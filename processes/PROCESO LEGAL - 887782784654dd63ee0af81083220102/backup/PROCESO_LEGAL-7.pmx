        <dyn_content><![CDATA[{"name":"Form5 Aprobacion Caso","description":"Form5 Aprobacion Caso","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3200622876556f9843c0518093052292","name":"Form5 Aprobacion Caso","description":"Form5 Aprobacion Caso","mode":"edit","script":{"type":"js","code":"$('.menu').on('click', function () {\n  pest = this.id;\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#164219982655447c9733796008417810\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#9579607476554479a9a40c3062705647\").show();\n      break;\n    case 'informacion':\n      $(\"#sub_inf\").show();\n      $(\"#8772638676554496d6f8428069996411\").show();\n      break;\n  }\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_friss\").hide();\n  $(\"#276991790654e5db64db976015608181\").hide();\n  $(\"#sub_busqueda\").hide();\n  $(\"#210046437654e5dda2471b8060121807\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#712682644654e5e1b762a32057232411\").hide();\n  $(\"#sub_accesorios\").hide();\n  $(\"#47854012665568139bb0451001865945\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#975172180654e5e4cdcea97042363185\").hide();\n  $(\"#sub_taller_asign\").hide();\n  $(\"#7556819866556e6d7e0ed03014600235\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#504620397654e5e8bd06c38001384835\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#578719942654e5ed5144508033935400\").hide();\n  $(\"#subt_accidente\").hide();\n  $(\"#134085550654e5efe0a0bb4059785346\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#595992730654e5eba660bc4059005720\").hide();\n\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#925223586654e5f134f8d66048355477\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#140487401654e6097d7c7c9075610530\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#583353528654e60af727c44072609866\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#5778108566556e727dab9e9020834769\").hide();\n  $(\"#subt_analisis_coberturas\").hide();\n  $(\"#3167242526556e74a77b816087056308\").hide();\n  \n  $(\"#sub_docs\").hide();\n  $(\"#573968372654e60c8554bd0031157549\").hide();\n  $(\"#sub_inf\").hide();\n  $(\"#8772638676554496d6f8428069996411\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#164219982655447c9733796008417810\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#9579607476554479a9a40c3062705647\").hide();\n\n  \n\n}\nfunction mostrar_solicitud() {\n\n    $(\"#sub_friss\").show();\n    $(\"#276991790654e5db64db976015608181\").show();\n    $(\"#sub_busqueda\").show();\n    $(\"#210046437654e5dda2471b8060121807\").show();\n    $(\"#subt_poliza\").show();\n    $(\"#712682644654e5e1b762a32057232411\").show();\n    $(\"#sub_accesorios\").show();\n    $(\"#47854012665568139bb0451001865945\").show();\n    $(\"#subt_vehiculo\").show();\n    $(\"#975172180654e5e4cdcea97042363185\").show();\n    $(\"#sub_taller_asign\").show();\n    $(\"#7556819866556e6d7e0ed03014600235\").show();\n    $(\"#subt_hsiniestros\").show();\n    $(\"#504620397654e5e8bd06c38001384835\").show();\n    $(\"#subt_asegurado\").show();\n    $(\"#578719942654e5ed5144508033935400\").show();\n    $(\"#subt_accidente\").show();\n    $(\"#134085550654e5efe0a0bb4059785346\").show();\n    $(\"#subt_ppolicial\").show();\n    $(\"#595992730654e5eba660bc4059005720\").show();\n\n    \n  $(\"#subt_ve_afectados\").show();\n  $(\"#925223586654e5f134f8d66048355477\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#140487401654e6097d7c7c9075610530\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#583353528654e60af727c44072609866\").show();\n  $(\"#subt_registro\").show();\n  $(\"#5778108566556e727dab9e9020834769\").show();\n  $(\"#subt_analisis_coberturas\").show();\n  $(\"#3167242526556e74a77b816087056308\").show();\n  \n  $(\"#sub_docs\").show();\n  $(\"#573968372654e60c8554bd0031157549\").show();\n  \n\n}\n\n\n\nocultar_todo();\nmostrar_solicitud();\n\nlet vehiculos = $(\"#frm_siniestro_OtrosVehiculos\").getValue();\nlet propiedades = $(\"#frm_siniestro_Propiedad\").getValue();\nlet personas = $(\"#frm_siniestro_Personas\").getValue();\n\n$(\"#subt_ve_afectados\").hide();\n  $(\"#925223586654e5f134f8d66048355477\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#140487401654e6097d7c7c9075610530\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#583353528654e60af727c44072609866\").hide();\n\nif (vehiculos == 'SI') {\n    $(\"#subt_ve_afectados\").show();\n  $(\"#925223586654e5f134f8d66048355477\").show();\n}\nif (propiedades == 'SI') {\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#583353528654e60af727c44072609866\").show();\n}\nif (personas == 'SI') {\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#140487401654e6097d7c7c9075610530\").show();\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"INFORMACION","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"98825973165519a07985603078466915","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"informacion\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Información</h4></a></li>\n  <li id=\"solicitud\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>  \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"5324641846579bc4e175527047657180","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"/plugin/ph_soluciones/core_librerias/js_externos/app.min.js,\n\n/plugin/ph_soluciones/core_librerias/css_externos/AdminLTE.min.css, /plugin/ph_soluciones/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"7804165286579bc5211e9e9097343418","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"2025321376579bc5215eae1050534556","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"9234920846579bc5219a863098066888","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"9682616496579bc521d0841099591537","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"6447922546579bc522090b1033933772","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"7804165286579bc5211e9e9097343418","prj_uid":"887782784654dd63ee0af81083220102","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconne