uid":"","dataType":"","id":"595992730654e5eba660bc4059005720","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"\nfunction asesoriaLegal(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_siniestro_afectado\").getValue())\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'SI'){\n     \n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      \n    } \n}\n\n//execute when the Dynaform loads:\nasesoriaLegal($(\"#frm_requiere_AsesoriaLegal\").getValue(), ''); \n$('#frm_requiere_AsesoriaLegal').setOnchange(asesoriaLegal);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"147390278654e5ebfae2d54036850050","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"397160963654e5ebfb1e793035316459","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"",