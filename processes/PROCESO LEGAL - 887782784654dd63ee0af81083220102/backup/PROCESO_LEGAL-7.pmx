cia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Tranferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_inicio","name":"f_inicio","label":"Fecha Inicio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Inicio"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_fin","name":"f_fin","label":"Fecha Fin","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Fin"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"accion","name":"accion","label":"Accion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":f