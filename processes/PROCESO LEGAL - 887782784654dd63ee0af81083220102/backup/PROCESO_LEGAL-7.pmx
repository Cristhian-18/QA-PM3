ar_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"39594828064a4a7bda1dc47068712487","var_name_old":"PROCESS","prj_uid_old":"35087580064a18c9776b638006106795"}],"colSpan":12}]],"variables":[{"var_uid":"78292220265519a4f1cb743092467787","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"78292220265519a4f1cb743092467787","var_name_old":"frm_accion","prj_uid_old":"887782784654dd63ee0af81083220102","create":false},{"var_uid":"6166835646556fc4921a733013498860","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_doc_analista","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6166835646556fc4921a733013498860","var_name_old":"frm_doc_analista","prj_uid_old":"887782784654dd63ee0af81083220102","create":false},{"var_uid":"45374669665562d16f26123004379281","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"45374669665562d16f26123004379281","var_name_old":"frm_comentario","prj_uid_old":"887782784654dd63ee0af81083220102","create":false}]}]}]]></dyn_content>
