Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_relacion_otro","colSpan":4}]],"variables":[{"var_uid":"178233902654e5ed8b858c3040574290","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_tipo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"30865455164a5eb03105167001606129","var_name_old":"frm_asegurado_tipo","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"402326280654e5ed8bc3328027845677","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"35959853464a5eb33eab333020957592","var_name_old":"frm_asegurado_identificacion","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"603179683654e5ed8bf2989062611717","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_nombres","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"83276475364a5eb1720fba5018137683","var_name_old":"frm_asegurado_nombres","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"117696833654e5ed8c23e37059341461","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_telefono","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"44094274164a5eb4aa11dd5057756317","var_name_old":"frm_asegurado_telefono","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"349397872654e5ed8c53d29016908270","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_relacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"95571476564a5eb54141170034918196","var_name_old":"frm_asegurado_relacion","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"737594144654e5ed8c878a4082623990","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_asegurado_relacion_otro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"35295574464bab6a30f76f2063964056","var_name_old":"frm_asegurado_relacion_otro","prj_uid_old":"35087580064a18c9776b638006106795"}],"colSpan":12}],[{"type":"subtitle","id":"subt_accidente","label":"<span class=\"subtitulo\" id=\"isubt_accidente\" subform=\"134085550654e5efe0a0bb4059785346\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos del accidente</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"134085550654e5efe0a0bb4059785346","name":"SubForm Datos Accidente","description":"SubForm Datos Accidente","mode":"disabled","script":{"type":"js","code":"//PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n  $.ajax({\n    url  : '../ph_soluciones/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_provincias',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'provincia'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_provincia').getControl().empty();\n    $('#frm_accidente_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_pais\").getValue() == '') {\n  checkProvincia($(\"#frm_accidente_pais\").getValue(), '');\n} \n*/\n$('#frm_accidente_pais').setOnchange(checkProvincia); //execute when field's value changes\n\n//CANTON\nfunction checkCanton(newVal, oldVal) {\nvar frm_dato = $(\"#frm_accidente_pais\").getValue();\n  $.ajax({\n    url  : '../ph_soluciones/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_cantones',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'canton'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_provincia\").getValue() != '') {\n  checkCanton($(\"#frm_accidente_provincia\").getValue(), '');\n} \n*/\n$('#frm_accidente_provincia').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  /*console.log(\"BANDERA CAMBIO: \" + newVal);\n$(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n$(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n$(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n$(\"#frm_taller_ciudad\").setValue(\"Q\");\n$(\"#frm_taller_prioridad\").setValue(\"1\");\n$(\"#frm_taller_capacidad\").setValue(\"20\");\n$(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n$(\"#frm_taller_saldo\").setValue(\"15\");\n$(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n$(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n$(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");*/\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#subt_ve_afectados\").show();\n      $(\"#24440509064a84d82d7a6e4090951046\").show();\n  } else {\n     $(\"#subt_ve_afectados\").hide();\n      $(\"#24440509064a84d82d7a6e4090951046\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#iisubt_pr_afectados\").show();\n      $(\"#83626962464a84f217fbb30019736581\").show();\n  } else {\n     $(\"#iisubt_pr_afectados\").hide();\n      $(\"#83626962464a84f217fbb30019736581\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#isubt_pe_afectados\").show();\n      $(\"#59581944164a84e6bc66f02025995827\").show();\n  } else {\n     $(\"#isubt_pe_afectados\").hide();\n      $(\"#59581944164a84e6bc66f02025995827\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accidente_pais","var_uid":"903442928654e5f016e8c21062116897","dataType":"string","protectedValue":false,"id":"frm_accidente_pais","name":"frm_accidente_pais","label":"Pais","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtapais","options":[],"var_name":"frm_accidente_pais","colSpan":4},{"type":"dropdown","variable":"frm_accidente_provincia","var_uid":"497679531654e5f01722a69033623469","dataType":"string","protectedValue":false,"id":"frm_accidente_provincia","name":"frm_accidente_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaprov","options":[],"var_name":"frm_accidente_provincia","colSpan":4},{"type":"dropdown","variable":"frm_accidente_ciudad","var_uid":"315249874654e5f01756249071589823","dataType":"string","protectedValue":false,"id":"frm_accidente_ciudad","name":"frm_accidente