        <dyn_content><![CDATA[{"name":"SubForm Parte Policial","description":"SubForm Parte Policial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"595992730654e5eba660bc4059005720","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"function checkAfectado(newVal, oldVal) {\n  console.log(newVal);\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'AFECTADO') {\n    $('#frm_siniestro_informacionResponsable').show();\n    $('#frm_siniestro_informacionResponsable').enableValidation();\n    console.log(newVal);\n\n  } else {\n    $('#frm_siniestro_informacionResponsable').setValue(\"\");\n    console.log(newVal);\n\n  }\n}\n\n//execute when the Dynaform loads:\ncheckAfectado($(\"#frm_siniestro_seConsidera\").getValue(), '');\n$('#frm_siniestro_seConsidera').setOnchange(checkAfectado);\n\n\nfunction informacionResponsable(newVal, oldVal) {\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_nombreResponsable').show();\n    $('#frm_siniestro_placaResponsable').show();\n    $('#frm_siniestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n//execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"147390278654e5ebfae2d54036850050","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"397160963654e5ebfb1e793035316459","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"dropdown","variable":"frm_siniestro_seConsidera","var_uid":"785846459656de58e3f6db7029335938","dataType":"string","protectedValue":false,"id":"frm_siniestro_seConsidera","name":"frm_siniestro_seConsidera","label":"¿A juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"RESPONSABLE","label":"Responsable"},{"value":"AFECTADO","label":"Afectado"}],"var_name":"frm_siniestro_seConsidera","colSpan":6},{"type":"dropdown","variable":"frm_siniestro_informacionResponsable","var_uid":"545558871654e5ebfb87b58095070983","dataType":"string","protectedValue":false,"id":"frm_siniestro_informacionResponsable","name":"frm_siniestro_informacionResponsable","label":"¿Tiene información del responsable?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione una ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_siniestro_informacionResponsable","colSpan":6}],[{"type":"text","variable":"frm_siniestro_placaResponsable","var_uid":"585592009654e5ebfbb8951030293254","dataType":"string","protectedValue":false,"id":"frm_siniestro_placaResponsable","name":"frm_siniestro_placaResponsable","label":"# de Placa del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_placaResponsable","colSpan":6},{"type":"text","variable":"frm_siniestro_nombreResponsable","var_uid":"424352849654e5ebfbe74f5006768798","dataType":"string","protectedValue":false,"id":"frm_siniestro_nombreResponsable","name":"frm_siniestro_nombreResponsable","label":"Nombre del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":""