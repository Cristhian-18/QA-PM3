tectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Comentario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Usuario","name":"gridDocumentos_Usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Usuario"},{"type":"link","id":"gridDocumentos_Descarga","name":"gridDocumentos_Descarga","label":"","tabIndex":"","value":"Descargar","href":"","hint":"","ariaLabel":"","columnWidth":"20","width":100,"title":""}],"data":[],"mode":"view","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Documentos del flujo","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"dropdown","variable":"frm_accion","var_uid":"78292220265519a4f1cb743092467787","dataType":"string","protectedValue":false,"id":"frm_accion","name":"frm_accion","label":"Acción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"RC","label":"Notificar Responsabilidad Civil"},{"value":"Subrogacion","label":"Notificar Subrogación"},{"value":"CierreRC","label":"Notificar Cierre Responsabilidad Civil"},{"value":"CierreSubrogacion","label":"Notificar Cierre Subrogación"},{"value":"Asignar","label":"Asignar a ejecutivo legal"}],"var_name":"frm_accion","colSpan":12}],[{"type":"multipleFile","variable":"frm_poliza","var_uid":"82269727965519aaa6de424096916974","dataType":"multiplefile","protectedValue":false,"id":"frm_poliza","name":"frm_poliza","label":"Póliza","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_poliza","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"504535152654dd70f0eb7a8068973345","name":"SubForm Estilos Funciones","description":"SubForm Estilos Funciones","mode":"edit","script":{"type":"js","code":"$(\"#dyn_forward\").hide();\n$(\"img[src='/images/bulletButton.gif']\").hide();\n$('.panel').css(\"border\",\"none\");\n$(\".row\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"margin-bottom\", \"5px\");\n$(\".panel-body\").css(\"padding\", \"0\");\n$('.pmdynaform-form').css(\"border\",\"none\");\n$(\".form-control\").css(\"box-shadow\", \"none\");\n$(\".pmdynaform-grid-row\").css(\"border-bottom\", \"none\");\n$(\".pmdynaform-label-options\").css(\"text-align\", \"left\");\n$(\".pmdynaform-grid-title\").css(\"color\", \"#FFFFFF\");\n$(\".pmdynaform-field-title\").css(\"margin-bottom\", \"1px\");\n$(\".pmdynaform-field-title\").css(\"text-align\", \"center\");\n$(\".nav\").css(\"padding.bottom\", \"1px\");\n$(\".pmdynaform-field-subtitle\").css(\"color\", \"#FFFFFF\");\n$(\".pmdynaform-field-subtitle\").css(\"background-color\", \"#039BE5\");\n$(\".pmdynaform-field-subtitle\").css(\"border-color\", \"#039BE5\");\n$(\".pmdynaform-field-title\").css(\"color\", \"#FFFFFF\");\n$(\".pmdynaform-field-title\").css(\"background-color\", \"#003366\");\n$(\".pmdynaform-field-title\").css(\"border-color\", \"#003366\");\n\n$(\".btn-primary:hover\").css(\"background-color\", \"#003366\");\n$(\".btn-primary:hover\").css(\"color\", \"#003366\");\n$(\".btn-primary\").css(\"background-color\", \"#003366\");\n$(\".btn-primary\").css(\"color\", \"#ffffff\");\n\n$(\".btn-default\").css(\"background-color\", \"#039BE5\");\n$(\".btn-default\").css(\"color\", \"#ffffff\");\n$(\".btn-default\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".btn-uploadfile:hover\").css(\"background-color\", \"#003366\");\n$(\".btn-uploadfile:hover\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile\").css(\"background-color\", \"#039BE5\");\n$(\".btn-uploadfile\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".btn:hover\").css(\"background-color\", \"#003366\");\n$(\".btn:hover\").css(\"color\", \"#003366\");\n$(\".btn\").css(\"background-color\", \"#039BE5\");\n$(\".btn\").css(\"color\", \"#ffffff\");\n$(\".btn\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"background-color\", \"#039BE3\");\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"color\", \"#ffffff\");\n$(\".ui-button\").css(\"background-color\", \"#039BE5\");\n$(\".ui-button\").css(\"color\", \"#ffffff\");\n\n$(\".pmdynaform-grid-title\").css(\"background-color\", \"#039be5cf\");\n$(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n//$(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#039BE5\");\n//$(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n//$(\".pmdynaform-grid-newitem\").css(\"border-color\", \"#003366\");\n$(\".btn-default\").css(\"background-color\", \"#039BE5\");\n$(\".btn-default\").css(\"border-color\", \"#039BE5\");\n$(\".pmdynaform-grid-text-plus\").text(\"Agregar\");\n\n\n$( function(){\n\t$('.subtitulo').css( 'cursor', 'pointer' );\n\t\n\t$('.subtitulo').on('click', function(){\n\t\tid = this.id;\n\t\tsubforms = $('#'+this.id).attr('subform').split('|');\n\t\tif( $('#'+id).children().attr('class') == 'glyphicon glyphicon-plus')\n\t\t$('#'+id).children().removeClass('glyphicon-plus').addClass('glyphicon-minus');\n\t\telse\n\t\t$('#'+id).children().removeClass('glyphicon-minus').addClass('glyphicon-plus');\n\t\t$.each( subforms , function( index, subform ) {\n\t\t\t$('#'+subform).toggle('slow');\n\t\t});\n\t});\n\t\n\t\n})\n\nfunction validarExpresionRegular(id, numeroExpresion){\n\t\n\tif(numeroExpresion == 4){\n\t\tponerDecimales(id);\n\t}\n\t\n\t$(\"#\" + id).focusout( function () {\n\t\tvalidarExpresionRegular_2($(this), numeroExpresion);\n\t}); \t\n\t\n\tvalidarExpresionRegular_2($(\"#\" + id), numeroExpresion);\n} \n\nfunction roundToFixed(_float, _digits){\n  var rounder = Math.pow(10, _digits);\n  return (Math.round(_float * rounder) / rounder).toFixed(_digits);\n}\n\nfunction limitMaxMin(_float, _max, _min){\n  var parsed = parseFloat(_float);\n  if(isNaN(parsed)) {\n    return '';\n  }\n  console.log(parsed);\n  if(parsed > _max) {\n    console.log(_max, parsed);\n    return _max;\n  }\n  if(parsed < _min) {\n    console.log(_min, parsed);\n    return _min;\n  }\n  return parsed;\n}\n\nfunction validarExpresionRegular_2(id, numeroExpresion){\n\tvar expresion_regular = $(\"#expresion_regular_\" + numeroExpresion).getValue();\n\t//alert(expresion_regular);\n\tvar texto = $(id).getValue().toString().trim();\n\t//alert(texto);\n\t\n\t//alert(texto.match(expresion_regular) + \" - \" + texto.length);\n\t\n\tif (texto.match(expresion_regular) || texto.length == 0){\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"\" );\n\t\t$(id).getControl().css(\"borderColor\", \"\");\n\t\t}else {\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"#a94442\" );\n\t\t$(id).getControl().css(\"borderColor\", \"#e4655f\");\n\t}\t\n}\n\nfunction ponerDecimales(id){\n\t\n\tvar identificador = $('#' + id);\n\tvar valor = identificador.getValue().toString().trim();\n\t\n\tif(valor == ''){\n\t\tidentificador.setValue(\"\");\n\t\treturn;\n\t}  \n\t\n\tif(typeof valor.split(\".\")[1] === 'undefined'){\n\t\tidentificador.setValue(valor + \".00\");\n\t\t}else if(valor.split(\".\")[1].length == 0){\n\t\tidentificador.setValue(valor + \"00\");\n\t\t}else if(valor.split(\".\")[1].length == 1){\n\t\tidentificador.setValue(valor + \"0\");\n\t}\n\t\n}\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion, aux) {\n\n    numero = identificacion;\n    var tercerDigito = numero.substring(2, 3);\n    var bandera = true;\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            if (aux) {\n                alert(\"La identificacion no tiene diez digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    } else if (tipoIdentificacion == 'R') {\n      \t//alert('otro');\n      \tif (isNaN(numero)) {\n           alert(\"La identificacion es incorrecta\");\n        }\n        if (numero.length != 13) {\n            if (aux) {\n                alert(\"La identificacion no tiene trece digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (tercerDigito == 9) {\n            digitos = numero.split(\"\");\n            totdigitos = 10;\n            total = 0;\n            digito = (digitos[9] * 1);\n            p1 = digitos[0] * 4;\n            p2 = digitos[1] * 3;\n            p3 = digitos[2] * 2;\n            p4 = digitos[3] * 7;\n            p5 = digitos[4] * 6;\n            p6 = digitos[5] * 5;\n            p7 = digitos[6] * 4;\n            p8 = digitos[7] * 3;\n            p9 = digitos[8] * 2;\n            total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\n            residuo = total % 11\n            final = residuo == 0 ? 0 : 11 - residuo\n            //comprobando codigo verificador\n            if (final == digito) {\n                //alert(\"RUC EMPRESA valido\");\n                bandera = false;\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"RUC EMPRESA no valido\");\n                }\n                identificacion.value = '';\n                bandera = false;\n            }\n        }\n    }\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n        var i = 0;\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n        //comprobando codigo verificador\n        decena = total / 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            //alert(\"Cedula valida\");\n            return true;\n        } else {\n            if (tipoIdentificacion == 'P') {\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"Identificacion no valida\");\n                }\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n}\n\nfunction clearGrid (grd_name) {\n    //first delete all rows except for the first:\n    var rows = $(\"#\"+grd_name).getNumberRows();\n    for (var i=1; i < rows; i++) {\n        $(\"#\"+grd_name).deleteRow();\n    }\n    //clear all fields in the grid:\n    var aValues = $(\"#\"+grd_name).getValue();\n    for (var i=1; i <= aValues[0].length; i++) {\n        $(\"#\"+grd_name).setValue(\"\", 1, i);\n    }\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"hidden","variable":"expresion_regular_1","var_uid":"786226101654dd71259a0c0086589994","dataType":"string","protectedValue":false,"id":"expresion_regular_1","name":"expresion_regular_1","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_1","colSpan":1},{"type":"hidden","variable":"expresion_regular_2","var_uid":"768548660654dd7125d5183023734796","dataType":"string","protectedValue":false,"id":"expresion_regular_2","name":"expresion_regular_2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_2","colSpan":1},{"type":"hidden","variable":"expresion_regular_3","var_uid":"612087801654dd712605198008430231","dataType":"string","protectedValue":false,"id":"expresion_regular_3","name":"expresion_regular_3","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_3","colSpan":1},{"type":"hidden","variable":"expresion_regular_4","var_uid":"834634274654dd712635675075594999","dataType":"string","protectedValue":false,"id":"expresion_regular_4","name":"expresion_regular_4","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_4","colSpan":1},{"type":"hidden","variable":"PROCESS","var_uid":"347243617654dd712665e12099650512","dataType":"string","protectedValue":false,"id":"PROCESS","name":"PROCESS","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"PROCESS","colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1}]],"variables":[{"var_uid":"786226101654dd71259a0c0086589994","prj_uid":"887782784654dd63ee0af81083220102","var_name":"expresion_regular_1","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23517588564a4a7bd9a2f38044177148","var_name_old":"expresion_regular_1","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"768548660654dd7125d5183023734796","prj_uid":"887782784654dd63ee0af81083220102","var_name":"expresion_regular_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"57772352964a4a7bd9e4523087321015","var_name_old":"expresion_regular_2","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"612087801654dd712605198008430231","prj_uid":"887782784654dd63ee0af81083220102","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"54791107064a4a75a88a1b0006756267","var_name_old":"expresion_regular_3","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"834634274654dd712635675075594999","prj_uid":"887782784654dd63ee0af81083220102","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"99684288764a4a75a8cb118042504278","var_name_old":"expresion_regular_4","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"347243617654dd712665e12099650512","prj_uid":"887782784654dd63ee0af81083220102","var_name":"PROCESS","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"39594828064a4a7bda1dc47068712487","var_name_old":"PROCESS","prj_uid_old":"35087580064a18c9776b638006106795"}],"colSpan":12}]],"variables":[{"var_uid":"78292220265519a4f1cb743092467787","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"82269727965519aaa6de424096916974","prj_uid":"887782784654dd63ee0af81083220102","var_name":"frm_poliza","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
