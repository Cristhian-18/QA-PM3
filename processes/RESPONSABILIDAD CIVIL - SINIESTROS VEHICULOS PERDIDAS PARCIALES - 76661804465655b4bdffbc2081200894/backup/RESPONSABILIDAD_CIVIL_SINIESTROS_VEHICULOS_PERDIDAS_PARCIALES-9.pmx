41453365655b4ed3ad27050479402\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos del conductor<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76241453365655b4ed3ad27050479402","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"disabled","script":{"type":"js","code":"\/\/CONDUCTOR\nfunction checkConductor(newVal, oldVal) {\n    if (newVal == 'A') {\n        $(\"#frm_asegurado_nombres\").setValue($(\"#frm_busqueda_nombres\").getValue());\n      \t$(\"#frm_asegurado_identificacion\").setValue($(\"#frm_busqueda_identificacion\").getValue());\n    } else {\n        $(\"#frm_asegurado_nombres\").setValue('');\n      \t$(\"#frm_asegurado_identificacion\").setValue('');\n    }\n}\n\/\/execute when the Dynaform loads:\nif ($(\"#frm_asegurado_tipo\").getValue() != '') {\n    checkConductor($(\"#frm_asegurado_tipo\").getValue(), '');\n} \n$('#frm_asegurado_tipo').setOnchange(checkConductor); \/\/execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"28966250165655b4ee91854071269948","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"37401606165655b4ee88057027800219","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion",