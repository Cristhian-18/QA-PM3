	//tarea 13
	case '75557425865139ecc83cd31064722953':
		$de = '';
		$para = @@frm_responsable_emision_mail;
		$para = @@tri_correo_desarrollador_cc;


		$asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
		$accion = @@frm_accion;
