        <dyn_content><![CDATA[{"name":"Form 5 Verificar datos del siniestro","description":"Form 5 Verificar datos del siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"42031909565655b4ed75619071979958","name":"Form 5 Verificar datos del siniestro","description":"Form 5 Verificar datos del siniestro","mode":"edit","script":{"type":"js","code":"//created by Hwenry\n\nlet nombre_taller = $(\"#frm_taller\").getValue();\n$(\"#grd_valores_siniestros\").hideColumn(9);\n\n\t$(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setValue(0);\n\nlet numberRows = $(\"#grd_valores_siniestros\").getNumberRows();\nconsole.log(numberRows);\nlet valorSuma = 0;\n\nfor (let i = 1; i <= numberRows; i++) {\n  if(nombre_taller == \"TALLER INDEMNIZACION\"){\n    $(\"#grd_valores_siniestros\").setValue(\"Indemnizacion\", i, 11);\n  }\n    for (let j = 1; j <= 11; j++) {\n        if (j != 10 && j != 11) {\n            $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n        }\n    }\n}\n\nfunction checkValores(newVal, oldVal) {\n    valorSuma = 0;\n    valorTotal = 0;\n    for (let i = 1; i <= numberRows; i++) {\n        if ($(\"#grd_valores_siniestros\").getValue(i, 11) != \"Negado\") {\n            console.log(\"Valor\", $(\"#grd_valores_siniestros\").getValue(i, 5));\n            valorSuma = valorSuma + parseInt($(\"#grd_valores_siniestros\").getValue(i, 5));\n        }\n        valorTotal = valorTotal + parseInt($(\"#grd_valores_siniestros\").getValue(i, 5));\n\n    }\n    $valorSuma = roundToFixed(valorSuma, 2);\n\n    console.log(\"Valor suma\", $valorSuma);\n    $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(valorSuma);\n    console.log(\"Valor suma\", $valorSuma);\n    hideRepuestos();\n\n}\ncheckValores($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkValores);\n\nfunction hideRepuestos() {\n    console.log(\"Valor suma\", valorSuma);\n    if (valorTotal > 0) {\n        if (nombre_taller == \"MUNDO MOTRIZ\") {\n          \n        }\n        if(nombre_taller == \"TALLER INDEMNIZACION\"){\n          $(\"option[value='Aprobado']\").remove();\n          $(\"option[value='Pendiente']\").remove();\n        }\n       \n    } else {\n       \n        /*$(\"#sub_gestionrepuestos\").hide()\n        $(\"#grd_valores_siniestros\").hide()*/\n\n    }\n}\nfunction accion(newValue, oldValue) {\n  $(\"#sub_gestionrepuestos\").hide();\n  $(\"#61619725465655b4ed55658058928127\").hide();\n\n  if(newValue == 'COTIZAR'){\n     $(\"#sub_gestionrepuestos\").show();\n    $(\"#61619725465655b4ed55658058928127\").show();\n  } \n}\n\n\naccion();\n$(\"#frm_accion\").setOnchange(accion);\n\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        \n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#75921207865655b4ed5b3c1053457518').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#79094655365655b4ed40d17058683087').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $(\"#sub_gestionrepuestos\").show();\n        $(\"#57719423965655b4ed5e193039723079\").show();\n        $('#sub_valores_aprobados').show()\n        $('#13230486865655b4ed57598003315291').show()\n        $('#57719423965655b4ed5e193039723079').show()\n        $('#frm_comentarioAnalista_ajustadorInterno').show()\n\n        break\n    }\n    hideRepuestos();\n  })\n  \n  function ocultar_todo() {\n    $('#frm_comentarioAnalista_ajustadorInterno').hide()\n    $('#subt_friss').hide()\n    $('#95547977665655b4ed87ca6055466913').hide()\n    $('#43198352265655b4ed78569007990565').hide()\n    $('#subt_tallerAsignado').hide()\n    $('#subt_ppolicial').hide()\n    $('#57796621765655b4ed83ea3082357963').hide()\n    $('#subt_accesoriosRegistrados').hide()\n    $('#43015877965655b4ed7d2a1016407207').hide()\n    $('#subt_accidente').hide()\n    $('#31053789365655b4ed53799071011166').hide()\n    $('#33327433165655b4ed6abd1080464820').hide()\n    $('#sub_busqueda').hide()\n    $('#60259283965655b4ed68cb6009778512').hide()\n    $('#subt_vehiculo').hide()\n    $('#17569986565655b4ed8c995023188336').hide()\n    $('#subt_asegurado').hide()\n    $('#76241453365655b4ed3ad27050479402').hide()\n    $('#subt_detalle').hide()\n    $('#41209453665655b4ed71780023900709').hide()\n    $('#subt_registro').hide()\n    $('#44056937965655b4ed42c04054669455').hide()\n    $('#subt_ve_afectados').hide()\n    $('#93254149565655b4ed46a66057215729').hide()\n    $('#isubt_pe_afectados').hide()\n    $('#43602034065655b4ed6ca46084965014').hide()\n    $('#iisubt_pr_afectados').hide()\n    $('#46533585865655b4ed84dd4018270742').hide()\n    $('#sub_docs').hide()\n    $('#98325375965655b4ed45b13092827388').hide()\n    $('#sub_valores').hide()\n    $('#51718349165655b4ed81039097317111').hide()\n    $('#subt_docs').hide()\n    $('#75921207865655b4ed5b3c1053457518').hide()\n    $('#sbt_historial').hide()\n    $('#79094655365655b4ed40d17058683087').hide()\n    $('#subt_poliza').hide()\n    $('#28358068365655b4ed35473079795674').hide()\n    $('#sub_repuestos').hide()\n    $('#57719423965655b4ed5e193039723079').hide()\n    $('#subt_hsiniestros').hide()\n    $('#47330327665655b4ed38dc0072757607').hide()\n    $('#subt_direccionador').hide()\n    $('#83210580965655b4ed546d3053710376').hide()\n    $('#subt_documentosTaller').hide()\n    $('#13053029065655b4ed8da75032156816').hide()\n    $('#subt_gestionTaller').hide()\n    $('#16138142065655b4ed73766092455273').hide()\n    $('#subt_valoresSiniestros').hide()\n    $('#48813423665655b4ed48ac5080424075').hide()\n    $('#subt_documentos_cotizacion').hide()\n    $('#11357093065655b4ed85e43013712128').hide()\n    $('#sub_valores_aprobados').hide()\n    $('#13230486865655b4ed57598003315291').hide()\n    \n    \n  }\n  function mostrar_solicitud() {\n    $('#frm_comentarioAnalista_ajustadorInterno').show()\n    $('#subt_friss').show()\n    $('#95547977665655b4ed87ca6055466913').show()\n    $('#43198352265655b4ed78569007990565').show()\n    $('#subt_tallerAsignado').show()\n    $('#subt_ppolicial').show()\n    $('#57796621765655b4ed83ea3082357963').show()\n    $('#subt_accesoriosRegistrados').show()\n    $('#43015877965655b4ed7d2a1016407207').show()\n    $('#subt_accidente').show()\n    $('#31053789365655b4ed53799071011166').show()\n    $('#subt_hsiniestros').show()\n    $('#sub_busqueda').show()\n    $('#60259283965655b4ed68cb6009778512').show()\n    $('#subt_vehiculo').show()\n    $('#17569986565655b4ed8c995023188336').show()\n    $('#subt_asegurado').show()\n    $('#76241453365655b4ed3ad27050479402').show()\n    $('#subt_detalle').show()\n    $('#41209453665655b4ed71780023900709').show()\n    $('#subt_registro').show()\n    $('#44056937965655b4ed42c04054669455').show()\n    $('#subt_ve_afectados').show()\n    $('#93254149565655b4ed46a66057215729').show()\n    $('#isubt_pe_afectados').show()\n    $('#43602034065655b4ed6ca46084965014').show()\n    $('#iisubt_pr_afectados').show()\n    $('#46533585865655b4ed84dd4018270742').show()\n    $('#sub_docs').show()\n    $('#98325375965655b4ed45b13092827388').show()\n    $('#sub_valores').show()\n    $('#51718349165655b4ed81039097317111').show()\n    $('#subt_poliza').show()\n    $('#28358068365655b4ed35473079795674').show()\n    $('#subt_historial_siniestro').show()\n    $('#47330327665655b4ed38dc0072757607').show()\n    $('#subt_direccionador').show()\n    $('#83210580965655b4ed546d3053710376').show()\n    $('#subt_documentosTaller').show()\n    $('#13053029065655b4ed8da75032156816').show()\n    $('#subt_gestionTaller').show()\n    $('#16138142065655b4ed73766092455273').show()\n    $('#subt_valoresSiniestros').show()\n    $('#48813423665655b4ed48ac5080424075').show()\n    $('#subt_documentos_cotizacion').show()\n    $('#11357093065655b4ed85e43013712128').show()\n   \n}\n  \n  ocultar_todo()\n  mostrar_solicitud()\n  "},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACIÓN SINIESTROS VEHÍCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"49220356465655b4ed7c383098421016","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13048492165655b4ed69be3029064099","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n//$(\"#tri_id_stro\").setValue(\"12345\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#app_number_padre\").getValue());"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"49544138865658539b71d72085132355","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"85256800865658539bb0651098135575","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"70874789365655b4f012b92099486659","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":