nt","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"1","label":"Prueba sobre la propiedad del vehículo y/o de su interés asegurable"},{"value":"2","label":"Parte policial y/o denuncia a las autoridades correspondientes"},{"value":"3","label":"Fotocopia de la matrícula actualizada"},{"value":"4","label":"Fotocopia a color de la cédula del conductor y del Asegurado"},{"value":"5","label":"Fotocopia de la licencia vigente del conductor (daños y responsabilidad civil)"},{"value":"6","label":"Proforma de reparación o reemplazo de las partes afectadas (total de mano de obra u repuestos)"},{"value":"7","label":"Original de las facturas proforma, a nombre de Seguros Equinoccial S. A"},{"value":"8","label":"Contrato de compraventa firmado en el anverso y el reverso, según formato entregado por la Compañía (pérdida total)"},{"value":"9","label":"Matrícula original actualizada (o cubrir costos de la misma en caso de pérdida total)"},{"value":"10","label":"Certificados de Policía de no gravamen (pérdida total)"},{"value":"11","label":"Copias a color de cédula de identidad y certificado de votación del propietario del vehículo y del cónyuge"},{"value":"12","label":"Historia de dominio emitida por la autoridad de tránsito competente"},{"value":"13","label":"Llaves del vehículo y duplicados (pérdida total)"},{"value":"14","label":"Denuncias originales de Policía Judicial, autoridad de tránsito competente (Comisión de Tránsito del Guayas o Dirección Nacional de Tránsito) y fiscalía (pérdida total)"},{"value":"15","label":"Informe final de la Policía Judicial y Autoridad de Tránsito competente después de transcurridos cuarenta y cinco (45) días de la fecha de robo (Comisión de Transito del Guayas"},{"value":"16","label":"Sentencia Judicial ejecutoriada demostrando la responsabilidad del Asegurado y el monto de los perjuicios sufridos p