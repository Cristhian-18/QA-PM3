:"Valor Reclamado"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cod_amparo","name":"grd_s_cod_amparo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_codCobertura","name":"grd_s_codCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_codConsecutivo","name":"grd_s_codConsecutivo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_impPrimaBasica","name":"grd_s_impPrimaBasica","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"61247336765655b4f008b64094147501","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"grd_registro_siniestro","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"61247336765655b4f008b64094147501","var_name_old":"grd_registro_siniestro","prj_uid_old":"76661804465655b4bdffbc2081200894"}]}]}]]></dyn_content>
