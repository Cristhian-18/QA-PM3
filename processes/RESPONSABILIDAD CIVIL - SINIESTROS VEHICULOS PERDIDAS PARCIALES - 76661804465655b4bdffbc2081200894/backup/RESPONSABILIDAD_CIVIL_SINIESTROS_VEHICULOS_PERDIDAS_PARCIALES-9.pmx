id":"total_aprobado","name":"total_aprobado","label":"Total aprobado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Total aprobado"}],"data":[],"mode":"disabled","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Alcances","colSpan":12}],[{"type":"text","variable":"frm_totalMasAlcances","var_uid":"53102598765655b4ef27d52010557991","dataType":"string","protectedValue":false,"id":"frm_totalMasAlcances","name":"frm_totalMasAlcances","label":"Total Aprobado + Alcances","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_totalMasAlcances","colSpan":12}]],"variables":[{"var_uid":"22148225265655b4eefc729062358741","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_reg_alcances","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"53102598765655b4ef27d52010557991","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_totalMasAlcances","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
