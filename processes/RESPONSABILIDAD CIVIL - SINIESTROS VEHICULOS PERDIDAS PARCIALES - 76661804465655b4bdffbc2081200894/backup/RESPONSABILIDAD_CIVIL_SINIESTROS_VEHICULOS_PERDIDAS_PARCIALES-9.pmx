        <dyn_content><![CDATA[{"name":"SubForm Emisión de Negativas","description":"SubForm Emisión de Negativas","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"66043585565655b4ed4c8d2031469461","name":"SubForm Emisión de Negativas","description":"SubForm Emisión de Negativas","mode":"edit","script":{"type":"js","code":"function nombreDoc(newValue, oldValue) {\n  $(\"#frm_emisionNegativa_nombreUltimoDoc2\").hide();\n  if(newValue == 'OTROS'){\n    $(\"#frm_emisionNegativa_nombreUltimoDoc2\").show();\n  } \n}\n\nnombreDoc($(\"#frm_emisionNegativa_nombreUltimoDoc\").getValue(), '');\n$(\"#frm_emisionNegativa_nombreUltimoDoc\").setOnchange(nombreDoc);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"datetime","variable":"frm_emisionNegativa_fechaAnalisis","var_uid":"11718756765655b4eed8a84028393198","dataType":"datetime","protectedValue":false,"id":"frm_emisionNegativa_fechaAnalisis","name":"frm_emisionNegativa_fechaAnalisis","label":"Fecha Análisis / Solicitd Negativa","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_emisionNegativa_fechaAnalisis","colSpan":6},{"type":"multipleFile","variable":"frm_emisionNegativa_condicionesGenerales","var_uid":"53332864965655b4eed59d5001182891","dataType":"multiplefile","protectedValue":false,"id":"frm_emisionNegativa_condicionesGenerales","name":"frm_emisionNegativa_condicionesGenerales","label":"Condiciones Generales","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_emisionNegativa_condicionesGenerales","colSpan":6}],[{"type":"datetime","variable":"frm_emisionNegativa_fechaUltimoDoc","var_uid":"11065791665655b4eed9c37097176233","dataType":"datetime","protectedValue":false,"id":"frm_emisionNegativa_fechaUltimoDoc","name":"frm_emisionNegativa_fechaUltimoDoc","label":"Fecha Último Documento","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_emisionNegativa_fechaUltimoDoc","colSpan":6},{"type":"multipleFile","variable":"frm_emisionNegativa_clausulaNombrada","var_uid":"86469146065655b4eed3914073666747","dataType":"multiplefile","protectedValue":false,"id":"frm_emisionNegativa_clausulaNombrada","name":"frm_emisionNegativa_clausulaNombrada","label":"Claúsula Nombrada","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_emisionNegativa_clausulaNombrada","colSpan":6}],[{"type":"dropdown","variable":"frm_emisionNegativa_nombreUltimoDoc","var_uid":"89023463965655b4eedcc20009844692","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_nombreUltimoDoc","name":"frm_emisionNegativa_nombreUltimoDoc","label":"Nombre Último Documento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"1","label":"Prueba sobre la propiedad del vehículo y/o de su interés asegurable"},{"value":"2","label":"Parte policial y/o denuncia a las autoridades correspondientes"},{"value":"3","label":"Fotocopia de la matrícula actualizada"},{"value":"4","label":"Fotocopia a color de la cédula del conductor y del Asegurado"},{"value":"5","label":"Fotocopia de la licencia vigente del conductor (daños y responsabilidad civil)"},{"value":"6","label":"Proforma de reparación o reemplazo de las partes afectadas (total de mano de obra u repuestos)"},{"value":"7","label":"Original de las facturas proforma, a nombre de Seguros Equinoccial S. A"},{"value":"8","label":"Contrato de compraventa firmado en el anverso y el reverso, según formato entregado por la Compañía (pérdida total)"},{"value":"9","label":"Matrícula original actualizada (o cubrir costos de la misma en caso de pérdida total)"},{"value":"10","label":"Certificados de Policía de no gravamen (pérdida total)"},{"value":"11","label":"Copias a color de cédula de identidad y certificado de votación del propietario del vehículo y del cónyuge"},{"value":"12","label":"Historia de dominio emitida por la autoridad de tránsito competente"},{"value":"13","label":"Llaves del vehículo y duplicados (pérdida total)"},{"value":"14","label":"Denuncias originales de Policía Judicial, autoridad de tránsito competente (Comisión de Tránsito del Guayas o Dirección Nacional de Tránsito) y fiscalía (pérdida total)"},{"value":"15","label":"Informe final de la Policía Judicial y Autoridad de Tránsito competente después de transcurridos cuarenta y cinco (45) días de la fecha de robo (Comisión de Transito del Guayas"},{"value":"16","label":"Sentencia Judicial ejecutoriada demostrando la responsabilidad del Asegurado y el monto de los perjuicios sufridos por el tercero o terceros afectados (responsabilidad civil)"},{"value":"17","label":"Facturas de los gastos médicos incurridos (gastos médicos y responsabilidad civil)."},{"value":"18","label":"Certificado médico del profesional que atendió al accidentado (gastos médicos y responsabilidad civil por lesiones)"},{"value":"19","label":"Historia clínica en caso de ser necesaria (gastos médicos y responsabilidad civil por lesiones)"},{"value":"20","label":"Original y copia de la cédula del afectado (gastos médicos y responsabilidad civil por lesiones)"},{"value":"21","label":"Certificado de autopsia (Muerte accidental y responsabilidad civil por muerte)."},{"value":"22","label":"Levantamiento del cadáver (Muerte accidental y responsabilidad civil por muerte)."},{"value":"23","label":"Certificado de defunción (Muerte accidental y responsabilidad civil por muerte)."},{"value":"24","label":"Original y copia de la cédula del fallecido (Muerte accidental y responsabilidad civil por muerte)."},{"value":"25","label":"Original y copia de la cédula de los beneficiarios legales (Muerte accidental y responsabilidad civil por muerte)."},{"value":"26","label":"Posesión efectiva de bienes (Muerte accidental y responsabilidad civil por muerte)"},{"value":"OTROS","label":"Otros"}],"var_name":"frm_emisionNegativa_nombreUltimoDoc","colSpan":6},{"type":"multipleFile","variable":"frm_emisionNegativa_textoPoliza","var_uid":"62757937665655b4eedede7009476818","dataType":"multiplefile","protectedValue":false,"id":"frm_emisionNegativa_textoPoliza","name":"frm_emisionNegativa_textoPoliza","label":"Texto en Póliza","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_emisionNegativa_textoPoliza","colSpan":6}],[{"type":"text","variable":"frm_emisionNegativa_nombreUltimoDoc2","var_uid":"55115707365655b4eeddd63038493633","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_nombreUltimoDoc2","name":"frm_emisionNegativa_nombreUltimoDoc2","label":"Detalle otros documentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_emisionNegativa_nombreUltimoDoc2","colSpan":12}],[{"type":"text","variable":"frm_emisionNegativa_diasRestantes","var_uid":"65477019865655b4eed6aa0023666878","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_diasRestantes","name":"frm_emisionNegativa_diasRestantes","label":"Dias restantes para notificación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_emisionNegativa_diasRestantes","colSpan":6},{"type":"multipleFile","variable":"frm_emisionNegativa_certificadoPoliza","var_uid":"73008940765655b4eed1288027962452","dataType":"multiplefile","protectedValue":false,"id":"frm_emisionNegativa_certificadoPoliza","name":"frm_emisionNegativa_certificadoPoliza","label":"Certificado Póliza","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_emisionNegativa_certificadoPoliza","colSpan":6}],[{"type":"checkgroup","variable":"frm_emisionNegativa_causales","var_uid":"76379447965655b4eeceee8052336483","dataType":"array","protectedValue":false,"id":"frm_emisionNegativa_causales","name":"frm_emisionNegativa_causales","label":"Causales de negativa","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"Prexistente","label":"Daño prexistente"},{"value":"Inexacta","label":"Declaración inexacta"},{"value":"Etilico","label":"Estado etílico"},{"value":"Fraude","label":"Fraude"},{"value":"Infraccion","label":"Infracción de tránsito"},{"value":"Licencias","label":"Licencias"},{"value":"RC","label":"No existe rc"},{"value":"Extras","label":"No extras declarados"},{"value":"Interes","label":"No interés asegurable"},{"value":"Poliza","label":"No existe póliza"},{"value":"Rastreo","label":"No posee rastreo satelital"},{"value":"Sentencia","label":"Rc bajo sentencia"},{"value":"Autorizacion","label":"Reparación sin autorización"},{"value":"Extemporaneo","label":"Reporte extemporáneo"},{"value":"Llantas","label":"Rotura de llantas"},{"value":"PTRC","label":"Solo cobertura de pt y rc"},{"value":"Distinto","label":"Uso distinto póliza"},{"value":"Transportado","label":"Vehículo transportado"}],"var_name":"frm_emisionNegativa_causales","colSpan":6},{"type":"dropdown","variable":"frm_emisionNegativa_ciudad","var_uid":"69876868065655b4eed2820073156904","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_ciudad","name":"frm_emisionNegativa_ciudad","label":"Ciudad del siniestro","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_DtaCant","options":[],"var_name":"frm_emisionNegativa_ciudad","colSpan":6}],[{"type":"dropdown","variable":"frm_emisionNegativa_cobertura","var_uid":"73194069265655b4eed4927017380712","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_cobertura","name":"frm_emisionNegativa_cobertura","label":"Cobertura Afectada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"Propios","label":"Daños Propios"},{"value":"RC","label":"Responsabilidad Civil"},{"value":"RCPropios","label":"Daños Propios y RC"}],"var_name":"frm_emisionNegativa_cobertura","colSpan":6},{"type":"dropdown","variable":"frm_emisionNegativa_jefatura","var_uid":"82140172265655b4eedbc48021250519","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_jefatura","name":"frm_emisionNegativa_jefatura","label":"Jefatura de Aprobación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT u.USR_UID, CONCAT(u.USR_FIRSTNAME, \" \", u.USR_LASTNAME) FROM GROUPWF g \nJOIN GROUP_USER gu ON g.GRP_UID = gu.GRP_UID \nJOIN USERS u ON gu.USR_UID = u.USR_UID \nWHERE gu.GRP_UID = '374863587660dd033a5bfa6041821599'\nAND u.USR_STATUS = 'ACTIVE'","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_emisionNegativa_jefatura","colSpan":6}],[{"type":"text","variable":"frm_emisionNegativa_extemporanea","var_uid":"68182467565655b4eed7a94074064369","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_extemporanea","name":"frm_emisionNegativa_extemporanea","label":"En caso de reclamo extemporaneo, indique la hora y fecha del siniestro","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_emisionNegativa_extemporanea","colSpan":12}]],"variables":[{"var_uid":"11718756765655b4eed8a84028393198","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_emisionNegativa_fechaAnalisis","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"53332864965655b4eed59d5001182891","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_emisionNegativa_condicionesGenerales","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"v