        <pro_uid>76661804465655b4bdffbc2081200894</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[76661804465655b4bdffbc2081200894/13048492165655b4ed69be3029064099]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13048492165655b4ed69be3029064099","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n//$(\"#tri_id_stro\").setValue(\"12345\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#app_number_padre\").getValue());\n\n// Número de reclamo real (viene del SISE, vía @@frm_numero_reclamo_sise)\nvar reclamoReal = String($(\"#frm_numero_reclamo_sise\").getValue() || '').trim();\n\nif (reclamoReal == '') {\n    reclamoReal = 'XXXX';\n    $(\"#frm_numero_reclamo_sise\").setValue(reclamoReal);\n}\n\nif (reclamoReal.toUpperCase().indexOf('XXXX') === 0) {\n    // Aún no se ha logrado consultar / hubo un error\n    $(\"#nro-reclamo-real\").html('Consultando...');\n} else {\n    $(\"#nro-reclamo-real\").html(''+reclamoReal);\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>INTEGRACIÓN:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"nro-stro\"></strong></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-alert-circled\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"nro-reclamo-real\"></strong></span>\n    </div>\n  </div>\n</div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"49544138865658539b71d72085132355","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"85256800865658539bb0651098135575","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"70874789365655b4f012b92099486659","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"26943165765655b4f015ce2015234217","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"39155452865655b4f016cc7001174890","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"type":"hidden","variable":"app_number_padre","var_uid":"7852099926893ae7a55a631036488759","dataType":"string","protectedValue":false,"id":"app_number_padre","name":"app_number_padre","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"app_number_padre","colSpan":2}],[{"type":"hidden","variable":"frm_numero_reclamo_sise","var_uid":"7718852366a4bcfc89383d1048826930","dataType":"string","protectedValue":false,"id":"frm_numero_reclamo_sise","name":"frm_numero_reclamo_sise","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_reclamo_sise","colSpan":2},{"type":"hidden","variable":"frm_numero_reporte_sise","var_uid":"6579736476a4bcfc8a27361073272628","dataType":"string","protectedValue":false,"id":"frm_numero_reporte_sise","name":"frm_numero_reporte_sise","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_reporte_sise","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"49544138865658539b71d72085132355","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"825131544655d966690baf3008380613"},{"var_uid":"85256800865658539bb0651098135575","prj_uid":"76661804465655b4bdff