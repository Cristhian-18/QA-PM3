ndsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"# Parte"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"60","width":100,"title":"Descripción"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"PROFORMA","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_valoresSiniestros","label":"<span class=\"subtitulo\" id=\"isub_valores_siniestro\" subform=\"48813423665655b4ed48ac5080424075\"> <i class=\"glyphicon glyphicon-minus\"></i> \nValores de siniestros</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"48813423665655b4ed48ac5080424075","name":"SubForm Valores Siniestro","description":"SubForm Valores Siniestro","mode":"edit","script":{"type":"js","code":"$(\"#frm_valoresSiniestro_procentajeDescuentoProformado\").setOnchange(function(newVal, oldVal) {\n\n  let max = 100;\n  let min = 0;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_procentajeDescuentoProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_valoresRepuestos1\").setOnchange(function(newVal, oldVal) {\n\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_valoresRepuestos1\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_valorRepuestosProformado\").setOnchange(function(newVal, oldVal) {\n\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_valorRepuestosProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_manoObraProformada\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_totalProformado\").setOnchange(function(newVal, oldVal) {\n\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setOnchange(function(newVal, oldVal) {\n\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setValue(value);\n})\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"79366641365655b4ef34609086555635","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado","var_uid":"36046509665655b4ef324d0028864089","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_procentajeDescuentoProformado","name":"frm_valoresSiniestro_procentajeDescuentoProformado","label":"Procentaje Descuento","tabIndex":"