9be7083902536","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_vehiculo_color","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_detalle","label":"<span class=\"subtitulo\" id=\"isubt_detalle\" subform=\"41209453665655b4ed71780023900709\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDetalle de daños</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"41209453665655b4ed71780023900709","name":"SubForm Datos Daños","description":"SubForm Datos Daños","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"textarea","variable":"frm_danios_detalle","var_uid":"77416560165655b4eeb52c9061020017","dataType":"string","protectedValue":false,"id":"frm_danios_detalle","name":"frm_danios_detalle","label":"Detalle de los daños","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"disabled","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_danios_detalle","colSpan":12}]],"variables":[{"var_uid":"77416560165655b4eeb52c9061020017","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_danios_detalle","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_docs","label":"Documentos del caso\n","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"75921207865655b4ed5b3c1053457518","name":"SubForm Documentos del caso","description":"SubForm Documentos del caso","mode":"edit","script":{"type":"js","code":"var host        = PMDynaform.getHostName();\nvar ws          = PMDynaform.getWorkspaceName();\nvar app_uid     = frames.app_uid       ? frames.app_uid       : '';\nvar app_uid_padre = $(\"#app_uid_rc\").getValue() || ''; // campo del dynaform con el UID padre\n\n$(function(){\n    var numero_columna_link = 5;\n\n    // Refrescar links existentes\n    for (var i = 1; i <= $(\"#gridDocumentos\").getNumberRows(); i++) {\n        var url = $(\"#gridDocumentos\").getValue(i, numero_columna_link);\n        $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n    }\n\n    // Si los enlaces están vacíos, cargar automáticamente\n    var primerEnlace = $(\"#gridDocumentos\").getValue(1, numero_columna_link);\n    if (!primerEnlace || primerEnlace.trim() === '') {\n        cargarDocumentos();\n    }\n\n    $('#historial_comentarios').html($('#tri_comentarios').getValue());\n    $('#tabla-comentarios').dataTable({\n        dom: 'Bfrtip',\n        buttons: ['copyHtml5', 'excelHtml5', 'csvHtml5', 'pdfHtml5'],\n        \"language\": {\n            \"url\": \"/plugin/phsoluciones/core_librerias/datatables/spanish.json\"\n        }\n    });\n});\n\nfunction cargarDocumentos() {\n    if (!app_uid) return;\n\n    // Leer app_uid_padre en el momento de ejecutar (puede que cargue después)\n    var uid_padre = $(\"#app_uid_rc\").getValue() || '';\n\n    $.ajax({\n        url: host + \"/syscertificacion/es/3sesa/beesmartec/services/siniestrosVeh/consultar_documentos/obtener_enlaces_rc.php\"\n             + \"?app_uid=\" + app_uid\n             + \"&app_uid_padre=\" + uid_padre,\n        type: \"GET\",\n        dataType: \"json\",\n        success: function(response) {\n            if (!response.success || !response.documentos.length) return;\n            llenarGridDocumentos(response.documentos,         \"gridDocumentos\");\n            llenarGridDocumentos(response.documentos_cliente, \"gridDocumentos_cliente\");\n        },\n        error: function(xhr, status, error) {\n            console.error(\"Error cargando documentos RC:\", error);\n        }\n    });\n}\n\nfunction llenarGridDocumentos(docs, gridId) {\n    // Vaciar visualmente\n    var totalFilas = $(\"#\" + gridId).getNumberRows();\n    for (var i = totalFilas; i > 1; i--) {\n        $(\"#\" + gridId).deleteRow(i);\n    }\n    for (var c = 1; c <= 5; c++) {\n        $(\"#\" + gridId).setValue(\"\", 1, c);\n    }\n    // Llenar\n    $.each(docs, function(i, doc) {\n        if (i === 0) {\n            $(\"#\" + gridId).setValue(doc.fecha,      1, 1);\n            $(\"#\" + gridId).setValue(doc.archivo,    1, 2);\n            $(\"#\" + gridId).setValue(doc.comentario, 1, 3);\n            $(\"#\" + gridId).setValue(doc.usuario,    1, 4);\n            $(\"#\" + gridId).setValue(doc.descarga,   1, 5);\n        } else {\n            $(\"#\" + gridId).addRow([\n                {value: doc.fecha},\n                {value: doc.archivo},\n                {value: doc.comentario},\n                {value: doc.usuario},\n                {value: doc.descarga}\n            ]);\n        }\n    });\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"hidden","variable":"app_uid_rc","var_uid":"6864216526732c638f412b4091378487","dataType":"string","protectedValue":false,"id":"app_uid_rc","name":"app_uid_rc","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"app_uid_rc","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}],[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo"