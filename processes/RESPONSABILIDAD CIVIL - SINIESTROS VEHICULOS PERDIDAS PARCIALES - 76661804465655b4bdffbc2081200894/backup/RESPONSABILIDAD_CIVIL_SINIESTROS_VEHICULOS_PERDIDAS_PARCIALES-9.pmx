      <record>
        <tri_uid>53901131465655b4eddc954063708793</tri_uid>
        <tri_title>Obtener datos uid RC</tri_title>
        <tri_description>Obtener datos uid RC</tri_description>
        <pro_uid>76661804465655b4bdffbc2081200894</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//Jean

$newCaseId = @@app_uid_rc;
$c         = new Cases();
