        <dyn_content><![CDATA[{"name":"Form 3 Validar Informaci\u00f3n Siniestro - Analistas","description":"Form 3 Validar Informaci\u00f3n Siniestro - Analistas","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"27699629265655b4ed66e33027260905","name":"Form 3 Validar Informaci\u00f3n Siniestro - Analistas","description":"Form 3 Validar Informaci\u00f3n Siniestro - Analistas","mode":"edit","script":{"type":"js","code":"$(\"#repuestos\").hide();\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACI\u00d3N SINIESTROS VEH\u00cdCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"49220356465655b4ed7c383098421016","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'documentos':\n            $(\"#subt_docs\").show();\n            $(\"#75921207865655b4ed5b3c1053457518\").show();\n            break;\n        case 'repuestos':\n            $(\"#subt_docs\").show();\n            $(\"#75921207865655b4ed5b3c1053457518\").show();\n            break;\n        case 'historial':\n            $(\"#sbt_historial\").show();\n            $(\"#79094655365655b4ed40d17058683087\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n    $(\"#sub_busqueda\").hide();\n    $(\"#60259283965655b4ed68cb6009778512\").hide();\n    $(\"#subt_vehiculo\").hide();\n    $(\"#17569986565655b4ed8c995023188336\").hide();\n    $(\"#subt_asegurado\").hide();\n    $(\"#76241453365655b4ed3ad27050479402\").hide();\n    $(\"#subt_detalle\").hide();\n    $(\"#41209453665655b4ed71780023900709\").hide();\n    $(\"#subt_registro\").hide();\n    $(\"#44056937965655b4ed42c0405466945