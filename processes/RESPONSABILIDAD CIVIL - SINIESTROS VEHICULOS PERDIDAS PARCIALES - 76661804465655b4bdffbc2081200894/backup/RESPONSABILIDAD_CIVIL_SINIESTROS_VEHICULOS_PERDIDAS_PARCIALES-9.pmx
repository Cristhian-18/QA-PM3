        <dyn_content><![CDATA[{"name":"SubForm Analisis de Cobertura","description":"SubForm Analisis de Cobertura","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"75783003565655b4ed584d5025482593","name":"SubForm Analisis de Cobertura","description":"SubForm Analisis de Cobertura","mode":"edit","script":{"type":"js","code":"console.log($(\"#frm_taller\").getValue());\nconsole.log(\"SHOW1\");\n\nif($(\"#frm_taller\").getValue() == 'MUNDO MOTRIZ SA'){\n  console.log(\"SI\");\n  $(\"#frm_analisisCobertura_analisisTecnico\").setValue('NO');\n} else {\n    console.log(\"NO\");\n\n  $(\"#frm_analisisCobertura_analisisTecnico\").setValue('SI');\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"datetime","variable":"frm_analisisCoberturas_fecha","var_uid":"67314412265655b4ee7ff46042497281","dataType":"datetime","protectedValue":false,"id":"frm_analisisCoberturas_fecha","name":"frm_analisisCoberturas_fecha","label":"Fecha Último Documento","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"@@today","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_analisisCoberturas_fecha","colSpan":6},{"colSpan":6}],[{"type":"dropdown","variable":"frm_analisisCobertura_superaDeducible","var_uid":"35550070465655b4ee83f66008739912","dataType":"string","protectedValue":false,"id":"frm_analisisCobertura_superaDeducible","name":"frm_analisisCobertura_superaDeducible","label":"¿El Reclamo supera el Deducible?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_analisisCobertura_superaDeducible","colSpan":6},{"type":"dropdown","variable":"frm_analisisCobertura_analisisTecnico","var_uid":"40456443865655b4ee82ef2027550198","dataType":"string","protectedValue":false,"id":"frm_analisisCobertura_analisisTecnico","name":"frm_analisisCobertura_analisisTecnico","label":"¿Requiere Análisis Técnico?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_analisisCobertura_analisisTecnico","colSpan":6}]],"variables":[{"var_uid":"67314412265655b4ee7ff46042497281","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_analisisCoberturas_fecha","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35550070465655b4ee83f66008739912","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_analisisCobertura_superaDeducible","var_field_type":"string","var_fi