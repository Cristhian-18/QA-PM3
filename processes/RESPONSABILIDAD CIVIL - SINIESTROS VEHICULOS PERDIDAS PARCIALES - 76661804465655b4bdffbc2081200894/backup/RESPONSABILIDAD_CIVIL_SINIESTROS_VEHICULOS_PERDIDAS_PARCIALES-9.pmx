        <dyn_content><![CDATA[{"name":"SubForm Añadir Alcance adicional","description":"SubForm Añadir Alcance adicional","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"30054645565655b4ed52671075267205","name":"SubForm Añadir Alcance adicional","description":"SubForm Añadir Alcance adicional","mode":"edit","script":{"type":"js","code":"$(\"#frm_alcanceAdicional_valorRepuestos\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorRepuestos\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_valorMano\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorMano\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_total\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_total\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_alcanceAdicional_valorRepuestos","var_uid":"30374002965655b4ee77ea5079049488","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorRepuestos","name":"frm_alcanceAdicional_valorRepuestos","label":"Valor de Repuestos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorRepuestos","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorMano","var_uid":"80084716265655b4ee75e22017718003","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorMano","name":"frm_alcanceAdicional_valorMano","label":"Valor de Mano de Obra","tabIndex":"","defaultValue":""