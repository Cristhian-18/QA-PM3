name":"SubForm Gestión Cotizacion Mundo Partes","description":"SubForm Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal) {\r\n    let rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\r\n    console.log(rowNum);\r\n\r\n    for (let i = 1; i <= rowNum; i++) {\r\n        // PVP - columna 5\r\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i, 5);\r\n        pvp = roundToFixed(pvp, 2);\r\n        $(\"#grd_valores_siniestros\").setValue(i, 5, pvp);\r\n\r\n        // Días entrega - columna 6\r\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i, 6);\r\n        dias_entrega = roundToFixed(dias_entrega, 0);\r\n        $(\"#grd_valores_siniestros\").setValue(i, 6, dias_entrega);\r\n    }\r\n}\r\n\r\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\r\n$('#grd_valores_siniestros').change(checkGrid);\r\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"88148785665655b4f009b38058926416","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","l