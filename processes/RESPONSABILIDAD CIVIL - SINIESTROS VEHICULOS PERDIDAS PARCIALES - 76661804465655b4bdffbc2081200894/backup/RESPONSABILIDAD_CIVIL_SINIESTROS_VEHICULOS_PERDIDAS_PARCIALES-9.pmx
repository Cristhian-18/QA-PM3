        <dyn_content><![CDATA[{"name":"Form 2 Validar Informaci\u00f3n Siniestro - Comercial","description":"Form 2 Validar Informaci\u00f3n Siniestro - Comercial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"18429265165655b4ed4d850025529336","name":"Form 2 Validar Informaci\u00f3n Siniestro - Comercial","description":"Form 2 Validar Informaci\u00f3n Siniestro - Comercial","mode":"edit","script":{"type":"js","code":"$(\"#repuestos\").hide();\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACI\u00d3N SINIESTROS VEH\u00cdCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"49220356465655b4ed7c383098421016","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'documentos':\n            $(\"#subt_docs\").show();\n            $(\"#75921207865655b4ed5b3c1053457518\").show();\n            break;\n        case 'repuestos':\n            $(\"#subt_docs\").show();\n            $(\"#75921207865655b4ed5b3c1053457518\").show();\n            break;\n        case 'historial':\n            $(\"#sbt_historial\").show();\n            $(\"#79094655365655b4ed40d17058683087\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n    $(\"#sub_busqueda\").hide();\n    $(\"#60259283965655b4ed68cb6009778512\").hide();\n    $(\"#subt_vehiculo\").hide();\n    $(\"#17569986565655b4ed8c995023188336\").hide();\n    $(\"#subt_asegurado\").hide();\n    $(\"#76241453365655b4ed3ad27050479402\").hide();\n    $(\"#subt_detalle\").hide();\n    $(\"#41209453665655b4ed71780023900709\").hide();\n    $(\"#subt_registro\").hide();\n    $(\"#44056937965655b4ed42c04054669455\").hide();\n    $(\"#subt_gestionTaller\").hide();\n    $(\"#16138142065655b4ed73766092455273\").hide();\n    $(\"#isubt_pe_afectados\").hide();\n    $(\"#43602034065655b4ed6ca46084965014\").hide();\n    $(\"#iisubt_pr_afectados\").hide();\n    $(\"#46533585865655b4ed84dd4018270742\").hide();\n    $(\"#sub_docs\").hide();\n    $(\"#98325375965655b4ed45b13092827388\").hide();\n    $(\"#sub_valores\").hide();\n    $(\"#51718349165655b4ed81039097317111\").hide();\n    $(\"#subt_docs\").hide();\n    $(\"#75921207865655b4ed5b3c1053457518\").hide();\n    $(\"#sbt_historial\").hide();\n    $(\"#79094655365655b4ed40d17058683087\").hide();\n    $(\"#subt_poliza\").hide();\n    $(\"#28358068365655b4ed35473079795674\").hide();\n    $(\"#subt_hsiniestros\").hide();\n    $(\"#47330327665655b4ed38dc0072757607\").hide();\n    $(\"#subt_ppolicial\").hide();\n    $(\"#57796621765655b4ed83ea3082357963\").hide();\n    $(\"#subt_direccionador\").hide();\n    $(\"#83210580965655b4ed546d3053710376\").hide();\n    $(\"#subt_friss\").hide();\n    $(\"#95547977665655b4ed87ca6055466913\").hide();\n    $(\"#subt_accidente\").hide();\n    $(\"#31053789365655b4ed53799071011166\").hide();\n    $(\"#subt_valoresSiniestros\").hide();\n    $(\"#48813423665655b4ed48ac5080424075\").hide();\n    $(\"#isubt_pe_afectados\").hide();\n    $(\"#43602034065655b4ed6ca46084965014\").hide();\n    $(\"#iisubt_pr_afectados\").hide();\n    $(\"#46533585865655b4ed84dd4018270742\").hide();\n    $(\"#81475448765655b4ed746c3049785877\").hide();\n    $(\"#subt_documentosTaller\").hide();\n    $(\"#13053029065655b4ed8da75032156816\").hide();\n    $(\"#subt_tallerAsignado\").hide();\n    $(\"#43198352265655b4ed78569007990565\").hide();\n    $(\"#subt_accesoriosRegistrados\").hide();\n    $(\"#43015877965655b4ed7d2a1016407207\").hide();\n    \n\n}\nfunction mostrar_solicitud() {\n    $(\"#sub_busqueda\").show();\n    $(\"#60259283965655b4ed68cb6009778512\").show();\n    $(\"#subt_vehiculo\").show();\n    $(\"#17569986565655b4ed8c995023188336\").show();\n    $(\"#subt_asegurado\").show();\n    $(\"#76241453365655b4ed3ad27050479402\").show();\n    $(\"#subt_gestionTaller\").show();\n    $(\"#16138142065655b4ed73766092455273\").show();\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#43602034065655b4ed6ca46084965014\").show();\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#46533585865655b4ed84dd4018270742\").show();\n    $(\"#sub_docs\").show();\n    $(\"#98325375965655b4ed45b13092827388\").show();\n    $(\"#sub_valores\").show();\n    $(\"#51718349165655b4ed81039097317111\").show();\n    $(\"#subt_poliza\").show();\n    $(\"#28358068365655b4ed35473079795674\").show();\n    $(\"#subt_hsiniestros\").show();\n    $(\"#47330327665655b4ed38dc0072757607\").show();\n    $(\"#subt_ppolicial\").show();\n    $(\"#57796621765655b4ed83ea3082357963\").show();\n    $(\"#subt_valoresSiniestros\").show();\n    $(\"#48813423665655b4ed48ac5080424075\").show();\n    $(\"#subt_friss\").show();\n    $(\"#95547977665655b4ed87ca6055466913\").show();\n    $(\"#subt_accidente\").show();\n    $(\"#31053789365655b4ed53799071011166\").show();\n    $(\"#subt_documentosTaller\").show();\n    $(\"#13053029065655b4ed8da75032156816\").show();\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#43602034065655b4ed6ca46084965014\").show();\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#46533585865655b4ed84dd4018270742\").show();\n    $(\"#81475448765655b4ed746c3049785877\").show();\n    $(\"#subt_detalle\").show();\n    $(\"#41209453665655b4ed71780023900709\").show();\n    $(\"#subt_tallerAsignado\").hide();\n    $(\"#43198352265655b4ed78569007990565\").hide();\n\n}\n\nocultar_todo();\nmostrar_solicitud();\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud<\/h4><\/a><\/li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos<\/h4><\/a><\/li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos<\/h4><\/a><\/li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13048492165655b4ed69be3029064099","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"\/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*\/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"\/plugin\/beesmartec\/core_librerias\/js_externos\/app.min.js,\n\n\/plugin\/beesmartec\/core_librerias\/css_externos\/AdminLTE.min.css, \/plugin\/beesmartec\/core_librerias\/ionicons-2.0.1\/css\/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"><\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"><\/i><\/span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"><\/i><\/span>\n\n    <div class=\"info-box-content\">\n      <span cl