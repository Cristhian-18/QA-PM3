_uid":"90341478065655b4eec5959066328235","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_deducible_ValorMinimo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
