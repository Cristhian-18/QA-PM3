iable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_observaciones","name":"frm_gvs_observaciones","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Observaciones"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_estado","name":"frm_gvs_estado","label":"estado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"Aprobado","label":"Aprobado"},{"value":"Negado","label":"Negado"}],"columnWidth":"10","width":100,"title":"estado"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"PROFORMA","colSpan":12}]],"variables":[]}]}]]></dyn_content>
