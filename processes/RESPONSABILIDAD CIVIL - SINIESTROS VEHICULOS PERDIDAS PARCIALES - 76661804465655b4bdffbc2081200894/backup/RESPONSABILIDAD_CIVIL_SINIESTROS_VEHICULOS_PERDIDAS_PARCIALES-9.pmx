        <dyn_content><![CDATA[{"name":"Form 6.2 Aprobación Importación Alcance","description":"Form 6.2 Aprobación Importación Alcance","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"202857296657093bb526e74088658287","name":"Form 6.2 Aprobación Importación Alcance","description":"Form 6.2 Aprobación Importación Alcance","mode":"edit","script":{"type":"js","code":"let numberRows = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n\n$(\"#grd_valores_siniestros_alcance\").hideColumn(5);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(7);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(8);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(9);\n\nlet rows = $(\".pmdynaform-grid-row\");\nlet length = $(\".pmdynaform-grid-row\").length-1;\n\nlet negados = $(\"option[value='Negado']\");\nlet pendientes = $(\"option[value='Pendiente']\");\n\nfor (let i = 0; i <= length; i++) {\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 3).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 4).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 5).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 6).attr('disabled', true)\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 7).attr('disabled', true)\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 8).attr('disabled', true)\n\n    if(($(\"#grd_valores_siniestros_alcance\").getValue(i+1, 11))!=\"Pendiente\"){\n        $(rows[i]).hide();\n    } else {\n        $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 11).attr('required', true)\n        $(negados[i]).hide();\n        $(pendientes[i]).hide();\n    }\n\n}\n\n/*$(\"option[value='Negado']\").remove();\n$(\"option[value='Pendiente']\").remove();*/\n\nlet isBoss = confirm(\"Estimado cliente: \\nPor favor, apruebe la importación de los siguientes repuestos o en su defecto solicite su indemnización, en caso de no seleccionar ninguno de los dos se aprobarán por defecto\");\n\ndocument.onload = function () {\nalert( isBoss );\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACIÓN SINIESTROS VEHÍCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13048492165655b4ed69be3029064099","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#tri_id_stro\").setValue(\"12345\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-2 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID PRINCIPAL:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-2 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-2 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"49544138865658539b71d72085132355","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"85256800865658539bb0651098135575","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"70874789365655b4f012b92099486659","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"26943165765655b4f015ce2015234217","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"39155452865655b4f016cc7001174890","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"49544138865658539b71d72085132355","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"825131544655d966690baf3008380613"},{"var_uid":"85256800865658539bb0651098135575","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"825131544655d966690baf3008380613"},{"var_uid":"70874789365655b4f012b92099486659","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_bandera_parcial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"744477976655d9669be74f6093940827","var_name_old":"tri_bandera_parcial","prj_uid_old":"825131544655d966690baf3008380613","create":false},{"var_uid":"26943165765655b4f015ce2015234217","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"266725094655d9669beaa69064696809","var_name_old":"tri_imp_monto_estimado","prj_uid_old":"825131544655d966690baf3008380613","create":false},{"var_uid":"39155452865655b4f016cc7001174890","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"723045930655d9669bebbd7044632151","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"825131544655d966690baf3008380613","create":false}],"colSpan":12}],[{"type":"subtitle","id":"sub_repuestos","label":"Gestión de repuestos1","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000001","label":"Estimado cliente:","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000002","label":"Por favor, apruebe la importación de los siguientes repuestos o en su defecto solicite su indemnización, en caso de no seleccionar ninguno de los dos se aprobarán por defecto","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Para confirmar la importación por favor seleccione en \"ESTADO\"","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"10860191065655b4ed51747094306214","name":"SubForm Alcance Gestión Cotizacion Mundo Partes","description":"SubForm Alcance Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal){\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        let pvp = $(\"#grd_valores_siniestros_alcance\").getValue(i,5);\n        pvp = roundToFixed(pvp, 2);\n        $(\"#grd_valores_siniestros_alcance\").setValue(pvp,i,5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros_alcance\").getValue(i,6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros_alcance\").setValue(dias_entrega,i,6);\n    }\n}\n\ncheckGrid($(\"#grd_valores_siniestros_alcance\").getValue(), '');\n$('#grd_valores_siniestros_alcance').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros_alcance","var_uid":"94629264365655b4f00ab20019050519","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros_alcance","name":"grd_valores_siniestros_alcance","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad_1","name":"frm_gvs_cantidad_1","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"Cantidad","var_name":"grd_valores_siniestros_alcance"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte_1","name":"frm_gvs_nparte_1","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConn