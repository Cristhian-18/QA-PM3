none;\">\n    <div class=\"info-box box box-primary\"> \n      <span class=\"info-box-icon bg-yellow\"><i class=\"ion ion-clock\"></i></span>\n      <div class=\"info-box-content\">\n        <span class=\"info-box-text\"><strong>ESTADO:</strong></span>\n        <span class=\"info-box-number\"><strong id=\"estado-stro\"></strong></span>\n      </div>\n    </div>\n  </div>\n</div>","border":"1px","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000002","label":"INFORMACIÓN ADICIONAL","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"frm_busqueda_nombres","var_uid":"40078910865655b4eea1d82081412745","dataType":"string","protectedValue":false,"id":"frm_busqueda_nombres","name":"frm_busqueda_nombres","label":"Propietario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_busqueda_nombres","colSpan":12}],[{"type":"textarea","variable":"frm_taller","var_uid":"26148202965655b4ef108b2011712820","dataType":"string","protectedValue":false,"id":"frm_taller","name":"frm_taller","label":"Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_taller","colSpan":6},{"type":"textarea","variable":"frm_ruc_taller","var_uid":"1108157216a5a5a6a2009f2053274230","dataType":"string","protectedValue":false,"id":"frm_ruc_taller","name":"frm_ruc_taller","label":"Ruc Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","val