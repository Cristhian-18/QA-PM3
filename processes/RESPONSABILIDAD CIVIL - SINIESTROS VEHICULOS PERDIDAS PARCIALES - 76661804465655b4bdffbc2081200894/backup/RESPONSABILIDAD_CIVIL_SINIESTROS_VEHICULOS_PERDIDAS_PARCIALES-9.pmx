        <dyn_content><![CDATA[{"name":"SubForm Documentos Cotizacion evidencias","description":"SubForm Documentos Cotizacion evidencias","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13053029065655b4ed8da75032156816","name":"SubForm Documentos Cotizacion evidencias","description":"SubForm Documentos Cotizacion evidencias","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"multipleFile","variable":"frm_documentos_cotizacion","var_uid":"58932542465655b4eec7b28061055511","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos_cotizacion","name":"frm_documentos_cotizacion","label":"Cotizaci\u00f3n","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_taller","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"14141887165655b4ed91b51020181948","var_name":"frm_documentos_cotizacion","colSpan":12}],[{"type":"multipleFile","variable":"frm_documentos_evidencia","var_uid":"77737608965655b4eec9b54076799353","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos_evidencia","name":"frm_documentos_evidencia","label":"Evidencia","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_taller","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"14141887165655b4ed91b51020181948","var_name":"frm_documentos_evidencia","colSpan":12}],[{"type":"multipleFile","variable":"frm_documentos_otros","var_uid":"45838379665655b4eecbd17055319014","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos_otros","name":"frm_documentos_otros","label":"Otros","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_taller","required":false,"requiredFieldErrorMessage":"