5","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_siniestro_informacionResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"806302141653aca7ed3b8b1014028540","var_name_old":"frm_siniestro_informacionResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"67293522065655b4ef07836044704039","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_siniestro_placaResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"917378942653acad9c095c7075960765","var_name_old":"frm_siniestro_placaResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"25738833465655b4ef048e0014588496","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_siniestro_nombreResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"765788563653acae2843f40000288141","var_name_old":"frm_siniestro_nombreResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false}],"colSpan":12}],[{"type":"subtitle","id":"subt_asegurado","label":"<span class=\"subtitulo\" id=\"isubt_asegurado\" subform=\"76241453365655b4ed3ad27050479402\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos Conductor</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76241453365655b4ed3ad27050479402","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"disabled","script":{"type":"js","code":"//henry\nlet tipoSolicitud = $(\"#frm_asegurado_tipo\").getValue();\nif (tipoSolicitud == 'A') {\nlet cedula = $(\"#frm_busqueda_identificacion\").getValue();\nlet nombres = $(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"28966250165655b4ee91854071269948","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_conductor_identificacion","var_uid":"613349124659e2f060d69c3099953254","dataType":"string","protectedValue":false,"id":"frm_conductor_identificacion","name":"frm_conductor_identificacion","label":"Identificación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_identificacion","colSpan":4},{"type":"text","variable":"frm_conductor_nombres","var_uid":"625686025659e2f06113124027716471","dataType":"string","protectedValue":false,"id":"frm_conductor_nombres","name":"frm_conductor_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_nombres","colSpan":8}],[{"type":"text","variable":"frm_conductor_telefono","var_uid":"236448215659e2f0614aab0019812121","dataType":"string","protectedValue":false,"id":"frm_conductor_telefono","name":"frm_conductor_telefono","label":"Teléfono","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_telefono","colSpan":4},{"type":"dropdown","variable":"frm_conductor_relacion","var_uid":"414618929659e2f0617fe55066508516","dat