        <dyn_content><![CDATA[{"name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"39128067765655b4ed89bf7000262689","name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","mode":"edit","script":{"type":"js","code":"\/\/henry"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"VALIDAR INFORMACI\u00d3N DEL SINIESTOR","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"49220356465655b4ed7c383098421016","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    switch (this.id) {\n        case 'solicitud':\n           mostrar_solicitud();\n            break;\n        case 'documentos':\n\t\t\t$(\"#subt_docs\").show();\n            $(\"#75921207865655b4ed5b3c1053457518\").show();\n            break;\n        case 'historial':\n          $(\"#sbt_historial\").show();\n          $(\"#79094655365655b4ed40d17058683087\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#60259283965655b4ed68cb6009778512\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#17569986565655b4ed8c995023188336\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#76241453365655b4ed3ad27050479402\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#41209453665655b4ed71780023900709\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#44056937965655b4ed42c04054669455\").hide();\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#93254149565655b4ed46a66057215729\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#43602034065655b4ed6ca46084965014\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#46533585865655b4ed84dd4018270742\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#98325375965655b4ed45b13092827388\").hide();\n  $(\"#sub_valores\").hide();\n  $(\"#51718349165655b4ed81039097317111\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#75921207865655b4ed5b3c1053457518\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#79094655365655b4ed40d17058683087\").hide();\n}\nfunction mostrar_solicitud(){\n  $(\"#sub_busqueda\").show();\n  $(\"#60259283965655b4ed68cb6009778512\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#17569986565655b4ed8c995023188336\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#76241453365655b4ed3ad27050479402\").show();\n  $(\"#subt_detalle\").show();\n  $(\"#41209453665655b4ed71780023900709\").show();\n  $(\"#subt_registro\").show();\n  $(\"#44056937965655b4ed42c04054669455\").show();\n  $(\"#subt_ve_afectados\").show();\n  $(\"#93254149565655b4ed46a66057215729\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#43602034065655b4ed6ca46084965014\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#46533585865655b4ed84dd4018270742\").show();\n  $(\"#sub_docs\").show();\n  $(\"#98325375965655b4ed45b13092827388\").show();\n  $(\"#sub_valores\").show();\n  $(\"#51718349165655b4ed81039097317111\").show();\n}\n\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud<\/h4><\/a><\/li> \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos<\/h4><\/a><\/li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"sub_busqueda","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"60259283965655b4ed68cb6009778512\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos asegurado<\/span>","ariaLabel":"","colSpan":1