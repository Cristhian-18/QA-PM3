,"dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_manoObraProformada","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valorRepuestosProformado","var_uid":"49380840265655b4ef2f419089764851","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valorRepuestosProformado","name":"frm_valoresAprobados_valorRepuestosProformado","label":"Mano Obra Aprobada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valorRepuestosProformado","colSpan":6}],[{"type":"text","variable":"frm_deducible_deducible","var_uid":"59913461165655b4eeb7595082856360","dataType":"string","protectedValue":false,"id":"frm_deducible_deducible","name":"frm_deducible_deducible","label":"Deducible","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_deducible_deducible","colSpan":6},{"type":"text","variable":"frm_deducible_rasa","var_uid":"41630348665655b4eebe909053659211","dataType":"string","protectedValue":false,"id":"frm_deducible_rasa","name":"frm_deducible_rasa","label":"Rasa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_deducible_rasa","colSpan":6}],[{"type":"subtitle","id":"subtitle0000000004","label":"Documentos del caso","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"75921207865655b4ed5b3c1053457518","name":"SubForm Documentos del caso","description":"SubForm Documentos del caso","mode":"edit","script":{"type":"js","code":"var host        = PMDynaform.getHostName();\nvar ws          = PMDynaform.getWorkspaceName();\nvar app_uid     = frames.app_uid       ? frames.app_uid       : '';\nvar app_uid_padre = $(\"#app_uid_rc\").getValue() || ''; // campo del dynaform con el UID padre\n\n$(function(){\n    var numero_columna_link = 5;\n\n    // Refrescar links existentes\n    for (var i = 1; i <= $(\"#gridDocumentos\").getNumberRows(); i++) {\n        var url = $(\"#gridDocumentos\").getValue(i, numero_columna_link);\n        $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n    }\n\n    // Si los enlaces están vacíos, cargar automáticamente\n    var primerEnlace = $(\"#gridDocumentos\").getValue(1, numero_columna_link);\n    if (!primerEnlace || primerEnlace.trim() === '') {\n        cargarDocumentos();\n    }\n\n    $('#historial_comentarios').html($('#tri_comentarios').getValue());\n    $('#tabla-comentarios').dataTable({\n        dom: 'Bfrtip',\n        buttons: ['copyHtml5', 'excelHtml5', 'csvHtml5', 'pdfHtml5'],\n        \"language\": {\n            \"url\": \"/plugin/phsoluciones/core_librerias/datatables/spanish.json\"\n        }\n    });\n});\n\nfunction cargarDocumentos() {\n    if (!app_uid) return;\n\n    // Leer app_uid_padre en el momento de ejecutar (puede que cargue después)\n    var uid_padre = $(\"#app_uid_rc\").getValue() || '';\n\n    $.ajax({\n        url: host + \"/syscertificacion/es/3sesa/beesmartec/services/siniestrosVeh/consultar_documentos/obtener_enlaces_rc.php\"\n             + \"?app_uid=\" + app_uid\n             + \"&app_uid_padre=\" + uid_padre,\n        type: \"GET\",\n        dataType: \"json\",\n        success: function(response) {\n            if (!response.success || !response.documentos.length) return;\n            llenarGridDocumentos(response.documentos,         \"gridDocumentos\");\n            llenarGridDocumentos(response.documentos_cliente, \"gridDocumentos_cliente\");\n        },\n        error: function(xhr, status, error) {\n            console.error(\"Error cargando documentos RC:\", error);\n        }\n    });\n}\n\nfunction llenarGridDocumentos(docs, gridId) {\n    // Vaciar visualmente\n    var totalFilas = $(\"#\" + gridId).getNumberRows();\n    for (var i = totalFilas; i > 1; i--) {\n        $(\"#\" + gridId).deleteRow(i);\n    }\n    for (var c = 1; c <= 5; c++) {\n        $(\"#\" + gridId).setValue(\"\", 1, c);\n    }\n    // Llenar\n    $.each(docs, function(i, doc) {\n        if (i === 0) {\n            $(\"#\" + gridId).setValue(doc.fecha,      1, 1);\n            $(\"#\" + gridId).setValue(doc.archivo,    1, 2);\n            $(\"#\" + gridId).setValue(doc.comentario, 1, 3);\n            $(\"#\" + gridId).setValue(doc.usuario,    1, 4);\n            $(\"#\" + gridId).setValue(doc.descarga,   1, 5);\n        } else {\n            $(\"#\" + gridId).addRow([\n                {value: doc.fecha},\n                {value: doc.archivo},\n                {value: doc.comentario},\n                {value: doc.usuario},\n                {value: doc.descarga}\n            ]);\n        }\n    });\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"hidden","variable":"app_uid_rc","var_uid":"6864216526732c638f412b4091378487","dataType":"string","protectedValue":false,"id":"app_uid_rc","name":"app_uid_rc","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"app_uid_rc","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}],[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Archivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMe