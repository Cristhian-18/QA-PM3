:false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"TRANSITO","label":"Tránsito"},{"value":"TALLER","label":"Taller"}],"var_name":"frm_gestionTaller_ubicacion","colSpan":6}]],"variables":[{"var_uid":"10130032065655b4eee82d1033309320","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_gestionTaller_fecha","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"59657074665655b4eee9479025062322","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_gestionTaller_ubicacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
