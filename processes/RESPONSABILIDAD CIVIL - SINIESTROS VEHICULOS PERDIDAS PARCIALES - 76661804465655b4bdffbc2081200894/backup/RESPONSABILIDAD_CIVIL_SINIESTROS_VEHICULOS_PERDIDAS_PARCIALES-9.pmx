ection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Tarea","var_name":"grd_historial_caso"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"usuario","name":"usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Usuario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_tranferencia","name":"f_tranferencia","label":"Fecha Tranferencia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Tranferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_inicio","name":"f_inicio","label":"Fecha Inicio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Inicio"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_fin","name":"f_fin","label":"Fecha Fin","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"non