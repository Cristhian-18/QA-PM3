=\"glyphicon glyphicon-minus\"><\/i> \nParte Policial<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"57796621765655b4ed83ea3082357963","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"\nfunction actionPartePolicial(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_siniestro_afectado\").getValue())\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'NO'){\n      if($(\"#frm_siniestro_afectado\").getValue() == \"Afectado\"){\n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      }\n    } \n}\n\nfunction actionResponsableSiniestro(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_requiere_PartePolicial\").getValue())\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'Afectado'){\n      if($(\"#frm_requiere_PartePolicial\").getValue() == \"NO\"){\n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      }\n    } \n}\n\n\/\/execute when the Dynaform loads:\nactionPartePolicial($(\"#frm_requiere_PartePolicial\").getValue(), ''); \n$('#frm_requiere_PartePolicial').setOnchange(actionPartePolicial);\n\nactionResponsableSiniestro($(\"#frm_siniestro_afectado\").getValue(), ''); \n$('#frm_siniestro_afectado').setOnchange(actionResponsableSiniestro);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"35059629565655b4eefe875085996297","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"29901219265655b4eefd795042239054","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"radio","variable":"frm_siniestro_afectado","var_uid":"27993478565655b4ef00932095567642","dataType":"string","protectedValue":false,"id":"frm_siniestro_afectado","name":"frm_siniestro_afectado","label":"\u00bfA juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel"