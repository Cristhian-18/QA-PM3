        <dyn_content><![CDATA[{"name":"Form 3 Generar Cotización","description":"Form 3 Generar Cotización","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"40954217265655b4ed33b81085969831","name":"Form 3 Generar Cotización","description":"Form 3 Generar Cotización","mode":"edit","script":{"type":"js","code":"$(\"#grd_valores_siniestros\").hideColumn(11);\n$(\"#grd_valores_siniestros\").hideColumn(9);\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#75921207865655b4ed5b3c1053457518').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#79094655365655b4ed40d17058683087').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $('#17206049365655b4ed499f4054369527').show()\n        $('#57719423965655b4ed5e193039723079').show()\n        $('#subt_documentos_cotizacion').show()\n        $('#11357093065655b4ed85e43013712128').show()\n        \n        \n        break\n    }\n  })\n  \n  function ocultar_todo() {\n    $('#subt_friss').hide()\n    $('#95547977665655b4ed87ca6055466913').hide()\n    $('#43198352265655b4ed78569007990565').hide()\n    $('#subt_tallerAsignado').hide()\n    $('#subt_ppolicial').hide()\n    $('#57796621765655b4ed83ea3082357963').hide()\n    $('#subt_accesoriosRegistrados').hide()\n    $('#43015877965655b4ed7d2a1016407207').hide()\n    $('#subt_accidente').hide()\n    $('#31053789365655b4ed53799071011166').hide()\n    $('#33327433165655b4ed6abd1080464820').hide()\n    $('#sub_busqueda').hide()\n    $('#60259283965655b4ed68cb6009778512').hide()\n    $('#subt_vehiculo').hide()\n    $('#17569986565655b4ed8c995023188336').hide()\n    $('#subt_asegurado').hide()\n    $('#76241453365655b4ed3ad27050479402').hide()\n    $('#subt_detalle').hide()\n    $('#41209453665655b4ed71780023900709').hide()\n    $('#subt_registro').hide()\n    $('#44056937965655b4ed42c04054669455').hide()\n    $('#subt_ve_afectados').hide()\n    $('#93254149565655b4ed46a66057215729').hide()\n    $('#isubt_pe_afectados').hide()\n    $('#43602034065655b4ed6ca46084965014').hide()\n    $('#iisubt_pr_afectados').hide()\n    $('#46533585865655b4ed84dd4018270742').hide()\n    $('#sub_docs').hide()\n    $('#98325375965655b4ed45b13092827388').hide()\n    $('#sub_valores').hide()\n    $('#51718349165655b4ed81039097317111').hide()\n    $('#subt_docs').hide()\n    $('#75921207865655b4ed5b3c1053457518').hide()\n    $('#sbt_historial').hide()\n    $('#79094655365655b4ed40d17058683087').hide()\n    $('#subt_poliza').hide()\n    $('#28358068365655b4ed35473079795674').hide()\n    $('#sub_repuestos').hide()\n    $('#57719423965655b4ed5e193039723079').hide()\n    $('#subt_hsiniestros').hide()\n    $('#47330327665655b4ed38dc0072757607').hide()\n\n    $('#subt_direccionador').hide()\n    $('#83210580965655b4ed546d3053710376').hide()\n    $('#subt_documentosTaller').hide()\n    $('#13053029065655b4ed8da75032156816').hide()\n    $('#subt_gestionTaller').hide()\n    $('#16138142065655b4ed73766092455273').hide()\n    $('#subt_valoresSiniestros').hide()\n    $('#48813423665655b4ed48ac5080424075').hide()\n    $('#subt_documentos_cotizacion').hide()\n    $('#11357093065655b4ed85e43013712128').hide()\n    \n    \n  }\n  function mostrar_solicitud() {\n    $('#subt_friss').show()\n    $('#95547977665655b4ed87ca6055466913').show()\n    $('#43198352265655b4ed78569007990565').show()\n    $('#subt_tallerAsignado').show()\n    $('#subt_ppolicial').show()\n    $('#57796621765655b4ed83ea3082357963').show()\n    $('#subt_accesoriosRegistrados').show()\n    $('#43015877965655b4ed7d2a1016407207').show()\n    $('#subt_accidente').show()\n    $('#31053789365655b4ed53799071011166').show()\n  \n    $('#sub_busqueda').show()\n    $('#60259283965655b4ed68cb6009778512').show()\n    $('#subt_vehiculo').show()\n    $('#17569986565655b4ed8c995023188336').show()\n    $('#subt_asegurado').show()\n    $('#76241453365655b4ed3ad27050479402').show()\n    $('#subt_detalle').show()\n    $('#41209453665655b4ed71780023900709').show()\n    $('#subt_registro').show()\n    $('#44056937965655b4ed42c04054669455').show()\n    $('#subt_ve_afectados').show()\n    $('#93254149565655b4ed46a66057215729').show()\n    $('#isubt_pe_afectados').show()\n    $('#43602034065655b4ed6ca46084965014').show()\n    $('#iisubt_pr_afectados').show()\n    $('#46533585865655b4ed84dd4018270742').show()\n    $('#sub_docs').show()\n    $('#98325375965655b4ed45b13092827388').show()\n    $('#sub_valores').show()\n    $('#51718349165655b4ed81039097317111').show()\n    $('#subt_poliza').show()\n    $('#28358068365655b4ed35473079795674').show()\n    $('#subt_historial_siniestro').show()\n    $('#47330327665655b4ed38dc0072757607').show()\n    $('#subt_direccionador').show()\n    $('#83210580965655b4ed546d3053710376').show()\n    $('#subt_documentosTaller').show()\n    $('#13053029065655b4ed8da75032156816').show()\n    $('#subt_gestionTaller').show()\n    $('#16138142065655b4ed73766092455273').show()\n    $('#subt_valoresSiniestros').show()\n    $('#48813423665655b4ed48ac5080424075').show()\n\n}\n  \n  ocultar_todo()\n  mostrar_solicitud()\n\n$(\"#40954217265655b4ed33b81085969831\").setOnSubmit(function(){\n  var aRc = $(\"#grd_valores_siniestros\").getNumberRows();\n  if($(\"#frm_accion\").getValue() == \"CONTINUAR\"){\n  for (var i=0; i <= aRc; i++) {\n      if ($(\"#grd_valores_siniestros\").getValue(i, 1) != \"\" \n      && $(\"#grd_valores_siniestros\").getValue(i, 2) != \"\"\n      && $(\"#grd_valores_siniestros\").getValue(i, 3) != \"\") {\n          if($(\"#grd_valores_siniestros\").getValue(i, 7) == \"\" || \n            $(\"#grd_valores_siniestros\").getValue(i, 7) == null){\n              alert(\"Verifique la cotización de todos los repuestos\");\n              return false;\n          }\n      }\n  }}\n  return true;\n} );\n\nfunction action(newVal, oldVal) {\n  $('#tri_user_mundopartes').hide();\n    $('#grd_valores_siniestros').enableValidation();\n\n  if (newVal == \"MANTENER\") {\n    $('#tri_user_mundopartes').show();\n        $('#grd_valores_siniestros').disableValidation();\n\n  }\n}\n\naction($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(action);\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"GENERAR COTIZACIÓN","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"49220356465655b4ed7c383098421016","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_direccionador","label":"<span class=\"subtitulo\" id=\"isubt_direccionador\" subform=\"83210580965655b4ed546d3053710376\"> <i class=\"glyphicon glyphicon-minus\"></i> \nInformación del taller</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"83210580965655b4ed546d3053710376","name":"SubForm Información delTaller","description":"SubForm Direccionador Taller","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_taller","var_uid":"26148202965655b4