"prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}]],"variables":[{"var_uid":"12757371665655b4ee73d97017770701","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"12757371665655b4ee73d97017770701","var_name_old":"frm_accion","prj_uid_old":"76661804465655b4bdffbc2081200894","create":false},{"var_uid":"95055412265655b4eeac070034106838","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"95055412265655b4eeac070034106838","var_name_old":"frm_comentario","prj_uid_old":"76661804465655b4bdffbc2081200894","create":false}]}]}]]></dyn_content>
