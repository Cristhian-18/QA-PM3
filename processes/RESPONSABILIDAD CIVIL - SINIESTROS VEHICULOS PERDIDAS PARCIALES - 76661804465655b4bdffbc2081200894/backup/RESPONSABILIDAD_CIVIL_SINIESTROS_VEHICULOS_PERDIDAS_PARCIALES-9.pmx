        <dyn_content><![CDATA[{"name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"98325375965655b4ed45b13092827388","name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","mode":"edit","script":{"type":"js","code":"\/\/$('#frm_documentos_check').setOnchange(checkCanton); \/\/execute when field's value changes\n\n$(\"#frm_documentos_check\").setOnchange(function (newVal, oldVal) {\n  $('#fle_matricula').disableValidation();\n  $('#fle_cedula').disableValidation();\n  $('#fle_licencia').disableValidation();\n  $('#fle_denuncia').disableValidation();\n  $('#fle_partePolicial').disableValidation();\n\n\n  if (newVal == \"SI\") {\n    $('#fle_matricula').enableValidation();\n    $('#fle_cedula').enableValidation();\n    $('#fle_licencia').enableValidation();\n    $('#fle_denuncia').enableValidation();\n    $('#fle_partePolicial').enableValidation();\n\n  }\n\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_documentos_check","var_uid":"24814120665655b4eec6b05038179500","dataType":"string","protectedValue":false,"id":"frm_documentos_check","name":"frm_documentos_check","label":"\u00bfCuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_documentos_check","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Documentos obligatorios","ariaLabel":"","colSpan":6},{"colSpan":1},{"colSpan":5}],[{"type":"multipleFile","variable":"file_matricula_RC","var_uid":"67048509165664b5fd048d2091219258","dataType":"multiplefile","protectedValue":false,"id":"file_matricula_RC","name":"file_matricula_RC","label":"Copia de matr\u00edcula del veh\u00edculo afectado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"99018233265655b4ed8ff38088415826","var_name":"file_matricula_RC","colSpan":6},{"colSpan":6}],[{"type":"multipleFile","variable":"file_licencia_RC","var_uid":"7823929916567ac84166ea6019314163","dataType":"multiplefile","protectedValue":false,"id":"file_licencia_RC","name":"file_licencia_RC","label":"Copia de licencia de la persona que estaba conduciendo el veh\u00edculo en el momento del siniestro","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"99018233265655b4ed8ff38088415826","var_name":"file_licencia_RC","colSpan":6},{"colSpan":6}],[{"type":"multipleFile","variable":"file_cedula_RC","var_uid":"1672844716567ac93e82548017198065","dataType":"multiplefile","protectedValue":false,"id":"file_cedula_RC","name":"file_cedula_RC","label":"Copia de c\u00e9dula del afectado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"99018233265655b4ed8ff38088415826","var_name":"file_cedula_RC","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"24814120665655b4eec6b05038179500","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_documentos_check","var_field_type":"string"