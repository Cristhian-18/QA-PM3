        <dyn_content><![CDATA[{"name":"SubForm Valores Aprobados","description":"SubForm Valores Aprobados","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13230486865655b4ed57598003315291","name":"SubForm Valores Aprobados","description":"SubForm Valores Aprobados","mode":"edit","script":{"type":"js","code":"function calcularTotalProformado() {\n  let manoObra = parseFloat($(\"#frm_valoresAprobados_manoObraProformada\").getValue()) || 0;\n  let repuestos = parseFloat($(\"#frm_valoresAprobados_valorRepuestosProformado\").getValue()) || 0;\n  let total = roundToFixed(manoObra + repuestos, 2);\n  $(\"#frm_valoresAprobados_totalProformado\").setValue(total);\n}\n\nfunction calcularTotalSiniestro() {\n  let manoObra = parseFloat($(\"#frm_valoresSiniestro_manoObraProformada\").getValue()) || 0;\n  let repuestos = parseFloat($(\"#frm_valoresSiniestro_valoresRepuestos1\").getValue()) || 0;\n  let total = roundToFixed(manoObra + repuestos, 2);\n  $(\"#frm_valoresSiniestro_totalProformado\").setValue(total);\n}\n\n$(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setOnchange(function(newVal, oldVal) {\n  let max = 100;\n  let min = 0;\n  let value = limitMaxMin(newVal, max, min);\n  if (value != '') {\n    value = roundToFixed(value, 2);\n  }\n  value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_valoresRepuestos1\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(value);\n \n})\n\n$(\"#frm_valoresAprobados_valorRepuestosProformado\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valorRepuestosProformado\").setValue(value);\n \n})\n\n$(\"#frm_valoresAprobados_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_manoObraProformada\").setValue(value);\n \n})\n\n$(\"#frm_valoresSiniestro_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_manoObraProformada\").setValue(value);\n \n})\n\n$(\"#frm_valoresAprobados_totalProformado\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_diasEstimadosReparacion\").setOnchange(function(newVal, oldVal) {\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresAprobados_diasEstimadosReparacion\").setValue(value);\n})\n\ncalcularTotalProformado();\ncalcularTotalSiniestro();\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"79366641365655b4ef34609086555635","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos proforma sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valoresRepuestos1","var_uid":"23870014165655b4ef2e400055178513","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valoresRepuestos1","name":"frm_valoresAprobados_valoresRepuestos1","label":"Valores Repuestos Aprobados sin descuento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valoresRepuestos1","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado","var_uid":"36046509665655b4ef324d0028864089","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_procentajeDescuentoProformado","name":"frm_valoresSiniestro_procentajeDescuentoProformado","label":"Procentaje Descuento Proformado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_procentajeDescuentoProformado","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_procentajeDescuentoProformado","var_uid":"49024340465655b4ef2bd05075154707","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_procentajeDescuentoProformado","name":"frm_valoresAprobados_procentajeDescuentoProformado","label":"Porcentaje Descuento Aprobado ","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_procentajeDescuentoProformado","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_valorRepuestosProformado","var_uid":"38556427765655b4ef36ba6056680802","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valorRepuestosProformado","name":"frm_valoresSiniestro_valorRepuestosProformado","label":"Valor Repuestos Proformado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valorRepuestosProformado","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valorRepuestosProformado","var_uid":"49380840265655b4ef2f419089764851","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valorRepuestosProformado","name":"frm_valoresAprobados_valorRepuestosProformado","label":"Valor Repuestos Aprobados","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"frm_valoresAprobados_valoresRepuestos1*(1-(frm_valoresAprobados_procentajeDescuentoProformado/100))","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valorRepuestosProformado","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_manoObraProformada","var_uid":"55217178365655b4ef314d7066720124","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_manoObraProformada","name":"frm_valoresSiniestro_manoObraProformada","label":"Mano de Obra Proformada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_manoObraProformada","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_manoObraProformada","var_uid":"27927795365655b4ef2ac84030956460","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_manoObraProformada","name":"frm_valoresAprobados_manoObraProformada","label":"Mano Obra Aprobada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_manoObraProformada","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_diasEstimadosReparacion","var_uid":"12241559465655b4ef304e5055466843","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_diasEstimadosReparacion","name":"frm_valoresSiniestro_diasEstimadosReparacion","label":"Dias Estimados en Reparación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_diasEstimadosReparacion","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_diasEstimadosReparacion","var_uid":"21368076065655b4ef29cc0050160925","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_diasEstimadosReparacion","name":"frm_valoresAprobados_diasEstimadosReparacion",