		if ($accion == "CONTINUAR") {
			$texto .= '<p align="justify">Se le notifica que la solicitud de emisión del caso ' . $app_number . ' fue exitosa y enviada
	al cliente.</tipo>
</p>';
		} else {
			$texto .= '<p align="justify">Se le notifica que la solicitud de emisión del caso ' . $app_number . ' requiere su atneción
	en lo siguiente:
	*Observaciones* por favor gestionarlo de acuerdo a las condiciones solicitadas.
	</tipo>
</p>';
		}

		$comentario = @@frm_comentario;
		$accion = @@frm_accion;
		$plantilla_rec = 'Plantilla_mail.html';

		@@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
		$texto));

		break;

	default:

		$de = '';
		$para = @@tri_correo_desarrollador_cc;


		$asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
		$accion = @@frm_accion;
		$texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';

		if ($accion == "CONTINUAR") {
			$texto .= '<p align="justify">Se le notifica que la solicitud de emisión del caso ' . $app_number . ' fue exitosa y enviada
		al cliente.</tipo>
	</p>';
		} else {
			$texto .= '<p align="justify">Se le notifica que la solicitud de emisión del caso ' . $app_number . ' requiere su atneción
		en lo siguiente:
		*Observaciones* por favor gestionarlo de acuerdo a las condiciones solicitadas.
		</tipo>
	</p>';
		}

		$comentario = @@frm_comentario;
		$accion = @@frm_accion;
		$plantilla_rec = 'Plantilla_mail.html';

		@@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
		$texto));

		break;
}
]]></tri_webbot>
