formación al Cliente"},{"value":"ACTUALIZAR","label":"Mantener en la gestión del analista"}],"var_name":"frm_accion","colSpan":12}],[{"type":"text","variable":"frm_correo_cliente","var_uid":"80788882465655b4eeb32d9046262054","dataType":"string","protectedValue":false,"id":"frm_correo_cliente","name":"frm_correo_cliente","label":"Correo del asegurado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_correo_cliente","colSpan":12}],[{"type":"text","variable":"frm_correo_cliente2","var_uid":"19795907265d661303aafe1002582592","dataType":"string","protectedValue":false,"id":"frm_correo_cliente2","name":"frm_correo_cliente2","label":"Otros correos (separados por coma)","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_correo_cliente2","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"95055412265655b4eeac070034106838","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_comentario","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"ENVIAR","tabIndex":"","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13131544665655b4ed3de01039118584","name":"SubForm Estilos Funciones","description":"SubForm Estilos Funciones","mode":"edit","script":{"type":"js","code":"$(\"#dyn_forward\").hide();\n$(\"img[src='/images/bulletButton.gif']\").hide();\n$(\".panel\").css(\"border\", \"none\");\n$(\".row\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"margin-bottom\", \"5px\");\n$(\".panel-body\").css(\"padding\", \"0\");\n$(\".pmdynaform-form\").css(\"border\", \"none\");\n$(\".form-control\").css(\"box-shadow\", \"none\");\n$(\".pmdynaform-grid-row\").css(\"border-bottom\", \"none\");\n$(\".pmdynaform-label-options\").css(\"text-align\", \"left\");\n$(\".pmdynaform-grid-title\").css(\"color\", \"#FFFFFF\");\n$(\".pmdynaform-field-title\").css(\"margin-bottom\", \"1px\");\n$(\".pmdynaform-field-title\").css(\"text-align\", \"center\");\n$(\".nav\").css(\"padding.bottom\", \"1px\");\n$(\".pmdynaform-field-subtitle\").css(\"color\", \"#027361\");\n$(\".pmdynaform-field-subtitle\").css(\"background-color\", \"#E1FFCB\");\n$(\".pmdynaform-field-subtitle\").css(\"border-color\", \"#E1FFCB\");\n\n$(\".pmdynaform-field-title\").css(\"color\", \"#E1FFCB\");\n$(\".pmdynaform-field-title\").css(\"background-color\", \"#027361\");\n$(\".pmdynaform-field-title\").css(\"border-color\", \"#027361\");\n\n$(\".btn-primary:hover\").css(\"background-color\", \"#027361\");\n$(\".btn-primary:hover\").css(\"color\", \"#027361\");\n$(\".btn-primary\").css(\"background-color\", \"#027361\");\n$(\".btn-primary\").css(\"color\", \"#ffffff\");\n\n$(\".btn-default\").css(\"background-color\", \"#E1FFCB\");\n$(\".btn-default\").css(\"color\", \"#ffffff\");\n$(\".btn-default\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".btn-uploadfile:hover\").css(\"background-color\", \"#027361\");\n$(\".btn-uploadfile:hover\").css(\"color\", \"#ffffff\");\n\n\n$(\".btn:hover\").css(\"background-color\", \"#027361\");\n$(\".btn:hover\").css(\"color\", \"#027361\");\n$(\".btn\").css(\"background-color\", \"#E1FFCB\");\n$(\".btn\").css(\"color\", \"#ffffff\");\n$(\".btn\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\n    \"background-color\",\n    \"#E1FFCB\"\n);\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\n    \"color\",\n    \"#ffffff\"\n);\n$(\".ui-button\").css(\"background-color\", \"#E1FFCB\");\n$(\".ui-button\").css(\"color\", \"#ffffff\");\n\n$(\".pmdynaform-grid-title\").css(\"background-color\", \"#027361\");\n$(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-title\").css(\"color\", \"#E1FFCB\");\n//$(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#E1FFCB\");\n//$(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n//$(\".pmdynaform-grid-newitem\").css(\"border-color\", \"#027361\");\n$(\".btn-default\").css(\"background-color\", \"#027361\");\n$(\".btn-default\").css(\"border-color\", \"#027361\");\n$(\".pmdynaform-grid-text-plus\").text(\"Agregar\");\n$(\".info-box-icon.bg-blue\").css(\"background-color\", \"#027361\");\n$(\".info-box-icon.bg-blue\").css(\"background-color\", \"#027361 !important\");\n$(\".info-box-icon.bg-blue .ion-bookmark\").css(\"color\", \"#E1FFCB\");\n$(\".info-box-icon.bg-blue i.ion\").css(\"color\", \"#E1FFCB\");\n\n$(\".info-box-icon.bg-blue\").each(function () {\n    this.style.setProperty(\"background-color\", \"#027361\", \"important\");\n});\n$(\".info-box.box-primary\").each(function () {\n    this.style.setProperty(\"border-top-color\", \"#027361\", \"important\");\n});\n\n$(\"h5\").css(\"color\", \"#027361\");\n\n//btn btn-uploadfile-disabled\n$(\".btn-uploadfile-disabled\").css(\"background-color\", \"#027361\");\n$(\".btn-uploadfile-disabled\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile-disabled\").css(\"border-color\", \"#027361\");\n\n$(\".btn-uploadfile\").css(\"background-color\", \"#027361\");\n$(\".btn-uploadfile\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile\").css(\"border-color\", \"#027361\");\n\n\n// Estilos para el paginador\n$(\".pagination li.active a\").css(\"background-color\", \"#027361\");\n$(\".pagination li.active a\").css(\"color\", \"#ffffff\");\n$(\".pagination li.active a\").css(\"border-color\", \"#027361\");\n\n$(\".btn-danger\").css(\"background-color\", \"#027361\");\n$(\".btn-danger\").css(\"color\", \"#ffffff\");\n$(\".btn-danger\").css(\"border-color\", \"#027361\");\n\n\n$(function () {\n    $('.subtitulo').css('cursor', 'pointer');\n\n    $('.subtitulo').on('click', function () {\n        id = this.id;\n        subforms = $('#' + this.id).attr('subform').split('|');\n        if ($('#' + id).children().attr('class') == 'glyphicon glyphicon-plus')\n            $('#' + id).children().removeClass('glyphicon-plus').addClass('glyphicon-minus');\n        else\n            $('#' + id).children().removeClass('glyphicon-minus').addClass('glyphicon-plus');\n        $.each(subforms, function (index, subform) {\n            $('#' + subform).toggle('slow');\n        });\n    });\n\n\n})\n\nfunction validarExpresionRegular(id, numeroExpresion) {\n\n    if (numeroExpresion == 4) {\n        ponerDecimales(id);\n    }\n\n    $(\"#\" + id).focusout(function () {\n        validarExpresionRegular_2($(this), numeroExpresion);\n    });\n\n    validarExpresionRegular_2($(\"#\" + id), numeroExpresion);\n}\n\nfunction roundToFixed(_float, _digits) {\n    var rounder = Math.pow(10, _digits);\n    return (Math.round(_float * rounder) / rounder).toFixed(_digits);\n}\n\nfunction limitMaxMin(_float, _max, _min) {\n    var parsed = parseFloat(_float);\n    if (isNaN(parsed)) {\n        return '';\n    }\n    console.log(parsed);\n    if (parsed > _max) {\n        console.log(_max, parsed);\n        return _max;\n    }\n    if (parsed < _min) {\n        console.log(_min, parsed);\n        return _min;\n    }\n    return parsed;\n}\n\nfunction validarExpresionRegular_2(id, numeroExpresion) {\n    var expresion_regular = $(\"#expresion_regular_\" + numeroExpresion).getValue();\n    //alert(expresion_regular);\n    var texto = $(id).getValue().toString().trim();\n    //alert(texto);\n\n    //alert(texto.match(expresion_regular) + \" - \" + texto.length);\n\n    if (texto.match(expresion_regular) || texto.length == 0) {\n        $(id).parent().find(\".textlabel\").css(\"color\", \"\");\n        $(id).getControl().css(\"borderColor\", \"\");\n    } else {\n        $(id).parent().find(\".textlabel\").css(\"color\", \"#a94442\");\n        $(id).getControl().css(\"borderColor\", \"#e4655f\");\n    }\n}\n\nfunction ponerDecimales(id) {\n\n    var identificador = $('#' + id);\n    var valor = identificador.getValue().toString().trim();\n\n    if (valor == '') {\n        identificador.setValue(\"\");\n        return;\n    }\n\n    if (typeof valor.split(\".\")[1] === 'undefined') {\n        identificador.setValue(valor + \".00\");\n    } else if (valor.split(\".\")[1].length == 0) {\n        identificador.setValue(valor + \"00\");\n    } else if (valor.split(\".\")[1].length == 1) {\n        identificador.setValue(valor + \"0\");\n    }\n\n}\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion, aux) {\n\n    numero = identificacion;\n    var tercerDigito = numero.substring(2, 3);\n    var bandera = true;\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            if (aux) {\n                alert(\"La identificacion no tiene diez digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    } else if (tipoIdentificacion == 'R') {\n        //alert('otro');\n        if (isNaN(numero)) {\n            alert(\"La identificacion es incorrecta\");\n        }\n        if (numero.length != 13) {\n            if (aux) {\n                alert(\"La identificacion no tiene trece digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (tercerDigito == 9) {\n            digitos = numero.split(\"\");\n            totdigitos = 10;\n            total = 0;\n            digito = (digitos[9] * 1);\n            p1 = digitos[0] * 4;\n            p2 = digitos[1] * 3;\n            p3 = digitos[2] * 2;\n            p4 = digitos[3] * 7;\n            p5 = digitos[4] * 6;\n            p6 = digitos[5] * 5;\n            p7 = digitos[6] * 4;\n            p8 = digitos[7] * 3;\n            p9 = digitos[8] * 2;\n            total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\n            residuo = total % 11\n            final = residuo == 0 ? 0 : 11 - residuo\n            //comprobando codigo verificador\n            if (final == digito) {\n                //alert(\"RUC EMPRESA valido\");\n                bandera = false;\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"RUC EMPRESA no valido\");\n                }\n                identificacion.value = '';\n                bandera = false;\n            }\n        }\n    }\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n        var i = 0;\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n        //comprobando codigo verificador\n        decena = total / 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            //alert(\"Cedula valida\");\n            return true;\n        } else {\n            if (tipoIdentificacion == 'P') {\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"Identificacion no valida\");\n                }\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n};\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"hidden","variable":"expresion_regular_1","var_uid":"42720141465655b4ee65af1018954822","dataType":"string","protectedValue":false,"id":"expresion_regular_1","name":"expresion_regular_1","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_1","colSpan":1},{"type":"hidden","variable":"expresion_regular_2","var_uid":"31871794765655b4ee66b06014122752","dataType":"string","protectedValue":false,"id":"expresion_regular_2","name":"expresion_regular_2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_2","colSpan":1},{"type":"hidden","variable":"expresion_regular_3","var_uid":"74930015565655b4ee67af0043659724","dataType":"string","protectedValue":false,"id":"expresion_regular_3","name":"expresion_regular_3","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_3","colSpan":1},{"type":"hidden","variable":"expresion_regular_4","var_uid":"37854240165655b4ee68ba3025403089","dataType":"string","protectedValue":false,"id":"expresion_regular_4","name":"expresion_regular_4","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_4","colSpan":1},{"type":"hidden","variable":"PROCESS","var_uid":"38955671965655b4f00eb82063276625","dataType":"string","protectedValue":false,"id":"PROCESS","name":"PROCESS","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"PROCESS","colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1}]],"variables":[{"var_uid":"42720141465655b4ee65af1018954822","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"expresion_regular_1","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"63645473164760b7d3d3c92008795027","var_name_old":"expresion_regular_1","prj_uid_old":"771962534639f70846b6f90010923609"},{"var_uid":"31871794765655b4ee66b06014122752","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"expresion_regular_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"95716858564760b7d4274e1026004027","var_name_old":"expresion_regular_2","prj_uid_old":"771962534639f70846b6f90010923609"},{"var_uid":"74930015565655b4ee67af0043659724","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"52082462164760b7d45ea42053122049","var_name_old":"expresion_regular_3","prj_uid_old":"771962534639f70846b6f90010923609"},{"var_uid":"37854240165655b4ee68ba3025403089","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"53574378564760b7d49bc11075935804","var_name_old":"expresion_regular_4","prj_uid_old":"771962534639f70846b6f90010923609"},{"var_uid":"38955671965655b4f00eb82063276625","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"PROCESS","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"24323299364760b7d4d77b5029006240","var_name_old":"PROCESS","prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}],[{"type":"hidden","variable":"frm_analisisCoberturas_relacionTotal","var_uid":"90209220465655b4ee80f20073033273","dataType":"string","protectedValue":false,"id":"frm_analisisCoberturas_relacionTotal","name":"frm_analisisCoberturas_relacionTotal","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_analisisCoberturas_relacionTotal","colSpan":12}]],"variables":[{"var_uid":"12757371665655b4ee73d97017770701","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"80788882465655b4eeb32d9046262054","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_correo_cliente","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"19795907265d661303aafe1002582592","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_correo_cliente2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95055412265655b4eeac070034106838","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"95055412265655b4eeac070034106838","var_name_old":"frm_comentario","prj_uid_old":"76661804465655b4bdffbc2081200894"},{"var_uid":"90209220465655b4ee80f20073033273","prj_uid":"76661804465655b4bdffbc2081200894","var_name":"frm_analisisCoberturas_relacionTotal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
