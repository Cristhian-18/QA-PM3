glyphicon glyphicon-minus\"><\/i> \nDatos del conductor<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76241453365655b4ed3ad27050479402","name":"SubForm Datos Asegurado","description":"SubForm Datos Asegurado","mode":"edit","script":{"type":"js","code":"\/\/CONDUCTOR\nfunction checkConductor(newVal, oldVal) {\n    if (newVal == 'A') {\n        $(\"#frm_asegurado_nombres\").setValue($(\"#frm_busqueda_nombres\").getValue());\n      \t$(\"#frm_asegurado_identificacion\").setValue($(\"#frm_busqueda_identificacion\").getValue());\n    } else {\n        $(\"#frm_asegurado_nombres\").setValue('');\n      \t$(\"#frm_asegurado_identificacion\").setValue('');\n    }\n}\n\/\/execute when the Dynaform loads:\nif ($(\"#frm_asegurado_tipo\").getValue() != '') {\n    checkConductor($(\"#frm_asegurado_tipo\").getValue(), '');\n} \n$('#frm_asegurado_tipo').setOnchange(checkConductor); \/\/execute when field's value changes\n\n\/\/PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n    $.ajax({\n      url  : '..\/beesmartec\/services\/siniestrosVeh\/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_provincias',\n        'frm_dato' : newVal,\n        'frm_tipo' : 'provincia'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_asegurado_provincia').getControl().empty();\n  \t\t$('#frm_asegurado_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_asegurado_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n\/\/execute when the Dynaform loads:\nif ($(\"#frm_asegurado_pais\").getValue() != '') {\n    checkProvincia($(\"#frm_asegurado_pais\").getValue(), '');\n} \n$('#frm_asegurado_pais').setOnchange(checkProvincia); \/\/execute when field's value changes\n\n\/\/CANTON\nfunction checkCanton(newVal, oldVal) {\n  var frm_dato = $(\"#frm_asegurado_pais\").getValue();\n    $.ajax({\n      url  : '..\/beesmartec\/services\/siniestrosVeh\/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_provincias',\n        'frm_dato' : frm_dato,\n        'frm_prov' : newVal,\n        'frm_tipo' : 'canton'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_asegurado_ciudad').getControl().empty();\n  \t\t$('#frm_asegurado_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_asegurado_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n\/\/execute when the Dynaform loads:\nif ($(\"#frm_asegurado_provincia\").getValue() != '') {\n    checkCanton($(\"#frm_asegurado_provincia\").getValue(), '');\n} \n$('#frm_asegurado_provincia').setOnchange(checkCanton); \/\/execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  $(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n  $(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n  $(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n  $(\"#frm_taller_ciudad\").setValue(\"Q\");\n  $(\"#frm_taller_prioridad\").setValue(\"1\");\n  $(\"#frm_taller_capacidad\").setValue(\"20\");\n  $(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n  $(\"#frm_taller_saldo\").setValue(\"15\");\n  $(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n  $(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n  $(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#subt_ve_afectados\").show();\n      \t$(\"#93254149565655b4ed46a66057215729\").show();\n    } else {\n       $(\"#subt_ve_afectados\").hide();\n      \t$(\"#93254149565655b4ed46a66057215729\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); \/\/execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#iisubt_pr_afectados\").show();\n      \t$(\"#46533585865655b4ed84dd4018270742\").show();\n    } else {\n       $(\"#iisubt_pr_afectados\").hide();\n      \t$(\"#46533585865655b4ed84dd4018270742\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); \/\/execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#isubt_pe_afectados\").show();\n      \t$(\"#43602034065655b4ed6ca46084965014\").show();\n    } else {\n       $(\"#isubt_pe_afectados\").hide();\n      \t$(\"#43602034065655b4ed6ca46084965014\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); \/\/execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"28966250165655b4ee91854071269948","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"37401606165655b4ee88057027800219","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_identificacion","colSpan":4},{"type":"text","variable":"frm_asegurado_nombres","var_uid":"51550901365655b4ee8aff7000383937","dataType":"string","protectedValue":false,"id":"frm_asegurado_nombres","name":"frm_asegurado_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryC