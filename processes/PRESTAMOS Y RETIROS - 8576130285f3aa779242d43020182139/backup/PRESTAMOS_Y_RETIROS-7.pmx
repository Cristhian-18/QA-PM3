        <dyn_content><![CDATA[{"name":"Form Mensaje Monto","description":"Form Mensaje Monto","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"90613571860c8206c8affb7045907730","name":"Form Mensaje Monto","description":"Form Mensaje Monto","mode":"edit","script":{"type":"js","code":"$(\"#monto_solicitado\").html($(\"#frm_monto_solicitado\").getValue());\n$(\"#monto_disponible\").html($(\"#frm_monto_disponible_actual\").getValue());"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"REVISAR LA SOLICITUD DE PRESTAMO O RETIRO","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3786171875f3ca249268723093039369","name":"Subform estilos funciones","description":"Subform estilos funciones","mode":"edit","script":{"type":"js","code":"$(\"#dyn_forward\").hide();\n$(\"img[src='\/images\/bulletButton.gif']\").hide();\n$('.panel').css(\"border\",\"none\");\n$(\".row\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"margin-bottom\", \"5px\");\n$(\".panel-body\").css(\"padding\", \"0\");\n$('.pmdynaform-form').css(\"border\",\"none\");\n$(\".form-control\").css(\"box-shadow\", \"none\");\n$(\".pmdynaform-grid-row\").css(\"border-bottom\", \"none\");\n$(\".pmdynaform-label-options\").css(\"text-align\", \"left\");\n\/\/$(\".pmdynaform-grid-title\").css(\"display\", \"none\");\n$(\".pmdynaform-field-title\").css(\"margin-bottom\", \"1px\");\n$(\".pmdynaform-field-title\").css(\"text-align\", \"center\");\n$(\".nav\").css(\"padding.bottom\", \"1px\");\n$(\".pmdynaform-field-subtitle h5\").css(\"background-color\", \"#039BE5\");\n$(\".pmdynaform-field-subtitle h5\").css(\"border-color\", \"#039BE5\");\n$(\".pmdynaform-field-title h4\").css(\"background-color\", \"#003366\");\n$(\".pmdynaform-field-title h4\").css(\"border-color\", \"#003366\");\n\n$(\".btn-primary:hover\").css(\"background-color\", \"#003366\");\n$(\".btn-primary:hover\").css(\"color\", \"#003366\");\n$(\".btn-primary\").css(\"background-color\", \"#003366\");\n$(\".btn-primary\").css(\"color\", \"#ffffff\");\n\n$(\".btn-default\").css(\"background-color\", \"#039BE5\");\n$(\".btn-default\").css(\"color\", \"#ffffff\");\n$(\".btn-default\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".btn-uploadfile:hover\").css(\"background-color\", \"#003366\");\n$(\".btn-uploadfile:hover\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile\").css(\"background-color\", \"#039BE5\");\n$(\".btn-uploadfile\").css(\"color\", \"#ffffff\");\n$(\".btn-uploadfile\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".btn:hover\").css(\"background-color\", \"#003366\");\n$(\".btn:hover\").css(\"color\", \"#003366\");\n$(\".btn\").css(\"background-color\", \"#039BE5\");\n$(\".btn\").css(\"color\", \"#ffffff\");\n$(\".btn\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"background-color\", \"#039BE3\");\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"color\", \"#ffffff\");\n$(\".ui-button\").css(\"background-color\", \"#039BE5\");\n$(\".ui-button\").css(\"color\", \"#ffffff\");\n\n$(\".pmdynaform-grid-title\").css(\"background-color\", \"#039BE5\");\n$(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#039BE5\");\n$(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"border-color\", \"#003366\");\n$(\".btn-default\").css(\"background-color\", \"#039BE5\");\n$(\".btn-default\").css(\"border-color\", \"#039BE5\");\n$(\".pmdynaform-grid-text-plus\").text(\"Agregar\");\n\n\n$( function(){\n\t$('.subtitulo').css( 'cursor', 'pointer' );\n\t\n\t$('.subtitulo').on('click', function(){\n\t\tid = this.id;\n\t\tsubforms = $('#'+this.id).attr('subform').split('|');\n\t\tif( $('#'+id).children().attr('class') == 'glyphicon glyphicon-plus')\n\t\t$('#'+id).children().removeClass('glyphicon-plus').addClass('glyphicon-minus');\n\t\telse\n\t\t$('#'+id).children().removeClass('glyphicon-minus').addClass('glyphicon-plus');\n\t\t$.each( subforms , function( index, subform ) {\n\t\t\t$('#'+subform).toggle('slow');\n\t\t});\n\t});\n\t\n\t\n})\n\n\nfunction validarExpresionRegular(id, numeroExpresion){\n\t\n\tif(numeroExpresion == 4){\n\t\tponerDecimales(id);\n\t}\n\t\n\t$(\"#\" + id).focusout( function () {\n\t\tvalidarExpresionRegular_2($(this), numeroExpresion);\n\t}); \t\n\t\n\tvalidarExpresionRegular_2($(\"#\" + id), numeroExpresion);\n} \n\nfunction validarExpresionRegular_2(id, numeroExpresion){\n\tvar expresion_regular = $(\"#expresion_regular_\" + numeroExpresion).getValue();\n\t\/\/alert(expresion_regular);\n\tvar texto = $(id).getValue().toString().trim();\n\t\/\/alert(texto);\n\t\n\t\/\/alert(texto.match(expresion_regular) + \" - \" + texto.length);\n\t\n\tif (texto.match(expresion_regular) || texto.length == 0){\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"\" );\n\t\t$(id).getControl().css(\"borderColor\", \"\");\n\t\t}else {\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"#a94442\" );\n\t\t$(id).getControl().css(\"borderColor\", \"#e4655f\");\n\t}\t\n}\n\nfunction ponerDecimales(id){\n\t\n\tvar identificador = $('#' + id);\n\tvar valor = identificador.getValue().toString().trim();\n\t\n\tif(valor == ''){\n\t\tidentificador.setValue(\"\");\n\t\treturn;\n\t}  \n\t\n\tif(typeof valor.split(\".\")[1] === 'undefined'){\n\t\tidentificador.setValue(valor + \".00\");\n\t\t}else if(valor.split(\".\")[1].length == 0){\n\t\tidentificador.setValue(valor + \"00\");\n\t\t}else if(valor.split(\".\")[1].length == 1){\n\t\tidentificador.setValue(valor + \"0\");\n\t}\n\t\n}\n\nfunction canton_2(bandera, idProvincia, idCanton){\n\t\n\tvar str = $('#frm_canton_auxiliar').getValue() + \"\";\/\/El espacio vacio es para q se convierta a string\n\tvar vector = str.split(\",\");\t\n\t\n\t$(\"#\" + idCanton).find(\"option\").hide();\n\t$(\"#\" + idCanton).find(\"option[value='']\").show();\t\n\tif(bandera){\n\t\t$('#' + idCanton).setValue('');\t\n\t}\n\t\n\tvar comboUno = $('#'+idProvincia).getControl().val();\n\t\n\tif(comboUno == ''){\n\t\t$('#' + idCanton).getControl().attr('disabled',true);\n\t\t}else if(comboUno != \"\"){\n\t\t$('#' + idCanton).getControl().attr('disabled',false);\n\t\tfor (i = 0; i < (vector.length\/2); i++) {\n\t\t\tif(vector[i*2] == comboUno){\n\t\t\t\t$(\"#\" + idCanton).find(\"option[value=\" + vector[i*2 + 1] +\"]\").show();\n\t\t\t}\n\t\t}\n\t}\t\n\t\n}\n\n\n\n\/\/validar campos vacios\n$(\"#validacionesCampos\").hide();\n\nfunction showConfirmDlg() {\n\n\tif($(\"form\").prop(\"id\") == \"9653957035e829ed50c2e51034344533\"){\n\t\treturn;\n\t}\n\t\n\tvar bandera = true;\n\tvar c = '';\n    var count = 0;\n\tvar noCumplioValidacion;\n\tvar noCumplioValidacionProcess;\n\tvar stringHtml = \"\";\n\t\n\t$(\"div.pmdynaform-edit-text, div.pmdynaform-edit-dropdown, div.pmdynaform-edit-datetime, div.pmdynaform-edit-file, pmdynaform-edit-dropdown, pmdynaform-edit-file\").each(function(index, element) {\n\/\/      $(\"div.pmdynaform-edit-datetime\").each(function(index) {\n\t\n\t\tif($(this).getControl().toString() == \"\"){\/\/para q ingnore los campos de grillas\n\t\t\treturn;\n\t\t}\t\n\t\t\n\t\tif(typeof $(this).find(\".pmdynaform-message-error\").html() !== 'undefined'){\n\t\t\tnoCumplioValidacionProcess = true;\n\t\t}else{\n\t\t\tnoCumplioValidacionProcess = false;\n\t\t}\n\t\t\n\t\tstringHtml = $(this).getControl().attr(\"style\").toString();\n  \/\/    \talert(($(this).toString()));\n      \t\n\t\tif(stringHtml.indexOf(\"border-color\") > 0 || stringHtml.indexOf(\"color\") > 0){\n\t\t\tnoCumplioValidacion = true;\n    \n\t\t}else{\n\t\t\tnoCumplioValidacion = false;\n    \n\t\t}\t\n        \n        \/\/if($(this).find(\".pmdynaform-field-required\").html() == '*')){\n          \n\t\t\n\t\tdeshabilitadaValidacion = $(this).find(\".pmdynaform-field-required\").attr(\"style\") != \"display: none;\" ? true : false;\n\t\t\n\t\tif((deshabilitadaValidacion && $(this).find(\".pmdynaform-field-required\").html() == '*') || noCumplioValidacion || noCumplioValidacionProcess){\n          if($(this).attr('class').indexOf('file') > -1){\n            if($(this).getText(0).length == 0){\n                count++;\n\t\t\t\tc += count + \") \" + $(this).getLabel() + \"<br>\";\n              \t$(this).getControl().css(\"border\", \"1px solid red\");\n\t\t\t\tbandera = false;\n             }else{\n                  $(this).getControl().css(\"border\", \"\");\n              }\n            }else{\n              if($(this).getValue().trim().length == 0 || noCumplioValidacion || noCumplioValidacionProcess){\n                  count++;\n                  c += count + \") \" + $(this).getLabel() + \"<br>\";\n                  $(this).getControl().css(\"border\", \"1px solid red\");\n                  bandera = false;\n              }else{\n                  $(this).getControl().css(\"border\", \"\");\n              }\n            }\n\t\t}\n\t\t\n\t});  \n\n\t$(\"#validacionesCampos\").html(c); \n\t\n\tvar dlgContents = {\n\t\tmodal:     true,\n\t\tresizable: false,\n\t\tbuttons: {\n\t\t\t\"Ok\": function() {\n\t\t\t\t$(this).dialog(\"close\");\n\t\t\t\tcallback(true);\n\t\t\t}\n\t\t}\n\t}\n\t\n\tif(count > 0){\n\t\t$(\"#validacionesCampos\").dialog(dlgContents);\n\t}\n\treturn bandera;\n}\nfunction validarIdentificacion(identificacion, tipoIdentificacion, aux) {\n\n    numero = identificacion;\n    var tercerDigito = numero.substring(2, 3);\n    var bandera = true;\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            if (aux) {\n                alert(\"La identificacion no tiene diez digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    } else if (tipoIdentificacion == 'R') {\n      \t\/\/alert('otro');\n      \tif (isNaN(numero)) {\n           alert(\"La identificacion es incorrecta\");\n        }\n        if (numero.length != 13) {\n            if (aux) {\n                alert(\"La identificacion no tiene trece digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (tercerDigito == 9) {\n            digitos = numero.split(\"\");\n            totdigitos = 10;\n            total = 0;\n            digito = (digitos[9] * 1);\n            p1 = digitos[0] * 4;\n            p2 = digitos[1] * 3;\n            p3 = digitos[2] * 2;\n            p4 = digitos[3] * 7;\n            p5 = digitos[4] * 6;\n            p6 = digitos[5] * 5;\n            p7 = digitos[6] * 4;\n            p8 = digitos[7] * 3;\n            p9 = digitos[8] * 2;\n            total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\n            residuo = total % 11\n            final = residuo == 0 ? 0 : 11 - residuo\n            \/\/comprobando codigo verificador\n            if (final == digito) {\n                \/\/alert(\"RUC EMPRESA valido\");\n                bandera = false;\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"RUC EMPRESA no valido\");\n                }\n                identificacion.value = '';\n                bandera = false;\n            }\n        }\n    }\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n        var i = 0;\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n        \/\/comprobando codigo verificador\n        decena = total \/ 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            \/\/alert(\"Cedula valida\");\n            return true;\n        } else {\n            if (tipoIdentificacion == 'P') {\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"Identificacion no valida\");\n                }\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n}\n\nfunction gridIdentificacionRepetida(nombre_grilla, columna){\n\t\n\tvar bandera = true;\n\t\n\tvar filas = $(\"#\" + nombre_grilla).getNumberRows();\n\tvar arr = new Array(0);\n\t\n\t\/\/ Verificar si hay repetidos\n    for (f = 1; f <= filas; f++) {\t\n\t\tvar identificacion = $(\"#\" + nombre_grilla).getValue(f, columna).trim();\n\t\t\n\t\tif(identificacion != \"\" && arr.indexOf(identificacion) >= 0){\n\t\t\tbandera = false;\n\t\t}\t\t\n\t\t\n\t\tarr.push(identificacion);\n\t}\n\t\n\t\/\/Colorear bordes\n    for (f = 1; f <= filas; f++) {\t\n        if (bandera == false) {\n\t\t\t$(\"#\" + nombre_grilla).getControl(f, columna).css(\"borderColor\", \"red\");\n        }else{\n\t\t\t$(\"#\" + nombre_grilla).getControl(f, columna).css(\"borderColor\", \"\");\n\t\t}\n\t}\t\n\t\n\treturn bandera;\n\t\n}\n\n\n\n\n\n\n\n\n\n\n"},"language":"en","externalLibs":"\/plugin\/beesmartec\/core_librerias\/js_externos\/jquery-ui.css,\/plugin\/beesmartec\/core_librerias\/js_externos\/jquery-ui.js","printable":false,"items":[[{"type":"panel","id":"panelRequeridos","content":"<div id=\"validacionesCampos\" title=\"Verificar la informacion\"><\/div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"expresion_regular_1","var_uid":"3681304635e8525e4b173d3069070665","dataType":"string","protectedValue":false,"id":"expresion_regular_1","name":"expresion_regular_1","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_1","colSpan":3},{"type":"hidden","variable":"expresion_regular_2","var_uid":"9579963435e8579e5dc9351087274555","dataType":"string","protectedValue":false,"id":"expresion_regular_2","name":"expresion_regular_2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_2","colSpan":3},{"type":"hidden","variable":"expresion_regular_3","var_uid":"7631587875f3ca2543bdbd2020871489","dataType":"string","protectedValue":false,"id":"expresion_regular_3","name":"expresion_regular_3","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_3","colSpan":3},{"type":"hidden","variable":"expresion_regular_4","var_uid":"2590718105f3ca25452fb31095485119","dataType":"string","protectedValue":false,"id":"expresion_regular_4","name":"expresion_regular_4","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_4","colSpan":3}]],"variables":[{"var_uid":"3681304635e8525e4b173d3069070665","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_1","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3681304635e8525e4b173d3069070665","var_name_old":"expresion_regular_1","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"9579963435e8579e5dc9351087274555","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9579963435e8579e5dc9351087274555","var_name_old":"expresion_regular_2","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"7631587875f3ca2543bdbd2020871489","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2837094465ec434e3918ce2092196455","var_name_old":"expresion_regular_3","prj_uid_old":"5393441295ebc1555705f98060769179"},{"var_uid":"2590718105f3ca25452fb31095485119","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9491441075ec434e3b51753019415626","var_name_old":"expresion_regular_4","prj_uid_old":"5393441295ebc1555705f98060769179"}],"colSpan":12}],[{"type":"panel","id":"pnl_msg","content":" <!-- Info boxes -->\n<div class=\"row\">\n  <div class=\"col-12 col-sm-12 col-md-12\">\n     <!-- \/.card-header -->\n    <div class=\"card-body\">\n      <div class=\"alert alert-danger alert-dismissible\">\n        <h5><i class=\"icon fa fa-ban\"><\/i> Alerta!<\/h5>\n        <p style=\"text-align:center;\">\"La solicitud no se puede procesar ya que el valor disponible actual es <span id=\"monto_disponible\"><\/span> menor al monto solicitado <span id=\"monto_solicitado\"><\/span>\".<\/p>\n        <p style=\"text-align:center;\">Por favor de click en continuar para enviar la solicitud a SAC.<\/p>\n        <p style=\"text-align:center\"><img src=\"\/plugin\/beesmartec\/progs_pr\/stop.jpg\"><\/p>\n      <\/div>\n    <\/div>\n  <!-- \/.col -->\n<\/div>\n<!-- \/.ROW -->","border":"1px","colSpan":12}],[{"type":"hidden","variable":"frm_monto_solicitado","var_uid":"87449975260c89ec2937cd7037146190","dataType":"string","protectedValue":false,"id":"frm_monto_solicitado","name":"frm_monto_solicitado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_monto_solicitado","colSpan":2},{"type":"hidden","variable":"frm_monto_disponible_actual","var_uid":"52315168260dcadbd23fa51038514213","dataType":"string","protectedValue":false,"id":"frm_monto_disponible_actual","name":"frm_monto_disponible_actual","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_monto_disponible_actual","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"CONTINUAR","colSpan":12}]],"variables":[{"var_uid":"87449975260c89ec2937cd7037146190","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_monto_solicitado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"52315168260dcadbd23fa51038514213","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_monto_disponible_actual","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
