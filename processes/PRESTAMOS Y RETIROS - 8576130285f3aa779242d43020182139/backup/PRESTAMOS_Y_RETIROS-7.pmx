entos\").children(\"div\").eq(0).addClass(\"col-sm-8.col-md-8.col-lg-8\")\n$(\"#chk_documentos\").children(\"div\").eq(0).find(\"label\").css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(1).addClass(\"col-sm-4 col-md-4 col-lg-4 pmdynaform-field-control\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"padding-left\", \"0\")\n$(\"#chk_documentos\").find(\"span.textlabel\").css(\"font-size\", \"16px\");"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_tamnio","label":"El tamaño de los archivos no debe superar los 2MB","ariaLabel":"","colSpan":12}],[{"type":"file","variable":"frm_documentos_natural_cedula","var_uid":"3262110935f3cacf548cad5034421623","dataType":"file","protectedValue":false,"id":"frm_documentos_natural_cedula","name":"frm_documentos_natural_cedula","label":"Cedula, pasaporte o RUC del contratante","tabIndex":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf, *.jpg, *.png","size":"2","sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"5028443425ee7d8a823c0b4062936539","var_name":"frm_documentos_natural_cedula","colSpan":12}],[{"type":"file","variable":"frm_documentos_nombramiento","var_uid":"8821970485f3d75e2529318078163356","dataType":"file","protectedValue":false,"id":"frm_documentos_nombramiento","name":"frm_documentos_nombramiento","label":"Copia de nombramiento del representante legal","tabIndex":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf, *.jpg, *.png","size":2,"sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"4972393305f3d3380b23a46028329965","var_name":"frm_documentos_nombramiento","colSpan":12}],[{"type":"file","variable":"frm_documentos_natural_representante_cedula","var_uid":"2204753235f3d74e79dc