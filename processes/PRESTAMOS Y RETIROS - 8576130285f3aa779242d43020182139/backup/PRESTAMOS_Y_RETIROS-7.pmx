r_uid":"9558245775f3ebe8d034ab1095749207","dataType":"string","protectedValue":false,"id":"cmb_accion_t5","name":"cmb_accion_t5","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"A","label":"REVISADO Y APROBADO"},{"value":"N","label":"NOVEDADES"}],"var_name":"cmb_accion_t5","colSpan":12}],[{"type":"textarea","variable":"frm_comentario_t5","var_uid":"5217962055f4ad1114ccc21023176594","dataType":"string","protectedValue":false,"id":"frm_comentario_t5","name":"frm_comentario_t5","label":"Comentario","defaultValue":"--","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_comentario_t5","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"CONTINUAR","colSpan":12}],[{"type":"hidden","variable":"tri_mes_GrabarMovPR","var_uid":"1691687985f6e7da5e2a4f7033597334","dataType":"string","protectedValue":false,"id":"tri_mes_GrabarMovPR","name":"tri_mes_GrabarMovPR","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_mes_GrabarMovPR","colSpan":2},{"type":"hidden","variable":"tri_mes_ConsultaPID","var_uid":"8646172295f516fb0e3d724013483609","dataType":"string","protectedValue":false,"id":"tri_mes_ConsultaPID","name":"tri_mes_ConsultaPID","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_mes_ConsultaPID","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"6479542975f3ca21fb74b16059720012","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6479542975f3ca21fb74b16059720012","var_name_old":"frm_recibio_deposito","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"9558245775f3ebe8d034ab1095749207","prj_uid":"8576130285f3aa779242d43020182139","var_name":"cmb_accion_t5","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5217962055f4ad1114ccc21023176594","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_comentario_t5","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"1691687985f6e7da5e2a4f7033597334","prj_uid":"8576130285f3aa779242d43020182139","var_name":"tri_mes_GrabarMovPR","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8646172295f516fb0e3d724013483609","prj_uid":"8576130285f3aa779242d43020182139","var_name":"tri_mes_ConsultaPID","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
