base","sql":"","var_name":"tipo_proceso","colSpan":4}],[{"type":"submit","id":"btn_repro","name":"btn_repro","label":"REPROCESAR","colSpan":12}]],"variables":[{"var_uid":"9330103275f4d63ef434e41026375635","prj_uid":"8576130285f3aa779242d43020182139","var_name":"id_proceso","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9185007605f4d63e9412456055659792","prj_uid":"8576130285f3aa779242d43020182139","var_name":"id_pev_cero","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6487300885f4d63f43bd8d7074616132","prj_uid":"8576130285f3aa779242d43020182139","var_name":"tipo_proceso","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
