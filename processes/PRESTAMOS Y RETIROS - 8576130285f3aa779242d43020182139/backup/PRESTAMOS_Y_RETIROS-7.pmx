":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Tranferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_inicio","name":"f_inicio","label":"Fecha Inicio","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Inicio"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_fin","name":"f_fin","label":"Fecha Fin","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Fin"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"accion","name":"accion","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_comentario","name":"txt_comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"8364879445f3ea1538a0212086841201","prj_uid":"8576130285f3aa779242d43020182139","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"sbt_accion","label":"Atencion\n","colSpan":12}],[{"type":"dropdown","variable":"cmb_accion_t6","var_uid":"3470938075f3ec41ee3a646040287605","dataType":"string","protectedValue":false,"id":"cmb_accion_t6","name":"cmb_accion_t6","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"@@mrt_cmb_accion","options":[],"var_name":"cmb_accion_t6","colSpan":12}],[{"type":"textarea","variable":"frm_comentario_t6","var_uid":"8902030575f4ad2d0a39646022566323","dataType":"string","protectedValue":false,"id":"frm_comentario_t6","name":"frm_comentario_t6","label":"Comentario","defaultValue":"--","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_comentario_t6","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"CONTINUAR","colSpan":12}]],"variables":[{"var_uid":"6479542975f3ca21fb74b16059720012","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6479542975f3ca21fb74b16059720012","var_name_old":"frm_recibio_deposito","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"7325624775fbbfeb3f41c19057544716","prj_uid":"8576130285f3aa779242d43020182139","var_name":"motivo_proceso","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3470938075f3ec41ee3a646040287605","prj_uid":"8576130285f3aa779242d43020182139","var_name":"cmb_accion_t6","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8902030575f4ad2d0a39646022566323","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_comentario_t6","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
