 }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"4746962945e7eb5f58b08e5020280313","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"dropdown","variable":"frm_entidad_financiera","var_uid":"6913105725e7e99f5066af3054784745","dataType":"string","protectedValue":false,"id":"frm_entidad_financiera","name":"frm_entidad_financiera","label":"Banco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","db