        <dyn_content><![CDATA[{"name":"Subform Datos contratantes","description":"Subform Datos contratantes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7689594095f3ca309a42d38006294228","name":"Subform Datos contratantes","description":"Subform Datos contratantes","mode":"edit","script":{"type":"js","code":"//ocultar campo endoso va opo default 0\n$(\"#frm_numero_endozo_vigente\").hide();\n//Validar cedula de identidad y pasaporte\n$(\"#frm_numero_identificacion_juridico\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    var bool = validarIdentificacion($('#frm_numero_identificacion_juridico').getValue(), $('#frm_tipo_identificacion_juridico').getControl().val());\n    if (bool == false) {\n      $('#frm_numero_identificacion_juridico').setValue(\"\");\n    }\n  }\n});\n\n\n//Validar cedula de identidad y pasaporte\n$(\"#frm_plazo_prestamo\").focusout(function () {\n  var monto = $('#frm_monto_prestamo').getValue();\n  if ($('#frm_frecuencia_pago').getValue() == '1')\n    var frec = 12;\n  if ($('#frm_frecuencia_pago').getValue() == '6')\n    var frec = 1;\n  if ($('#frm_frecuencia_pago').getValue() == '2')\n    var frec = 6;\n  if ($('#frm_frecuencia_pago').getValue() == '4')\n    var frec = 3;\n\n  var plazo = ($('#frm_plazo_prestamo').getValue() * 1) * frec;\n  //console.log(plazo);\n  var frecuencia = $('#frm_frecuencia_pago').getValue();\n\n  //monto 5000\n  if (monto <= 5000) {\n    if (plazo > 12) {\n      alert(\"Plazo no valido \\n por ese monto solo se admite hasta 12 meses\");\n      $(\"#frm_plazo_prestamo\").setValue('');\n      return false;\n    }\n  }\n  //monto 10000\n  if (monto > 5000 && monto <= 10000) {\n    if (plazo > 24) {\n      alert(\"Plazo no valido \\n por ese monto solo se admite hasta 24 meses\");\n      $(\"#frm_plazo_prestamo\").setValue('');\n      return false;\n    }\n  }\n  //monto 10000\n  if (monto > 10000 && monto <= 100000) {\n    if (plazo > 36) {\n      alert(\"Plazo no valido \\n por ese monto solo se admite hasta 36 meses\");\n      $(\"#frm_plazo_prestamo\").setValue('');\n      return false;\n    }\n  }\n});\n\nfunction FrecuenciaPago(newValue, oldValue) {\n  //cambio el foco al plazo\n  $(\"#frm_plazo_prestamo\").getControl().focus();\n}\n\n$(\"#frm_frecuencia_pago\").setOnchange(FrecuenciaPago);\n\nfunction EnableTextbox(newVal, oldVal) {\n\n  if (newVal == '1' || newVal == 'on' || newVal === true || newVal == '\"1\"') {\n    $(\"#frm_plazo_prestamo\").setValue(\"1\");\n    $('#frm_plazo_prestamo').getControl().attr('disabled', true);\n\n    var monto = $('#frm_monto_prestamo').getValue();\n    var frecuencia = $('#frm_frecuencia_pago').getValue();\n    if (monto > 3000 || frecuencia == 1) {\n      alert(\"Monto o Plazo no valido \\n monto maximo es 3000 y frecuencia 6 meses\");\n      $(\"#frm_monto_prestamo\").setValue('');\n      $(\"#frm_plazo_prestamo\").setValue('');\n      $(\"#frm_frecuencia_pago\").setValue('');\n      return false;\n    }\n  }\n  else {\n\n    $('#frm_plazo_prestamo').getControl().attr('disabled', false);\n  }\n}\n$(\"#chk_vencimiento\").setOnchange(EnableTextbox);\n\n\nfunction Unidades(num) {\n\n  switch (num) {\n    case 1: return \"UN\";\n    case 2: return \"DOS\";\n    case 3: return \"TRES\";\n    case 4: return \"CUATRO\";\n    case 5: return \"CINCO\";\n    case 6: return \"SEIS\";\n    case 7: return \"SIETE\";\n    case 8: return \"OCHO\";\n    case 9: return \"NUEVE\";\n  }\n\n  return \"\";\n}//Unidades()\n\nfunction Decenas(num) {\n\n  decena = Math.floor(num / 10);\n  unidad = num - (decena * 10);\n  switch (decena) {\n    case 1:\n      switch (unidad) {\n        case 0: return \"DIEZ\";\n        case 1: return \"ONCE\";\n        case 2: return \"DOCE\";\n        case 3: return \"TRECE\";\n        case 4: return \"CATORCE\";\n        case 5: return \"QUINCE\";\n        default: return \"DIECI\" + Unidades(unidad);\n      }\n    case 2:\n      switch (unidad) {\n        case 0: return \"VEINTE\";\n        default: return \"VEINTI\" + Unidades(unidad);\n      }\n    case 3: return DecenasY(\"TREINTA\", unidad);\n    case 4: return DecenasY(\"CUARENTA\", unidad);\n    case 5: return DecenasY(\"CINCUENTA\", unidad);\n    case 6: return DecenasY(\"SESENTA\", unidad);\n    case 7: return DecenasY(\"SETENTA\", unidad);\n    case 8: return DecenasY(\"OCHENTA\", unidad);\n    case 9: return DecenasY(\"NOVENTA\", unidad);\n    case 0: return Unidades(unidad);\n  }\n}//Unidades()\n\nfunction DecenasY(strSin, numUnidades) {\n  if (numUnidades > 0)\n    return strSin + \" Y \" + Unidades(numUnidades)\n\n  return strSin;\n}//DecenasY()\n\nfunction Centenas(num) {\n  centenas = Math.floor(num / 100);\n  decenas = num - (centenas * 100);\n  switch (centenas) {\n    case 1:\n      if (decenas > 0)\n        return \"CIENTO \" + Decenas(decenas);\n      return \"CIEN\";\n    case 2: return \"DOSCIENTOS \" + Decenas(decenas);\n    case 3: return \"TRESCIENTOS \" + Decenas(decenas);\n    case 4: return \"CUATROCIENTOS \" + Decenas(decenas);\n    case 5: return \"QUINIENTOS \" + Decenas(decenas);\n    case 6: return \"SEISCIENTOS \" + Decenas(decenas);\n    case 7: return \"SETECIENTOS \" + Decenas(decenas);\n    case 8: return \"OCHOCIENTOS \" + Decenas(decenas);\n    case 9: return \"NOVECIENTOS \" + Decenas(decenas);\n  }\n\n  return Decenas(decenas);\n}//Centenas()\n\nfunction Seccion(num, divisor, strSingular, strPlural) {\n  cientos = Math.floor(num / divisor)\n  resto = num - (cientos * divisor);\n\n\n  letras = \"\";\n\n  if (cientos > 0)\n    if (cientos > 1)\n      letras = Centenas(cientos) + \" \" + strPlural;\n    else\n      letras = strSingular;\n\n  if (resto > 0)\n    letras += \"\";\n\n  return letras;\n}//Seccion()\n\nfunction Miles(num) {\n  divisor = 1000;\n  cientos = Math.floor(num / divisor)\n  resto = num - (cientos * divisor)\n\n\n  strMiles = Seccion(num, divisor, \"UN MIL\", \"MIL\");\n  strCentenas = Centenas(resto);\n\n  if (strMiles == \"\")\n    return strCentenas;\n\n  return strMiles + \" \" + strCentenas;\n}//Miles()\n\nfunction Millones(num) {\n  divisor = 1000000;\n  cientos = Math.floor(num / divisor)\n  resto = num - (cientos * divisor)\n\n\n  strMillones = Seccion(num, divisor, \"UN MILLON DE\", \"MILLONES DE\");\n  strMiles = Miles(resto);\n\n  if (strMillones == \"\")\n    return strMiles;\n\n  return strMillones + \" \" + strMiles;\n}//Millones()\n\nfunction NumeroALetras(num) {\n  var data = {\n    numero: num,\n    enteros: Math.floor(num),\n    centavos: (((Math.round(num * 100)) - (Math.floor(num) * 100))),\n    letrasCentavos: \"\",\n    letrasMonedaPlural: 'DOLARES',//\"PESOS\", 'Dólares', 'Bolívares', 'etcs'\n    letrasMonedaSingular: 'DOLAR', //\"PESO\", 'Dólar', 'Bolivar', 'etc'\n\n    letrasMonedaCentavoPlural: \"CENTAVOS\",\n    letrasMonedaCentavoSingular: \"CENTAVO\"\n  };\n\n  if (data.centavos > 0) {\n    data.letrasCentavos = \"CON \" + (function () {\n      if (data.centavos == 1)\n        return Millones(data.centavos) + \" \" + data.letrasMonedaCentavoSingular;\n      else\n        return Millones(data.centavos) + \" \" + data.letrasMonedaCentavoPlural;\n    })();\n  };\n\n  if (data.enteros == 0)\n    return \"CERO \" + data.letrasMonedaPlural + \" \" + data.letrasCentavos;\n  if (data.enteros == 1)\n    return Millones(data.enteros) + \" \" + data.letrasMonedaSingular + \" \" + data.letrasCentavos;\n  else\n    return Millones(data.enteros) + \" \" + data.letrasMonedaPlural + \" \" + data.letrasCentavos;\n}\n\n\n//Pasar a letras\n$(\"#frm_monto_prestamo\").focusout(function () {\n\n  $(\"#frm_plazo_prestamo\").setValue('');\n  $(\"#frm_total_capital\").setValue('');\n  $(\"#frm_total_interes\").setValue('');\n  $(\"#frm_total_pagar\").setValue('');\n  $(\"#tabla_amor\").html('');\n\n  var numeroaletras = NumeroALetras($(\"#frm_monto_prestamo\").getValue());\n  if (numeroaletras.trim() === \"undefined DOLARES\") {\n    numeroaletras = \"\";\n  }\n\n  if ($(\"#frm_monto_prestamo\").getValue() * 1 < $(\"#tri_monto_minimo_p\").getValue() * 1 || $(\"#frm_monto_prestamo\").getValue() * 1 > $(\"#frm_monto_disponible\").getValue() * 1) {\n    //alert($(\"#frm_monto_prestamo\").getValue() + ' ' + $(\"#tri_monto_minimo_p\").getValue());\n    if ($(\"#frm_monto_prestamo\").getValue() * 1 < $(\"#tri_monto_minimo_p\").getValue() * 1)\n      alert(\"Monto mínimo de prestamo es \" + $(\"#tri_monto_minimo_p\").getValue());\n    if ($(\"#frm_monto_prestamo\").getValue() * 1 > $(\"#frm_monto_disponible\").getValue() * 1)\n      alert(\"Monto máximo de prestamo es \" + $(\"#frm_monto_disponible\").getValue());\n\n    $(\"#frm_monto_prestamo\").setValue('');\n  }\n\n\n  $(\"#frm_monto_prestamo_letras\").setValue(numeroaletras)\n});\n\n//Pasar a letras\n$(\"#frm_monto\").focusout(function () {\n  $(\"#frm_costo_retiro\").setValue('');\n  $(\"#frm_derecho_retiro\").setValue('');\n  $(\"#frm_val_descontado\").setValue('');\n  //console.log('sipp');\n  if ($(\"#frm_monto\").getValue() * 1 < $(\"#tri_monto_minimo_r\").getValue() * 1 || $(\"#frm_monto\").getValue() * 1 > $(\"#frm_monto_disponible\").getValue() * 1) {\n    if ($(\"#frm_monto\").getValue() * 1 < $(\"#tri_monto_minimo_r\").getValue() * 1)\n      alert(\"Monto mínimo de retiro es \" + $(\"#tri_monto_minimo_r\").getValue());\n    if ($(\"#frm_monto\").getValue() * 1 > $(\"#frm_monto_disponible\").getValue() * 1)\n      alert(\"Monto máximo de retiro es \" + $(\"#frm_monto_disponible\").getValue());\n\n    $(\"#frm_monto\").setValue('');\n  }\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_solicitud","var_uid":"4855994035f3ca7c8ba3340013161465","dataType":"string","protectedValue":false,"id":"frm_tipo_solicitud","name":"frm_tipo_solicitud","label":"Tipo de solicitud","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"P","label":"PRESTAMO"},{"value":"R","label":"RETIRO"}],"var_name":"frm_tipo_solicitud","colSpan":6},{"type":"dropdown","variable":"frm_tipo_persona","var_uid":"9671926415f3ca89039a555001479543","dataType":"string","protectedValue":false,"id":"frm_tipo_persona","name":"frm_tipo_persona","label":"Tipo de persona","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"N","label":"PERSONAL NATURAL"},{"value":"J","label":"PERSONA JURIDICA"}],"var_name":"frm_tipo_persona","colSpan":6}],[{"type":"dropdown","variable":"frm_sucursal","var_uid":"2746763005f4ba813922c49091672581","dataType":"string","protectedValue":false,"id":"frm_sucursal","name":"frm_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[10.10.22.63:3306] mysql: certificacion","sql":" \n\nSELECT DISTINCT  CODIGO,  DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSALES_PR' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_sucursal","colSpan":6},{"type":"dropdown","variable":"frm_canal","var_uid":"1584434535f4ba825b3c7d2087987445","dataType":"string","protectedValue":false,"id":"frm_canal","name":"frm_canal","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMOS_SISE' AND ESTADO = 1 ORDER BY DESCRIPCION AND CODIGO = '59'","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_canal","colSpan":6}],[{"type":"text","variable":"frm_numero_poliza","var_uid":"9448278215f3d610e247f97017478282","dataType":"string","protectedValue":false,"id":"frm_numero_poliza","name":"frm_numero_poliza","label":"# de poliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_poliza","colSpan":6},{"type":"text","variable":"frm_numero_endozo_vigente","var_uid":"8918431995f49957e759b46007053039","dataType":"string","protectedValue":false,"id":"frm_numero_endozo_vigente","name":"frm_numero_endozo_vigente","label":"# de endoso vigente ","tabIndex":"","defaultValue":"0","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_endozo_vigente","colSpan":6}],[{"colSpan":4},{"type":"button","id":"btn_consultar","name":"btn_consultar","label":"CONSULTAR","tabIndex":"","ariaLabel":"","colSpan":4},{"colSpan":4}],[{"type":"hidden","variable":"cod_aseg","var_uid":"6513748805f764514773497068652990","dataType":"string","protectedValue":false,"id":"cod_aseg","name":"cod_aseg","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"cod_aseg","colSpan":1},{"type":"hidden","variable":"id_pev_cero","var_uid":"9185007605f4d63e9412456055659792","dataType":"string","protectedValue":false,"id":"id_pev_cero","name":"id_pev_cero","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"id_pev_cero","colSpan":1},{"type":"hidden","variable":"tri_table_amor","var_uid":"8843220135f76614f33ea52077482361","dataType":"string","protectedValue":false,"id":"tri_table_amor","name":"tri_table_amor","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_table_amor","colSpan":1},{"type":"hidden","variable":"imp_valor_rescate","var_uid":"8639820805f7bac73570732086791858","dataType":"string","protectedValue":false,"id":"imp_valor_rescate","name":"imp_valor_rescate","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"imp_valor_rescate","colSpan":1},{"type":"hidden","variable":"tri_monto_minimo_p","var_uid":"5919163765fbdbf5accb8a0044911865","dataType":"string","protectedValue":false,"id":"tri_monto_minimo_p","name":"tri_monto_minimo_p","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_monto_minimo_p","colSpan":1},{"type":"hidden","variable":"tri_monto_minimo_r","var_uid":"8583123385fbdbf62741568077848902","dataType":"string","protectedValue":false,"id":"tri_monto_minimo_r","name":"tri_monto_minimo_r","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_monto_minimo_r","colSpan":1},{"type":"hidden","variable":"frm_cod_tipoAgente","var_uid":"705756418645638390b11e4041099105","dataType":"string","protectedValue":false,"id":"frm_cod_tipoAgente","name":"frm_cod_tipoAgente","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cod_tipoAgente","colSpan":1},{"type":"hidden","variable":"frm_tipo_agente","var_uid":"6402496206456385962b764076335941","dataType":"string","protectedValue":false,"id":"frm_tipo_agente","name":"frm_tipo_agente","defaultValue":"","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT DESCRIPCION, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_AGENTE' AND CODIGO = '@#frm_cod_tipoAgente'","var_name":"frm_tipo_agente","colSpan":1},{"type":"hidden","variable":"frm_cod_agente","var_uid":"7240042686456386bc04268011504583","dataType":"string","protectedValue":false,"id":"frm_cod_agente","name":"frm_cod_agente","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cod_agente","colSpan":1},{"type":"hidden","variable":"frm_agente","var_uid":"20906432464563875734a15036274003","dataType":"string","protectedValue":false,"id":"frm_agente","name":"frm_agente","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_agente","colSpan":1},{"type":"hidden","variable":"frm_canal_venta","var_uid":"83821003364563883bfe071069877366","dataType":"string","protectedValue":false,"id":"frm_canal_venta","name":"frm_canal_venta","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_canal_venta","colSpan":1},{"type":"hidden","variable":"frm_linea_negocio","var_uid":"17144932364563891d53789062966280","dataType":"string","protectedValue":false,"id":"frm_linea_negocio","name":"frm_linea_negocio","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","