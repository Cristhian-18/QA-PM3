n":12}]],"variables":[{"var_uid":"8364879445f3ea1538a0212086841201","prj_uid":"8576130285f3aa779242d43020182139","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
