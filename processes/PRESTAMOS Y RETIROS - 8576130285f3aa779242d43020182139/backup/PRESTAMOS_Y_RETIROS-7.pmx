","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_comentario","name":"txt_comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"8364879445f3ea1538a0212086841201","prj_uid":"8576130285f3aa779242d43020182139","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"sbt_accion","label":"Atencion\n","colSpan":12}],[{"type":"dropdown","variable":"cmb_accion_t3","var_uid":"8298955285f3eacc9068158035306621","dataType":"string","protectedValue":false,"id":"cmb_accion_t3","name":"cmb_accion_t3","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"A","label":"REVISADO Y APROBADO"},{"value":"N","label":"NOVEDADES"}],"var_name":"cmb_accion_t3","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"9590244945f3e92d58f7e09072227177","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Comentario","defaultValue":"--","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"3","var_name":"frm_comentario","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"CONTINUAR","colSpan":12}]],"variables":[{"var_uid":"6479542975f3ca21fb74b16059720012","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6479542975f3ca21fb74b16059720012","var_name_old":"frm_recibio_deposito","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"8298955285f3eacc9068158035306621","prj_uid":"8576130285f3aa779242d43020182139","var_name":"cmb_accion_t3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9590244945f3e92d58f7e09072227177","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
