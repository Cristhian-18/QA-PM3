        <dyn_content><![CDATA[{"name":"Subform Datos Acreditacion","description":"Subform Datos Acreditacion","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3481439505f3d658c99b673065865401","name":"Subform Datos Acreditacion","description":"Subform Datos Acreditacion","mode":"edit","script":{"type":"js","code":"$(\"#frm_cedula_receptor\").focusout(function(){\n\tvar bool = validarIdentificacion($('#frm_cedula_receptor ').getValue(), $('#frm_tipo_identificacion_receptor').getControl().val());\n\tif(bool == false){\n\t\t$('#frm_cedula_receptor ').setValue(\"\");\n      \talert(\"Numero de identificacion incorrecta\");     \n\t}\n  \n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n\treturn false;\n  }\n  if(tipoIdentificacion=='R'){\n  if (numero.length != 13) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n\n  var bandera = true;\n  \n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\t\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\t\n    \/\/comprobando codigo verificador\n    decena = total \/ 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\t\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      \/\/alert(\"Cedula valida\");\n      return true;\n    }else{\n\t  \/\/Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_acreditacion","label":"El titular de la cuenta debe ser el contratante. No se aceptan cuentas de terceros.","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion_receptor","var_uid":"8656901585f3d65d2e038b0000771587","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_receptor","name":"frm_tipo_identificacion_receptor","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_receptor","colSpan":6},{"type":"text","variable":"frm_cedula_receptor","var_uid":"3511023375f3d65e65fcb06048948927","dataType":"string","protectedValue":false,"id":"frm_cedula_receptor","name":"frm_cedula_receptor","label":"Identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cedula_receptor","colSpan":6}],[{"type":"dropdown","variable":"frm_entidad_financiera_receptor","var_uid":"7255650305f3d6620583964073543587","dataType":"string","protectedValue":false,"id":"frm_entidad_financiera_receptor","name":"frm_entidad_financiera_receptor","label":"Banco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT DISTINCT CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'PR'\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_entidad_financiera_receptor","colSpan":6},{"type":"dropdown","variable":"frm_medio_pago_receptor","var_uid":"9788955955f3d662cbf4718002962025","dataType":"string","protectedValue":false,"id":"frm_medio_pago_receptor","name":"frm_medio_pago_receptor","label":"Tipo de Cuenta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"var_name":"frm_medio_pago_receptor","colSpan":6}],[{"type":"text","variable":"frm_numero_cuenta_receptor","var_uid":"9940243235f3d663aa0b336012353922","dataType":"string","protectedValue":false,"id":"frm_numero_cuenta_receptor","name":"frm_numero_cuenta_receptor","label":"# Cuenta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"no valido","maxLength":"15","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_cuenta_receptor","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"8656901585f3d65d2e038b0000771587","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_tipo_identificacion_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3511023375f3d65e65fcb06048948927","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_cedula_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7255650305f3d6620583964073543587","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_entidad_financiera_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9788955955f3d662cbf4718002962025","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_medio_pago_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9940243235f3d663aa0b336012353922","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_numero_cuenta_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
