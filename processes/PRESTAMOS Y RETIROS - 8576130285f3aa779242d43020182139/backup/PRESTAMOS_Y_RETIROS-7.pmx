        <dyn_content><![CDATA[{"name":"Subform Datos Debito","description":"Subform Datos Debito","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3420420135f3cad48cf08a7020087388","name":"Subform Datos Debito","description":"Subform Datos Debito","mode":"edit","script":{"type":"js","code":"$(\"#frm_cedula_pagador\").focusout(function () {\n  var bool = validarIdentificacion($('#frm_cedula_pagador ').getValue(), $('#frm_tipo_identificacion_pagador').getControl().val());\n  if (bool == false) {\n    $('#frm_cedula_pagador ').setValue(\"\");\n    alert(\"Numero de identificacion incorrecta\");\n  }\n\n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion) {\n  numero = identificacion;\n  if (tipoIdentificacion == '') {\n    alert(\"Ingrese el tipo de identificacion\");\n    return false;\n  }\n  if (tipoIdentificacion == 'R') {\n    if (numero.length != 13) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n\n  var bandera = true;\n\n  if (tipoIdentificacion == 'C') {\n    if (numero.length != 10) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n  if (bandera) {\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9] * 1);\n\n    for (i = 0; i < (totdigitos - 1); i++) {\n      mult = 0;\n      if ((i % 2) != 0) {\n        total = total + (digitos[i] * 1);\n      } else {\n        mult = digitos[i] * 2;\n        if (mult > 9)\n          total = total + (mult - 9);\n        else\n          total = total + mult;\n      }\n    }\n\n    //comprobando codigo verificador\n    decena = total / 10;\n    decena = Math.floor(decena);\n    decena = (decena + 1) * 10;\n    final = (decena - total);\n\n    if ((final == 10 && digito == 0) || (final == digito)) {\n      //alert(\"Cedula valida\");\n      return true;\n    } else {\n      //Validar pasaporte\n      if (tipoIdentificacion == 'P' && numero.length <= 30) {\n        return true;\n      }\n      if (tipoIdentificacion == 'P' && numero.length > 30) {\n        alert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n        // alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}\n\n//$(\"#frm_tipo_identificacion_pagador\").hide();\n//$(\"#frm_cedula_pagador\").hide();\nif ($(\"#tri_ban_portal\").getValue() == 'SI') {\n  $(\"#grd_ctas_debito\").hide();\n  $(\"#chk_nuevo_banco\").hide();\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"4746962945e7eb5f58b08e5020280313","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"grid","variable":"grd_ctas_debito","var_uid":"1196714225f7d134f7780d0014993040","dataType":"grid","protectedValue":false,"id":"grd_ctas_debito","name":"grd_ctas_debito","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_entidad_financiera","name":"grd_entidad_financiera","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"1471226895f49403bebfa26089899906","dbConnectionLabel":"[10.10.52.51:1433] mssql: vida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'AC'\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[],"columnWidth":"30","width":100,"title":"Banco","var_name":"grd_ctas_debito"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_medio_pago","name":"grd_medio_pago","label":"Tipo de Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"columnWidth":"20","width":100,"title":"Tipo de Cuenta"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_numero_cuenta","name":"grd_numero_cuenta","label":"# Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"30","width":100,"title":"# Cuenta"},{"type":"checkbox","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_selecc","name":"grd_selecc","label":"Seleccionar","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[],"columnWidth":"20","width":100,"title":"Seleccionar"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}],[{"type":"checkbox","variable":"chk_nuevo_banco","var_uid":"9198399645f7d2755da3dd1007077596","dataType":"boolean","protectedValue":false,"id":"chk_nuevo_banco","name":"chk_nuevo_banco","label":"Para ingresar un nuevo banco ingrese los datos.","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"chk_nuevo_banco","colSpan":12}],[{"type":"dropdown","variable":"frm_entidad_financiera","var_uid":"6913105725e7e99f5066af3054784745","dataType":"string","protectedValue":false,"id":"frm_entidad_financiera","name":"frm_entidad_financiera","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'AC'\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_entidad_financiera","colSpan":4},{"type":"dropdown","variable":"frm_medio_pago","var_uid":"6834203835e7e994a3641b8040677841","dataType":"string","protectedValue":false,"id":"frm_medio_pago","name":"frm_medio_pago","label":"Tipo de Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"var_name":"frm_medio_pago","colSpan":4},{"type":"text","variable":"frm_numero_cuenta","var_uid":"5860384115f3d63a21dd3b7046995957","dataType":"string","protectedValue":false,"id":"frm_numero_cuenta","name":"frm_numero_cuenta","label":"# Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"no valido","maxLength":"15","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_cuenta","colSpan":4}],[{"type":"hidden","variable":"tri_ban_portal","var_uid":"6798429815f8bcc19336418012843215","dataType":"string","protectedValue":false,"id":"tri_ban_portal","name":"tri_ban_portal","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_ban_portal","colSpan":12}]],"variables":[{"var_uid":"4746962945e7eb5f58b08e5020280313","prj_uid":"