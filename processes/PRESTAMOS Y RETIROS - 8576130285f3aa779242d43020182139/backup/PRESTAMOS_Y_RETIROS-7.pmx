85f3aa779242d43020182139","var_name":"frm_documentos_natural_representante_cedula","var_field_type":"file","var_field_size":10,"var_label":"file","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":"4972393305f3d3380b23a46028329965"},{"var_uid":"67436040960c80a8d1a2c72098405343","prj_uid":"8576130285f3aa779242d43020182139","var_name":"chk_documentos","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[{\"value\":\"1\",\"label\":\"true\"},{\"value\":\"0\",\"label\":\"false\"}]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"ifrm_sbt_acreedor","label":"<span class=\"subtitulo\" id=\"iifrm_sbt_acreedor\" subform=\"3481439505f3d658c99b673065865401\"> <i class=\"glyphicon glyphicon-plus\"></i> \n Cuenta para Acreditacion</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3481439505f3d658c99b673065865401","name":"Subform Datos Acreditacion","description":"Subform Datos Acreditacion","mode":"edit","script":{"type":"js","code":"$(\"#frm_cedula_receptor\").focusout(function(){\n\tvar bool = validarIdentificacion($('#frm_cedula_receptor ').getValue(), $('#frm_tipo_identificacion_receptor').getControl().val());\n\tif(bool == false){\n\t\t$('#frm_cedula_receptor ').setValue(\"\");\n      \talert(\"Numero de identificacion incorrecta\");     \n\t}\n  \n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n\treturn false;\n  }\n  if(tipoIdentificacion=='R'){\n  if (numero.length != 13) {\n    //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n\n  var bandera = true;\n  \n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n    //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\t\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\t\n    //comprobando codigo verificador\n    decena = total / 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\t\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      //alert(\"Cedula valida\");\n      return true;\n    }else{\n\t  //Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       // alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_acreditacion","label":"El titular de la cuenta debe ser el contratante. No se aceptan cuentas de terceros.","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion_receptor","var_uid":"8656901585f3d65d2e038b0000771587","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_receptor","name":"frm_tipo_identificacion_receptor","label":"Tipo ID","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_receptor","colSpan":6},{"type":"text","variable":"frm_cedula_receptor","var_uid":"3511023375f3d65e65fcb06048948927","dataType":"string","protectedValue":false,"id":"frm_cedula_receptor","name":"frm_cedula_receptor","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cedula_receptor","colSpan":6}],[{"type":"dropdown","variable":"frm_entidad_financiera_receptor","var_uid":"7255650305f3d6620583964073543587","dataType":"string","protectedValue":false,"id":"frm_entidad_financiera_receptor","name":"frm_entidad_financiera_receptor","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT DISTINCT CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'PR'\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_entidad_financiera_receptor","colSpan":6},{"type":"dropdown","variable":"frm_medio_pago_receptor","var_uid":"9788955955f3d662cbf4718002962025","dataType":"string","protectedValue":false,"id":"frm_medio_pago_receptor","name":"frm_medio_pago_receptor","label":"Tipo de Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"var_name":"frm_medio_pago_receptor","colSpan":6}],[{"type":"text","variable":"frm_numero_cuenta_receptor","var_uid":"9940243235f3d663aa0b336012353922","dataType":"string","protectedValue":false,"id":"frm_numero_cuenta_receptor","name":"frm_numero_cuenta_receptor","label":"# Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"no valido","maxLength":"15","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_cuenta_receptor","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"8656901585f3d65d2e038b0000771587","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_tipo_identificacion_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3511023375f3d65e65fcb06048948927","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_cedula_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7255650305f3d6620583964073543587","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_entidad_financiera_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9788955955f3d662cbf4718002962025","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_medio_pago_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9940243235f3d663aa0b336012353922","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_numero_cuenta_receptor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"frm_sbt_debito","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_debito\" subform=\"3420420135f3cad48cf08a7020087388\"> <i class=\"glyphicon glyphicon-plus\"></i> \n Datos para Debito</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3420420135f3cad48cf08a7020087388","name":"Subform Datos Debito","description":"Subform Datos Debito","mode":"edit","script":{"type":"js","code":"$(\"#frm_cedula_pagador\").focusout(function () {\n  var bool = validarIdentificacion($('#frm_cedula_pagador ').getValue(), $('#frm_tipo_identificacion_pagador').getControl().val());\n  if (bool == false) {\n    $('#frm_cedula_pagador ').setValue(\"\");\n    alert(\"Numero de identificacion incorrecta\");\n  }\n\n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion) {\n  numero = identificacion;\n  if (tipoIdentificacion == '') {\n    alert(\"Ingrese el tipo de identificacion\");\n    return false;\n  }\n  if (tipoIdentificacion == 'R') {\n    if (numero.length != 13) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n\n  var bandera = true;\n\n  if (tipoIdentificacion == 'C') {\n    if (numero.length != 10) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n  if (bandera) {\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9] * 1);\n\n    for (i = 0; i < (totdigitos - 1); i++) {\n      mult = 0;\n      if ((i % 2) != 0) {\n        total = total + (digitos[i] * 1);\n      } else {\n        mult = digitos[i] * 2;\n        if (mult > 9)\n          total = total + (mult - 9);\n        else\n          total = total + mult;\n      }\n    }\n\n    //comprobando codigo verificador\n    decena = total / 10;\n    decena = Math.floor(decena);\n    decena = (decena + 1) * 10;\n    final = (decena - total);\n\n    if ((final == 10 && digito == 0) || (final == digito)) {\n      //alert(\"Cedula valida\");\n      return true;\n    } else {\n      //Validar pasaporte\n      if (tipoIdentificacion == 'P' && numero.length <= 30) {\n        return true;\n      }\n      if (tipoIdentificacion == 'P' && numero.length > 30) {\n        alert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n        // alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}\n\n//$(\"#frm_tipo_identificacion_pagador\").hide();\n//$(\"#frm_cedula_pagador\").hide();\nif ($(\"#tri_ban_portal\").getValue() == 'SI') {\n  $(\"#grd_ctas_debito\").hide();\n  $(\"#chk_nuevo_banco\").hide();\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"4746962945e7eb5f58b08e5020280313","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"grid","variable":"grd_ctas_debito","var_uid":"1196714225f7d134f7780d0014993040","dataType":"grid","protectedValue":false,"id":"grd_ctas_debito","name":"grd_ctas_debito","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_entidad_financiera","name":"grd_entidad_financiera","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"1471226895f49403bebfa26089899906","dbConnectionLabel":"[10.10.52.51:1433] mssql: vida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'AC'\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[],"columnWidth":"30","width":100,"title":"Banco","var_name":"grd_ctas_debito"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_medio_pago","name":"grd_medio_pago","label":"Tipo de Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"columnWidth":"20","width":100,"title":"Tipo de Cuenta"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_numero_cuenta","name":"grd_numero_cuenta","label":"# Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"30","width":100,"title":"# Cuenta"},{"type":"checkbox","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_selecc","name":"grd_sele