        <dyn_content><![CDATA[{"name":"SubForm Documentos","description":"SubForm Documentos","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13283628860e352dadef162015150841","name":"SubForm Documentos","description":"SubForm Documentos","mode":"edit","script":{"type":"js","code":"\/\/ Resuelve el bug de que el link de la grilla\n\/\/ no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    \/*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    *\/\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  \/\/ Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"\/plugin\/beesmartec\/core_librerias\/datatables\/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"\/plugin\/beesmartec\/core_librerias\/datatables\/jquery.dataTables.css,\n\/plugin\/beesmartec\/core_librerias\/datatables\/jquery.dataTables.js,\n\/plugin\/beesmartec\/core_librerias\/dataTables\/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Archivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Comentario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Usuario","name":"gridDocumentos_Usuario","label":"Usuario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Usuario"},{"type":"link","id":"gridDocumentos_Descarga","name":"gridDocumentos_Descarga","label":"","value":"Descargar","href":"","hint":"","columnWidth":"20","width":100,"title":""}],"data":[],"mode":"view","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Documentos del flujo","colSpan":12}]],"variables":[]}]}]]></dyn_content>
