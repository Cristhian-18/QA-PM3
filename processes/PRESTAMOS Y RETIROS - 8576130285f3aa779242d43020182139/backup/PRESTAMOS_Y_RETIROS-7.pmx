ql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9579963435e8579e5dc9351087274555","var_name_old":"expresion_regular_2","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"7631587875f3ca2543bdbd2020871489","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2837094465ec434e3918ce2092196455","var_name_old":"expresion_regular_3","prj_uid_old":"5393441295ebc1555705f98060769179"},{"var_uid":"2590718105f3ca25452fb31095485119","prj_uid":"8576130285f3aa779242d43020182139","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9491441075ec434e3b51753019415626","var_name_old":"expresion_regular_4","prj_uid_old":"5393441295ebc1555705f98060769179"}],"colSpan":12}],[{"type":"title","id":"tit_autorizacion","label":"CONFIRMAR LA TRANSFERENCIA DE PRESTAMO O RETIRO","colSpan":12}],[{"type":"panel","id":"pnl_op","content":"<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"><\/i> Mensaje...!<\/h4>\n    <h2><div id=\"html_op\"><\/div><\/h2>\n  <\/div>\n<\/div>","border":"1px","colSpan":12}],[{"type":"subtitle","id":"frm_sbt_datos_asegurado","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_datos_asegurado\" subform=\"7689594095f3ca309a42d38006294228\"> <i class=\"glyphicon glyphicon-plus\"><\/i> Datos Asegurado<\/span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7689594095f3ca309a42d38006294228","name":"Subform Datos contratantes","description":"Subform Datos contratantes","mode":"disabled","script":{"type":"js","code":"\/\/ocultar campo endoso va opo default 0\n$(\"#frm_numero_endozo_vigente\").hide();\n\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_numero_identificacion_juridico\").focusout(function () {\n    if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificacion($('#frm_numero_identificacion_juridico').getValue(), $('#frm_tipo_identificacion_juridico').getControl().val());\n        if (bool == false) {\n            $('#frm_numero_identificacion_juridico').setValue(\"\");\n        }\n    }\n});\n\n\n\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_plazo_prestamo\").focusout(function () {\n  var monto = $('#frm_monto_prestamo').getValue();\n  if($('#frm_frecuencia_pago').getValue() == '1')\n    var frec = 12;\n  if($('#frm_frecuencia_pago').getValue() == '6')\n    var frec = 1;\n  if($('#frm_frecuencia_pago').getValue() == '2')\n    var frec = 6;\n  if($('#frm_frecuencia_pago').getValue() == '4')\n    var frec = 3;\n  \n  var plazo = ($('#frm_plazo_prestamo').getValue()*1) * frec;\n  \/\/console.log(plazo);\n  var frecuencia = $('#frm_frecuencia_pago').getValue();\n  \t \n  \/\/monto 5000\n  if(monto <= 5000){\n\tif(plazo > 12){\n\t\talert(\"Plazo no valido \\n por ese monto solo se admite hasta 12 meses\");\n\t\t$(\"#frm_plazo_prestamo\").setValue('');\n\t\treturn false;\n\t}\n  }\n  \/\/monto 10000\n  if(monto > 5000 && monto <= 10000){\n\tif(plazo > 24){\n\t\talert(\"Plazo no valido \\n por ese monto solo se admite hasta 24 meses\");\n\t\t$(\"#frm_plazo_prestamo\").setValue('');\n\t\treturn false;\n\t}\n  }\n   \/\/monto 10000\n  if(monto > 10000 && monto <= 100000){\n\tif(plazo > 36){\n\t\talert(\"Plazo no valido \\n por ese monto solo se admite hasta 36 meses\");\n\t\t$(\"#frm_plazo_prestamo\").setValue('');\n\t\treturn false;\n\t}\n  }\n});\n\nfunction FrecuenciaPago(newValue, oldValue) {\n\t\/\/cambio el foco al plazo\n\t$(\"#frm_plazo_prestamo\").getControl().focus();\n}\n\n$(\"#frm_frecuencia_pago\").setOnchange(FrecuenciaPago);\n\nfunction EnableTextbox(newVal, oldVal) {\n        if (newVal == '\"1\"'){\t\n            $(\"#frm_plazo_prestamo\").setValue(\"1\");\n          \t$('#frm_plazo_prestamo').getControl().attr('disabled',true);\t\n          \tvar monto = $('#frm_monto_prestamo').getValue();\n          \tvar frecuencia = $('#frm_frecuencia_pago').getValue();\n          \t if(monto > 3000 || frecuencia == 1){\n              alert(\"Monto o Plazo no valido \\n monto maximo es 3000 y frecuencia 6 meses\");\n              $(\"#frm_monto_prestamo\").setValue('');\n              $(\"#frm_plazo_prestamo\").setValue('');\n               $(\"#frm_frecuencia_pago\").setValue('');\n              return false;\n            }  \n        }\n      else{\n        \t\/\/$(\"#frm_plazo_prestamo\").setValue(\"\");\n          \t$('#frm_plazo_prestamo').getControl().attr('disabled',false);\t\n      }\n  }\n  $(\"#chk_vencimiento\").setOnchange(EnableTextbox);\n\n\nfunction Unidades(num){\n\n  switch(num)\n      {\n    case 1: return \"UN\";\n    case 2: return \"DOS\";\n    case 3: return \"TRES\";\n    case 4: return \"CUATRO\";\n    case 5: return \"CINCO\";\n    case 6: return \"SEIS\";\n    case 7: return \"SIETE\";\n    case 8: return \"OCHO\";\n    case 9: return \"NUEVE\";\n  }\n\n  return \"\";\n}\/\/Unidades()\n\nfunction Decenas(num){\n\n  decena = Math.floor(num\/10);\n  unidad=num-(decena*10);\n  switch(decena)\n      {\n    case 1:\n      switch(unidad)\n          {\n        case 0: return \"DIEZ\";\n        case 1: return \"ONCE\";\n        case 2: return \"DOCE\";\n        case 3: return \"TRECE\";\n        case 4: return \"CATORCE\";\n        case 5: return \"QUINCE\";\n        default: return \"DIECI\" + Unidades(unidad);\n      }\n    case 2:\n      switch(unidad)\n          {\n        case 0: return \"VEINTE\";\n        default: return \"VEINTI\" + Unidades(unidad);\n      }\n    case 3: return DecenasY(\"TREINTA\", unidad);\n    case 4: return DecenasY(\"CUARENTA\", unidad);\n    case 5: return DecenasY(\"CINCUENTA\", unidad);\n    case 6: return DecenasY(\"SESENTA\", unidad);\n    case 7: return DecenasY(\"SETENTA\", unidad);\n    case 8: return DecenasY(\"OCHENTA\", unidad);\n    case 9: return DecenasY(\"NOVENTA\", unidad);\n    case 0: return Unidades(unidad);\n  }\n}\/\/Unidades()\n\nfunction DecenasY(strSin, numUnidades) {\n  if (numUnidades > 0)\n    return strSin + \" Y \" + Unidades(numUnidades)\n\n  return strSin;\n}\/\/DecenasY()\n\nfunction Centenas(num) {\n  centenas = Math.floor(num \/ 100);\n  decenas=num-(centenas*100);\n  switch(centenas)\n      {\n    case 1:\n      if (decenas > 0)\n        return \"CIENTO \" + Decenas(decenas);\n      return \"CIEN\";\n    case 2: return \"DOSCIENTOS \" + Decenas(decenas);\n    case 3: return \"TRESCIENTOS \" + Decenas(decenas);\n    case 4: return \"CUATROCIENTOS \" + Decenas(decenas);\n    case 5: return \"QUINIENTOS \" + Decenas(decenas);\n    case 6: return \"SEISCIENTOS \" + Decenas(decenas);\n    case 7: return \"SETECIENTOS \" + Decenas(decenas);\n    case 8: return \"OCHOCIENTOS \" + Decenas(decenas);\n    case 9: return \"NOVECIENTOS \" + Decenas(decenas);\n  }\n\n  return Decenas(decenas);\n}\/\/Centenas()\n\nfunction Seccion(num, divisor, strSingular, strPlural) {\n  cientos = Math.floor(num \/ divisor)\n  resto=num-(cientos*divisor);\n\n\n  letras = \"\";\n\n  if (cientos > 0)\n    if (cientos > 1)\n      letras = Centenas(cientos) + \" \" + strPlural;\n    else\n      letras = strSingular;\n\n  if (resto > 0)\n    letras += \"\";\n\n  return letras;\n}\/\/Seccion()\n\nfunction Miles(num) {\n  divisor = 1000;\n  cientos = Math.floor(num \/ divisor)\n  resto=num-(cientos*divisor)\n\n\n  strMiles = Seccion(num, divisor, \"UN MIL\", \"MIL\");\n  strCentenas = Centenas(resto);\n\n  if(strMiles == \"\")\n    return strCentenas;\n\n  return strMiles + \" \" + strCentenas;\n}\/\/Miles()\n\nfunction Millones(num) {\n  divisor = 1000000;\n  cientos = Math.floor(num \/ divisor)\n  resto=num-(cientos*divisor)\n\n\n  strMillones = Seccion(num, divisor, \"UN MILLON DE\", \"MILLONES DE\");\n  strMiles = Miles(resto);\n\n  if(strMillones == \"\")\n    return strMiles;\n\n  return strMillones + \" \" + strMiles;\n}\/\/Millones()\n\nfunction NumeroALetras(num) {\n  var data = {\n    numero: num,\n    enteros: Math.floor(num),\n    centavos:(((Math.round(num*100))-(Math.floor(num)*100))),\n    letrasCentavos: \"\",\n    letrasMonedaPlural: 'DOLARES',\/\/\"PESOS\", 'Diconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f3')))lares', 'Boliconv('UCS-4LE','UTF-8',pack('V', hexdec('U00ed')))vares', 'etcs'\n    letrasMonedaSingular: 'DOLAR', \/\/\"PESO\", 'Diconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f3')))lar', 'Bolivar', 'etc'\n\n    letrasMonedaCentavoPlural: \"CENTAVOS\",\n    letrasMonedaCentavoSingular: \"CENTAVO\"\n  };\n\n  if (data.centavos > 0) {\n    data.letrasCentavos = \"CON \" + (function (){\n      if (data.centavos == 1)\n        return Millones(data.centavos) + \" \" + data.letrasMonedaCentavoSingular;\n      else\n        return Millones(data.centavos) + \" \" + data.letrasMonedaCentavoPlural;\n    })();\n  };\n\n  if(data.enteros == 0)\n    return \"CERO \" + data.letrasMonedaPlural + \" \" + data.letrasCentavos;\n  if (data.enteros == 1)\n    return Millones(data.enteros) + \" \" + data.letrasMonedaSingular + \" \" + data.letrasCentavos;\n  else\n    return Millones(data.enteros) + \" \" + data.letrasMonedaPlural + \" \" + data.letrasCentavos;\n}\n\n\n\/\/Pasar a letras\n$(\"#frm_monto_prestamo\").focusout( function () {\n  \n  $(\"#frm_plazo_prestamo\").setValue('');\n  $(\"#frm_total_capital\").setValue('');\n  $(\"#frm_total_interes\").setValue('');\n  $(\"#frm_total_pagar\").setValue('');\n  $(\"#tabla_amor\").html('');\n  \n  var numeroaletras=NumeroALetras ($(\"#frm_monto_prestamo\").getValue());\n  if(numeroaletras.trim()===\"undefined DOLARES\"){\n    numeroaletras=\"\";\n  }\n  \n  if($(\"#frm_monto_prestamo\").getValue()*1 < $(\"#tri_monto_minimo_p\").getValue()*1 || $(\"#frm_monto_prestamo\").getValue()*1 > $(\"#frm_monto_disponible\").getValue()*1){\n    \/\/alert($(\"#frm_monto_prestamo\").getValue() + ' ' + $(\"#tri_monto_minimo_p\").getValue());\n  \tif($(\"#frm_monto_prestamo\").getValue()*1 < $(\"#tri_monto_minimo_p\").getValue()*1)\n    \talert(\"Monto m\u00ednimo de prestamo es \"+$(\"#tri_monto_minimo_p\").getValue());\n    if($(\"#frm_monto_prestamo\").getValue()*1 > $(\"#frm_monto_disponible\").getValue()*1)\n       alert(\"Monto m\u00e1ximo de prestamo es \"+$(\"#frm_monto_disponible\").getValue());\n    \n    $(\"#frm_monto_prestamo\").setValue('');\n  }\n\n\n  $(\"#frm_monto_prestamo_letras\").setValue(numeroaletras)\n}); \n\n\/\/Pasar a letras\n$(\"#frm_monto\").focusout( function () {\n  $(\"#frm_costo_retiro\").setValue('');\n  $(\"#frm_derecho_retiro\").setValue('');\n  $(\"#frm_val_descontado\").setValue('');\n  \/\/console.log('sipp');\n  if($(\"#frm_monto\").getValue()*1 < $(\"#tri_monto_minimo_r\").getValue()*1 || $(\"#frm_monto\").getValue()*1 > $(\"#frm_monto_disponible\").getValue()*1){\n  \tif($(\"#frm_monto\").getValue()*1 < $(\"#tri_monto_minimo_r\").getValue()*1)\n    \talert(\"Monto m\u00ednimo de retiro es \"+$(\"#tri_monto_minimo_r\").getValue());\n    if($(\"#frm_monto\").getValue()*1 > $(\"#frm_monto_disponible\").getValue()*1)\n       alert(\"Monto m\u00e1ximo de retiro es \"+$(\"#frm_monto_disponible\").getValue());\n   \n    $(\"#frm_monto\").setValue('');\n  }\n}); \n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_solicitud","var_uid":"4855994035f3ca7c8ba3340013161465","dataType":"string","protectedValue":false,"id":"frm_tipo_solicitud","name":"frm_tipo_solicitud","label":"Tipo de solicitud","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"P","label":"PRESTAMO"},{"value":"R","label":"RETIRO"}],"var_name":"frm_tipo_solicitud","colSpan":6},{"type":"dropdown","variable":"frm_tipo_persona","var_uid":"9671926415f3ca89039a555001479543","dataType":"string","protectedValue":false,"id":"frm_tipo_persona","name":"frm_tipo_persona","label":"Tipo de persona","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"N","label":"PERSONAL NATURAL"},{"value":"J","label":"PERSONA JURIDICA"}],"var_name":"frm_tipo_persona","colSpan":6}],[{"type":"dropdown","variable":"frm_sucursal","var_uid":"2746763005f4ba813922c49091672581","dataType":"string","protectedValue":false,"id":"frm_sucursal","name":"frm_sucursal","label":"Sucursal","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSALES_PR' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_sucursal","colSpan":6},{"type":"dropdown","variable":"frm_canal","var_uid":"1584434535f4ba825b3c7d2087987445","dataType":"string","protectedValue":false,"id":"frm_canal","name":"frm_canal","label":"Ramo","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMOS_SISE' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_canal","colSpan":6}],[{"type":"text","variable":"frm_numero_poliza","var_uid":"9448278215f3d610e247f97017478282","dataType":"string","protectedValue":false,"id":"frm_numero_poliza","name":"frm_numero_poliza","label":"# de poliza","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_poliza","colSpan":6},{"type":"text","variable":"frm_numero_endozo_vigente","var_uid":"8918431995f49957e759b46007053039","dataType":"string","protectedValue":false,"id":"frm_numero_endozo_vigente","name":"frm_numero_endozo_vigente","label":"# de endoso vigente ","defaultValue":"0","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_endozo_vigente","colSpan":6}],[{"colSpan":4},{"type":"button","id":"btn_consultar","name":"btn_consultar","label":"CONSULTAR","colSpan":4},{"colSpan":4}],[{"type":"hidden","variable":"cod_aseg","var_uid":"6513748805f764514773497068652990","dataType":"string","protectedValue":false,"id":"cod_aseg","name":"cod_aseg","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"cod_aseg","colSpan":2},{"type":"hidden","variable":"id_pev_cero","var_uid":"9185007605f4d63e9412456055659792","dataType":"string","protectedValue":false,"id":"id_pev_cero","name":"id_pev_cero","defaultValue":"","dbConnection":"workflow","dbConne