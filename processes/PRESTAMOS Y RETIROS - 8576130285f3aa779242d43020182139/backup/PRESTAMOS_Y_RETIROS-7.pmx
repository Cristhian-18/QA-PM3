.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\t\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      \/\/alert(\"Cedula valida\");\n      return true;\n    }else{\n\t  \/\/Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_opcion_debito","var_uid":"9532556865f4a6aa27e4b97094844266","dataType":"string","protectedValue":false,"id":"frm_opcion_debito","name":"frm_opcion_debito","label":"Autorizar debito","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"La misma cuenta utilizada para acreditar"},{"value":"N","label":"Una cuenta diferente"}],"var_name":"frm_opcion_debito","colSpan":6},{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"4746962945e7eb5f58b08e5020280313","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6}],[{"type":"text","variable":