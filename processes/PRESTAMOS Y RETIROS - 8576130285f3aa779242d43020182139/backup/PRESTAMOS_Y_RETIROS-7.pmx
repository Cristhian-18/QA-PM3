    $msg_m_auth
);

$token='';
echo 'aqui 1xx';
try {
    if(!empty($rs_m_auth) && is_object($rs_m_auth)) {
        // Si json_decode retorna un objeto
        if(isset($rs_m_auth->Token)) {
            $token = $rs_m_auth->Token;
        }
    } elseif(is_array($rs_m_auth) && count($rs_m_auth) > 0) {
        // Si por alguna razón es un array
        if(isset($rs_m_auth['Token'])) {
