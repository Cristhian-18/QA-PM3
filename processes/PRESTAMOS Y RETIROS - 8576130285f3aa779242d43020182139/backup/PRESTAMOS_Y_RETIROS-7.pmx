{"var_uid":"6356009165ebc18bc793f53046319014","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_cedula_pagador","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6356009165ebc18bc793f53046319014","var_name_old":"frm_cedula_pagador","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"6913105725e7e99f5066af3054784745","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_entidad_financiera","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6913105725e7e99f5066af3054784745","var_name_old":"frm_entidad_financiera","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"6834203835e7e994a3641b8040677841","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_medio_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6834203835e7e994a3641b8040677841","var_name_old":"frm_medio_pago","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"5860384115f3d63a21dd3b7046995957","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_numero_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5860384115f3d63a21dd3b7046995957","var_name_old":"frm_numero_cuenta","prj_uid_old":"8576130285f3aa779242d43020182139","create":false}],"colSpan":12}],[{"type":"hidden","variable":"frm_recibio_deposito","var_uid":"6479542975f3ca21fb74b16059720012","dataType":"string","protectedValue":false,"id":"frm_recibio_deposito","name":"frm_recibio_deposito","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_recibio_deposito","colSpan":6},{"colSpan":6}],[{"type":"subtitle","id":"sbt_historial","label":"<span class=\"subtitulo\" id=\"isbt_historial\" subform=\"2287684385f3ea13a46f6c7064108437\"> <i class=\"glyphicon glyphicon-plus\"><\/i> \n Historial de caso<\/span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"2287684385f3ea13a46f6c7064108437","name":"Subform historial de caso","description":"Subform historial de caso","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_historial_caso","var_uid":"8364879445f3ea1538a0212086841201","dataType":"grid","protectedValue":false,"id":"grd_historial_caso","name":"grd_historial_caso","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"tarea","name":"tarea","label":"Tarea","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"15","width":100,"title":"Tarea","var_name":"grd_historial_caso"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"usuario","name":"usuario","label":"Usuario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"15","width":100,"title":"Usuario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_tranferencia","name":"f_tranferencia","label":"Fecha Tranferencia","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Tranferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_inicio","name":"f_inicio","label":"Fecha Inicio","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Inicio"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_fin","name":"f_fin","label":"Fecha Fin","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"13","width":100,"title":"Fecha Fin"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"accion","name":"accion","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_comentario","name":"txt_comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"8364879445f3ea1538a0212086841201","prj_uid":"8576130285f3aa779242d43020182139","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"sbt_accion","label":"Atencion\n","colSpan":12}],[{"type":"dropdown","variable":"frm_respuesta_cliente","var_uid":"5460561845f6e812c8a4706077706964","dataType":"string","protectedValue":false,"id":"frm_respuesta_cliente","name":"frm_respuesta_cliente","label":"Respuesta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccionar ----"},{"value":"Sin Respuesta","label":"Sin Respuesta"},{"value":"Acepto","label":"Acepto"},{"value":"No Acepto","label":"No Acepto"}],"var_name":"frm_respuesta_cliente","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"9590244945f3e92d58f7e09072227177","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Comentario","defaultValue":"--","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"