grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Archivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Comentario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Usuario","name":"gridDocumentos_Usuario","label":"Usuario","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"20","width":100,"title":"Usuario"},{"type":"link","id":"gridDocumentos_Descarga","name":"gridDocumentos_Descarga","label":"","value":"Descargar","href":"","hint":"","columnWidth":"20","width":100,"title":""}],"data":[],"mode":"view","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Documentos del flujo","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"ifrm_sbt_acreedor","label":"<span class=\"subtitulo\" id=\"iifrm_sbt_acreedor\" subform=\"3481439505f3d658c99b673065865401\"> <i class=\"glyphicon glyphicon-plus\"><\/i> \n Datos acreditar<\/span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3481439505f3d658c99b673065865401","name":"Subform Datos Acreditacion","description":"Subform Datos Acreditacion","mode":"parent","script":{"type":"js","code":"$(\"#frm_cedula_receptor\").focusout(function(){\n\tvar bool = validarIdentificacion($('#frm_cedula_receptor ').getValue(), $('#frm_tipo_identificacion_receptor').getControl().val());\n\tif(bool == false){\n\t\t$('#frm_cedula_receptor ').setValue(\"\");\n      \talert(\"Numero de identificacion incorrecta\");     \n\t}\n  \n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n\treturn false;\n  }\n  if(tipoIdentificacion=='R'){\n  if (numero.length != 13) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n\n  var bandera = true;\n  \n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\t\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\t\n    \/\/comprobando codigo verificador\n    decena = total \/ 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\t\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      \/\/alert(\"Cedula valida\");\n      return true;\n    }else{\n\t  \/\/Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_acreditacion","label":"El titular de la cuenta debe ser el contratante. No se aceptan cuentas de terceros.","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion_receptor","var_uid":"8656901585f3d65d2e038b0000771587","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_receptor","name":"frm_tipo_identificacion_receptor","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","