        <dyn_content><![CDATA[{"name":"Subform Datos Debito View","description":"Subform Datos Debito View","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4507897025f8ee23ab6d4a0062588371","name":"Subform Datos Debito View","description":"Subform Datos Debito View","mode":"disabled","script":{"type":"js","code":"$(\"#frm_cedula_pagador\").focusout(function(){\n\tvar bool = validarIdentificacion($('#frm_cedula_pagador ').getValue(), $('#frm_tipo_identificacion_pagador').getControl().val());\n\tif(bool == false){\n\t\t$('#frm_cedula_pagador ').setValue(\"\");\n      \talert(\"Numero de identificacion incorrecta\");      \n\t}\n  \n});\n\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n\treturn false;\n  }\n  if(tipoIdentificacion=='R'){\n  if (numero.length != 13) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n\n  var bandera = true;\n  \n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n    \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n  \n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\t\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\t\n    \/\/comprobando codigo verificador\n    decena = total \/ 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\t\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      \/\/alert(\"Cedula valida\");\n      return true;\n    }else{\n\t  \/\/Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n\t\talert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n       \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"4746962945e7eb5f58b08e5020280313","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"dropdown","variable":"frm_entidad_financiera","var_uid":"6913105725e7e99f5066af3054784745","dataType":"string","protectedValue":false,"id":"frm_entidad_financiera","name":"frm_entidad_financiera","label":"Banco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"4647520625f3ca6ed2d2621030136501","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS_PR' AND ESTADO=1\nAND VALOR = 'AC'\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_entidad_financiera","colSpan":6},{"type":"dropdown","variable":"frm_medio_pago","var_uid":"6834203835e7e994a3641b8040677841","dataType":"string","protectedValue":false,"id":"frm_medio_pago","name":"frm_medio_pago","label":"Tipo de Cuenta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"0","label":"CUENTA AHORROS"},{"value":"1","label":"CUENTA CORRIENTE"}],"var_name":"frm_medio_pago","colSpan":6}],[{"type":"text","variable":"frm_numero_cuenta","var_uid":"5860384115f3d63a21dd3b7046995957","dataType":"string","protectedValue":false,"id":"frm_numero_cuenta","name":"frm_numero_cuenta","label":"# Cuenta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"no valido","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_cuenta","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"4746962945e7eb5f58b08e5020280313","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_tipo_identificacion_pagador","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_name_old":"frm_tipo_identificacion_pagador","var_uid_old":"4746962945e7eb5f58b08e5020280313","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"6356009165ebc18bc793f53046319014","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_cedula_pagador","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6356009165ebc18bc793f53046319014","var_name_old":"frm_cedula_pagador","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"6913105725e7e99f5066af3054784745","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_entidad_financiera","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6913105725e7e99f5066af3054784745","var_name_old":"frm_entidad_financiera","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"6834203835e7e994a3641b8040677841","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_medio_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6834203835e7e994a3641b8040677841","var_name_old":"frm_medio_pago","prj_uid_old":"8576130285f3aa779242d43020182139","create":false},{"var_uid":"5860384115f3d63a21dd3b7046995957","prj_uid":"8576130285f3aa779242d43020182139","var_name":"frm_numero_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5860384115f3d63a21dd3b7046995957","var_name_old":"frm_numero_cuenta","prj_uid_old":"8576130285f3aa779242d43020182139","create":false}]}]}]]></dyn_content>
