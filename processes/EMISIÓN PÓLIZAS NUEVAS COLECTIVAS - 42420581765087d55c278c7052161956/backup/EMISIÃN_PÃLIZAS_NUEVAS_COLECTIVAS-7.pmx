        <dyn_content><![CDATA[{"name":"Form 12 Emitir Póliza","description":"Form 12 Emitir Póliza","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4890558466515056dc17062022043724","name":"Form 12 Emitir Póliza","description":"Form 12 Emitir Póliza","mode":"edit","script":{"type":"js","code":"//henry"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisión (Cotización Comercial)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"177103750650a494f0656c5013926580\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"177103750650a494f0656c5013926580","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"559109641650a4969cbfb31016177616","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO