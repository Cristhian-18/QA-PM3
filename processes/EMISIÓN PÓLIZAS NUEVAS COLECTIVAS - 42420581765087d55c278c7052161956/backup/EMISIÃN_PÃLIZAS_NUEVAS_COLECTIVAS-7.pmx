    <table name="triggers">
      <record>
        <tri_uid>13259155465446b7befc7a2035234146</tri_uid>
        <tri_title>Inicializar Combo Accion Correccion</tri_title>
        <tri_description>Inicializar Combo Accion Correccion</tri_description>
        <pro_uid>42420581765087d55c278c7052161956</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//created by Hugo
//Inicializar Combo Accion Correccion

