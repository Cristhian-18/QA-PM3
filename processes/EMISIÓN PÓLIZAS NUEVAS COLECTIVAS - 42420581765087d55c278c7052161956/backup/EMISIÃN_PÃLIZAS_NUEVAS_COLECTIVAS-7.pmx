        <dyn_content><![CDATA[{"name":"Form 7 Cotizaci\u00f3n Comercial","description":"Form 7 Cotizaci\u00f3n Comercial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"315375147650a78eb977d21005466644","name":"Form 7 Cotizaci\u00f3n Comercial","description":"Form 7 Cotizaci\u00f3n Comercial","mode":"edit","script":{"type":"js","code":"\n$(\"#frm_datosSolicitud_tipo\").getControl().attr('disabled', true);\n\n$(\"#frm_datosSolicitud_cliente\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_RUC\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_linea\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_ramo\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_sucursal\").getControl().attr('disabled', true);\n\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n\n\n$(\"#frm_datosCotizacion_valorRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_primaNeta\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorSiniestros\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeIncurridos\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorComision\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeComision\").getControl().attr('disabled', true);\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisi\u00f3n (Cotizaci\u00f3n Comercial)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"177103750650a494f0656c5013926580\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos de la solicitud<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"177103750650a494f0656c5013926580","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"edit","script":{"type":"js","code":"\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"559109641650a4969cbfb31016177616","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND ESTADO = 1 and VALOR = \"N\" ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"836437714650a49b8da0f12048209949","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats"