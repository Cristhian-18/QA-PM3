        <dyn_content><![CDATA[{"name":"Form 7 Cotización Tecnica","description":"Form 7 Cotización Tecnica","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"32760751065242f43c30c64083862112","name":"Form 7 Cotización Tecnica","description":"Form 7 Cotización Tecnica","mode":"edit","script":{"type":"js","code":"\n$(\"#frm_datosSolicitud_tipo\").getControl().attr('disabled', true);\n\n$(\"#frm_datosSolicitud_cliente\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_RUC\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_linea\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_ramo\").getControl().attr('disabled', true);\n$(\"#frm_datosSolicitud_sucursal\").getControl().attr('disabled', true);\n\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n\n\n$(\"#frm_datosCotizacion_valorRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_primaNeta\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorSiniestros\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeIncurridos\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorComision\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeComision\").getControl().attr('disabled', true);\n\n\n\nfunction checkAccion(newVal, oldVal) {\n    $(\"#fileComiteSuscripcion_t\").hide();\n    $(\"#fileComiteSuscripcion_t\").disableValidation();\n    if (newVal == 'CONTINUAR') {\n        if ($(\"#tri_bandera_mda\").getValue() == 'true') {\n            $(\"#fileComiteSuscripcion_t\").show();\n            $(\"#fileComiteSuscripcion_t\").enableValidation();\n\n        }\n    }\n    console.log(\"TIPO DE ACCION: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion_t\").getValue(), '');\n$('#frm_accion_t').setOnchange(checkAccion);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisión (Cotización Técnica)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"177103750650a494f0656c5013926580\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"177103750650a494f0656c5013926580","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"edit","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"559109641650a4969cbfb31016177616","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND ESTADO = 1 and VALOR = \"N\" ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"836437714650a49b8da0f12048209949","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"336864363650a49d4228c72081248973","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"385776876650a49e65f8bf9066762230","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_linea","var_uid":"333607248650a49f573ce79020050019","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_linea","name":"frm_datosSolicitud_linea","label":"Línea de Negocio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'LINEA_NEGOCIO' AND VALOR='C' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_linea","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_ramo","var_uid":"656297754650a4a18ee87e0013794507","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_ramo","name":"frm_datosSolicitud_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMO' AND VALOR <> 'AP' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_da