        <dyn_content><![CDATA[{"name":"SubForm Datos Cotización","description":"SubForm Datos Cotización","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"358965563650a5a9310b169033806490","name":"SubForm Datos Cotización","description":"SubForm Datos Cotización","mode":"edit","script":{"type":"js","code":"$(\"#frm_datosCotizacion_valorRazon\").hide();\n$(\"#frm_datosCotizacion_utilidad\").setOnchange(function(newVal, oldVal) {\n  let max = 500;\n  let min = -200;\n  console.log('min ', min);\n  let value = limitMaxMin(newVal, max, min);\n  value = roundToFixed(value, 2);\n  $(\"#frm_datosCotizacion_utilidad\").setValue(value);\n})\n$(\"#frm_datosCotizacion_porcentajeRazon\").setOnchange(function(newVal, oldVal) {\n  let max = 500;\n  let min = -200;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_porcentajeRazon\").setValue(value);\n})\n$(\"#frm_datosCotizacion_porcentajeIncurridos\").setOnchange(function(newVal, oldVal) {\n  let max = 500;\n  let min = -200;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_porcentajeIncurridos\").setValue(value);\n})\n$(\"#frm_datosCotizacion_porcentajeComision\").setOnchange(function(newVal, oldVal) {\n  let max = 500;\n  let min = -200;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_porcentajeComision\").setValue(value);\n})\n//frm_datosCotizacion_primaGanada\n//frm_datosCotizacion_resultadoTecnico\n$(\"#frm_datosCotizacion_primaGanada\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_primaGanada\").setValue(value);\n})\n$(\"#frm_datosCotizacion_resultadoTecnico\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_resultadoTecnico\").setValue(value);\n})\n$(\"#frm_datosCotizacion_valorRazon\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorRazon\").setValue(value);\n})\n$(\"#frm_datosCotizacion_valorSiniestros\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorSiniestros\").setValue(value);\n})\n$(\"#frm_datosCotizacion_valorComision\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorComision\").setValue(value);\n})\n$(\"#frm_datosCotizacion_primaNeta\").setOnchange(function(newVal, oldVal) {\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_primaNeta\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_datosCotizacion_primaNeta","var_uid":"809328936650a5ae588ea02042301024","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaNeta","name":"frm_datosCotizacion_primaNeta","label":"Prima Neta","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaNeta","colSpan":6},{"type":"text","variable":"frm_datosCotizacion_primaGanada","var_uid":"189490972651f9d9f1ffdd8050709127","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaGanada","name":"frm_datosCotizacion_primaGanada","label":"Prima Ganada","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":" ","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaGanada","colSpan":6}],[{"type":"text","variable":"frm_datosCotizacion_resultadoTecnico","var_uid":"164973763651f9df2348816073071014","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_resultadoTecnico","name":"frm_datosCotizacion_resultadoTecnico","label":"Resultado Técnico","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_resultadoTecnico","colSpan":6},{"type":"text","variable":"frm_datosCotizacion_utilidad","var_uid":"469982507651f9e6776eea7088454434","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_utilidad","name":"frm_datosCotizacion_utilidad","label":"Utilidad","tabIndex":"","defaultValue":"","placeholder":"% de utilidad","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"","maxLength":"10000","formula":"((frm_datosCotizacion_resultadoTecnico / frm_datosCotizacion_primaGanada)*100)\n","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_utilidad","colSpan":6}],[{"type":"text","variable":"frm_datosCotizacion_valorSiniestros","var_uid":"935241746650a5afbe2ca70024413926","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_valorSiniestros","name":"frm_datosCotizacion_valorSiniestros","label":" Valor Siniestros Incurridos Netos","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":"20","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_valorSiniestros","colSpan":6},{"type":"text","variable":"frm_datosCotizacion_porcentajeRazon","var_uid":"336331695650a5ad5940617079189909","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_porcentajeRazon","name":"frm_datosCotizacion_porcentajeRazon","label":"Porcentaje Razón Combinada","tabIndex":"","defaultValue":"","placeholder":"100%","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Solo admite numeros enteros, entre 0 y 100 con dos decimales","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"",