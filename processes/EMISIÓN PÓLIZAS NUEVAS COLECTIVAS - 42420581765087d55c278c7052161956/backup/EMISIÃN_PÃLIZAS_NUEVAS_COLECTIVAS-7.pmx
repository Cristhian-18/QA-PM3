ield_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"128880614650bb8e69a20b5026592014","prj_uid":"42420581765087d55c278c7052161956","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"128880614650bb8e69a20b5026592014","var_name_old":"frm_comentario","prj_uid_old":"42420581765087d55c278c7052161956"}]}]}]]></dyn_content>
