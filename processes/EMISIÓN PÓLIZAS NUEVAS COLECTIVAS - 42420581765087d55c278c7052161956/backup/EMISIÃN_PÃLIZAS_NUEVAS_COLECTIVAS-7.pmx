        <dyn_content><![CDATA[{"name":"Form 11 Revisión Borrador Comercial","description":"Form 11 Revisión Borrador Comercial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"29925111965150508b6d804043793290","name":"Form 11 Revisión Borrador Comercial","description":"Form 11 Revisión Borrador Comercial","mode":"edit","script":{"type":"js","code":"\nfunction checkAccion(newVal, oldVal) {\n    $(\"#file_borrador_negado_1\").hide();\n    $(\"#file_borrador_negado_1\").disableValidation();\n  $(\"#fileComiteSuscripcion\").hide();\n        $(\"#fileComiteSuscripcion\").disableValidation();\n          $(\"#frm_emisor_asignado\").disableValidation();\n\n$('#frm_emisor_asignado').hide();\n\n    if (newVal == 'REGRESAR') {\n        $(\"#file_borrador_negado_1\").show();\n        $(\"#file_borrador_negado_1\").enableValidation();\n    } \n  \n  if (newVal == 'CONTINUAR') {\n        $(\"#fileComiteSuscripcion\").show();\n        $(\"#fileComiteSuscripcion\").enableValidation();\n           $(\"#frm_emisor_asignado\").enableValidation();\n\n    $('#frm_emisor_asignado').show();\n\n    } \n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(checkAccion);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisión (Cotización Comercial)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"177103750650a494f0656c5013926580\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"177103750650a494f0656c5013926580","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"559109641650a4969cbfb31016177616","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND ESTADO = 1 and VALOR = \"N\" ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"836437714650a49b8da0f12048209949","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":