        <dyn_content><![CDATA[{"name":"Form 4 Ejecutivo Comercial","description":"Form 4 Ejecutivo Comercial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"999188255650a5c7e8d4f62026348597","name":"Form 4 Ejecutivo Comercial","description":"Form 4 Ejecutivo Comercial","mode":"edit","script":{"type":"js","code":"\/\/\n\/\/disable frm_datosSolicitud_tipo\n\n\n\n$(\"#frm_datosSolicitud_fechaDictamen1\").hide();\n$(\"#frm_datosSolicitud_suscriptorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacion\").hide();\n$(\"#frm_datosSolicitud_fechaAceptacion\").hide();\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n\n\/\/comit\u00e9\n$(\"#fileComiteSuscripcion\").disableValidation();\n\n\/\/para el comite\n\n\nfunction checkAccion(newVal, oldVal) {\n    $(\"#fileComiteSuscripcion\").hide();\n    $(\"#fileComiteSuscripcion\").disableValidation();\n  \tconsole.log('CAMBIO');\n    if (newVal == 'CONTINUAR') {\n        if ($(\"#tri_bandera_mda\").getValue() == 'true') {\n            $(\"#fileComiteSuscripcion\").show();\n            $(\"#fileComiteSuscripcion\").enableValidation();\n        }\n    }\n    console.log(\"TIPO DE ACCION: \" + newVal);\n}\n\/\/execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion_c\").getValue(), '');\n$('#frm_accion_c').setOnchange(checkAccion);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Aprobaci\u00f3n caso Comercial","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"177103750650a494f0656c5013926580\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos de la solicitud<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"177103750650a494f0656c5013926580","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"559109641650a4969cbfb31016177616","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND ESTADO = 1 and VALOR = \"N\" ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"836437714650a49b8da0f12048209949","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","