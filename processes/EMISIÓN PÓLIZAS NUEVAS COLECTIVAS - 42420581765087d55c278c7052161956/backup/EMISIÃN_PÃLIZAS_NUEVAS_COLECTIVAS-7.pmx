 min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_primaNeta\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_datosCotizacion_primaNeta","var_uid":"809328936650a5ae588ea02042301024","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaNeta","name":"frm_datosCotizacion_primaNeta","label":"Prima Neta","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaNeta","colSpan":6},{"type":"text","variable":"frm_datosCotizacion_primaGanada","var_uid":"189490972651f9d9f1ffdd8050709127","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaGanada","name":"frm_datosCotizacion_primaGanada","label":"Prima Ganada","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":" ","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaGanada","colSpan":6}],[{"type":"text","variable":"frm_datosCotizacion_resultadoTecnico","var_uid":"164973763651f9df2348816073071014","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_resultadoTecnico","name":"frm_datosCotizacion_resultadoTecnico","labe