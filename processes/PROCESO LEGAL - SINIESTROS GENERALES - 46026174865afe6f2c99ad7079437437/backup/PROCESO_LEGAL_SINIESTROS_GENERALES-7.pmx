"validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Tranferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_inicio","name":"f_inicio","label":"Fecha Inicio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Inicio"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_fin","name":"f_fin","label":"Fecha Fin","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"13","width":100,"title":"Fecha Fin"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"accion","name":"accion","label":"Accion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_comentario","name":"txt_comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"14665688565afe6f3509103021776326","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"361648268652a78c083ccc4033133874","var_name_old":"grd_historial_caso","prj_uid_old":"35087580064a18c9776b638006106795"}]}]}]]></dyn_content>
