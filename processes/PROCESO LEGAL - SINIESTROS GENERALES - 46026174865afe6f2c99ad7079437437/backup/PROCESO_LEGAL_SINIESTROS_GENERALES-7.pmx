        <dyn_content><![CDATA[{"name":"SF IDS Datos asegurado","description":"SF IDS Datos asegurado","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"55699582765affdbeabb180057428247","name":"SF IDS Datos asegurado","description":"SF IDS Datos asegurado","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_da_fechaNotificacion","var_uid":"78605523165affdc2a86c73005912366","dataType":"string","protectedValue":false,"id":"frm_da_fechaNotificacion","name":"frm_da_fechaNotificacion","label":"Fecha de Notificación:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_fechaNotificacion","colSpan":6},{"type":"text","variable":"frm_da_FechaRegistro","var_uid":"84905341765affdc2ac32f8089117142","dataType":"string","protectedValue":false,"id":"frm_da_FechaRegistro","name":"frm_da_FechaRegistro","label":"Fecha de Registro:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_FechaRegistro","colSpan":6}],[{"type":"dropdown","variable":"frm_da_tipoDocumentoContratante","var_uid":"12757394865affdc2afa179006141818","dataType":"string","protectedValue":false,"id":"frm_da_tipoDocumentoContratante","name":"frm_da_tipoDocumentoContratante","label":"Tipo Documento Contratante","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, UPPER(DESCRIPCION) FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'DOCUMENTO_CONTRATANTE' AND ESTADO = 1 ORDER BY DESCRIPCION\n","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_da_tipoDocumentoContratante","colSpan":6},{"type":"text","variable":"frm_da_NoDocumentoContratate","var_uid":"96478836265affdc2b31007024005953","dataType":"string","protectedValue":false,"id":"frm_da_NoDocumentoContratate","name":"frm_da_NoDocumentoContratate","label":"No. Documento Contratate:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_NoDocumentoContratate","colSpan":6}],[{"type":"text","variable":"frm_rs_codAsegurado","var_uid":"32680385765affdc2b6bc71045707627","dataType":"string","protectedValue":false,"id":"frm_rs_codAsegurado","name":"frm_rs_codAsegurado","label":"Código Asegurado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_codAsegurado","colSpan":6},{"type":"text","variable":"frm_da_apellidoPaterno","var_uid":"33587430065affdc2ba15a8099079472","dataType":"string","protectedValue":false,"id":"frm_da_apellidoPaterno","name":"frm_da_apellidoPaterno","label":"Cliente/Contratista:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"200","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_apellidoPaterno","colSpan":6}],[{"type":"text","variable":"frm_da_celular","var_uid":"63538004165affdc2bdc7f3067461412","dataType":"string","protectedValue":false,"id":"frm_da_celular","name":"frm_da_celular","label":"Celular:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"1000","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_celular","colSpan":6},{"type":"text","variable":"frm_da_correoElectronico","var_uid":"22139280065affdc2c11ff5013076272","dataType":"string","protectedValue":false,"id":"frm_da_correoElectronico","name":"frm_da_correoElectronico","label":"Correo Electrónico:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_da_correoElectronico","colSpan":6}]],"variables":[{"var_uid":"78605523165affdc2a86c73005912366","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_fechaNotificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"96713943365510adf99bba9036522012","var_name_old":"frm_da_fechaNotificacion","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"84905341765affdc2ac32f8089117142","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_FechaRegistro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23929924565510b28f1ba04039454708","var_name_old":"frm_da_FechaRegistro","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"12757394865affdc2afa179006141818","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_tipoDocumentoContratante","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"16945269965510c058cf478046017249","var_name_old":"frm_da_tipoDocumentoContratante","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"96478836265affdc2b31007024005953","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_NoDocumentoContratate","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"80561126365510c3e18be09042565704","var_name_old":"frm_da_NoDocumentoContratate","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"32680385765affdc2b6bc71045707627","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_rs_codAsegurado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"49143890665787b670cb747058960785","var_name_old":"frm_rs_codAsegurado","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"33587430065affdc2ba15a8099079472","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_apellidoPaterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"50279607165510d6c50aea3098178500","var_name_old":"frm_da_apellidoPaterno","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"63538004165affdc2bdc7f3067461412","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_celular","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"85678335365510e8c42c849088647209","var_name_old":"frm_da_celular","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"22139280065affdc2c11ff5013076272","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_da_correoElectronico","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"30677015465510e5c8f6909074820448","var_name_old":"frm_da_correoElectronico","prj_uid_old":"1000194806550fb7da01a56009651331","create":false}]}]}]]></dyn_content>
