      <record>
        <dyn_uid>35655585465afe6f345e697033456384</dyn_uid>
        <dyn_title>Form 1 Asignar proceso legal</dyn_title>
        <dyn_description>Form 1 Asignar proceso legal</dyn_description>
        <pro_uid>46026174865afe6f2c99ad7079437437</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[46026174865afe6f2c99ad7079437437/35655585465afe6f345e697033456384]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Form 1 Asignar proceso legal","description":"Form 1 Asignar proceso legal","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"35655585465afe6f345e697033456384","name":"Form 1 Asignar proceso legal","description":"Form 1 Asignar proceso legal","mode":"edit","script":{"type":"js","code":"\r\n$('.menu').on('click', function () {\r\n  ocultar_todo()\r\n  console.log(this.id)\r\n  console.log('CAMBIO')\r\n  switch (this.id) {\r\n    case 'solicitud':\r\n      mostrar_solicitud()\r\n      break\r\n    case 'documentos':\r\n      $('#sub_documentos').show()\r\n      $('#89682335465afe6f344a372005028595').show()\r\n      break\r\n    case 'historial':\r\n      $('#sub_historial').show()\r\n      $('#24402141165afe6f3464602000676261').show()\r\n      break\r\n\r\n  }\r\n})\r\n\r\nfunction ocultar_todo() {\r\n  $('#sub_info').hide()\r\n  $('#39099956865afe6f34626a7042279865').hide()\r\n  $('#sub_declaracion').hide()\r\n  $('#99540153965afe6f344b488063484252').hide()\r\n  $('#sub_poliza').hide()\r\n  $('#91396116065afe6f345c669041463905').hide()\r\n  $('#sub_parte').hide()\r\n  $('#88721209965afe6f345b6a4073649834').hide()\r\n  $('#sub_historial').hide()\r\n  $('#24402141165afe6f3464602000676261').hide()\r\n  $('#sub_documentos').hide()\r\n  $('#89682335465afe6f344a372005028595').hide()\r\n\r\n}\r\nfunction mostrar_solicitud() {\r\n  $('#sub_info').show()\r\n  $('#39099956865afe6f34626a7042279865').show()\r\n  $('#sub_declaracion').show()\r\n  $('#99540153965afe6f344b488063484252').show()\r\n  $('#sub_poliza').show()\r\n  $('#91396116065afe6f345c669041463905').show()\r\n  $('#sub_parte').show()\r\n  $('#88721209965afe6f345b6a4073649834').show()\r\n\r\n}\r\n\r\nocultar_todo()\r\nmostrar_solicitud()\r\n\r\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Asignar a abogado","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":""