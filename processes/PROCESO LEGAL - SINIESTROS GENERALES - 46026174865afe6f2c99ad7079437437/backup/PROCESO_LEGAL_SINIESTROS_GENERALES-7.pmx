NO","label":"NO"}],"var_name":"frm_as_requiereAjustador","colSpan":6},{"colSpan":6}],[{"type":"dropdown","variable":"frm_as_tipoAjustador","var_uid":"11175435165b000d9427714072457774","dataType":"string","protectedValue":false,"id":"frm_as_tipoAjustador","name":"frm_as_tipoAjustador","label":"Tipo Ajustador","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SINIESTROS_ANALISTAS_GN","label":"INTERNO"},{"value":"SINIESTROS_AJUSTADORES_EXTERNOS","label":"EXTERNO"}],"var_name":"frm_as_tipoAjustador","colSpan":6},{"type":"text","variable":"frm_as_causaRequerimientoAjustador","var_uid":"71204639265b000d945a182035630408","dataType":"string","protectedValue":false,"id":"frm_as_causaRequerimientoAjustador","name":"frm_as_causaRequerimientoAjustador","label":"Motivo designación ajustador","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"200","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_as_causaRequerimientoAjustador","colSpan":6}],[{"type":"dropdown","variable":"frm_as_nombreAjustadorAsignado","var_uid":"29123775965b000d949b830083159778","dataType":"string","protectedValue":false,"id":"frm_as_nombreAjustadorAsignado","name":"frm_as_nombreAjustadorAsignado","label":"Ajustador Asignado:","tabIndex":"","defaultValue":"@@USER_LOGGED","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT\n    U.USR_UID,\n    UPPER(CONCAT(\n        USR_FIRSTNAME,\n        ' ',\n        USR_LASTNAME\n    )\n) AS NOMBRE\nFROM USERS U, GROUP_USER G\nWHERE\n    U.USR_UID = G.USR_UID\n    AND GRP_UID = (\n        SELECT\n            GRP_UID\n        FROM GROUPWF\n        WHERE GRP_TITLE = \"@#frm_as_tipoAjustador\"\n    )\n","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_as_nombreAjustadorAsignado","colSpan":6},{"type":"text","variable":"frm_as_emailAjustadorAsignado","var_uid":"46855910665b000d94dcf55047345012","dataType":"string","protectedValue":false,"id":"frm_as_emailAjustadorAsignado","name":"frm_as_emailAjustadorAsignado","label":"Email Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_EMAIL, USR_EMAIL FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_emailAjustadorAsignado","colSpan":6}],[{"type":"text","variable":"frm_as_telefonoAjustadorAsignado","var_uid":"15846672465b000d951d629025938147","dataType":"string","protectedValue":false,"id":"frm_as_telefonoAjustadorAsignado","name":"frm_as_telefonoAjustadorAsignado","label":"Teléfono Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"15","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_PHONE, USR_PHONE FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_telefonoAjustadorAsignado","colSpan":6},{"colSpan":6}],[{"type":"multipleFile","variable":"fle_docs_analista","var_uid":"59113075165b000d955b4b3057207317","dataType":"multiplefile","protectedValue":false,"id":"fle_docs_analista","name":"fle_docs_analista","label":"Adjuntar Documentos","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"4072964256579d07f770873059916631","var_name":"fle_docs_analista","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"39686920565b000d91557d2025896277","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_ac_tipoOperacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"40078400165590e0fc068f4051942613","var_name_old":"frm_ac_tipoOperacion","prj_uid_old":"1000194806550fb7da01a56009651331"},{"var_uid":"49119778865b000d918e816077749107","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_as_tipoGestion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"74198305665789869edcfe8000080104","var_name_old":"frm_as_tipoGestion","prj_uid_old":"1000194806550fb7da01a56009651331"},{"var_uid":"51853536865b000d91c4872029301658","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"frm_as_valorSiniestro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1714265806579dea6048040088989891","var_name_old":"frm_as_valorSiniestro","prj_uid_ol