        <dyn_content><![CDATA[{"name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"35981980465afe6f34576c8043867250","name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","mode":"edit","script":{"type":"js","code":"//$('#frm_documentos_check').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_documentos_check\").setOnchange(function (newVal, oldVal) {\n  $('#fle_matricula').disableValidation();\n  $('#fle_cedula').disableValidation();\n  $('#fle_licencia').disableValidation();\n  $('#fle_denuncia').disableValidation();\n  $('#fle_partePolicial').disableValidation();\n\n\n  if (newVal == \"SI\") {\n    $('#fle_matricula').enableValidation();\n    $('#fle_cedula').enableValidation();\n    $('#fle_licencia').enableValidation();\n    $('#fle_denuncia').enableValidation();\n    $('#fle_partePolicial').enableValidation();\n\n  }\n\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_documentos_check","var_uid":"80997250065afe6f34bcb47032746792","dataType":"string","protectedValue":false,"id":"frm_documentos_check","name":"frm_documentos_check","label":"¿Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_documentos_check","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Documentos obligatorios","ariaLabel":"","colSpan":6},{"colSpan":1},{"type":"subtitle","id":"subtitle0000000002","label":"Documentos adicionales","ariaLabel":"","colSpan":5}],[{"type":"multipleFile","variable":"fle_matricula","var_uid":"89839263065afe6f348de37030548857","dataType":"multiplefile","protectedValue":false,"id":"fle_matricula","name":"fle_matricula","label":"Copia de matrícula del vehículo asegurado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":5,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"739729238652a772f7814b7025820719","var_name":"fle_matricula","colSpan":6},{"type":"multipleFile","variable":"fle_denuncia","var_uid":"17208669265afe6f348bc82027711865","dataType":"multiplefile","protectedValue":false,"id":"fle_denuncia","name":"fle_denuncia","label":"Denuncia en fiscalía","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":5,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"739729238652a772f7814b7025820719","var_name":"fle_denuncia","colSpan":6}],[{"type":"multipleFile","variable":"fle_licencia","var_uid":"58303031065afe6f348cdc5096839924","dataType":"multiplefile","protectedValue":false,"id":"fle_licencia","name":"fle_licencia","label":"Copia de licencia de la persona que estaba conduciendo el vehículo en el momento del siniestro","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":5,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"739729238652a772f7814b7025820719","var_name":"fle_licencia","colSpan":6},{"type":"multipleFile","variable":"fle_partePolicial","var_uid":"22678149765afe6f348eea2018469514","dataType":"multiplefile","protectedValue":false,"id":"fle_partePolicial","name":"fle_partePolicial","l