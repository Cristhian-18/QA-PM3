        <dyn_content><![CDATA[{"name":"SubForm Vinetas","description":"SubForm Vinetas","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"77534200465afe6f3466606096231964","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"informacion\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Información</h4></a></li>\n  <li id=\"solicitud\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>  \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[]}]}]]></dyn_content>
