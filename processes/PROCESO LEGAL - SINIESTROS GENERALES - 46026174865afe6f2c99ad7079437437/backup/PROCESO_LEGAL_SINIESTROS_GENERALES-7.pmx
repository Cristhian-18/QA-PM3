"\nfunction asesoriaLegal(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_siniestro_afectado\").getValue())\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'SI'){\n     \n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      \n    } \n}\n\n//execute when the Dynaform loads:\nasesoriaLegal($(\"#frm_requiere_AsesoriaLegal\").getValue(), ''); \n$('#frm_requiere_AsesoriaLegal').setOnchange(asesoriaLegal);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"39276019965afe6f34dff57086308061","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"12116264665afe6f34dee31015677106","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","db