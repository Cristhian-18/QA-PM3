x":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Email"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"","colSpan":12}]],"variables":[{"var_uid":"39242571865afe6f350b669010482306","prj_uid":"46026174865afe6f2c99ad7079437437","var_name":"grd_personas_afectados","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"29862003164a84eb64dbfe6075534851","var_name_old":"grd_personas_afectados","prj_uid_old":"35087580064a18c9776b638006106795"}]}]}]]></dyn_content>
