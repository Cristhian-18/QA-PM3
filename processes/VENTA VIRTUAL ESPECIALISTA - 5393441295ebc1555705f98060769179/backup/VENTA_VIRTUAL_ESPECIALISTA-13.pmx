ld":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"1454651325ec435ebdac351018903941","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_origen_otros_ingresos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1454651325ec435ebdac351018903941","var_name_old":"frm_origen_otros_ingresos","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"7165008515ec534f22400c3095209456","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_ingresos_familiares","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5246418936072563d86a0e7040466784","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_financiera_total_egresos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"7807716305e829ed52439e3049645412","var_name_old":"frm_financiera_total_egresos","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"4285171206072568af22606027306127","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_financiera_total_activos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3390956866072565e2a5a67026838191","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_financiera_total_pasivos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"79558603065181d540a8c92047406541","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_financiera_total_patrimonio","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"45715646765181f327a4529056593760","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_plan_contablidad","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"58565199765181f3e66d580044243022","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_plan_pago_renta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8440844445f38aac16ef702019813077","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_plan_pago_impuestos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8440844445f38aac16ef702019813077","var_name_old":"frm_plan_pago_impuestos","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}],"colSpan":12}],[{"type":"submit","id":"btn_financiera_submit","name":"btn_financiera_submit","label":"Grabar y Continuar","colSpan":6},{"type":"button","id":"btn_financiera_save","name":"btn_financiera_save","label":"Grabar","colSpan":6}]],"variables":[]}]}]]></dyn_content>
