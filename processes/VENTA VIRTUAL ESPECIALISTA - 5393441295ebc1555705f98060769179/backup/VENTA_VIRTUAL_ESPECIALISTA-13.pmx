06f277221da79056042198","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_descuento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"490935367606f277221da79056042198","var_name_old":"frm_provisional_descuento","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"8916654695f1266c4eac169036406620","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_monto_deposito_provisional","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8916654695f1266c4eac169036406620","var_name_old":"frm_monto_deposito_provisional","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}]}]}]]></dyn_content>
