pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"152115123669f147b37c384027382274","prj_uid":"5393441295ebc1555705f98060769179","var_name":"grd_politicas_emision","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"25830987060590cf686aa76067215111","name":"subform resumen de solicitud","description":"","mode":"edit","script":{"type":"js","code":"var prod =$(\"#frm_producto\").getValue(); \n//alert (prod);\n\n$('#frm_aps_codigo_tipoAgente').hide();\n\n\n\ncalcular_edad();\nfunction calcular_edad() {\n\n  var fecha = $('#frm_fecha_nacimiento').getValue();\n  //alert (fecha);\n  var hoy = new Date();\n\n  var fechaNacimiento = new Date(fecha);\n  fechaNacimiento.setDate(fechaNacimiento.getDate() + 1);\n  //  alert (hoy);  \n  //  alert (fechaNacimiento);\n  var edad = hoy.getFullYear() - fechaNacimiento.getFullYear();\n  var diferenciaMeses = hoy.getMonth() - fechaNacimiento.getMonth();\n  var diferenciaDias = hoy.getDay() - fechaNacimiento.getDay();\n\n  if (\n    diferenciaMeses < 0 || (diferenciaMeses === 0 && hoy.getDate() < fechaNacimiento.getDate())\n  ) {\n    edad--\n  }\n  //alert (edad);\n  $(\"#frm_cliente_edad\").setValue(edad);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"etCliente","label":"<h5 style=\"color:#1C9DD9;\"><b>Datos del Candidato a Asegurado</b></h5><hr>","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"di