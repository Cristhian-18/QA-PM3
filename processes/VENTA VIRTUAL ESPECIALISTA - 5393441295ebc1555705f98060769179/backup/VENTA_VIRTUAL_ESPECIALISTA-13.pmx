        <dyn_content><![CDATA[{"name":"sub form  preferencias conctacto","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9375138705f0243767f1c28069669725","name":"sub form  preferencias conctacto","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_trabajo_envio_correspondencia\").find(\"div.radio\").addClass(\"radio-inline\");\n$(\"#frm_trabajo_contacto_preferido\").find(\"div.radio\").addClass(\"radio-inline\");\n$(\"#frm_trabajo_correo_preferido\").find(\"div.radio\").addClass(\"radio-inline\");\n\n$(\"#frm_trabajo_llamar_preferentemente\").hide();\n$(\"#frm_trabajo_hora_inicial\").hide();\n$(\"#frm_trabajo_hora_final\").hide();\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"label0000000001","label":"<b><u>PREFERENCIAS DE CONTACTO<\/U><\/B>","colSpan":12}],[{"type":"radio","variable":"frm_trabajo_envio_correspondencia","var_uid":"6504990135efb50837bd015029269997","dataType":"boolean","protectedValue":false,"id":"frm_trabajo_envio_correspondencia","name":"frm_trabajo_envio_correspondencia","label":"","defaultValue":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"1","label":"Domicilio"},{"value":"0","label":"Trabajo"}],"var_name":"frm_trabajo_envio_correspondencia","colSpan":6},{"colSpan":6}],[{"type":"label","id":"frm_trabajo_llamar_preferentemente","label":"<H5><b><u>Llamar preferentemente<\/u><b><\/H5>","colSpan":12}],[{"type":"datetime","variable":"frm_trabajo_hora_inicial","var_uid":"3601558235efb5083e6e417085768363","dataType":"datetime","protectedValue":false,"id":"frm_trabajo_hora_inicial","name":"frm_trabajo_hora_inicial","label":"Hora inicial","placeholder":"HH:MM","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"HH:mm","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_trabajo_hora_inicial","colSpan":6},{"type":"datetime","variable":"frm_trabajo_hora_final","var_uid":"8287640445efb508406c050089160370","dataType":"datetime","protectedValue":false,"id":"frm_trabajo_hora_final","name":"frm_trabajo_hora_final","label":"Hora final","placeholder":"HH:MM","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"HH:mm","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_trabajo_hora_final","colS