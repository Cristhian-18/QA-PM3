el":"Segundo apellido","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"150","width":100,"title":"Segundo apellido"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0a000000003","name":"dropdown0a000000003","label":"Parentesco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'tparentesco'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"150","width":100,"title":"Parentesco"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text000000a0005","name":"text000000a0005","label":"%","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"150","width":100,"title":"%"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown000000a0004","name":"dropdown000000a0004","label":"Beneficiario","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'tleyenda_vida'\nAND 