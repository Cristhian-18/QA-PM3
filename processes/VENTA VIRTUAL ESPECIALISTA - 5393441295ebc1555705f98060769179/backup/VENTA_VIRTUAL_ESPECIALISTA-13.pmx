us: 4px 4px 4px 4px;\n    -moz-border-radius: 4px 4px 4px 4px;\n    -webkit-border-radius: 4px 4px 4px 4px;\n\n    background:#ffffff;\n    text-align: center;\n    color: white;\n    font-size: 14px;\n    overflow:visible;\n    text-shadow: 1px 1px 2px black, 0 0 25px blue, 0 0 5px #f0b04f;\n    padding: 10px;\n  }\n  .panel.panel-default.pmdynaform-panel\n  {\n    overflow:visible;    \n  }\n\n<\/style>\n<br><br>\n<div id=\"resultado\" class=\"titulo\"><h3>PENDIENTE<\/h3><\/div> \n<br>\n<div id=\"mensaje\" class=\"titulo\"><h3>Cliente necesita autorizacion<\/h3><\/div>\n<br><br><br><br><br>\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_mensaje","var_uid":"860926860600b95949be072063895832","dataType":"string","protectedValue":false,"id":"tri_mensaje","name":"tri_mensaje","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_mensaje","colSpan":6},{"type":"hidden","variable":"tri_ruta_cot","var_uid":"4269916086023367ebbfb30003751664","dataType":"string","protectedValue":false,"id":"tri_ruta_cot","name":"tri_ruta_cot","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_ruta_cot","colSpan":6}],[{"type":"submit","id":"btn_continuar","name":"btn_continuar","label":"Continuar","colSpan":12}]],"variables":[{"var_uid":"860926860600b95949be072063895832","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_mensaje","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4269916086023367ebbfb30003751664","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_ruta_cot","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[