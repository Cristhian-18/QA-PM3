        <dyn_content><![CDATA[{"name":"subform analisis atencion t8","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9458715575fa435e25efcc4029990032","name":"subform analisis atencion t8","description":"","mode":"edit","script":{"type":"js","code":"$(\"#chk_errores\").find(\"div.checkbox\").addClass(\"radio-inline\");\n$(\"#chk_errores_poliza\").find(\"div.checkbox\").addClass(\"radio-inline\");\n\n$(\"#chk_errores\").hide();\n$(\"#chk_errores_poliza\").hide();\n$(\"#frm_estado_cu\").hide();\n$(\"#frm_anexo_crs\").hide();\n$(\"#frm_estado_cu\").disableValidation();\n$(\"#frm_anexo_crs\").disableValidation();\n\nfunction acciones(){\nvar accion =   $(\"#frm_accion\").getControl().val();\n  \/\/alert (\"accion\");\n  if(accion == 'REPROCESAR'){\n    $(\"#chk_errores\").show();\n    $(\"#frm_comentario\").setLabel('Dictamen para Comercial');\n    \/\/$(\"#chk_errores_poliza\").show();\n    $(\"#frm_estado_cu\").disableValidation();\n\t$(\"#frm_anexo_crs\").disableValidation();\n    $(\"#frm_estado_cu\").hide();\n    $(\"#frm_anexo_crs\").hide();\n  }\n  else\n  {\n    if(accion == 'CONTINUAR'){\n       \t$(\"#chk_errores\").hide();\n      \t$(\"#frm_estado_cu\").show();\n\t\t$(\"#frm_anexo_crs\").show();\n      \t$(\"#frm_estado_cu\").enableValidation();\n\t\t$(\"#frm_anexo_crs\").enableValidation();\n\t\t$(\"#frm_comentario\").setLabel('Observaciones para Emision');\n    }else{\n    \tif(accion == 'RECHAZAR'){\n          $(\"#chk_errores\").hide();\n          $(\"#frm_estado_cu\").hide();\n          $(\"#frm_anexo_crs\").hide();\n          $(\"#frm_estado_cu\").disableValidation();\n          $(\"#frm_anexo_crs\").disableValidation();\n          $(\"#frm_comentario\").setLabel('Dictamen para Comercial_Rechazo o Aplazo');\n    \t}else{\n    \t\t$(\"#chk_errores\").hide();\n    \t\t\/\/$(\"#chk_errores_poliza\").hide();\n\t\t\t$(\"#frm_comentario\").setLabel('Comentarios');\n           \t$(\"#frm_estado_cu\").hide();\n          \t$(\"#frm_anexo_crs\").hide();\n      \t\t$(\"#frm_estado_cu\").disableValidation();\n\t\t\t$(\"#frm_anexo_crs\").disableValidation();\n        }\n  \t}\n  }\n}\n\n\n$('#frm_accion').setOnchange(acciones);\nacciones();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accion","var_uid":"1150050185f458a822fa696023208110","dataType":"string","protectedValue":false,"id":"frm_accion","name":"frm_accion","label":"Accion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"REPROCESAR","label":"Requiere regularizacion"},{"value":"CONTINUAR","label":"Continuar con la emision de la poliza"},{"value":"RECHAZAR","label":"Rechazo\/Aplazo"},{"value":"NO_CONCRETADO","label":"No concretado"}],"var_name":"frm_accion","colSpan":6},{"colSpan":6}],[{"type":"checkgroup","variable":"chk_errores","var_uid":"9911771325fa43663c7f5b5035604136","dataType":"array","protectedValue":false,"id":"chk_errores","name":"chk_errores","label":"Regularizaciones","defaultValue":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'ERRORES' AND PRO_UID = '5393441295ebc1555705f98060769179' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[],"var_name":"chk_errores","colSpan":12}],[{"type":"checkgroup","variable":"chk_errores_poliza","var_uid":"3908562045fa43663e22554023012878","dataType":"array","protectedValue":false,"id":"chk_errores_poliza","name":"chk_errores_poliza","label":"Errores poliza","defaultValue":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT CODIGO, \nRPAD(DESCRIPCION,40,' ')\nFROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'ERRORES_POLIZA' \nAND PRO_UID = '6464242075dc1b09e050206009257411' \nAND ESTADO = 1 \nORDER BY DESCRIPCION ","dataVariable":"","options":[],"var_name":"chk_errores_poliza","colSpan":12}],[{"type":"dropdown","variable":"frm_estado_cu","var_uid":"5121902716452668e9da583069378598","dataType":"string","protectedValue":false,"id":"frm_estado_cu","name":"frm_estado_cu","label":"Estado CU","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_estado_cu","colSpan":6},{"type":"dropdown","variable":"frm_anexo_crs","var_uid":"900953345645266a43474e3076986600","dataType":"string","protectedValue":false,"id":"frm_anexo_crs","name":"frm_anexo_crs","label":"Anexo CRS","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_anexo_crs","colSpan":6}],[{"type":"textarea","variable":"frm_comentario","var_uid":"9131720755f2b61d4c1ffe3079023787","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Comentario","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"2","var_name":"frm_comentario","colSpan":12}]],"variables":[{"var_uid":"1150050185f458a822fa696023208110","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4074566825dcac4c7742458001504208","var_name_old":"frm_accion","prj_uid_old":"6464242075dc1b09e050206009257411","create":false},{"var_uid":"9911771325fa43663c7f5b5035604136","prj_uid":"5393441295ebc1555705f98060769179","var_name":"chk_errores","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5711461855dd310bedcdf50083050687","var_name_old":"chk_errores","prj_uid_old":"6464242075dc1b09e050206009257411"},{"var_uid":"3908562045fa43663e22554023012878","prj_uid":"5393441295ebc1555705f98060769179","var_name":"chk_errores_poliza","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"7881313345dd5752847e387027142870","var_name_old":"chk_errores_poliza","prj_uid_old":"6464242075dc1b09e050206009257411"},{"var_uid":"5121902716452668e9da583069378598","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_estado_cu","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"900953345645266a43474e3076986600","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_anexo_crs","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9131720755f2b61d4c1ffe3079023787","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1754874415dcac50da742b6063134484","var_name_old":"frm_comentario","prj_uid_old":"6464242075dc1b09e050206009257411","create":false}]}]}]]></dyn_content>
