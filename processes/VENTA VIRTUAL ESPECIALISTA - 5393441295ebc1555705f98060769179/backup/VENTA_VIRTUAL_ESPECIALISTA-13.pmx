	$ruta = ($accion == 'PENDIENTE' || $accion1 == 'PENDIENTE' ? 'PENDIENTE' : $ruta);
	$ruta = ($accion == 'NOPASA' ? 'RECHAZADO' : $ruta);
	@@tri_comm_rcs = ($ruta != 'APROBADO'? 'Validacion RCS' : '');

	@@tri_ruta_cot = $ruta;
	@@tri_mensaje = '';
	@@tri_mensaje = $mensaje.'<br>'.$mensaje1;
	@@tri_contador_rcs2 = 0;
*/	
}
else
{
