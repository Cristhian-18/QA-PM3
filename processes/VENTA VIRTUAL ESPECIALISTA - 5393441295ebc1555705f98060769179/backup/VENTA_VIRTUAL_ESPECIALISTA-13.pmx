        <dyn_content><![CDATA[{"name":"FORM COTIZACION REPROCESO","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8983100066061e0ebd62c33095713799","name":"FORM COTIZACION REPROCESO","description":"","mode":"edit","script":{"type":"js","code":"$('#1852090325ec434cca75924044427744').hide();\n\n$(\"#8983100066061e0ebd62c33095713799\").setOnSubmit(function(){\n  $(\"#8983100066061e0ebd62c33095713799\").saveForm() ;\n  var bandera = true;\n\n  \/\/PDF\n  var array_PDF = $(\"#file_cotizacion\").find( \".pmdynaform-field-control li\" );\n\n  if(array_PDF.length == 0){\n    alert(\"Cotizacion PDF - requerido\");\n    bandera = false;\n  }else if(array_PDF.length > 1){\n    alert(\"Cotizacion PDF - Por favor adjunte solo un archivo\");\n    bandera = false;\n  }\n\n  const nombresArchivos = [];\n  $.each(array_PDF, function( index, value ) {\n\n    nombreArchivo_PDF = $(value).html();\n\n    if(nombreArchivo_PDF != '' && typeof nombreArchivo_PDF !== 'undefined'){\n      var pizza = nombreArchivo_PDF.toString().trim().split('.');\n      var ext = pizza[pizza.length - 1];\n      if(ext != \"pdf\"){\n        alert(\"Cotizacion PDF - debe ser un archivo .pdf\");\n        bandera = false;\n      }\n    }\n\n    \/\/verificar repetidos\n    if(jQuery.inArray(nombreArchivo_PDF, nombresArchivos) !== -1){\n      alert(\"Archivos PDF repetidos\");\n      bandera = false;\n    }\n    nombresArchivos.push(nombreArchivo_PDF);\n\n  });\n\n  \/\/CSV\n  var array_CSV = $(\"#file_cotizacion_csv\").find( \".pmdynaform-field-control li\" );\n\n  if(array_CSV.length == 0){\n    alert(\"Cotizacion CSV - requerido\");\n    bandera = false;\n  }else if(array_CSV.length > 1){\n    alert(\"Cotizacion CSV - Por favor adjunte solo un archivo\");\n    bandera = false;\n  }\n\n  const nombresArchivos_2 = [];\n  $.each(array_CSV, function( index, value ) {\n\n    nombreArchivo_CSV = $(value).html();\n\n    if(nombreArchivo_CSV != '' && typeof nombreArchivo_CSV !== 'undefined'){\n      var pizza = nombreArchivo_CSV.toString().trim().split('.');\n      var ext = pizza[pizza.length - 1];\n      if(ext != \"csv\" && ext != \"CSV\"){\n        alert(\"Cotizacion CSV - debe ser un archivo .csv\");\n        bandera = false;\n      }\n    }\n\n    \/\/verificar repetidos\n    if(jQuery.inArray(nombreArchivo_CSV, nombresArchivos_2) !== -1){\n      alert(\"Archivos CSV repetidos\");\n      bandera = false;\n    }\n    nombresArchivos_2.push(nombreArchivo_CSV);\n\n  });\n\n  return bandera;\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"form","variable":"","var_uid":"","dataType":"","id":"1852090325ec434cca75924044427744","name":"subform estilos funciones","description":"","mode":"edit","script":{"type":"js","code":"$(\"#dyn_forward\").hide();\n$(\"img[src='\/images\/bulletButton.gif']\").hide();\n$('.panel').css(\"border\", \"none\");\n$(\".row\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"margin-bottom\", \"5px\");\n$(\".panel-body\").css(\"padding\", \"0\");\n$('.pmdynaform-form').css(\"border\", \"none\");\n$(\".form-control\").css(\"box-shadow\", \"none\");\n$(\".pmdynaform-grid-row\").css(\"border-bottom\", \"none\");\n$(\".pmdynaform-label-options\").css(\"text-align\", \"left\");\n\/\/$(\".pmdynaform-grid-title\").css(\"display\", \"none\");\n$(\".pmdynaform-field-title\").css(\"margin-bottom\", \"1px\");\n$(\".nav\").css(\"padding.bottom\", \"1px\");\n$(\".pmdynaform-field-subtitle h5\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-field-subtitle h5\").css(\"border-color\", \"#f29500\");\n$(\".pmdynaform-field-title h4\").css(\"background-color\", \"#ed7424\");\n$(\".pmdynaform-field-title h4\").css(\"border-color\", \"#ed7424\");\n\n$(\".btn-primary:hover\").css(\"background-color\", \"#ed7424 !IMPORTANT\");\n$(\".btn-primary:hover\").css(\"color\", \"#ffffff\");\n$(\".btn-primary\").css(\"background-color\", \"#ed7424\");\n$(\".btn-primary\").css(\"color\", \"#ffffff\");\n\n\n$(\".btn-default\").css(\"background-color\", \"#f29500\");\n$(\".btn-default\").css(\"color\", \"#ffffff\");\n$(\".btn-default\").css(\"border-color\", \"#c5c5c5\");\n$(\".btn\").css(\"background-color\", \"#f29500\");\n$(\".btn\").css(\"color\", \"#ffffff\");\n$(\".btn\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"background-color\", \"#f29500\");\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"color\", \"#ffffff\");\n$(\".ui-button\").css(\"background-color\", \"#f29500\");\n$(\".ui-button\").css(\"color\", \"#ffffff\");\n\n$(\".pmdynaform-grid-title\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"border-color\", \"#ed7424\");\n$(\".btn-default\").css(\"background-color\", \"#f29500\");\n$(\".btn-default\").css(\"border-color\", \"#f29500\");\n$(\".pmdynaform-grid-text-plus\").text(\"Agregar\");\n\n$(\"#1852090325ec434cca75924044427744\").hide();\n\n\n$(function () {\n    $('.subtitulo').css('cursor', 'pointer');\n\n    $('.subtitulo').on('click', function () {\n        id = this.id;\n        subforms = $('#' + this.id).attr('subform').split('|');\n        if ($('#' + id).children().attr('class') == 'glyphicon glyphicon-plus')\n            $('#' + id).children().removeClass('glyphicon-plus').addClass('glyphicon-minus');\n        else\n            $('#' + id).children().removeClass('glyphicon-minus').addClass('glyphicon-plus');\n        $.each(subforms, function (index, subform) {\n            $('#' + subform).toggle('slow');\n        });\n    });\n\n\n})\n\nfunction validarExpresionRegular(id, numeroExpresion) {\n\n    if (numeroExpresion == 4) {\n        ponerDecimales(id);\n    }\n\n    $(\"#\" + id).focusout(function () {\n        validarExpresionRegular_2($(this), numeroExpresion);\n    });\n\n    validarExpresionRegular_2($(\"#\" + id), numeroExpresion);\n}\n\nfunction validarExpresionRegular_2(id, numeroExpresion) {\n    var expresion_regular = $(\"#expresion_regular_\" + numeroExpresion).getValue();\n    \/\/alert(expresion_regular);\n    var texto = $(id).getValue().toString().trim();\n    \/\/alert(texto);\n\n    \/\/alert(texto.match(expresion_regular) + \" - \" + texto.length);\n\n    if (texto.match(expresion_regular) || texto.length == 0) {\n        $(id).parent().find(\".textlabel\").css(\"color\", \"\");\n        $(id).getControl().css(\"borderColor\", \"\");\n    } else {\n        $(id).parent().find(\".textlabel\").css(\"color\", \"#a94442\");\n        $(id).getControl().css(\"borderColor\", \"#e4655f\");\n    }\n}\n\nfunction ponerDecimales(id) {\n\n    var identificador = $('#' + id);\n    var valor = identificador.getValue().toString().trim();\n\n    if (valor == '') {\n        identificador.setValue(\"\");\n        return;\n    }\n\n    if (typeof valor.split(\".\")[1] === 'undefined') {\n        identificador.setValue(valor + \".00\");\n    } else if (valor.split(\".\")[1].length == 0) {\n        identificador.setValue(valor + \"00\");\n    } else if (valor.split(\".\")[1].length == 1) {\n        identificador.setValue(valor + \"0\");\n    }\n\n}\n\nfunction canton_2(bandera, idProvincia, idCanton) {\n\n    var str = $('#frm_canton_auxiliar').getValue() + \"\";\/\/El espacio vacio es para q se convierta a string\n    var vector = str.split(\",\");\n\n    $(\"#\" + idCanton).find(\"option\").hide();\n    $(\"#\" + idCanton).find(\"option[value='']\").show();\n    if (bandera) {\n        $('#' + idCanton).setValue('');\n    }\n\n    var comboUno = $('#' + idProvincia).getControl().val();\n\n    if (comboUno == '') {\n        $('#' + idCanton).getControl().attr('disabled', true);\n    } else if (comboUno != \"\") {\n        $('#' + idCanton).getControl().attr('disabled', false);\n        for (i = 0; i < (vector.length \/ 2); i++) {\n            if (vector[i * 2] == comboUno) {\n                $(\"#\" + idCanton).find(\"option[value=\" + vector[i * 2 + 1] + \"]\").show();\n            }\n        }\n    }\n\n}\n\n\n\n\/\/validar campos vacios\n$(\"#validacionesCampos\").hide();\n\nfunction showConfirmDlg() {\n\n    if ($(\"form\").prop(\"id\") == \"9653957035e829ed50c2e51034344533\") {\n        return;\n    }\n\n    var bandera = true;\n    var c = '';\n    var count = 0;\n    var noCumplioValidacion;\n    var noCumplioValidacionProcess;\n    var stringHtml = \"\";\n\n    $(\"div.pmdynaform-edit-radio, div.pmdynaform-edit-text, div.pmdynaform-edit-dropdown, div.pmdynaform-edit-datetime, pmdynaform-edit-dropdown\").each(function (index) {\n        \/\/      $(\"div.pmdynaform-edit-datetime\").each(function(index) {\n\n        if ($(this).getControl().toString() == \"\") {\/\/para q ingnore los campos de grillas\n            return;\n        }\n\n        if (typeof $(this).find(\".pmdynaform-message-error\").html() !== 'undefined') {\n            noCumplioValidacionProcess = true;\n        } else {\n            noCumplioValidacionProcess = false;\n        }\n\n        if ($(this).prop(\"class\").indexOf(\"pmdynaform-edit-radio\") < 0) {\n            stringHtml = $(this).getControl().attr(\"style\").toString();\/\/attr da error cuando el campo es radio\n            \/\/    \talert(($(this).toString()));\n        }\n\n        if (stringHtml.indexOf(\"border-color\") > 0 || stringHtml.indexOf(\"color\") > 0) {\n            noCumplioValidacion = true;\n\n        } else {\n            noCumplioValidacion = false;\n\n        }\n\n        \/\/if($(this).find(\".pmdynaform-field-required\").html() == '*')){\n\n\n        deshabilitadaValidacion = $(this).find(\".pmdynaform-field-required\").attr(\"style\") != \"display: none;\" ? true : false;\n\n        if ((deshabilitadaValidacion && $(this).find(\".pmdynaform-field-required\").html() == '*') || noCumplioValidacion || noCumplioValidacionProcess) {\n            if ($(this).getValue().trim().length == 0 || noCumplioValidacion || noCumplioValidacionProcess) {\n                count++;\n                c += count + \") \" + $(this).getLabel() + \"<br>\";\n                bandera = false;\n            }\n        }\n\n    });\n\n    $(\"#validacionesCampos\").html(c);\n\n    var dlgContents = {\n        modal: true,\n        resizable: false,\n        buttons: {\n            \"Ok\": function () {\n                $(this).dialog(\"close\");\n                callback(true);\n            }\n        }\n    }\n\n    if (count > 0) {\n        $(\"#validacionesCampos\").dialog(dlgContents);\n    }\n    return bandera;\n}\nfunction validarIdentificacion(identificacion, tipoIdentificacion, aux) {\n    return identificacionValidez(identificacion, tipoIdentificacion, aux);\n}\n\nfunction gridIdentificacionRepetida(nombre_grilla, columna) {\n\n    var bandera = true;\n\n    var filas = $(\"#\" + nombre_grilla).getNumberRows();\n    var arr = new Array(0);\n\n    \/\/ Verificar si hay repetidos\n    for (f = 1; f <= filas; f++) {\n        var identificacion = $(\"#\" + nombre_grilla).getValue(f, columna).trim();\n        identificacion = identificacion.toUpperCase();\n\n        if (identificacion != \"\" && arr.indexOf(identificacion) >= 0) {\n            bandera = false;\n        }\n\n        arr.push(identificacion);\n    }\n\n    \/\/Colorear bordes\n    for (f = 1; f <= filas; f++) {\n        if (bandera == false) {\n            $(\"#\" + nombre_grilla).getControl(f, columna).css(\"borderColor\", \"red\");\n        } else {\n            stringHtml = $(\"#\" + nombre_grilla).getControl(f, columna).attr(\"style\");\n            if (typeof stringHtml !== 'undefined') {\n                stringHtml = stringHtml.toString();\n\n                if (stringHtml.indexOf(\"border-color\") < 0 || stringHtml.indexOf(\"color\") < 0) {\n                    $(\"#\" + nombre_grilla).getControl(f, columna).css(\"borderColor\", \"\");\n                }\n            }\n        }\n    }\n\n    return bandera;\n\n}\n\nfunction identificacionAlgoritmo(identificacion, tipoValidacion) {\n\n    digitos = identificacion.split(\"\");\n    total = 0;\n    \/\/ alert(tipoValidacion + \" - \" + identificacion);\n    \/\/Personas naturales ecuatorianos y extranjeros residentes\n    if (tipoValidacion == \"cedula\") {\n\n        modulo = 10;\n        digitoVerificador = digitos[9] * 1;\n\n        digitos[0] *= 2;\n        digitos[1] *= 1;\n        digitos[2] *= 2;\n        digitos[3] *= 1;\n        digitos[4] *= 2;\n        digitos[5] *= 1;\n        digitos[6] *= 2;\n        digitos[7] *= 1;\n        digitos[8] *= 2;\n\n    }\n    \/\/Sociedades piconv('UCS-4LE','UTF-8',pack('V', hexdec('U00fa')))blicas\n    else if (tipoValidacion == \"rucPublicas\") {\n\n        modulo = 11;\n        digitoVerificador = digitos[8] * 1;\n\n        digitos[0] *= 3;\n        digitos[1] *= 2;\n        digitos[2] *= 7;\n        digitos[3] *= 6;\n        digitos[4] *= 5;\n        digitos[5] *= 4;\n        digitos[6] *= 3;\n        digitos[7] *= 2;\n        digitos[8] *= 0;\/\/El noveno digito no se ocupa en el algoritmo por eso le multiplico por cero\n\n    }\n    \/\/Sociedades privadas y extranjeros no residentes (sin ciconv('UCS-4LE','UTF-8',pack('V', hexdec('U00e9')))dula de identidad)\n    else if (tipoValidacion == \"rucPrivadas\") {\n\n        modulo = 11;\n        digitoVerificador = digitos[9] * 1;\n\n        digitos[0] *= 4;\n        digitos[1] *= 3;\n        digitos[2] *= 2;\n        digitos[3] *= 7;\n        digitos[4] *= 6;\n        digitos[5] *= 5;\n        digitos[6] *= 4;\n        digitos[7] *= 3;\n        digitos[8] *= 2;\n    }\n\n    \/\/si es mayor a 9 sumo entre digitos\n    for (g = 0; g <= 8; g++) {\n\n        if (tipoValidacion == \"cedula\") {\n            tempo = digitos[g] + \"\";\n            if (tempo * 1 > 9) {\n                digitos[g] = tempo.charAt(0) * 1 + tempo.charAt(1) * 1;\n            }\n        }\n        total += digitos[g] * 1;\n    }\n\n    residuo = total % modulo;\n    \/\/ alert(total + \" - \" + residuo + \" - \" + digitoVerificador);\n\n    if (residuo == 0 && residuo == digitoVerificador) {\n        return true;\n    } else if (modulo - residuo == digitoVerificador) {\n        return true;\n    } else {\n        return false;\n    }\n\n    return true;\n}\n\nfunction identificacionValidez(identificacion, tipoIdentificacion, aux) {\n\n    var bandera = true;\n    var tipo = { C: \"CEDULA\", R: \"RUC\", P: \"PASAPORTE\" };\n\n    if (identificacion.length == 0 || typeof tipo[tipoIdentificacion] === 'undefined') {\n        return false;\n    }\n\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    \/\/Cedula\n    \/\/Personas naturales ecuatorianos y extranjeros residentes\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    if (tipoIdentificacion == 'C') {\n\n        if (\/^\\d+$\/.test(identificacion) == false) {\n            if (aux) {\n                alert(tipo[\"C\"] + \" : solo se permite digitos\");\n            }\n            return false;\n        } else if (\/^\\d{10}$\/.test(identificacion) == false) {\n            if (aux) {\n                alert(tipo[\"C\"] + \" : debe tener 10 digitos\");\n            }\n            return false;\n        } else if ((identificacion.substr(0, 2) * 1 < 1 || identificacion.substr(0, 2) * 1 > 24) && identificacion.substr(0, 2) * 1 != 30) {\n            if (aux) {\n                \/\/ alert(tipo[\"C\"] + \" : Dos primeros diconv('UCS-4LE','UTF-8',pack('V', hexdec('U00ed')))gitos comprenden el rango entre (01 - 24) y 30\");\n                alert(tipo[\"C\"] + \" : incorrecta\");\n            }\n            return false;\n        } else {\n            bandera = identificacionAlgoritmo(identificacion, \"cedula\");\n            if (aux && bandera == false) {\n                alert(tipo[\"C\"] + \" : incorrecta\");\n            }\n        }\n\n    }\n\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    \/\/RUC\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    if (tipoIdentificacion == 'R') {\n\n        if (\/^\\d+$\/.test(identificacion) == false) {\n            if (aux) {\n                alert(tipo[\"R\"] + \" : solo se permite digitos\");\n            }\n            return false;\n        } else if (\/^\\d{13}$\/.test(identificacion) == false) {\n            if (aux) {\n                alert(tipo[\"R\"] + \" : debe tener 13 digitos\");\n            }\n            return false;\n        } else if ((identificacion.substr(0, 2) * 1 < 1 || identificacion.substr(0, 2) * 1 > 24) && identificacion.substr(0, 2) * 1 != 30) {\n            if (aux) {\n                \/\/ alert(tipo[\"R\"] + \" : Dos primeros diconv('UCS-4LE','UTF-8',pack('V', hexdec('U00ed')))gitos comprenden el rango entre (01 - 24) y 30\");\n                alert(tipo[\"R\"] + \" : incorrecto\");\n            }\n            return false;\n        } else if (identificacion.charAt(2) * 1 > 6 && identificacion.charAt(2) * 1 != 9) {\n            \/\/ Personas naturales ecuatorianos y extranjeros residentes: ( 0,1,2,3,4,5 )\n            \/\/ Sociedades piconv('UCS-4LE','UTF-8',pack('V', hexdec('U00fa')))blicas:\t6\n            \/\/ Sociedades privadas y extranjeros no residentes (sin ciconv('UCS-4LE','UTF-8',pack('V', hexdec('U00e9')))dula de identidad):\t9\n\n            if (aux) {\n                \/\/ alert(tipo[\"R\"] + \" : El tercer digito debe ser ( 0,1,2,3,4,5,6,9 )\");\n                alert(tipo[\"R\"] + \" : incorrecto\");\n            }\n            return false;\n\n        } else if (identificacion.charAt(2) * 1 <= 5) {\n            ci = identificacion.slice(0, -3);\n            \/\/ alert(ci);\n            bandera = identificacionAlgoritmo(ci, \"cedula\");\n\n        } else if (identificacion.charAt(2) * 1 == 6) {\n\n            bandera = identificacionAlgoritmo(identificacion, \"rucPublicas\");\n\n        } else if (identificacion.charAt(2) * 1 == 9) {\n\n            bandera = identificacionAlgoritmo(identificacion, \"rucPrivadas\");\n\n        }\n\n        if (aux && bandera == false) {\n            alert(tipo[\"R\"] + \" : incorrecto\");\n        }\n    }\n\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    \/\/PASAPORTE\n    \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n    if (tipoIdentificacion == 'P') {\n\n        if (\/^[a-zA-Z0-9_-]*$\/.test(identificacion) == false) {\n            if (aux) {\n                alert(tipo[\"P\"] + \" : Caracteres incorrectos\");\n            }\n            return false;\n        } else if (identificacion.length > 30) {\n            if (aux) {\n                alert(tipo[\"P\"] + \" : incorrecto maximo 30 caracteres\");\n            }\n            return false;\n        }\n\n    }\n\n    return bandera;\n\n}\n\nfunction validarTarjetas(tipotarjeta, numero) {\n    switch (tipotarjeta) {\n        case \"4\":\t\/\/VISA\n            if (!numero.match(\/^4[0-9]{12}(?:[0-9]{3})?$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n        case \"8\":\t\/\/AMEX\n            if (!numero.match(\/^3[47][0-9]{13}$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n        case \"3\":\t\/\/DINERS\n            if (!numero.match(\/^3(?:0[0-5]|[68][0-9])[0-9]{11}$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n\n        case \"5\":\t\/\/MASTERCARD\n            if (!numero.match(\/5[1-5][0-9]{14}$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n        case \"2\":\t\/\/MASTERCARDTITANIUM\n            if (!numero.match(\/2[0-9]{15}$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n        case \"6\":\t\/\/DISCOVER\n            if (!numero.match(\/^6(?:011|5[0-9]{2})[0-9]{12}$\/)) {\n                return false;\n            }\n            else {\n                return true;\n            }\n            break;\n    }\n}\n\nfunction calcular_edad(fechaNacimiento) {\n    \/\/Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n\n"},"language":"en","externalLibs":"\/plugin\/phsoluciones\/core_librerias\/js_externos\/jquery-ui.css,\/plugin\/phsoluciones\/core_librerias\/js_externos\/jquery-ui.js","printable":false,"items":[[{"type":"panel","id":"panelRequeridos","content":"<div id=\"validacionesCampos\" title=\"Verificar la informacion\"><\/div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"expresion_regular_1","var_uid":"3681304635e8525e4b173d3069070665","dataType":"string","protectedValue":false,"id":"expresion_regular_1","name":"expresion_regular_1","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_1","colSpan":3},{"type":"hidden","variable":"expresion_regular_2","var_uid":"9579963435e8579e5dc9351087274555","dataType":"string","protectedValue":false,"id":"expresion_regular_2","name":"expresion_regular_2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_2","colSpan":3},{"type":"hidden","variable":"expresion_regular_3","var_uid":"2837094465ec434e3918ce2092196455","dataType":"string","protectedValue":false,"id":"expresion_regular_3","name":"expresion_regular_3","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_3","colSpan":3},{"type":"hidden","variable":"expresion_regular_4","var_uid":"9491441075ec434e3b51753019415626","dataType":"string","protectedValue":false,"id":"expresion_regular_4","name":"expresion_regular_4","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_4","colSpan":3}]],"variables":[{"var_uid":"3681304635e8525e4b173d3069070665","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_1","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3681304635e8525e4b173d3069070665","var_name_old":"expresion_regular_1","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"9579963435e8579e5dc9351087274555","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9579963435e8579e5dc9351087274555","var_name_old":"expresion_regular_2","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"2837094465ec434e3918ce2092196455","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5290064565e8df1ec9ee1d4077852307","var_name_old":"expresion_regular_3","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"9491441075ec434e3b51753019415626","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5747417245e95f5bd9072d0065641887","var_name_old":"expresion_regular_4","prj_uid_old":"3685317655e829ed34bce43075006773"}],"colSpan":12}],[{"type":"title","id":"tit","label":"REPROCESO DE COTIZADOR","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"717835621600ef82bb986d1065323768","name":"subform num adjunto cotizacion","description":"","mode":"edit","script":{"type":"js","code":"$(\".btn-uploadfile\").text(\"Seleccionar archivo\");"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_cod_cotizacion","var_uid":"3966585855f6400f0e7a601081056031","dataType":"string","protectedValue":false,"id":"frm_cod_cotizacion","name":"frm_cod_cotizacion","label":"Num Cotizacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{2,10}$","validateMessage":"Formato incorrecto","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cod_cotizacion","colSpan":4},{"type":"dropdown","variable":"frm_producto","var_uid":"1653057295f976349e08dc7010897132","dataType":"string","protectedValue":false,"id":"frm_producto","name":"frm_producto","label":"Producto","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM `ADMIN_CATALOGOS` WHERE COD_CATALOGO = 'producto_vida' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_producto","colSpan":8}],[{"colSpan":4},{"type":"multipleFile","variable":"file_cotizacion","var_uid":"463803353605e8ef030b904046745575","dataType":"multiplefile","protectedValue":false,"id":"file_cotizacion","name":"file_cotizacion","label":"Cotizacion PDF","inputDocument":"","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"PDF","size":1024,"sizeUnity":"KB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"file_cotizacion","colSpan":8}],[{"type":"checkbox","variable":"frm_recargar","var_uid":"1388041996061f4095eec01009479483","dataType":"boolean","protectedValue":false,"id":"frm_recargar","name":"frm_recargar","label":"Recargar","defaultValue":true,"hint":"Importa el archivo CSV y remplaza la informaci\u00f3n en el cotizador","required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"SI"},{"value":"0","label":"NO"}],"var_name":"frm_recargar","colSpan":4},{"type":"multipleFile","variable":"file_cotizacion_csv","var_uid":"629691198605e8f56472c25020056799","dataType":"multiplefile","protectedValue":false,"id":"file_cotizacion_csv","name":"file_cotizacion_csv","label":"Cotizacion csv","inputDocument":"","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"csv","size":1024,"sizeUnity":"KB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"file_cotizacion_csv","colSpan":8}]],"variables":[{"var_uid":"3966585855f6400f0e7a601081056031","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cod_cotizacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3966585855f6400f0e7a6010810560