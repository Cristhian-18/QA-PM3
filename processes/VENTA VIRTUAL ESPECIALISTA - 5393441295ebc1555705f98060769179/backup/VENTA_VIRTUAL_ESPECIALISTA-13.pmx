        <dyn_content><![CDATA[{"name":"SubForm_Cobranzas","description":"SubForm_Cobranzas","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7143229796457cc4c0f1d64039882781","name":"SubForm_Cobranzas","description":"SubForm_Cobranzas","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"sub_cobranzas","label":"DATOS COBRANZAS","colSpan":12}],[{"type":"dropdown","variable":"frm_cobranza_banco","var_uid":"6785653416457cd5a36b219050380890","dataType":"string","protectedValue":false,"id":"frm_cobranza_banco","name":"frm_cobranza_banco","label":"Banco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS'  AND ESTADO=1 AND (VALOR='E' OR VALOR ='EG')\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_cobranza_banco","colSpan":6},{"type":"dropdown","variable":"frm_cobranza_tipo_pago","var_uid":"4785969986457cd6ec7cdf1041187628","dataType":"string","protectedValue":false,"id":"frm_cobranza_tipo_pago","name":"frm_cobranza_tipo_pago","label":"Tipo de Pago","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'MEDIO_PAGO' AND ESTADO = 1","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_cobranza_tipo_pago","colSpan":6}],[{"type":"datetime","variable":"frm_cobranza_fecha","var_uid":"6703737556457cd7ae1bd96088987639","dataType":"datetime","protectedValue":false,"id":"frm_cobranza_fecha","name":"frm_cobranza_fecha","label":"Fecha de pago","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_cobranza_fecha","colSpan":6},{"type":"text","variable":"frm_cobranza_referencia","var_uid":"6752081916457cd8c6fbdd2089545448","dataType":"string","protectedValue":false,"id":"frm_cobranza_referencia","name":"frm_cobranza_referencia","label":"Referencia","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cobranza_referencia","colSpan":6}],[{"type":"text","variable":"frm_cobranza_valor","var_uid":"3049408636457cd999eee63094080822","dataType":"string","protectedValue":false,"id":"frm_cobranza_valor","name":"frm_cobranza_valor","label":"Valor","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cobranza_valor","colSpan":6},{"type":"textarea","variable":"frm_cobranza_comentario","var_uid":"2151044936457cdac1e8f47067053681","dataType":"string","protectedValue":false,"id":"frm_cobranza_comentario","name":"frm_cobranza_comentario","label":"Comentario Pago","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_cobranza_comentario","colSpan":6}]],"variables":[{"var_uid":"6785653416457cd5a36b219050380890","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_banco","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4785969986457cd6ec7cdf1041187628","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_tipo_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6703737556457cd7ae1bd96088987639","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_fecha","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6752081916457cd8c6fbdd2089545448","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_referencia","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var