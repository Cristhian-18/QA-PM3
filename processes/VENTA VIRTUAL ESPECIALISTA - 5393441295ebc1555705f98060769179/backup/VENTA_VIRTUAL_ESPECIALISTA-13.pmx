        <dyn_content><![CDATA[{"name":"subform causas regularizacion gestionar regularizacion","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"59672343762796838529bb6079521448","name":"subform causas regularizacion gestionar regularizacion","description":"","mode":"edit","script":{"type":"js","code":"//oculto grillas del subfrom regulizacion gestionar regularizacion\n$(\"#grd_coberturas\").hide();\n$(\"#dropdown0000000001\").hide();\n$(\"#text0000000001\").hide();\n$(\"#tipo_extraprima_2\").hide();\n$(\"#dropdown0000000003\").hide();\n$(\"#Años extraprima\").hide();\n$(\"#text0000000002\").hide();\n\ngrid_col_especifique();\n\nfunction grid_col_especifique() {\n\n  if ($(\"#grid_regularizacion\").getNumberRows() !== 0) {\n    for (var f = 1; f <= $(\"#grid_regularizacion\").getNumberRows(); f++) {\n\n      var respuesta = $(\"#grid_regularizacion\").getValue(f, 2);\n\n      if (respuesta == 'S') {\n        $(\"#grid_regularizacion\").getControl(f, 4).attr(\"disabled\",false);\n        //$(\"#grid_regularizacion\").getControl(f, 5).attr(\"disabled\",false);\n      } else {\n        //$(\"#grid_regularizacion\").getControl(f, 3).attr(\"disabled\", true);\n        //$(\"#grid_regularizacion\").getControl(f, 4).attr(\"disabled\",true);\n        //$(\"#grid_regularizacion\").getControl(f, 5).attr(\"disabled\",true);\n\n      }\n\n      files_hideShow_2(f, respuesta);\n\n    }\n  }\n\n}\n\nfunction files_hideShow_2(fila, respuesta){\n\n  if (fila == 3){\n    if (respuesta == 'S'){\n      $(\"#grd_obligatorios_incorrectos\").show();\n      $(\"#grd_especificos_incorrectos\").show();\n      $(\"#frm_opcionales\").show();\n      jQuery(\"#grd_obligatorios_incorrectos\").enableValidation(2);\n      jQuery(\"#grd_especificos_incorrectos\").enableValidation(2);\n    }else{\n      $(\"#grd_obligatorios_incorrectos\").hide();\n      $(\"#grd_especificos_incorrectos\").hide();\n      $(\"#frm_opcionales\").hide();\n      jQuery(\"#grd_obligatorios_incorrectos\").disableValidation(2);\n      jQuery(\"#grd_especificos_incorrectos\").disableValidation(2);\n    }\n  }\n\n}\n\n\n//On change del select \"Regulado\"\n$(\"#grid_regularizacion select\").on('change', function () {\t\n  var fila = $(this).val();\n  //alert(fila);\n});\n\n\n//On change del multiple archivo\n$(\"#grid_regularizacion .pm-multiplefile-upload value\").on('change',function(){\n  alert('extensin');\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_coberturas","var_uid":"6030027005fdb81b9030d59099807195","dataType":"grid","protectedValue":false,"id":"grd_coberturas","name":"grd_coberturas","label":"COBERTURAS CONTRATADAS","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"producto","name":"producto","label":"prod","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"1","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"10","width":100,"title":"prod"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"cobertura","name":"cobertura","label":"Cobertura<br>contratada","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"@@aBeneficios","options":[{"value":"","label":"Seleccione"}],"columnWidth":"20","width":100,"title":"Cobertura<br>contratada"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"valor_asegurado","name":"valor_asegurado","label":"Valor","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"10","width":100,"title":"Valor"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"por_extraprima","name":"por_extraprima","label":"% <br>Extrap.","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+(\\.\\d{2})?$","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"7","width":100,"title":"% <br>Extrap."},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"val_extraprima","name":"val_extraprima","label":"Usd<br>Extrap.","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+(\\.\\d{2})?$","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"9","width":100,"title":"Usd<br>Extrap."},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dsctos","name":"dsctos","label":"Dsctos<br>Cargos","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"8","width":100,"title":"Dsctos<br>Cargos"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"deducible","name":"deducible","label":"Deducible","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"@@aDeducible","options":[],"columnWidth":"14","width":100,"title":"Deducible"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"prima_neta_anual","name":"prima_neta_anual","label":"Prima<br> neta anual","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"12","width":100,"title":"Prima<br> neta anual"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"COBERTURAS CONTRATADAS","colSpan":12}],[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0000000001","name":"dropdown0000000001","label":"Tarifa","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"APLAZAR","label":"Aplazar"},{"value":"EXTRAPRIMA","label":"Extraprima"},{"value":"RECHAZAR","label":"Rechazar"},{"value":"TARIFA_NORMAL","label":"Tarifa normal"}],"colSpan":6},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text0000000001","name":"text0000000001","label":"Valor","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[1-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"El monto debe ser mayor a cero","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","colSpan":6}],[{"type":"dropdown","variable":"tipo_extraprima_2","var_uid":"53204048360aede5a5a6856059464771","dataType":"string","protectedValue":false,"id":"tipo_extraprima_2","name":"tipo_extraprima_2","label":"Tipo extraprima","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE \nCOD_CATALOGO = 'tipo_extraprima' \nAND ESTADO = 1 \nAND PRO_UID = '5393441295ebc1555705f98060769179'\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"tipo_extraprima_2","colSpan":6},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0000000003","name":"dropdown0000000003","label":"Motivo extraprima","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE \nCOD_CATALOGO = 'tmotivo_extraprima' \nAND ESTADO = 1 \nAND PRO_UID = '5393441295ebc1555705f98060769179'\nAND VALOR = '@#tipo_extraprima_2'\nORDER BY DESCRIPCION\n","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"colSpan":6}],[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text0000000002","name":"text0000000002","label":"Aiconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f1')))os extraprima","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[1-9][0-9]*$","validateMessage":"El monto debe ser mayor a cero","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","colSpan":6},{"colSpan":6}],[{"type":"grid","variable":"grid_regularizacion","var_uid":"523127344609f30b21e7