        <dyn_content><![CDATA[{"name":"subform direccion domicilio","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4989348205ec4353801c771067884578","name":"subform direccion domicilio","description":"","mode":"edit","script":{"type":"js","code":"if(typeof validarExpresionRegular === 'function') {\n\tvalidarExpresionRegular(\"frm_barrio\", 2);\n\t//validarExpresionRegular(\"frm_calle_principal\", 2);\n\tvalidarExpresionRegular(\"frm_numero\", 3);\n//\tvalidarExpresionRegular(\"frm_calle_transversal\", 2);\n\t//validarExpresionRegular(\"frm_conjunto_edificio\", 2);\n\t//validarExpresionRegular(\"frm_departamento_casa\", 2)\n}\n\nfunction domicilio_val(newVal, oldVal){\n\tif(newVal != '56' && newVal != ''){\n  \t$('#frm_provincia').disableValidation();\n    $('#frm_canton').disableValidation();\n    $('#frm_provincia').hide();\n    $('#frm_canton').hide();\n    $('#frm_provincia_auxiliar').show();\n    $('#frm_canton_auxiliar').show();\n  }else{\n    $('#frm_provincia').enableValidation();\n    $('#frm_canton').enableValidation();\n    $('#frm_provincia').show();\n    $('#frm_canton').show();  \n    $('#frm_provincia_auxiliar').hide();\n    $('#frm_canton_auxiliar').hide();\n  }\n}\n\n$(document).ready ( function(){\n\t\n\t//$('#frm_canton_auxiliar').hide();\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(false, 'frm_provincia', 'frm_canton');\n\t}\n  domicilio_val($(\"#frm_pais\").getValue(), 0);\n});\n\n$('#frm_provincia').on('change', function() {\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(true, 'frm_provincia', 'frm_canton');\n\t}\n});\n\n\n$(\"#frm_convencional\").hide();\n$('#frm_convencional').disableValidation();\n$('#frm_pais').setOnchange(domicilio_val);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_pais","var_uid":"38225710665180fe110a0b1074570243","dataType":"string","protectedValue":false,"id":"frm_pais","name":"frm_pais","label":"País","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"}],"var_name":"frm_pais","colSpan":4},{"type":"dropdown","variable":"frm_provincia","var_uid":"8284902755ec435498f16d3056661980","dataType":"string","protectedValue":false,"id":"frm_provincia","name":"frm_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='PROVINCIAS' AND ESTADO=1 AND VALOR = '@#frm_pais'\nORDER BY DESCRIPCION ASC","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"}],"var_name":"frm_provincia","colSpan":4},{"type":"dropdown","variable":"frm_canton","var_uid":"6015351485ec43549af8cf5067034244","dataType":"string","protectedValue":false,"id":"frm_canton","name":"frm_canton","label":"Cantón o Ciudad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='CANTONES' AND ESTADO=1 AND VALOR=@@frm_provincia\nORDER BY DESCRIPCION ASC","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"}],"var_name":"frm_canton","colSpan":4}],[{"type":"text","variable":"frm_provincia_auxiliar","var_uid":"932475154660ad647661944071905328","dataType":"string","protectedValue":false,"id":"frm_provincia_auxiliar","name":"frm_provincia_auxiliar","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_provincia_auxiliar","colSpan":6},{"type":"text","variable":"frm_canton_auxiliar","var_uid":"4052943965ec43549cfe5d1085303076","dataType":"string","protectedValue":false,"id":"frm_canton_auxiliar","name":"frm_canton_auxiliar","label":"Canton","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"2000","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_canton_auxiliar","colSpan":6}],[{"type":"text","variable":"frm_barrio","var_uid":"8152526645ec43549ededd2080448456","dataType":"string","protectedValue":false,"id":"frm_barrio","name":"frm_barrio","label":"Barrio o Sector","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"titleCase","validate":"^[-#.0-9a-zA-Z, ]+$","validateMessage":"Ingrese los datos correctamente","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","exter