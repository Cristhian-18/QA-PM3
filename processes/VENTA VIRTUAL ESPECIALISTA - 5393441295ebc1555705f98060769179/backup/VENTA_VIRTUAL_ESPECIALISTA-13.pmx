RIPCION FROM ADMIN_CATALOGOS \nWHERE\nESTADO = 1\nAND PRO_UID = '5393441295ebc1555705f98060769179'\nAND COD_CATALOGO = 'ttipo_agente'\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"30","width":100,"title":"Tipo agente"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_agente","name":"frm_agente","label":"Agente","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE\nESTADO = 1\nAND PRO_UID = '5393441295ebc1555705f98060769179'\nAND COD_CATALOGO = 'magente'\nAND VALOR = '@#frm_tipo_agente'\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"30","width":100,"title":"Agente"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_agente_porcentage","name":"frm_agente_porcentage","label":"Porcentage","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[1-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"El monto debe ser mayor a cero","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"30","width":100,"title":"Porcentage"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"Agentes","colSpan":12}],[{"type":"text","variable":"frm_agente_suma","var_uid":"49504460360afc495a3a970064137856","dataType":"string","protectedValue":false,"id":"frm_agente_suma","name":"frm_agente_suma","label":"Suma porcentajes","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","vali