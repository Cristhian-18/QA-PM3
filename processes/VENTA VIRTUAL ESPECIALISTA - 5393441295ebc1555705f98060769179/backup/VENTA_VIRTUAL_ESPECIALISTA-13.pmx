49073272020","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6539651075ee8cb18d9cf36086760462","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_titular_apellidos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2752798885ee8cb5b202153072254954","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_titular_apellidos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6150651485f04c4655be758023906114","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aplica_vitality","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7728182605f88e319956a76009637431","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_nombres_completos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
