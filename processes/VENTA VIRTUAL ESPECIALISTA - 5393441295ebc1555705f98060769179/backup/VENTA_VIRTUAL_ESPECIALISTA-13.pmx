        <dyn_content><![CDATA[{"name":"sub form dictsus varios","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9339587925faeb65b4e6c46077220923","name":"sub form dictsus varios","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grid0000000001","name":"grid0000000001","label":"Beneficiario asegurado","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdoawn0000000001","name":"dropdoawn0000000001","label":"Tipo de persona","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'ttipo_persona'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"150","width":100,"title":"Tipo de persona"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdowna0000000002","name":"dropdowna0000000002","label":"Tipo de Identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'ttipo_doc'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"180","width":100,"title":"Tipo de Identificacion"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text00