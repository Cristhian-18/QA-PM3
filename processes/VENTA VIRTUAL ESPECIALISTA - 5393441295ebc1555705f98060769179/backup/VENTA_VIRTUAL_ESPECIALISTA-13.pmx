        <dyn_title>sub form cuenta devolucion</dyn_title>
        <dyn_description></dyn_description>
        <pro_uid>5393441295ebc1555705f98060769179</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[5393441295ebc1555705f98060769179/8289982305ec5e457199fd7088050775]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"sub form cuenta devolucion","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8289982305ec5e457199fd7088050775","name":"sub form cuenta devolucion","description":"","mode":"edit","script":{"type":"js","code":"// $(\"#frm_devolucion_tipo_identificacion\").change( function () {\n \t// $('#frm_devolucion_identificacion ').setValue('');\n// });\n//Validar cedula de identidad y pasaporte\n$(\"#frm_devolucion_identificacion\").focusout(function () {\n   // if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificaciond($('#frm_devolucion_identificacion').getValue(), $('#frm_devolucion_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_devolucion_identificacion').setValue(\"\");\n         \t alert(\"Identifiacion incorrecta\");\n        }\n   // }\n});\n/*\n$(\"#frm_misma_cuenta_vitality\").change(function () {\n    cuenta_vitality();\n});\n\nfunction cuenta_vitality() {\n\n    if ($(\"#frm_misma_cuenta_vitality option:selected\").val() == 'CTAVITALITY') {\n      \n      $(\"#frm_devolucion_banco\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_tipo_cuenta\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_numero_cuenta\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_tipo_identificacion\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_titular\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_titular_apellidos\").getControl().attr('disabled', true); \n       $(\"#frm_devolucion_identificacion\").getControl().attr('disabled', true); \n    \n\n    }\n    else {\n       \n         $(\"#frm_devolucion_banco\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_tipo_cuenta\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_numero_cuenta\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_tipo_identificacion\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_titular\").getControl().attr('disabled', false); \n       $(\"#frm_devolucion_titular_apellidos\").getControl().attr('disabled', false); \n         $(\"#frm_devolucion_identificacion\").getControl().attr('disabled', false); \n    \n    }\n}\n*/\nfunction validarIdentificaciond(identificacion, tipoIdentificacion, aux) {\n\n    numero = identificacion;\n    var tercerDigito = numero.substring(2, 3);\n    var bandera = true;\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            if (aux) {\n                alert(\"La identificacion no tiene diez digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    } else if (tipoIdentificacion == 'R') {\n      \n      \tif (isNaN(numero)) {\n         //  alert(\"La identificacion es incorrecta\");\n           identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (numero.length != 13) {\n            if (aux) {\n                alert(\"La identificacion no tiene trece digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (tercerDigito == 9) {\n            digitos = numero.split(\"\");\n            totdigitos = 10;\n            total = 0;\n            digito = (digitos[9] * 1);\n            p1 = digitos[0] * 4;\n            p2 = digitos[1] * 3;\n            p3 = digitos[2] * 2;\n            p4 = digitos[3] * 7;\n            p5 = digitos[4] * 6;\n            p6 = digitos[5] * 5;\n            p7 = digitos[6] * 4;\n            p8 = digitos[7] * 3;\n            p9 = digitos[8] * 2;\n            total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\n            residuo = total % 11\n            final = residuo == 0 ? 0 : 11 - residuo\n            //comprobando codigo verificador\n            if (final == digito) {\n                //alert(\"RUC EMPRESA valido\");\n                bandera = false;\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"RUC EMPRESA no valido\");\n                }\n                identificacion.value = '';\n                bandera = false;\n            }\n        }\n    }\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n        var i = 0;\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n        //comprobando codigo verificador\n        decena = total / 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            //alert(\"Cedula valida\");\n            return true;\n        } else {\n            if (tipoIdentificacion == 'P') {\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"Identificacion no valida\");\n                }\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_titulo_devolucion","label":"<b>Si la solicitud de seguro no fuese aceptada, fuese aplazada o que no se concrete la revisión de la misma por necesidad\nde información o exámenes adicionales, acepto que el deposito y/valor provisional que he entregado sea devuelto a la siguiente cuenta:</B>","colSpan":12}],[{"type":"dropdown","variable":"frm_misma_cuenta_vitality","var_uid":"4861347545ec5e4e5b350b4093980583","dataType":"string","protectedValue":false,"id":"frm_misma_cuenta_vitality","name":"frm_misma_cuenta_vitality","label":"Cuenta","defaultValue":"","placeholder":"Seleccione","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"CTAVITALITY","label":"CUENTA VITALITY"},{"value":"CTAOTRA","label":"OTRA CUENTA"}],"var_name":"frm_misma_cuenta_vitality","colSpan":12}],[{"type":"dropdown","variable":"frm_devolucion_banco","var_uid":"2549207265ec5ebd5a26103020724822","dataType":"string","protectedValue":false,"id":"frm_devolucion_banco","name":"frm_devolucion_banco","label":"Banco","defaultValue":"","placeholder":"Seleccione","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS' AND ESTADO=1 AND (VALOR='E' OR VALOR='EG')\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[],"var_name":"frm_devolucion_banco","colSpan":12}],[{"type":"dropdown","variable":"frm_devolucion_tipo_cuenta","var_uid":"4375872795ec5ebe7467560099040242","dataType":"string","protectedValue":false,"id":"frm_devolucion_tipo_cuenta","name":"frm_devolucion_tipo_cuenta","label":"Tipo Cuenta","defaultValue":"","placeholder":"Seleccione\n","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"CTAAHO","label":"CUENTA AHORROS"},{"value":"CTACTE","label":"CUENTA CORRIENTE"}],"var_name":"frm_devolucion_tipo_cuenta","colSpan":6},{"type":"text","variable":"frm_devolucion_numero_cuenta","var_uid":"6295102835ec5ebf42b89e1073687300","dataType":"string","protectedValue":false,"id":"frm_devolucion_numero_cuenta","name":"frm_devolucion_numero_cuenta","label":"# Cuenta","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo se aceptan numeros","maxLength":"16","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_devolucion_numero_cuenta","colSpan":6}],[{"type":"dropdown","variable":"frm_devolucion_tipo_identificacion","var_uid":"5389834925ec5ec051be5b3068051481","dataType":"string","protectedValue":false,"id":"frm_devolucion_tipo_identificacion","name":"frm_devolucion_tipo_identificacion","label":"Tipo Identificación","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"C","label":"CEDULA"},{"value":"R","label":"RUC"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_devolucion_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_devolucion_identificacion","var_uid":"6388863975ec5ec176c2049073272020","dataType":"string","protectedValue":false,"id":"frm_devolucion_identificacion","name":"frm_devolucion_identificacion","label":"Identificación","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[a-zA-Z0-9_ -]*$","validateMessage":"","maxLength":"20","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_devolucion_identificacion","colSpan":6}],[{"type":"text","variable":"frm_devolucion_titular","var_uid":"3047118995ec5ec273cc967044757757","dataType":"string","protectedValue":false,"id":"frm_devolucion_titular","name":"frm_devolucion_titular","label":"Nombres","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato incorrecto","maxLength":"80","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_devolucion_titular","colSpan":6},{"type":"text","variable":"frm_devolucion_titular_apellidos","var_uid":"2752798885ee8cb5b202153072254954","dataType":"string","protectedValue":false,"id":"frm_devolucion_titular_apellidos","name":"frm_devolucion_titular_apellidos","label":"Apellidos","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato incorrecto","maxLength":"80","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_devolucion_titular_apellidos","colSpan":6}]],"variables":[{"var_uid":"4861347545ec5e4e5b350b4093980583","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_misma_cuenta_vitality","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4861347545ec5e4e5b350b4093980583","var_name_old":"frm_misma_cuenta_vitality","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"2549207265ec5ebd5a26103020724822","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_banco","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2549207265ec5ebd5a26103020724822","var_name_old":"frm_devolucion_banco","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"4375872795ec5ebe7467560099040242","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_tipo_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4375872795ec5ebe7467560099040242","var_name_old":"frm_devolucion_tipo_cuenta","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"6295102835ec5ebf42b89e1073687300","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_numero_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6295102835ec5ebf42b89e1073687300","var_name_old":"frm_devolucion_numero_cuenta","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"5389834925ec5ec051be5b3068051481","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5389834925ec5ec051be5b3068051481","var_name_old":"frm_devolucion_tipo_identificacion","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"6388863975ec5ec176c2049073272020","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6388863975ec5ec176c2049073272020","var_name_old":"frm_devolucion_identificacion","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"3047118995ec5ec273cc967044757757","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_titular","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3047118995ec5ec273cc967044757757","var_name_old":"frm_devolucion_titular","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"2752798885ee8cb5b202153072254954","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_devolucion_titular_apellidos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2752798885ee8cb5b202153072254954","var_name_old":"frm_devolucion_titular_apellidos","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}]}]}]]></dyn_content>
