    }
} else {
    //aqui no debe haber CODIGO
    //echo $respuesta['Message'];
    @@frm_accion_emisiona = 'ERROR';
    @@frm_accion ='EMISION';
    @@nro_asiento = '';
    @@nro_factura = '';
