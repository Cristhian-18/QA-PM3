        <dyn_content><![CDATA[{"name":"SubForm conyuge Solicitud","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"472083576608f275e8eac64071905583","name":"SubForm conyuge Solicitud","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_conyuge_tipo_identificacion\").change( function () {\n \t$('#frm_conyuge_numero_identificacion ').setValue('');\n});\nif(typeof validarExpresionRegular === 'function') {\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_paterno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_materno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_primer_nombre\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_segundo_nombre\", 1);\n}\n\n$(\"#frm_conyuge_numero_identificacion\").focusout(function () {\n  var identificacion = $(\"#frm_numero_identificacion\").getValue();\n   if ($(\"#frm_numero_identificacion\").getValue == identificacion) {\n    \talert(\"La identificacion ingresada no puede ser la misma del asegurado\");\n        (\"#frm_conyuge_numero_identificacion\").setValue(\"\");\n    }\n});\n\n\n// Validar que no podria tener menos de 18 anios cumplidos o mas de 69 anios cumplidos\n$(\"#frm_conyuge_fecha_nacimiento\").setOnchange(function () {\n    var fechaNacimiento = $(\"#frm_conyuge_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad < 69) {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_conyuge_fecha_nacimiento').setValue('');\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    //Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_conyuge_tipo_identificacion","var_uid":"34751558461da568aa693b9043873828","dataType":"string","protectedValue":false,"id":"frm_conyuge_tipo_identificacion","name":"frm_conyuge_tipo_identificacion","label":"Tipo de identificación","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_conyuge_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_conyuge_numero_identificacion","var_uid":"34739105461da569a3b6195075663521","dataType":"string","protectedValue":false,"id":"frm_conyuge_numero_identificacion","name":"frm_conyuge_numero_identificacion","label":"Número de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"Campo requerido","textTransform":"none","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"Formato no permitido","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_conyuge_primer_nombre","var_uid":"42759376265181842838e57069917727","dataType":"string","protectedValue":false,"id":"frm_conyuge_primer_nombre","name":"frm_conyuge_primer_nombre","label":"Primer nombre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_primer_nombre","colSpan":6},{"type":"text","variable":"frm_conyuge_segundo_nombre","var_uid":"391824217651818429df830096152755","dataType":"string","protectedValue":false,"id":"frm_conyuge_segundo_nombre","name":"frm_conyuge_segundo_nombre","label":"Segundo nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_segundo_nombre","colSpan":6}],[{"type":"text","variable":"frm_conyuge_apellido_paterno","var_uid":"46818291165181842b8dbe0080612169","dataType":"string","protectedValue":false,"id":"frm_conyuge_apellido_paterno","name":"frm_conyuge_apellido_paterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_apellido_paterno","colSpan":6},{"type":"text","variable":"frm_conyuge_apellido_materno","var_uid":"50354223665181842d19fb9066501056","dataType":"string","protectedValue":false,"id":"frm_conyuge_apellido_materno","name":"frm_conyuge_apellido_materno","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_apellido_materno","colSpan":6}],[{"type":"dropdown","variable":"frm_conyuge_nacionalidad","var_uid":"36175833465181872edc100097078428","dataType":"string","protectedValue":false,"id":"frm_conyuge_nacionalidad","name":"frm_conyuge_nacionalidad","label":"Nacionalidad","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_conyuge_nacionalidad","colSpan":6},{"type":"dropdown","variable":"frm_conyuge_tipo_empleo","var_uid":"1272839586518190f1a1ed0087380853","dataType":"string","protectedValue":false,"id":"frm_conyuge_tipo_empleo","name":"frm_conyuge_tipo_empleo","label":"Tipo de empleo (Actividad Económica)","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"DEPENDIENTE","label":"EMPLEADO PUBLICO"},{"value":"DEPENDIENTE_1","label":"EMPLEADO PRIVADO"},{"value":"INDEPENDIENTE","label":"INDEPENDIENTE"},{"value":"AMA_CASA","label":"AMA DE CASA / ESTUDIANTE"},{"value":"RENTISTA","label":"RENTISTA"},{"value":"JUBILADO","label":"JUBILADO / PENSIONISTA"},{"value":"REMESAS","label":"REMESAS DEL EXTERIOR"}],"var_name":"frm_conyuge_tipo_empleo","colSpan":6}],[{"type":"datetime","variable":"frm_conyugue_fecha_nacimiento","var_uid":"21724013765f2994795ffb4050942794","dataType":"datetime","protectedValue":false,"id":"frm_conyugue_fecha_nacimiento","name":"frm_conyugue_fecha_nacimiento","label":"Fecha de nacimiento","placeholder":"DD-MM-YYYY","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"DD-MM-YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_conyugue_fecha_nacimiento","colSpan":6},{"colSpan":6}],[{"type":"label","id":"lbl_conyuge","label":"<h5 style=\"color:#e84c3d;\"><b>Favor validar Dirección y Teléfono del Conyuge o Conviviente, editarla si fuese necesario.</b></h5><hr>","colSpan":12}],[{"type":"textarea","variable":"frm_conyuge_direccion","var_uid":"19994430865181aab036b79029294169","dataType":"string","protectedValue":false,"id":"frm_conyuge_direccion","name":"frm_conyuge_direccion","label":"Dirección","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql"