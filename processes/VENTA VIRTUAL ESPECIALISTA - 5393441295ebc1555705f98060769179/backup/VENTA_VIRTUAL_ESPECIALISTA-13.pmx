bIndex":"","value":"@#link_covid_fecha","href":"@@dana_link_covid","hint":"","ariaLabel":"","colSpan":6},{"type":"link","id":"lnk_informe","name":"lnk_informe","label":"Declaracion agente","tabIndex":"","value":"@#link_informe_fecha","href":"@@dana_link_informe_confidencial","hint":"","ariaLabel":"","colSpan":6}],[{"type":"link","id":"lnk_dictamen","name":"lnk_dictamen","label":"Dictamen Suscripcion","tabIndex":"","value":"@#tri_dictamen_fecha","href":"@@dana_link_dictamen","hint":"","ariaLabel":"","colSpan":6},{"colSpan":6}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subtit_cambios","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_acc\" subform=\"4959530495f45111f2b25d8085095050\"> <i class=\"glyphicon glyphicon-minus\"></i> ATENCION COMERCIAL</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4959530495f45111f2b25d8085095050","name":"Subform accion reproceso T7 ","description":"","mode":"edit","script":{"type":"js","code":"// comentar por paso produ\n//$(\"#frm_control_pago\").hide();\n//$(\"#frm_control_risk\").hide();\n//$(\"#frm_control_informe\").hide();\n//$(\"#frm_control_adjuntos\").hide();\n\n$(\"#frm_modificar_solicitud\").hide();\n$(\"#frm_modificar_debito\").hide();\n$(\"#frm_modificar_covid\").hide();\n$('#frm_modificar_covid').setValue('0');\n\n$(\"#frm_accion\").on(\"change\" , function() {\n  var sw = $(\"#frm_accion\").getControl().val();\n  $(\"#frm_comentario\").setValue('');\n  // alert (id);\n  if (sw == 'MODIFICAR')\n  {\n    $(\"#frm_modificar_solicitud\").show();\n    if($('#frm_debito_si').getValue() == 'SI')\n    \t$(\"#frm_modificar_debito\").show();\n    //$(\"#frm_modificar_covid\").show();\n  }\n  else\n  {\n    $('#frm_modificar_solicitud').setValue('0');\n    $('#frm_modificar_debito').setValue('0');\n    //$('#frm_modificar_covid').setValue('0'); \n     \n    \n    $(\"#frm_modificar_solicitud\").hide();\n    $(\"#frm_modificar_debito\").hide();\n    //$(\"#frm_modificar_covid\").hide();\n    //$(\"#frm_comentario\").setValue(''); \n\n    \n  }\n  if (sw == 'ADJUNTAR')\n  {\n    $(\"#frm_comentario\").setValue('Cliente entrega documentos');\n  }\n  if (sw == 'INFORME')\n  {\n    $(\"#frm_comentario\").setValue('Declaracion agente');\n  }  \n  if (sw == 'FINALIZAR')\n  {\n    $(\"#frm_comentario\").setValue('Cliente no cumple politica de riesgos');\n  }    \n   \n});\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"label0000000001","label":"<b>Por favor verificar que los formularios aceptados por el candidato se encuentren cargados en la herramienta para <u>\"Continuar el proceso.\"</u></b>","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"frm_control_pago","var_uid":"2505297005f9b2c55d511f9013991865","dataType":"string","protectedValue":false,"id":"frm_control_pago","name":"frm_control_pago","label":"Pago primera cuota","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_control_pago","colSpan":6},{"type":"text","variable":"frm_control_informe","var_uid":"5533533795f98eaca02fb36076009041","dataType":"string","protectedValue":true,"id":"frm_control_informe","name":"frm_control_informe","label":"Declaracion agente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_control_informe","colSpan