values('$ticket', '$app_uid', '$task_uid', '$fecha_inicio', '$fecha_fin', '$fecha_derivacion', '$fecha_vencimiento', '$del_index', '$codaccion', '$accion', '$usr_uid_actual', '$usr_uid_receptor', '$comentario', $tiempo_sla, $tiempo_atencion, $holgura)";
