o = $(\"#frm_conyuge_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad < 69) {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_conyuge_fecha_nacimiento').setValue('');\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    //Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_conyuge_tipo_identificacion","var_uid":"4772704505e829ed516ec73048585953","dataType":"string","protectedValue":false,"id":"frm_conyuge_tipo_identificacion","name":"frm_conyuge_tipo_identificacion","label":"Tipo de identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":