320456010cbab579823088697264\"> <i class=\"glyphicon glyphicon-minus\"><\/i> DATOS DEL PAGADOR<\/span>","colSpan":12}],[{"type":"dropdown","variable":"frm_pago_terceros","var_uid":"8038045615ebc18bd506c66096976444","dataType":"string","protectedValue":false,"id":"frm_pago_terceros","name":"frm_pago_terceros","label":"Pago Tercero","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_pago_terceros","colSpan":6},{"colSpan":6}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8639320456010cbab579823088697264","name":"subform datos pagador","description":"","mode":"disabled","script":{"type":"js","code":"\n$(\"#frm_cedula_pagador\").focusout(function(){\n  var bool = validarIdentificacion($('#frm_cedula_pagador ').getValue(), $('#frm_tipo_identificacion_pagador').getControl().val());\n  if(bool == false){\n    $('#frm_cedula_pagador ').setValue(\"\");\n    alert(\"Numero de identificacion incorrecta\")\n\n  }\n\n});\n\n\n\/*\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n    return false;\n  }\n  if(tipoIdentificacion=='R'){\n    if (numero.length != 13) {\n      \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n\n  var bandera = true;\n\n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n      \/\/  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\n    \/\/comprobando codigo verificador\n    decena = total \/ 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      \/\/alert(\"Cedula valida\");\n      return true;\n    }else{\n      \/\/Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n        alert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n        \/\/ alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}*\/\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"7804832955eea3b5a2c92c7018698875","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"text","variable":"frm_nombre_pagador","var_uid":"8805191105ebc18bc94fdc5085388163","dataType":"string","protectedValue":false,"id":"frm_nombre_pagador","name":"frm_nombre_pagador","label":"Nombres","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato incorrecto","maxLength":"50","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_nombre_pagador","colSpan":6},{"type":"text","variable":"frm_apellidos_pagador","var_uid":"7325486075ebc18bcacd946060018468","dataType":"string","protectedValue":false,"id":"frm_apellidos_pagador","name":"frm_apellidos_pagador","label":"Apellidos","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato incorrecto","maxLength":"50","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_apellidos_pagador","colSpan":6}],[{"type":"dropdown","variable":"frm_parentesco","var_uid":"2849415965ec195bc496ac2065401476","dataType":"string","protectedValue":false,"id":"frm_parentesco","name":"frm_parentesco","label":"Parentesco","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PARENTESCO' AND CODIGO IN (1,2,3,4,5,6,15,22) AND ESTADO 