        <dyn_content><![CDATA[{"name":"subform politicas emision","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6663629995fa42bedd1f833054954588","name":"subform politicas emision","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbel_emision","label":"<h5 style=\"color:#1C9DD9;\"><b>Políticas de emisión</b></h5><hr>","colSpan":12}],[{"type":"grid","variable":"grd_politicas_emision","var_uid":"152115123669f147b37c384027382274","dataType":"grid","protectedValue":false,"id":"grd_politicas_emision","name":"grd_politicas_emision","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_polemi_descripcion","name":"frm_polemi_descripcion","label":"Politica","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"50","width":100,"title":"Politica","var_name":"grd_politicas_emision"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_polemi_resultado","name":"frm_polemi_resultado","label":"Resultado","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"10","width":100,"title":"Resultado"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_polemi_obs","name":"frm_polemi_obs","label":"Observacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"40","width":100,"title":"Observacion"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"152115123669f147b37c384027382274","prj_uid":"5393441295ebc1555705f98060769179","var_name":"grd_politicas_emision","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
