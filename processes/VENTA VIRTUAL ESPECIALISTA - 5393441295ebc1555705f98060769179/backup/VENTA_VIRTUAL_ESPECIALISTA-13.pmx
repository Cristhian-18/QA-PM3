        <dyn_content><![CDATA[{"name":"subform num adjunto cotizacion","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"717835621600ef82bb986d1065323768","name":"subform num adjunto cotizacion","description":"","mode":"edit","script":{"type":"js","code":"$(\".btn-uploadfile\").text(\"Seleccionar archivo\");"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_cod_cotizacion","var_uid":"3966585855f6400f0e7a601081056031","dataType":"string","protectedValue":false,"id":"frm_cod_cotizacion","name":"frm_cod_cotizacion","label":"Num. Cotizacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{2,10}$","validateMessage":"Formato incorrecto","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cod_cotizacion","colSpan":3},{"type":"dropdown","variable":"frm_producto","var_uid":"1653057295f976349e08dc7010897132","dataType":"string","protectedValue":false,"id":"frm_producto","name":"frm_producto","label":"Producto","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM `ADMIN_CATALOGOS` WHERE COD_CATALOGO = 'producto_vida' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_producto","colSpan":6},{"type":"checkbox","variable":"frm_recargar","var_uid":"1388041996061f4095eec01009479483","dataType":"boolean","protectedValue":false,"id":"frm_recargar","name":"frm_recargar","label":"Recargar ","defaultValue":true,"hint":"Importa el archivo CSV y remplaza la informaciiconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f3')))n en el cotizador","required