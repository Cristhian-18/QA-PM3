        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[$cnx = '7477305145e37562849cda7003565620';
$app_uid = @@APPLICATION;
$app_number = @@APP_NUMBER;
$app_status = 'INGRESADO';
