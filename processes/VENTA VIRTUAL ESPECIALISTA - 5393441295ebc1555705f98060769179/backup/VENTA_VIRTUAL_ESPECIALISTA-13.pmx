        <dyn_content><![CDATA[{"name":"subform resumen personales","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6479360225f976335c43157021199308","name":"subform resumen personales","description":"","mode":"edit","script":{"type":"js","code":"$( function(){\n  var aux = $(\"#frm_recibio_deposito\").getControl().val();\n  if (aux == 'S'){\n    $(\"#frm_primera_cuota_medio_pago\").hide();   \n    $(\"#frm_deposito_medio\").show();   \n  }\n  else\n  {\n    $(\"#frm_primera_cuota_medio_pago\").show();   \n    $(\"#frm_deposito_medio\").hide();       \n  }\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"1376701895ec43528bf9be0095386762","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Numero de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9a-zA-Z]*$","validateMessage":"","maxLength":"30","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_nombres_completos","var_uid":"7728182605f88e319956a76009637431","dataType":"string","protectedValue":false,"id":"frm_nombres_completos","name":"frm_nombres_completos","label":"Nombre completo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_nombres_completos","colSpan":12}],[{"type":"dropdown","variable":"frm_estado_civil","var_uid":"4938512885ec4352a192960050708231","dataType":"string","protectedValue":false,"id":"frm_estado_civil","name":"frm_estado_civil","label":"Estado Civil","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"1","label":"Soltero"},{"value":"2","label":"Casado"},{"value":"3","label":"Divorsiado"},{"value":"4","label":"Viudo"},{"value":"5","label":"Union Libre"}],"var_name":"frm_estado_civil","colSpan":6},{"type":"text","variable":"frm_numero_hijos","var_uid":"1175762055ec4352a3a6667095733135","dataType":"string","protectedValue":false,"id":"frm_numero_hijos","name":"frm_numero_hijos","label":"Numero de hijos","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":"2","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_hijos","colSpan":6}],[{"type":"text","variable":"correo_preferido","var_uid":"9456261215f9766e7b3d096024836671","dataType":"string","protectedValue":false,"id":"correo_preferido","name":"correo_preferido","label":"Email","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"correo_preferido","colSpan":6},{"type":"text","variable":"telefono_preferido","var_uid":"7776318355f9766bb60d6d2038282580","dataType":"string","protectedValue":false,"id":"telefono_preferido","name":"telefono_preferido","label":"Celular","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"telefono_preferido","colSpan":6}]],"variables":[{"var_uid":"2838629145ec43528a30698090876761","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3631350015e829ed51bac93001647259","var_name_old":"frm_tipo_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"1376701895ec43528bf9be0095386762","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_numero_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6695089515e829ed51c9995051101725","var_name_old":"frm_numero_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"7728182605f88e319956a76009637431","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_nombres_completos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4938512885ec4352a192960050708231","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_estado_civil","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5187577455e829ed51e6930061871173","var_name_old":"frm_estado_civil","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"1175762055ec4352a3a6667095733135","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_numero_hijos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2292871175e829ed5193916004375304","var_name_old":"frm_numero_hijos","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"9456261215f9766e7b3d096024836671","prj_uid":"5393441295ebc1555705f98060769179","var_name":"correo_preferido","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7776318355f9766bb60d6d2038282580","prj_uid":"5393441295ebc1555705f98060769179","var_name":"telefono_preferido","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
