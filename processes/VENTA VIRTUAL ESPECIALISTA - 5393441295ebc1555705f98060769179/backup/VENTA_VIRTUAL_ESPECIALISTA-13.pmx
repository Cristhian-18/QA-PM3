        <dyn_content><![CDATA[{"name":"SubForm Casos Magnum","description":"SubForm Casos Magnum","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"26770765663c55d39d9a8d3040722455","name":"SubForm Casos Magnum","description":"SubForm Casos Magnum","mode":"edit","script":{"type":"js","code":"$(\"#bl_hist_mag\").hide();\n$(\"grd_datos_magnum\").hide();\n\nif($(\"#tri_bandera_magnum\").getValue() == 'true'){\n\t$(\"#bl_hist_mag\").show();\n  \t$(\"grd_datos_magnum\").show();\n}\n\nvar numRows = $(\"#grd_datos_magnum\").getNumberRows();\nfor (var i=1; i <= numRows; i++) {\n\t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_num_caso\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_num_caso\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_fecha_magnum\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_fecha_magnum\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_magnum\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_magnum\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_canal_entrada\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_canal_entrada\\\\]\").css(\"border\", \"green solid 2px\");\n  \t\/*$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_resumen_link\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_resumen_link\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_link\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_link\\\\]\").css(\"border\", \"green solid 2px\");\n  *\/  \n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"bl_hist_mag","label":"<h5 style=\"color:#1C9DD9;\"><b>Historial Magnum<\/b><\/h5><hr>","colSpan":12}],[{"type":"grid","variable":"grd_datos_magnum","var_uid":"33538202063c55d650227a6028096252","dataType":"grid","protectedValue":false,"id":"grd_datos_magnum","name":"grd_datos_magnum","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_num_caso","name":"grd_num_caso","label":"# Caso","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"10","width":100,"title":"# Caso","var_name":"grd_datos_magnum"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_fecha_magnum","name":"grd_fecha_magnum","label":"Fecha","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"15","width":100,"title":"Fecha"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_decision_magnum","name":"grd_decision_magnum","label":"Decision","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"10","columnWidth":"40","width":100,"title":"Decision"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_canal_entrada","name":"grd_canal_entrada","label":"Canal","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"15","width":100,"title":"Canal"},{"type":"link","id":"grd_decision_link","name":"grd_decision_link","label":"","value":"Visualizar","href":"","hint":"","columnWidth":"10","width":100,"title":""},{"type":"link","id":"grd_resumen_link","name":"grd_resumen_link","label":"","value":"Visualizar","href":"","hint":"","columnWidth":"10","width":100,"title":""}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"","colSpan":12}],[{"type":"hidden","variable":"tri_bandera_magnum","var_uid":"16543323663852f4a341920074856280","dataType":"string","protectedValue":false,"id":"tri_bandera_magnum","name":"tri_bandera_magnum","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_magnum","colSpan":12}]],"variables":[{"var_uid":"33538202063c55d650227a6028096252","prj_uid":"5393441295ebc1555705f98060769179","var_name":"grd_datos_magnum","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"16543323663852f4a341920074856280","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_bandera_magnum","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
