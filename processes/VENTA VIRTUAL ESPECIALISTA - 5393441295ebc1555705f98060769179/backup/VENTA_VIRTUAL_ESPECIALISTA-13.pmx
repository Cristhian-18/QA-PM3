        <dyn_content><![CDATA[{"name":"subform analisis venta","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7322237105fa4354c1c5cc1002811158","name":"subform analisis venta","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_Sucursal","var_uid":"2810092775fa4355d89f3a2027362825","dataType":"string","protectedValue":false,"id":"frm_Sucursal","name":"frm_Sucursal","label":"Sucursal","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"5624461675dcaef93dcaa10013654573","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT \n  CODIGO, DESCRIPCION\nFROM\n  ADMIN_CATALOGOS \nWHERE COD_CATALOGO = 'SUCURSAL' \nAND PRO_UID = '6464242075dc1b09e050206009257411'\nAND ESTADO = 1\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"---- Seleccione una opci\u00f3n ----"}],"var_name":"frm_Sucursal","colSpan":6},{"type":"dropdown","variable":"frm_Jefe_ventas","var_uid":"1241781935fa4355dd21b29075390966","dataType":"string","protectedValue":false,"id":"frm_Jefe_ventas","name":"frm_Jefe_ventas","label":"Jefe de ventas","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"5624461675dcaef93dcaa10013654573","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT \n  CODIGO, DESCRIPCION\nFROM\n  ADMIN_CATALOGOS \nWHERE COD_CATALOGO = 'JEFE_VTA' \nAND PRO_UID = '6464242075dc1b09e050206009257411'\nAND ESTADO = 1\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"---- Seleccione una opci\u00f3n ----"}],"var_name":"frm_Jefe_ventas","colSpan":6}],[{"type":"dropdown","variable":"frm_uid_asesor","var_uid":"5389283835fa4355e017d17094389438","dataType":"string","protectedValue":false,"id":"frm_uid_asesor","