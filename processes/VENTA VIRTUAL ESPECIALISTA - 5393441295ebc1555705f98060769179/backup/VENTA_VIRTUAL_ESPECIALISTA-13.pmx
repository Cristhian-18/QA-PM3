        <dyn_content><![CDATA[{"name":"Subform EC o APS","description":"Subform que verifica la persona que ingresa la solicitud es EC o Broker","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8817384746318d0059fb703027825554","name":"Subform EC o APS","description":"Subform que verifica la persona que ingresa la solicitud es EC o Broker","mode":"edit","script":{"type":"js","code":"\/\/created By Henry\nvar is_broker = $(\"#tri_es_broker\").getValue();\n\nif(is_broker == 'SI'){\n\t$(\"#frm_vendedor_nombre\").hide();\n  \t$(\"#frm_vendedor_cargo\").disableValidation();\n  \t$(\"#frm_vendedor_cargo\").hide();\n}else{\n\t$(\"#frm_aps_nombre\").disableValidation();\n  \t$(\"#frm_aps_nombre\").hide();\n  \t$(\"#frm_aps_cargo\").disableValidation();\n  \t$(\"#frm_aps_cargo\").hide();\n  \t$(\"#frm_aps_ec_nombre\").hide();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_aps_codigo_tipoAgente","var_uid":"133617606667319d22bf8e6037213702","dataType":"string","protectedValue":false,"id":"frm_aps_codigo_tipoAgente","name":"frm_aps_codigo_tipoAgente","label":"Tipo Agente","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"1","label":"AGENCIAS-EMP"},{"value":"2","label":"AGENTES IND"},{"value":"3","label":"FUERZA DE VENTA ESPECIALISTA"}],"var_name":"frm_aps_codigo_tipoAgente","colSpan":6},{"type":"text","variable":"frm_aps_codigo_agente","var_uid":"460175202667319e0091434079946301","dataType":"string","protectedValue":false,"id":"frm_aps_codigo_agente","name":"frm_aps_codigo_agente","label":"Codigo Agente","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_aps_codigo_agente","colSpan":6}],[{"type":"text","variable":"frm_vendedor_nombre","var_uid":"7399090555ec6892b2f9214071330107","dataType":"string","protectedValue":false,"id":"frm_vendedor_nombre","name":"frm_vendedor_nombre","label":"Nombre Ejecutivo Comercial","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_vendedor_nombre","colSpan":6},{"type":"text","variable":"frm_vendedor_cargo","var_uid":"8345886506318d10a75c769064952518","dataType":"string","protectedValue":false,"id":"frm_vendedor_cargo","name":"frm_vendedor_cargo","label":"Cargo Ejecutivo Comercial","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_vendedor_cargo","colSpan":6}],[{"type":"text","variable":"frm_aps_nombre","var_uid":"4462069636318d174c77378033337515","dataType":"string","protectedValue":false,"id":"frm_aps_nombre","name":"frm_aps_nombre","label":"Nombre del APS","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_aps_nombre","colSpan":4},{"type":"text","variable":"frm_aps_ec_nombre","var_uid":"1230222146318d18eee85b3029354014","dataType":"string","protectedValue":false,"id":"frm_aps_ec_nombre","name":"frm_aps_ec_nombre","label":"Nombre Ejecutivo APS","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_aps_ec_nombre","colSpan":4},{"type":"text","variable":"frm_aps_cargo","var_uid":"9892683696318d1c165e110037890103","dataType":"string","protectedValue":false,"id":"frm_aps_cargo","name":"frm_aps_cargo","label":"Cargo Ejecutivo APS","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_aps_cargo","colSpan":4}],[{"type":"hidden","variable":"tri_es_broker","var_uid":"95167456160becf060a78f9098563798","dataType":"string","protectedValue":false,"id":"tri_es_broker","name":"tri_es_broker","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_es_broker","colSpan":12}]],"variables":[{"var_uid":"133617606667319d22bf8e6037213702","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aps_codigo_tipoAgente","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"460175202667319e0091434079946301","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aps_codigo_agente","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7399090555ec6892b2f9214071330107","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vendedor_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8345886506318d10a75c769064952518","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vendedor_cargo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4462069636318d174c77378033337515","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aps_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"1230222146318d18eee85b3029354014","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aps_ec_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9892683696318d1c165e110037890103","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_aps_cargo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95167456160becf060a78f9098563798","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_es_broker","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
