    }
    $aux_i++;
}

$bandera_dental_exequial = 0;
foreach(@=grid_seguro_exequial as $dataex){
    $iden_e = $dataex['frm_exequial_identificacion'];
    $tipoDocumento = $dataex['frm_exequial_tipo_identificacion'] == 1 ? 'C' : 'P';
