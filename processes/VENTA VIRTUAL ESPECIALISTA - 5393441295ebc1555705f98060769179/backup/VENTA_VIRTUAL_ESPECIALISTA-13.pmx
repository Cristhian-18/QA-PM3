olSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"1308114045ec43c341dbf91082909342","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_comentarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5608579545e829ed522fed0018096998","var_name_old":"tri_comentarios","prj_uid_old":"3685317655e829ed34bce43075006773","create":false}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8817384746318d0059fb703027825554","name":"Subform EC o APS","description":"Subform que verifica la persona que ingresa la solicitud es EC o Broker","mode":"edit","script":{"type":"js","code":"//created By Henry\nvar is_broker = $(\"#tri_es_broker\").getValue();\n\nif(is_broker == 'SI'){\n\t$(\"#frm_vendedor_nombre\").hide();\n  \t$(\"#frm_vendedor_cargo\").disableValidation();\n  \t$(\"#frm_vendedor_cargo\").hide();\n}else{\n\t$(\"#frm_aps_nombre\").disableValidation();\n  \t$(\"#frm_aps_nombre\").hide();\n  \t$(\"#frm_aps_cargo\").disableValidation();\n  \t$(\"#frm_aps_cargo\").hide();\n  \t$(\"#frm_aps_ec_nombre\").hide();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_aps_codigo_tipoAgente","var_uid":"133617606667319d22bf8e6037213702","dataType":"string","protectedValue":false,"id":"frm_aps_codigo_tipoAgente","name":"frm_aps_codigo_tipoAgente","label":"Tipo Agente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"AGENCIAS-EMP"},{"value":"2","label":"AGENTES IND"},{"value":"3","label":"FUERZA DE VENTA ESPECIA