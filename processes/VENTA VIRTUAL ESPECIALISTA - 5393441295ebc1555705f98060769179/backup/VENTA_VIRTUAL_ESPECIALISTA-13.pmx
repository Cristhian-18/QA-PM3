}],[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"1376701895ec43528bf9be0095386762","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Numero de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9a-zA-Z]*$","validateMessage":"","maxLength":"30","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_identificacion","colSpan":6}],[{"type":"text","variable":"tri_CodAseg_SISE","var_uid":"858843559669f17394c81a3074008420","dataType":"string","protectedValue":false,"id":"tri_CodAseg_SISE","name":"tri_CodAseg_SISE","label":"Codigo Asegurado","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_CodAseg_SISE","colSpan":6},{"type":"hidden","variable":"frm_fecha_nacimiento","var_uid":"8085954315ec43529b5f970038530666","dataType":"datetime","protectedValue":false,"id":"frm_fecha_nacimiento","name":"frm_fecha_nacimiento","defaultValue":"","dbConnectio