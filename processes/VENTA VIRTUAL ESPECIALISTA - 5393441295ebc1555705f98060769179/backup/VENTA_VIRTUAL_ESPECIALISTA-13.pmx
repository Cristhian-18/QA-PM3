xt0000000022","name":"text0000000022","label":"Incremento","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"150","width":100,"title":"Incremento"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text0000000023","name":"text0000000023","label":"% de incremento","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"150","width":100,"title":"% de incremento"}],"data":[],"mode":"parent","layout":"static","pageSize":"0","addRow":true,"deleteRow":true,"title":"Coberturas dependiente","colSpan":12}],[{"type":"grid","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grid0000000005","name":"grid0000000005","label":"Agentes","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0000000008","name":"dropdown0000000008","label":"Tipo de agente","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'ttipo_agente'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"columnWidth":"150","width":100,"title":"Tipo de agente"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropd