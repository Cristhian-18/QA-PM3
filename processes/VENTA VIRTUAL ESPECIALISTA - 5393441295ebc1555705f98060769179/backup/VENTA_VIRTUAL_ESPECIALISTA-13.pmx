st:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS'  AND ESTADO=1 AND (VALOR='E' OR VALOR ='EG')\nORDER BY DESCRIPCION ASC","memoryCache":false,"dataVariable":"","options":[],"var_name":"frm_vitality_banco","colSpan":12}],[{"type":"dropdown","variable":"frm_vitality_tipo_cuenta","var_uid":"2796809805ec5e1034f5169052407966","dataType":"string","protectedValue":false,"id":"frm_vitality_tipo_cuenta","name":"frm_vitality_tipo_cuenta","label":"Tipo Cuenta","tabIndex":"","defaultValue":"","placeholder":"Seleccione\n","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"CTAAHO","label":"CUENTA AHORROS"},{"value":"CTACTE","label":"CUENTA CORRIENTE"}],"var_name":"frm_vitality_tipo_cuenta","colSpan":6},{"type":"text","variable":"frm_vitality_numero_cuenta","var_uid":"5740012375ec5e13a39a144021585272","dataType":"string","protectedValue":false,"id":"frm_vitality_numero_cuenta","name":"frm_vitality_numero_cuenta","label":"# Cuenta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"","maxLength":"16","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vitality_numero_cuenta","colSpan":6}]],"variables":[{"var_uid":"2359733165ec5e17b3fbe13007796898","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_titular","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6539651075ee8cb18d9cf36086760462","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_titular_apellidos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2330539015ec5e225d9ee61046693089","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6389536805ec5e163182152073610421","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4247484875ec5e0d88a28c4062536765","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_banco","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2796809805ec5e1034f5169052407966","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_tipo_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5740012375ec5e13a39a144021585272","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_vitality_numero_cuenta","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"title","id":"tit_devolucion","label":"<span class=\"subtitulo\" id=\"isub_devolucion\" subform=\"8289982305ec5e457199fd7088050775\"> <i class=\"glyphicon glyphicon-plus\"></i> 7. CUENTA TRANSFERENCIA EN CASO DE DEVOLUCION</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8289982305ec5e457199fd7088050775","name":"sub form cuenta devolucion","description":"","mode":"edit","script":{"type":"js","code":"// $(\"#frm_devolucion_tipo_identificacion\").change( function () {\n \t// $('#frm_devolucion_identificacion ').setValue('');\n// });\n//Validar cedula de identidad y pasaporte\n$(\"#frm_devolucion_identificacion\").focusout(function () {\n   // if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificaciond($('#frm_devolucion_identificacion').getValue(), $('#frm_devolucion_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_devolucion_identificacion').setValue(\"\");\n         \t alert(\"Identifiacion incorrecta\");\n        }\n   // }\n});\n/*\n$(\"#frm_misma_cuenta_vitality\").change(function () {\n    cuenta_vitality();\n});\n\nfunction cuenta_vitality() {\n\n    if ($(\"#frm_misma_cuenta_vitality option:selected\").val() == 'CTAVITALITY') {\n      \n      $(\"#frm_devolucion_banco\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_tipo_cuenta\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_numero_cuenta\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_tipo_identificacion\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_titular\").getControl().attr('disabled', true); \n      $(\"#frm_devolucion_titular_apellidos\").getControl().attr('disabled', true); \n       $(\"#frm_devolucion_identificacion\").getControl().attr('disabled', true); \n    \n\n    }\n    else {\n       \n         $(\"#frm_devolucion_banco\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_tipo_cuenta\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_numero_cuenta\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_tipo_identificacion\").getControl().attr('disabled', false); \n      $(\"#frm_devolucion_titular\").getControl().attr('disabled', false); \n       $(\"#frm_devolucion_titular_apellidos\").getControl().attr('disabled', false); \n         $(\"#frm_devolucion_identificacion\").getControl().attr('disabled', false); \n    \n    }\n}\n*/\nfunction validarIdentificaciond(identificacion, tipoIdentificacion, aux) {\n\n    numero = identificacion;\n    var tercerDigito = numero.substring(2, 3);\n    var bandera = true;\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            if (aux) {\n                alert(\"La identificacion no tiene diez digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    } else if (tipoIdentificacion == 'R') {\n      \n      \tif (isNaN(numero)) {\n         //  alert(\"La identificacion es incorrecta\");\n           identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (numero.length != 13) {\n            if (aux) {\n                alert(\"La identificacion no tiene trece digitos\");\n            }\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n        if (tercerDigito == 9) {\n            digitos = numero.split(\"\");\n            totdigitos = 10;\n            total = 0;\n            digito = (digitos[9] * 1);\n            p1 = digitos[0] * 4;\n            p2 = digitos[1] * 3;\n            p3 = digitos[2] * 2;\n            p4 = digitos[3] * 7;\n            p5 = digitos[4] * 6;\n            p6 = digitos[5] * 5;\n            p7 = digitos[6] * 4;\n            p8 = digitos[7] * 3;\n            p9 = digitos[8] * 2;\n            total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\n            residuo = total % 11\n            final = residuo == 0 ? 0 : 11 - residuo\n            //comprobando codigo verificador\n            if (final == digito) {\n                //alert(\"RUC EMPRESA valido\");\n                bandera = false;\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"RUC EMPRESA no valido\");\n                }\n                identificacion.value = '';\n                bandera = false;\n            }\n        }\n    }\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n        var i = 0;\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n        //comprobando codigo verificador\n        decena = total / 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            //alert(\"Cedula valida\");\n            return true;\n        } else {\n            if (tipoIdentificacion == 'P') {\n                return true;\n            } else {\n                if (aux) {\n                    alert(\"Identificacion no valida\");\n                }\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_titulo_devolucion","label":"<b>Si la solicitud de seguro no fuese aceptada, fuese aplazada o que no se concrete la revisión de la misma por necesidad\nde información o exámenes adicionales, acepto que el deposito y/valor provisional que he entregado sea devuelto a la siguiente cuenta:</B>","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_misma_cuenta_vitality","var_uid":"4861347545ec5e4e5b350b4093980583","dataType":"string","protectedValue":false,"id":"frm_misma_cuenta_vitality","name":"frm_misma_cuenta_vitality","label":"Cuenta","tabIndex":"","defaultValue":"","placeholder":"Seleccione","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"CTAVITALITY","label":"CUENTA VITALITY"},{"value":"CTAOTRA","label":"OTRA CUENTA"}],"var_name":"frm_misma_cuenta_vitality","colSpan":12}],[{"type":"dropdown","variable":"frm_devolucion_banco","var_uid":"2549207265ec5ebd5a26103020724822","dataType":"string","protectedValue":false,"id":"frm_devolucion_banco","name":"frm_devolucion_banco","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"Seleccione","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS' AND ESTADO=1 AND (VALOR='E' OR VALOR='EG')\nORDER BY DESCRIPCION ASC","memoryCache":false,"dataVariable":"","options":[],"var_name":"frm_devolucion_banco","colSpan":12}],[{"type":"dropdown","variable":"frm_devolucion_tipo_cuenta","var_uid":"4375872795ec5ebe7467560099040242","dataT