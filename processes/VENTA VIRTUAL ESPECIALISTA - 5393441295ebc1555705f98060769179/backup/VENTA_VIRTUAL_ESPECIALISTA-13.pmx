        <dyn_filename><![CDATA[5393441295ebc1555705f98060769179/3757104985ec4355abb45c4085575644]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"subform conyuge datos personales","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3757104985ec4355abb45c4085575644","name":"subform conyuge datos personales","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_conyuge_tipo_identificacion\").change( function () {\n \t$('#frm_conyuge_numero_identificacion ').setValue('');\n});\nif(typeof validarExpresionRegular === 'function') {\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_paterno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_materno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_primer_nombre\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_segundo_nombre\", 1);\n}\n\n$(\"#frm_conyuge_numero_identificacion\").focusout(function () {\n  var identificacion = $(\"#frm_numero_identificacion\").getValue();\n   if ($(\"#frm_numero_identificacion\").getValue == identificacion) {\n    \talert(\"La identificacion ingresada no puede ser la misma del asegurado\");\n        (\"#frm_conyuge_numero_identificacion\").setValue(\"\");\n    }\n});\n\n\n// Validar que no podria tener menos de 18 anios cumplidos o mas de 69 anios cumplidos\n$(\"#frm_conyuge_fecha_nacimiento\").setOnchange(function () {\n    var fechaNacimiento = $(\"#frm_conyuge_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad < 69) {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_conyuge_fecha_nacimiento').setValue('');\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    //Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_conyuge_tipo_identificacion","var_uid":"4772704505e829ed516ec73048585953","dataType":"string","protectedValue":false,"id":"frm_conyuge_tipo_identificacion","name":"frm_conyuge_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_conyuge_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_conyuge_numero_identificacion","var_uid":"8951537385e829ed51a4901025955614","dataType":"string","protectedValue":false,"id":"frm_conyuge_numero_identificacion","name":"frm_conyuge_numero_identificacion","label":"Numero de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"Campo requerido","textTransform":"none","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"Formato no permitido","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_conyuge_primer_nombre","var_uid":"9202546135e829ed51de290070601778","dataType":"string","protectedValue":false,"id":"frm_conyuge_primer_nombre","name":"frm_conyuge_primer_nombre","label":"Primer nombre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_primer_nombre","colSpan":6},{"type":"text","variable":"frm_conyuge_segundo_nombre","var_uid":"5480705335e829ed51bc714038616280","dataType":"string","protectedValue":false,"id":"frm_conyuge_segundo_nombre","name":"frm_conyuge_segundo_nombre","label":"Segundo nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_segundo_nombre","colSpan":6}],[{"type":"text","variable":"frm_conyuge_apellido_paterno","var_uid":"6299580875e829ed525af13006096699","dataType":"string","protectedValue":false,"id":"frm_conyuge_apellido_paterno","name":"frm_conyuge_apellido_paterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_apellido_paterno","colSpan":6},{"type":"text","variable":"frm_conyuge_apellido_materno","var_uid":"3833879525e829ed517dff5087142494","dataType":"string","protectedValue":false,"id":"frm_conyuge_apellido_materno","name":"frm_conyuge_apellido_materno","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_conyuge_apellido_materno","colSpan":6}]],"variables":[{"var_uid":"4772704505e829ed516ec73048585953","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8951537385e829ed51a4901025955614","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_numero_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9202546135e829ed51de290070601778","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_primer_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5480705335e829ed51bc714038616280","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_segundo_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6299580875e829ed525af13006096699","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_apellido_paterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3833879525e829ed517dff5087142494","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_conyuge_apellido_materno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
