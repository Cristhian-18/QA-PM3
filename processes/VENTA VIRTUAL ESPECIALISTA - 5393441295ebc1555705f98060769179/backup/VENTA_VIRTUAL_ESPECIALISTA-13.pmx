":false,"id":"html_decision_magnum","name":"html_decision_magnum","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"html_decision_magnum","colSpan":1},{"type":"hidden","variable":"tri_es_broker","var_uid":"95167456160becf060a78f9098563798","dataType":"string","protectedValue":false,"id":"tri_es_broker","name":"tri_es_broker","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_es_broker","colSpan":1},{"type":"hidden","variable":"tri_bandera_primera_cuota","var_uid":"22032268863e6796c312474045078599","dataType":"string","protectedValue":false,"id":"tri_bandera_primera_cuota","name":"tri_bandera_primera_cuota","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_primera_cuota","colSpan":1},{"type":"hidden","variable":"frm_recibio_deposito","var_uid":"6163213375f1264730a9313065496027","dataType":"string","protectedValue":false,"id":"frm_recibio_deposito","name":"frm_recibio_deposito","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_recibio_deposito","colSpan":1},{"type":"hidden","variable":"frm_pago_terceros","var_uid":"8038045615ebc18bd506c66096976444","dataType":"string","protectedValue":false,"id":"frm_pago_terceros","name":"frm_pago_terceros","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_pago_terceros","colSpan":1}]],"variables":[{"var_uid":"4281432486380019a076106084768940","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_debito_si","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"907391348638001a5c1cf45015163623","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_pago_si","var_field_type":"strin