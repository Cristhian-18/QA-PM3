ker","colSpan":4},{"colSpan":4}]],"variables":[{"var_uid":"24664147464489b16147d13091812793","prj_uid":"5393441295ebc1555705f98060769179","var_name":"fle_mas_docs","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"18998844564696e73d44298013651947","prj_uid":"5393441295ebc1555705f98060769179","var_name":"fle_otros_docs","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95915000064888e07523ce8049172650","prj_uid":"5393441295ebc1555705f98060769179","var_name":"fle_docs_repro","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"573084827649062274a1331098041613","prj_uid":"5393441295ebc1555705f98060769179","var_name":"fle_docs_aprobar","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8462559665f8f1f9fca8350024764654","prj_uid":"5393441295ebc1555705f98060769179","var_name":"TASK","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95167456160becf060a78f9098563798","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_es_broker","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}]],"variables":[]}]}]]></dyn_content>
