"defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccion"},{"value":"M","label":"MASCULINO"},{"value":"F","label":"FEMENINO"}],"var_name":"frm_sexo","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"3631350015e829ed51bac93001647259","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3631350015e829ed51bac93001647259","var_name_old":"frm_tipo_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"6695089515e829ed51c9995051101725","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_numero_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6695089515e829ed51c9995051101725","var_name_old":"frm_numero_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"6663904455e829ed5236922089000242","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_apellido_paterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6663904455e829ed5236922089000242","var_name_old":"frm_apellido_paterno","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"5537661105e829ed51eb9b5095670724","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_apellido_materno","var_field_ty