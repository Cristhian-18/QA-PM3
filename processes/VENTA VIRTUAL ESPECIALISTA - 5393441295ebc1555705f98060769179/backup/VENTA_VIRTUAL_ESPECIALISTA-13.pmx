        <dyn_content><![CDATA[{"name":"sub form PEP","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"1739740325edd7debda4263019542413","name":"sub form PEP","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_pep_cargo_publico","var_uid":"9230077795edd7f170a67a9024048867","dataType":"string","protectedValue":false,"id":"frm_pep_cargo_publico","name":"frm_pep_cargo_publico","label":"Alguna vez ha ocupado un cargo p\u00fablico? ","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_pep_cargo_publico","colSpan":12}],[{"type":"text","variable":"frm_pep_cargo_a","var_uid":"8275687215edd7e6d74deb2069519152","dataType":"string","protectedValue":false,"id":"frm_pep_cargo_a","name":"frm_pep_cargo_a","label":"Cargo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_pep_cargo_a","colSpan":6},{"type":"text","variable":"frm_pep_antiguedad_cargo_a","var_uid":"1783319685edd7e811e32c6006252752","dataType":"string","protectedValue":false,"id":"frm_pep_antiguedad_cargo_a","name":"frm_pep_antiguedad_cargo_a","label":"Antiguedad del Cargo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_pep_antiguedad_cargo_a","colSpan":6}],[{"type":"text","variable":"frm_pep_institucion_a","var_uid":"7154551575edd7e925b1f76042671809","dataType":"string","protectedValue":false,"id":"frm_pep_institucion_a","name":"frm_pep_institucion_a","label":"Instituci\u00f3n en la que trabaj\u00f3","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_pep_institucion_a","colSpan":6},{"type":"text","variable":"frm_pep_grado_cargo_a","var_uid":"1109029635edd7eab5db931015885864","dataType":"string","protectedValue":false,"id":"frm_pep_grado_cargo_a","name":"frm_pep_grado_cargo_a","label":"Grado seg\u00fan la escala de remuneraci\u00f3n unificada","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_pep_grado_cargo_a","colSpan":6}],[{"type":"grid","variable":"grid_pep_relaciones","var_uid":"1712869965edd7fc5a222c7078152618","dataType":"grid","protectedValue":false,"id":"grid_pep_relaciones","name":"grid_pep_relaciones","label":"DETALLE DE RELACIONES (CONSANGUINIDAD Y AFINIDAD)","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_parentesco_pep_a","name":"frm_parentesco_pep_a","label":"Parentesco","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PARENTESCO' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"100","label":"Esposo"},{"value":"101","label":"Esposa"}],"columnWidth":"200","width":100,"title":"Parentesco","var_name":"grid_pep_relaciones"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_identificacion_pep_a","name":"frm_identificacion_pep_a","label":"Identificaci\u00f3n","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Identificaci\u00f3n"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_primer_nombre_pep_a","name":"frm_primer_nombre_pep_a","label":"Primer Nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Primer Nombre"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_segundo_nombre_pep_a","name":"frm_segundo_nombre_pep_a","label":"Segundo Nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Segundo Nombre"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_apellido_paterno_pep_a","name":"frm_apellido_paterno_pep_a","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Apellido Paterno"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_apellido_materno_pep_a","name":"frm_apellido_materno_pep_a","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Apellido Materno"}],"data":[],"mode":"parent","layout":"static","pageSize":"0","addRow":true,"deleteRow":true,"title":"DETALLE DE RELACIONES (CONSANGUINIDAD Y AFINIDAD)","colSpan":12}],[{"type":"grid","variable":"grid_pep_colaboradores","var_uid":"2148900565edd80dc994902033615752","dataType":"grid","protectedValue":false,"id":"grid_pep_colaboradores","name":"grid_pep_colaboradores","label":"Colaboradores cercanos","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_cargo_pep_b","name":"frm_cargo_pep_b","label":"Cargo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"80","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Cargo","var_name":"grid_pep_colaboradores"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_pep_idenficacion","name":"frm_pep_idenficacion","label":"Identificaci\u00f3n","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Identificaci\u00f3n"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_pep_primer_nombre","name":"frm_pep_primer_nombre","label":"Primer Nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"50","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Primer Nombre"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_pep_segundo_nombre","name":"frm_pep_segundo_nombre","label":"Segundo Nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Segundo Nombre"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_pep_apellido_paterno","name":"frm_pep_apellido_paterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"200","width":100,"title":"Apellido Paterno"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_pep_apellido_materno","name":"frm_pep_apellido_materno","label":"Ap