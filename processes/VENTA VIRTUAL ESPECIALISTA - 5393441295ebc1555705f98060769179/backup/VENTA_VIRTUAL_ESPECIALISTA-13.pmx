        @@html_decision_notificacion = $html_decision_notificacion;    
        @@envio_mail_ejec = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array());            
    }
}
]]></tri_webbot>
