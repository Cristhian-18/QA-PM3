Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8954395475fc006aa685e28033118714","var_name_old":"frm_deposito_fecha","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"1426929905fa1f1580c1270096941231","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_deposito_comprobante","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1426929905fa1f1580c1270096941231","var_name_old":"frm_deposito_comprobante","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"8927076765fa204988e0707073358860","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_banco_ccontable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8927076765fa204988e0707073358860","var_name_old":"frm_banco_ccontable","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"960023509606f2710554720003512129","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_numero_lote","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"960023509606f2710554720003512129","var_name_old":"frm_provisional_numero_lote","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"311506056606f271dea0423094103486","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_numero_autorizacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var