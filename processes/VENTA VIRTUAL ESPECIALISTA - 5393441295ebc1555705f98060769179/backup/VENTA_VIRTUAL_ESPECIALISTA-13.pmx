 DESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE  COD_CATALOGO = 'tconducto_tarjeta' \nAND ESTADO = 1 \nAND PRO_UID = '5393441295ebc1555705f98060769179' \nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_tipo_tarjeta","colSpan":6},{"type":"datetime","variable":"frm_fecha_caducidad_tarjeta","var_uid":"8270874955ee96871515102061398508","dataType":"datetime","protectedValue":false,"id":"frm_fecha_caducidad_tarjeta","name":"frm_fecha_caducidad_tarjeta","label":"Fecha de Caducidad(MM/AAAA))","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"MM/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"@@fecha_actual","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"@@fecha_actual","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_caducidad_tarjeta","colSpan":6}],[{"type":"text","variable":"frm_numero_tarjeta","var_uid":"2703631985e7e9a7eea1d46084172309","dataType":"string","protectedValue":false,"id":"frm_numero_tarjeta","name":"frm_numero_tarjeta","label":"#Tarjeta","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"","maxLength":"16","form