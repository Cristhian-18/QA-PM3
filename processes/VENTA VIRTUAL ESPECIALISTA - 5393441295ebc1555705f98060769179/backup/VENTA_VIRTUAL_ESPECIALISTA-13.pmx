,"id":"frm_polemi_resultado","name":"frm_polemi_resultado","label":"Resultado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Resultado"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_polemi_obs","name":"frm_polemi_obs","label":"Observacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"40","width":100,"title":"Observacion"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"152115123669f147b37c384027382274","prj_uid":"5393441295ebc1555705f98060769179","var_name":"grd_politicas_emision","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"25830987060590cf686aa76067215111","name":"subform resumen de solicitud","description":"","mode":"edit","script":{"type":"js","code":"var prod =$(\"#frm_producto\").getValue(); \n//alert (prod);\n\n$('#frm_aps_codigo_tipoAgente').hide();\n\n\n\ncalcular_edad();\nfunction calcular_edad() {\n\n  var fecha = $('#frm_fecha_nacimiento').getValue();\n  //alert (fecha);\n  var hoy = new Date();\n\n  var fechaNacimiento = new Date(fecha);\n  fechaNacimiento.setDate(fechaNacimiento.getDate() + 1);\n  //  alert (hoy);  \n  //  alert (fechaNacimiento);\n  var edad = hoy.getFullYear() - fechaNacimiento.getFullYear();\n  var diferenciaMeses = hoy.getMonth() - fechaNacimiento.getMonth();\n  var diferenciaDias = hoy.getDay() - fechaNacimiento.getDay();\n\n  if (\n    diferenciaMeses < 0 || (diferenciaMeses === 0 && hoy.getDate() < fechaNacimiento.getDate())\n  ) {\n    edad--\n  }\n  //alert (edad);\n  $(\"#frm_cliente_edad\").setValue(edad);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"etCliente","label":"<h5 style=\"color:#1C9DD9;\"><b>Datos del Candidato a Asegurado</b></h5><hr>","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"1376701895ec43528bf9be0095386762","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Numero de identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9a-zA-Z]*$","validateMessage":"","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_identificacion","colSpan":6}],[{"type":"text","variable":"tri_CodAseg_SISE","var_uid":"858843559669f17394c81a3074008420","dataType":"string","protectedValue":false,"id":"tri_CodAseg_SISE","name":"tri_CodAseg_SISE","label":"Codigo Asegurado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"tri_CodAseg_SISE","colSpan":6},{"type":"hidden","variable":"frm_fecha_nacimiento","var_uid":"8085954315ec43529b5f970038530666","dataType":"datetime","protectedValue":false,"id":"frm_fecha_nacimiento","name":"frm_fecha_nacimiento","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_fecha_nacimiento","colSpan":6}],[{"type":"text","variable":"frm_nombres_completos","var_uid":"7728182605f88e319956a76009637431","dataType":"string","protectedValue":false,"id":"frm_nombres_completos","name":"frm_nombres_completos","label":"Nombre completo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_nombres_completos","colSpan":6},{"type":"dropdown","variable":"frm_estado_civil","var_uid":"4938512885ec4352a192960050708231