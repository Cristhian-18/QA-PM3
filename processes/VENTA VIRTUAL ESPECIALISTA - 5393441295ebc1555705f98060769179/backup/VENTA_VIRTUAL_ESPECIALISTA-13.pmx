    "ServerPM"=>@@server_pm,
    "username"=>@@dana_pagador_usr,
    "password"=>@@dana_pagador_pwd,
    "Index_Tarea"=>(int)@@INDEX + 2
);

$url = $conversation_url;

@@tmp_dj_aurl = $url;
//$usr=$usuario.":".$clave;

$data= json_encode($data);
