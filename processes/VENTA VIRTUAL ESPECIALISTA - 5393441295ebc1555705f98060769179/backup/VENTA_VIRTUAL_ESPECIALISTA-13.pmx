var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"9131720755f2b61d4c1ffe3079023787","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"submit","id":"btn_confirmar_autorizacion_submit","name":"btn_confirmar_autorizacion_submit","label":"Grabar y Continuar","tabIndex":"","ariaLabel":"","colSpan":6},{"type":"button","id":"btn_confirmar_autorizacion_save","name":"btn_confirmar_autorizacion_save","label":"GRABAR","tabIndex":"","ariaLabel":"","colSpan":6}]],"variables":[]}]}]]></dyn_content>
