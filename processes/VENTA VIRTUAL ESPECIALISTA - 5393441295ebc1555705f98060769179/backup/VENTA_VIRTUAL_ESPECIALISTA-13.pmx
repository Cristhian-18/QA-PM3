!= ''){\n  \t$('#frm_provincia').disableValidation();\n    $('#frm_canton').disableValidation();\n    $('#frm_provincia').hide();\n    $('#frm_canton').hide();\n    $('#frm_provincia_auxiliar').show();\n    $('#frm_canton_auxiliar').show();\n  }else{\n    $('#frm_provincia').enableValidation();\n    $('#frm_canton').enableValidation();\n    $('#frm_provincia').show();\n    $('#frm_canton').show();  \n    $('#frm_provincia_auxiliar').hide();\n    $('#frm_canton_auxiliar').hide();\n  }\n}\n\n$(document).ready ( function(){\n\t\n\t//$('#frm_canton_auxiliar').hide();\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(false, 'frm_provincia', 'frm_canton');\n\t}\n  domicilio_val($(\"#frm_pais\").getValue(), 0);\n});\n\n$('#frm_provincia').on('change', function() {\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(true, 'frm_provincia', 'frm_canton');\n\t}\n});\n\n\n$(\"#frm_convencional\").hide();\n$('#frm_convencional').disableValidation();\n$('#frm_pais').setOnchange(domicilio_val);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_pais","var_uid":"38225710665180fe110a0b1074570243","dataType":"string","protectedValue":false,"id":"frm_pais","name":"frm_pais","label":"País","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"}],"var_name":"frm_pais","colSpan":4},{"type":"dropdown","variable":"frm_provincia","var_uid":"8284902755ec435498f16d3056661980","dataType":"string","protectedValue":false,"id":"frm_provincia","name":"frm_provincia","