79","var_name":"grd_beneficiario","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5245376775ed6b14e8b1931034199609","var_name_old":"grd_beneficiario","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"2323133585ec4a3969c6c93083250348","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_plan_total_beneficiarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2323133585ec4a3969c6c93083250348","var_name_old":"frm_plan_total_beneficiarios","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"2073920065ec4a6cc3c10c9078045634","prj_uid":"5393441295ebc1555705f98060769179","var_name":"grid_beneficiarios_contingentes","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2073920065ec4a6cc3c10c9078045634","var_name_old":"grid_beneficiarios_contingentes","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"3224805585ec4ab11461391031544773","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_plan_total_beneficiarios_contingentes","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3224805585ec4ab11461391031544773","var_name_old":"frm_plan_total_beneficiarios_contingentes","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}],"colSpan":12}],[{"type":"subtitle","id":"subtit_pagador","label":"<span class=\"subtitulo\" id=\"isubtit_pagador\" subform=\"8639320456010cbab579823088697264\"> <i class=\"glyphicon glyphicon-minus\"></i> DATOS DEL PAGADOR</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8639320456010cbab579823088697264","name":"subform datos pagador","description":"","mode":"edit","script":{"type":"js","code":"\n$(\"#frm_cedula_pagador\").focusout(function(){\n  var bool = validarIdentificacion($('#frm_cedula_pagador ').getValue(), $('#frm_tipo_identificacion_pagador').getControl().val());\n  if(bool == false){\n    $('#frm_cedula_pagador ').setValue(\"\");\n    alert(\"Numero de identificacion incorrecta\")\n\n  }\n\n});\n\n\n/*\nfunction validarIdentificacion(identificacion, tipoIdentificacion){\n  numero = identificacion;\n  if(tipoIdentificacion == ''){\n    alert(\"Ingrese el tipo de identificacion\");\n    return false;\n  }\n  if(tipoIdentificacion=='R'){\n    if (numero.length != 13) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n\n  var bandera = true;\n\n  if(tipoIdentificacion == 'C'){\n    if (numero.length != 10) {\n      //  alert(\"La identificacion no tiene diez digitos\");\n      identificacion.value = '';\n      bandera = false;\n      return false;\n    }\n  }\n\n  if (bandera){\n    digitos = numero.split(\"\");\n    totdigitos = 10;\n    total = 0;\n    digito = (digitos[9]*1);\n\n    for( i=0; i < (totdigitos-1); i++ ){\n      mult = 0;\n      if ( ( i%2 ) != 0 ) {\n        total = total + ( digitos[i] * 1 );\n      }else{\n        mult = digitos[i] * 2;\n        if ( mult > 9 )\n          total = total + ( mult - 9 );\n        else\n          total = total + mult;\n      }\n    }\n\n    //comprobando codigo verificador\n    decena = total / 10;\n    decena = Math.floor( decena );\n    decena = (decena + 1) * 10;\n    final = (decena-total);\n\n    if ((final == 10 && digito == 0) || (final == digito)){     \n      //alert(\"Cedula valida\");\n      return true;\n    }else{\n      //Validar pasaporte\n      if(tipoIdentificacion == 'P' && numero.length <= 30){\n        return true;\n      }\t\t\n      if(tipoIdentificacion == 'P' && numero.length > 30){\n        alert(\"En un pasaporte se permite maximo 30 caracteres \");\n        return false;\n      } else {\n        // alert(\"Identificacion no valida\");\n        identificacion.value = '';\n        return false;\n      }\n    }\n  }\n}*/\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion_pagador","var_uid":"7804832955eea3b5a2c92c7018698875","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion_pagador","name":"frm_tipo_identificacion_pagador","label":"Tipo ID","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion_pagador","colSpan":6},{"type":"text","variable":"frm_cedula_pagador","var_uid":"6356009165ebc18bc793f53046319014","dataType":"string","protectedValue":false,"id":"frm_cedula_pagador","name":"frm_cedula_pagador","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_ -]*$","validateMessage":"No se aceptan caracteres especiales","maxLength":"30","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cedula_pagador","colSpan":6}],[{"type":"text","variable":"frm_nombre_pagador","var_uid":"8805191105ebc18bc94fdc5085388163","dataType":"string","protectedValue":false,"id":"frm_nombre_pagador","name":"frm_nombre_pagador","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato incorrecto","maxLength":"50","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_nombre_pagador","colSpan":6},{"type":"text","variable":"frm_apellidos_pagador","var_uid":"7325486075ebc18bcacd946060018468","dataType":"string","protectedValue":false,"id":"frm_apellidos_pagador","name":"frm_apellidos_pagador","label":"Apellidos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato incorrecto","maxLength":"50","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_apellidos_pagador","colSpan":6}],[{"type":"dropdown","variable":"frm_parentesco","var_uid":"2849415965ec195bc496ac2065401476","dataType":"string","protectedValue":false,"id":"frm_parentesco","name":"frm_parentesco","label":"Parentesco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PARENTESCO' AND CODIGO IN (1,2,3,4,5,6,15,22) AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_parentesco","colSpan":6},{"type":"dropdown","variable":"ajx_eqfx_pagador_tipo","var_uid":"3399281636019d62f08aac5084033066","dataType":"string","protectedValue":false,"id":"ajx_eqfx_pagador_tipo","name":"ajx_eqfx_pagador_tipo","label":"Score","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"A","label":"Cliente perfil +"},{"value":"B","label":"Cliente perfil -"},{"value":"C","label":"Cliente con potencial"},{"value":"D","label":"Suspenso"},{"value":"E","label":"Cliente no perfil"}],"var_name":"ajx_eqfx_pagador_tipo","colSpan":6}],[{"type":"panel","id":"pnl_pagador","content":"<div id=\"mensaje_pagador\" class=\"tituloCliente\">.</div>","border":"1px","colSpan":12}]],"variables":[{"var_uid":"7804832955eea3b5a2c92c7018698875","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_tipo_identificacion_pagador","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_name_old":"frm_tipo_identificacion_pagador","var_uid_old":"7804832955eea3b5a2c92c7018698875","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"6356009165ebc18bc793f53046319014","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cedula_pagador","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_de