ll":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6752081916457cd8c6fbdd2089545448","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_referencia","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3049408636457cd999eee63094080822","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_valor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2151044936457cdac1e8f47067053681","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_cobranza_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"submit","id":"btn_continuar","name":"btn_continuar","label":"Continuar","tabIndex":"","ariaLabel":"","colSpan":6},{"type":"button","id":"btn_emision_save","name":"btn_emision_save","label":"Grabar","tabIndex":"","ariaLabel":"","colSpan":6}]],"variables":[{"var_uid":"8695538626457cb16edea24095960853","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_numero_poliza","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8695538626457cb16edea24095960853","var_name_old":"frm_numero_poliza","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"9916169056697dd96cbd536009797808","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_n