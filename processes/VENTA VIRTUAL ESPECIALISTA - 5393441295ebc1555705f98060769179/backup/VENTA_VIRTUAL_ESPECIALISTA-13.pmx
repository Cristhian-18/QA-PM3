        <dyn_content><![CDATA[{"name":"sub form direccion juridica","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"5223278435edd94634bde25020562146","name":"sub form direccion juridica","description":"","mode":"edit","script":{"type":"js","code":"if(typeof validarExpresionRegular === 'function') {\n\tvalidarExpresionRegular(\"frm_juridica_barrio\", 2);\n\tvalidarExpresionRegular(\"frm_juridica_calle_principal\", 2);\n\tvalidarExpresionRegular(\"frm_juridica_numero\", 3);\n\tvalidarExpresionRegular(\"frm_juridica_calle_transversal\", 2);\n\tvalidarExpresionRegular(\"frm_juridica_conjunto_edificio\", 2);\n\tvalidarExpresionRegular(\"frm_juridica_departamento_casa\", 2)\n}\n\n$(document).ready ( function(){\n\t\n\t$('#frm_canton_auxiliar').hide();\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(false, 'frm_juridica_provincia', 'frm_juridica_canton');\n\t}\n});\n\n$('#frm_juridica_provincia').on('change', function() {\n\tif(typeof canton_2 === 'function') {\n\t\tcanton_2(true, 'frm_juridica_provincia', 'frm_juridica_canton');\n\t}\t\n});\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_juridica_provincia","var_uid":"1518464155edd94a37582e5079331965","dataType":"string","protectedValue":false,"id":"frm_juridica_provincia","name":"frm_juridica_provincia","label":"Provincia","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='PROVINCIAS' AND ESTADO=1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_juridica_provincia","colSpan":6},{"type":"dropdown","variable":"frm_juridica_canton","var_uid":"7323010555edd94b69c4a80025936728","dataType":"string","protectedValue":false,"id":"frm_juridica_canton","name":"frm_juridica_canton","label":"Canton","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='CANTONES' AND ESTADO=1 AND VALOR=@@frm_juridica_provincia\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_juridica_canton","colSpan":6}],[{"type":"text","variable":"frm_canton_auxiliar","var_uid":"4052943965ec43549cfe5d1085303076","dataType":"string","protectedValue":false,"id":"frm_canton_auxiliar","name":"frm_canton_auxiliar","label":"frm_canton_auxiliar","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"2000","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_canton_auxiliar","colSpan":12}],[{"type":"text","variable":"frm_juridica_barrio","var_uid":"1360290475edd94cd3e7737031742491","dataType":"string","protectedValue":false,"id":"frm_juridica_barrio","name":"frm_juridica_barrio","label":"Barrio","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"titleCase","validate":"","validateMessage":"","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_juridica_barrio","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_juridica_calle_principal","var_uid":"8254824275edd94e648cca4082870816","dataType":"string","protectedValue":false,"id":"frm_juridica_calle_principal","name":"frm_juridica_calle_principal","label":"Calle principal","defaultValue":"","placeholder":"","