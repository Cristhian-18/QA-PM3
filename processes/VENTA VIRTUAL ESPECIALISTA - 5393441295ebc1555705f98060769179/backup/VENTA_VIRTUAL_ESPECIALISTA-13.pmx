arios\").getValue();\n$(\"#comentarios\").html(comm); \n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"panel_comentario","content":"<div id=\"comentarios\"></div>","border":"1px","colSpan":12}],[{"colSpan":2},{"colSpan":2},{"type":"hidden","variable":"tri_comentarios","var_uid":"1308114045ec43c341dbf91082909342","dataType":"string","protectedValue":false,"id":"tri_comentarios","name":"tri_comentarios","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_comentarios","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"1308114045ec43c341dbf91082909342","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_comentarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5608579545e829ed522fed0018096998","var_name_old":"tri_comentarios","prj_uid_old":"3685317655e829ed34bce43075006773","create":false}],"colSpan":12}],[{"type":"subtitle","id":"subtit_datos","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_venta\" subform=\"25830987060590cf686aa76067215111\"> <i class=\"glyphicon glyphicon-minus\"></i> RESUMEN DE SOLICITUD</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"32832123863dc1b7ca05b77080881437","name":"SubForm Decision Magnum","description":"SubForm Decision Magnum","mode":"edit","script":{"type":"js","code":"var data = $(\"#html_decision_magnum\").getValue();\n$(\"#html_decision\").html(data);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_magnum","label":"<h5 style=\"color:#1C9DD9;\"><b>Datos Magnum</b></h5><hr>","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"correoEnviadoDesicionMagnum","var_uid":"25303306566be60d9da4628042436111","dataType":"string","protectedValue":false,"id":"correoEnviadoDesicionMagnum","name":"correoEnviadoDesicionMagnum","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"correoEnviadoDesicionMagnum","colSpan":12}],[{"type":"panel","id":"pnl_magnum","content":"<style>\n   @media print {\n        .noPrint{\n          display:none;\n        }\n      }\n      h1{\n        color:#f6f6;\n      }\n\t:root {\n\t   --magnum-color-default-1: #3e3e3e;\n\t   --magnum-color-default-2: #9c9c9c; /*rgb(3, 155, 227);*/\n\t   --magnum-color-default-3: #cbcbcb;\n\t   --magnum-color-default-4: #e7e7e7;\n\t   --magnum-color-default-5: #f3f3f3;\n\t   --magnum-color-default-6: #ffffff;\n\n\t   --magnum-color-invalid-1: #c61111;\n\t   --magnum-color-invalid-2: #fbd0d0;\n\t   --magnum-color-invalid-3: #fef1f1;\n\n\t   --magnum-color-primary-1: rgb(3, 155, 227);\n\t   --magnum-color-primary-2: #fbdac6;\n\t   --magnum-color-primary-3: rgb(201, 206, 208);\n\n\t   --magnum-color-valid-1: #00a52d;\n\t   --magnum-color-valid-2: #53c671;\n\t   --magnum-color-valid-3: #ebfaef;\n\n\t   --magnum-background-normal: var(--magnum-color-default-6);\n\n\t   --magnum-font-family: Source Sans Pro, Arial, sans-serf, serif;\n\t   --magnum-font-size-base: 16px;\n\n\t   --magnum-title-color-custom: #00965E;\n\t   --magnum-widget-background-active: var(--magnum-color-primary-3);\n\t   --magnum-widget-background-invalid: var(--magnum-color-invalid-3);\n\t   --magnum-widget-background-normal: var(--magnum-color-default-6);\n\t   --magnum-widget-border-active-default: inset 0 0 0 1px var(--magnum-color-primary-1);\n\t   --magnum-widget-border-active-focus: inset 0 0 0 1px var(--magnum-color-primary-1), inset 0 0 0 4px var(--magnum-color-primary-2);\n\t   --magnum-widget-border-active-focus-hover: inset 0 0 0 2px var(--magnum-color-primary-1), inset 0 0 0 4px var(--magnum-color-primary-2);\n\n\t   --magnum-widget-border-active-hover: inset 0 0 0 2px var(--magnum-color-primary-1);\n\t   --magnum-widget-border-invalid-default: inset 0 0 0 1px var(--magnum-color-invalid-1);\n\t   --magnum-widget-border-invalid-focus: inset 0 0 0 1px var(--magnum-color-invalid-1), inset 0 0 0 4px var(--magnum-color-invalid-2);\n\t   --magnum-widget-border-invalid-focus-hover: inset 0 0 0 2px var(--magnum-color-invalid-1), inset 0 0 0 4px var(--magnum-color-invalid-2);\n\t   --magnum-widget-border-invalid-hover: inset 0 0 0 2px var(--magnum-color-invalid-1);\n\n\t   --magnum-widget-border-normal-default: inset 0 0 0 1px var(--magnum-color-default-2);\n\t   --magnum-widget-border-normal-disabled: inset 0 0 0 1px var(--magnum-color-default-3);\n\t   --magnum-widget-border-normal-focus: inset 0 0 0 1px var(--magnum-color-default-2), inset 0 0 0 4px var(--magnum-color-default-4);\n\t   --magnum-widget-border-normal-focus-hover: inset 0 0 0 2px var(--magnum-color-default-2), inset 0 0 0 4px var(--magnum-color-default-4);\n\t   --magnum-widget-border-normal-hover: inset 0 0 0 2px var(--magnum-color-default-2);\n\n\t   --magnum-popup-box-shadow-default: 0 5px 15px var(--magnum-color-default-2);\n\n\t   --magnum-left-indent-step: 40px;\n\n\t   --magnum-icon-loading-default: url('https://bpmpreprod.equivida.tv/images/loader-gears.gif');\n\t}\n   button.magnum-summary-action__edit{\n    \tdisplay: none;\n    }\n\t</style>\n<!--<magnum-decision id=\"magnum-decision\"></magnum-decision>-->\n<div id=\"magnum-decision\">\n  <div class=\"col-md-12\">\n      <div class=\"card card-default\">\n          <div class=\"card-header\">\n              <h3 class=\"card-title text-center text-primary\">\n              <i class=\"fa fa-bullhorn\"></i>\n                  DECISION\n              </h3>\n          </div>\n          <div class=\"card-body\">\n              <div class=\"callout callout-info text-center\">\n                  <div id=\"html_decision\"></div>\n              </div>\n          </div>\n      </div>\n  </div>\n</div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"html_decision_magnum","var_uid":"60650237563bc519107fe05016977384","dataType":"string","protectedValue":false,"id":"html_decision_magnum","name":"html_decision_magnum","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"html_decision_magnum","colSpan":12}]],"variables":[{"var_uid":"25303306566be60d9da4628042436111","prj_uid":"5393441295ebc1555705f98060769179","var_name":"correoEnviadoDesicionMagnum","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"60650237563bc519107fe05016977384","prj_uid":"5393441295ebc1555705f98060769179","var_name":"html_decision_magnum","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"25830987060590cf686aa76067215111","name":"subform resumen de solicitud","description":"","mode":"disabled","script":{"type":"js","code":"var prod =$(\"#frm_producto\").getValue(); \n//alert (prod);\n\n$('#frm_aps_codigo_tipoAgente').hide();\n\n\n\ncalcular_edad();\nfunction calcular_edad() {\n\n  var fecha = $('#frm_fecha_nacimiento').getValue();\n  //alert (fecha);\n  var hoy = new Date();\n\n  var fechaNacimiento = new Date(fecha);\n  fechaNacimiento.setDate(fechaNacimiento.getDate() + 1);\n  //  alert (hoy);  \n  //  alert (fechaNacimiento);\n  var edad = hoy.getFullYear() - fechaNacimiento.getFullYear();\n  var diferenciaMeses = hoy.getMonth() - fechaNacimiento.getMonth();\n  var diferenciaDias = hoy.getDay() - fechaNacimiento.getDay();\n\n  if (\n    diferenciaMeses < 0 || (diferenciaMeses === 0 && hoy.getDate() < fechaNacimiento.getDate())\n  ) {\n    edad--\n  }\n  //alert (edad