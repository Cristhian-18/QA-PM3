ne","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_pep_especifique","colSpan":6}],[{"type":"label","id":"lbl_representante_pep","label":"Persona Politicamente Expuesta es quien desempe\u00f1a o ha desempe\u00f1ado funciones publicas destacadas en el pais o en el exterior; o tenga hasta el segundo grado de consanguinidad, primero de afinidad o que sea colaborador cercano de una persona pol\u00edticamente expuesta. Se considera PEP hasta despues de un a\u00f1o de haber cesado en sus funciones. En caso afirmativo, llenar Formulario PEP.","colSpan":12}]],"variables":[{"var_uid":"5612826715edd97be96abe4080515068","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_representante_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3291712415edd97ffaa17e5043537889","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_representante_numero_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2732534485edd9819309016001520100","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_representante_apellido_paterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3383097575edd9826790fa4042162909","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_representante_apellido_materno","var_field_type":"string","var_field_size":10,