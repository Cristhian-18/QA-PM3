        <dyn_content><![CDATA[{"name":"sub form juridica representante","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8138944845edd97555ba081001649445","name":"sub form juridica representante","description":"","mode":"edit","script":{"type":"js","code":"if (typeof validarExpresionRegular === 'function') {\n    validarExpresionRegular(\"frm_representante_apellido_paterno\", 1);\n    validarExpresionRegular(\"frm_representante_apellido_materno\", 1);\n    validarExpresionRegular(\"frm_representante_primer_nombre\", 1);\n    validarExpresionRegular(\"frm_representante_segundo_nombre\", 1);\n}\n\n\n$('#frm_representante_nacionalidad').setValue(56);\n\n\nif ($('#frm_representante_numero_identificacion').getValue().length == 10) {\/\/para cuando ya trae la cedula de la T1\n    $('#frm_representante_tipo_identificacion').setValue('C');\n} else if ($('#frm_representante_numero_identificacion').getValue().length != \"\") {\/\/para cuando ya trae pasaporte de la T1\n    $('#frm_representante_tipo_identificacion').setValue('P');\n} else {\n    $('#frm_representante_tipo_identificacion').setValue('');\n}\n\n$(\"#frm_representante_tipo_identificacion\").change(function () {\n    if ($(\"#frm_representante_tipo_identificacion option:selected\").val() == 'P') {\n       \/\/ $(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").parent().parent().show(\"slow\");\n    }\n    else {\n       \/\/ $(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").parent().parent().hide(\"slow\");\n    }\n\n    $('#frm_representante_numero_identificacion').setValue(\"\");\n});\n\n\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_representante_numero_identificacion\").focusout(function () {\n    if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificacion($('#frm_representante_numero_identificacion').getValue(), $('#frm_representante_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_numero_identificacion').setValue(\"\");\n        }\n    }\n});\n\n$(\"#frm_representante_conyuge_numero_identificacion\").focusout(function () {\n    if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificacion($('#frm_representante_conyuge_numero_identificacion').getValue(), $('#frm_representante_conyuge_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_representante_conyuge_numero_identificacion').setValue(\"\");\n        }\n    }\n});\n\n\/\/ Validar que no podria tener menos de 18 anios cumplidos o mas de 69 anios cumplidos\n$(\"#frm_fecha_nacimiento\").setOnchange(function () {\n    var fechaNacimiento = $(\"#frm_representante_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad < 69) {\n        $(\"#frm_representante_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_representante_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_representante_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_representante_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_representante_fecha_nacimiento').setValue('');\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    \/\/Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n\n\n\/\/Sumar un dia a fecha actual\nvar d = new Date();\nvar otraFecha = d.setDate(d.getDate() + 1);\nd = new Date(otraFecha);\nvar month = d.getMonth() + 1;\nvar day = d.getDate();\n\nvar fechaMasUnDia = (month < 10 ? '0' : '') + month + '\/' +\n    (day < 10 ? '0' : '') + day + '\/' +\n    d.getFullYear()\n\n\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_representante_tipo_identificacion","var_uid":"5612826715edd97be96abe4080515068","dataType":"string","protectedValue":false,"id":"frm_representante_tipo_identificacion","name":"frm_representante_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_representante_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_representante_numero_identificacion","var_uid":"3291712415edd97ffaa17e5043537889","dataType":"string","protectedValue":false,"id":"frm_representante_numero_identificacion","name":"frm_representante_numero_identificacion","label":"Numero de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9a-zA-Z]*$","validateMessage":"","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_representante_apellido_paterno","var_uid":"2732534485edd9819309016001520100","dataType":"string","protectedValue":false,"id":"frm_representante_apellido_paterno","name":"frm_representante_apellido_paterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_apellido_paterno","colSpan":6},{"type":"text","variable":"frm_representante_apellido_materno","var_uid":"3383097575edd9826790fa4042162909","dataType":"string","protectedValue":false,"id":"frm_representante_apellido_materno","name":"frm_representante_apellido_materno","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_apellido_materno","colSpan":6}],[{"type":"text","variable":"frm_representante_primer_nombre","var_uid":"8659084565edd9839583751069968125","dataType":"string","protectedValue":false,"id":"frm_representante_primer_nombre","name":"frm_representante_primer_nombre","label":"Primer nombre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_primer_nombre","colSpan":6},{"type":"text","variable":"frm_representante_segundo_nombre","var_uid":"3931174745edd9847b85575069297800","dataType":"string","protectedValue":false,"id":"frm_representante_segundo_nombre","name":"frm_representante_segundo_nombre","label":"Segundo nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_representante_segundo_nombre","colSpan":6}],[{"type":"dropdown","variable":"frm_representante_ciudad_nacimiento","var_uid":"9562102305edd98de309e64002702886","dataType":"string","protectedValue":false,"id":"frm_representante_ciudad_nacimiento","name":"frm_representante_ciudad_nacimiento","label":"Ciudad de Nacimiento","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'CIUDADES' AND ESTADO = 1  ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_representante_ciudad_nacimiento","colSpan":6},{"type":"datetime","variable":"frm_representante_fecha_nacimiento","var_uid":"5046212725edd98f9173eb5083844205","dataType":"datetime","protectedValue":false,"id":"frm_representante_fecha_nacimiento","name":"frm_representante_fecha_nacimiento","label":"Fecha de Nacimiento","placeholder":"DD\/MM\/YYYY","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"DD\/MM\/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_representante_fecha_nacimiento","colSpan":6}],[{"type":"dropdown","variable":"frm_representante_nacionalidad","var_uid":"2979280485edd990b531831096000967","dataType":"string","protectedValue":false,"id":"frm_representante_nacionalidad","name":"frm_representante_nacionalidad","label":"Nacionalidad","defaultValue":"56","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_representante_nacionalidad","colSpan":6},{"type":"dropdown","variable":"frm_representante_estado_civil","var_uid":"5579783905edd9919c659c9005933990","dataType":"string","protectedValue":false,"id":"frm_representante_estado_civil","name":"frm_representante_estado_civil","label":"Estado Civil","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'ESTADO_CIVIL' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_representante_estado_civil","colSpan":6}],[{"type":"text","variable":"frm_representante_telefono","var_uid":"2442681615edd9ac27817b6071173047","dataType":"string","protectedValue":false,"id":"frm_representante_telefono","name":"frm_representante_telefono","label":"Telefono","defaultValue"