action__edit{\n    \tdisplay: none;\n    }\n\t<\/style>\n<!--<magnum-decision id=\"magnum-decision\"><\/magnum-decision>-->\n<div id=\"magnum-decision\">\n  <div class=\"col-md-12\">\n      <div class=\"card card-default\">\n          <div class=\"card-header\">\n              <h3 class=\"card-title text-center text-primary\">\n              <i class=\"fa fa-bullhorn\"><\/i>\n                  DECISI\u00d3N\n              <\/h3>\n          <\/div>\n          <div class=\"card-body\">\n              <div class=\"callout callout-info text-center\">\n                  <div id=\"html_decision\"><\/div>\n              <\/div>\n          <\/div>\n      <\/div>\n  <\/div>\n<\/div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"html_decision_magnum","var_uid":"60650237563bc519107fe05016977384","dataType":"string","protectedValue":false,"id":"html_decision_magnum","name":"html_decision_magnum","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"html_decision_magnum","colSpan":12}]],"variables":[{"var_uid":"25303306566be60d9da4628042436111","prj_uid":"5393441295ebc1555705f98060769179","var_name":"correoEnviadoDesicionMagnum","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"60650237563bc519107fe05016977384","prj_uid":"5393441295ebc1555705f98060769179","var_name":"html_decision_magnum","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"25830987060590cf686aa76067215111","name":"subform resumen de solicitud","description":"","mode":"edit","script":{"type":"js","code":"var prod =$(\"#frm_producto\").getValue(); \n\/\/alert (prod);\n\n$('#frm_aps_codigo_tipoAgente').hide();\n\n\n\ncalcular_edad();\nfunction calcular_edad() {\n\n  var fecha = $('#frm_fecha_nacimiento').getValue();\n  \/\/alert (fecha);\n  var hoy = new Date();\n\n  var fechaNacimiento = new Date(fecha);\n  fechaNacimiento.setDate(fechaNacimiento.getDate() + 1);\n  \/\/  alert (hoy);  \n  \/\/  alert (fechaNacimiento);\n  var edad = hoy.getFullYear() - fechaNacimiento.getFullYear();\n  var diferenciaMeses = hoy.getMonth() - fechaNacimiento.getMonth();\n  var diferenciaDias = hoy.getDay() - fechaNacimiento.getDay();\n\n  if (\n    diferenciaMeses < 0 || (diferenciaMeses === 0 && hoy.getDate() < fechaNacimiento.getDate())\n  ) {\n    edad--\n  }\n  \/\/alert (edad);\n  $(\"#frm_cliente_edad\").setValue(edad);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"etCliente","label":"<h5 style=\"color:#1C9DD9;\"><b>Datos del Candidato a Asegurado<\/b><\/h5><hr>","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"1376701895ec43528bf9be0095386762","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Numero de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","v