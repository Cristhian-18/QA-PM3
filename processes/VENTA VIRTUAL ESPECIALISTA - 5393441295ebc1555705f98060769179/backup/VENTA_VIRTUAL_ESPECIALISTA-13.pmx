        <dyn_content><![CDATA[{"name":"subform resumen solicitud para suscripcion","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"959142268608854903b3d40011117519","name":"subform resumen solicitud para suscripcion","description":"","mode":"edit","script":{"type":"js","code":"\n\/*\n$( function(){\n  var aux = $(\"#frm_recibio_deposito\").getControl().val();\n  if (aux == 'S'){\n    $(\"#frm_primera_cuota_medio_pago\").hide();   \n    $(\"#frm_deposito_medio\").show();   \n  }\n  else\n  {\n    $(\"#frm_primera_cuota_medio_pago\").show();   \n    $(\"#frm_deposito_medio\").hide();       \n  }\n})\n*\/\n\n\n\n$(function() {\n\nif(typeof calcular_edad === 'function') {\n\t\n\tvar fechaNacimiento = $(\"#frm_fecha_nacimiento\").getValue();\n\talert(fechaNacimiento);\n\t$(\"#frm_resumen_edad\").setValue(calcular_edad(fechaNacimiento));\n\t\n}\n\n});\n\n\n\n\n\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"etCliente","label":"<H5 style=\"background-color: #f5f5f5;\" ><b>DATOS PERSONALES<\/b><hr><\/H5>","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"2838629145ec43528a30698090876761","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"1376701895ec43528bf9be0095386762","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Numero de identificacion","def