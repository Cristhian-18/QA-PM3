        <dyn_content><![CDATA[{"name":"subform datos asegurado","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"2200289695ec4351a1bd6d3027166827","name":"subform datos asegurado","description":"","mode":"edit","script":{"type":"js","code":"validacionCedula();\n\n//Cuando seleccione opcion pasaporte, debera desplegar\n//Fecha de expedicion del pasaporte\t\tFecha de caducidad del pasaporte\n//Tipo de Visa\t\tFecha de ingreso al pais\n//$(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").parent().parent().hide();\n\n//if ($('#frm_numero_identificacion').getValue().length == 10) {//para cuando ya trae la cedula de la T1\n    //$('#frm_tipo_identificacion').setValue('C');\n//} else if ($('#frm_numero_identificacion').getValue().length != \"\") {//para cuando ya trae pasaporte de la T1\n    //$('#frm_tipo_identificacion').setValue('P');\n//} else {\n  //  $('#frm_tipo_identificacion').setValue('');\n//}\nfunction validacionCedula(){\n  var ced = $(\"#frm_tipo_identificacion\").getControl().val();\n  \n\t if (ced  == 'P') {\n        $(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").parent().parent().show(\"slow\");\n      \t$(\"#frm_fecha_expedicion_pasaporte\").enableValidation();\n        $(\"#frm_tipo_visa\").enableValidation();\n        $(\"#frm_fecha_ingreso_pais\").enableValidation();\n        $(\"#frm_fecha_caducidad_pasaporte\").enableValidation();\n    }\n    else {\n        $(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").parent().parent().hide(\"slow\");\n       $(\"#frm_fecha_expedicion_pasaporte, #frm_tipo_visa\").setValue('');\n      \t$(\"#frm_fecha_expedicion_pasaporte\").disableValidation();\n        $(\"#frm_tipo_visa\").disableValidation();\n      $(\"#frm_tipo_visa\").setValue('');\n        $(\"#frm_fecha_ingreso_pais\").disableValidation();\n        $(\"#frm_fecha_caducidad_pasaporte\").disableValidation();\n      $(\"#frm_fecha_ingreso_pais\").setValue('');\n        $(\"#frm_fecha_caducidad_pasaporte\").setValue('');\n    }\n}\n\n$(\"#frm_tipo_identificacion\").change(function () {\n   \n\tvalidacionCedula();\n    $('#frm_numero_identificacion').setValue(\"\");\n});\n\n//Validar cedula de identidad y pasaporte\n$(\"#frm_numero_identificacion\").focusout(function () {\n    if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificacion($('#frm_numero_identificacion').getValue(), $('#frm_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_numero_identificacion').setValue(\"\");\n        }\n    }\n});\n\n$(\"#frm_conyuge_numero_identificacion\").focusout(function () {\n    if (typeof validarIdentificacion === 'function') {\n        var bool = validarIdentificacion($('#frm_conyuge_numero_identificacion').getValue(), $('#frm_conyuge_tipo_identificacion').getControl().val());\n        if (bool == false) {\n            $('#frm_conyuge_numero_identificacion').setValue(\"\");\n        }\n    }\n});\n\n// Validar que no podria tener menos de 18 anios cumplidos o mas de 79 anios cumplidos\n$(\"#frm_fecha_nacimiento\").setOnchange(function () {\n    var fechaNacimiento = $(\"#frm_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad <=79) {\n        $(\"#frm_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_fecha_nacimiento').setValue('');\n\t\talert(\"Debe tener entre 18 y 79 anios\");\n\t\t\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    //Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n$(\"#frm_cliente_edad\").setValue(calcular_edad($(\"#frm_fecha_nacimiento\").getValue()));\n\n// Validar Numero de hijos\n$(\"#frm_numero_hijos\").focusout(function () {\n    var numeroHijos = $(\"#frm_numero_hijos\").getValue();\n\n    if (numeroHijos >= 0 && numeroHijos <= 10) {\n        $(this).getControl().css({ \"border\": \"\" })\n        $(this).find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(this).getControl().css({ \"border\": \"#E45061 solid 1px\" })\n        $(this).find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $(this).setValue('');\n        return false;\n    }\n});\n\n//Sumar un dia a fecha actual\nvar d = new Date();\nvar otraFecha = d.setDate(d.getDate() + 1);\nd = new Date(otraFecha);\nvar month = d.getMonth() + 1;\nvar day = d.getDate();\n\nvar fechaMasUnDia = (month < 10 ? '0' : '') + month + '/' +\n    (day < 10 ? '0' : '') + day + '/' +\n    d.getFullYear()\n/*\n// Validar Fecha de ingreso al pais\n$(\"#frm_fecha_ingreso_pais\").focusout(function () {\n    validarFechaExpedicionPasaporte('#frm_fecha_ingreso_pais', fechaMasUnDia, 1);\n});\n\n// Validar Fecha de expedicion del pasaporte\n$(\"#frm_fecha_expedicion_pasaporte, #frm_fecha_nacimiento\").focusout(function () {\n    validarFechaExpedicionPasaporte('#frm_fecha_expedicion_pasaporte', $('#frm_fecha_nacimiento').getValue(), 0);\n});\n\n// Validar Fecha de caducidad del pasaporte\n$(\"#frm_fecha_caducidad_pasaporte, #frm_fecha_expedicion_pasaporte\").focusout(function () {\n    validarFechaExpedicionPasaporte('#frm_fecha_caducidad_pasaporte', $('#frm_fecha_expedicion_pasaporte').getValue(), 0);\n});\n*/\n\n$(\"#frm_fecha_nacimiento, #frm_fecha_ingreso_pais, #frm_fecha_expedicion_pasaporte, #frm_fecha_caducidad_pasaporte\").focusout(function () {\n    \n\tvar nacimiento = $(\"#frm_fecha_nacimiento\").getValue();\n\tvar ingreso =  $(\"#frm_fecha_ingreso_pais\").getValue();\n\tvar expedicion =  $(\"#frm_fecha_expedicion_pasaporte\").getValue();\n\tvar caducidad =  $(\"#frm_fecha_caducidad_pasaporte\").getValue();\n\t\n\t// alert(nacimiento + \" --- \" + ingreso + \" --- \" + expedicion + \" --- \" + caducidad);\n\t\n\tid = $(this).getControl().attr(\"id\");\n\t// alert(id);\n\t\n\t// if(id == \"form[frm_fecha_nacimiento]\" && expedicion < nacimiento){\n\t\t\t// $(\"#frm_fecha_nacimiento\").setValue('');\n\t// }\n\t\n\tif(id == \"form[frm_fecha_ingreso_pais]\" && (expedicion > ingreso || nacimiento > ingreso)){\n\t\t$(\"#frm_fecha_ingreso_pais\").setValue('');\n\t}\n\n\t// if(id == \"form[frm_fecha_expedicion_pasaporte]\" && (expedicion > ingreso || expedicion > caducidad)){ \n\t\t// $(\"#frm_fecha_expedicion_pasaporte\").setValue('');\n\t// }\n\t\n\tif(ingreso != \"\"){\n\t\tif(id == \"form[frm_fecha_expedicion_pasaporte]\" && expedicion > ingreso){ \n\t\t\t$(\"#frm_fecha_expedicion_pasaporte\").setValue('');\n\t\t}\t\t\t\n\t}\n\t\n\tif(caducidad != \"\"){\n\t\tif(id == \"form[frm_fecha_expedicion_pasaporte]\" && expedicion >= caducidad){ \n\t\t\t$(\"#frm_fecha_expedicion_pasaporte\").setValue('');\n\t\t}\t\t\t\n\t}\n\t\n\tif(id == \"form[frm_fecha_caducidad_pasaporte]\" && expedicion >= caducidad){\n\t\t\t$(\"#frm_fecha_caducidad_pasaporte\").setValue('');\n\t}\n\t\n});\n\n\nfunction checkCountry(newVal, oldVal) {\n  if(newVal != ''){\n\t  $(\"#frm_nacionalidad\").setValue(newVal);\n  }\n  if (newVal == 56) {\n    $(\"#frm_ciudad_nacimiento\").show();\n    $(\"#frm_ciudad_nacimiento_otro\").hide();\n  } else {\n    $(\"#frm_ciudad_nacimiento\").hide();\n    $(\"#frm_ciudad_nacimiento_otro\").show();\n  }\n}\n//execute when the Dynaform loads:\nif ($(\"#frm_pais_nacimiento\").getValue() != '') {\n  checkCountry($(\"#frm_pais_nacimiento\").getValue(), '');\n} else {\n  $(\"#frm_ciudad_nacimiento\").hide();\n  $(\"#frm_ciudad_nacimiento_otro\").hide();\n}\n//execute when field's value changes:\n$('#frm_pais_nacimiento').setOnchange(checkCountry);\n\n//CAMBIAR DIRECTO LA NACIONALIDAD\n$('#frm_pais_nacimiento').setOnchange(checkCountry);\n\n\n\n\n\n\n\n\n\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_identificacion","var_uid":"3631350015e829ed51bac93001647259","dataType":"string","protectedValue":false,"id":"frm_tipo_identificacion","name":"frm_tipo_identificacion","label":"Tipo de identificación","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione una opcion"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_numero_identificacion","var_uid":"6695089515e829ed51c9995051101725","dataType":"string","protectedValue":false,"id":"frm_numero_identificacion","name":"frm_numero_identificacion","label":"Número de identificación","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"","maxLength":"30","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_apellido_paterno","var_uid":"6663904455e829ed5236922089000242","dataType":"string","protectedValue":false,"id":"frm_apellido_paterno","name":"frm_apellido_paterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-\\sÑñ]*$","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_apellido_paterno","colSpan":6},{"type":"text","variable":"frm_apellido_materno","var_uid":"5537661105e829ed51eb9b5095670724","dataType":"string","protectedValue":false,"id":"frm_apellido_materno","name":"frm_apellido_materno","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-\\sÑñ]*$","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_apellido_materno","colSpan":6}],[{"type":"text","variable":"frm_primer_nombre","var_uid":"1097060605e829ed51905d8016923541","dataType":"string","protectedValue":false,"id":"frm_primer_nombre","name":"frm_primer_nombre","label":"Primer nombre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-\\sÑñ]*$","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_primer_nombre","colSpan":6},{"type":"text","variable":"frm_segundo_nombre","var_uid":"3983519925e829ed51c4944036034123","dataType":"string","protectedValue":false,"id":"frm_segundo_nombre","name":"frm_segundo_nombre","label":"Segundo nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-Z0-9_-\\sÑñ]*$","validateMessage":"Formato invalido","maxLength":"32","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_segundo_nombre","colSpan":6}],[{"type":"datetime","variable":"frm_fecha_expedicion_pasaporte","var_uid":"2812082575e829ed51cb3f5006307090","dataType":"datetime","protectedValue":false,"id":"frm_fecha_expedicion_pasaporte","name":"frm_fecha_expedicion_pasaporte","label":"Fecha de expedicion del pasaporte","placeholder":"DD/MM/YYYY","hint":"Fecha de expedicion del pasaporte debe ser mayor a la fecha de nacimiento\n","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"DD/MM/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"@@frm_fecha_actual","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_expedicion_pasaporte","colSpan":6},{"type":"datetime","variable":"frm_fecha_caducidad_pasaporte","var_uid":"5714019125e829ed523eb23042403435","dataType":"datetime","protectedValue":false,"id":"frm_fecha_caducidad_pasaporte","name":"frm_fecha_caducidad_pasaporte","label":"Fecha de caducidad del pasaporte","placeholder":"DD/MM/YYYY","hint":"La fecha de caducidad debe ser mayor a la fecha actual","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"DD/MM/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"@@fecha_manana","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"@@fecha_vacio","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_caducidad_pasaporte","colSpan":6}],[{"type":"dropdown","variable":"frm_tipo_visa","var_uid":"8787119995e829ed5205325033360048","dataType":"string","protectedValue":false,"id":"frm_tipo_visa","name":"frm_tipo_visa","label":"Tipo de Visa","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='TIPO_VISA' AND ESTADO=1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_tipo_visa","colSpan":6},{"type":"datetime","variable":"frm_fecha_ingreso_pais","var_uid":"4409279795e829ed5189c37092700585","dataType":"datetime","protectedValue":false,"id":"frm_fecha_ingreso_pais","name":"frm_fecha_ingreso_pais","label":"Fecha de ingreso al pais","placeholder":"DD/MM/YYYY","hint":"La fecha de ingreso al pais no puede ser mayor a la fecha de registro del formulario","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"DD/MM/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"@@frm_fecha_actual","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_ingreso_pais","colSpan":6}],[{"type":"dropdown","variable":"frm_pais_nacimiento","var_uid":"4294448665e829ed522ae94026994181","dataType":"string","protectedValue":false,"id":"frm_pais_nacimiento","name":"frm_pais_nacimiento","label":"País de nacimiento","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_pais_nacimiento","colSpan":4},{"type":"dropdown","variable":"frm_nacionalidad","var_uid":"7159195915ec43529d25576078055974","dataType":"string","protectedValue":false,"id":"frm_nacionalidad","name":"frm_nacionalidad","label":"Nacionalidad","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PAISES' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_nacionalidad","colSpan":4},{"type":"dropdown","variable":"frm_ciudad_nacimiento","var_uid":"2139828205ec4352998e4f4042010479","dataType":"string","protectedValue":false,"id":"frm_ciudad_nacimiento","name":"frm_ciudad_nacimiento","label":"Lugar de nacimiento","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PROVINCIAS' AND VALOR = '@#frm_pais_nacimiento' AND ESTADO = 1 ORDER BY DESCRIPCION\n/*SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'CANTONES' AND ESTADO = 1 ORDER BY DESCRIPCION*/","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_ciudad_nacimiento","colSpan":4}],[{"type":"text","variable":"frm_ciudad_nacimiento_otro","var_uid":"30252186465180b6c13e9d5057200758","dataType":"string","protectedValue":false,"id":"frm_ciudad_nacimiento_otro","name":"frm_ciudad_nacimiento_otro","label":"Lugar de Nacimiento","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_ciudad_nacimiento_otro","colSpan":12}],[{"type":"dropdown","variable":"frm_estado_civil","var_uid":"5187577455e829ed51e6930061871173","dataType":"string","protectedValue":false,"id":"frm_estado_civil","name":"frm_estado_civil","label":"Estado Civil","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'ESTADO_CIVIL' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_estado_civil","colSpan":6},{"type":"text","variable":"frm_numero_hijos","var_uid":"2292871175e829ed5193916004375304","dataType":"string","protectedValue":false,"id":"frm_numero_hijos","name":"frm_numero_hijos","label":"Número de hijos","defaultValue":"0","placeholder":"","hint":"Solo admite numeros enteros, entre 0 y 10","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":"2","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_hijos","colSpan":6}],[{"type":"datetime","variable":"frm_fecha_nacimiento","var_uid":"2881036205e829ed51b3e11034048636","dataType":"datetime","protectedValue":false,"id":"frm_fecha_nacimiento","name":"frm_fecha_nacimiento","label":"Fecha de nacimiento","placeholder":"DD/MM/YYYY","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","format":"DD/MM/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"1920-09-02","maxDate":"@@frm_fecha_actual","useCurrent":"false","collapse":true,"locale":"","defaultDate":"1920-09-02","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"years","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_nacimiento","colSpan":6},{"type":"text","variable":"frm_cliente_edad","var_uid":"8715560725f976349ba6795076969270","dataType":"string","protectedValue":false,"id":"frm_cliente_edad","name":"frm_cliente_edad","label":"Edad Actual","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_edad","colSpan":6}],[{"type":"dropdown","variable":"frm_sexo","var_uid":"9900376675e829ed51c2fa3011812644","dataType":"string","protectedValue":false,"id":"frm_sexo","name":"frm_sexo","label":"Sexo","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccion"},{"value":"M","label":"MASCULINO"},{"value":"F","label":"FEMENINO"}],"var_name":"frm_sexo","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"3631350015e829ed51bac93001647259","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3631350015e829ed51bac93001647259","var_name_old":"frm_tipo_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"6695089515e829ed51c9995051101725","prj_uid":"3685317655e829ed34bce43075006773","var_name":"frm_numero_identificacion","var_field_type":"string"