        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[$texto = '';
//ENVIO DE EMAIL

//$de = 'NOTIFICACIONES BPM EQUISUIZA - Venta Virtual<infoequivida@segurosequinoccial.com>';
$de = '';
