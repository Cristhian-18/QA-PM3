}

//OBTENER LA URL Y KEY AUTORIZACION DE DEBITO
$sql = "SELECT CODIGO, DESCRIPCION, VALOR FROM ADMIN_CATALOGOS
WHERE
COD_CATALOGO = 'INTEGRACION_PVIDA'
AND ESTADO = 1
