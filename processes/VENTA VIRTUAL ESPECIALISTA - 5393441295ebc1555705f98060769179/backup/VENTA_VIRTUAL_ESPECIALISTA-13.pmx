        <dyn_content><![CDATA[{"name":"FORM DECLARACION ASEGURABILIDAD","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9445281465ec5e92ef2bd88072579424","name":"FORM DECLARACION ASEGURABILIDAD","description":"","mode":"edit","script":{"type":"js","code":"\n\n$(\"#9445281465ec5e92ef2bd88072579424\").setOnSubmit(function(){\n\t//return false;\n\t//alert( showConfirmDlg() );\n\t\n\treturn showConfirmDlg();\n\t//validarPeso();\n\t//validarEstatura();  \n\t$(\"#9445281465ec5e92ef2bd88072579424\").saveForm() ;\n});\n\n$(\"#btn_declaracion_save\").find(\"button\").on(\"click\" , function() {\n\t//validarPeso();\n\t//validarEstatura();\n\t$(\"#9445281465ec5e92ef2bd88072579424\").saveForm();\n\talert (\"Formulario guardado ...\");  \n});\n\n\n/*\n$(\"#frm_declaracion_peso\").on( \"focusout\", function() {\n\tvalidarPeso();\n});\n\n$(\"#frm_declaracion_estatura\").on( \"focusout\", function() {\n\tvalidarEstatura();\n});\n*/\n\n/*\nalert($(\"#frm_monto\").getValue());\nalert($(\"#frm_trabajo_expuesta_politicamente\").getValue());\nalert($(\"#frm_plan_tipo_identificacion\").getValue());\n*/\n\n//Para sumas aseguradas mayores a $50.000: \n//Confirmacion de pago del Impuesto a la Renta del año inmediato anterior \n//(se permite impresiones del portal web del SRI)\nif($(\"#frm_monto\").getValue() < 50000){\n\t$(\"#frm_aclaraciones_sumas_aseguradas\").hide();\n\t$(\"#frm_aclaraciones_file_sumas_aseguradas\").hide();\t\n}\n\nif($(\"#frm_trabajo_expuesta_politicamente\").getValue() == 'N'){\n\t$(\"#frm_aclaraciones_file_pep\").hide();\n}\n\nif($(\"#frm_plan_tipo_identificacion\").getValue() != 'C'){\n\t$(\"#frm_aclaraciones_file_sol_natural\").hide();\n}\n\nif($(\"#frm_plan_tipo_identificacion\").getValue() != 'R'){\n\t$(\"#frm_aclaraciones_file_sol_juridico\").hide();\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"form","variable":"","var_uid":"","dataType":"","id":"1852090325ec434cca75924044427744","name":"subform estilos funciones","description":"","mode":"edit","script":{"type":"js","code":"$('.panel').css(\"border\",\"none\");\n$(\".row\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"box-shadow\", \"none\");\n$(\".panel\").css(\"margin-bottom\", \"5px\");\n$(\".panel-body\").css(\"padding\", \"0\");\n$('.pmdynaform-form').css(\"border\",\"none\");\n$(\".form-control\").css(\"box-shadow\", \"none\");\n$(\".pmdynaform-grid-row\").css(\"border-bottom\", \"none\");\n$(\".pmdynaform-label-options\").css(\"text-align\", \"left\");\n//$(\".pmdynaform-grid-title\").css(\"display\", \"none\");\n$(\".pmdynaform-field-title\").css(\"margin-bottom\", \"1px\");\n$(\".nav\").css(\"padding.bottom\", \"1px\");\n$(\".pmdynaform-field-subtitle h5\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-field-subtitle h5\").css(\"border-color\", \"#f29500\");\n$(\".pmdynaform-field-title h4\").css(\"background-color\", \"#ed7424\");\n$(\".pmdynaform-field-title h4\").css(\"border-color\", \"#ed7424\");\n\n$(\".btn-primary:hover\").css(\"background-color\", \"#ed7424\");\n$(\".btn-primary:hover\").css(\"color\", \"#ffffff\");\n$(\".btn-primary\").css(\"background-color\", \"#ed7424\");\n$(\".btn-primary\").css(\"color\", \"#ffffff\");\n\n\n$(\".btn-default\").css(\"background-color\", \"#f29500\");\n$(\".btn-default\").css(\"color\", \"#ffffff\");\n$(\".btn-default\").css(\"border-color\", \"#c5c5c5\");\n$(\".btn\").css(\"background-color\", \"#f29500\");\n$(\".btn\").css(\"color\", \"#ffffff\");\n$(\".btn\").css(\"border-color\", \"#c5c5c5\");\n\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"background-color\", \"#f29500\");\n$(\".ui-dialog-titlebar.ui-widget-header.ui-corner-all.ui-helper-clearfix\").css(\"color\", \"#ffffff\");\n$(\".ui-button\").css(\"background-color\", \"#f29500\");\n$(\".ui-button\").css(\"color\", \"#ffffff\");\n\n\n\n\n$(\".pmdynaform-grid-title\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#f29500\");\n$(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n$(\".pmdynaform-grid-newitem\").css(\"border-color\", \"#ed7424\");\n$(\".btn-default\").css(\"background-color\", \"#f29500\");\n$(\".btn-default\").css(\"border-color\", \"#f29500\");\n$(\".pmdynaform-grid-text-plus\").text(\"Agregar\");\n\n\n\n\n\n\n\n\n$( function(){\n\t\n\t$('.subtitulo').css( 'cursor', 'pointer' );\n\t\n\t$('.subtitulo').on('click', function(){\n\t\tid = this.id;\n\t\tsubforms = $('#'+this.id).attr('subform').split('|');\n\t\tif( $('#'+id).children().attr('class') == 'glyphicon glyphicon-plus')\n\t\t$('#'+id).children().removeClass('glyphicon-plus').addClass('glyphicon-minus');\n\t\telse\n\t\t$('#'+id).children().removeClass('glyphicon-minus').addClass('glyphicon-plus');\n\t\t$.each( subforms , function( index, subform ) {\n\t\t\t$('#'+subform).toggle('slow');\n\t\t});\n\t});\n\t\n\t\n})\n\nfunction validarExpresionRegular(id, numeroExpresion){\n\t\n\tif(numeroExpresion == 4){\n\t\tponerDecimales(id);\n\t}\n\t\n\t$(\"#\" + id).focusout( function () {\n\t\tvalidarExpresionRegular_2($(this), numeroExpresion);\n\t}); \t\n\t\n\tvalidarExpresionRegular_2($(\"#\" + id), numeroExpresion);\n} \n\nfunction validarExpresionRegular_2(id, numeroExpresion){\n\tvar expresion_regular = $(\"#expresion_regular_\" + numeroExpresion).getValue();\n\t//alert(expresion_regular);\n\tvar texto = $(id).getValue().toString().trim();\n\t//alert(texto);\n\t\n\t//alert(texto.match(expresion_regular) + \" - \" + texto.length);\n\t\n\tif (texto.match(expresion_regular) || texto.length == 0){\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"\" );\n\t\t$(id).getControl().css(\"borderColor\", \"\");\n\t\t}else {\n\t\t$(id).parent().find( \".textlabel\" ).css( \"color\", \"#a94442\" );\n\t\t$(id).getControl().css(\"borderColor\", \"#e4655f\");\n\t}\t\n}\n\nfunction ponerDecimales(id){\n\t\n\tvar identificador = $('#' + id);\n\tvar valor = identificador.getValue().toString().trim();\n\t\n\tif(valor == ''){\n\t\tidentificador.setValue(\"\");\n\t\treturn;\n\t}  \n\t\n\tif(typeof valor.split(\".\")[1] === 'undefined'){\n\t\tidentificador.setValue(valor + \".00\");\n\t\t}else if(valor.split(\".\")[1].length == 0){\n\t\tidentificador.setValue(valor + \"00\");\n\t\t}else if(valor.split(\".\")[1].length == 1){\n\t\tidentificador.setValue(valor + \"0\");\n\t}\n\t\n}\n\nfunction canton_2(bandera, idProvincia, idCanton){\n\t\n\tvar str = $('#frm_canton_auxiliar').getValue() + \"\";//El espacio vacio es para q se convierta a string\n\tvar vector = str.split(\",\");\t\n\t\n\t$(\"#\" + idCanton).find(\"option\").hide();\n\t$(\"#\" + idCanton).find(\"option[value='']\").show();\t\n\tif(bandera){\n\t\t$('#' + idCanton).setValue('');\t\n\t}\n\t\n\tvar comboUno = $('#'+idProvincia).getControl().val();\n\t\n\tif(comboUno == ''){\n\t\t$('#' + idCanton).getControl().attr('disabled',true);\n\t\t}else if(comboUno != \"\"){\n\t\t$('#' + idCanton).getControl().attr('disabled',false);\n\t\tfor (i = 0; i < (vector.length/2); i++) {\n\t\t\tif(vector[i*2] == comboUno){\n\t\t\t\t$(\"#\" + idCanton).find(\"option[value=\" + vector[i*2 + 1] +\"]\").show();\n\t\t\t}\n\t\t}\n\t}\t\n\t\n}\n\n\n\n//validar campos vacios\n$(\"#validacionesCampos\").hide();\n\nfunction showConfirmDlg() {\n\n\tif($(\"form\").prop(\"id\") == \"9653957035e829ed50c2e51034344533\"){\n\t\treturn;\n\t}\n\t\n\tvar bandera = true;\n\tvar c = '';\n    var count = 0;\n\tvar noCumplioValidacion;\n\tvar noCumplioValidacionProcess;\n\tvar stringHtml = \"\";\n\t\n\t$(\"div.pmdynaform-edit-text, div.pmdynaform-edit-dropdown, div.pmdynaform-edit-datetime, pmdynaform-edit-dropdown\").each(function(index) {\n\t\n\t\tif($(this).getControl().toString() == \"\"){//para q ingnore los campos de grillas\n\t\t\treturn;\n\t\t}\t\n\t\t\n\t\tif(typeof $(this).find(\".pmdynaform-message-error\").html() !== 'undefined'){\n\t\t\tnoCumplioValidacionProcess = true;\n\t\t}else{\n\t\t\tnoCumplioValidacionProcess = false;\n\t\t}\n\t\t\n\t\tstringHtml = $(this).getControl().attr(\"style\").toString();\n\t\tif(stringHtml.indexOf(\"border-color\") > 0 || stringHtml.indexOf(\"color\") > 0){\n\t\t\tnoCumplioValidacion = true;\n\t\t}else{\n\t\t\tnoCumplioValidacion = false;\n\t\t}\t\t\n\t\t\n\t\tdeshabilitadaValidacion = $(this).find(\".pmdynaform-field-required\").attr(\"style\") != \"display: none;\" ? true : false;\n\t\t\n\t\tif((deshabilitadaValidacion && $(this).find(\".pmdynaform-field-required\").html() == '*') || noCumplioValidacion || noCumplioValidacionProcess){\n\t\t\tif($(this).getValue().trim().length == 0 || noCumplioValidacion || noCumplioValidacionProcess){\n\t\t\t\tcount++;\n\t\t\t\tc += count + \") \" + $(this).getLabel() + \"<br>\";\n\t\t\t\tbandera = false;\n\t\t\t}\t\t\n\t\t}\n\t\t\n\t});  \n\n\t$(\"#validacionesCampos\").html(c); \n\t\n\tvar dlgContents = {\n\t\tmodal:     true,\n\t\tresizable: false,\n\t\tbuttons: {\n\t\t\t\"Ok\": function() {\n\t\t\t\t$(this).dialog(\"close\");\n\t\t\t\tcallback(true);\n\t\t\t}\n\t\t}\n\t}\n\t\n\tif(count > 0){\n\t\t$(\"#validacionesCampos\").dialog(dlgContents);\n\t}\n\treturn bandera;\n}\n\nfunction validarIdentificacion(identificacion, tipoIdentificacion) {\n\n    if (tipoIdentificacion == '') {\n        alert(\"Ingrese el tipo de identificacion\");\n        return false;\n    }\n\n    numero = identificacion;\n    var bandera = true;\n\n    if (tipoIdentificacion == 'C') {\n        if (numero.length != 10) {\n            alert(\"La identificacion no tiene diez digitos\");\n            identificacion.value = '';\n            bandera = false;\n            return false;\n        }\n    }\n\n    if (bandera) {\n        digitos = numero.split(\"\");\n        totdigitos = 10;\n        total = 0;\n        digito = (digitos[9] * 1);\n\n        for (i = 0; i < (totdigitos - 1); i++) {\n            mult = 0;\n            if ((i % 2) != 0) {\n                total = total + (digitos[i] * 1);\n            } else {\n                mult = digitos[i] * 2;\n                if (mult > 9)\n                    total = total + (mult - 9);\n                else\n                    total = total + mult;\n            }\n        }\n\n        //comprobando codigo verificador\n        decena = total / 10;\n        decena = Math.floor(decena);\n        decena = (decena + 1) * 10;\n        final = (decena - total);\n\n        if ((final == 10 && digito == 0) || (final == digito)) {\n            //alert(\"Cedula valida\");\n            return true;\n        } else {\n            //Validar pasaporte\n            if (tipoIdentificacion == 'P' && numero.length <= 30) {\n                return true;\n            }\n            if (tipoIdentificacion == 'P' && numero.length > 30) {\n                alert(\"En un pasaporte se permite maximo 30 caracteres \");\n                return false;\n            } else {\n                alert(\"Identificacion no valida\");\n                identificacion.value = '';\n                return false;\n            }\n        }\n    }\n}\n\n\n\n\n\n\n\n\n\n\n\n"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/jquery-ui.css,/plugin/beesmartec/core_librerias/js_externos/jquery-ui.js","printable":false,"items":[[{"type":"panel","id":"panelRequeridos","content":"<div id=\"validacionesCampos\" title=\"Verificar la informacion\"></div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"expresion_regular_1","var_uid":"3681304635e8525e4b173d3069070665","dataType":"string","protectedValue":false,"id":"expresion_regular_1","name":"expresion_regular_1","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_1","colSpan":3},{"type":"hidden","variable":"expresion_regular_2","var_uid":"9579963435e8579e5dc9351087274555","dataType":"string","protectedValue":false,"id":"expresion_regular_2","name":"expresion_regular_2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_2","colSpan":3},{"type":"hidden","variable":"expresion_regular_3","var_uid":"2837094465ec434e3918ce2092196455","dataType":"string","protectedValue":false,"id":"expresion_regular_3","name":"expresion_regular_3","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_3","colSpan":3},{"type":"hidden","variable":"expresion_regular_4","var_uid":"9491441075ec434e3b51753019415626","dataType":"string","protectedValue":false,"id":"expresion_regular_4","name":"expresion_regular_4","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"expresion_regular_4","colSpan":3}]],"variables":[{"var_uid":"3681304635e8525e4b173d3069070665","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_1","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3681304635e8525e4b173d3069070665","var_name_old":"expresion_regular_1","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"9579963435e8579e5dc9351087274555","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9579963435e8579e5dc9351087274555","var_name_old":"expresion_regular_2","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"2837094465ec434e3918ce2092196455","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_3","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5290064565e8df1ec9ee1d4077852307","var_name_old":"expresion_regular_3","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"9491441075ec434e3b51753019415626","prj_uid":"5393441295ebc1555705f98060769179","var_name":"expresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5747417245e95f5bd9072d0065641887","var_name_old":"expresion_regular_4","prj_uid_old":"3685317655e829ed34bce43075006773"}],"colSpan":12}],[{"type":"subtitle","id":"frm_sbt_declaracion","label":"<span class=\"subtitulo\" id=\"isub_declaracion\" subform=\"8323199425ec549bca5cf96089834194\"> <i class=\"glyphicon glyphicon-minus\"></i> 4. DECLARACION DE ASEGURABILIDAD</span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8323199425ec549bca5cf96089834194","name":"subform asegurado declaracion","description":"","mode":"edit","script":{"type":"js","code":"$(\"#grid_historia_familiar\").onAddRow(function(newArrayRow, gridObject, indexAdd) {\n    if(indexAdd>=4){  \n  \t\tnewArrayRow[0].setValue(\"HERMANO\");\n      \tnewArrayRow[0].setText(\"Hermano(a)\");\n      \n\n    }\n})\nvar gridId = 'grid_historia_familiar'; //set to the ID of the grid\nfunction setEmptyRowsToRed() {\n    var aGridVals = $('#'+gridId).getValue();  \n    for (i = 1; i <= aGridVals.length; i++) {   \n    \t$($(\"#\"+gridId).find(\"button\")[i]).attr(\"disabled\", true);       \n      \t$($(\"#\"+gridId).find(\"select\")[i-1]).attr(\"disabled\", true);      \n    }\n}\n\n\n//Inicializar Grid de Historia Familiar\n$(\"#grid_historia_familiar\").addRow();\n$(\"#grid_historia_familiar\").addRow();\n\njQuery(\"#grid_historia_familiar\").setValue('MADRE', '1', '1');\njQuery(\"#grid_historia_familiar\").setText('Madre', '1', '1');\njQuery(\"#grid_historia_familiar\").setValue('PADRE', '2', '1');\njQuery(\"#grid_historia_familiar\").setText('Padre', '2', '1');\njQuery(\"#grid_historia_familiar\").setValue('HERMANO', '3', '1');\njQuery(\"#grid_historia_familiar\").setText('Hermano(a)', '3', '1');\n\nif($('#frm_sexo').getValue()==\"M\"){\n\t$('#frm_declaracion_embarazo').parent().parent().hide()\n  \tjQuery(\"#frm_declaracion_embarazo\").disableValidation();\n \t$('#frm_declaracion_fecha_cita').parent().parent().hide()\n  \tjQuery(\"#frm_declaracion_fecha_cita\").disableValidation();\n  \t$('#frm_declaracion_resultado_cita').parent().parent().hide()\n  \tjQuery(\"#frm_declaracion_resultado_cita\").disableValidation();\n}\nelse{\n\t$('#frm_declaracion_embarazo').parent().parent().show()\n  \tjQuery(\"#frm_declaracion_embarazo\").enableValidation();\n \t$('#frm_declaracion_fecha_cita').parent().parent().show()\n  \tjQuery(\"#frm_declaracion_fecha_cita\").enableValidation();\n  \t$('#frm_declaracion_resultado_cita').parent().parent().show()\n  \tjQuery(\"#frm_declaracion_resultado_cita\").enableValidation();\n}\n\n\n// if (typeof ponerDecimales === 'function') {\n    // $(\"#frm_declaracion_peso\").focusout(function () {\n        // ponerDecimales(\"frm_declaracion_peso\");\n    // });\n\n    // $(\"#frm_declaracion_estatura\").focusout(function () {\n        // ponerDecimales(\"frm_declaracion_estatura\");\n    // });\n\n    // ponerDecimales(\"frm_declaracion_peso\");\n    // ponerDecimales(\"frm_declaracion_estatura\");\n// }\nvar controles=\"#frm_declaracion_a_combo,#frm_declaracion_b_combo,#frm_declaracion_c_combo,#frm_declaracion_d_combo,#frm_declaracion_e_combo,#frm_declaracion_f_combo,#frm_declaracion_g_combo,#frm_declaracion_h_combo,#frm_declaracion_i_combo,#frm_declaracion_j_combo,#frm_declaracion_k_combo,#frm_declaracion_l_combo,#frm_declaracion_m_combo,#frm_declaracion_n_combo,#frm_declaracion_o_combo\";\nvar paneles=\"#pnl_a,#pnl_b,#pnl_c,#pnl_d,#pnl_e,#pnl_f,#pnl_g,#pnl_h,#pnl_i,#pnl_j,#pnl_k,#pnl_l,#pnl_m,#pnl_n,#pnl_o,#pnl_p\";\nvar grids=\"#grid_historia_familiar,#grid_medicos_consultados\";\n\n\n$(controles).find(\".textlabel\").css(\"display\", \"none\");\n\n\n//$(controles).css(\"width\", \"275px\");\n//$(controles).css(\"float\", \"right\");\n\n$(paneles).css(\"height\", \"5px\");\n$(paneles).css(\"background-color\", \"#f29500\");\n\n$(grids).find(\".pmdynaform-grid-title\").css(\"background-color\", \"#f29500\");\n$(grids).find(\".pmdynaform-grid-title\").css(\"font-size\", \"12px\");\n$(grids).find(\".pmdynaform-grid-newitem\").css(\"background-color\", \"#f29500\");\n$(grids).find(\".pmdynaform-grid-newitem\").css(\"font-size\", \"12px\");\n$(grids).find(\".btn-default\").css(\"background-color\", \"#f29500\");\n$(grids).find(\".btn-default\").css(\"border-color\", \"#f29500\");\n\n\n$(\"#frm_declaracion_peso_variacion\").change(function () {\n    variacionPeso();\n});\nfunction variacionPeso(){\n  var opcion=$(\"#frm_declaracion_peso_variacion option:selected\").val();\n // alert ($(\"#frm_declaracion_a_combo option:selected\").val());\n  switch(opcion){\n    case 'GANO':\n     \t $(\"#frm_declaracion_peso_ganado\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_peso_ganado\").enableValidation();\n        jQuery(\"#frm_declaracion_causa_ganancia_peso\").enableValidation();      \n     \t$(\"#frm_declaracion_peso_perdido\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_peso_perdido\").disableValidation();\n        jQuery(\"#frm_declaracion_causa_perdida_peso\").disableValidation();\n      break;\n    case 'PERDIO':\n        $(\"#frm_declaracion_peso_ganado\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_peso_ganado\").disableValidation();\n        jQuery(\"#frm_declaracion_causa_ganancia_peso\").disableValidation();      \n     \t$(\"#frm_declaracion_peso_perdido\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_peso_perdido\").enableValidation();\n        jQuery(\"#frm_declaracion_causa_perdida_peso\").enableValidation();\n      break;   \n    default:\n        $(\"#frm_declaracion_peso_ganado\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_peso_ganado\").disableValidation();\n        jQuery(\"#frm_declaracion_causa_ganancia_peso\").disableValidation();      \n     \t$(\"#frm_declaracion_peso_perdido\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_peso_perdido\").disableValidation();\n        jQuery(\"#frm_declaracion_causa_perdida_peso\").disableValidation();\n     \n  }\n}\n    \n\n\n$(\"#frm_declaracion_peso_unidad\").setOnchange(  \n\nfunction cambiarUnidad() {\n    var unidadPeso=$(\"#frm_declaracion_peso_unidad\").getValue();\n  \t$(\"#frm_declaracion_peso\").setLabel(\"Peso en \"+ unidadPeso);\n   \t$(\"#frm_declaracion_peso_ganado\").setLabel(\"Peso en \"+ unidadPeso+\" ganado el iconv('UCS-4LE','UTF-8',pack('V', hexdec('U00fa')))ltimo aiconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f1')))o\");\n   \t$(\"#frm_declaracion_peso_perdido\").setLabel(\"Peso en \"+ unidadPeso+ \" perdido el iconv('UCS-4LE','UTF-8',pack('V', hexdec('U00fa')))ltimo aiconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f1')))o\");\n}\n  );\n\n//Todos los combos inicializados en Seleccion damian\n//$('select option[value=\"\"]').attr(\"selected\", true);\n\n$(function () {\n\t// x = Math.round(20.49);\n\t// x = Math.round(20.49);\n\t$(\"#frm_declaracion_peso\").setValue(Math.round($(\"#frm_declaracion_peso\").getValue()));\n\t$(\"#frm_declaracion_estatura\").setValue(Math.round($(\"#frm_declaracion_estatura\").getValue()));\n\t\n    validarPeso(false);\n    validarEstatura(false);\n\n    campos_a_combo();\n    campos_b_combo();\n    campos_c_combo();\n    campos_d_combo();\n    campos_e_combo();\n  \tcampos_f_combo();\n    campos_g_combo();\n    campos_h_combo();\n    campos_i_combo();\n    campos_j_combo();\n    campos_k_combo();\n    campos_l_combo();\n    campos_m_combo();\n    campos_n_combo();\n    campos_o_combo();\n  \tvariacionPeso();\n  setEmptyRowsToRed();\n});\n\n//////////////////////////\n//Validar peso y estatura\n//////////////////////////\n$(\"#frm_declaracion_peso\").on(\"focusout\", function () {\n    validarPeso(true);\n});\n\n$(\"#frm_declaracion_estatura\").on(\"focusout\", function () {\n    validarEstatura(true);\n});\n\nfunction validarPeso(auxAlert) {\n    $(\"#frm_declaracion_peso\").getControl().css(\"borderColor\", \"\");\n    var peso = parseFloat($(\"#frm_declaracion_peso\").getValue());\n    if (isNaN(peso) || peso <= 77 || peso >= 440) {\n        $(\"#frm_declaracion_peso\").getControl().css(\"borderColor\", \"#e4655f\");\n        if (auxAlert) {\n            alert(\"Confirme si el peso es correcto\");\n        }\n        return false;\n    }\n    return true;\n}\n\nfunction validarEstatura(auxAlert) {\n    $(\"#frm_declaracion_estatura\").getControl().css(\"borderColor\", \"\");\n    var estatura = parseFloat($(\"#frm_declaracion_estatura\").getValue());\n    if (isNaN(estatura) || estatura <= 120 || estatura >= 198) {\n        $(\"#frm_declaracion_estatura\").getControl().css(\"borderColor\", \"#e4655f\");\n        if (auxAlert) {\n            alert(\"Confirme si la estatura es correcta\");\n        }\n        return false;\n    }\n    return true;\n}\n\n\n          \n  \n    \n\t\n\n///////////\n//Preguntas\n///////////\n\n//Pregunta a)\n$(\"#frm_declaracion_a_combo\").change(function () {\n    campos_a_combo();\n});\n\nfunction campos_a_combo() {\n    var enfermedades=\"#frm_declaracion_a_diabetes,#frm_declaracion_a_corazon,#frm_declaracion_a_cancer,#frm_declaracion_a_cirrosis,#frm_declaracion_a_renal,#frm_declaracion_a_pulmonar,#frm_declaracion_a_nervioso,#frm_declaracion_a_tiroides,#frm_declaracion_a_sida,#frm_declaracion_a_discapacidad\";\n \tif ($(\"#frm_declaracion_a_combo option:selected\").val() == 'S') {\n        $(enfermedades).show(\"slow\");\n        jQuery(\"#frm_declaracion_a_diabetes\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_corazon\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_cancer\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_cirrosis\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_renal\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_pulmonar\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_nervioso\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_tiroides\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_sida\").enableValidation();\n\t\tjQuery(\"#frm_declaracion_a_discapacidad\").enableValidation();\n\n    }\n    else {    \n\t\t$(enfermedades).hide(\"slow\");\n       // jQuery(enfermedades).disableValidation();\n        jQuery(\"#frm_declaracion_a_diabetes\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_corazon\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_cancer\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_cirrosis\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_renal\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_pulmonar\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_nervioso\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_tiroides\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_sida\").disableValidation();\n\t\tjQuery(\"#frm_declaracion_a_discapacidad\").disableValidation();\n     //    \n    }\n}\n\n//Pregunta b)\n$(\"#frm_declaracion_b_combo\").change(function () {\n    campos_b_combo();\n});\n\nfunction campos_b_combo() {\n    if ($(\"#frm_declaracion_b_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_b_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_b_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_b_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_b_detalle\").disableValidation();\n    }\n}\n\n//Pregunta c)\n$(\"#frm_declaracion_c_combo\").change(function () {\n    campos_c_combo();\n});\n\nfunction campos_c_combo() {\n    if ($(\"#frm_declaracion_c_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_c_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_c_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_c_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_c_detalle\").disableValidation();\n    }\n}\n\n//Pregunta d)\n$(\"#frm_declaracion_d_combo\").change(function () {\n    campos_d_combo();\n});\n\nfunction campos_d_combo() {\n    if ($(\"#frm_declaracion_d_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_d_motivo\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_d_motivo\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_d_motivo\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_d_motivo\").disableValidation();\n    }\n}\n//Pregunta e)\n$(\"#frm_declaracion_e_combo\").change(function () {\n    campos_e_combo();\n});\n\nfunction campos_e_combo() {\n    if ($(\"#frm_declaracion_e_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_e_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_e_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_e_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_e_detalle\").disableValidation();\n    }\n}\n//Pregunta f)\n$(\"#frm_declaracion_f_combo\").change(function () {\n    campos_f_combo();\n});\n\nfunction campos_f_combo() {\n    if ($(\"#frm_declaracion_f_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_f_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_f_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_f_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_f_detalle\").disableValidation();\n    }\n}\n\n//Pregunta g)\n$(\"#frm_declaracion_g_combo\").change(function () {\n    campos_g_combo();\n});\n\nfunction campos_g_combo() {\n  if ($(\"#frm_declaracion_g_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_g_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_g_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_g_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_g_detalle\").disableValidation();\n    }\n}\n//Pregunta h)\n$(\"#frm_declaracion_h_combo\").change(function () {\n    campos_h_combo();\n});\n\nfunction campos_h_combo() {\n  if ($(\"#frm_declaracion_h_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_h_edad\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_h_edad\").enableValidation();\n\t\t $(\"#frm_declaracion_h_cantidad\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_h_cantidad\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_h_edad\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_h_edad\").disableValidation();\n\t\t$(\"#frm_declaracion_h_cantidad\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_h_cantidad\").disableValidation();\n    }\n}\n//Pregunta i)\n$(\"#frm_declaracion_i_combo\").change(function () {\n    campos_i_combo();\n});\n\nfunction campos_i_combo() {\n  if ($(\"#frm_declaracion_i_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_i_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_i_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_i_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_i_detalle\").disableValidation();\n    }\n}\n//Pregunta j)\n$(\"#frm_declaracion_j_combo\").change(function () {\n    campos_j_combo();\n});\n\nfunction campos_j_combo() {\n  if ($(\"#frm_declaracion_j_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_j_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_j_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_j_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_j_detalle\").disableValidation();\n    }\n}\n//Pregunta k)\n$(\"#frm_declaracion_k_combo\").change(function () {\n    campos_k_combo();\n});\n\nfunction campos_k_combo() {\n  if ($(\"#frm_declaracion_k_combo option:selected\").val() == 'S') {\n    \n    \n        $(\"#frm_declaracion_k_clase\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_k_clase\").enableValidation();\n     \t$(\"#frm_declaracion_k_cantidad\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_k_cantidad\").enableValidation();\n    \t$(\"#frm_declaracion_k_frecuencia\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_k_frecuencia\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_k_clase\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_k_clase\").disableValidation();\n      $(\"#frm_declaracion_k_cantidad\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_k_cantidad\").disableValidation();\n      $(\"#frm_declaracion_k_frecuencia\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_k_frecuencia\").disableValidation();\n    }\n}\n//Pregunta l)\n$(\"#frm_declaracion_l_combo\").change(function () {\n    campos_l_combo();\n});\n\nfunction campos_l_combo() {\n  if ($(\"#frm_declaracion_l_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_l_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_l_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_l_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_l_detalle\").disableValidation();\n    }\n}\n//Pregunta m)\n$(\"#frm_declaracion_m_combo\").change(function () {\n    campos_m_combo();\n});\n\nfunction campos_m_combo() {\n  if ($(\"#frm_declaracion_m_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_m_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_m_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_m_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_m_detalle\").disableValidation();\n    }\n}\n//Pregunta n)\n$(\"#frm_declaracion_n_combo\").change(function () {\n    campos_n_combo();\n});\n\nfunction campos_n_combo() {\n  if ($(\"#frm_declaracion_n_combo option:selected\").val() == 'S') {\n        $(\"#frm_declaracion_n_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_n_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_n_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_n_detalle\").disableValidation();\n    }\n}\n//Pregunta o)\n$(\"#frm_declaracion_o_combo\").change(function () {\n    campos_o_combo();\n});\n\nfunction campos_o_combo() {\n  if ($(\"#frm_declaracion_o_combo option:selected\").val() == 'N') {\n        $(\"#frm_declaracion_o_detalle\").parent().parent().show(\"slow\");\n        jQuery(\"#frm_declaracion_o_detalle\").enableValidation();\n    }\n    else {\n        $(\"#frm_declaracion_o_detalle\").parent().parent().hide(\"slow\");\n        jQuery(\"#frm_declaracion_o_detalle\").disableValidation();\n    }\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_declaracion_estatura","var_uid":"4997502905ec549cb2099c5089846929","dataType":"string","protectedValue":false,"id":"frm_declaracion_estatura","name":"frm_declaracion_estatura","label":"Estatura en centimetros","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":""