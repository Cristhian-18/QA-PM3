        <dyn_content><![CDATA[{"name":"subform cotizacion Broker","description":"subform cotizacion Broker","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"324076764662d351b1042c4067702883","name":"subform cotizacion Broker","description":"subform cotizacion Broker","mode":"edit","script":{"type":"js","code":"\/*\n\/\/sets the value of the independent fields in each row in the grid:\nfunction setIndependent (newVal, oldVal) {\n\/\/  alert (\"entre\");\n  var oGrid = $(\"#grd_coberturas\"); \/\/change to the ID of the grid\n  for (var i = 1; i <= oGrid.getNumberRows(); i++) {\n    \/\/change 2 to the column position of the hidden text field:\n    oGrid.setValue(newVal, i, 8); \n  }   \n}\n\/\/change selectUserId to the ID of the independent field outside the grid   \n$(\"#selectUserId\").setOnchange(setIndependent);\nsetIndependent($(\"#frm_producto\").getValue(), '');\n*\/\n\n$(\"#frm_impuesto\").hide();\n$(\"#grd_coberturas\").hideColumn(1);\nvar impuesto = $(\"#frm_impuesto\").getValue();\n$(\"#frm_prima_iva\").setLabel(impuesto+'% Impuesto');\n$(\"#tri_error_producto\").hide();\n$(\"#btn_calcular\").hide();\n\n\n\/*\n$(\"#grd_coberturas\").onAddRow(function(aNewRow, oGrid, rowIndex) {\n  var aux = $(\"#frm_producto\").getControl().val();\n  aNewRow[0].setValue(aux);\n\n});\n\n\n$(\"#grd_coberturas\").on(\"change\" , function() {\n  alert (\"entrando\");\n  \/\/$(\"#grd_coberturas\").clear();\n});\n*\/\n\n$(\"#frm_producto\").on(\"change\" , function() {\n  $(\"#grd_coberturas\").clear();\n});\n\n$(\"#btn_calcular\").on(\"click\" , function() {\n  validar_beneficio();\n  calcular()\n});\n\nfunction calcular(){\n  $(\"#3751077885fbe75756c4ec1052766767\").saveForm();  \n  recorrer_beneficio();\n  var numRows = $(\"#grd_coberturas\").getNumberRows();\n  var suma=0;\n  var dscto = 0;\n  \/\/alert (numRows);\n  for (var i=1; i <= numRows; i++) {\n    var dato = $(\"#grd_coberturas\").getValue(i, 8)*1;   \n    var des = $(\"#grd_coberturas\").getValue(i, 6);\n    suma = suma + dato*1;\n    dscto = dscto + des*1;\n    var dato1 = dato.toFixed(2);\n    $(\"#grd_coberturas\").setValue(dato1,i, 8);\n    \/\/ alert (suma);\n  };  \n  var impuesto = $(\"#frm_impuesto\").getValue();\n  var derecho = $(\"#frm_prima_derechos\").getValue();  \n  var adicional = $(\"#frm_aporte_adicional\").getValue();\n  \/\/  alert ('adicional '+ adicional);\n  var val_impuesto = suma * impuesto \/ 100;\n  \/\/  alert ('impouesto '+ val_impuesto);\n\n  var subtotal = val_impuesto*1 + suma*1 ;\n  \/\/  alert ('subtotal '+ subtotal);\n  var porRecargo = $(\"#frm_por_recargo\").getValue();\n  \/\/  alert ('por'+porRecargo);\n  var recargo = subtotal * porRecargo \/ 100; \/\/subtotal\n  \/\/   alert ('recar'+recargo);  \n\n\n\n  var suma = suma.toFixed(2);  \n  var val_impuesto = val_impuesto.toFixed(2);\n  \n  var total = subtotal + derecho*1 +recargo*1 +adicional*1;  \n\n  var subtotal = subtotal.toFixed(2);\n  var recargo = recargo.toFixed(2);\n  var dscto = dscto.toFixed(2);   \n  var total = total.toFixed(2); \n\n  $(\"#frm_prima_subtt\").setValue(suma);\n  $(\"#frm_prima_iva\").setValue(val_impuesto);\n  $(\"#frm_prima_dscto\").setValue(dscto);\n  $(\"#frm_prima_conimpuestos\").setValue(subtotal);  \n  $(\"#frm_prima_recargo\").setValue(recargo);  \n\/\/  $(\"#frm_prima_total\").setValue(total); \n\n\n  \/\/  ponerDecimales('frm_prima_total');\n  \/\/  ponerDecimales('frm_prima_iva');  \n  \/\/  ponerDecimales('frm_prima_conImpuesto');    \n\n}\n\nfunction recorrer_beneficio(){\n  var numRows = $(\"#grd_coberturas\").getNumberRows();\n  var dental=0;\n  var exequial=0; \n  var suma = 0;\n  for (var i=1; i <= numRows; i++) {\n    var dato= \t$(\"#grd_coberturas\").getValue(i, 2);\n    var prima = $(\"#grd_coberturas\").getValue(i, 8)*1;\n    if (dato >= 24 && dato <= 32){\n      \/\/    alert ('dental '+prima);\n      dental = dental + prima;\n    }\n    if (dato >= 5801 && dato <= 5820){\n      \/\/    alert ('exequial '+prima);\n      exequial = exequial + prima;\n    }\n    if (dato == 1 ){\n      var asegurado = $(\"#grd_coberturas\").getValue(i, 3)*1;\n    }    \n    suma = suma + prima;\n  };\n  var suma = suma.toFixed(2);\n  var dental = dental.toFixed(2);\n  var exequial = exequial.toFixed(2);  \n  $(\"#frm_prima_subtt\").setValue(suma);  \n  $(\"#frm_prima_dental\").setValue(dental);  \n  $(\"#frm_prima_exequial\").setValue(exequial);  \n  $(\"#frm_valor_asegurado\").setValue(asegurado);    \n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_impuesto","var_uid":"322057658600b680c8cf633072359364","dataType":"string","protectedValue":false,"id":"frm_impuesto","name":"frm_impuesto","label":"Impuesto","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT VALOR FROM `ADMIN_CATALOGOS` WHERE COD_CATALOGO = 'PARAMETROS_GENERALES' AND CODIGO = 'IMPUESTO' \nAND ESTADO = 1 AND PRO_UID = '5393441295ebc1555705f98060769179'\n","var_name":"frm_impuesto","colSpan":2},{"type":"hidden","variable":"frm_por_recargo","var_uid":"700194723605d04282a2687082954475","dataType":"string","protectedValue":false,"id":"frm_por_recargo","name":"frm_por_recargo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_por_recargo","colSpan":2},{"type":"text","variable":"tri_error_producto","var_uid":"88413148060787a54a6adb2032115120","dataType":"string","protectedValue":false,"id":"tri_error_producto","name":"tri_error_producto","label":"Error de producto","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_error_producto","colSpan":2},{"type":"hidden","variable":"ajx_eqfx_validacion","var_uid":"92765623662b9b7fa8f5b15046909101","dataType":"string","protectedValue":false,"id":"ajx_eqfx_validacion","name":"ajx_eqfx_validacion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"ajx_eqfx_validacion","colSpan":2},{"type":"hidden","variable":"tri_error_validacion","var_uid":"61225158362b9bd93c3ff91087367913","dataType":"string","protectedValue":false,"id":"tri_error_validacion","name":"tri_error_validacion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_error_validacion","colSpan":2},{"colSpan":2}],[{"type":"label","id":"lblCliente","label":"<h5 style=\"color:#1C9DD9;\"><b>DATOS DEL CLIENTE<\/b><\/h5><hr>","colSpan":12}],[{"type":"datetime","variable":"frm_fecha_nacimiento","var_uid":"8085954315ec43529b5f970038530666","dataType":"datetime","protectedValue":false,"id":"frm_fecha_nacimiento","name":"frm_fecha_nacimiento","label":"Fecha de nacimiento","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"DD-MM-YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_nacimiento","colSpan":4},{"type":"dropdown","variable":"frm_sexo","var_uid":"8984127055ec43529f0cae3096848123","dataType":"string","protectedValue":false,"id":"frm_sexo","name":"frm_sexo","label":"Sexo","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"M","label":"Masculino"},{"value":"F","label":"Femenino"}],"var_name":"frm_sexo","colSpan":4},{"type":"dropdown","variable":"frm_declaracion_h_combo","var_uid":"5329203735ec549cdaddcb6034103597","dataType":"string","protectedValue":false,"id":"frm_declaracion_h_combo","name":"frm_declaracion_h_combo","label":"Fumador","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"Si"},{"value":"N","label":"No"}],"var_name":"frm_declaracion_h_combo","colSpan":4}],[{"type":"label","id":"lblSeg","label":"<h5 style=\"color:#1C9DD9;\"><b>DATOS DE LA POLIZA<\/b><\/h5><hr>","colSpan":12}],[{"type":"dropdown","variable":"frm_Sucursal","var_uid":"2810092775fa4355d89f3a2027362825","dataType":"string","protectedValue":false,"id":"frm_Sucursal","name":"frm_Sucursal","label":"Sucursal","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT CODIGO, DESCRIPCION FROM `ADMIN_CATALOGOS` WHERE COD_CATALOGO = 'SUCURSALES_PR' AND CODIGO NOT IN (10, 6, 9) AND PRO_UID = 'GENERICO' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options"