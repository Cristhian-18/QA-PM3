        <dyn_filename><![CDATA[5393441295ebc1555705f98060769179/5082028826058a730c8e057031947313]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"subform primera cuota","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"5082028826058a730c8e057031947313","name":"subform primera cuota","description":"","mode":"edit","script":{"type":"js","code":"$( function(){\n  var aux = $(\"#frm_recibio_deposito\").getControl().val();\n  if (aux == 'S'){\n    $(\"#frm_primera_cuota_medio_pago\").hide();   \n    $(\"#frm_deposito_medio\").show();   \n  }\n  else\n  {\n    $(\"#frm_primera_cuota_medio_pago\").show();   \n    $(\"#frm_deposito_medio\").hide();       \n  }\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_recibio_deposito","var_uid":"6529563555f1266c4c97622091790237","dataType":"string","protectedValue":false,"id":"frm_recibio_deposito","name":"frm_recibio_deposito","label":"Realizo cobro anticipado","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_recibio_deposito","colSpan":4},{"type":"dropdown","variable":"frm_primera_cuota_medio_pago","var_uid":"7509989555f239254458d52031410108","dataType":"string","protectedValue":false,"id":"frm_primera_cuota_medio_pago","name":"frm_primera_cuota_medio_pago","label":"Medio de Pago primera cuota","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"DEBITO","label":"Debito bancario"},{"value":"TARJETA","label":"Tarjeta credito \/ debito"},{"value":"GRATIS","label":"Cuota gratis"},{"value":"","label":"ND"}],"var_name":"frm_primera_cuota_medio_pago","colSpan":4},{"type":"dropdown","variable":"frm_deposito_medio","var_uid":"3835068535fa1f157d4f019033353062","dataType":"string","protectedValue":false,"id":"frm_deposito_medio","name":"frm_deposito_medio","label":"Medio de pago","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='MEDIO_PAGO' AND ESTADO=1 \nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"ND"}],"var_name":"frm_deposito_medio","colSpan":4}]],"variables":[{"var_uid":"6529563555f1266c4c97622091790237","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6163213375f1264730a9313065496027","var_name_old":"frm_recibio_deposito","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"7509989555f239254458d52031410108","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_primera_cuota_medio_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"7509989555f239254458d52031410108","var_name_old":"frm_primera_cuota_medio_pago","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"3835068535fa1f157d4f019033353062","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_deposito_medio","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3835068535fa1f157d4f019033353062","var_name_old":"frm_deposito_medio","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}]}]}]]></dyn_content>
