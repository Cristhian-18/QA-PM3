:"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"^[#.0-9a-zA-Z\u00c0-\u00fa\\s,-]{2}[#.0-9a-zA-Z\u00c0-\u00fa\\s,-]+$","validateMessage":"Formato incorrecto","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"2","var_name":"frm_covid_cuatro_detalle","colSpan":12}],[{"type":"dropdown","variable":"frm_covid_cuatro_refuerzo","var_uid":"69069883762fabf23c4c900000718384","dataType":"string","protectedValue":false,"id":"frm_covid_cuatro_refuerzo","name":"frm_covid_cuatro_refuerzo","label":"Vacuna de refuerzo recibida","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_covid_cuatro_refuerzo","colSpan":6},{"type":"datetime","variable":"frm_covid_cuatro_fecha_refuerzo","var_uid":"74966515062fabf23dd8e75045689857","dataType":"datetime","protectedValue":false,"id":"frm_covid_cuatro_fecha_refuerzo","name":"frm_covid_cuatro_fecha_refuerzo","label":"Fecha de la dosis de refuerzo","placeholder":"DD\/MM\/YYYY","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"DD\/MM\/YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_covid_cuatro_fecha_refuerzo","colSpan":6}],[{"type":"text","variable":"frm_covid_cuatro_detalle_refuerzo","var_uid":"63189733762fabf24016856062697375","dataType":"string","protectedValue":false,"id":"frm_covid_cuatro_detalle_refuerzo","name":"frm_covid_cuatro_detalle_refuerzo","label":"Complicaciones a causa de la vacuna de refuerzo","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_covid_cuatro_detalle_refuerzo","colSpan":12}],[{"type":"panel","id":"panel0000000001","content":"<p>Declaro expresa e irrevocablemente que los datos consignados en el presente formulario son correctos y fidedignos, eximo\na Seguros Equinoccial S.A. de toda responsabilidad, inclusive respecto de terceros, si esta declaraci\u00f3n fuese falsa.<\/p>\n<p>Faculto a Seguros Equinoccial S.A. a proceder con la comprobaci\u00f3n de esta declaraci\u00f3n; para el efecto podr\u00e1 efectuar\ntodas las indagaciones necesarias, por los medios que considere convenientes y queda expresamente autorizada para\nque la informaci\u00f3n consignada en el presente formulario y\/o la que proporcione personalmente por otros medios a Seguros\nEquinoccial S.A., podr\u00e1 ser administrada y en especial: capturada, tratada, procesada, operada, verificada, transmitida,\nalmacenada, usada o puesta en circulaci\u00f3n por la Aseguradora a sus distintos proveedores de servicios, a fin de que yo\npueda acceder a los distintos beneficios y servicios que conferir\u00e1 la p\u00f3liza cuya contrataci\u00f3n estoy solicitando, y pueda ser\nemitida a autoridades competentes, organismos de control y\/o a otras instituciones o personas jur\u00eddicas legal o\nreglamentariamente facultadas.<\/p>\n<p>Conforme a la normativa vigente, el Solicitante del seguro y\/o Asegurado est\u00e1 obligado a declarar objetivamente el estado\nde riesgo, previo al perfeccionamiento del contrato de seguro, seg\u00fan el cuestionario que le sea propuesto por el\nasegurador, y de conformidad con la Ley. La reticencia o falsedad acerca de la declaraci\u00f3n del Solicitante, vician de nulidad\nrelativa el contrato de seguro, con la salvedad prevista para el seguro de vida en el caso de inexactitud en la declaraci\u00f3n\nde la edad del Asegurado.<\/p>","border":"1px","colSpan":12}],[{"type":"submit","id":"btn_continuar_covid","name":"btn_continuar_covid","label":"Continuar","colSpan":12}]],"variables":[{"var_uid":"6605805105ecc6086b056e2079872609","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_covid_uno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8650362775f107061dfe469047817852","var_name_old":"frm_covid_uno","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"4272803695ecc60985b3769057110453","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_covid_uno_fecha","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3916349585f107062082bb4095828507","var_name_old":"frm_covid_uno_fecha","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"2915043775ecc60a61124e2002694063","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_covid_uno_tratamiento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_