"","dataType":"","id":"4134920295f9c8c87b37d96033269232","name":"subform check list documentos","description":"","mode":"parent","script":{"type":"js","code":"\/*$(\"#grd_obligatorios\").hide();*\/\n$(\"#fle_mas_docs\").hide();\n$(\"#fle_otros_docs\").hide();\n$(\"#fle_docs_repro\").hide();\n\/*$(\"#grd_especificos\").hide();*\/\n$(\"#fle_docs_aprobar\").hide();\n\n$(\"#fle_mas_docs\").find(\"button\").html(\"Seleccionar archivos\");\n$(\"#fle_otros_docs\").find(\"button\").html(\"Seleccionar archivos\");\n$(\"#fle_docs_repro\").find(\"button\").html(\"Seleccionar archivos\");\n$(\"#fle_docs_aprobar\").find(\"button\").html(\"Seleccionar archivos\");\n\n\/*var numopcional =  $(\"#grd_especificos\").getNumberRows();\nif (numopcional == 0){\n  $(\"#subtit_opc\").getNumberRows();\n  $(\"#grd_especificos\").hide();\n}*\/\n\nif($(\"#TASK\").getValue() == '4033495885f982c8ce12631090926236'){\n\t$(\"#fle_mas_docs\").show();\n}\n\nif($(\"#TASK\").getValue() == '9625228685f982cb3eaa338037581251'){\n\t$(\"#fle_otros_docs\").show();\n}\n\nif($(\"#TASK\").getValue() == '9938028895f0f3574ab7db1043599014'){\n\t$(\"#fle_docs_repro\").show();\n}\n\/\/t09\nif($(\"#TASK\").getValue() == '5378516815f96e3b7bf1699006176801' && $(\"#tri_es_broker\").getValue() == 'SI'){\n\t$(\"#fle_docs_aprobar\").show();\n}\n\n\/*$(\"#grd_especificos\").hideColumn(2);*\/"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"multipleFile","variable":"fle_mas_docs","var_uid":"24664147464489b16147d13091812793","dataType":"multiplefile","protectedValue":false,"id":"fle_mas_docs","name":"fle_mas_docs","label":"Otros Documentos","inputDocument":"documentos cliente","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.jpg,*.png,*.jpeg","size":11,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"8223936685f984df51a48b6016633531","var_name":"fle_mas_docs","colSpan":12}],[{"type":"multipleFile","variable":"fle_otros_docs","var_uid":"18998844564696e73d44298013651947","dataType":"multiplefile","protectedValue":false,"id":"fle_otros_docs","name":"fle_otros_docs","label":"Otros Documentos","inputDocument":"documentos cliente","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.jpg,*.png,*.jpeg","size":11,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"8223936685f984df51a48b6016633531","var_name":"fle_otros_docs","colSpan":12}],[{"type":"multipleFile","variable":"fle_docs_repro","var_uid":"95915000064888e07523ce8049172650","dataType":"multiplefile","protectedValue":false,"id":"fle_docs_repro","name":"fle_docs_repro","label":"Otros Documentos","inputDocument":"documentos cliente","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.jpg,*.png,*.jpeg","size":11,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"8223936685f984df51a48b6016633531","var_name":"fle_docs_repro","colSpan":12}],[{"type":"multipleFile","variable":"fle_docs_aprobar","var_uid":"573084827649062274a1331098041613","dataType":"multiplefile","protectedValue":false,"id":"fle_docs_aprobar","name":"fle_docs_aprobar","label":"Otros Documentos","inputDocument":"documentos cliente","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.jpg,*.png,*.jpeg","size":11,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"8223936685f984df51a48b6016633531","var_name":"fle_docs_aprobar","colSpan":12}],[{"type":"hidden","variable":"TASK","var_uid":"8462559665f8f1f9fca8350024764654","dataType":"string","protectedValue":false,"id":"TASK","name":"TASK","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"TASK","colSpan":4},{"type":"hidden","variable":"tri_es_broker","var_uid":"95167456160becf060a78f9098563798","dataType":"string","protectedValue":false,"id":"tri_es_broker","name":"tri_es_broker","defa