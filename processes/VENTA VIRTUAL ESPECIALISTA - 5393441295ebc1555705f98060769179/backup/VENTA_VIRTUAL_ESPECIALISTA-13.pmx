        <dyn_content><![CDATA[{"name":"subform historial atencion","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3659092825f484ded40e690037283996","name":"subform historial atencion","description":"","mode":"edit","script":{"type":"js","code":"var comm = $(\"#tri_comentarios\").getValue();\n$(\"#comentarios\").html(comm); \n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"panel_comentario","content":"<div id=\"comentarios\"><\/div>","border":"1px","colSpan":12}],[{"colSpan":2},{"colSpan":2},{"type":"hidden","variable":"tri_comentarios","var_uid":"1308114045ec43c341dbf91082909342","dataType":"string","protectedValue":false,"id":"tri_comentarios","name":"tri_comentarios","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_comentarios","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"1308114045ec43c341dbf91082909342","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_comentarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5608579545e829ed522fed0018096998","var_name_old":"tri_comentarios","prj_uid_old":"3685317655e829ed34bce43075006773","create":false}]}]}]]></dyn_content>
