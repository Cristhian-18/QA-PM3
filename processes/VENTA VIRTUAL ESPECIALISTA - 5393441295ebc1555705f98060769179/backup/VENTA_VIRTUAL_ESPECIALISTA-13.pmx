        <dyn_content><![CDATA[{"name":"subform asegurado trabajo","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"5032478615ec435a90a1eb9075237565","name":"subform asegurado trabajo","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_trabajo_convencional\").hide();\n\nif (typeof validarExpresionRegular === 'function') {\n\t//validarExpresionRegular(\"frm_trabajo_sector_barrio\", 2);\n\t//validarExpresionRegular(\"frm_trabajo_calle_principal\", 2);\n\t//validarExpresionRegular(\"frm_trabajo_numero\", 3);\n\t//validarExpresionRegular(\"frm_trabajo_calle_transversal\", 2);\n\t//validarExpresionRegular(\"frm_trabajo_edificio\", 3);\n\t//validarExpresionRegular(\"frm_trabajo_oficina\", 2);\n\t\n}\n/*\n$(document).ready(function () {\n\tif (typeof canton_2 === 'function') {\n\t\tcanton_2(false, 'frm_trabajo_provincia', 'frm_trabajo_canton');\n\t}\n\t\n\t\n});\n\n\n$('#frm_trabajo_provincia').on('change', function () {\n\tif (typeof canton_2 === 'function') {\n\t\tcanton_2(true, 'frm_trabajo_provincia', 'frm_trabajo_canton');\n\t}\n});\n*/\n\n\n\n\n\n\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"textarea","variable":"frm_trabajo_direccion","var_uid":"90947406165c430c68fc2f2090641589","dataType":"string","protectedValue":false,"id":"frm_trabajo_direccion","name":"frm_trabajo_direccion","label":"Dirección","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"El texto ingresado no debe contener carateres especiales como: \\n\\t\\r","validate":"^[^\\n\\t\\r]*$","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_trabajo_direccion","colSpan":12}],[{"type":"text","variable":"frm_trabajo_celular","var_uid":"7863408895e829ed51ad041076526462","dataType":"string","protectedValue":false,"id":"frm_trabajo_celular","name":"frm_trabajo_celular","label":"Teléfono","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Formato no permitido","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_trabajo_celular","colSpan":6},{"type":"text","variable":"frm_trabajo_correo_trabajo","var_uid":"5858219095efb50841bc960065235644","dataType":"string","protectedValue":false,"id":"frm_trabajo_correo_trabajo","name":"frm_trabajo_correo_trabajo","label":"Correo electrónico del trabajo","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[a-zA-Z0-9.!#$%&'*+/=?^_-`{|}~-]+@(\\w+\\.)+\\w{2,4}$","validateMessage":"Formato no permitido","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_trabajo_correo_trabajo","colSpan":6}],[{"type":"text","variable":"frm_trabajo_convencional","var_uid":"1876941915e829ed51a9a59056423964","dataType":"string","protectedValue":false,"id":"frm_trabajo_convencional","name":"frm_trabajo_convencional","label":"Telefono convencional","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Formato no permitido","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_trabajo_convencional","colSpan":6},{"colSpan":6}]],"variables":[{"var_uid":"90947406165c430c68fc2f2090641589","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_trabajo_direccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7863408895e829ed