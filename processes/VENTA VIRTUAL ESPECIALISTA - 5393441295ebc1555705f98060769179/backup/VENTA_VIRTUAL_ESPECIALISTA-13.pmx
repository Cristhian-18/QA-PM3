' AND ESTADO = 1 ORDER BY DESCRIPCION*/","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_ciudad_nacimiento","colSpan":4}],[{"type":"text","variable":"frm_ciudad_nacimiento_otro","var_uid":"30252186465180b6c13e9d5057200758","dataType":"string","protectedValue":false,"id":"frm_ciudad_nacimiento_otro","name":"frm_ciudad_nacimiento_otro","label":"Lugar de Nacimiento","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_ciudad_nacimiento_otro","colSpan":12}],[{"type":"dropdown","variable":"frm_estado_civil","var_uid":"5187577455e829ed51e6930061871173","dataType":"string","protectedValue":false,"id":"frm_estado_civil","name":"frm_estado_civil","label":"Estado Civil","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'ESTADO_CIVIL' AND ESTADO = 1 ORDER BY DESCRIPCION ","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_estado_civil","colSpan":6},{"type":"text","variable":"frm_numero_hijos","var_uid":"2292871175e829ed5193916004375304","dataType":"string","protectedValue":false,"id":"frm_numero_hijos","name":"frm_numero_hijos","label":"Número de hijos","defaultValue":"0","placeholder":"","hint":"Solo admite numeros enteros, entre 0 y 10","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Solo admite numeros enteros, entre 0 y 10","maxLength":"2","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","v