:"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5747417245e95f5bd9072d0065641887","var_name_old":"expresion_regular_4","prj_uid_old":"3685317655e829ed34bce43075006773"}],"colSpan":12}],[{"type":"panel","id":"pnl_vineta","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li> \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"suscripcion\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Dictamen Suscripcion</h4></a></li>\n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"subtitle","id":"subtit_commen","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_commen\" subform=\"3659092825f484ded40e690037283996\"> <i class=\"glyphicon glyphicon-plus\"></i> HISTORIAL TICKET</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3659092825f484ded40e690037283996","name":"subform historial atencion","description":"","mode":"edit","script":{"type":"js","code":"var comm = $(\"#tri_comentarios\").getValue();\n$(\"#comentarios\").html(comm); \n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"panel_comentario","content":"<div id=\"comentarios\"></div>","border":"1px","colSpan":12}],[{"colSpan":2},{"colSpan":2},{"type":"hidden","variable":"tri_comentarios","var_uid":"1308114045ec43c341dbf91082909342","dataType":"string","protectedValue":false,"id":"tri_comentarios","name":"tri_comentarios","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_comentarios","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"1308114045ec43c341dbf91082909342","prj_uid":"5393441295ebc1555705f98060769179","var_name":"tri_comentarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5608579545e829ed522fed0018096998","var_name_old":"tri_comentarios","prj_uid_old":"3685317655e829ed34bce43075006773","create":false}],"colSpan":12}],[{"type":"subtitle","id":"subtit_datos","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_venta\" subform=\"25830987060590cf686aa76067215111|32832123863dc1b7ca05b77080881437\"> <i class=\"glyphicon glyphicon-minus\"></i> RESUMEN DE SOLICITUD</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"26770765663c55d39d9a8d3040722455","name":"SubForm Casos Magnum","description":"SubForm Casos Magnum","mode":"disabled","script":{"type":"js","code":"$(\"#bl_hist_mag\").hide();\n$(\"grd_datos_magnum\").hide();\n\nif($(\"#tri_bandera_magnum\").getValue() == 'true'){\n\t$(\"#bl_hist_mag\").show();\n  \t$(\"grd_datos_magnum\").show();\n}\n\nvar numRows = $(\"#grd_datos_magnum\").getNumberRows();\nfor (var i=1; i <= numRows; i++) {\n\t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_num_caso\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_num_caso\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_fecha_magnum\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_fecha_magnum\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_magnum\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_decision_magnum\\\\]\").css(\"border\", \"green solid 2px\");\n  \t$(\"#form\\\\[grd_datos_magnum\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_canal_entrada\\\\]\").css(\"color\", \"green\");\n  \t$(\"#form\\\\[grd_datos_ma