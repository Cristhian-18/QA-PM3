        $bloque .= '<td width="30%" ' . $thStyle . '>Correo Electronico</td>';
        $bloque .= '<td width="28%" ' . $thStyle . '>Telefono</td>';
        $bloque .= '<td width="27%" colspan="2" ' . $thStyle . '>Tipo de beneficiario Gratuito / Oneroso</td>';
        $bloque .= '</tr>';

        for ($i = 1; $i <= $tot; $i++) {
            $email    = vacioNoAplica(@=grd_beneficiario[$i]['frm_email_beneficiario'] ?? '');
            $telefono = vacioNoAplica(@=grd_beneficiario[$i]['frm_telefono_beneficiario'] ?? '');
            $tipo     = vacioNoAplica(@=grd_beneficiario[$i]['frm_plan_tipo_beneficiario'] ?? '');

            $bloque .= '<tr>';
            $bloque .= '<td width="30%" ' . $tdStyle . '>' . $email . '</td>';
            $bloque .= '<td width="28%" ' . $tdStyle . '>' . $telefono . '</td>';
            $bloque .= '<td width="27%" colspan="2" ' . $tdStyle . '>' . $tipo . '</td>';
            $bloque .= '</tr>';
        }

        $bloque .= '</table>';
        @@frm_beneficiarios_bloque = $bloque;
    }
}

 $tdStyle = 'style="border: 1px solid #02493c; color: #001815; background-color: #ffffff; font-size: x-small; vertical-align: top;"';
$thStyle = 'style="background-color: #c4f99b; color: #001815; font-size: x-small; font-weight: bold;"';

$bloque_default  = '<table width="100%" cellspacing="0" cellpadding="2">';
$bloque_default .= '<tr><td width="30%" ' . $thStyle . '>Nombres y Apellidos completos</td><td width="28%" ' . $thStyle . '>No. C.I / Pasaporte</td><td width="27%" ' . $thStyle . '>Parentesco</td><td width="15%" ' . $thStyle . '>Porcentaje</td></tr>';
$bloque_default .= '<tr><td width="30%" ' . $tdStyle . '>N/A</td><td width="28%" ' . $tdStyle . '>N/A</td><td width="27%" ' . $tdStyle . '>N/A</td><td width="15%" ' . $tdStyle . '>N/A</td></tr>';
$bloque_default .= '<tr><td width="30%" ' . $thStyle . '>Correo Electronico</td><td width="28%" ' . $thStyle . '>Telefono</td><td width="27%" colspan="2" ' . $thStyle . '>Tipo de beneficiario Gratuito / Oneroso</td></tr>';
$bloque_default .= '<tr><td width="30%" ' . $tdStyle . '>N/A</td><td width="28%" ' . $tdStyle . '>N/A</td><td width="27%" colspan="2" ' . $tdStyle . '>N/A</td></tr>';
$bloque_default .= '</table>';

@@frm_beneficiarios_contingentes_bloque = $bloque_default;

if (isset(@@grid_beneficiarios_contingentes) && is_array(@@grid_beneficiarios_contingentes) && count(@@grid_beneficiarios_contingentes) > 0) {

    $frm_primer_nombre = trim(@=grid_beneficiarios_contingentes[1]['frm_plan_primer_nombre_contingente'] ?? '');

    if ($frm_primer_nombre != "") {
        $bloque  = '<table width="100%" cellspacing="0" cellpadding="2">';
        $bloque .= '<tr><td width="30%" ' . $thStyle . '>Nombres y Apellidos completos</td><td width="28%" ' . $thStyle . '>No. C.I / Pasaporte</td><td width="27%" ' . $thStyle . '>Parentesco</td><td width="15%" ' . $thStyle . '>Porcentaje</td></tr>';

        $tot = count(@=grid_beneficiarios_contingentes);
        for ($i = 1; $i <= $tot; $i++) {
            $primer_nombre  = trim(@=grid_beneficiarios_contingentes[$i]['frm_plan_primer_nombre_contingente'] ?? '');
            $segundo_nombre = trim(@=grid_beneficiarios_contingentes[$i]['frm_plan_segundo_nombre_contingente'] ?? '');
            $primer_apellido  = trim(@=grid_beneficiarios_contingentes[$i]['frm_plan_primer_apellido_contingente'] ?? '');
            $segundo_apellido = trim(@=grid_beneficiarios_contingentes[$i]['frm_plan_segundo_apellido_contingente'] ?? '');

            $nombre_completo = trim($primer_nombre . ' ' . $segundo_nombre . ' ' . $primer_apellido . ' ' . $segundo_apellido);
            $nombre_completo = $nombre_completo != '' ? $nombre_completo : 'N/A';

            $identificacion = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_plan_numero_identificacion_beneficiario_contingente'] ?? '');
            $parentesco     = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_plan_prentesco_contingente_label'] ?? '');
            $porcentaje     = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_plan_porcentaje_contingente'] ?? '');

            $bloque .= '<tr><td width="30%" ' . $tdStyle . '>' . $nombre_completo . '</td><td width="28%" ' . $tdStyle . '>' . $identificacion . '</td><td width="27%" ' . $tdStyle . '>' . $parentesco . '</td><td width="15%" ' . $tdStyle . '>' . $porcentaje . '%</td></tr>';
        }

        $bloque .= '<tr><td width="30%" ' . $thStyle . '>Correo Electronico</td><td width="28%" ' . $thStyle . '>Telefono</td><td width="27%" colspan="2" ' . $thStyle . '>Tipo de beneficiario Gratuito / Oneroso</td></tr>';

        for ($i = 1; $i <= $tot; $i++) {
            $email    = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_email_contingente'] ?? '');
            $telefono = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_telefono_contingente'] ?? '');
            $tipo     = vacioNoAplica(@=grid_beneficiarios_contingentes[$i]['frm_plan_tipo_beneficiario_contingente'] ?? '');

            $bloque .= '<tr><td width="30%" ' . $tdStyle . '>' . $email . '</td><td width="28%" ' . $tdStyle . '>' . $telefono . '</td><td width="27%" colspan="2" ' . $tdStyle . '>' . $tipo . '</td></tr>';
        }

        $bloque .= '</table>';
        @@frm_beneficiarios_contingentes_bloque = $bloque;
    }
}


@@tmp_paso = 'aca';

]]></tri_webbot>
