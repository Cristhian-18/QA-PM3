ND ESTADO = 1\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_infconf_a_detalle","colSpan":6}],[{"type":"dropdown","variable":"frm_infconf_b","var_uid":"7493316065ecd7676d9db47084039924","dataType":"string","protectedValue":false,"id":"frm_infconf_b","name":"frm_infconf_b","label":"b) Le consta que el candidato reviso y firmo en su presencia la solicitud del seguro?","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_infconf_b","colSpan":12}],[{"type":"textarea","variable":"frm_infconf_b_detalle","var_uid":"7912212635ecd77c16255b8018331864","dataType":"string","protectedValue":false,"id":"frm_infconf_b_detalle","name":"frm_infconf_b_detalle","label":"Explique","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"1","var_name":"frm_infconf_b_detalle","colSpan":12}],[{"type":"dropdown","variable":"frm_infconf_c","var_uid":"9310961945ecd767e2c6ea0038351310","dataType":"string","protectedValue":false,"id":"frm_infconf_c","name":"frm_infconf_c","label":"c) Le consta que el contratante reviso y firmo en su presencia la solicitud del seguro?","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccion"},{"value":"S","label":"SI"},{"value":"N","label":"NO"}],"var_name":"frm_infconf_c","colSpan":12}],[{"type":"textarea","variable":"frm_infconf_c_detalle","var_uid":"1966649195ecd783