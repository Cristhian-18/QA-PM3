uid":"4938512885ec4352a192960050708231","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_estado_civil","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4938512885ec4352a192960050708231","var_name_old":"frm_estado_civil","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"4595023666019d5da6d3776084898817","prj_uid":"5393441295ebc1555705f98060769179","var_name":"ajx_eqfx_cliente_tipo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4595023666019d5da6d3776084898817","var_name_old":"ajx_eqfx_cliente_tipo","prj_uid_old":"5393441295ebc1555705f98060769179","create":false}],"colSpan":12}],[{"type":"subtitle","id":"frm_sbt_conyuge_datos","label":"<span class=\"subtitulo\" id=\"ifrmcony\" subform=\"3757104985ec4355abb45c4085575644\"> <i class=\"glyphicon glyphicon-plus\"></i> DATOS DEL CONYUGUE</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3757104985ec4355abb45c4085575644","name":"subform conyuge datos personales","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_conyuge_tipo_identificacion\").change( function () {\n \t$('#frm_conyuge_numero_identificacion ').setValue('');\n});\nif(typeof validarExpresionRegular === 'function') {\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_paterno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_apellido_materno\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_primer_nombre\", 1);\n\tvalidarExpresionRegular(\"frm_conyuge_segundo_nombre\", 1);\n}\n\n$(\"#frm_conyuge_numero_identificacion\").focusout(function () {\n  var identificacion = $(\"#frm_numero_identificacion\").getValue();\n   if ($(\"#frm_numero_identificacion\").getValue == identificacion) {\n    \talert(\"La identificacion ingresada no puede ser la misma del asegurado\");\n        (\"#frm_conyuge_numero_identificacion\").setValue(\"\");\n    }\n});\n\n\n// Validar que no podria tener menos de 18 anios cumplidos o mas de 69 anios cumplidos\n$(\"#frm_conyuge_fecha_nacimiento\").setOnchange(function () {\n    var fechaNacimiento = $(\"#frm_conyuge_fecha_nacimiento\").getValue();\n\n    if (fechaNacimiento == '') {\n        return false;\n    }\n\n    var edad = calcular_edad(fechaNacimiento);\n\n    if (edad >= 18 && edad < 69) {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"\");\n        return true;\n    } else {\n        $(\"#frm_conyuge_fecha_nacimiento\").getControl().css({ \"border\": \"#E45061 solid 1px\" });\n        $(\"#frm_conyuge_fecha_nacimiento\").find(\"span.textlabel\").css(\"color\", \"#a94442\");\n        $('#frm_conyuge_fecha_nacimiento').setValue('');\n        return false;\n    }\n});\n\nfunction calcular_edad(fechaNacimiento) {\n    //Split de las fecha recibida para separarla\n    var x = fechaNacimiento.split(\"-\");\n    var dia = x[2];\n    var mes = x[1];\n    var ano = x[0];\n\n    fecha_hoy = new Date();\n    ahora_ano = fecha_hoy.getYear();\n    ahora_mes = fecha_hoy.getMonth();\n    ahora_dia = fecha_hoy.getDate();\n    edad = (ahora_ano + 1900) - ano;\n\n    if (ahora_mes < (mes - 1)) {\n        edad--;\n    }\n    if (((mes - 1) == ahora_mes) && (ahora_dia < dia)) {\n        edad--;\n    }\n    if (edad > 1900) {\n        edad -= 1900;\n    }\n\n    return edad;\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_conyuge_tipo_identificacion","var_uid":"4772704505e829ed516ec73048585953","dataType":"string","protectedValue":false,"id":"frm_conyuge_tipo_identificacion","name":"frm_conyuge_tipo_identificacion","label":"Tipo de identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_conyuge_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_conyuge_numero_identificacion","var_uid":"8951537385e829ed51a4901025955614","dataType":"string","protectedValue":false,"id":"frm_conyuge_numero_identificacion","name":"frm_conyuge_numero_identificacion","label":"Numero de identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"Campo requerido","textTransform":"none","validate":"^[a-zA-Z0-9_-]*$","validateMessage":"Formato no permitido","maxLength":"13","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conyuge_numero_identificacion","colSpan":6}],[{"type":"text","variable":"frm_conyuge_primer_nombre","var_uid":"9202546135e829ed51de290070601778","dataType":"string","protectedValue":false,"id":"frm_conyuge_primer_nombre","name":"frm_conyuge_primer_nombre","label":"Primer nombre","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñÑÁÉÍÓÚáéíóú\\s]*$","validateMessage":"Formato no permitido","maxLength":"32","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","