alue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"Requerido.","mode":"edit","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"S","label":"Si"},{"value":"N","label":"No"}],"columnWidth":"10","width":100,"title":"Regularizado"},{"type":"multipleFile","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_regulacion_archivo","name":"frm_regulacion_archivo","label":"Subir archivo","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":"5","sizeUnity":"MB","enableVersioning":false,"mode":"edit","multiple":false,"inp_doc_uid":"","columnWidth":"10","width":100,"title":"Subir archivo"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Seccion regularizacion","colSpan":12}],[{"type":"grid","variable":"grd_obligatorios_incorrectos","var_uid":"89173567360af927940e631090727574","dataType":"grid","protectedValue":false,"id":"grd_obligatorios_incorrectos","name":"grd_obligatorios_incorrectos","label":"Obligatorios incorrectos o incompletos","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_obligatorio_codigo","name":"frm_obligatorio_codigo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100,"var_name":"grd_obligatorios_incorrectos"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_obligatorio_descripcion","name":"frm_obligatorio_descripcion","label":"Descripcion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"P