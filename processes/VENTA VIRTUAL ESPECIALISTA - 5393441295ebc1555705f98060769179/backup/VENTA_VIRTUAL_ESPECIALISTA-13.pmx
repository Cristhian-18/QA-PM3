        <dyn_content><![CDATA[{"name":"sub form dictsus asegurado","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7630948545faeb652af6268064318900","name":"sub form dictsus asegurado","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"text0000000001","name":"text0000000001","label":"SISE para el contratante","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","colSpan":6},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0000000003","name":"dropdown0000000003","label":"Vinculo familiar","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'tvinculo_aseg'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"colSpan":6}],[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"dropdown0000000004","name":"dropdown0000000004","label":"Conducto de pago","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"1479570925ec29f1d8d1d57019959618","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida - [QA]","sql":"SELECT\nCODIGO,\nDESCRIPCION\nFROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'tconducto'\nAND ESTADO = 1\nORDER BY DESCRIPCION ASC","dataVariable":"","options":[{"value":"","