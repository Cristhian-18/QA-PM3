$tdStyle = 'style="border: 1px solid #02493c; color: #001815; background-color: #ffffff; font-size: x-small; vertical-align: top;"';
$thStyle = 'style="background-color: #c4f99b; color: #001815; font-size: x-small; font-weight: bold;"';

$bloque_default  = '<table width="100%" cellspacing="0" cellpadding="2">';
$bloque_default .= '<tr><td width="30%" ' . $thStyle . '>Nombres y Apellidos completos</td><td width="28%" ' . $thStyle . '>No. C.I / Pasaporte</td><td width="20%" ' . $thStyle . '>Parentesco</td><td width="22%" ' . $thStyle . '>Fecha Nacimiento</td></tr>';
$bloque_default .= '<tr><td width="30%" ' . $tdStyle . '>N/A</td><td width="28%" ' . $tdStyle . '>N/A</td><td width="20%" ' . $tdStyle . '>N/A</td><td width="22%" ' . $tdStyle . '>N/A</td></tr>';
$bloque_default .= '</table>';

@@frm_dental_bloque = $bloque_default;

if (isset(@@grid_dental) && is_array(@@grid_dental) && count(@@grid_dental) > 0) {

    $frm_dental_identificacion = trim(@=grid_dental[1]['frm_dental_identificacion'] ?? '');

    if ($frm_dental_identificacion != "") {
        $bloque  = '<table width="100%" cellspacing="0" cellpadding="2">';
        $bloque .= '<tr>';
        $bloque .= '<td width="30%" ' . $thStyle . '>Nombres y Apellidos completos</td>';
        $bloque .= '<td width="28%" ' . $thStyle . '>No. C.I / Pasaporte</td>';
        $bloque .= '<td width="20%" ' . $thStyle . '>Parentesco</td>';
        $bloque .= '<td width="22%" ' . $thStyle . '>Fecha Nacimiento</td>';
        $bloque .= '</tr>';

        $tot = count(@=grid_dental);
        for ($i = 1; $i <= $tot; $i++) {
            $primer_nombre    = trim(@=grid_dental[$i]['frm_dental_primer_nombre'] ?? '');
            $segundo_nombre   = trim(@=grid_dental[$i]['frm_dental_segundo_nombre'] ?? '');
            $primer_apellido  = trim(@=grid_dental[$i]['frm_dental_primer_apellido'] ?? '');
            $segundo_apellido = trim(@=grid_dental[$i]['frm_dental_segundo_apellido'] ?? '');

            $nombre_completo = trim($primer_nombre . ' ' . $segundo_nombre . ' ' . $primer_apellido . ' ' . $segundo_apellido);
            $nombre_completo = $nombre_completo != '' ? $nombre_completo : 'N/A';

            $identificacion = vacioNoAplica(@=grid_dental[$i]['frm_dental_identificacion'] ?? '');
            $parentesco     = vacioNoAplica(@=grid_dental[$i]['frm_dental_parentesco_label'] ?? '');
            $fecha          = vacioNoAplica(@=grid_dental[$i]['frm_dental_fecha_nacimiento'] ?? '');

            $bloque .= '<tr>';
            $bloque .= '<td width="30%" ' . $tdStyle . '>' . $nombre_completo . '</td>';
            $bloque .= '<td width="28%" ' . $tdStyle . '>' . $identificacion . '</td>';
            $bloque .= '<td width="20%" ' . $tdStyle . '>' . $parentesco . '</td>';
            $bloque .= '<td width="22%" ' . $tdStyle . '>' . $fecha . '</td>';
            $bloque .= '</tr>';
        }

        $bloque .= '</table>';
        @@frm_dental_bloque = $bloque;
    }
}


