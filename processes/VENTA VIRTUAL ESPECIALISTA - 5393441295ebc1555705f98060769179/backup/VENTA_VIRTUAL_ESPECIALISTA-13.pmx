\\.00)(?=.{1,9}(\\.|$))(?!0(?!\\.))\\d{1,3}(,\\d{3})*(\\.\\d+)?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_financiera_total_egresos","colSpan":6},{"colSpan":6}],[{"type":"label","id":"frm_financiera_activos","label":"<H5><b><u>Total activos<\/u>  (bienes que tenga a la fecha de llenado de este formulario)<b><\/H5>\n\n\n","colSpan":6},{"type":"label","id":"frm_financiera_pasivos","label":"<H5><b><u>Total Pasivos<\/u> (Valores que adeuda a la fecha de llenado de este formulario)<b><\/H5>\n\n\n","colSpan":6}],[{"type":"text","variable":"frm_financiera_total_activos","var_uid":"4285171206072568af22606027306127","dataType":"string","protectedValue":false,"id":"frm_financiera_total_activos","name":"frm_financiera_total_activos","label":"Valor USD $","defaultValue":"","placeholder":"00.00","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^(?!0+\\.00)(?=.{1,9}(\\.|$))(?!0(?!\\.))\\d{1,3}(,\\d{3})*(\\.\\d+)?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_financiera_total_activos","colSpan":6},{"type":"text","variable":"frm_financiera_total_pasivos","var_uid":"3390956866072565e2a5a67026838191","dataType":"string","protectedValue":false,"id":"frm_financiera_total_pasivos","name":"frm_financiera_total_pasivos","label":"Valor USD $","defaultValue":"","placeholder":"00.00","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^(?!0+\\.00)(?=.{1,9}(\\.|$))(?!0(?!\\.))\\d{1,3}(,\\d{3})*(\\.\\d+)?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_financiera_total_pasivos","colSpan":6}],[{"type":"text","variable":"frm_financiera_total_patrimonio","var_uid":"79558603065181d540a8c92047406541","dataType":"string","protectedValue":false,"id":"frm_financiera_total_patrimonio","name":"frm_financiera_total_patrimonio","label":"Patrimonio USD $","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^(?!0+\\.00)(?=.{1,9}(\\.|$))(?!0(?!\\.))\\d{1,3}(,\\d{3})*(\\.\\d+)?$","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_financiera_total_patrimonio","colSpan":6},{"colSpan":6}],[{"type":"dropdown","variable":"frm_plan_contablidad","var_uid":"45715646765181f327a4529056593760","dataType":"string","protectedValue":false,"id":"frm_plan_contablidad","name":"frm_plan_contablidad","label":"Es obligado a llevar contabilidad?","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_plan_contablidad","colSpan":4},{"type":"dropdown","variable":"frm_plan_pago_renta","var_uid":"58565199765181f3e66d580044243022","dataType":"string","protectedValue":false,"id":"frm_plan_pago_renta","name":"frm_plan_pago_renta","label":"Paga usted Impuesto a la Renta?","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"SeleccIone"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_plan_pago_renta","colSpan":4},{"type":"dropdown","variable":"frm_p