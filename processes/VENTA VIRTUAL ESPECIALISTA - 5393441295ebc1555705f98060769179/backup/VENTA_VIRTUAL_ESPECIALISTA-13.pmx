atabase","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"114916868606f270038dda4087444592","var_name_old":"frm_provisional_numero_tarjeta","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"613640211606f2736e07da3070191457","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_plan_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"613640211606f2736e07da3070191457","var_name_old":"frm_provisional_plan_pago","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"353177181606f2741a339e2069138571","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_plan_cobro_cuota","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"353177181606f2741a339e2069138571","var_name_old":"frm_provisional_plan_cobro_cuota","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"8413533996075d2e494c604000758367","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_saldo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8413533996075d2e494c604000758367","var_name_old":"frm_provisional_saldo","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"685635949606f2759579804055850661","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_saldo_inicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"685635949606f2759579804055850661","var_name_old":"frm_provisional_saldo_inicial","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"190035796606f274d0d5617069212193","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_promocion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"190035796606f274d0d5617069212193","var_name_old":"frm_provisional_promocion","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"265662624606f2765525c70086653648","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"265662624606f2765525c70086653648","var_name_old":"frm_provisional_pago","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"490935367606f277221da79056042198","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_provisional_descuento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"490935367606f277221da79056042198","var_name_old":"frm_provisional_descuento","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"8916654695f1266c4eac169036406620","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_monto_deposito_provisional","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8916654695f1266c4eac169036406620","var_name_old":"frm_monto_deposito_provisional","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"9726153525ebc18bd020db6097470723","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_monto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
