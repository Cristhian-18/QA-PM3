        <dyn_content><![CDATA[{"name":"Form 5 Registrar inspección","description":"Form 5 Registrar inspección","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"660166329656650d81efa84030929495","name":"Form 5 Registrar inspección","description":"Form 5 Registrar inspección","mode":"edit","script":{"type":"js","code":"//$(\"#frm_as_tipoGestion\").getControl().attr('disabled', true);\n\nocultar_solicitud();\nmostrar_solicitud();\nocultar_documentos();\nocultar_historial();\nfunction mostrar_solicitud() {\n  $('#46098314565510a5cd57553018796264').show(); // Datos asegurado \n  $('#14607804465510ee3e00a05082909351').show(); // Datos siniestro\n  //$('#19482908265511238869e34082628309').show(); // Datos gestión\n  $('#7403890606552d71dbfcce0019230087').show(); // Historial de casos\n  $('#56993520565511b0c807296060115467').show(); // Siniestros registrados\n  //$('#37397912265511ee4965f19044370072').show(); // Alcance a siniestro\n  $('#462863856655124050411a0083795803').show(); // Información siniestro\n  $('#16423784965514772ad1aa4003438500').show(); // Direcciones bienes\n  $('#3991222066552d3306b3be8000113907').show(); // Información inspección\n  $('#4479316636552d520db0b22003258870').show(); // Información pago\n  $('#3524701026552e2db3b1ce7038906501').show(); // Análisis siniestro\n  $('#26930265365541e148c32f9051535276').show(); // Gestión informe ajustador externo\n  //$('#124534031655423d6933cf3054917309').show(); // Gestión informe ajustador interno\n  $('#73833911165542a9e820942098465603').show(); // Recomendaciones\n  $('#30141999765542f7db73941014259095').show(); // Subrogaciones/salvamentos\n  $('#258163566655432b663f282099762126').show(); // Atención al caso\n  $('#18277194465787f6590bb75083746853').show(); // Poliza\n  $('#subtitleDatase').show();\n  $('#subtitleDatoSini').show();\n  $('#subtitleDatGes').show();\n  $('#subtitleSiniReg').show();\n  $('#subtitleAlcaSin').show();\n  $('#subtitleInformacionSiniestro').show();\n  $('#subtitleDireBien').show();\n  $('#subtitleInfoInsp').show();\n  $('#subtitleInfPago').show();\n  $('#subtitleAnaSini').show();\n  $('#subtitleGestAjusExter').show();\n  $('#subtitleGestAjusInter').show();\n  $('#subtitleRecomenda').show();\n  $('#subtitleSubrSalv').show();\n  $('#subtitleAtenCaso').show();\n  $('#sub_titlePoliza').show();\n  $('#fle_respaldosInspeccion').show();\n  $('#sub_companias_coaseguradas').show();\n  $('#930411861658b16b7c6ffe2080159750').show();\n  $('#72023205665542581b5be35026876051').show();\n  salvamento($('#frm_ss_existeSalvamento').getValue(), '');\n\n\n  let tipo_operacion = $(\"#frm_ds_tipoOperacion\").getValue();\n  console.log(tipo_operacion);\n  if (tipo_operacion === 'COASEGURO CEDIDO') {\n    console.log(tipo_operacion);\n\n    $('#sub_companias_coaseguradas').show();\n    $('#930411861658b16b7c6ffe2080159750').show();\n  } else {\n    $('#sub_companias_coaseguradas').hide();\n    $('#930411861658b16b7c6ffe2080159750').hide();\n  }\n}\nfunction ocultar_solicitud() {\n  $('#46098314565510a5cd57553018796264').hide();\n  $('#14607804465510ee3e00a05082909351').hide();\n  //$('#19482908265511238869e34082628309').hide(); \n  $('#7403890606552d71dbfcce0019230087').hide();\n  $('#56993520565511b0c807296060115467').hide();\n  //$('#37397912265511ee4965f19044370072').hide(); \n  $('#462863856655124050411a0083795803').hide();\n  $('#16423784965514772ad1aa4003438500').hide();\n  $('#3991222066552d3306b3be8000113907').hide();\n  $('#4479316636552d520db0b22003258870').hide();\n  $('#3524701026552e2db3b1ce7038906501').hide();\n  $('#26930265365541e148c32f9051535276').hide();\n  //$('#124534031655423d6933cf3054917309').hide(); \n  $('#73833911165542a9e820942098465603').hide();\n  $('#30141999765542f7db73941014259095').hide();\n  $('#258163566655432b663f282099762126').hide();\n  $('#18277194465787f6590bb75083746853').hide();\n  $('#subtitleDatase').hide();\n  $('#subtitleDatoSini').hide();\n  $('#subtitleDatGes').hide();\n  $('#subtitleSiniReg').hide();\n  $('#subtitleAlcaSin').hide();\n  $('#subtitleInformacionSiniestro').hide();\n  $('#subtitleDireBien').hide();\n  $('#subtitleInfoInsp').hide();\n  $('#subtitleInfPago').hide();\n  $('#subtitleAnaSini').hide();\n  $('#subtitleGestAjusExter').hide();\n  $('#subtitleGestAjusInter').hide();\n  $('#subtitleRecomenda').hide();\n  $('#subtitleSubrSalv').hide();\n  $('#subtitleAtenCaso').hide();\n  $('#sub_titlePoliza').hide();\n  $('#fle_respaldosInspeccion').hide();\n  $('#sub_companias_coaseguradas').hide();\n  $('#930411861658b16b7c6ffe2080159750').hide();\n  $('#72023205665542581b5be35026876051').hide();\n\n\n}\nfunction mostrar_documentos() {\n  $('#27509649065667f59aa7000055860950').show(); // *** Documentos de respaspaldo\n}\nfunction mostrar_historial() {\n  $('#7403890606552d71dbfcce0019230087').show(); // ** Historial de casos \n}\nfunction ocultar_documentos() {\n  $('#27509649065667f59aa7000055860950').hide(); // *** Documentos de respaspaldo\n}\nfunction ocultar_historial() {\n  $('#7403890606552d71dbfcce0019230087').hide(); // ** Historial de casos \n}\n\n$('.menu').on('click', function () {\n  switch (this.id) {\n    case 'menu1':\n      mostrar_solicitud();\n      ocultar_documentos();\n      ocultar_historial();\n      //ocultarInspeccion();\n      break;\n    case 'menu2':\n      ocultar_solicitud();\n      ocultar_documentos();\n      mostrar_historial();\n      break;\n    case 'menu3':\n      ocultar_solicitud();\n      mostrar_documentos();\n      ocultar_historial();\n      break;\n  }\n})\n\n\nlet tri_bandera_inspeccion = $('#tri_bandera_inspeccion').getValue();\n\n\nfunction ocultarInspeccion() {\n  if (tri_bandera_inspeccion == null || tri_bandera_inspeccion == '' || tri_bandera_inspeccion == ' ' || tri_bandera_inspeccion == undefined || tri_bandera_inspeccion == 'undefined') {\n    $('#subtitleInfPago').hide();\n    $('#4479316636552d520db0b22003258870').hide();\n    $('#7403890606552d71dbfcce0019230087').hide();\n    $('#subtitleAnaSini').hide();\n    $('#3524701026552e2db3b1ce7038906501').hide();\n    $('#subtitleGestAjusExter').hide();\n    $('#26930265365541e148c32f9051535276').hide();\n    $('#subtitleRecomenda').hide();\n    $('#73833911165542a9e820942098465603').hide();\n    $('#subtitleSubrSalv').hide();\n    $('#30141999765542f7db73941014259095').hide();\n    $('#72023205665542581b5be35026876051').hide();\n    $('#frm_as_valorSiniestro').disableValidation();\n    $('#frm_as_valorSiniestro').hide();\n    $('#frm_as_tipoGestion').disableValidation();\n    $('#frm_as_tipoGestion').hide();\n    $('#frm_as_reclamoSuperaDeducible').disableValidation();\n    $('#frm_as_reclamoSuperaDeducible').hide();\n    $('#frm_as_valorTotal').disableValidation();\n    $('#frm_as_valorTotal').hide();\n\n  }\n}\n/*\nif (tri_bandera_inspeccion == null || tri_bandera_inspeccion == '' || tri_bandera_inspeccion == ' ' || tri_bandera_inspeccion == undefined || tri_bandera_inspeccion == 'undefined') {\n  $('#subtitleInfPago').hide();\n  $('#4479316636552d520db0b22003258870').hide();\n  $('#7403890606552d71dbfcce0019230087').hide();\n  $('#subtitleAnaSini').hide();\n  $('#3524701026552e2db3b1ce7038906501').hide();\n  $('#subtitleGestAjusExter').hide();\n  $('#26930265365541e148c32f9051535276').hide();\n  $('#subtitleRecomenda').hide();\n  $('#73833911165542a9e820942098465603').hide();\n  $('#subtitleSubrSalv').hide();\n  $('#30141999765542f7db73941014259095').hide();\n  $('#72023205665542581b5be35026876051').hide();\n  $('#frm_as_valorSiniestro').disableValidation();\n  $('#frm_as_valorSiniestro').hide();\n  $('#frm_as_tipoGestion').disableValidation();\n  $('#frm_as_tipoGestion').hide();\n  $('#frm_as_reclamoSuperaDeducible').disableValidation();\n  $('#frm_as_reclamoSuperaDeducible').hide();\n  $('#frm_as_valorTotal').disableValidation();\n  $('#frm_as_valorTotal').hide();\n}*/\n\nfunction salvamento(newVal, oldVal) {\n  $('#72023205665542581b5be35026876051').hide();\n\n  if (newVal == 'SI') {\n    $('#72023205665542581b5be35026876051').show();\n  } else {\n    $('#72023205665542581b5be35026876051').hide();\n  }\n}\n\nsalvamento($('#frm_ss_existeSalvamento').getValue(), '');\n$('#frm_ss_existeSalvamento').setOnchange(salvamento);\n\n\n\n\nconsole.log('CHECK BANDERA');\n\nfunction checkAccion(newVal, oldVal) {\n  $(\"#chk_docs_basicos_grid\").hide();\n  \n  if (newVal == 'DOCUMENTAR') {\n    $(\"#chk_docs_basicos_grid\").show();\n\n\n  } \n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_ac_accion\").getValue(), '');\n$('#frm_ac_accion').setOnchange(checkAccion);\n\n$(\"#frm_as_requiereAjustador\").getControl().attr('disabled', true);\n$(\"#frm_as_tipoAjustador\").getControl().attr('disabled', true);\n$(\"#frm_as_causaRequerimientoAjustador\").getControl().attr('disabled', true);\n$(\"#frm_as_nombreAjustadorAsignado\").getControl().attr('disabled', true);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"REVISAR SINIESTRO AJUSTADOR","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"frm_hd_NroStro","var_uid":"5876395246552d69d598378088666542","dataType":"string","protectedValue":false,"id":"frm_hd_NroStro","name":"frm_hd_NroStro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_hd_NroStro","colSpan":2},{"type":"hidden","variable":"tri_bandera_inspeccion","var_uid":"968245391658b0f63173462025578744","dataType":"string","protectedValue":false,"id":"tri_bandera_inspeccion","name":"tri_bandera_inspeccion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_inspeccion","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}],[{"type":"panel","id":"panel0000000001","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"menu1\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>SOLICITUD</h4></a></li>\n  <li id=\"menu3\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>DOCUMENTOS</h4></a></li>\n  <li id=\"menu2\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>HISTORIAL</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6706953386577ecb13d8070050567896","name":"SubForm Mensaje siniestro","description":"SubForm Mensaje siniestro","mode":"edit","script":{"type":"js","code":"\n/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n\n/*$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");*/\n\nif ($(\"#tri_id_stro\").getValue() == null || $(\"#tri_id_stro\").getValue() == \"\") {\n    $(\"#id-stro\").html('' + $(\"#nro_stro\").getValue());\n} else {\n    $(\"#id-stro\").html('' + $(\"#tri_id_stro\").getValue());\n\n}\n\n\n\nif ($(\"#tri_nro_stro\").getValue() == null || $(\"#tri_nro_stro\").getValue() == \"\" || $(\"#tri_nro_stro\").getValue() == \" - 2024\") {\n    $(\"#nro-stro\").html('' + $(\"#nro_inspeccion\").getValue() + $(\"#tri_nro_stro\").getValue());\n} else {\n    $(\"#nro-stro\").html('' + $(\"#tri_nro_stro\").getValue() );\n}\n"},"language":"en","externalLibs":"/plugin/ph_soluciones/core_librerias/js_externos/app.min.js,\n\n/plugin/ph_soluciones/core_librerias/css_externos/AdminLTE.min.css, /plugin/ph_soluciones/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>NRO RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NRO REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"1453936926577ecb972dba9013266489","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"8263423596577ecb9768160070254345","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"6438257896577ecb979bf40098401040","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"8169175466577ecb97cae60007912358","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"2937079996577ecb97faa67091523565","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}],[{"type":"hidden","variable":"nro_stro","var_uid":"34489768465fd278523fff4037463461","dataType":"string","protectedValue":false,"id":"nro_stro","name":"nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_stro","colSpan":6},{"type":"hidden","variable":"nro_inspeccion","var_uid":"30965624465fd277d4f12f2064306707","dataType":"string","protectedValue":false,"id":"nro_inspeccion","name":"nro_inspeccion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_inspeccion","colSpan":6}]],"variables":[{"var_uid":"1453936926577ecb972dba9013266489","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"8263423596577ecb9768160070254345","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"6438257896577ecb979bf40098