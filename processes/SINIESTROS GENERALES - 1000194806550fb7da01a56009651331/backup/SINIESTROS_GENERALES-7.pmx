AJUSTADORES_EXTERNOS","label":"EXTERNO"}],"var_name":"frm_as_tipoAjustador","colSpan":6},{"type":"text","variable":"frm_as_causaRequerimientoAjustador","var_uid":"1542163966552e3fa310065068944056","dataType":"string","protectedValue":false,"id":"frm_as_causaRequerimientoAjustador","name":"frm_as_causaRequerimientoAjustador","label":"Motivo designación ajustador","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"200","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_as_causaRequerimientoAjustador","colSpan":6}],[{"type":"dropdown","variable":"frm_as_nombreAjustadorAsignado","var_uid":"8924356396552e46e691284098313111","dataType":"string","protectedValue":false,"id":"frm_as_nombreAjustadorAsignado","name":"frm_as_nombreAjustadorAsignado","label":"Ajustador Asignado:","tabIndex":"","defaultValue":"@@USER_LOGGED","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT\n    U.USR_UID AS VALUE,\n    UPPER(CONCAT( U.USR_LASTNAME)) AS LABEL\nFROM USERS U\nINNER JOIN GROUP_USER G ON U.USR_UID = G.USR_UID\nINNER JOIN GROUPWF W ON G.GRP_UID = W.GRP_UID\nWHERE\n    W.GRP_TITLE = '@#frm_as_tipoAjustador' OR GRP_TITLE = \"SINIESTROS_ANALISTAS_GN_INSURANCE\"\nORDER BY LABEL;","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_as_nombreAjustadorAsignado","colSpan":6},{"type":"text","variable":"frm_as_emailAjustadorAsignado","var_uid":"6440481166552e4973c51e3072059648","dataType":"string","protectedValue":false,"id":"frm_as_emailAjustadorAsignado","name":"frm_as_emailAjustadorAsignado","label":"Email Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_EMAIL, USR_EMAIL FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_emailAjustadorAsignado","colSpan":6}],[{"type":"text","variable":"frm_as_telefonoAjustadorAsignado","var_uid":"8130118776552e4d7e17709097485944","dataType":"string","protectedValue":false,"id":"frm_as_telefonoAjustadorAsignado","name":"frm_as_telefonoAjustadorAsignado","label":"Teléfono Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"15","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_PHONE, USR_PHONE FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_telefonoAjustadorAsignado","colSpan":6},{"colSpan":6}],[{"type":"multipleFile","variable":"fle_docs_analista","var_uid":"700381588657a0d3254fa11080602868","dataType":"multiplefile","protectedValue":false,"id":"fle_docs_analista","name":"fle_docs_analista","label":"Adjuntar Documentos","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"4072964256579d07f770873059916631","var_name":"fle_docs_analista","colSpan":6},{"colSpan":6}],[{"type":"hidden","variable":"tri_usr_analista","var_uid":"9925086416579be2b110c47058079584","dataType":"string","protectedValue