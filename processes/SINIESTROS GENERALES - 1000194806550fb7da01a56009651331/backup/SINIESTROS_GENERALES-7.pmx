@@tri_text_hora_ocurrencia = $fec_hora_recepcion_in;

//fecha is in dd-MM-YYYYT12:20:49Z and it should be in 2024-01-03T12:20:49Z

$date_fecha_hora = date("Y-m-d\TH:i:s\Z", time());
