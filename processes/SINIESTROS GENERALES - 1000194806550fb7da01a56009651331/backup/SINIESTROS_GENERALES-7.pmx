tri_usr_analista_2","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"34033056765a6b55a27d006067214927","prj_uid":"1000194806550fb7da01a56009651331","var_name":"file_cartaDeducible","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"34033056765a6b55a27d006067214927","var_name_old":"file_cartaDeducible","prj_uid_old":"1000194806550fb7da01a56009651331"},{"var_uid":"872940281659b6fe3645064051723706","prj_uid":"1000194806550fb7da01a56009651331","var_name":"chk_docs_basicos_grid","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"872940281659b6fe3645064051723706","var_name_old":"chk_docs_basicos_grid","prj_uid_old":"1000194806550fb7da01a56009651331"}]}]}]]></dyn_content>
