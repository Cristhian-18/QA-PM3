        <dyn_content><![CDATA[{"name":"SubForm Mensaje siniestro","description":"SubForm Mensaje siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6706953386577ecb13d8070050567896","name":"SubForm Mensaje siniestro","description":"SubForm Mensaje siniestro","mode":"edit","script":{"type":"js","code":"\n/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n\n/*$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");*/\n\nif ($(\"#tri_id_stro\").getValue() == null || $(\"#tri_id_stro\").getValue() == \"\") {\n    $(\"#id-stro\").html('' + $(\"#nro_stro\").getValue());\n} else {\n    $(\"#id-stro\").html('' + $(\"#tri_id_stro\").getValue());\n\n}\n\n\n\nif ($(\"#tri_nro_stro\").getValue() == null || $(\"#tri_nro_stro\").getValue() == \"\" || $(\"#tri_nro_stro\").getValue() == \" - 2024\") {\n    $(\"#nro-stro\").html('' + $(\"#nro_inspeccion\").getValue() + $(\"#tri_nro_stro\").getValue());\n} else {\n    $(\"#nro-stro\").html('' + $(\"#tri_nro_stro\").getValue() );\n}\n"},"language":"en","externalLibs":"/plugin/ph_soluciones/core_librerias/js_externos/app.min.js,\n\n/plugin/ph_soluciones/core_librerias/css_externos/AdminLTE.min.css, /plugin/ph_soluciones/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>NRO RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NRO REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"1453936926577ecb972dba9013266489","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"8263423596577ecb9768160070254345","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"6438257896577ecb979bf40098401040","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"8169175466577ecb97cae60007912358","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri