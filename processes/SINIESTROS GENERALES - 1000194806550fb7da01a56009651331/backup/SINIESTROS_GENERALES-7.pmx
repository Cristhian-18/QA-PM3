<td><font size="1">@#frm_rip_textoDeducible</font></td>
</tr>
<tr>
<td><font size="1">TABLA DEPRECIACI&Oacute;N</font></td>
<td><font size="1">@#frm_rip_tablaDepreciacion</font></td>
<td><font size="1">CIRCUNSTANCIA EVENTO</font></td>
<td><font size="1">@#frm_rip_circunstanciaEvento</font></td>
</tr>
<tr>
<td><font size="1">GESTIONES REALIZADAS</font></td>
<td colspan="3"><font size="1">@#frm_rip_gestionesRealizadas</font></td>
</tr>
<tr>
<td><font size="1"><b>6. RESERVA SUGERIDAS</b></font></td>
<td colspan="3"></td>
</tr>
<tr>
<td><font size="1">VALOR LUEGO DEDUCIBLE</font></td>
