$cnx = '736600101659ece82736670094820028';
//estado de la bandera
$sql = "SELECT id, bandera FROM SINIESTRO_GN_CONFIGURACION WHERE id = (SELECT MAX(id) FROM SINIESTRO_GN_CONFIGURACION)";
