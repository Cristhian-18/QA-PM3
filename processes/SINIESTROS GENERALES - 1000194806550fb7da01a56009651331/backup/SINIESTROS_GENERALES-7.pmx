g","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5876395246552d69d598378088666542","var_name_old":"frm_hd_NroStro","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"629479048657b3cb7853664082031983","prj_uid":"1000194806550fb7da01a56009651331","var_name":"fle_respaldosInspeccion","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"629479048657b3cb7853664082031983","var_name_old":"fle_respaldosInspeccion","prj_uid_old":"1000194806550fb7da01a56009651331","create":false}]}]}]]></dyn_content>
