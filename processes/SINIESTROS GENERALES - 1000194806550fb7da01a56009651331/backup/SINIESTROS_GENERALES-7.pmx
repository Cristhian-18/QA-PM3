dex":"","ariaLabel":"","colSpan":12}]],"variables":[{"var_uid":"5876395246552d69d598378088666542","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_hd_NroStro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5876395246552d69d598378088666542","var_name_old":"frm_hd_NroStro","prj_uid_old":"1000194806550fb7da01a56009651331","create":false},{"var_uid":"48606129365ad5b0f59d524069143427","prj_uid":"1000194806550fb7da01a56009651331","var_name":"file_confimacionBroker","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
