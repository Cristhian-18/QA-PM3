<td><font size="1">@#frm_da_correoElectronico</font></td>
</tr>
<tr>
<td><font size="1">FECHA REGISTRO</font></td>
<td><font size="1">@#frm_da_FechaRegistro</font></td>
<td><font size="1">FECHA NOTIFICACI&Oacute;N</font></td>
<td><font size="1">@#frm_da_fechaNotificacion</font></td>
</tr>
<tr>
<td><font size="1">N.- POLIZA</font></td>
<td><font size="1">@#frm_rs_NroPoliza - @#frm_ds_tipoOperacion</font></td>
<td><font size="1">N.- SINIESTRO</font></td>
<td><font size="1"> @#frm_is_CodcausaSiniestro - @#frm_is_causaSiniestro </font></td>
</tr>
<tr>
<td><font size="1">N.- REPORTE</font></td>
<td><font size="1">@#APP_NUMBER</font></td>
<td><font size="1">FECHA OCURRENCIA</font></td>
<td><font size="1">@#frm_da_fechaNotificacion</font></td>
</tr>
<tr>
<td><font size="1">LINEA NEGOCIO</font></td>
<td><font size="1">@#frm_ds_lineaNegocio</font></td>
<td><font size="1">SUBLINEA NEGOCIO</font></td>
<td><font size="1">@#frm_ds_SublineaNegocio</font></td>
</tr>
<tr>
<td><font size="1">SUMA ASEGURADA</font></td>
<td><font size="1">$ @#frm_ds_sumaAsegurada</font></td>
