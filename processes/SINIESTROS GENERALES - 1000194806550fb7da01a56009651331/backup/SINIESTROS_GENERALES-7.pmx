<td><font size="1">@#frm_ds_fechaFinVigenciaUltimafacturacion</font></td>
</tr>
<tr>
<td><font size="1">RAMO</font></td>
<td><font size="1">@#frm_poliza_ramo</font></td>
<td></td>
<td></td>
</tr>
<tr>
<td><font size="1"><b>2. CIRCUNSTANCIAS DEL EVENTO</b></font></td>
<td colspan="3"></td>
</tr>
<tr>
<td><font size="1">REPORTADO POR</font></td>
<td><font size="1"> @#frm_is_nombreApellidosResponsableNotificacion </font></td>
<td><font size="1">INCISO AFECTADO</font></td>
<td><font size="1">@#frm_is_incisoAfectado</font></td>
</tr>
<tr>
<td><font size="1">EMAIL</font></td>
<td><font size="1">@#frm_is_emailResponsableNotificacion</font></td>
