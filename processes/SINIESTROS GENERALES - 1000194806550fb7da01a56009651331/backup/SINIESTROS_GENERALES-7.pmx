        <dyn_content><![CDATA[{"name":"Form 0 Asignar SISE","description":"Asignar SISE","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"27940000565e5589d798841016410751","name":"Form 0 Asignar SISE","description":"Asignar SISE","mode":"edit","script":{"type":"js","code":"\nocultar_solicitud();\nmostrar_solicitud();\nocultar_documentos();\nocultar_historial();\n\n$('#frm_as_reclamoSuperaDeducible').disableValidation();\n$('#27940000565e5589d798841016410751').disableValidation();\n\n\nfunction mostrar_solicitud() {\n  $('#46098314565510a5cd57553018796264').show(); // Datos asegurado \n  $('#14607804465510ee3e00a05082909351').show(); // Datos siniestro\n  $('#18277194465787f6590bb75083746853').show(); // Datos poliza\n  $('#7403890606552d71dbfcce0019230087').show(); // Historial de casos\n  $('#56993520565511b0c807296060115467').show(); // Siniestros registrados\n  //$('#37397912265511ee4965f19044370072').show(); // Alcance a siniestro\n  $('#462863856655124050411a0083795803').show(); // Información siniestro\n  $('#16423784965514772ad1aa4003438500').show(); // Direcciones bienes\n  $('#3991222066552d3306b3be8000113907').show(); // Información inspección\n  //$('#4479316636552d520db0b22003258870').show(); // Información pago\n  $('#3524701026552e2db3b1ce7038906501').show(); // Análisis siniestro\n  //$('#26930265365541e148c32f9051535276').show(); // Gestión informe ajustador externo\n  //$('#124534031655423d6933cf3054917309').show(); // Gestión informe ajustador interno\n  //$('#73833911165542a9e820942098465603').show(); // Recomendaciones\n  //$('#30141999765542f7db73941014259095').show(); // Subrogaciones/salvamentos\n  $('#258163566655432b663f282099762126').show(); // Atención al caso\n  $('#502697178658351be3b93a1020343316').hide(); // Informe Final\n  $('#subtitleDatase').show();\n  $('#subtitleDatoSini').show();\n  $('#subtitleDatGes').show();\n  $('#subtitleSiniReg').show();\n  $('#subtitleAlcaSin').show();\n  $('#subtitleInformacionSiniestro').show();\n  $('#subtitleDireBien').show();\n  $('#subtitleInfoInsp').show();\n  $('#subtitleInfPago').show();\n  $('#subtitleAnaSini').show();\n  $('#subtitleGestAjusExter').show();\n  $('#subtitleGestAjusInter').show();\n  $('#subtitleRecomenda').show();\n  $('#subtitleSubrSalv').show();\n  $('#subtitleAtenCaso').show();\n      $('#tri_nro_stro').show();\n  $('#tri_id_stro').show();\n    //  $('#tri_usr_analista').show();\n\n  fastTrack($(\"#frm_as_tipoGestion\").getValue(), '');\n\n  let tipo_operacion = $(\"#frm_ac_tipoOperacion\").getValue();\n\n  if (tipo_operacion == 'COASEGURO CEDIDO') {\n    $('#sub_companias_coaseguradas').show();\n    $('#930411861658b16b7c6ffe2080159750').show();\n  }\n  if (tipo_operacion == 'COASEGURO ACEPTADO') {\n    $('#subtitleInfoInsp').hide();\n    $('#3991222066552d3306b3be8000113907').hide();\n\tconsole.log(\"COASEGURO ACEPTADO\");\n  }\n\n\n}\nfunction ocultar_solicitud() {\n  $('#sub_companias_coaseguradas').hide();\n  $('#930411861658b16b7c6ffe2080159750').hide();\n  $('#46098314565510a5cd57553018796264').hide();\n  $('#14607804465510ee3e00a05082909351').hide();\n  $('#18277194465787f6590bb75083746853').hide();\n  $('#7403890606552d71dbfcce0019230087').hide();\n  $('#56993520565511b0c807296060115467').hide();\n  $('#462863856655124050411a0083795803').hide();\n  $('#16423784965514772ad1aa4003438500').hide();\n  $('#3991222066552d3306b3be8000113907').hide();\n  $('#3524701026552e2db3b1ce7038906501').hide();\n  $('#258163566655432b663f282099762126').hide();\n  //$('#502697178658351be3b93a1020343316').hide(); \n  $('#subtitleDatase').hide();\n  $('#subtitleDatoSini').hide();\n  $('#subtitleDatGes').hide();\n  $('#subtitleSiniReg').hide();\n  $('#subtitleAlcaSin').hide();\n  $('#subtitleInformacionSiniestro').hide();\n  $('#subtitleDireBien').hide();\n  $('#subtitleInfoInsp').hide();\n  $('#subtitleInfPago').hide();\n  $('#subtitleAnaSini').hide();\n  $('#subtitleGestAjusExter').hide();\n  $('#subtitleGestAjusInter').hide();\n  $('#subtitleRecomenda').hide();\n  $('#subtitleSubrSalv').hide();\n  $('#subtitleAtenCaso').hide();\n    $('#tri_nro_stro').hide();\n  $('#tri_id_stro').hide();\n    //$('#tri_usr_analista').hide();\n\n  \n  \n}\nfunction mostrar_documentos() {\n  $('#27509649065667f59aa7000055860950').show(); // *** Documentos de respaspaldo\n}\nfunction mostrar_historial() {\n  $('#7403890606552d71dbfcce0019230087').show(); // ** Historial de casos \n}\nfunction ocultar_documentos() {\n  $('#27509649065667f59aa7000055860950').hide(); // *** Documentos de respaspaldo\n}\nfunction ocultar_historial() {\n  $('#7403890606552d71dbfcce0019230087').hide(); // ** Historial de casos \n}\n\nfunction fastTrack(newVal, oldVal) {\n\n  $('#subtitleInfoInsp').hide();\n  $('#3991222066552d3306b3be8000113907').hide();\n  let tipo_operacion = $(\"#frm_ac_tipoOperacion\").getValue();\n\n  if (newVal != 'FASTTRACK' && tipo_operacion != 'COASEGURO ACEPTADO') {\n    $('#subtitleInfoInsp').show();\n    $('#3991222066552d3306b3be8000113907').show();\n  }\n}\nfastTrack($(\"#frm_as_tipoGestion\").getValue(), '');\n$('#frm_as_tipoGestion').setOnchange(fastTrack);\n\n$('.menu').on('click', function () {\n  switch (this.id) {\n    case 'menu1':\n      mostrar_solicitud();\n      ocultar_documentos();\n      ocultar_historial();\n      break;\n    case 'menu2':\n      ocultar_solicitud();\n      ocultar_documentos();\n      mostrar_historial();\n      break;\n    case 'menu3':\n      ocultar_solicitud();\n      mostrar_documentos();\n      ocultar_historial();\n      break;\n  }\n})\n\n\n//$(\"#tri_usr_analista\").hide();\n\n\nfunction accion(newValue, oldValue) {\n  $('#30510795265850a90c04265058882654').hide();\n // $(\"#tri_usr_analista\").hide();\n  $('#chk_docs_basicos_grid').hide();\n  $('#file_cartaDeducible').hide();\n\n  var tipo = $(\"#frm_as_tipoGestion\").getValue();\n  if (newValue == 'NEGAR') {\n    $('#30510795265850a90c04265058882654').show();\n  }\n  if (newValue == 'REASIGNAR') {\n    $('#tri_usr_analista').show();\n  }\n  if (newValue == 'DOCUMENTAR') {\n    $('#chk_docs_basicos_grid').show();\n  }\n  if (newValue == 'DEDUCIBLE') {\n    $('#file_cartaDeducible').show();\n  }\n  if (newValue == 'APROBAR' && tipo == 'FASTTRACK') {\n    $(\"#502697178658351be3b93a1020343316\").show();\n  } else {\n    $(\"#502697178658351be3b93a1020343316\").hide();\n  }\n}\nif ($(\"#frm_ac_accion\").getValue() != '') {\n  var dato = $(\"#frm_ac_accion\").getValue();\n  accion(dato, '');\n}\n\naccion($(\"#frm_ac_accion\").getValue(), '');\n$(\"#frm_ac_accion\").setOnchange(accion);\n\nfunction accionEquisuiza(newValue, oldValue) {\n  //tri_usr_analista\n  $(\"#tri_usr_analista\").hide();\n\n  if (newValue == 'INSURANCE') {\n    $(\"#tri_usr_analista\").show();\n  }\n \n}\n\naccionEquisuiza($(\"#frm_accion\").getValue(), '');\n$(\"#frm_accion\").setOnchange(accionEquisuiza);\n\nlet suma = 0;\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"AUDITORÍA TÉCNICA","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"frm_hd_NroStro","var_uid":"5876395246552d69d598378088666542","dataType":"string","protectedValue":false,"id":"frm_hd_NroStro","name":"frm_hd_NroStro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_hd_NroStro","colSpan":12}],[{"type":"panel","id":"panel00000000001","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"menu1\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>SOLICITUD</h4></a></li>\n  <li id=\"menu3\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>DOCUMENTOS</h4></a></li>\n  <li id=\"menu2\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>HISTORIAL</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"subtitle","id":"subtitleDatase","label":"<span class=\"subtitulo\" id=\"isub_titleDatase\" subform=\"46098314565510a5cd57553018796264\"> <i class=\"glyphicon glyphicon-minus\"></i> Datos asegurado</span>","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"error_detail","var_uid":"37659786765fd980a059fe4073294995","dataType":"string","protectedValue":false,"id":"error_detail","name":"error_detail","label":"Detalle de error","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"error_detail","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"46098314565510a5cd57553018796264","name":"SF IDS Datos asegurado","description":"","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_origen_core_insurance","var_uid":"43864822868da1eb7e66276038477304","dataType":"string","protectedValue":false,"id":"frm_origen_core_insurance","name":"frm_origen_core_insurance","label":"Origen","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_origen_core_insurance","colSpan":6},{"type":"text","variable":"frm_reclamante_core_insurance","var_uid":"66408874868f104513cbee2035645524","dataType":"string","protectedValue":false,"id":"frm_reclamante_core_insurance","name":"frm_reclamante_core_insurance","label":"Reclamante","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLen