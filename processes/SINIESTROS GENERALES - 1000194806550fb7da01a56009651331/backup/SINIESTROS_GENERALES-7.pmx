ction":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT\n    U.USR_UID,\n    UPPER(CONCAT(\n        USR_LASTNAME\n    )\n) AS NOMBRE\nFROM USERS U, GROUP_USER G\nWHERE\n    U.USR_UID = G.USR_UID\n    AND GRP_UID = (\n        SELECT\n            GRP_UID\n        FROM GROUPWF\n        WHERE GRP_TITLE = \"@#frm_as_tipoAjustador\"\n    )\n","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_as_nombreAjustadorAsignado","colSpan":6},{"type":"text","variable":"frm_as_emailAjustadorAsignado","var_uid":"6440481166552e4973c51e3072059648","dataType":"string","protectedValue":false,"id":"frm_as_emailAjustadorAsignado","name":"frm_as_emailAjustadorAsignado","label":"Email Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_EMAIL, USR_EMAIL FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_emailAjustadorAsignado","colSpan":6}],[{"type":"text","variable":"frm_as_telefonoAjustadorAsignado","var_uid":"8130118776552e4d7e17709097485944","dataType":"string","protectedValue":false,"id":"frm_as_telefonoAjustadorAsignado","name":"frm_as_telefonoAjustadorAsignado","label":"Teléfono Ajustador Asignado:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"15","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT USR_PHONE, USR_PHONE FROM USERS WHERE USR_UID = '@#frm_as_nombreAjustadorAsignado'","memoryCache":false,"var_name":"frm_as_telefonoAjustadorAsignado","colSpan":6},{"colSpan":6}],[{"