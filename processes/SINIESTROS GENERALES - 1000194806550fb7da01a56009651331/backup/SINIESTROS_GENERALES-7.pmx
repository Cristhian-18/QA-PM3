:"PM Database","sql":"","memoryCache":false,"var_name":"frm_ii_fechaHoraContacto","colSpan":6},{"type":"text","variable":"frm_ii_HoraContacto","var_uid":"551846408657894620a7d70018767028","dataType":"string","protectedValue":false,"id":"frm_ii_HoraContacto","name":"frm_ii_HoraContacto","label":"Hora Inspecci\u00f3n:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ii_HoraContacto","colSpan":6}],[{"type":"text","variable":"frm_ii_direccionInspeccion","var_uid":"2243642116552d3b409f9b0064703433","dataType":"string","protectedValue":false,"id":"frm_ii_direccionInspeccion","name":"frm_ii_direccionInspeccion","label":"Direcci\u00f3n Inspecci\u00f3n:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"500","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ii_direccionInspeccion","colSpan":12}]],"variables":[{"var_uid":"7137379026552d40d5f82f5039209470","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_personaContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8640533196552d44a88bf63095676829","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_telefonoContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"248383469657892db8ae2e9029984744","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_emailContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"11140805465e72378d1f7a3048557428","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_horadecontacto","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"436624808657893454eee56069202759","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_fechaHoraContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"551846408657894620a7d70018767028","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_HoraContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2243642116552d3b409f9b0064703433","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ii_direccionInspeccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
