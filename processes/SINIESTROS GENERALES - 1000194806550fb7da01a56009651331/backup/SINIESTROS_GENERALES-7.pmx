l_fiscalia\").show();\n        $(\"#file_siniestroInusual_judicatura\").show();\n        $(\"#file_siniestroInusual_super\").show();\n        $(\"#sub_siniestroInusual_causal\").show();\n        $(\"#frm_siniestroInusual_categoria\").show();\n        $(\"#frm_siniestroInusual_observaciones\").show();\n\n        $(\"#file_siniestroInusual_fiscalia\").enableValidation();\n        $(\"#file_siniestroInusual_judicatura\").enableValidation();\n        $(\"#file_siniestroInusual_super\").enableValidation();\n        $(\"#sub_siniestroInusual_causal\").enableValidation();\n        $(\"#frm_siniestroInusual_categoria\").enableValidation();\n        $(\"#frm_siniestroInusual_observaciones\").enableValidation();\n\n        //if bandera_inusual == 1, disable sub_siniestroInusual_causal\n        let bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\n        if(bandera_inusual == '1'){\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', true);\n        } else {\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', false);\n        }\n    \n    }\n\n}\ncheckInusual($(\"#frm_siniestroInusual_check\").getValue(), ''); \n$('#frm_siniestroInusual_check').setOnchange(checkInusual);\n\nlet bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\nif(bandera_inusual == '1'){\n    //disable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', true);\n\n} else {\n    //enable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', false);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"sub_siniestro_inusual","label":"Siniestro inusual","ariaLabel":"","colSpan":12}],[{"type":"radio","variable":"frm_siniestroInusual_check","var_uid":"420016371662755a78b8725083037112","dataType":"boolean","protectedValue":false,"id":"frm_siniestroInusual_check","name":"frm_siniestroInusual_check","label":"¿Siniestro Inusual?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Si"},{"value":"0","label":"No"}],"var_name":"frm_siniestroInusual_check","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_fiscalia","var_uid":"760834502662755a7a8d9b7055395516","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_fiscalia","name":"file_siniestroInusual_fiscalia","label":"Fiscalia","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_fiscalia","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_judicatura","var_uid":"604610493662755a7c1f1e7089020418","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_judicatura","name":"file_siniestroInusual_judicatura","label":"Judicatura","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_judicatura","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_super","var_uid":"224437546662755a7e02733044316516","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_super","name":"file_siniestroInusual