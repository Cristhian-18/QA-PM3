  <body>
<table border="0" cellspacing="0" cellpadding="0" style="width: 100%;">
<tbody>
<tr>
<td width="100%" colspan="4" valign="top"><font size="1"> <img src="https://imagenesweb.equisuiza.com/imagenesweb/Generales/BPM%20siniestros%20VH%20y%20Generales/SINIESTROS%20GENERALES/Salidas/links/logo2.png" class="img-responsive" alt="equisuiza" /> </font></td>
</tr>
</tbody>
</table>
<table>
<tbody>
<tr>
<td colspan="4" style="background: #ccc; text-align: center;"><font size="1"><b>INFORME PRELIMINAR</b></font></td>
</tr>
<tr>
<td><font size="1"><b>1. POLIZA Y DATOS DE ASEGURADO</b></font></td>
<td colspan="3"></td>
</tr>
<tr>
<td><font size="1">CI/RUC</font></td>
<td><font size="1">@#frm_da_NoDocumentoContratate</font></td>
