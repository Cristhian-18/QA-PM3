        <dyn_content><![CDATA[{"name":"Form 3 Solicitar informaci\u00f3n reaseguradoras","description":"Form 3 Solicitar informaci\u00f3n reaseguradoras","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"710765774659cc2ec8922e8027532945","name":"Form 3 Solicitar informaci\u00f3n reaseguradoras","description":"Form 3 Solicitar informaci\u00f3n reaseguradoras","mode":"edit","script":{"type":"js","code":"\nmostrar_solicitud();\nocultar_documentos();\nocultar_historial();\nfunction mostrar_solicitud(){\n$('#46098314565510a5cd57553018796264').show(); \/\/ Datos asegurado \n$('#14607804465510ee3e00a05082909351').show(); \/\/ Datos siniestro\n\/\/$('#19482908265511238869e34082628309').show(); \/\/ Datos gesti\u00f3n\n$('#7403890606552d71dbfcce0019230087').show(); \/\/ Historial de casos\n$('#56993520565511b0c807296060115467').show(); \/\/ Siniestros registrados\n\/\/$('#37397912265511ee4965f19044370072').show(); \/\/ Alcance a siniestro\n$('#462863856655124050411a0083795803').show(); \/\/ Informaci\u00f3n siniestro\n$('#16423784965514772ad1aa4003438500').show(); \/\/ Direcciones bienes\n\/\/$('#3991222066552d3306b3be8000113907').show(); \/\/ Informaci\u00f3n inspecci\u00f3n\n\/\/$('#4479316636552d520db0b22003258870').show(); \/\/ Informaci\u00f3n pago\n\/\/$('#3524701026552e2db3b1ce7038906501').show(); \/\/ An\u00e1lisis siniestro\n\/\/$('#26930265365541e148c32f9051535276').show(); \/\/ Gesti\u00f3n informe ajustador externo\n\/\/$('#124534031655423d6933cf3054917309').show(); \/\/ Gesti\u00f3n informe ajustador interno\n\/\/$('#73833911165542a9e820942098465603').show(); \/\/ Recomendaciones\n\/\/$('#30141999765542f7db73941014259095').show(); \/\/ Subrogaciones\/salvamentos\n$('#258163566655432b663f282099762126').show(); \/\/ Atenci\u00f3n al caso\n$('#3128780916579cf40ebf183063674198').show(); \/\/ Docs\n$('#subtitleDatase').show();\n$('#subtitleDatoSini').show();\n$('#subtitleDatGes').show();\n$('#subtitleSiniReg').show();\n$('#subtitleAlcaSin').show();\n$('#subtitleInformacionSiniestro').show();\n$('#subtitleDireBien').show();\n$('#subtitleInfoInsp').show();\n$('#subtitleInfPago').show();\n$('#subtitleAnaSini').show();\n$('#subtitleGestAjusExter').show();\n$('#subtitleGestAjusInter').show();\n$('#subtitleRecomenda').show();\n$('#subtitleSubrSalv').show();\n$('#subtitleAtenCaso').show();\n}\nfunction ocultar_solicitud(){\n    $('#46098314565510a5cd57553018796264').hide(); \n    $('#14607804465510ee3e00a05082909351').hide(); \n    \/\/$('#19482908265511238869e34082628309').hide(); \n    $('#7403890606552d71dbfcce0019230087').hide(); \n    $('#56993520565511b0c807296060115467').hide(); \n    \/\/$('#37397912265511ee4965f19044370072').hide(); \n    $('#462863856655124050411a0083795803').hide(); \n    $('#16423784965514772ad1aa4003438500').hide(); \n    \/\/$('#3991222066552d3306b3be8000113907').hide(); \n    \/\/$('#4479316636552d520db0b22003258870').hide(); \n    \/\/$('#3524701026552e2db3b1ce7038906501').hide(); \n    \/\/$('#26930265365541e148c32f9051535276').hide(); \n    \/\/$('#124534031655423d6933cf3054917309').hide(); \n    \/\/$('#73833911165542a9e820942098465603').hide(); \n    \/\/$('#30141999765542f7db73941014259095').hide(); \n    $('#258163566655432b663f282099762126').hide(); \n  $('#3128780916579cf40ebf183063674198').hide(); \/\/ Docs\n    $('#subtitleDatase').hide();\n    $('#subtitleDatoSini').hide();\n    $('#subtitleDatGes').hide();\n    $('#subtitleSiniReg').hide();\n    $('#subtitleAlcaSin').hide();\n    $('#subtitleInformacionSiniestro').hide();\n    $('#subtitleDireBien').hide();\n    $('#subtitleInfoInsp').hide();\n    $('#subtitleInfPago').hide();\n    $('#subtitleAnaSini').hide();\n    $('#subtitleGestAjusExter').hide();\n    $('#subtitleGestAjusInter').hide();\n    $('#subtitleRecomenda').hide();\n    $('#subtitleSubrSalv').hide();\n    $('#subtitleAtenCaso').hide();\n    }\nfunction mostrar_documentos(){\n  $('#27509649065667f59aa7000055860950').show(); \/\/ *** Documentos de respaspaldo\n  }\nfunction mostrar_historial(){\n  $('#7403890606552d71dbfcce0019230087').show(); \/\/ ** Historial de casos \n  }\nfunction ocultar_documentos(){\n  $('#27509649065667f59aa7000055860950').hide(); \/\/ *** Documentos de respaspaldo\n  }\nfunction ocultar_historial(){\n  $('#7403890606552d71dbfcce0019230087').hide(); \/\/ ** Historial de casos \n  }\n\n$('.menu').on('click', function(){\n     switch(this.id){       \n      case 'menu1' :\n      mostrar_solicitud();\n      ocultar_documentos();\n      ocultar_historial();\n      break;\n      case 'menu2' :\n      ocultar_solicitud();\n      ocultar_documentos();\n      mostrar_historial();\n      break;\n      case 'menu3' :\n      ocultar_solicitud();\n      mostrar_documentos();\n      ocultar_historial();\n      break;\n      }\n})\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"ATENCI\u00d3N SINIESTRO","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"frm_hd_NroStro","var_uid":"5876395246552d69d598378088666542","dataType":"string","protectedValue":false,"id":"frm_hd_NroStro","name":"frm_hd_NroStro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_hd_NroStro","colSpan":12}],[{"type":"panel","id":"panel0000000001","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"menu1\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>SOLICITUD<\/h4><\/a><\/li>\n  <li id=\"menu3\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>DOCUMENTOS<\/h4><\/a><\/li>\n  <li id=\"menu2\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>HISTORIAL<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6706953386577ecb13d8070050567896","name":"SubForm Mensaje siniestro","description":"SubForm Mensaje siniestro","mode":"edit","script":{"type":"js","code":"\/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*\/\n\/*$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");*\/\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"\/plugin\/ph_soluciones\/core_librerias\/js_externos\/app.min.js,\n\n\/plugin\/ph_soluciones\/core_librerias\/css_externos\/AdminLTE.min.css, \/plugin\/ph_soluciones\/core_librerias\/ionicons-2.0.1\/css\/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"><\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"><\/i><\/span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"><\/i><\/span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3\"><\/div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"><\/i> Mensaje...!<\/h4>\n    <h2><div id=\"html_op\"><\/div><\/h2>\n  <\/div>\n<\/div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","varia