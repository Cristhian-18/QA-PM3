<td><font size="1">@#frm_is_fonoResponsableNotificacion</font></td>
</tr>
<tr>
<td><font size="1">PAIS OCURRENCIA</font></td>
<td><font size="1">@#frm_is_paisOcurrencia</font></td>
<td><font size="1">PROVINCIA OCURRENCIA</font></td>
<td><font size="1">@#frm_is_provinciaOcurrencia</font></td>
</tr>
<tr>
<td><font size="1">CIUDAD OCURRENCIA</font></td>
<td><font size="1">@#frm_is_ciudadOcurrencia</font></td>
<td><font size="1">EMAIL ASEGURADO</font></td>
<td><font size="1"> @#frm_is_emailAsegurado1/@#frm_is_emailAsegurado2 </font></td>
</tr>
