	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue asignado a su bandeja para revisión del ajustador interno</tipo>
</p>';
} elseif ($accion == "CONTINUAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue asignado a su bandeja para revisión del PDA</tipo>
</p>';
}
elseif ($accion == "SOLICITAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' requiere de mas información</tipo>
</p>';
}
elseif ($accion == "ACTUALIZAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue asignado a su bandeja</tipo>
</p>';
}
elseif ($accion == "REQUERIR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' requiere de peritaje especial</tipo>
</p>';
}
elseif ($accion == "SUSTITUIR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' requiere de un auto sustituto</tipo>
</p>';
}
elseif ($accion == "PERDER"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue enviado al proceso de perdida total</tipo>
</p>';
}
elseif ($accion == "APROBAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue enviado a aprobación de la carta de deducible</tipo>
</p>';
}
elseif ($accion == "NEGAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' requiere de la generación de una carta de negativa</tipo>
</p>';
}
elseif ($accion == "FINALIZAR"){
	$texto .= '<p align="justify">Se le notifica que el caso '.$app_number.' fue enviado al proceso de cierre administrativo</tipo>
</p>';
}
else {
$texto .= '<p align="justify">Se le notifica que su caso necesita información adicional
	</tipo>
</p>';
}
