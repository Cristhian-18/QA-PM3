        <dyn_content><![CDATA[{"name":"SF I Registro salvamentos","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"72023205665542581b5be35026876051","name":"SF I Registro salvamentos","description":"","mode":"edit","script":{"type":"js","code":"function valorSalvamento(newVal, oldVal){\n    $(\"#frm_rs_ofertaAseguradoSalvamento\").hide();\n    if(newVal == \"SI\"){\n        $(\"#frm_rs_ofertaAseguradoSalvamento\").show();\n    }\n}\n\nvalorSalvamento($(\"#frm_rs_check_ofertaAseguradoSalvamento\").getValue(),'');\n$(\"#frm_rs_check_ofertaAseguradoSalvamento\").setOnchange(valorSalvamento);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_rs_nombreSalvamento","var_uid":"64385027965542783b9f7b5080966557","dataType":"string","protectedValue":false,"id":"frm_rs_nombreSalvamento","name":"frm_rs_nombreSalvamento","label":"Nombre Salvamento:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"200","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_nombreSalvamento","colSpan":4},{"type":"text","variable":"frm_rs_modeloSalvamento","var_uid":"314853360655427a5dd0f36046788107","dataType":"string","protectedValue":false,"id":"frm_rs_modeloSalvamento","name":"frm_rs_modeloSalvamento","label":"Modelo Salvamento:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_modeloSalvamento","colSpan":4},{"type":"text","variable":"frm_rs_serieSalvamento","var_uid":"364613799655427c3678118058816955","dataType":"string","protectedValue":false,"id":"frm_rs_serieSalvamento","name":"frm_rs_serieSalvamento","label":"Serie Salvamento:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_serieSalvamento","colSpan":4}],[{"type":"textarea","variable":"frm_rs_causaSalvamento","var_uid":"6580712436554298b70a7b6068194053","dataType":"string","protectedValue":false,"id":"frm_rs_causaSalvamento","name":"frm_rs_causaSalvamento","label":"Causa de Salvamento:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","var_name":"frm_rs_causaSalvamento","colSpan":12}],[{"type":"text","variable":"frm_rs_personaContacto","var_uid":"91217357465947330b3a408049698567","dataType":"string","protectedValue":false,"id":"frm_rs_personaContacto","name":"frm_rs_personaContacto","label":"Persona Contacto Salvamento:\t\t\t\t\t","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_personaContacto","colSpan":6},{"type":"text","variable":"frm_rs_numCelularContacto","var_uid":"6136196096594733da7f013012084628","dataType":"string","protectedValue":false,"id":"frm_rs_numCelularContacto","name":"frm_rs_numCelularContacto","label":"Celular Persona Contacto Salvamento\t\t\t\t\t","tabIn