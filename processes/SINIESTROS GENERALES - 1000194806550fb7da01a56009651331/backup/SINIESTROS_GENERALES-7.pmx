        <dyn_content><![CDATA[{"name":"SF I Historial de casos","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7403890606552d71dbfcce0019230087","name":"SF I Historial de casos","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_historial_caso_1","var_uid":"319445937656678783d3489016415518","dataType":"grid","protectedValue":false,"id":"grd_historial_caso_1","name":"grd_historial_caso_1","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"tarea","name":"tarea","label":"Tarea","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Tarea","var_name":"grd_historial_caso_1"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"usuario","name":"usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Usuario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"f_tranferencia","name":"f_tranferencia","label":"Fecha Tranferencia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":""