        <dyn_content><![CDATA[{"name":"SF I Analisis Siniestro Form Seguimiento","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"54722306068f8a69199ac78099278814","name":"SF I Analisis Siniestro Form Seguimiento","description":"","mode":"edit","script":{"type":"js","code":"$(\"#grd_participacion_coaseguro\").hide();\n\nfunction ajustadorChange(newVal, oldVal) {\n    $(\"#frm_as_nombreAjustadorAsignado\").getControl().attr('disabled', false);\n\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n    if(newVal == 'SINIESTROS_ANALISTAS_GN'){\n        console.log($(\"#tri_usr_analista\").getValue());\n        $(\"#frm_as_nombreAjustadorAsignado\").setValue($(\"#tri_usr_analista\").getValue())\n        $(\"#frm_as_nombreAjustadorAsignado\").getControl().attr('disabled', true);\n\n    }\n    //\n    //frm_as_emailAjustadorAsignado\n    //frm_as_telefonoAjustadorAsignado\n   /* $(\"#frm_as_nombreAjustadorAsignado\").hide();\n    $(\"#frm_as_emailAjustadorAsignado\").hide();\n    $(\"#frm_as_telefonoAjustadorAsignado\").hide();\n    $(\"#frm_as_nombreAjustadorAsignado\").disableValidation();\n    $(\"#frm_as_emailAjustadorAsignado\").disableValidation();\n    $(\"#frm_as_telefonoAjustadorAsignado\").disableValidation();\n\n    if (newVal == 'SINIESTROS_AJUSTADORES_EXTERNOS') {\n        $(\"#frm_as_nombreAjustadorAsignado\").show();\n        $(\"#frm_as_emailAjustadorAsignado\").show();\n        $(\"#frm_as_telefonoAjustadorAsignado\").show();\n        $(\"#frm_as_nombreAjustadorAsignado\").enableValidation();\n        $(\"#frm_as_emailAjustadorAsignado\").enableValidation();\n        $(\"#frm_as_telefonoAjustadorAsignado\").enableValidation();\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);*/\n}\n//execute when the Dynaform loads:\n//ajustadorChange($(\"#frm_as_tipoAjustador\").getValue(), '');\n$('#frm_as_tipoAjustador').setOnchange(ajustadorChange);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_ac_tipoOperacion","var_uid":"40078400165590e0fc068f4051942613","dataType":"string","protectedValue":false,"id":"frm_ac_tipoOperacion","name":"frm_ac_tipoOperacion","label":"Tipo Operación:","tabIndex":"","defaultValue":"@@frm_ds_tipoOperacion","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ac_tipoOperacion","colSpan":6},{"type":"dropdown","variable":"frm_as_tipoGestion","var_uid":"74198305665789869edcfe8000080104","dataType":"string","protectedValue":false,"id":"frm_as_tipoGestion","name":"frm_as_tipoGestion","label":"Tipo Gestión:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"FASTTRACK","label":"FAST TRACK"},{"value":"ESPECIALIZACION","label":"ESPECIALIZACIÓN"},{"value":"NORMAL","label":"NORMAL"}],"var_name":"frm_as_tipoGestion","colSpan":6}],[{"type":"text","variable":"frm_as_valorSiniestro","var_uid":"1714265806579dea6048040088989891","dataType":"string","protectedValue":false,"id":"frm_as_valorSiniestro","name":"frm_as_valorSiniestro","label":"Valor Pérdida:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"frm_as_valorSiniestro - ","memoryCache":false,"var_name":"frm_as_valorSiniestro","colSpan":6},{"type":"text","variable":"frm_as