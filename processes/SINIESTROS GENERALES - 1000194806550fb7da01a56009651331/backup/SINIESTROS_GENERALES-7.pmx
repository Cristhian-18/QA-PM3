dden0000000005","name":"hidden0000000005","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","colSpan":12}]],"variables":[{"var_uid":"5876395246552d69d598378088666542","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_hd_NroStro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5876395246552d69d598378088666542","var_name_old":"frm_hd_NroStro","prj_uid_old":"1000194806550fb7da01a56009651331"},{"var_uid":"968245391658b0f63173462025578744","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_bandera_inspeccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"629479048657b3cb7853664082031983","prj_uid":"1000194806550fb7da01a56009651331","var_name":"fle_respaldosInspeccion","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"872940281659b6fe3645064051723706","prj_uid":"1000194806550fb7da01a56009651331","var_name":"chk_docs_basicos_grid","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
