Salvamento","label":"Valor ofrecido por el Asegurado por el Salvamento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_rs_ofertaAseguradoSalvamento","colSpan":6}]],"variables":[{"var_uid":"64385027965542783b9f7b5080966557","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_rs_nombreSalvamento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"314853360655427a5dd0f36046788107","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_rs_modeloSalvamento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"364613799655427c3678118058816955","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_rs_serieSalvamento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6580712436554298b70a7b6068194053","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_rs_causaSalvamento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"91217357465947330b3a408049698567","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_rs_personaC