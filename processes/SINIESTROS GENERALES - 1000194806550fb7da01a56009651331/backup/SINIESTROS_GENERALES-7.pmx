        <dyn_content><![CDATA[{"name":"SF IDS Direcciones de los bienes Asegurados","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"16423784965514772ad1aa4003438500","name":"SF IDS Direcciones de los bienes Asegurados","description":"","mode":"edit","script":{"type":"js","code":"//let  value = roundToFixed(value, 2);\nlet numberRows = $(\"#grd_cobertura\").getNumberRows();\n\nfor (let i = 1; i <= numberRows; i++) {\n    for (let j = 1; j <= 10; j++) {\n        if (j == 7 || j == 9 || j == 10) {\n            console.log(j);\n            let value = $(\"#grd_cobertura\").getValue(i, j);\n            value = limitMaxMin(value, 9999999, -999999999);\n            console.log(value);\n            if (value != '') {\n                value = roundToFixed(value, 2);\n              }\n            $(\"#grd_cobertura\").setValue(value, i, j);\n        }\n    }\n\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_ramos","var_uid":"55809893065789ed25ffc72026709075","dataType":"grid","protectedValue":false,"id":"grd_ramos","name":"grd_ramos","label":"Ramos","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_Codsucursal","name":"grd_r_Codsucursal","label":"Cod Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Cod Sucursal","var_name":"grd_ramos"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_sucursal","name":"grd_r_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Sucursal"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_Codramo","name":"grd_r_Codramo","label":"Cod Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Cod Ramo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_ramo","name":"grd_r_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Ramo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_Nendoso","name":"grd_r_Nendoso","label":"# Endoso","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"# Endoso"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_r_nAplicacion","name":"grd_r_nAplicacion","label":"# A