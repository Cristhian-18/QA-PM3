ccepted_values":"[]","inp_doc_uid":""},{"var_uid":"39672864465542cde3906a5072335272","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_re_ejecutivoSiniestros","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"31082335865542d0bc7bc57030086964","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_re_recomendacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subtitleSubrSalv","label":"<span class=\"subtitulo\" id=\"isubtitleSubrSalv\"\nsubform=\"30141999765542f7db73941014259095\"> <i class=\"glyphicon glyphicon-minus\"><\/i>Subrogaciones\/salvamentos<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"30141999765542f7db73941014259095","name":"SF I Subrogaciones\/salvamentos","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_ss_existeSubrogacion","var_uid":"11946626465542fcad4e087066560688","dataType":"string","protectedValue":false,"id":"frm_ss_existeSubrogacion","name":"frm_ss_existeSubrogacion","label":"Existe Subrogaci\u00f3n?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"10","formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ss_existeSubrogacion","colSpan":6},{"colSpan":6}],[{"type":"textarea","variable":"frm_ss_observaciones","var_uid":"550732216655430047f1443058114619","dataType":"string","protectedValue":false,"id":"frm_ss_observaciones","name":"frm_ss_observaciones","label":"Observaciones:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","var_name":"frm_ss_observaciones","colSpan":12}]],"variables":[{"var_uid":"11946626465542fcad4e087066560688","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ss_existeSubrogacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"550732216655430047f1443058114619","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_ss_observaciones","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"27509649065667f59aa7000055860950","name":"SF Historial documentos","description":"","mode":"edit","script":{"type":"js","code":"\/\/ Resuelve el bug de que el link de la grilla\n\/\/ no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    \/*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    *\/\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  \/\/ Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"\/plugin\/phsoluciones\/core_librerias\/datatables\/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"\/plugin\/ph_soluciones\/core_librerias\/datatables\/jquery.dataTables.css,\n\/plugin\/ph_soluciones\/core_librerias\/datatables\/jquery.dataTables.js,\n\/plugin\/ph_soluciones\/core_librerias\/dataTables\/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Archivo"},{"type":"text