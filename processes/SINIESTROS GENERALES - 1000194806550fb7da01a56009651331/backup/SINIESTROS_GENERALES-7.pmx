        <dyn_filename><![CDATA[1000194806550fb7da01a56009651331/18947025367888fa49bf5c9034143710]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Form 2 Revisar Coberturas Analista","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"18947025367888fa49bf5c9034143710","name":"Form 2 Revisar Coberturas Analista","description":"","mode":"edit","script":{"type":"js","code":"\nocultar_solicitud();\nmostrar_solicitud();\nocultar_documentos();\nocultar_historial();\n\n$('#frm_as_reclamoSuperaDeducible').disableValidation();\n$('#frm_as_tipoAjustador').disableValidation();\n\n$(\"#frm_as_tipoAjustador\").getControl().attr('disabled', true);\n$(\"#frm_as_nombreAjustadorAsignado\").getControl().attr('disabled', true);\n\n\n\nfunction mostrar_solicitud() {\n  $('#46098314565510a5cd57553018796264').show(); // Datos asegurado \n  $('#14607804465510ee3e00a05082909351').show(); // Datos siniestro\n  $('#18277194465787f6590bb75083746853').show(); // Datos poliza\n  $('#7403890606552d71dbfcce0019230087').show(); // Historial de casos\n  $('#56993520565511b0c807296060115467').show(); // Siniestros registrados\n  //$('#37397912265511ee4965f19044370072').show(); // Alcance a siniestro\n  $('#462863856655124050411a0083795803').show(); // Información siniestro\n  $('#16423784965514772ad1aa4003438500').show(); // Direcciones bienes\n  $('#3991222066552d3306b3be8000113907').show(); // Información inspección\n  //$('#4479316636552d520db0b22003258870').show(); // Información pago\n  $('#3524701026552e2db3b1ce7038906501').show(); // Análisis siniestro\n  //$('#26930265365541e148c32f9051535276').show(); // Gestión informe ajustador externo\n  //$('#124534031655423d6933cf3054917309').show(); // Gestión informe ajustador interno\n  //$('#73833911165542a9e820942098465603').show(); // Recomendaciones\n  //$('#30141999765542f7db73941014259095').show(); // Subrogaciones/salvamentos\n  $('#258163566655432b663f282099762126').show(); // Atención al caso\n  $('#502697178658351be3b93a1020343316').hide(); // Informe Final\n  $('#subtitleDatase').show();\n  $('#subtitleDatoSini').show();\n  $('#subtitleDatGes').show();\n  $('#subtitleSiniReg').show();\n  $('#subtitleAlcaSin').show();\n  $('#subtitleInformacionSiniestro').show();\n  $('#subtitleDireBien').show();\n  $('#subtitleInfoInsp').show();\n  $('#subtitleInfPago').show();\n  $('#subtitleAnaSini').show();\n  $('#subtitleGestAjusExter').show();\n  $('#subtitleGestAjusInter').show();\n  $('#subtitleRecomenda').show();\n  $('#subtitleSubrSalv').show();\n  $('#subtitleAtenCaso').show();\n  fastTrack($(\"#frm_as_tipoGestion\").getValue(), '');\n\n  let tipo_operacion = $(\"#frm_ac_tipoOperacion\").getValue();\n\n  if (tipo_operacion == 'COASEGURO CEDIDO') {\n    $('#sub_companias_coaseguradas').show();\n    $('#930411861658b16b7c6ffe2080159750').show();\n  }\n  if (tipo_operacion == 'COASEGURO ACEPTADO') {\n    $('#subtitleInfoInsp').hide();\n    $('#3991222066552d3306b3be8000113907').hide();\n\tconsole.log(\"COASEGURO ACEPTADO\");\n  }\n\n\n}\nfunction ocultar_solicitud() {\n  $('#sub_companias_coaseguradas').hide();\n  $('#930411861658b16b7c6ffe2080159750').hide();\n  $('#46098314565510a5cd57553018796264').hide();\n  $('#14607804465510ee3e00a05082909351').hide();\n  $('#18277194465787f6590bb75083746853').hide();\n  $('#7403890606552d71dbfcce0019230087').hide();\n  $('#56993520565511b0c807296060115467').hide();\n  $('#462863856655124050411a0083795803').hide();\n  $('#16423784965514772ad1aa4003438500').hide();\n  $('#3991222066552d3306b3be8000113907').hide();\n  $('#3524701026552e2db3b1ce7038906501').hide();\n  $('#258163566655432b663f282099762126').hide();\n  //$('#502697178658351be3b93a1020343316').hide(); \n  $('#subtitleDatase').hide();\n  $('#subtitleDatoSini').hide();\n  $('#subtitleDatGes').hide();\n  $('#subtitleSiniReg').hide();\n  $('#subtitleAlcaSin').hide();\n  $('#subtitleInformacionSiniestro').hide();\n  $('#subtitleDireBien').hide();\n  $('#subtitleInfoInsp').hide();\n  $('#subtitleInfPago').hide();\n  $('#subtitleAnaSini').hide();\n  $('#subtitleGestAjusExter').hide();\n  $('#subtitleGestAjusInter').hide();\n  $('#subtitleRecomenda').hide();\n  $('#subtitleSubrSalv').hide();\n  $('#subtitleAtenCaso').hide();\n}\nfunction mostrar_documentos() {\n  $('#27509649065667f59aa7000055860950').show(); // *** Documentos de respaspaldo\n}\nfunction mostrar_historial() {\n  $('#7403890606552d71dbfcce0019230087').show(); // ** Historial de casos \n}\nfunction ocultar_documentos() {\n  $('#27509649065667f59aa7000055860950').hide(); // *** Documentos de respaspaldo\n}\nfunction ocultar_historial() {\n  $('#7403890606552d71dbfcce0019230087').hide(); // ** Historial de casos \n}\n\nfunction fastTrack(newVal, oldVal) {\n\n  $('#subtitleInfoInsp').hide();\n  $('#3991222066552d3306b3be8000113907').hide();\n  let tipo_operacion = $(\"#frm_ac_tipoOperacion\").getValue();\n\n  if (newVal != 'FASTTRACK' && tipo_operacion != 'COASEGURO ACEPTADO') {\n    $('#subtitleInfoInsp').show();\n    $('#3991222066552d3306b3be8000113907').show();\n  }\n}\nfastTrack($(\"#frm_as_tipoGestion\").getValue(), '');\n$('#frm_as_tipoGestion').setOnchange(fastTrack);\n\n$('.menu').on('click', function () {\n  switch (this.id) {\n    case 'menu1':\n      mostrar_solicitud();\n      ocultar_documentos();\n      ocultar_historial();\n      break;\n    case 'menu2':\n      ocultar_solicitud();\n      ocultar_documentos();\n      mostrar_historial();\n      break;\n    case 'menu3':\n      ocultar_solicitud();\n      mostrar_documentos();\n      ocultar_historial();\n      break;\n  }\n})\n\n\n$(\"#tri_usr_analista_2\").hide();\n\n\nfunction accion(newValue, oldValue) {\n  $('#30510795265850a90c04265058882654').hide();\n  $(\"#tri_usr_analista_2\").hide();\n  $('#chk_docs_basicos_grid').hide();\n  $('#file_cartaDeducible').hide();\n\n  $('#frm_as_tipoGestion').enableValidation();\n  $('#frm_as_valorSiniestro').enableValidation();\n  $('#frm_as_valorTotal').enableValidation();\n  $('#frm_as_requiereAjustador').enableValidation();\n  $('#frm_as_tipoAjustador').enableValidation();\n\n  \n  var tipo = $(\"#frm_as_tipoGestion\").getValue();\n  if (newValue == 'NEGAR') {\n    $('#30510795265850a90c04265058882654').show();\n  }\n  if (newValue == 'REASIGNAR') {\n    $('#tri_usr_analista_2').show();\n    $('#frm_as_tipoGestion').disableValidation();\n    $('#frm_as_valorSiniestro').disableValidation();\n    $('#frm_as_valorTotal').disableValidation();\n    $('#frm_as_requiereAjustador').disableValidation();\n    $('#frm_as_tipoAjustador').disableValidation();\n  }\n  if (newValue == 'DOCUMENTAR') {\n    $('#chk_docs_basicos_grid').show();\n  }\n  if (newValue == 'DEDUCIBLE') {\n    $('#file_cartaDeducible').show();\n  }\n  if (newValue == 'APROBAR' && tipo == 'FASTTRACK') {\n    $(\"#502697178658351be3b93a1020343316\").show();\n  } else {\n    $(\"#502697178658351be3b93a1020343316\").hide();\n  }\n}\nif ($(\"#frm_ac_accion\").getValue() != '') {\n  var dato = $(\"#frm_ac_accion\").getValue();\n  accion(dato, '');\n}\n\naccion($(\"#frm_ac_accion\").getValue(), '');\n$(\"#frm_ac_accion\").setOnchange(accion);\n\nlet suma = 0;\n\n$(\"#6665223826551056f63d193018124524\").setOnSubmit(function () {\n  let tipo_operacion = $(\"#frm_ds_tipoOperacion\").getValue();\n  if (tipo_operacion != 'COASEGURO CEDIDO') {\n    return true\n  }\n  var aRc = $(\"#frm_companias_coaseguradas\").getNumberRows();\n  suma = 0;\n  let valor = 0;\n  if ($(\"#frm_ac_accion\").getValue() == \"AJUSTADOR\") {\n    valor = $(\"#frm_companias_coaseguradas\").getSummary(3);\n    console.log(\"Valor \" + valor);\n\n    if (valor != 100) {\n      console.log(\"Suma \" + suma);\n\n      /*alert(\"La suma de los porcentajes de participación debe ser igual a 100%\");\n      return false;*/\n    }\n  }\n  console.log(\"Suma \" + suma);\n  return true;\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"AUDITORÍA TÉCNICA","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"frm_hd_NroStro","var_uid":"5876395246552d69d598378088666542","dataType":"string","protectedValue":false,"id":"frm_hd_NroStro","name":"frm_hd_NroStro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_hd_NroStro","colSpan":12}],[{"type":"panel","id":"panel0000000001","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"menu1\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>SOLICITUD</h4></a></li>\n  <li id=\"menu3\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>DOCUMENTOS</h4></a></li>\n  <li id=\"menu2\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>HISTORIAL</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6706953386577ecb13d8070050567896","name":"SubForm Mensaje siniestro","description":"SubForm Mensaje siniestro","mode":"edit","script":{"type":"js","code":"\n/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n\n/*$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");*/\n\nif ($(\"#tri_id_stro\").getValue() == null || $(\"#tri_id_stro\").getValue() == \"\") {\n    $(\"#id-stro\").html('' + $(\"#nro_stro\").getValue());\n} else {\n    $(\"#id-stro\").html('' + $(\"#tri_id_stro\").getValue());\n\n}\n\n\n\nif ($(\"#tri_nro_stro\").getValue() == null || $(\"#tri_nro_stro\").getValue() == \"\" || $(\"#tri_nro_stro\").getValue() == \" - 2024\") {\n    $(\"#nro-stro\").html('' + $(\"#nro_inspeccion\").getValue() + $(\"#tri_nro_stro\").getValue());\n} else {\n    $(\"#nro-stro\").html('' + $(\"#tri_nro_stro\").getValue() );\n}\n"},"language":"en","externalLibs":"/plugin/ph_soluciones/core_librerias/js_externos/app.min.js,\n\n/plugin/ph_soluciones/core_librerias/css_externos/AdminLTE.min.css, /plugin/ph_soluciones/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>NRO RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NRO REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"1453936926577ecb972dba9013266489","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"8263423596577ecb9768160070254345","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"6438257896577ecb979bf40098401040","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"8169175466577ecb97cae60007912358","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"2937079996577ecb97faa67091523565","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}],[{"type":"hidden","variable":"nro_stro","var_uid":"34489768465fd278523fff4037463461","dataType":"string","protectedValue":false,"id":"nro_stro","name":"nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_stro","colSpan":6},{"type":"hidden","variable":"nro_inspeccion","var_uid":"30965624465fd277d4f12f2064306707","dataType":"string","protectedValue":false,"id":"nro_inspeccion","name":"nro_inspeccion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_inspeccion","colSpan":6}]],"variables":[{"var_uid":"1453936926577ecb972dba9013266489","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"8263423596577ecb9768160070254345","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"6438257896577ecb979bf40098401040","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_bandera_parcial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"96928939765394f89a07cd8013571539","var_name_old":"tri_bandera_parcial","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"8169175466577ecb97cae60007912358","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"85104247565394f89a40d51072446619","var_name_old":"tri_imp_monto_estimado","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"2937079996577ecb97faa67091523565","prj_uid":"1000194806550fb7da01a56009651331","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"37089132765394f89a722c2062008643","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"34489768465fd278523fff4037463461","prj_uid":"1000194806550fb7da01a56009651331","var_name":"nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"30965624465fd277d4f12f2064306707","prj_uid":"1000194806550fb7da01a56009651331","var_name":"nro_inspeccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"549438521662755a1def3f2062254097","name":"SubForm Siniestros Inusuales","description":"SubForm Siniestros Inusuales","mode":"edit","script":{"type":"js","code":"//Siniestros inusuales\n\n\nfunction checkInusual(newVal, oldVal){\n\n    /*file_siniestroInusual_fiscalia\n    file_siniestroInusual_judicatura\n    file_siniestroInusual_super\n    sub_siniestroInusual_causal\n    frm_siniestroInusual_categoria\n    frm_siniestroInusual_observaciones*/\n\n    $(\"#file_siniestroInusual_fiscalia\").hide();\n    $(\"#file_siniestroInusual_judicatura\").hide();\n    $(\"#file_siniestroInusual_super\").hide();\n    $(\"#sub_siniestroInusual_causal\").hide();\n    $(\"#frm_siniestroInusual_categoria\").hide();\n    $(\"#frm_siniestroInusual_observaciones\").hide();\n\n    $(\"#file_siniestroInusual_fiscalia\").disableValidation();\n    $(\"#file_siniestroInusual_judicatura\").disableValidation();\n    $(\"#file_siniestroInusual_super\").disableValidation();\n    $(\"#sub_siniestroInusual_causal\").disableValidation();\n    $(\"#frm_siniestroInusual_categoria\").disableValidation();\n    $(\"#frm_siniestroInusual_observaciones\").disableValidation();\n\n    if(newVal == '1'){\n        $(\"#file_siniestroInusual_fiscalia\").show();\n        $(\"#file_siniestroInusual_judicatura\").show();\n        $(\"#file_siniestroInusual_super\").show();\n        $(\"#sub_siniestroInusual_causal\").show();\n        $(\"#frm_siniestroInusual_categoria\").show();\n        $(\"#frm_siniestroInusual_observaciones\").show();\n\n        $(\"#file_siniestroInusual_fiscalia\").enableValidation();\n        $(\"#file_siniestroInusual_judicatura\").enableValidation();\n        $(\"#file_siniestroInusual_super\").enableValidation();\n        $(\"#sub_siniestroInusual_causal\").enableValidation();\n        $(\"#frm_siniestroInusual_categoria\").enableValidation();\n        $(\"#frm_siniestroInusual_observaciones\").enableValidation();\n\n        //if bandera_inusual == 1, disable sub_siniestroInusual_causal\n        let bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\n        if(bandera_inusual == '1'){\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', true);\n        } else {\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', false);\n        }\n    \n    }\n\n}\ncheckInusual($(\"#frm_siniestroInusual_check\").getValue(), ''); \n$('#frm_siniestroInusual_check').setOnchange(checkInusual);\n\nlet bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\nif(bandera_inusual == '1'){\n    //disable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', true);\n\n} else {\n    //enable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', false);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"sub_siniestro_inusual","label":"Siniestro inusual","ariaLabel":"","colSpan":12}],[{"type":"radio","variable":"frm_siniestroInusual_check","var_uid":"420016371662755a78b8725083037112","dataType":"boolean","protectedValue":false,"id":"frm_siniestroInusual_check","name":"frm_siniestroInusual_check","label":"¿Siniestro Inusual?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Si"},{"value":"0","label":"No"}],"var_name":"frm_siniestroInusual_check","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_fiscalia","var_uid":"760834502662755a7a8d9b7055395516","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_fiscalia","name":"file_siniestroInusual_fiscalia","label":"Fiscalia","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_fiscalia","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_judicatura","var_uid":"604610493662755a7c1f1e7089020418","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_judicatura","name":"file_siniestroInusual_judicatura","label":"Judicatura","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_judicatura","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_super","var_uid":"224437546662755a7e02733044316516","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_super","name":"file_siniestroInusual_super","label":"Super Intendencia de Companias","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required