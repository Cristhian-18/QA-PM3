lues":"[]","inp_doc_uid":""},{"var_uid":"39672864465542cde3906a5072335272","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_re_ejecutivoSiniestros","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"31082335865542d0bc7bc57030086964","prj_uid":"1000194806550fb7da01a56009651331","var_name":"frm_re_recomendacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subtitleSubrSalv","label":"<span class=\"subtitulo\" id=\"isubtitleSubrSalv\"\nsubform=\"30141999765542f7db73941014259095\"> <i class=\"glyphicon glyphicon-minus\"><\/i>Subrogaciones\/salvamentos<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"30141999765542f7db73941014259095","name":"SF I Subrogaciones\/salvamentos","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_ss_existeSubrogacion","var_uid":"11946626465542fcad4e087066560688","dataType":"string","protectedValue":false,"id":"frm_ss_existeSubrogacion","name":"frm_ss_existeSubrogacion","label":"Existe Subrogaci\u00f3n?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"10","formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ss_existeSubrogacion","colSpan":6},{"colSpan":6}],[{"type":"textarea","variable":"frm_ss_observaciones","var_uid":"550732216655430047f1443058114619","dataType":"