rAsignado\").enableValidation();\n        $(\"#frm_as_emailAjustadorAsignado\").enableValidation();\n        $(\"#frm_as_telefonoAjustadorAsignado\").enableValidation();\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);*/\n}\n//execute when the Dynaform loads:\najustadorChange($(\"#frm_as_tipoAjustador\").getValue(), '');\n$('#frm_as_tipoAjustador').setOnchange(ajustadorChange);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_ac_tipoOperacion","var_uid":"40078400165590e0fc068f4051942613","dataType":"string","protectedValue":false,"id":"frm_ac_tipoOperacion","name":"frm_ac_tipoOperacion","label":"Tipo Operación:","tabIndex":"","defaultValue":"@@frm_ds_tipoOperacion","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ac_tipoOperacion","colSpan":6},{"type":"dropdown","variable":"frm_as_tipoGestion","var_uid":"74198305665789869edcfe8000080104","dataType":"string","protectedValue":false,"id":"frm_as_tipoGestion","name":"frm_as_tipoGestion","label":"Tipo Gestión:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"FASTTRACK","label":"FAST TRACK"},{"value":"ESPECIALIZACION","label":"ESPECIALIZACIÓN"},{"value":"NORMAL","label":"NORMAL"}],"var_name":"frm_as_tipoGestion","colSpan":6}],[{"type":"text","variable":"frm_as_valorSiniestro","var_uid":"1714265806579dea6048040088989891","dataType":"string","protectedValue":false,"id":"frm_as_valorSiniestro","name":"frm_as_valorSiniestro",