$rs  = executeQuery($sql);
$rs_actual    = $rs['1'];

$rs_siguiente = $rs['2'];
$usr_uid_receptor    = ($rs_siguiente['USR_UID'] == '' ? @@USER_LOGGED : $rs_siguiente['USR_UID']);
