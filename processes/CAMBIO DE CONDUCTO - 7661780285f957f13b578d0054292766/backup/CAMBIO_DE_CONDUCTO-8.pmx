                        <tr>
                          <td
                            style="width: 50%; color: #001815; font-size: x-small; font-weight: bold; vertical-align: top;">
                            Póliza a nombre de
                          </td>
                          <td
                            style="width: 50%; color: #001815; font-size: x-small; font-weight: bold; vertical-align: top;"
                            class="table-spacing">
