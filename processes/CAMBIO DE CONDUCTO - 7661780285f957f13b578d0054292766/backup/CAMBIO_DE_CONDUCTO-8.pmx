de":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"5991188245f99c8e2385684016797529","prj_uid":"7661780285f957f13b578d0054292766","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8364879445f3ea1538a0212086841201","var_name_old":"grd_historial_caso","prj_uid_old":"8576130285f3aa779242d43020182139"}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7677946405f99c8828782c2034278251","name":"SubForm Documentos","description":"SubForm Documentos","mode":"edit","script":{"type":"js","code":"// Resuelve el bug de que el link de la grilla\n// no funciona al cargar la data desde trigger.\n$(function () {\n  var numero_columna_link = 5;\n\n  for (var i = 1; i <= $(\"#gridDocumentos\").getNumberRows(); i++) {\n    /*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    */\n\n    var url = $(\"#gridDocumentos\").getValue(i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  // Cargar documentos\n  $('#historial_comentarios').html($('#tri_comentarios').getValue());\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"/plugin/beesmartec/core_librerias/datatables/spanish.json\"\n    }\n  });\n\n})\n\n"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/phsoluciones/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Autorizacion de debito","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Archivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Comentario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Usuario","name":"gridDocumentos_Usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Usuario"},{"type":"link","id":"gridDocumentos_Descarga","name":"gridDocumentos_Descarga","label":"","tabIndex":"","value":"Descargar","href":"","hint":"","ariaLabel":"","columnWidth":"20","width":100,"title":""}],"data":[],"mode":"view","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Autorizacion de debito","colSpan":12}],[{"type":"hidden","variable":"tri_comentarios","var_uid":"5398929455f99c8a12d1bf7014129376","dataType":"string","protectedValue":false,"id":"tri_comentarios","name":"tri_comentarios","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_comentarios","colSpan":12}]],"variables":[{"var_uid":"5398929455f99c8a12d1bf7014129376","prj_uid":"7661780285f957f13b578d0054292766","var_name":"tri_comentarios","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9324655985efe6b5912d043024878669","var_name_old":"tri_comentarios","prj_uid_old":"9607309865ee57d397205d4062346575"}],"colSpan":12}],[{"type":"subtitle","id":"sbt_atencion","label":"ATENCION","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"frm_endoso_numCC","var_uid":"50698673860a3e745cb2252091024256","dataType":"string","protectedValue":false,"id":"frm_endoso_numCC","name":"frm_endoso_numCC","label":"Número de endoso Cambio de Conducto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Ingrese solo números","maxLength":"3","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_endoso_numCC","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"7258863035f98d0aee58e69056184054","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Comentario","tabIndex":"","defaultValue":"--","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_comentario","colSpan":12}],[{"type":"hidden","variable":"frm_recibio_deposito","var_uid":"4298992545f95841d50ac67047047742","dataType":"string","protectedValue":false,"id":"frm_recibio_deposito","name":"frm_recibio_deposito","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_recibio_deposito","colSpan":3},{"type":"hidden","variable":"frm_tarea","var_uid":"6551834875f95841d7061f6024900426","dataType":"string","protectedValue":false,"id":"frm_tarea","name":"frm_tarea","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_tarea","colSpan":3},{"type":"hidden","variable":"tri_mes_grbar","var_uid":"6981779026058cf4172d324043592966","dataType":"string","protectedValue":false,"id":"tri_mes_grbar","name":"tri_mes_grbar","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_mes_grbar","colSpan":3},{"colSpan":3}],[{"colSpan":4},{"type":"submit","id":"btn_financiera_submit","name":"btn_financiera_submit","label":"GRABAR Y CONTINUAR","tabIndex":"","ariaLabel":"","colSpan":4},{"colSpan":4}]],"variables":[{"var_uid":"50698673860a3e745cb2252091024256","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_endoso_numCC","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7258863035f98d0aee58e69056184054","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4298992545f95841d50ac67047047742","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4298992545f95841d50ac67047047742","var_name_old":"frm_recibio_deposito","prj_uid_old":"7661780285f957f13b578d0054292766","create":false},{"var_uid":"6551834875f95841d7061f6024900426","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_tarea","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6551834875f95841d7061f6024900426","var_name_old":"frm_tarea","prj_uid_old":"7661780285f957f13b578d0054292766","create":false},{"var_uid":"6981779026058cf4172d324043592966","prj_uid":"7661780285f957f13b578d0054292766","var_name":"tri_mes_grbar","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
