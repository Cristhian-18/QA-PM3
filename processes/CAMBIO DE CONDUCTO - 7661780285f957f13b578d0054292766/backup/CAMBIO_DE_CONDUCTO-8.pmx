deposito","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_recibio_deposito","colSpan":6},{"type":"hidden","variable":"frm_tarea","var_uid":"6551834875f95841d7061f6024900426","dataType":"string","protectedValue":false,"id":"frm_tarea","name":"frm_tarea","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_tarea","colSpan":6}],[{"type":"button","id":"btn_financiera_save","name":"btn_financiera_save","label":"GRABAR","tabIndex":"","ariaLabel":"","colSpan":6},{"type":"submit","id":"btn_financiera_submit","name":"btn_financiera_submit","label":"GRABAR Y CONTINUAR","tabIndex":"","ariaLabel":"","colSpan":6}]],"variables":[{"var_uid":"4298992545f95841d50ac67047047742","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_recibio_deposito","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4298992545f95841d50ac67047047742","var_name_old":"frm_recibio_deposito","prj_uid_old":"7661780285f957f13b578d0054292766","create":false},{"var_uid":"6551834875f95841d7061f6024900426","prj_uid":"7661780285f957f13b578d0054292766","var_name":"frm_tarea","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6551834875f95841d7061f6024900426","var_name_old":"frm_tarea","prj_uid_old":"7661780285f957f13b578d0054292766","create":false}]}]}]]></dyn_content>
