,"validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_salvamento_canton","colSpan":4}],[{"type":"textarea","variable":"frm_salvamento_direccion","var_uid":"2535921946576884cd46fc0070949688","dataType":"string","protectedValue":false,"id":"frm_salvamento_direccion","name":"frm_salvamento_direccion","label":"Dirección del Salvamento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_salvamento_direccion","colSpan":12}],[{"type":"text","variable":"frm_salvamento_nombreContacto","var_uid":"1002784936576885b832a94074089062","dataType":"string","protectedValue":false,"id":"frm_salvamento_nombreContacto","name":"frm_salvamento_nombreContacto","label":"Nombre de Contacto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_salvamento_nombreContacto","colSpan":6},{"type":"text","variable":"frm_salvamento_celularContacto","var_uid":"15277782465768862462989061198038","dataType":"string","protectedValue":false,"id":"frm_salvamento_celularContacto","name":"frm_salvamento_celularContacto","label":"No. Ceular Contacto\t\t\t\t","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_salvamento_celularContacto","colSpan":6}]],"variables":[{"var_uid":"9979537546576882c1ce488068890548","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_provincia","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"969164520657688358de103049507535","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_ciudadUbicacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2056792116576883f4c7710071084238","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_canton","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"2535921946576884cd46fc0070949688","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_direccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"1002784936576885b832a94074089062","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_nombreContacto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"15277782465768862462989061198038","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_salvamento_celularConta