ores_siniestros\").setValue(pvp,i,5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i,6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega,i,6);\n    }\n}\n\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"25508654365657eeaaedeb6017655346","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"7","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"# Parte"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","h