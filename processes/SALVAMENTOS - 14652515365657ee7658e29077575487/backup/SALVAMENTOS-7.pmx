        <dyn_content><![CDATA[{"name":"Gestión Cotizacion Anadir Mundo Partes","description":"Gestión Cotizacion Anadir Mundo Partes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"72017514065657eea87d0b8083831841","name":"Gestión Cotizacion Anadir Mundo Partes","description":"Gestión Cotizacion Anadir Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal){\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i,4);\n        pvp = roundToFixed(pvp, 2);\n        $(\"#grd_valores_siniestros\").setValue(pvp,i,4);\n\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i,5);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega,i,5);\n    }\n}\n\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"25508654365657eeaaedeb6017655346","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"# Parte"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Descripción"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_pvp","name":"frm_gvs_pvp","label":"PVP","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"PVP"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_didas_entrega","name":"frm_gvs_didas_entrega","label":"Dias de entrega","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":