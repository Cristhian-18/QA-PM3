e":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_color","colSpan":6}]],"variables":[{"var_uid":"50375919968f73dea07bc53068931884","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_origen_core_insurance","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"76800309668f73e00a47b80034925869","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_reclamante_core_insurance","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"76276295865657eeaadb476049776377","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_vehiculo_placa","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"76276295865657eeaadb476049776377","var_name_old":"frm_vehiculo_placa","prj_uid_old":"14652515365657ee7658e29077575487","create":false},{"var_uid":"86266793065657eeaad6ea1050247411","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_vehiculo_marca","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"86266793065657eeaad6ea1050247411","var_name_old":"frm_vehiculo_marca","prj_uid_old":"14652515365657ee7658e29077575487","create":false},{"var_uid":"47969053565657