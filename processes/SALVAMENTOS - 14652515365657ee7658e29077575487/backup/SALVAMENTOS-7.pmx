        <dyn_content><![CDATA[{"name":"Form 5 Verificar datos del siniestro","description":"Form 5 Verificar datos del siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"85240658765657eea8ad219008829384","name":"Form 5 Verificar datos del siniestro","description":"Form 5 Verificar datos del siniestro","mode":"edit","script":{"type":"js","code":"//created by Hwenry\n\nlet nombre_taller = $(\"#frm_taller\").getValue();\n$(\"#grd_valores_siniestros\").hideColumn(9);\n\n\t$(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setValue(0);\n\nlet numberRows = $(\"#grd_valores_siniestros\").getNumberRows();\nconsole.log(numberRows);\nlet valorSuma = 0;\n\nfor (let i = 1; i <= numberRows; i++) {\n  if(nombre_taller == \"TALLER INDEMNIZACION\"){\n    $(\"#grd_valores_siniestros\").setValue(\"Indemnizacion\", i, 11);\n  }\n    for (let j = 1; j <= 11; j++) {\n        if (j != 10 && j != 11) {\n            $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n        }\n    }\n}\n\nfunction checkValores(newVal, oldVal) {\n    valorSuma = 0;\n    valorTotal = 0;\n    for (let i = 1; i <= numberRows; i++) {\n        if ($(\"#grd_valores_siniestros\").getValue(i, 11) != \"Negado\") {\n            console.log(\"Valor\", $(\"#grd_valores_siniestros\").getValue(i, 5));\n            valorSuma = valorSuma + parseInt($(\"#grd_valores_siniestros\").getValue(i, 5));\n        }\n        valorTotal = valorTotal + parseInt($(\"#grd_valores_siniestros\").getValue(i, 5));\n\n    }\n    $valorSuma = roundToFixed(valorSuma, 2);\n\n    console.log(\"Valor suma\", $valorSuma);\n    $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(valorSuma);\n    console.log(\"Valor suma\", $valorSuma);\n    hideRepuestos();\n\n}\ncheckValores($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkValores);\n\nfunction hideRepuestos() {\n    console.log(\"Valor suma\", valorSuma);\n    if (valorTotal > 0) {\n        if (nombre_taller == \"MUNDO MOTRIZ\") {\n          \n        }\n        if(nombre_taller == \"TALLER INDEMNIZACION\"){\n          $(\"option[value='Aprobado']\").remove();\n          $(\"option[value='Pendiente']\").remove();\n        }\n       \n    } else {\n       \n        /*$(\"#sub_gestionrepuestos\").hide()\n        $(\"#grd_valores_siniestros\").hide()*/\n\n    }\n}\nfunction accion(newValue, oldValue) {\n  $(\"#sub_gestionrepuestos\").hide();\n  $(\"#18790399865657eea8896d9056917483\").hide();\n\n  if(newValue == 'COTIZAR'){\n     $(\"#sub_gestionrepuestos\").show();\n    $(\"#18790399865657eea8896d9056917483\").show();\n  } \n}\n\n\naccion();\n$(\"#frm_accion\").setOnchange(accion);\n\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        \n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#23271031065657eea890261027484884').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#38388078065657eea86f554052132558').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $(\"#sub_gestionrepuestos\").show();\n        $(\"#83349221365657eea8935c0034368501\").show();\n        $('#sub_valores_aprobados').show()\n        $('#66500223665657eea88bf88096551186').show()\n        $('#83349221365657eea8935c0034368501').show()\n        $('#frm_comentarioAnalista_ajustadorInterno').show()\n\n        break\n    }\n    hideRepuestos();\n  })\n  \n  function ocultar_todo() {\n    $('#frm_comentarioAnalista_ajustadorInterno').hide()\n    $('#subt_friss').hide()\n    $('#37834123465657eea8c1164099238212').hide()\n    $('#47781112665657eea8b0668042786066').hide()\n    $('#subt_tallerAsignado').hide()\n    $('#subt_ppolicial').hide()\n    $('#15894986365657eea8bd0f2052191535').hide()\n    $('#subt_accesoriosRegistrados').hide()\n    $('#38598074265657eea8b6072000128001').hide()\n    $('#subt_accidente').hide()\n    $('#33751146965657eea8867b4097970847').hide()\n    $('#23654578165657eea8a1875054303713').hide()\n    $('#sub_busqueda').hide()\n    $('#52345823565657eea89f273081823396').hide()\n    $('#subt_vehiculo').hide()\n    $('#39942008765657eea8c60e4037826925').hide()\n    $('#subt_asegurado').hide()\n    $('#77577551765657eea869184079116697').hide()\n    $('#subt_detalle').hide()\n    $('#40264027065657eea8a90a6057516237').hide()\n    $('#subt_registro').hide()\n    $('#41246456365657eea871e92041543660').hide()\n    $('#subt_ve_afectados').hide()\n    $('#15565307165657eea877078043143405').hide()\n    $('#isubt_pe_afectados').hide()\n    $('#72757335765657eea8a3ea5068757906').hide()\n    $('#iisubt_pr_afectados').hide()\n    $('#80125453265657eea8be050001169192').hide()\n    $('#sub_docs').hide()\n    $('#42369092065657eea875f65039015911').hide()\n    $('#sub_valores').hide()\n    $('#81367868865657eea8ba0a9094814227').hide()\n    $('#subt_docs').hide()\n    $('#23271031065657eea890261027484884').hide()\n    $('#sbt_historial').hide()\n    $('#38388078065657eea86f554052132558').hide()\n    $('#subt_poliza').hide()\n    $('#85517892965657eea863bb6085915178').hide()\n    $('#sub_repuestos').hide()\n    $('#83349221365657eea8935c0034368501').hide()\n    $('#subt_hsiniestros').hide()\n    $('#70029930365657eea866da2082229749').hide()\n    $('#subt_direccionador').hide()\n    $('#17233983365657eea8880d0032087370').hide()\n    $('#subt_documentosTaller').hide()\n    $('#55104713665657eea8c7130067901735').hide()\n    $('#subt_gestionTaller').hide()\n    $('#34010538965657eea8ab189068687628').hide()\n    $('#subt_valoresSiniestros').hide()\n    $('#49436449665657eea879846048030792').hide()\n    $('#subt_documentos_cotizacion').hide()\n    $('#78166437265657eea8bf0e4033789844').hide()\n    $('#sub_valores_aprobados').hide()\n    $('#66500223665657eea88bf88096551186').hide()\n    \n    \n  }\n  function mostrar_solicitud() {\n    $('#frm_comentarioAnalista_ajustadorInterno').show()\n    $('#subt_friss').show()\n    $('#37834123465657eea8c1164099238212').show()\n    $('#47781112665657eea8b0668042786066').show()\n    $('#subt_tallerAsignado').show()\n    $('#subt_ppolicial').show()\n    $('#15894986365657eea8bd0f2052191535').show()\n    $('#subt_accesoriosRegistrados').show()\n    $('#38598074265657eea8b6072000128001').show()\n    $('#subt_accidente').show()\n    $('#33751146965657eea8867b4097970847').show()\n    $('#subt_hsiniestros').show()\n    $('#sub_busqueda').show()\n    $('#52345823565657eea89f273081823396').show()\n    $('#subt_vehiculo').show()\n    $('#39942008765657eea8c60e4037826925').show()\n    $('#subt_asegurado').show()\n    $('#77577551765657eea869184079116697').show()\n    $('#subt_detalle').show()\n    $('#40264027065657eea8a90a6057516237').show()\n    $('#subt_registro').show()\n    $('#41246456365657eea871e92041543660').show()\n    $('#subt_ve_afectados').show()\n    $('#15565307165657eea877078043143405').show()\n    $('#isubt_pe_afectados').show()\n    $('#72757335765657eea8a3ea5068757906').show()\n    $('#iisubt_pr_afectados').show()\n    $('#80125453265657eea8be050001169192').show()\n    $('#sub_docs').show()\n    $('#42369092065657eea875f65039015911').show()\n    $('#sub_valores').show()\n    $('#81367868865657eea8ba0a9094814227').show()\n    $('#subt_poliza').show()\n    $('#85517892965657eea863bb6085915178').show()\n    $('#subt_historial_siniestro').show()\n    $('#70029930365657eea866da2082229749').show()\n    $('#subt_direccionador').show()\n    $('#17233983365657eea8880d0032087370').show()\n    $('#subt_documentosTaller').show()\n    $('#55104713665657eea8c7130067901735').show()\n    $('#subt_gestionTaller').show()\n    $('#34010538965657eea8ab189068687628').show()\n    $('#subt_valoresSiniestros').show()\n    $('#49436449665657eea879846048030792').show()\n    $('#subt_documentos_cotizacion').show()\n    $('#78166437265657eea8bf0e4033789844').show()\n   \n}\n  \n  ocultar_todo()\n  mostrar_solicitud()\n  "},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACIÓN SINIESTROS VEHÍCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76037149265657eea8b4f56001848192","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"11967327665657eea8a05c7022834649","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"46543713065657eeaaf77d9018514339","dataType":"string","protec