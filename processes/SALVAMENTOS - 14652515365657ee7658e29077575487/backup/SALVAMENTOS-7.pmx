xpresion_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"53574378564760b7d49bc11075935804","var_name_old":"expresion_regular_4","prj_uid_old":"771962534639f70846b6f90010923609","create":false},{"var_uid":"49958005365657eeaaf32e5061064990","prj_uid":"14652515365657ee7658e29077575487","var_name":"PROCESS","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"24323299364760b7d4d77b5029006240","var_name_old":"PROCESS","prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}]],"variables":[{"var_uid":"74596320165657eea9de760075902210","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"74596320165657eea9de760075902210","var_name_old":"frm_accion","prj_uid_old":"14652515365657ee7658e29077575487","create":false},{"var_uid":"64507468365657eeaa20703053632759","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"64507468365657eeaa20703053632759","var_name_old":"frm_comentario","prj_uid_old":"14652515365657ee7658e29077575487","create":false}]}]}]]></dyn_content>
