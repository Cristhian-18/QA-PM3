ario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Historial de Siniestros","colSpan":12}]],"variables":[{"var_uid":"20981959065657eeaae96b5085239311","prj_uid":"14652515365657ee7658e29077575487","var_name":"grd_historial_siniestros","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_registro","label":"<span class=\"subtitulo\" id=\"isubt_registro\" subform=\"41246456365657eea871e92041543660\"> <i class=\"glyphicon glyphicon-minus\"></i> \nRegistro causa siniestros</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"41246456365657eea871e92041543660","name":"SubForm Registro Siniestros","description":"SubForm Registro Siniestros","mode":"edit","script":{"type":"js","code":"//henry\n$('#frm_rp_componente_e').hide();\n$('#frm_componente_accesorios').hide();\n$('#frm_componente_inundado').hide();\n$('#lbl_robo_parcial').hide();\n$('#lbl_danio_parcial').hide();\n\nvar formId = $(\"form\").prop(\"id\");\n  \n//Set an onchange event handler for the form. When the value of a field changes in the Dynaform, \n//check whether the changed field is the hasDiscount field in the grid. \n//If so, then if hasDiscount is set to \"Discount\", then enable the discountRate field in the same row. \n//If set to \"No Discount\", then disable the discountRate field.\n$( \"#\" + formId ).setOnchange( function(fieldId, newVal, oldVal) {\n  //check if a field changed inside the grid:\n  var aMatches = fieldId.match(/^\\[grd_registro_siniestro\\]\\[(\\d+)\\]\\[grd_s_aplicar\\]$/);\n  \n   if (aMatches) {\n    var rowNo = aMatches[1];\n    if (newVal == \"SI\") {\n      //para poner el resto en NO\n      var nRows = $(\"#grd_registro_siniestro\").getNumberRows(); \n\n      for (var i = 1; i <= nRows; i++) {\n        var grd_s_cobertura = $(\"#grd_registro_siniestro\").getValue(rowNo, 1)\t;//cobertura\n        if(i != rowNo)\n        \t$(\"#form\\\\[grd_registro_siniestro\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_s_aplicar\\\\]\").val(\"NO\");\n        else{\n          if(grd_s_cobertura == 'Robo parcial'){\n            $('#lbl_robo_parcial').show();\n          \t$('#frm_rp_componente_e').show();\n          \t$('#frm_componente_accesorios').show();\n          }\n          if(grd_s_cobertura == 'Daño Parcial'){\n\t\t\t$('#lbl_danio_parcial').show();\n          \t$('#frm_componente_inundado').show();\n          }\n        }          \n      }\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"71261513065657eeaaecd17046159745","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cobertura","name":"grd_s_cobertura","label":"Causa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"25","width":100,"title":"Causa","var_name":"grd_registro_siniestro"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_sumaAsegurada","name":"grd_s_sumaAsegurada","label":"Suma Asegurada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Suma Asegurada"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_aplicar","name":"grd_s_aplicar","label":"Aplicar","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"columnWidth":"15","width":100,"title":"Aplicar"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_montoSolicitado","name":"grd_s_montoSolicitado","label":"Monto Solicitado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Monto Solicitado"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}],[{"type":"label","id":"lbl_robo_parcial","label":"Robo Parcial","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_rp_componente_e","var_uid":"25017143865657eeaa895a4043415075","dataType":"string","protectedValue":false,"id":"frm_rp_componente_e","name":"frm_rp_componente_e","label":"Componente Electrico / Electrónico / Hibrídos (computador, cableado)","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache