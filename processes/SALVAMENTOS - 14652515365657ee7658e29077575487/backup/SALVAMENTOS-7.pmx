        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//<?php
//Incializar Datos Solicitud
$pro_uid = @@PROCESS;
@@tri_msg_error = '';

//catalogos de marcas modelos
//obtengo el token
