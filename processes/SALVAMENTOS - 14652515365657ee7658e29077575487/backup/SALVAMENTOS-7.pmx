gurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n      $(\"#frm_asegurado_identificacion\").setValue(cedula);\n      $(\"#frm_asegurado_nombres\").setValue(nombres);\n      $(\"#frm_asegurado_telefono\").setValue(telefono);  \n      \n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n    $(\"#frm_asegurado_identificacion\").setValue('');\n      $(\"#frm_asegurado_nombres\").setValue('');\n      $(\"#frm_asegurado_telefono\").setValue('');  \n      \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"26190146365657eeaa02b55079463741","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"94904485165657eea9f7d15026624243","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_identificacion","colSpan":4},{"type":"text","variable":"frm_asegurado_nombres","var_uid":"64683053965657eea9fb983016735698","dataType":"string","protectedValue":false,"id":"frm_asegurado_nombres","name":"frm_asegurado_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_nombres","colSpan":8}],[{"type":"text","variable":"frm_asegurado_telefono","var_uid":"31627305865657eeaa01925056290423","dataType":"string","protectedValue":false,"id":"frm_asegurado_telefono","name":"frm_asegurado_telefono","label":"Telefono","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_telefono","colSpan":4},{"type":"dropdown","variable":"frm_asegurado_relacion