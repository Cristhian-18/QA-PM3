        <dyn_content><![CDATA[{"name":"SubForm Valores Aprobados","description":"SubForm Valores Aprobados","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"66500223665657eea88bf88096551186","name":"SubForm Valores Aprobados","description":"SubForm Valores Aprobados","mode":"edit","script":{"type":"js","code":"$(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100;\n  let min = 0;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_valoresRepuestos1\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_valorRepuestosProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valorRepuestosProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_manoObraProformada\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_totalProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_diasEstimadosReparacion\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresAprobados_diasEstimadosReparacion\").setValue(value);\n})\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"16567499865657eeaace748014771575","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos proforma sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valoresRepuestos1","var_uid":"77632846965657eeaac6512096516226","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valoresRepuestos1","name":"frm_valoresAprobados_valoresRepuestos1","label":"Valores Repuestos Aprobados sin descuento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valoresRepuestos1","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado","var_uid":"27731480265657eeaacb959027193253","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_procentajeDescuentoProformado","name":"frm_valoresSiniestro_procentajeDescuentoProformado","label":"Procentaje Descuento Proformado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_v