unt is set to \"Discount\", then enable the discountRate field in the same row. \n//If set to \"No Discount\", then disable the discountRate field.\n$( \"#\" + formId ).setOnchange( function(fieldId, newVal, oldVal) {\n  //check if a field changed inside the grid:\n  var aMatches = fieldId.match(/^\\[grd_registro_siniestro\\]\\[(\\d+)\\]\\[grd_s_aplicar\\]$/);\n  \n   if (aMatches) {\n    var rowNo = aMatches[1];\n    if (newVal == \"SI\") {\n      //para poner el resto en NO\n      var nRows = $(\"#grd_registro_siniestro\").getNumberRows(); \n\n      for (var i = 1; i <= nRows; i++) {\n        var grd_s_cobertura = $(\"#grd_registro_siniestro\").getValue(rowNo, 1)\t;//cobertura\n        if(i != rowNo)\n        \t$(\"#form\\\\[grd_registro_siniestro\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_s_aplicar\\\\]\").val(\"NO\");\n        else{\n          if(grd_s_cobertura == 'Robo parcial'){\n            $('#lbl_robo_parcial').show();\n          \t$('#frm_rp_componente_e').show();\n          \t$('#frm_componente_accesorios').show();\n          }\n          if(grd_s_cobertura == 'Daño Parcial'){\n\t\t\t$('#lbl_danio_parcial').show();\n          \t$('#frm_componente_inundado').show();\n          }\n        }          \n      }\n    }\n  }\n});\n*/"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"71261513065657eeaaecd17046159745","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cobertura","name":"grd_s_cobertura","label":"Causa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow