tabase","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_registro","label":"<span class=\"subtitulo\" id=\"isubt_registro\" subform=\"41246456365657eea871e92041543660\"> <i class=\"glyphicon glyphicon-minus\"></i> \nRegistro causa siniestros</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"41246456365657eea871e92041543660","name":"SubForm Registro Causa Siniestros","description":"SubForm Registro Causa Siniestros","mode":"edit","script":{"type":"js","code":"\n/*console.log($('#grd_registro_siniestro').getValue());\nvar formId = $(\"#form\\\\[grd_s_impValor\\\\]\\\\[2\\\\]\").getControl(); //get Dynaform's ID  \nconsole.log(formId);\nfunction checkGrid(newVal, oldVal) {\n    //$(\"#grd_registro_siniestro\").setValue(\"Mostrar2\", 1, 6);\n    //console.log(\"SHOIW2\")\n    //console.log(newVal);\n}\n\ncheckGrid($(\"#grd_registro_siniestro\").getValue(1, 6), '');\n$('#grd_registro_siniestro').setOnchange(checkGrid);*/\n//$(\"#frm_informacion_adicional2\").getControl().attr('disabled', true);\n//        $(\"#frm_informacion_adicional2\").getControl().attr('readonly', true);\n\n\nconsole.log($('#grd_registro_siniestro').getControl(1,4));\n\nfunction checkGrid(newVal, oldVal){\n    console.log(newVal);\n    let rowNum = 0;\n    rowNum = $(\"#grd_registro_siniestro\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        console.log($(\"#grd_registro_siniestro\").getControl(i,4));\n        if($(\"#grd_registro_siniestro\").getValue(i,4) == \"SI\"){\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', false);\n        }else{\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', true);\n            $(\"#grd_registro_siniestro\").setValue(\"\",i,6)\n        }\n    }\n}\n\ncheckGrid($(\"#grd_registro_siniestro\").getValue(), '');\n$('#grd_registro_siniestro').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"71261513065657eeaaecd17046159745","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cobertura","name":"grd_s_cobertura","label":"Causa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"40","width":100,"title":"Causa","var_name":"grd_registro_siniestro"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_limiteMin","name":"grd_s_limiteMin","label":"Limite Min","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Limite Min"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_limiteMax","name":"grd_s_limiteMax","label":"Limite Max","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Limite Max"},{"type":