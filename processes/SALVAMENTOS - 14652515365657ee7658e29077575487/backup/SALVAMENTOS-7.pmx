        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        if ($accion == "VERIFICAR") {
            $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' fue asignado a su bandeja para revisión del ajustador interno</tipo>
        </p>';
        } elseif ($accion == "CONTINUAR") {
            $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' fue asignado a su bandeja para revisión del PDA</tipo>
        </p>';
        } elseif ($accion == "SOLICITAR") {
            $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' requiere de mas información</tipo>
        </p>';
