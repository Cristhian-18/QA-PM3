$datos_result = $result->data;

foreach($datos_result as $dataMarc){
    $arr_Dtaparen[$i] = array($dataMarc->idParentesco, $dataMarc->txtDesc);
    $i++;
}

@@arr_Dtaparen = $arr_Dtaparen;
}
catch(Exception $e)
{
