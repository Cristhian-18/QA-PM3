        <dyn_content><![CDATA[{"name":"SubForm Parte Policial","description":"SubForm Parte Policial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"15894986365657eea8bd0f2052191535","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"\nfunction asesoriaLegal(newVal, oldVal) {\n\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_informacionResponsable').show();\n    $('#frm_siniestro_informacionResponsable').enableValidation();\n  } else {\n    $('#frm_siniestro_informacionResponsable').setValue(\"\");\n  }\n}\n\n//execute when the Dynaform loads:\nasesoriaLegal($(\"#frm_requiere_AsesoriaLegal\").getValue(), '');\n$('#frm_requiere_AsesoriaLegal').setOnchange(asesoriaLegal);\n\n\nfunction informacionResponsable(newVal, oldVal) {\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_nombreResponsable').show();\n    $('#frm_siniestro_placaResponsable').show();\n    $('#frm_siniestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n//execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"32474785365657eeaa884e7050013519","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"35309941765657eeaa87099005960863","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"radio","variable":"frm_siniestro_afectado","var_uid":"16583447365657eeaa8a860055244857","dataType":"string","protectedValue":false,"id":"frm_siniestro_afectado","name":"frm_siniestro_afectado","label":"¿A juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"Afectado","label":"Afectado"},{"value":"Responsable","label":"Responsable"}],"var_name":"frm_siniestro_afectado","colSpan":6},{"type":"dropdown","variable":"frm_siniestro_informacionResponsable","var_uid":"58254007065657eeaa8f002011478318","dataType":"string","protectedValue":false,"id":"frm_siniestro_informacionResponsable","name":"frm_siniestro_informacionResponsable","label":"¿Tiene información del responsable?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione una ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_siniestro_informacionResponsable","colSpan":6}],[{"type":"text","variable":"frm_siniestro_placaResponsable","var_uid":"52023738865657eeaa93b03019640298","dataType":"string","protectedValue":false,"id":"frm_siniestro_placaResponsable","name":"frm_siniestro_placaResponsable","label":"# de Placa del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_placaResponsable","colSpan":6},{"type":"text","variable":"frm_siniestro_nombreResponsable","var_uid":"49052635865657eeaa90382095217019","dataType":"string","protectedValue":false,"id":"frm_siniestro_nombreResponsable","name":"frm_siniestro_nombreResponsable","label":"Nombre del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_nombreResponsable","colSpan":6}]],"variables":[{"var_uid":"32474785365657eeaa884e7050013519","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_requiere_PartePolicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35309941765657eeaa87099005960863","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_requiere_AsesoriaLegal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"16583447365657eeaa8a860055244857","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_siniestro_afectado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"58254007065657eeaa8f002011478318","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_siniestro_informacionResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"52023738865657eeaa93b03019640298","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_siniestro_placaResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"49052635865657eeaa90382095217019","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_siniestro_nombreResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
