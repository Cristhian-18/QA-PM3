tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Usuario"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCausa","name":"grd_hs_codCausa","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCobertura","name":"grd_hs_codCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Historial de Siniestros","colSpan":12}]],"variables":[{"var_uid":"20981959065657eeaae96b5085239311","prj_uid":"14652515365657ee7658e29077575487","var_name":"grd_historial_siniestros","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_ppolicial","label":"<span class=\"subtitulo\" id=\"isubt_ppolicial\" subform=\"15894986365657eea8bd0f2052191535\"> <i class=\"glyphicon glyphicon-minus\"></i> \nParte Policial</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"15894986365657eea8bd0f2052191535","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"\nfunction actionPartePolicial(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_siniestro_afectado\").getValue())\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'NO'){\n      if($(\"#frm_siniestro_afectado\").getValue() == \"Afectado\"){\n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      }\n    } \n}\n\nfunction actionResponsableSiniestro(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_requiere_PartePolicial\").getValue())\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'Afectado'){\n      if($(\"#frm_requiere_PartePolicial\").getValue() == \"NO\"){\n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      }\n    } \n}\n\n//execute when the Dynaform loads:\nactionPartePolicial($(\"#frm_requiere_PartePolicial\").getValue(), ''); \n$('#frm_requiere_PartePolicial').setOnchange(actionPartePolicial);\n\nactionResponsableSiniestro($(\"#frm_siniestro_afectado\").getValue(), ''); \n$('#frm_siniestro_afectado').setOnchange(actionResponsableSiniestro);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"32474785365657eeaa884e7050013519","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","require