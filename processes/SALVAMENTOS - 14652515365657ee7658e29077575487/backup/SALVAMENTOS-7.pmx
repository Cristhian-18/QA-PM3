$app_number = @@APP_NUMBER;
$tipo_req = @@frm_datosSolicitud_tipo_label;
$taller = @@frm_taller;

//correos

$sqlCorreos = "SELECT ac.CAMPO1 , ac.CAMPO2 FROM  ADMIN_CATALOGOS ac WHERE ac.COD_CATALOGO = 'COPIAS_MAIL' AND ac.INTEGRACION = '14652515365657ee7658e29077575487'
AND ac.DESCRIPCION ='Envio_correos' LIMIT 1";

$resultadoCorreos = executeQuery($sqlCorreos);


$host = @@URL_SERVER_SQL;



$cc = $resultadoCorreos[1]['CAMPO2'];
$bcc = $resultadoCorreos[1]['CAMPO1'];
//validacion por tarea
switch (@@TASK) {
    //tarea 1
    case '47793586864a1915c3740e7013393106':
        $de = '';
        $para = @@frm_responsable_emision_mail;
        $para = 'jcchachalo@gmail.com';


        $asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $texto .= '<p align="justify">Se le notifica que se requiere la asignación del caso ' . $app_number . ' de tipo
    ' . $tipo_req . ' para su realización, por favor gestionarlo de acuerdo a las condiciones solicitadas</tipo>
    </p>';
        $comentario = @@frm_comentario;
        $accion = @@frm_accion;
        $plantilla_rec = 'Plantilla_mail.html';

        @@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
        $texto));

        break;
    //tarea 2
    case '21947251964a193141bc7e8005186014':
        $de = '';
        $para = @@frm_responsable_emision_mail;
        $para = 'jcchachalo@gmail.com';


        $asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' atendido por el taller
    ' . $taller . ' fue revisado, por favor darle el seguimiento necesario.
    </tipo>
    </p>';
        $comentario = @@frm_comentario;
        $accion = @@frm_accion;
        $plantilla_rec = 'Plantilla_mail.html';

        @@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
        $texto));

        break;

    //T2: Analizar Coberturas Siniestro
    case '72144115864a1924c5ab549003287587':
        $de = '';
        $para = @@frm_responsable_emision_mail;
        $para = 'jcchachalo@gmail.com';


        $asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $aAttachments = array();
        $accion = @@frm_accion;
        $caseID = @@APPLICATION;
        if ($accion == "ESPERAR") {
            $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' fue mantenido en su bandeja</tipo>
        </p>';
        } elseif ($accion == "CONTINUAR") {

            $outputUID = '563796961654b0c94578a15070715888';
            $sql = "SELECT
        MAX(DOC_VERSION) AS MAX_VERSION, APP_DOC_UID
        FROM
        APP_DOCUMENT where APP_UID = '$caseID'
        and APP_DOC_TYPE = 'OUTPUT' and DOC_UID = '$outputUID'";
            $res = executeQuery($sql);
            $docUID = $res['1']['APP_DOC_UID'];
            $v = $res['1']['MAX_VERSION'];

            //Creo link de archivo
            $server = $host . '/syscertificacion/es/3sesa/cases/cases_ShowOutputDocument?a=' . $docUID . '&v=' . $v . '&ext=pdf';
            $niv1 = substr($caseID, 0, 3);
            $niv2 = substr($caseID, 3, 3);
            $niv3 = substr($caseID, 6, 3);
            $niv4 = substr($caseID, 9);

            $doc_logico = '/opt/processmaker/shared/sites/workflow/files' . PATH_SEP . $niv1 . PATH_SEP . $niv2 . PATH_SEP . $niv3 . PATH_SEP . $niv4 . PATH_SEP . 'outdocs/' . $docUID . '_' . $v . '.pdf';

            @@tri_link_certificado = $server;

            $aAttachments = PMFAddAttachmentToArray($aAttachments, basename($doc_logico), $doc_logico);

            @@tri_mail_certificado = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array(), $aAttachments);

            $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' pasó a revisión</tipo>
        </p>';
        } else {
            $texto .= '<p align="justify">Se le notifica que su caso necesita información adicional
        </tipo>
        </p>';
        }
        $comentario = @@frm_comentario;
        $accion = @@frm_accion;
        $plantilla_rec = 'Plantilla_mail.html';

        @@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
        $texto), $aAttachments);

        break;


    //T2.1: Realizar Gestion Siniestro Cliente
    case '1346005026526fac1a91d03001561073':
        $de = '';
        $para = @@frm_responsable_emision_mail;
        $para = 'jcchachalo@gmail.com';


        $asunto = "Notificación de caso en BPM " . @#APP_NUMBER;
        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' fue devuelto por el cliente / broker con la información solicitada
    </tipo>
    </p>';
        $comentario = @@frm_comentario;
