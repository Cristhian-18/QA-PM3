id":"14652515365657ee7658e29077575487","var_name":"frm_vehiculo_chasis","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"47599397665657eeaad4097018670756","var_name_old":"frm_vehiculo_chasis","prj_uid_old":"14652515365657ee7658e29077575487","create":false},{"var_uid":"42376754865657eeaad57d9070201763","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_vehiculo_color","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"42376754865657eeaad57d9070201763","var_name_old":"frm_vehiculo_color","prj_uid_old":"14652515365657ee7658e29077575487","create":false}]}]}]]></dyn_content>
