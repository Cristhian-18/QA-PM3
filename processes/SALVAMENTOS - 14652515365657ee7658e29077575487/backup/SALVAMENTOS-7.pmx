wTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_taller_fechaIngreso","colSpan":6}],[{"type":"dropdown","variable":"frm_taller_transitoVehiculo","var_uid":"55757908265657eeaab8ac8011685369","dataType":"string","protectedValue":false,"id":"frm_taller_transitoVehiculo","name":"frm_taller_transitoVehiculo","label":"¿Vehículo en Tránsito?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[],"var_name":"frm_taller_transitoVehiculo","colSpan":12}]],"variables":[{"var_uid":"14459654165657eeaaa52a4014237119","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_taller_ExisteVehiculo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"39897148665657eeaaa6870016023192","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_taller_fechaIngreso","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"55757908265657eeaab8ac8011685369","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_taller_transitoVehiculo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
