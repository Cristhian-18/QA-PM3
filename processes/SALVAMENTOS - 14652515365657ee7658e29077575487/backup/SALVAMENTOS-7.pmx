        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $texto .= '<p align="justify">Se le notifica que el caso ' . $app_number . ' fue atendido por MUNDO PARTES para su análisis
    y cotización, por favor darle el seguimiento necesario.
    </tipo>
    </p>';
        $comentario = @@frm_comentario;
