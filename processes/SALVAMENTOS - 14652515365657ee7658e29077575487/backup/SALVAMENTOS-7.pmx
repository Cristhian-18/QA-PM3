dErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Analista asignado"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_profAlcacne_tipo","name":"grd_profAlcacne_tipo","label":"Tipo de Alcance","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"}],"columnWidth":"10","width":100,"title":"Tipo de Alcance"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_profAlcacne_motivo","name":"grd_profAlcacne_motivo","label":"Motivo de Alcance","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"title":"Motivo de Alcance"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_profAlcacne_valor","name":"grd_profAlcacne_valor","label":"Valor Proforma","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Valor Proforma"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_profAlcacne_vAprobado"