lt":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"64507468365657eeaa20703053632759","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"64507468365657eeaa20703053632759","var_name_old":"frm_comentario","prj_uid_old":"14652515365657ee7658e29077575487"},{"var_uid":"90247686565657eeaaf65c6069117743","prj_uid":"14652515365657ee7658e29077575487","var_name":"tri_bandera_mundoMotriz","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
