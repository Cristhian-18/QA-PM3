20703053632759","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"64507468365657eeaa20703053632759","var_name_old":"frm_comentario","prj_uid_old":"14652515365657ee7658e29077575487","create":false}]}]}]]></dyn_content>
