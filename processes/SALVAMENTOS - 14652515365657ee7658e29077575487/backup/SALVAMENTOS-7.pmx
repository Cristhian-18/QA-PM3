        <dyn_content><![CDATA[{"name":"Form 3 Generar Listado Subasta","description":"Form 3 Generar Listado Subasta","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"1237895986576906a8080a6063923479","name":"Form 3 Generar Listado Subasta","description":"Form 3 Generar Listado Subasta","mode":"edit","script":{"type":"js","code":"function action(newVal, oldVal) {\n    $(\"#file_retiroSalvamento\").hide();\n    $(\"#file_ingresoSalvamento\").hide();\n    $(\"#file_retiroSalvamento\").disableValidation();\n    $(\"#file_ingresoSalvamento\").disableValidation();\n\n    if (newVal == 'CONTINUAR') {\n        $(\"#file_retiroSalvamento\").show();\n        $(\"#file_ingresoSalvamento\").show();\n        $(\"#file_retiroSalvamento\").enableValidation();\n        $(\"#file_ingresoSalvamento\").enableValidation();\n    }\n\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(action);\n\n$(\"#repuestos\").hide();\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'documentos':\n            $(\"#sub_documentos_caso\").show();\n            $(\"#23271031065657eea890261027484884\").show();\n            break;\n        case 'historial':\n            $(\"#sub_historial_caso\").show();\n            $(\"#38388078065657eea86f554052132558\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n    $(\"#sub_informacion\").hide();\n    $(\"#35324623065767d4e255aa7070191370\").hide();\n    $(\"#sub_ubicacionSalvamento\").hide();\n    $(\"#4617805716576880a1eae81047564293\").hide();\n\n    $(\"#sub_historial_caso\").hide();\n    $(\"#38388078065657eea86f554052132558\").hide();\n    $(\"#sub_documentos_caso\").hide();\n    $(\"#23271031065657eea890261027484884\").hide();\n\n\n}\nfunction mostrar_solicitud() {\n    $(\"#sub_informacion\").show();\n    $(\"#35324623065767d4e255aa7070191370\").show();\n    $(\"#sub_ubicacionSalvamento\").show();\n    $(\"#4617805716576880a1eae81047564293\").show();\n\n}\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76037149265657eea8b4f56001848192","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"11967327665657eea8a05c7022834649","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"46543713065657eeaaf7