        <dyn_content><![CDATA[{"name":"SubForm Añadir Alcance adicional","description":"SubForm Añadir Alcance adicional","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"99373678665657eea884bd9020840251","name":"SubForm Añadir Alcance adicional","description":"SubForm Añadir Alcance adicional","mode":"edit","script":{"type":"js","code":"$(\"#frm_alcanceAdicional_valorRepuestos\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorRepuestos\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_valorMano\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorMano\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_total\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_total\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_alcanceAdicional_valorRepuestos","var_uid":"67760620265657eea9e3e09076697717","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorRepuestos","name":"frm_alcanceAdicional_valorRepuestos","label":"Valor de Repuestos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorRepuestos","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorMano","var_uid":"71432439865657eea9e12d4038192055","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorMano","name":"frm_alcanceAdicional_valorMano","label":"Valor de Mano de Obra","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorMano","colSpan":6}],[{"type":"text","variable":"frm_alcanceAdicional_total","var_uid":"91067838365657eea9dfcb9056758149","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_total","name":"frm_alcanceAdicional_total","label":"Valor Total","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"(frm_alcanceAdicional_valorRepuestos+frm_alcanceAdicional_valorMano)","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_total","colSpan":12}]],"variables":[{"var_uid":"67760620265657eea9e3e09076697717","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_alcanceAdicional_valorRepuestos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"71432439865657eea9e12d4038192055","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_alcanceAdicional_valorMano","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"91067838365657eea9dfcb9056758149","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_alcanceAdicional_total","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":