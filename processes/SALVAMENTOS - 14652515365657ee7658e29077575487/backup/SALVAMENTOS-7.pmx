le":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_recibido","name":"frm_gvs_recibido","label":"Recibido","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"columnWidth":"10","width":100,"title":"Recibido"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_observaciones","name":"frm_gvs_observaciones","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Observaciones"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_estado","name":"frm_gvs_estado","label":"Estado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"Aprobado","label":"Aprobado"},{"value":"Negado","label":"Negado"},{"value":"Pendiente","label":"Pendiente aprobación del cliente"},{"value":"Indemnizacion","label":"Indemnización"}],"columnWidth":"10","width":100,"title":"Estado"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"PROFORMA","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_docs","label":"Documentos del caso\n","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"23271031065657eea890261027484884","name":"SubForm Documentos del caso","description":"SubForm Documentos del caso","mode":"edit","script":{"type":"js","code":"// Resuelve el bug de que el link de la grilla\n// no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    /*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    */\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  // Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"/plugin/beesmartec/core_librerias/datatables/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","plac