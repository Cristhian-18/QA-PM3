ow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"35309941765657eeaa87099005960863","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}]],"variables":[{"var_uid":"32474785365657eeaa884e7050013519","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_requiere_PartePolicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35309941765657eeaa87099005960863","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_requiere_AsesoriaLegal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_asegurado","label":"<span class=\"subtitulo\" id=\"isubt_asegurado\" subform=\"77577551765657eea869184079116697\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos del conductor</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"77577551765657eea869184079116697","name":"SubForm Datos Asegurado","description":"SubForm Datos Asegurado","mode":"edit","script":{"type":"js","code":"//CONDUCTOR\nfunction checkConductor(newVal, oldVal) {\n    if (newVal == 'A') {\n        $(\"#frm_asegurado_nombres\").setValue($(\"#frm_busqueda_nombres\").getValue());\n      \t$(\"#frm_asegurado_identificacion\").setValue($(\"#frm_busqueda_identificacion\").getValue());\n    } else {\n        $(\"#frm_asegurado_nombres\").setValue('');\n      \t$(\"#frm_asegurado_identificacion\").setValue('');\n    }\n}\n//execute when the Dynaform loads:\nif ($(\"#frm_asegurado_tipo\").getValue() != '') {\n    checkConductor($(\"#frm_asegurado_tipo\").getValue(), '');\n} \n$('#frm_asegurado_tipo').setOnchange(checkConductor); //execute when field's value changes\n\n//PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n    $.ajax({\n      url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_provincias',\n        'frm_dato' : newVal,\n        'frm_tipo' : 'provincia'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_asegurado_provincia').getControl().empty();\n  \t\t$('#frm_asegurado_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_asegurado_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n//execute when the Dynaform loads:\nif ($(\"#frm_asegurado_pais\").getValue() != '') {\n    checkProvincia($(\"#frm_asegurado_pais\").getValue(), '');\n} \n$('#frm_asegurado_pais').setOnchange(checkProvincia); //execute when field's value changes\n\n//CANTON\nfunction checkCanton(newVal, oldVal) {\n  var frm_dato = $(\"#frm_asegurado_pais\").getValue();\n    $.ajax({\n      url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_provincias',\n        'frm_dato' : frm_dato,\n        'frm_prov' : newVal,\n        'frm_tipo' : 'canton'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_asegurado_ciudad').getControl().empty();\n  \t\t$('#frm_asegurado_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_asegurado_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n//execute when the Dynaform loads:\nif ($(\"#frm_asegurado_provincia\").getValue() != '') {\n    checkCanton($(\"#frm_asegurado_provincia\").getValue(), '');\n} \n$('#frm_asegurado_provincia').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  $(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n  $(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n  $(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n  $(\"#frm_taller_ciudad\").setValue(\"Q\");\n  $(\"#frm_taller_prioridad\").setValue(\"1\");\n  $(\"#frm_taller_capacidad\").setValue(\"20\");\n  $(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n  $(\"#frm_taller_saldo\").setValue(\"15\");\n  $(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n  $(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n  $(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#subt_ve_afectados\").show();\n      \t$(\"#15565307165657eea877078043143405\").show();\n    } else {\n       $(\"#subt_ve_afectados\").hide();\n      \t$(\"#15565307165657eea877078043143405\").hide();\n    }\n}\n//execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#iisubt_pr_afectados\").show();\n      \t$(\"#80125453265657eea8be050001169192\").show();\n    } else {\n       $(\"#iisubt_pr_afectados\").hide();\n      \t$(\"#80125453265657eea8be050001169192\").hide();\n    }\n}\n//execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#isubt_pe_afectados\").show();\n      \t$(\"#72757335765657eea8a3ea5068757906\").show();\n    } else {\n       $(\"#isubt_pe_afectados\").hide();\n      \t$(\"#72757335765657eea8a3ea5068757906\").hide();\n    }\n}\n//execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","va