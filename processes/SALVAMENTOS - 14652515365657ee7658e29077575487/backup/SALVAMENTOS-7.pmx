        <dyn_content><![CDATA[{"name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"77577551765657eea869184079116697","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"edit","script":{"type":"js","code":"//henry\nlet tipoSolicitud = $(\"#frm_asegurado_tipo\").getValue();\nif (tipoSolicitud == 'A') {\nlet cedula = $(\"#frm_busqueda_identificacion\").getValue();\nlet nombres = $(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"26190146365657eeaa02b55079463741","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"94904485165657eea9f7d15026624243","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_identificacion","colSpan":4},{"type":"text","variable":"frm_asegurado_nombres","var_uid":"64683053965657eea9fb983016735698","dataType":"string","protectedValue":false,"id":"frm_asegurado_nombres","name":"frm_asegurado_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_nombres","colSpan":8}],[{"type":"text","variable":"frm_asegurado_telefono","var_uid":"31627305865657eeaa01925056290423","dataType":"string","protectedValue":false,"id":"frm_asegurado_telefono","name":"frm_asegurado_telefono","label":"Telefono","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_telefono","colSpan":4},{"type":"dropdown","variable":"frm_asegurado_relacion","var_uid":"36788752565657eea9fee43073823763","dataType":"string","protectedValue":false,"id":"frm_asegurado_relacion","name":"frm_asegurado_relacion","label":"Relacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaparen","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_asegurado_relacion","colSpan":4},{"type":"text","variable":"frm_asegurado_relacion_otro","var_uid":"38333425465657eeaa00363057595693","dataType":"string","protectedValue":false,"id":"frm_asegurado_relacion_otro","name":"frm_asegurado_relacion_otro","label":"Especifique","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_relacion_otro","colSpan":4}]],"variables":[{"var_uid":"26190146365657eeaa02b55079463741","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_asegurado_tipo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"94904485165657eea9f7d15026624243","prj_uid":"14652515365657ee7658e29077575487","var_name":"frm_asegurado_identificacion","var_field_type":"string","var_field_size":10,"var_l