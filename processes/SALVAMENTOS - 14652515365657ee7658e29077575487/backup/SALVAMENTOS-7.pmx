        <dyn_content><![CDATA[{"name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"36011638065657eea8c20d2067128389","name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","mode":"edit","script":{"type":"js","code":"$(\"#grd_valores_siniestros_alcance\").hideColumn(9);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(11);\n\n\nfunction checkNewGrid(newVal, oldVal) {\n  console.log(\"CHECK\");\n  let rowNum = 0;\n  rowNum = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n  console.log(rowNum);\n  for (let i= 1; i <= rowNum; i++) {\n      let disponible = $(\"#grd_valores_siniestros_alcance\").getValue(i, 7);\n\n      if (disponible == \"DISPONIBLE\") {\n          $(\"#grd_valores_siniestros_alcance\").setValue(\"Aprobado\", i,11);\n      } \n      if (disponible == \"IMPORTACIÓN\") {\n        $(\"#grd_valores_siniestros_alcance\").setValue(\"Pendiente\", i,11);\n    } \n    if (disponible == \"FABRICACION\") {\n      $(\"#grd_valores_siniestros_alcance\").setValue(\"Indemnizacion\", i,11);\n  \n    }\n     \n  }\n}\ncheckNewGrid($(\"#grd_valores_siniestros_alcance\").getValue(), '');\n$(\"#grd_valores_siniestros_alcance\").change(checkNewGrid);\n\n\n$('.menu').on('click', function () {\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#23271031065657eea890261027484884\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#38388078065657eea86f554052132558\").show();\n      break;\n    case 'repuestos':\n      $('#sub_valores').show()\n      $('#50877823865657eea8835d8059140276').show()\n      break\n  }\n  $(\"#frm_documentos_otros\").hide();\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#52345823565657eea89f273081823396\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#39942008765657eea8c60e4037826925\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#77577551765657eea869184079116697\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#40264027065657eea8a90a6057516237\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#41246456365657eea871e92041543660\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#15565307165657eea877078043143405\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#72757335765657eea8a3ea5068757906\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#80125453265657eea8be050001169192\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#42369092065657eea875f65039015911\").hide();\n  $(\"#sub_valores\").hide();\n  $('#83349221365657eea8935c0034368501').hide()\n  $(\"#81367868865657eea8ba0a9094814227\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#23271031065657eea890261027484884\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#38388078065657eea86f554052132558\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#85517892965657eea863bb6085915178\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#70029930365657eea866da2082229749\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#15894986365657eea8bd0f2052191535\").hide();\n  $(\"#subt_direccionador\").hide();\n  $(\"#17233983365657eea8880d0032087370\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#37834123465657eea8c1164099238212\").hide();\n\n  $(\"#subt_accidente\").hide();\n  $(\"#33751146965657eea8867b4097970847\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#15565307165657eea877078043143405\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#72757335765657eea8a3ea5068757906\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#80125453265657eea8be050001169192\").hide();\n  $(\"#94611480865657eea8ac269071748434\").hide();\n  $('#50877823865657eea8835d8059140276').hide()\n\n}\nfunction mostrar_solicitud() {\n  $(\"#sub_busqueda\").show();\n  $(\"#52345823565657eea89f273081823396\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#39942008765657eea8c60e4037826925\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#77577551765657eea869184079116697\").show();\n  //$(\"#subt_detalle\").show();\n  //$(\"#40264027065657eea8a90a6057516237\").show();\n  //$(\"#subt_registro\").show();\n  //$(\"#41246456365657eea871e92041543660\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#15565307165657eea877078043143405\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#72757335765657eea8a3ea5068757906\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#80125453265657eea8be050001169192\").show();\n  $(\"#sub_docs\").show();\n  $(\"#42369092065657eea875f65039015911\").show();\n  $(\"#81367868865657eea8ba0a9094814227\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#85517892965657eea863bb6085915178\").show();\n  $(\"#subt_hsiniestros\").show();\n  $(\"#70029930365657eea866da2082229749\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#15894986365657eea8bd0f2052191535\").show();\n  $(\"#subt_direccionador\").show();\n  $(\"#17233983365657eea8880d0032087370\").show();\n  $(\"#subt_friss\").show();\n  $(\"#37834123465657eea8c1164099238212\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#33751146965657eea8867b4097970847\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#15565307165657eea877078043143405\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#72757335765657eea8a3ea5068757906\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#80125453265657eea8be050001169192\").show();\n  $(\"#94611480865657eea8ac269071748434\").show();\n\n\n}\n\nocultar_todo();\nmostrar_solicitud();\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"GENERAR COTIZACIÓN","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"76037149265657eea8b4f56001848192","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_direccionador","label":"<span class=\"subtitulo\" id=\"isubt_direccionador\" subform=\"17233983365657eea8880d0032087370\"> <i class=\"glyphicon glyphicon-minus\"></i> \nInformación del taller</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"17233983365657eea8880d0032087370","name":"SubForm Información delTaller","description":"SubForm Direccionador Taller","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_taller","var_uid":"25745403965657eeaa9e0b1090674408","dataType":"string","protectedValue":false,"id":"frm_taller","name":"frm_taller","label":"Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_taller","colSpan":6},{"type":"text","variable":"frm_taller_nombreContacto","var_uid":"76570022865657eeaaa9155084178309","dataType":"string","protectedValue":false,"id":"frm_taller_nombreContacto","name":"frm_taller_nombreContacto"