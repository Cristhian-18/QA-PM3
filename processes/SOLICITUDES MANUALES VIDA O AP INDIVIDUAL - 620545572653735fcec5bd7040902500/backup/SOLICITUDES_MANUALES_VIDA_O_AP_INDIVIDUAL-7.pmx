AR","label":"Impresión de póliza"},{"value":"REGRESAR","label":"Regresar al analista de suscripción"}],"var_name":"frm_accion","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000004","label":"<span class=\"subtitulo\" id=\"id_documentos\" subform=\"378147771654544cb8cef96099263996\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos Para Aplicar el Pago\n</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"378147771654544cb8cef96099263996","name":"SubForm Cobranzas","description":"SubForm Cobranzas","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_cobranza_banco","var_uid":"612153586654544d3a53ae5056063862","dataType":"string","protectedValue":false,"id":"frm_cobranza_banco","name":"frm_cobranza_banco","label":"Banco","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT  CODIGO,DESCRIPCION  \nFROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO='BANCOS'  AND ESTADO=1 AND (VALOR='E' OR VALOR ='EG')\nORDER BY DESCRIPCION ASC","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_cobranza_banco","colSpan":6},{"type":"dropdown","variable":"frm_cobranza_tipo_pago","var_uid":"475015628654544d3a910b0093134173","dataType":"string","protectedValue":false,"id":"frm_cobranza_tipo_pago","name":"frm_cobranza_tipo_pago","label":"Tipo de Pago","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'MEDIO_PAGO' AND ESTADO = 1","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_cobranza_tipo_pago","colSpan":6}],[{"type":"datetime","variable":"frm_cobranza_fecha","var_uid":"494591974654544d3ac3fb8068464901","dataType":"datetime","protectedValue":false,"id":"frm_cobranza_fecha","name":"frm_cobranza_fecha","label":"Fecha de pago","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_cobranza_fecha","colSpan":6},{"type":"text","variable":"frm_cobranza_referencia","var_uid":"609337951654544d3af7147027042854","dataType":"string","protectedValue":false,"id":"frm_cobranza_referencia","name":"frm_cobranza_referencia","label":"Referencia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cobranza_referencia","colSpan":6}],[{"type":"text","variable":"frm_cobranza_valor","var_uid":"629932125654544d3b29985044032287","dataType":"string","protectedValue":false,"id":"frm_cobranza_valor","name":"frm_cobranza_valor","label":"Valor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[1-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cobranza_valor","colSpan":6},{"type":"textarea","variable":"frm_cobranza_comentario","var_uid":"296359498654544d3b5b426053139949","dataType":"string","protectedValue":false,"id":"frm_cobranza_comentario","name":"frm_cobranza_comentario","label":"Comentario Pago","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_cobranza_comentario","colSpan":6}]],"variables":[{"var_uid":"612153586654544d3a53ae5056063862","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_cobranza_banco","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6785653416457cd5a36b219050380890","var_name_old":"frm_cobranza_banco","prj_uid_old":"5393441295ebc1555705f98060769179"},{"var_uid":"475015628654544d3a910b0093134173","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_cobranza_tipo_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid