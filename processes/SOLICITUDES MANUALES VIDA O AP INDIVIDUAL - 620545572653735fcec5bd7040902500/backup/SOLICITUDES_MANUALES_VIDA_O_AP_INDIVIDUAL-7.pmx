_uid_old":"8799375496521525608b1c5005115762"}],"colSpan":12}],[{"type":"subtitle","id":"subtitle0000000002","label":"<span class=\"subtitulo\" id=\"id_documentos\" subform=\"7498968416537432d84c2b0020993439\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDocumentos del caso\n</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7498968416537432d84c2b0020993439","name":"SubForm Documentos Caso","description":"SubForm Documentos Caso","mode":"edit","script":{"type":"js","code":"// Resuelve el bug de que el link de la grilla\n// no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    /*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    */\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  // Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"/plugin/beesmartec/core_librerias/datatables/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"