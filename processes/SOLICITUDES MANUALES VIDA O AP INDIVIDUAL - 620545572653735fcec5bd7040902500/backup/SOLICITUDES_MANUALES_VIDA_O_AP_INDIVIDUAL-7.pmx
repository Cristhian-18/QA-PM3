        <dyn_content><![CDATA[{"name":"Form1 Ingresar Solicitud","description":"Form1 Ingresar Solicitud","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"85458872165373f689ee9c0013724063","name":"Form1 Ingresar Solicitud","description":"Form1 Ingresar Solicitud","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"SOLICITAR SUSCRIPCIÓN DE PÓLIZA","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"sub_busqueda","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"71308955665373c48163718024105660\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"71308955665373c48163718024105660","name":"SubForm Datos de Solicitud","description":"SubForm Datos de Solicitud","mode":"edit","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = $(\"#frm_datosSolicitud_tipoDoc\").getValue();\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"64812507465373c576fae28042037432","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memo