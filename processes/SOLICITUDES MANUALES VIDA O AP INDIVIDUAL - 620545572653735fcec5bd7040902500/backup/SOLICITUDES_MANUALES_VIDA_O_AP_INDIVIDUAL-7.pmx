flow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"42193161365215257934bd4052424093","var_name_old":"PROCESS","prj_uid_old":"8799375496521525608b1c5005115762","create":false},{"var_uid":"975626655653740113d2a64063205992","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_caso_estado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"232680942652152578dea99040385603","var_name_old":"frm_caso_estado","prj_uid_old":"8799375496521525608b1c5005115762","create":false}],"colSpan":12}]],"variables":[{"var_uid":"984642196653740d99ce2e4043136206","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8092473436568e406b0fda9030992057","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_agente_correo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"893130578653740e469dce3095667088","prj_uid":"620545572653735fcec5bd7040902500","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
