tionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"suscripcion","label":"Solicitud de Suscripción"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"45498500365373c5773b1a1013819618","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_tipoDoc","var_uid":"2910379676545257d5d45e6051694148","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipoDoc","name":"frm_datosSolicitud_tipoDoc","label":"Tipo Documento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"valu