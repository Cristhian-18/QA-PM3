        <dyn_content><![CDATA[{"name":"Form 4 Revision Emision","description":"Form 4 Revision Emision","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"22593586165453d2cc8b187012795939","name":"Form 4 Revision Emision","description":"Form 4 Revision Emision","mode":"edit","script":{"type":"js","code":"function acciones(){\nvar accion =   $(\"#frm_accion\").getControl().val();\n  //alert (\"accion\");\n  \t$(\"#subtitle0000000004\").hide();\n  \t$(\"#378147771654544cb8cef96099263996\").hide();\n  \n  $(\"#frm_cobranza_banco\").disableValidation();\n  $(\"#frm_cobranza_tipo_pago\").disableValidation();\n  $(\"#frm_cobranza_fecha\").disableValidation();\n  $(\"#frm_cobranza_referencia\").disableValidation();\n  $(\"#frm_cobranza_valor\").disableValidation();\n  $(\"#frm_cobranza_comentario\").disableValidation(); \n  $(\"#frm_poliza_numero\").disableValidation(); \n      \n  if(accion == 'PAGAR'){\n    $(\"#subtitle0000000004\").show();\n    $(\"#378147771654544cb8cef96099263996\").show();  \n    $(\"#frm_cobranza_banco\").enableValidation();\n  $(\"#frm_cobranza_tipo_pago\").enableValidation();\n  $(\"#frm_cobranza_fecha\").enableValidation();\n  $(\"#frm_cobranza_referencia\").enableValidation();\n  $(\"#frm_cobranza_valor\").enableValidation();\n  $(\"#frm_cobranza_comentario\").enableValidation();\n    $(\"#frm_poliza_numero\").enableValidation(); \n  }\n  if(accion == 'REGRESAR'){\n     //$(\"#frm_poliza_numero\").enableValidation(); \n  }\n   if(accion == 'CONTINUAR'){\n     $(\"#frm_poliza_numero\").enableValidation(); \n  }\n}\n\n\n$('#frm_accion').setOnchange(acciones);\nacciones();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"ATENDER SOLICITUD","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"sub_busqueda","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"71308955665373c48163718024105660\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"71308955665373c48163718024105660","name":"SubForm Datos de Solicitud","description":"SubForm Datos de Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = $(\"#frm_datosSolicitud_tipoDoc\").getValue();\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"64812507465373c576fae28042037432","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"suscripcion","label":"Solicitud de Suscripción"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"45498500365373c5773b1a1013819618","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_tipoDoc","var_uid":"2910379676545257d5d45e6051694148","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipoDoc","name":"frm_datosSolicitud_tipoDoc","label":"Tipo Documento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"C","label":"Cédula"},{"value":"R","label":"Ruc"},{"value":"P","label":"Pasaporte"}],"var_name":"frm_datosSolicitud_tipoDoc","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"91277203065373c577b5ef3074646792","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"Cedula/Pasaporte/Ruc","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Por favor, ingrese una identificación correcta","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":