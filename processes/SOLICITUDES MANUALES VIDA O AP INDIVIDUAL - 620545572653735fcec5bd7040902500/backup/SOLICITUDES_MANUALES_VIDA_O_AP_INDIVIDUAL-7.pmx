        <dyn_content><![CDATA[{"name":"SubForm Datos de Solicitud","description":"SubForm Datos de Solicitud","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"71308955665373c48163718024105660","name":"SubForm Datos de Solicitud","description":"SubForm Datos de Solicitud","mode":"edit","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = $(\"#frm_datosSolicitud_tipoDoc\").getValue();\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"64812507465373c576fae28042037432","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"suscripcion","label":"Solicitud de Suscripción Normal"},{"value":"desgravamen","label":"Solicitud de Suscripción Desgravamen"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"45498500365373c5773b1a1013819618","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_tipoDoc","var_uid":"2910379676545257d5d45e6051694148","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipoDoc","name":"frm_datosSolicitud_tipoDoc","label":"Tipo Documento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"C","label":"Cédula"},{"value":"R","label":"Ruc"},{"value":"P","label":"Pasaporte"}],"var_name":"frm_datosSolicitud_tipoDoc","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"91277203065373c577b5ef3074646792","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"Cedula/Pasaporte/Ruc","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Por favor, ingrese una identificación correcta","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"51182816865373c5777f317052540043","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Nombre Candidato","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-zA-ZñZÑÁÉÍÓÚáéíóúñ\\s]*$","validateMessage":"Error de caracteres","maxLength":"100","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":12}],[{"type":"text","variable":"frm_datosSolicitud_MontoAsegurado","var_uid":"96854789465373cae2fc7a2066610211","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_MontoAsegurado","name":"frm_datosSolicitud_MontoAsegurado","label":"Monto Asegurado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[1-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_MontoAsegurado","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_broker","var_uid":"98042437365373cd87daa83038809725","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_broker","name":"frm_datosSolicitud_broker","label":"Ejecutivo Comercial FV / Broker","tabIndex":"","defaultValue":"