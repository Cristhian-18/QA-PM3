ectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_cod_estado_siniestro","name":"grd_cod_estado_siniestro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_id_indice","name":"grd_id_indice","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_id_pv","name":"grd_id_pv","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_id_pv_cero","name":"grd_id_pv_cero","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_cob_madre","name":"grd_cob_madre","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"Coberturas encontradas","colSpan":12}],[{"type":"hidden","variable":"tri_bandera_grid","var_uid":"9088660396255b91c1c1c19089056523","dataType":"string","protectedValue":false,"id":"tri_bandera_grid","name":"tri_bandera_grid","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_grid","colSpan":2},{"type":"hidden","variable":"tri_bandera_web","var_uid":"643804585625f40ff611504034444191","dataType":"string","protectedValue":false,"id":"tri_bandera_web","name":"tri_bandera_web","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_web","colSpan":2},{"type":"hidden","variable":"TASK","var_uid":"130791376628f8e4501e527077463521","dataType":"string","protectedValue":false,"id":"TASK","name":"TASK","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"TASK","colSpan":2},{"colSpan":2},{"colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"9088660396255b91c1c1c19089056523","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_grid","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"9088660396255b91c1c1c19089056523","var_name_old":"tri_bandera_grid","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"643804585625f40ff611504034444191","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_web","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"643804585625f40ff611504034444191","var_name_old":"tri_bandera_web","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"130791376628f8e4501e527077463521","prj_uid":"820474191615f602d3c4b33049036948","var_name":"TASK","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"130791376628f8e4501e527077463521","var_name_old":"TASK","prj_uid_old":"820474191615f602d3c4b33049036948","create":false}]}]}]]></dyn_content>
