                $accion_label     = 'Documentos faltantes';
                //estado
                $estado = 'DOCUMENTO NO RECIBIDO';
            }

            $sql = "UPDATE SINIESTRO_REGISTRADO SET estado = '$estado' WHERE app_uid = '$app_uid'";
