        <dyn_content><![CDATA[{"name":"SubFrom Siniestro Negado","description":"SubFrom Siniestro Negado","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"13200964761e80f2d027178076994049","name":"SubFrom Siniestro Negado","description":"SubFrom Siniestro Negado","mode":"edit","script":{"type":"js","code":"function tipo_asegurado(newValue, oldValue) {\n\t\/\/ocultar\n  if(newValue == 'O'){\n    $(\"#frm_tipo_documento_fallecido\").show();\n    $(\"#frm_documento_fallecido\").show();\n    $(\"#frm_apellido_paterno_fallecido\").show();\n    $(\"#frm_apellido_materno_fallecido\").show();\n    $(\"#frm_nombres_fallecido\").show();\n    $(\"#frm_parentesco_fallecido\").show();\n    $(\"#frm_fecha_nacimiento_fallecido\").show();\n    $(\"#frm_genero_fallecido\").show();\n  }else{\n  \t$(\"#frm_tipo_documento_fallecido\").hide();\n    $(\"#frm_documento_fallecido\").hide();\n    $(\"#frm_apellido_paterno_fallecido\").hide();\n    $(\"#frm_apellido_materno_fallecido\").hide();\n    $(\"#frm_nombres_fallecido\").hide();\n    $(\"#frm_parentesco_fallecido\").hide();\n    $(\"#frm_fecha_nacimiento_fallecido\").hide();\n    $(\"#frm_genero_fallecido\").hide();\n  }\n}\n\ntipo_asegurado($(\"#frm_tipo_asegurado\").getValue());\n$(\"#frm_tipo_asegurado\").setOnchange(tipo_asegurado);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_siniestro","var_uid":"26712623761d65ef58f0a32045977548","dataType":"string","protectedValue":false,"id":"frm_tipo_siniestro","name":"frm_tipo_siniestro","label":"Tipo de siniestro","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, CONCAT(DESCRIPCION, ' - ', CODIGO) AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_SINIESTRO' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[],"var_name":"frm_tipo_siniestro","colSpan":6},{"type":"dropdown","variable":"frm_cobertura_madre","var_uid":"72604592961d65f08b1bea2038579441","dataType":"string","protectedValue":false,"id":"frm_cobertura_madre","name":"frm_cobertura_madre","label":"Cobertura Madre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, CONCAT(DESCRIPCION, ' - ', CODIGO) AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'COBERTURA_MADRE' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[],"var_name":"frm_cobertura_madre","colSpan":6}],[{"type":"dropdown","variable":"frm_tipo_asegurado","var_uid":"85671191861d66720dfa0e2099333232","dataType":"string","protectedValue":false,"id":"frm_tipo_asegurado","name":"frm_tipo_asegurado","label":"Tipo de Asegurado Siniestrado","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ----"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_tipo_asegurado","colSpan":6},{"type":"datetime","variable":"frm_fecha_ocurrencia_auditor","var_uid":"50591143761da1e7193ad51032159886","dataType":"datetime","protectedValue":false,"id":"frm_fecha_ocurrencia_auditor","name":"frm_fecha_ocurrencia_auditor","label":"Fecha ocurrencia","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"DD-MM-YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"@@frm_fecha_ocurrencia","disabledDates":false,"enabledDates":false,"icons":{"time"