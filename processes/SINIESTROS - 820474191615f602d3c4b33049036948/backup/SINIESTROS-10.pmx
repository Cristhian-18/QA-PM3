e","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"894084495633b2068c1e708023638647","name":"Subform Grid Coberturas Negados","description":"Subform Grid Coberturas Negados","mode":"edit","script":{"type":"js","code":"var formId = $(\"form\").prop(\"id\");\n  \n//Set an onchange event handler for the form. When the value of a field changes in the Dynaform, \n//check whether the changed field is the hasDiscount field in the grid. \n//If so, then if hasDiscount is set to \"Discount\", then enable the discountRate field in the same row. \n//If set to \"No Discount\", then disable the discountRate field.\n$( \"#\" + formId ).setOnchange( function(fieldId, newVal, oldVal) {\n  var aMatches_vsolicitado = fieldId.match(/^\\[grd_coberturas\\]\\[(\\d+)\\]\\[grd_txt_valor_aprobado\\]$/);\n  //grid de coberturas monto solicitado\n    if (aMatches_vsolicitado) {\n      var rowNo_gv = aMatches_vsolicitado[1];\n      //$(\"#frm_monto_liquidar\").setValue(0);\n\n      if (newVal != \"\") {\n              $(\"#frm_monto_liquidar\").setValue($(\"#grd_coberturas\").getSummary(12));\n          }\n      }\n  \n  var aMatches_vaproba = fieldId.match(/^\\[grd_coberturas\\]\\[(\\d+)\\]\\[grd_txt_valor\\]$/);\n  //grid de coberturas monto solicitado\n    if (aMatches_vaproba) {\n      var rowNo_gv = aMatches_vaproba[1];\n      //$(\"#frm_monto_liquidar\").setValue(0);\n\n      if (newVal != \"\") {\n              $(\"#frm_monto_reportado\").setValue($(\"#grd_coberturas\").getSummary(11));\n          }\n      }\n });"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_coberturas","var_uid":"141498791624df91de1d4b6041313445","dataType":"grid","protectedValue":false,"id":"grd_coberturas","name":"grd_coberturas","label":"Coberturas encontradas","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_desc_riesgo","name":"grd_txt_desc_riesgo","label":"Cobertura","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CONCAT(DESCRIPCION, ' - ', CODIGO) AS CODIGO, CONCAT(DESCRIPCION, ' - ', CODIGO) AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'COBERTURA_MADRE' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[],"columnWidth":"10","width":100,"title":"Cobertura"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_imp_suma_aseg","name":"grd_imp_suma_aseg","label":"Suma A.","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Suma A."},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_aplicar","name":"grd_txt_aplicar","label":"Aplicar","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"SI","label":"SI"}],"columnWidth":"6","width":100,"title":"Aplicar"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":fal