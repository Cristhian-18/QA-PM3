er","var_uid":"39725565861d79c9f7e7159031767321","dataType":"string","protectedValue":false,"id":"frm_broker","name":"frm_broker","label":"Broker","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_broker","colSpan":6}],[{"type":"dropdown","variable":"frm_ramo","var_uid":"94877612461d65f598303c8012420383","dataType":"string","protectedValue":false,"id":"frm_ramo","name":"frm_ramo","label":"Ramo","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO = 'RAMOS_SINIESTROS' AND PRO_UID = '820474191615f602d3c4b33049036948' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[],"var_name":"frm_ramo","colSpan":6},{"type":"dropdown","variable":"frm_sucursal","var_uid":"43944283661d65f522c0474077126746","dataType":"string","protectedValue":false,"id":"frm_sucursal","name":"frm_sucursal","label":"Sucursal","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE COD_CATALOGO = 'SUCURSALES_SINIESTROS' AND PRO_UID = '820474191615f602d3c4b33049036948' AND ESTADO = 1 ORDER BY DESCRIPCION","dataVariable":"","options":[],"var_name":"frm_sucursal","colSpan":6}],[{"type":"datetime","variable":"frm_fecha_ingreso_poliza","var_uid":"13459038261d6679a18ce97044487379","dataType":"string","protectedValue":false,"id":"frm_fecha_ingres