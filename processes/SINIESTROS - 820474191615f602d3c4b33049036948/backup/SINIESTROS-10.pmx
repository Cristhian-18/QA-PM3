\":\"false\"}]","inp_doc_uid":""},{"var_uid":"59585419761d6626265fa45070263224","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_contratante","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"39725565861d79c9f7e7159031767321","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_broker","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"12729035461d660d1932449022171953","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_apellido_paterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"43228233361d660e92ddf19097057771","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_apellido_materno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"14212540961d66101ac69f6016092217","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_nombres","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
