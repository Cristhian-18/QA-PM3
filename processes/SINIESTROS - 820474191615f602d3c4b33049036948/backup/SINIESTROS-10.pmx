eMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cobertura_seleccionada","colSpan":12}]],"variables":[{"var_uid":"42356496861d65f42891040011640991","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_numero_poliza","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"92332058361da1ba3119920063132734","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_linea_negocio","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"59585419761d6626265fa45070263224","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_contratante","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"872120832620a860b762710023365292","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_contratante_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"39725565861d79c9f7e7159031767321","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_broker","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":