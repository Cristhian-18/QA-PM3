        <dyn_content><![CDATA[{"name":"Subform Documentos Respaldos","description":"Subform Documentos Respaldos","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"40350410561d9cbe0f0c3b3037075503","name":"Subform Documentos Respaldos","description":"Subform Documentos Respaldos","mode":"edit","script":{"type":"js","code":"\/\/estilo del checkbox\n$(\"#chk_documentos\").children(\"div\").eq(0).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(0).addClass(\"col-sm-8.col-md-8.col-lg-8\")\n$(\"#chk_documentos\").children(\"div\").eq(0).find(\"label\").css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(1).addClass(\"col-sm-4 col-md-4 col-lg-4 pmdynaform-field-control\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"padding-left\", \"0\")\n$(\"#chk_documentos\").find(\"span.textlabel\").css(\"font-size\", \"16px\");\n$(\"#frm_cober_select\").hide();\n\nfunction get_documentos(newValue, oldValue){\n  $(\"#frm_cober_select\").setValue('');\n  var datagrid = '';\n     \tvar rows = $(\"#grd_coberturas\").getNumberRows();\n       for (var i=1; i <= rows; i++) {\n         \tif($(\"#grd_coberturas\").getValue(i, 3) == 'SI')\n           \t\tdatagrid = $(\"#grd_coberturas\").getValue(i, 13)+'|'+datagrid;\n        }\n       var datagrid1 = datagrid.substring(0, datagrid.length - 1);\n        $(\"#frm_cober_select\").setValue(datagrid1);\n  \n  $(\"#chk_documentos_web\").disableValidation();\n  $(\"#frm_documentos\").disableValidation();\n  \n  \n\t if(newValue == 'SI'){\n       $(\"#chk_documentos_web\").enableValidation();\n       $(\"#frm_documentos\").enableValidation();\n     }\n}\n\n$(\"#frm_check_documentos\").setOnchange(get_documentos);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"label","id":"lbl_tamnio","label":"El tama\u00f1o de los archivos no debe superar los 50MB","colSpan":12}],[{"type":"text","variable":"frm_cober_select","var_uid":"81527549962ba18d8935028016318799","dataType":"string","protectedValue":false,"id":"frm_cober_select","name":"frm_cober_select","label":"Coberturas","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cober_select","colSpan":12}],[{"type":"dropdown","variable":"frm_check_documentos","var_uid":"99493999562ba182e902de9099868636","dataType":"string","protectedValue":false,"id":"frm_check_documentos","name":"frm_check_documentos","label":"Cuenta con todos los documentos?","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"---- Seleccione"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_check_documentos","colSpan":12}],[{"type":"checkgroup","variable":"chk_documentos_web","var_uid":"95906702362ba17c8c91392008211751","dataType":"array","protectedValue":false,"id":"chk_documentos_web","name":"chk_documentos_web","label":"Listado de documentos obligatorios","defaultValue":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE PRO_UID = '820474191615f602d3c4b33049036948' AND COD_CATALOGO = 'DOCUMENTOS' AND VALOR = 'O'\nAND CAMPO2 REGEXP '@#frm_cober_select'","dataVariable":"","options":[],"var_name":"chk_documentos_web","colSpan":6},{"type":"checkgroup","variable":"chk_documentos_web_a","var_uid":"75157303062bb70b562cc31099707251","dataType":"array","protectedValue":false,"id":"chk_documentos_web_a","name":"chk_documentos_web_a","label":"Listado de documentos Adicionales","defaultValue":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE PRO_UID = '820474191615f602d3c4b33049036948' AND COD_CATALOGO = 'DOCUMENTOS' AND VALOR = 'A'\nAND CAMPO2 REGEXP '@#frm_cober_select'","dataVariable":"","options":[],"var_name":"chk_documentos_web_a","colSpan":6}],[{"type":"file","variable":"frm_documentos_natural_cedula","var_uid":"64716157761d9cbe6dac174057281462","dataType":"file","protectedValue":false,"id":"frm_documentos_natural_cedula","name":"frm_documentos_natural_cedula","label":"Cedula, pasaporte o RUC del contratante","hint":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf, *.jpg, *.png","size":"2","sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"5028443425ee7d8a823c0b4062936539","var_name":"frm_documentos_natural_cedula","colSpan":12}],[{"type":"file","variable":"frm_documentos_fvida","var_uid":"60544534161d9cc8711b8c3035765491","dataType":"file","protectedValue":false,"id":"frm_documentos_fvida","name":"frm_documentos_fvida","label":"Formulario de vida","hint":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":50,"sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos_fvida","colSpan":12}],[{"type":"file","variable":"frm_documentos_fdesempleo","var_uid":"68187422361d9cca7af66a6071892598","dataType":"file","protectedValue":false,"id":"frm_documentos_fdesempleo","name":"frm_documentos_fdesempleo","label":"Formulario de desempleo","hint":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":"50","sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos_fdesempleo","colSpan":12}],[{"type":"file","variable":"frm_documentos_fgastos","var_uid":"10876689361d9ccc5d47de5055644464","dataType":"file","protectedValue":false,"id":"frm_documentos_fgastos","name":"frm_documentos_fgastos","label":"Formulario de Gastos Medicos","hint":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":"50","sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos_fgastos","colSpan":12}],[{"type":"file","variable":"frm_documentos_hc","var_uid":"97694889561f3e8dc4fb630006196689","dataType":"file","protectedValue":false,"id":"frm_documentos_hc","name":"frm_documentos_hc","label":"Historia Clinica","hint":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":"50","sizeUnity":"MB","mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos_hc","colSpan":12}],[{"type":"multipleFile","variable":"frm_documentos","var_uid":"24980288461d6664db74151087263353","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos","name":"frm_documentos","label":"Otros documentos","inputDocument":"Documentos del flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":50,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos","colSpan":12}],[{"type":"checkbox","variable":"chk_documentos","var_uid":"32694813461d6667c1745a6075713836","dataType":"boolean","protectedValue":false,"id":"chk_documentos","name":"chk_documentos","label":"Desea Adjuntar mas documentos?","defaultValue":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"chk_documentos","colSpan":12}]],"variables":[{"var_uid":"81527549962ba18d8935028016318799","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_cober_select","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"99493999562ba182e902de9099868636","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_check_documentos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95906702362ba17c8c91392008211751","prj_uid":"820474191615f602d3c4b33049036948","var_name":"chk_documentos_web","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"75157303062bb70b562cc31099707251","prj_uid":"820474191615f602d3c4b33049036948","var_name":"chk_documentos_web_a","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"64716157761d9cbe6dac174057281462","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_documentos_natural_cedula","var_field_type":"file","var_field_size":10,"var_label":"file","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"5028443425ee7d8a823c0b4062936539","var_uid_old":"3262110935f3cacf548cad5034421623","var_name_old":"frm_d