        $plantilla_rec = 'Siniestro_creado_docs.html';
        @@siniestro_mail = PMFSendMessage(@@APPLICATION,$de,$para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_destino_email' => @@tri_destino_email));
    }

    if(@@frm_accion=='CONTINUAR'){
