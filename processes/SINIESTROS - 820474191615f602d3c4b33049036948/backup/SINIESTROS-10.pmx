:"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"sbt_atencion","label":"Atencion al caso","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_accion","var_uid":"60536779361d9ce765a3cd3080469604","dataType":"string","protectedValue":false,"id":"frm_accion","name":"frm_accion","label":"Accion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"GUARDAR","label":"Guardar el caso"}],"var_name":"frm_accion","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"85419249361d665d0b3f134007509760","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"INFORMACION ADICIONAL DEL SINIESTRO","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_comentario","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"ENVIAR","tabIndex":"","ariaLabel":"","colSpan":12}]],"variables":[{"var_uid":"41414035361d838babe1029099803881","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_user_sac_uname","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"41414035361d838babe1029099803881","var_name_old":"tri_user_sac_uname","prj_uid_old":"8204741