l","colSpan":1},{"type":"hidden","variable":"frm_nombre_portal","var_uid":"4714949186a199df9814fb4035953036","dataType":"string","protectedValue":false,"id":"frm_nombre_portal","name":"frm_nombre_portal","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_nombre_portal","colSpan":1},{"type":"hidden","variable":"frm_usuario_portal","var_uid":"4032146546a199e006bee09041135491","dataType":"string","protectedValue":false,"id":"frm_usuario_portal","name":"frm_usuario_portal","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_usuario_portal","colSpan":1},{"type":"hidden","variable":"consultaExterior","var_uid":"6797524216a208b72249f46092126088","dataType":"integer","protectedValue":false,"id":"consultaExterior","name":"consultaExterior","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"consultaExterior","colSpan":1},{"type":"hidden","variable":"token_portal","var_uid":"5912692026a20cfbb83cc61019685039","dataType":"string","protectedValue":false,"id":"token_portal","name":"token_portal","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"token_portal","colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1},{"colSpan":1}],[{"type":"subtitle","id":"frm_sbt_datos_asegurado","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_datos_asegurado\" subform=\"86099412961e95eec7faf13028917121\n\"> <i class=\"glyphicon glyphicon-minus\"></i> \nBusqueda del asegurado</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"86099412961e95eec7faf13028917121","name":"Subform Datos Cliente Web","description":"Subform Datos Cliente Web","mode":"edit","script":{"type":"js","code":"function registro_siniestro(newValue, oldValue){\n  if(newValue != '001'){\n  \t$(\"#frm_registro_siniestro\").setValue('C');\n    $(\"#frm_numero_poliza_b\").hide();\n    $(\"#frm_numero_poliza_b\").disableValidation();\n  }else{\n  \t$(\"#frm_registro_siniestro\").setValue('P');\n    $(\"#frm_numero_poliza_b\").show();\n    $(\"#frm_numero_poliza_b\").enableValidation();\n  }\n\n}\n\n$(\"#btn_consultar_pol\").hide();\n$(\"#frm_numero_poliza_b\").hide();\n$(\"#frm_tipo_contratante\").hide();\n$(\"#frm_registro_siniestro\").hide();\n$(\"#frm_numero_poliza_pvcero\").hide();\n$(\"#frm_tipo_siniestro\").hide();\n$(\"#frm_cobertura_madre\").hide();\n$(\"#frm_mes_vencido_web\").hide();\n\n$(\"#frm_tipo_contratante\").setOnchange(registro_siniestro);\n\nfunction cargar_pol(newValue, oldValue){\n  if(newValue != ''){    \n    const myArray = newValue.split(\"|\");\n    $(\"#frm_numero_poliza_pvcero\").setValue(myArray[0]);\n  \t$(\"#frm_numero_poliza_b\").setValue(myArray[1]);\n  }else{\n  \t$(\"#frm_numero_poliza_pvcero\").setValue('');\n    $(\"#frm_numero_poliza_b\").setValue('');\n  }\n\n}\n\n$(\"#frm_pols_contratante\").setOnchange(cargar_pol);\nif($(\"#TASK\").getValue() == '799986505615f607b50a4f4033464318'){\n  $(\"#frm_fecha_notificacion_real\").show();\n  $(\"#frm_fecha_notificacion_real\").enableValidation();\n}else{\n  $(\"#frm_fecha_notificacion_real\").disableValidation();\n  $(\"#frm_fecha_notificacion_real\").hide();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_tipo_doc_contratante","var_uid":"87086006362bde67806b969021299243","dataType":"string","protectedValue":false,"id":"frm_tipo_doc_contratante","name":"frm_tipo_doc_contratante","label":"Tipo de contratante","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"---- Seleccione ----"},{"value":"1",