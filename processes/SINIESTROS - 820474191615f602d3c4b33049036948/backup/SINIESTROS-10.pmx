 es negativa","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"subtitle-negativa","label":"NEGATIVA","colSpan":12}],[{"type":"label","id":"lbl_antecdentes","label":"Una vez revisados los documentos presentados se determiniconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f3'))) lo siguiente:","colSpan":12}],[{"type":"textarea","variable":"frm_negativa_antecedentes","var_uid":"378677323624e0bfec95973013475156","dataType":"string","protectedValue":false,"id":"frm_negativa_antecedentes","name":"frm_negativa_antecedentes","label":"ANTECEDENTES","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"8","var_name":"frm_negativa_antecedentes","colSpan":12}],[{"type":"label","id":"lbl_ley","label":"Las Condiciones Particulares de la Piconv('UCS-4LE','UTF-8',pack('V', hexdec('U00f3')))liza No. <b>XXXXXXX<\/b> en el numeral de <b>RAZON DE LA NEGATIVA<\/b>, determina lo siguiente:","colSpan":12}],[{"type":"textarea","variable":"frm_negativa_ley","var_uid":"878656407624e0d29ce7de8026446091","dataType":"string","protectedValue":false,"id":"frm_negativa_ley","name":"frm_negativa_ley","label":"LEY","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"8","var_name":"frm_negativa_ley","colSpan":12}],[{"type":"textarea","variable":"frm_negativa_ley_1","var_uid":"24438137464590c7ba092f7058197746","dataType":"string","protectedValue":false,"id":"frm_negativa_ley_1","name":"frm_negativa_ley_1","label":"LEY","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_negativa_ley_1","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"85419249361d665d0b3f134007509760","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Observaciones","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"8","var_name":"frm_comentario","colSpan":12}],[{"type":"label","id":"lbl_resolucion","label":"Sin otro particular por el momento, suscribo.<br>Atentamente","colSpan":12}],[{"type":"textarea","variable":"frm_negativa_nota","var_uid":"446049171624e0dced78681038429442","dataType":"string","protectedValue":false,"id":"frm_negativa_nota","name":"frm_negativa_nota","label":"NOTA","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"8","var_name":"frm_negativa_nota","colSpan":12}]],"variables":[{"var_uid":"378677323624e0bfec95973013475156","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_negativa_antecedentes","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"378677323624e0bfec95973013475156","var_name_old":"frm_negativa_antecedentes","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"878656407624e0d29ce7de8026446091","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_negativa_ley","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accept