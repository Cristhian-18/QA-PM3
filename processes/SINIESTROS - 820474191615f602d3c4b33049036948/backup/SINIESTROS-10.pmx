                    $nro_aseg = $datagrid_cober['grd_nro_aseg'];
                    $nro_pariente = $datagrid_cober['grd_nro_pariente'];

                    if(@@frm_accion == 'APROBAR' || @@frm_accion == 'MANTENER'){
                        $cod_estado_siniestro= 2;
                        @@tri_estado_siniestro = $cod_estado_siniestro;
                        $cod_estado_evento = 7;
