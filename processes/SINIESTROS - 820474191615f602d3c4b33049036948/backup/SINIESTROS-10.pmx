        <dyn_content><![CDATA[{"name":"SubForm Info Liquidacion Siniestro","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"680302370680be5afc13bf4037693296","name":"SubForm Info Liquidacion Siniestro","description":"","mode":"edit","script":{"type":"js","code":"var respuestaJson = $(\"#respuestaApiLiquidacion\").getValue();\nif (respuestaJson === null || respuestaJson === undefined || respuestaJson.trim() === \"\") {\n  $('#pnlInfoLiquidacionSiniestro').html(\"<p style='color: red;'> No existen datos para mostrar.<\/p>\");\n}else{\n  try {\n      var respuestaApi = JSON.parse(respuestaJson);\n\n      var html = \"<table border='1' style='width:100%; font-size:12px; border-collapse: collapse;'>\";\n      html += `\n        <thead>\n          <tr>\n            <th style=\"width: 20%; border: 1px solid #ccc; padding: 6px;\">Codigo Abonado<\/th>\n            <th style=\"width: 50%; border: 1px solid #ccc; padding: 6px;\">Estado<\/th>\n            <th style=\"width: 30%; border: 1px solid #ccc; padding: 6px;\">Valor<\/th>\n          <\/tr>\n        <\/thead>\n        <tbody>\n      `;\n\n      respuestaApi.forEach(function (item) {\n          var estado = \"-\";\n          var valor = \"\";\n          var estiloFila = \"\"; \n\n          try {\n              var respuesta = JSON.parse(item.respuesta);\n\n              var code = respuesta.code !== undefined ? respuesta.code : respuesta.Code;\n              var message = respuesta.message !== undefined ? respuesta.message : respuesta.Message;\n              var data = respuesta.data !== undefined ? respuesta.data : respuesta.Data;\n\n              estado = message || \"Sin mensaje\";\n\n              if (code !== 0) {\n                  estiloFila = \"background-color: #f8d7da; color: #721c24;\"; \/\/ rojo claro\n                  $(\"#errorLiquidacion\").setValue(\"1\");\n              }\n\n              if (code === 0 && Array.isArray(data) && data.length > 0) {\n                  var datos = data[0];\n                  valor = `\n                    <ul style=\"padding-left: 18px; margin: 0;\">\n                      <li><strong>No. AT:<\/strong> ${datos.nro_aut_tec || \"-\"}<\/li>\n                      <li><strong>No. Recibo:<\/strong> ${datos.nro_recibo || \"-\"}<\/li>\n                      <li><strong>No. OP:<\/strong> ${datos.nro_op || \"-\"}<\/li>\n                    <\/ul>\n                  `;\n              }\n\n          } catch (err) {\n              estado = \"Respuesta no valida\";\n              estiloFila = \"background-color: #f8d7da; color: #721c24;\";\n          }\n\n          html += `\n            <tr style=\"${estiloFila}\">\n              <td style=\"border: 1px solid #ccc; padding: 6px;\">${item.cod_abona_vrs}<\/td>\n              <td style=\"border: 1px solid #ccc; padding: 6px;\">${estado}<\/td>\n              <td style=\"border: 1px solid #ccc; padding: 6px;\">${valor}<\/td>\n            <\/tr>\n          `;\n      });\n\n      html += \"<\/tbody><\/table>\";\n\n      $('#pnlInfoLiquidacionSiniestro').html(html);\n\n  } catch (e) {\n      console.error(\"Error al parsear JSON:\", e);\n      $('#pnlInfoLiquidacionSiniestro').html(\"<p style='color: red;'> Error al mostrar los resultados.<\/p>\");\n  }\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frmCmbTipoLiquidacion","var_uid":"86670624867e70d09155115076879303","dataType":"string","protectedValue":false,"id":"frmCmbTipoLiquidacion","name":"frmCmbTipoLiquidacion","label":"Tipo Liquidacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"view","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"TOTAL","label":"TOTAL"},{"value":"PARCIAL","label":"PARCIAL"}],"var_name":"frmCmbTipoLiquidacion","colSpan":12}],[{"type":"label","id":"lblMensajePago","label":"","colSpan":12}],[{"type":"grid","variable":"grdDetallePago","var_uid":"18284238667a673f9254489081914862","dataType":"grid","protectedValue":false,"id":"grdDetallePago","name":"grdDetallePago","label":"Pagos","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtCobertura","name":"grdtxtCobertura","label":"Cobertura","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"170","width":100,"title":"Cobertura","var_name":"grdDetallePago"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtPagarAPago","name":"grdtxtPagarAPago","label":"Pagar a","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"125","width":100,"title":"Pagar a"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtCodigoContratante","name":"grdtxtCodigoContratante","label":"Codigo<br>Contratante","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"120","width":100,"title":"Codigo<br>Contratante"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtPagoTransferencia","name":"grdtxtPagoTransferencia","label":"Pago<br>Transferencia","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"130","width":100,"title":"Pago<br>Transferencia"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtValorPagar","name":"grdtxtValorPagar","label":"Valor<br>a Pagar","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[0-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"sum","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"120","width":100,"title":"Valor<br>a Pagar"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtNombreCobertura","name":"grdtxtNombreCobertura","label":"Nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"180","width":100,"title":"Nombre"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtConceptoCobertura","name":"grdtxtConceptoCobertura","label":"Concepto","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"100","width":100,"title":"Concepto"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtClasePago","name":"grdtxtClasePago","label":"Clase de<br>Pago","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"150","width":100,"title":"Clase de<br>Pago"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtGenerarOp","name":"grdtxtGenerarOp","label":"Generar OP","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"125","width":100,"title":"Generar OP"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtTipoPago","name":"grdtxtTipoPago","label":"Tipo de<br>Pago","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"125","width":100,"title":"Tipo de<br>Pago"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtAplicaDeducible","name":"grdtxtAplicaDeducible","label":"Aplica<br>Deducible","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"125","width":100,"title":"Aplica<br>Deducible"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtValorDeducible","name":"grdtxtValorDeducible","label":"Valor<br>Deducible","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"120","width":100,"title":"Valor<br>Deducible"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtObservaciones","name":"grdtxtObservaciones","label":"Observaciones","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"250","width":100,"title":"Observaciones"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtIndexCobertura","name":"txtIndexCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtNombreCobertura","name":"txtNombreCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtProcesado","name":"txtProcesado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdChkPagoIndividual","name":"grdChkPagoIndividual","label":"Pago Individual","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"130","width":100,"title":"Pago Individual"}],"data":[],"mode":"parent","layout":"static","pageSize":"0","addRow":false,"deleteRow":false,"title":"Pagos","colSpan":12}],[{"type":"panel","id":"pnlInfoLiquidacionSiniestro","content":"","border":"1px","colSpan":12}],[{"type":"hidden","variable":"respuestaApiLiquidacion","var_uid":"325969048680ab0019ffef4043164838","dataType":"string","protectedValue":false,"id":"respuestaApiLiquidacion","name":"respuestaApiLiquidacion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"respuestaApiLiquidacion","colSpan":6},{"type":"hidden","variable":"errorLiquidacion","var_uid":"56760794667f6a7af0bafd0033679699","dataType":"string","protectedValue":false,"id":"errorLiquidacion","name":"errorLiquidacion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"errorLiquidacion","colSpan":6}]],"variables":[{"var_uid":"86670624867e70d09155115076879303","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frmCmbTipoLiquidacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"86670624867e70d09155115076879303","var_name_old":"frmCmbTipoLiquidacion","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"18284238667a673f9254489081914862","prj_uid":"820474191615f602d3c4b33049036948","var_name":"grdDetallePago","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"18284238667a673f9254489081914862","var_name_old":"grdDetallePago","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"325969048680ab0019ffef4043164838","prj_uid":"820474191615f602d3c4b33049036948","var_name":"respuestaApiLiquidacion","var_field_type":"string","var_fie