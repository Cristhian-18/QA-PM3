        <dyn_filename><![CDATA[820474191615f602d3c4b33049036948/55241990862ba1704c23881005873211]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Subform Documentos Web","description":"Subform Documentos Web","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"55241990862ba1704c23881005873211","name":"Subform Documentos Web","description":"Subform Documentos Web","mode":"edit","script":{"type":"js","code":"//estilo del checkbox\n$(\"#chk_documentos\").children(\"div\").eq(0).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(0).addClass(\"col-sm-8.col-md-8.col-lg-8\")\n$(\"#chk_documentos\").children(\"div\").eq(0).find(\"label\").css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(1).addClass(\"col-sm-4 col-md-4 col-lg-4 pmdynaform-field-control\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"padding-left\", \"0\")\n$(\"#chk_documentos\").find(\"span.textlabel\").css(\"font-size\", \"16px\");\n$(\"#frm_cober_select\").hide();\n\nfunction get_documentos(newValue, oldValue){\n  $(\"#frm_cober_select\").setValue('');\n  var datagrid = '';\n  var rows = $(\"#grd_coberturas\").getNumberRows();\n  for (var i=1; i <= rows; i++) {\n  \tif($(\"#grd_coberturas\").getValue(i, 3) == 'SI')\n    \tdatagrid = $(\"#grd_coberturas\").getValue(i, 13)+'|'+datagrid;\n  }\n  var datagrid1 = datagrid.substring(0, datagrid.length - 1);\n  $(\"#frm_cober_select\").setValue(datagrid1);\n  \n  $(\"#chk_documentos_web\").disableValidation();\n  $(\"#frm_documentos\").disableValidation();\n  \n  if($(\"#cmbOrigen\").getValue() == 'INSURANCE' || $(\"#cmbOrigenAux\").getValue() == 'INSURANCE'){\n    $(\"#chk_documentos_web\").disableValidation();\n     $(\"#frm_documentos\").disableValidation();\n  }else{\n\t if(newValue == 'SI' && ($(\"#cmbOrigen\").getValue() != 'INSURANCE' || $(\"#cmbOrigenAux\").getValue() != 'INSURANCE')){\n       $(\"#chk_documentos_web\").enableValidation();\n       $(\"#frm_documentos\").enableValidation();\n     }\n  }\n}\n\n$(\"#frm_check_documentos\").setOnchange(get_documentos);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_cober_select","var_uid":"81527549962ba18d8935028016318799","dataType":"string","protectedValue":false,"id":"frm_cober_select","name":"frm_cober_select","label":"Coberturas","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cober_select","colSpan":12}],[{"type":"label","id":"lbl_tamnio","label":"El tamanio de los archivos no debe superar los 50MB","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_check_documentos","var_uid":"99493999562ba182e902de9099868636","dataType":"string","protectedValue":false,"id":"frm_check_documentos","name":"frm_check_documentos","label":"Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_check_documentos","colSpan":12}],[{"type":"label","id":"lbl_docs","label":"Recuerde seleccionar (dar check) a los documentos que va a enviar.","ariaLabel":"","colSpan":12}],[{"type":"checkgroup","variable":"chk_documentos_web","var_uid":"95906702362ba17c8c91392008211751","dataType":"array","protectedValue":false,"id":"chk_documentos_web","name":"chk_documentos_web","label":"Listado de documentos obligatorios","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE PRO_UID = '820474191615f602d3c4b33049036948' AND COD_CATALOGO = 'DOCUMENTOS' AND ESTADO = '1' AND VALOR = 'O'\nAND CAMPO2 REGEXP '@#frm_cober_select'","memoryCache":false,"dataVariable":"","options":[],"var_name":"chk_documentos_web","colSpan":6},{"type":"checkgroup","variable":"chk_documentos_web_a","var_uid":"75157303062bb70b562cc31099707251","dataType":"array","protectedValue":false,"id":"chk_documentos_web_a","name":"chk_documentos_web_a","label":"Listado de documentos Adicionales","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS \nWHERE PRO_UID = '820474191615f602d3c4b33049036948' AND COD_CATALOGO = 'DOCUMENTOS' AND ESTADO = '1' AND VALOR = 'A'\nAND CAMPO2 REGEXP '@#frm_cober_select'","memoryCache":false,"dataVariable":"","options":[],"var_name":"chk_documentos_web_a","colSpan":6}],[{"type":"multipleFile","variable":"frm_documentos","var_uid":"24980288461d6664db74151087263353","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos","name":"frm_documentos","label":"Documentos","tabIndex":"","ariaLabel":"","inputDocument":"Documentos del flujo","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":50,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos","colSpan":12}],[{"type":"hidden","variable":"cmbOrigenAux","var_uid":"78874183269a850ee8d3613010175530","dataType":"string","protectedValue":false,"id":"cmbOrigenAux","name":"cmbOrigen","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"cmbOrigenAux","colSpan":12}]],"variables":[{"var_uid":"81527549962ba18d8935028016318799","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_cober_select","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"99493999562ba182e902de9099868636","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_check_documentos","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95906702362ba17c8c91392008211751","prj_uid":"820474191615f602d3c4b33049036948","var_name":"chk_documentos_web","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"75157303062bb70b562cc31099707251","prj_uid":"820474191615f602d3c4b33049036948","var_name":"chk_documentos_web_a","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"24980288461d6664db74151087263353","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_documentos","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"