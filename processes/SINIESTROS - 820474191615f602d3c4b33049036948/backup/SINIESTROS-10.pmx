<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <title>Liquidación de Reclamos Vida Universal</title>
</head>
<body style="font-family: Arial, sans-serif; font-size: 13px; color: #000000; margin: 0px; padding: 0px;">
<table style="width: 100%; border-collapse: collapse;" cellspacing="0" cellpadding="5" border="0">
<tbody><!-- TÍTULO -->
<tr>
<td colspan="4" style="text-align: center; font-size: 16px; font-weight: bold; padding: 10px 5px; border: none;">LIQUIDACI&Oacute;N DE RECLAMOS VIDA UNIVERSAL</td>
</tr>
<!-- Contratante -->
<tr>
<td colspan="4" style="padding: 5px;"><b>Contratante:</b> @#nomContrante</td>
</tr>
<!-- Póliza / Sucursal -->
<tr>
<td style="padding: 5px; width: 30%; white-space: nowrap;"><b>N&uacute;mero de P&oacute;liza:</b></td>
<td style="padding: 5px; width: 20%;">@#numPoliza</td>
<td style="padding: 5px; width: 20%; white-space: nowrap;"><b>Sucursal:</b></td>
<td style="padding: 5px; width: 30%;">@#sucursal</td>
</tr>
<!-- Nro Reclamo / Aut Tec -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Nro. Reclamo:</b></td>
<td style="padding: 5px;">@#numReclamo</td>
<td style="padding: 5px; white-space: nowrap;"><b>Nro. Aut. Tec.:</b></td>
<td style="padding: 5px;">@#numAT</td>
</tr>
<!-- Nro OP -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Nro. OP:</b></td>
<td colspan="3" style="padding: 5px;">@#numOP</td>
</tr>
<!-- Vigencia -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Vigencia Desde:</b></td>
<td style="padding: 5px;">@#vigDesde</td>
<td style="padding: 5px; white-space: nowrap;"><b>Hasta:</b></td>
<td style="padding: 5px;">@#vigHasta</td>
</tr>
<!-- Asegurado -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Nombre Asegurado:</b></td>
<td style="padding: 5px;">@#nomAsegurado</td>
<td style="padding: 5px; white-space: nowrap;"><b>NRO. DOC:</b></td>
<td style="padding: 5px;">@#numDocAsegurado</td>
</tr>
<!-- Beneficiario -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Beneficiario:</b></td>
<td style="padding: 5px;">@#nomBeneficiario</td>
<td style="padding: 5px; white-space: nowrap;"><b>NRO. DOC:</b></td>
<td style="padding: 5px;">@#numDocBeneficiario</td>
</tr>
<!-- Espacio -->
<tr>
<td colspan="4" style="border: none; height: 6px;"></td>
</tr>
<!-- Ramo -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Ramo:</b></td>
<td colspan="3" style="padding: 5px;">@#rptRamo</td>
</tr>
<!-- Cobertura -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Cobertura:</b></td>
<td colspan="3" style="padding: 5px;">@#rptCobertura</td>
</tr>
<!-- Diagnóstico -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Diagn&oacute;stico:</b></td>
<td colspan="3" style="padding: 5px;">@#rptDiagnostico</td>
</tr>
<!-- Fecha Incurrencia -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Fecha de Incurrencia:</b></td>
<td colspan="3" style="padding: 5px;">@#fecIncurrencia</td>
</tr>
<!-- Fecha Notificación -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Fecha de Notificaci&oacute;n:</b></td>
<td colspan="3" style="padding: 5px;">@#fecNotificacion</td>
</tr>
<!-- Fecha Presentación -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Fecha de Presentaci&oacute;n:</b></td>
<td colspan="3" style="padding: 5px;">@#fecPresentacion</td>
</tr>
<!-- Corredor -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Corredor:</b></td>
<td colspan="3" style="padding: 5px;">@#corredor</td>
</tr>
<!-- Forma de pago -->
<tr>
<td rowspan="2" style="padding: 5px; width: 200px;"><b>FORMA DE PAGO</b></td>
<td style="padding: 5px; width: 200px;">CHEQUE</td>
<td style="padding: 5px;">@#esCheque</td>
</tr>
<tr>
<td style="padding: 5px; width: 200px;">TRANSFERENCIA</td>
<td style="padding: 5px;">@#esTransferencia</td>
</tr>
<!-- DATOS DEL PAGO -->
<tr>
<td colspan="4" style="padding: 5px; font-weight: bold; background-color: #f0f0f0;">DATOS DEL PAGO</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Beneficiario:</b></td>
<td colspan="3" style="padding: 5px;">@#nomBeneficiario</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Nro DOC:</b></td>
<td colspan="3" style="padding: 5px;">@#numDocBeneficiario</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>BANCO:</b></td>
<td colspan="3" style="padding: 5px;">@#rptBanco</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>TIPO DE CUENTA:</b></td>
<td colspan="3" style="padding: 5px;">@#rptTipoCuenta</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>Nro CUENTA:</b></td>
<td colspan="3" style="padding: 5px;">@#rptNumCuenta</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>MAIL:</b></td>
<td colspan="3" style="padding: 5px;">@#rptMail</td>
</tr>
<!-- Espacio -->
<tr>
<td colspan="4" style="border: none; height: 6px;"></td>
</tr>
<!-- DETALLE DE LIQUIDACION -->
<tr>
<td colspan="4" style="padding: 5px; font-weight: bold;">DETALLE DE LIQUIDACION</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>VALOR A PAGAR:</b></td>
<td colspan="3" style="padding: 5px;">US$ 430.00</td>
</tr>
<!-- Texto recibo -->
<tr>
<td colspan="3" style="padding: 5px; text-align: justify;">Recibi de EQUISUIZA SEGUROS S.A. la cantidad arriba indicada. Con esta indemnizaci&oacute;n total y definitiva, queda liberada de toda responsabilidad la aseguradora.</td>
</tr>
<!-- OBSERVACIONES -->
<tr>
<td colspan="4" style="padding: 5px; font-weight: bold;">OBSERVACIONES</td>
</tr>
<tr>
<td colspan="4" style="padding: 5px;">COB 1 PARCIAL</td>
</tr>
<!-- Firma y datos finales -->
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>FIRMA DEL BENEFICIARIO(*):</b></td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>NRO. DOCUMENTO DE IDENTIDAD:</b></td>
<td colspan="3" style="padding: 5px;">1705005740</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>FECHA LIQUIDACION:</b></td>
<td colspan="3" style="padding: 5px;">29/04/2025</td>
</tr>
<tr>
<td style="padding: 5px; white-space: nowrap;"><b>USUARIO:</b></td>
<td colspan="3" style="padding: 5px;">cacalle</td>
</tr>
<tr>
<td colspan="4" style="padding: 5px; font-size: 11px;">(*) Firma en caso de que el pago se realice con cheque</td>
</tr>
</tbody>
</table>
</body>
</html>]]></out_doc_template>
