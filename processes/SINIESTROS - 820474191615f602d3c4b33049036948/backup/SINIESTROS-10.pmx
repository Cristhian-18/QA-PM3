abel":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"frm_sbt_docs","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_docs\" subform=\"55241990862ba1704c23881005873211\n\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDocumentos de respaldo</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"55241990862ba1704c23881005873211","name":"Subform Documentos Web","description":"Subform Documentos Web","mode":"edit","script":{"type":"js","code":"//estilo del checkbox\n$(\"#chk_documentos\").children(\"div\").eq(0).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(0).addClass(\"col-sm-8.col-md-8.col-lg-8\")\n$(\"#chk_documentos\").children(\"div\").eq(0).find(\"label\").css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).removeClass()\n$(\"#chk_documentos\").children(\"div\").eq(1).addClass(\"col-sm-4 col-md-4 col-lg-4 pmdynaform-field-control\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"float\", \"left\")\n$(\"#chk_documentos\").children(\"div\").eq(1).css(\"padding-left\", \"0\")\n$(\"#chk_documentos\").find(\"span.textlabel\").css(\"font-size\", \"16px\");\n$(\"#frm_cober_select\").hide();\n\nfunction get_documentos(newValue, oldValue){\n  $(\"#frm_cober_select\").setValue('');\n  var datagrid = '';\n  var rows = $(\"#grd_coberturas\").getNumberRows();\n  for (var i=1; i <= rows; i++) {\n  \tif($(\"#grd_coberturas\").getValue(i, 3) == 'SI')\n    \tdatagrid = $(\"#grd_coberturas\").getValue(i, 13)+'|'+datagrid;\n  }\n  var datagrid1 = datagrid.substring(0, datagrid.length - 1);\n  $(\"#frm_cober_select\").setValue(datagrid1);\n  \n  $(\"#chk_documentos_web\").disableValidation();\n  $(\"#frm_documentos\").disableValidation();\n  \n  if($(\"#cmbOrigen\").getValue() == 'INSURANCE' || $(\"#cmbOrigenAux\").getValue() == 'INSURANCE'){\n    $(\"#chk_documentos_web\").disableValidation();\n     $(\"#frm_documentos\").disableValidation();\n  }else{\n\t if(newValue == 'SI' && ($(\"#cmbOrigen\").getValue() != 'INSURANCE' || $(\"#cmbOrigenAux\").getValue() != 'INSURANCE')){\n       $(\"#chk_documentos_web\").enableValidation();\n       $(\"#frm_documentos\").enableValidation();\n     }\n  }\n}\n\n$(\"#frm_check_documentos\").setOnchange(get_documentos);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_cober_select","var_uid":"81527549962ba18d8935028016318799","dataType":"string","protectedValue":false,"id":"frm_cober_select","name":"frm_cober_select","label":"Coberturas","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_cober_select","colSpan":12}],[{"type":"label","id":"lbl_tamnio","label":"El tamanio de los archivos no debe superar los 50MB","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_check_documentos","var_uid":"99493999562ba182e902de9099868636","dataType":"string","protectedValue":false,"id":"frm_check_documentos","name":"frm_check_documentos","label":"Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_check_documentos","colSpan":12}],[{"type":"label","id"