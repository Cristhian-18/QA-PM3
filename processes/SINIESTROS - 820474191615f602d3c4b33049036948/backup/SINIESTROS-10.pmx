"prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"18284238667a673f9254489081914862","prj_uid":"820474191615f602d3c4b33049036948","var_name":"grdDetallePago","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"18284238667a673f9254489081914862","var_name_old":"grdDetallePago","prj_uid_old":"820474191615f602d3c4b33049036948","create":false}]}]}]]></dyn_content>
