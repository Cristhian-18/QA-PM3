n":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_fecha_vencimiento","colSpan":6}],[{"type":"text","variable":"frm_plazo_credito","var_uid":"73222862861d9f874505039003551976","dataType":"string","protectedValue":false,"id":"frm_plazo_credito","name":"frm_plazo_credito","label":"Plazo de Credito Meses","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Ingrese solo niconv('UCS-4LE','UTF-8',pack('V', hexdec('U00fa')))meros","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_plazo_credito","colSpan":6},{"type":"dropdown","variable":"frm_forma_pago","var_uid":"84785236461d9f89993fb22089471542","dataType":"string","protectedValue":false,"id":"frm_forma_pago","name":"frm_forma_pago","label":"Forma de Pago","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"1","label":"CRUCE DE PRIMAS"},{"value":"2","label":"CHEQUE"},{"value":"3","label":"TRANSFERENCIA"}],"var_name":"frm_forma_pago","colSpan":6}],[{"type":"text","variable":"frm_num_at","var_uid":"12705748261d9f8c9e77339003935607","dataType":"string","protectedValue":false,"id":"frm_num_at","name":"frm_num_at","label":"No. AT","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_num_at","colSpan":6},{"type":"dropdown","varia