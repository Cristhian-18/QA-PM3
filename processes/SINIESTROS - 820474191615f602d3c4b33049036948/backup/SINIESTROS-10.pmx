                }

                curl_close($ch);
                $result = json_decode($res);
                echo '15';
                PMFBitacoraServicios(@@APP_NUMBER, 'trigger', 'Guardar documentos MFILES', $url_mfils_param, 'POST', "apikey: " . $token, $json, $result, $msg_m);
