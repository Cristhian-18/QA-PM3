0474191615f602d3c4b33049036948","var_name":"chk_documentos","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"inp_doc_uid":"","var_uid_old":"67436040960c80a8d1a2c72098405343","var_name_old":"chk_documentos","prj_uid_old":"8576130285f3aa779242d43020182139","create":false}]}]}]]></dyn_content>
