n_regular_4","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2590718105f3ca25452fb31095485119","var_name_old":"expresion_regular_4","prj_uid_old":"8576130285f3aa779242d43020182139"}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"53159838961f1efa5eb4289036173351","name":"SubForm Mensaje Stro","description":"SubForm Mensaje Stro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());\n\n\n$(\"#pnl_parcial\").hide()\nvar id_parcial = $(\"#html_parcial\").html(\"CASO CATALOGADO COMO PARCIAL REVISE EN SISE -\"+$(\"#tri_imp_monto_estimado\").getValue()+' | '+$(\"#tri_imp_monto_pagado\").getValue());\n\nif($(\"#tri_bandera_parcial\").getValue() == 'true'){\n\t$(\"#pnl_parcial\").show();\n}"},"language":"en","externalLibs":"plugin/beesmartec/core_librerias/js_externos/app.min.js,\nplugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, \nplugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div