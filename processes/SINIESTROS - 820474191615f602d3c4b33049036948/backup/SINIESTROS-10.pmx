ieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","columnWidth":"10","width":100,"title":"%"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"cod_parentesco","name":"cod_parentesco","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_apellido2","name":"txt_apellido2","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"cod_tipo_doc","name":"cod_tipo_doc","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"cod_tipo_persona","name":"cod_tipo_persona","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_ben_nro_aseg","name":"grd_ben_nro_aseg","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"cod_leyenda","name":"cod_leyenda","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"90782914561da203e7eb7f1007732964","prj_uid":"820474191615f602d3c4b33049036948","var_name":"grd_beneficiarios","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"frm_sbt_resumen_liquidacion","label":"<span class=\"subtitulo\" id=\"ifrm_sbt_resumen_liquidacion\" subform=\"22934569061d6fd88f0d814094422539\n\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nResumen Liquidacion<\/span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"680302370680be5afc13bf4037693296","name":"SubForm Info Liquidacion Siniestro","description":"","mode":"edit","script":{"type":"js","code":"var respuestaJson = $(\"#respuestaApiLiquidacion\").getValue();\n\ntry {\n    var respuestaApi = JSON.parse(respuestaJson);\n\n    var html = `\n      <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n        <thead>\n          <tr style=\"background-color: #f2f2f2;\">\n            <th style=\"border: 1px solid #ccc; padding: 6px;\">C\u00f3digo Abonado<\/th>\n            <th style=\"border: 1px solid #ccc; padding: 6px;\">Estado<\/th>\n            <th style=\"border: 1px solid #ccc; padding: 6px;\">Valor<\/th>\n          <\/tr>\n        <\/thead>\n        <tbody>\n    `;\n\n    respuestaApi.forEach(function (item) {\n        var estado = \"-\";\n        var valor = \"\";\n\n        try {\n            var respuesta = JSON.parse(item.respuesta);\n            estado = respuesta.message || \"Sin mensaje\";\n\n            if (respuesta.code === 0 && Array.isArray(respuesta.data) && respuesta.data.length > 0) {\n                var datos = respuesta.data[0];\n                valor = `\n                  <ul style=\"padding-left: 18px; margin: 0;\">\n                    <li><strong>No. AT:<\/strong> ${datos.nro_aut_tec || \"-\"}<\/li>\n                    <li><strong>No. Recibo:<\/strong> ${datos.nro_recibo || \"-\"}<\/li>\n                    <li><strong>No. OP:<\/strong> ${datos.nro_op || \"-\"}<\/li>\n                  <\/ul>\n                `;\n            }\n        } catch (err) {\n            estado = \"\u274c Respuesta inv\u00e1lida\";\n        }\n\n        html += `\n          <tr>\n            <td style=\"border: 1px solid #ccc; padding: 6px;\">${item.cod_abona_vrs}<\/td>\n            <td style=\"border: 1px solid #ccc; padding: 6px;\">${estado}<\/td>\n            <td style=\"border: 1px solid #ccc; padding: 6px;\">${valor}<\/td>\n          <\/tr>\n        `;\n    });\n\n    html += `\n        <\/tbody>\n      <\/table>\n    `;\n\n    $('#pnlInfoLiquidacionSiniestro').html(html);\n\n} catch (e) {\n    console.error(\"Error al parsear JSON:\", e);\n    $('#pnlInfoLiquidacionSiniestro').html(\"<p style='color: red;'>\u274c Error al mostrar los resultados.<\/p>\");\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frmCmbTipoLiquidacion","var_uid":"86670624867e70d09155115076879303","dataType":"string","protectedValue":false,"id":"frmCmbTipoLiquidacion","name":"frmCmbTipoLiquidacion","label":"Tipo Liquidacion","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"TOTAL","label":"TOTAL"},{"value":"PARCIAL","label":"PARCIAL"}],"var_name":"frmCmbTipoLiquidacion","colSpan":12}],[{"type":"label","id":"lblMensajePago","label":"Mensaje ","colSpan":12}],[{"type":"grid","variable":"grdDetallePago","var_uid":"18284238667a673f9254489081914862","dataType":"grid","protectedValue":false,"id":"grdDetallePago","name":"grdDetallePago","label":"Pagos","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtCobertura","name":"grdtxtCobertura","label":"Cobertura","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":10