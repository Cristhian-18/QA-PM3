n glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"tri_fecha_ultimos_docs","colSpan":6}],[{"type":"textarea","variable":"frm_negativa_nota","var_uid":"446049171624e0dced78681038429442","dataType":"string","protectedValue":false,"id":"frm_negativa_nota","name":"frm_negativa_nota","label":"Razon de negativa","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_negativa_nota","colSpan":12}]],"variables":[{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"55631582268ef6266160ef6000443239","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frmTipoGestion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"11880073068ef6413080834061411630","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frmValorReservaInsurance","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc