    $tarea_actual    = PMFGetTaskName($rs_siguiente['TAS_UID'], 'es');

    @@tmp_entra = @@TASK;
    //validacion por tarea
    switch (@@TASK) {
        //tarea 1
        case '799986505615f607b50a4f4033464318':
