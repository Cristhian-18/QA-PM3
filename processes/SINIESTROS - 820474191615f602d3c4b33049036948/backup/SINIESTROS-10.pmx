        <dyn_filename><![CDATA[820474191615f602d3c4b33049036948/53159838961f1efa5eb4289036173351]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"SubForm Mensaje Stro","description":"SubForm Mensaje Stro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"53159838961f1efa5eb4289036173351","name":"SubForm Mensaje Stro","description":"SubForm Mensaje Stro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());\n\n\n$(\"#pnl_parcial\").hide()\nvar id_parcial = $(\"#html_parcial\").html(\"CASO CATALOGADO COMO PARCIAL REVISE EN SISE -\"+$(\"#tri_imp_monto_estimado\").getValue()+' | '+$(\"#tri_imp_monto_pagado\").getValue());\n\nif($(\"#tri_bandera_parcial\").getValue() == 'true'){\n\t$(\"#pnl_parcial\").show();\n}"},"language":"en","externalLibs":"plugin/beesmartec/core_librerias/js_externos/app.min.js,\nplugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, \nplugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"894162426622a1aa60b3b16032649971","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"523985251622a208a6237f9095133573","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"536049576622a20928ebc87025210023","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}],[{"type":"panel","id":"pnl_parcial","content":"<div class=\"box-body text-center\">\n  <div class=\"alert alert-danger alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_parcial\"></div></h2>\n  </div>\n</div>\n","border":"1px","colSpan":12}]],"variables":[{"var_uid":"22541636561df31c8065066073006658","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"894162426622a1aa60b3b16032649971","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_parcial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"523985251622a208a6237f9095133573","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"536049576622a20928ebc87025210023","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
