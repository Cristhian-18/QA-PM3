base","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"51609304561d9cf6cabc625016423245","var_name_old":"tri_bandera_analista","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"60240974361da36f3af43c2062664056","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_medico","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"60240974361da36f3af43c2062664056","var_name_old":"tri_bandera_medico","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"61380867161e6ea5c422e91019868588","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_monto_aprobado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"61380867161e6ea5c422e91019868588","var_name_old":"frm_monto_aprobado","prj_uid_old":"820474191615f602d3c4b33049036948","create":false}]}]}]]></dyn_content>
