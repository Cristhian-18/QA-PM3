                    PMFRedirectToStep(@@APPLICATION, @%INDEX, 'DYNAFORM', '669886330625d96ef6d7cd1073394695');
                }else{
                    PMFRedirectToStep(@@APPLICATION, @%INDEX, 'DYNAFORM', '76587094661da3be8a7b6b9083070571');
                }
            }
        }
    } catch (Exception $e) {

        $errorMessage =  $e->getMessage();


    }

    //	print_r($result);
]]></tri_webbot>
