Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5750508896272aec0b29da7032371456","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_cod_aseg_fallecido","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4790341976272aed2230420041953881","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_id_cns_fallecido","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"6129828476272aee1b88864075184711","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_id_persona_fallecido","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"198484631626c3fb66830c7026565051","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_region_ocurrencia","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
