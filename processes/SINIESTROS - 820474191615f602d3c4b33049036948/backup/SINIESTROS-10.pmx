    $del_index           = @@INDEX;
    $del_index_siguiente = @@INDEX + 1;
    $cod_negativa = 0;
    @@frm_accion_aux  = @@frm_accion;

    $sql = "SELECT * FROM APP_DELEGATION WHERE APP_UID = '$app_uid' AND (DEL_INDEX = '$del_index' OR DEL_INDEX = '$del_index_siguiente' ) ORDER BY DEL_INDEX";
    $rs  = executeQuery($sql);
    $rs_actual    = $rs['1'];
    $rs_siguiente = $rs['2'];

    $ticket              = @@APP_NUMBER;
