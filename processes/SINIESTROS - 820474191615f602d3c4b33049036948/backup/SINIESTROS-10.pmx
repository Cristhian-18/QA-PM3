hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_comentario","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"ENVIAR","tabIndex":"","ariaLabel":"","colSpan":12}]],"variables":[{"var_uid":"41414035361d838babe1029099803881","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_user_sac_uname","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"41414035361d838babe1029099803881","var_name_old":"tri_user_sac_uname","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"51609304561d9cf6cabc625016423245","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_analista","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"51609304561d9cf6cabc625016423245","var_name_old":"tri_bandera_analista","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"60240974361da36f3af43c2062664056","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_medico","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"60240974361da36f3af43c2062664056","var_name_old":"tri_bandera_medico","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"61380867161e6ea5c422e91019868588","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_monto_aprobado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"61380867161e6ea5c422e91019868588","var_name_old":"frm_monto_aprobado","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"38614681761f2079f8a8747080043885","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_message_update","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"38614681761f2079f8a8747080043885","var_name_old":"tri_message_update","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"6293735526261bb95c70f84091777248","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_bandera_cliente","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6293735526261bb95c70f84091777248","var_name_old":"tri_bandera_cliente","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"60536779361d9ce765a3cd3080469604","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[{"value":"","label":"--- Seleccione ---"}],"inp_doc_uid":"","var_uid_old":"60536779361d9ce765a3cd3080469604","var_name_old":"frm_accion","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"85419249361d665d0b3f134007509760","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_comentar