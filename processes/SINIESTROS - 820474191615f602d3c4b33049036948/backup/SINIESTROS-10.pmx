USERNAME,' - ', U.USR_FIRSTNAME, ' ',U.USR_LASTNAME ) AS NAME \nFROM GROUP_USER G, USERS U \nWHERE U.USR_UID = G.USR_UID AND G.GRP_UID = '42316650961d65806bc96e4063689284'\nAND U.USR_UID != '@#USER_LOGGED'\nAND U.USR_STATUS = 'ACTIVE'","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"tri_user_pda","colSpan":12}],[{"type":"dropdown","variable":"tri_user_auditor","var_uid":"21136169861e9cb98375566091276017","dataType":"string","protectedValue":false,"id":"tri_user_auditor","name":"tri_user_auditor","label":"Auditores tecnicos","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT U.USR_UID, CONCAT(U.USR_USERNAME,' - ', U.USR_FIRSTNAME, ' ',U.USR_LASTNAME ) AS NAME \nFROM GROUP_USER G, USERS U \nWHERE U.USR_UID = G.USR_UID AND G.GRP_UID = '26132490261d657dcdd2195090786463'\nAND U.USR_STATUS = 'ACTIVE'","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"tri_user_auditor","colSpan":12}],[{"type":"textarea","variable":"frm_comentario","var_uid":"85419249361d665d0b3f134007509760","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Observaciones","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_comentario","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"ENVIAR","colSpan":12}]],"variables":[{"var_uid":"41414035361d838babe1029099803881","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_user_sac_uname","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_acc