        <dyn_content><![CDATA[{"name":"SubForm Analisis Insurance","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"24658506168ef61d6a7ff47016147128","name":"SubForm Analisis Insurance","description":"","mode":"edit","script":{"type":"js","code":"function accion(newValue, oldValue) {\n  $(\"#frm_negativa_nota\").disableValidation();  \n  if(newValue == 'NEGATIVA'){\n    $(\"#frm_negativa_nota\").enableValidation();    \n    $(\"#frmValorLiquidarInsurance\").disableValidation();\n  }else{\n    $(\"#frmValorLiquidarInsurance\").enableValidation();    \n  }\n}\n\naccion();\n$(\"#frmTipoGestion\").setOnchange(accion);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","label":"Numero reclamo INSURANCE","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":6},{"type":"dropdown","variable":"frmTipoGestion","var_uid":"55631582268ef6266160ef6000443239","dataType":"string","protectedValue":false,"id":"frmTipoGestion","name":"frmTipoGestion","label":"Tipo de gestion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"LIQUIDACION","label":"Liquidacion"},{"value":"NEGATIVA","label":"Negativa"}],"var_name":"frmTipoGestion","colSpan":6}],[{"type":"text","variable":"frmValorReservaInsurance","var_uid":"11880073068ef6413080834061411630","dataType":"string","protectedValue":false,"id":"frmValorReservaInsurance","name":"frmValorReservaInsurance","label":"Valor reserva","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frmValorReservaInsurance","colSpan":6},{"type":"text","variable":"frmValorLiquidarInsurance","var_uid":"51771359668ef8792b81d51084434845","dataType":"string","protectedValue":false,"id":"frmValorLiquidarInsurance","name":"frmValorLiquidarInsurance","label":"Valor a liquidar","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frmValorLiquidarInsurance","colSpan":6}],[{"type":"datetime","variable":"tri_fecha_ultimos_docs","var_uid":"476338287633c73d7a25e93087865096","dataType":"datetime","protectedValue":false,"id":"tri_fecha_ultimos_docs","name":"tri_fecha_ultimos_docs","label":"Fecha ultimos documentos","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"tri_fecha_ultimos_docs","colSpan":6},{"colSpan":6}],[{"type":"textarea","variable":"frm_negativa_nota","var_uid":"446049171624e0dced78681038429442","dataType":"string","protectedValue":false,"id":"frm_negativa_nota","name":"frm_negativa_nota","label":"Razon de negativa","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"5","var_name":"frm_negativa_nota","colSpan":12}],[{"type":"multipleFile","variable":"frm_documentos","var_uid":"24980288461d6664db74151087263353","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos","name":"frm_documentos","label":"Documentos","inputDocument":"Documentos del flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":".pdf,.jpg,.png,.jpeg","size":50,"sizeUnity":"MB","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"72283441661d65ca9871594084412168","var_name":"frm_documentos","colSpan":12}]],"variables":[{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"55631582268ef6266160ef6000443239","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frmTipoGestion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"11880073068ef6413080834061411630","prj_uid":"820474191615f602