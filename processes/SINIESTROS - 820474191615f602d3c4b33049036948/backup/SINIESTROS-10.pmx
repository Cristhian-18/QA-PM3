 Database","sql":"","memoryCache":false,"columnWidth":"120","width":100,"title":"Valor<br>Deducible"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdtxtObservaciones","name":"grdtxtObservaciones","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"250","width":100,"title":"Observaciones"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtIndexCobertura","name":"txtIndexCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtNombreCobertura","name":"txtNombreCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txtProcesado","name":"txtProcesado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdChkPagoIndividual","name":"grdChkPagoIndividual","label":"Pago Individual","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"130","width":100,"title":"Pago Individual"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grdTxtAT","name":"grdTxtAT","label":"AT","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"130","width":100,"title":"AT"}],"data":[],"mode":"parent","layout":"static","pageSize":"0","addRow":false,"deleteRow":false,"title":"Pagos","colSpan":12}]],"variables":[{"var_uid":"86670624867e70d09155115076879303","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frmCmbTipoLiquidacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"86670624867e70d09155115076879303","var_name_old":"frmCmbTipoLiquidacion","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"18284238667a673f9254489081914862","prj_uid":"820474191615f602d3c4b33049036948","var_name":"grdDetallePago","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"18284238667a673f9254489081914862","var_name_old":"grdDetallePago","prj_uid_old":"820474191615f602d3c4b33049036948","create":false}],"colSpan":12}],[{"type":"subtitle","id":"sbt_atencion","label":"Atencion al caso","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_accion","var_uid":"60536779361d9ce765a3cd3080469604","dataType":"string","protectedValue":false,"id":"frm_accion","name":"frm_accion","label":"Accion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"CONTINUAR","label":"Continuar con la liquidacion"}],"var_name":"frm_accion","colSpan":12}],[{"type":"hidden","variable":"errorLiquidacion","var_uid":"56760794667f6a7af0bafd0033679699","dataType":"string","protectedValue":false,"id":"errorLiquidacion","name":"errorLiquidacion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"errorLiquidacion","colSpan":12}],[{"type":"submit","id":"btn_enviar","name":"btn_enviar","label":"ENVIAR","tabIndex":"","ariaLabel":"","colSpan":12}]],"variables":[{"var_uid":"60536779361d9ce765a3cd3080469604","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[{\"value\":\"\",\"label\":\"--- Seleccione ---\"}]","inp_doc_uid":""},{"var_uid":"56760794667f6a7af0bafd0033679699","prj_uid":"820474191615f602d3c4b33049036948","var_name":"errorLiquidacion","var_field_type":"string","var_field_size":10,"var_label":"integer","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":""}]}]}]]></dyn_content>
