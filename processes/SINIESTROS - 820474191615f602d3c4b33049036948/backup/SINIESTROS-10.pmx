","var_uid":"32886737361d66777d59587025179785","dataType":"string","protectedValue":false,"id":"frm_provincia_ocurrencia","name":"frm_provincia_ocurrencia","label":"Provincia de ocurrencia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'PROVINCIAS' AND VALOR = '@#frm_pais_ocurrencia' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_provincia_ocurrencia","colSpan":6},{"type":"dropdown","variable":"frm_ciudad_ocurrencia","var_uid":"5271021156324e010a669e1084431278","dataType":"string","protectedValue":false,"id":"frm_ciudad_ocurrencia","name":"frm_ciudad_ocurrencia","label":"Ciudad de ocurrencia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'CANTONES' AND VALOR = '@#frm_provincia_ocurrencia' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"}],"var_name":"frm_ciudad_ocurrencia","colSpan":6}],[{"type":"suggest","variable":"frm_causa_siniestro","var_uid":"56936878161d667c5dc7be4028507901","dataType":"string","protectedValue":false,"id":"frm_causa_siniestro","name":"frm_causa_siniestro","label":"Causa del siniestro","tabIndex":"","defaultValue":"","placeholder":"Ingrese el texto de 