        <dyn_content><![CDATA[{"name":"subform temporal","description":"por si acaso","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"126467198625ebcb7737252053513545","name":"subform temporal","description":"por si acaso","mode":"edit","script":{"type":"js","code":"function enmascarar(valor, visiblesIni = 2, visiblesFin = 2) {\n  if (!valor || valor.length <= (visiblesIni + visiblesFin)) return valor;\n  let parteVisibleInicio = valor.substring(0, visiblesIni);\n  let parteVisibleFinal = valor.substring(valor.length - visiblesFin);\n  return parteVisibleInicio + 'X'.repeat(valor.length - visiblesIni - visiblesFin) + parteVisibleFinal;\n}\n\n$(document).ready(function () {\n  \/\/ Supongamos que estos campos vienen de @@camposEnmascarar\n  let campos = [\"txtCedulaMax\", \"txtNombresMax\"];\n\n  campos.forEach(function (campo) {\n    let valorReal = getField(campo);\n    let valorMascara = enmascarar(valorReal);\n\n    \/\/ Guardas el valor real como atributo data-real\n    $(\"#\" + campo).attr(\"data-real\", valorReal);\n\n    \/\/ Mostramos la miconv('UCS-4LE','UTF-8',pack('V', hexdec('U00e1')))scara visualmente\n    setField(campo, valorMascara);\n  });\n\n  \/\/ Antes de enviar, restaurar los valores reales\n  $(\"form\").on(\"submit\", function () {\n    campos.forEach(function (campo) {\n      let valorReal = $(\"#\" + campo).attr(\"data-real\");\n      setField(campo, valorReal);\n    });\n  });\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"txtCedulaMax","var_uid":"853851371685ad60dac85a7065304753","dataType":"string","protectedValue":false,"id":"txtCedulaMax","name":"txtCedulaMax","label":"Cedula","defaultValue":"1803602067","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"txtCedulaMax","colSpan":12}],[{"type":"text","variable":"txtNombresMax","var_uid":"495719331685ad62aaa2f19027259211","dataType":"string","protectedValue":false,"id":"txtNombresMax","name":"txtNombresMax","label":"Nombres","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"txtNombresMax","colSpan":12}]],"variables":[{"var_uid":"853851371685ad60dac85a7065304753","prj_uid":"820474191615f602d3c4b33049036948","var_name":"txtCedulaMax","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"495719331685ad62aaa2f19027259211","prj_uid":"820474191615f602d3c4b33049036948","var_name":"txtNombresMax","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
