        <dyn_content><![CDATA[{"name":"Subform Grid Coberturas Negados","description":"Subform Grid Coberturas Negados","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"894084495633b2068c1e708023638647","name":"Subform Grid Coberturas Negados","description":"Subform Grid Coberturas Negados","mode":"edit","script":{"type":"js","code":"var formId = $(\"form\").prop(\"id\");\n  \n//Set an onchange event handler for the form. When the value of a field changes in the Dynaform, \n//check whether the changed field is the hasDiscount field in the grid. \n//If so, then if hasDiscount is set to \"Discount\", then enable the discountRate field in the same row. \n//If set to \"No Discount\", then disable the discountRate field.\n$( \"#\" + formId ).setOnchange( function(fieldId, newVal, oldVal) {\n\tvar aMatches_vsolicitado = fieldId.match(/^\\[grd_coberturas\\]\\[(\\d+)\\]\\[grd_txt_valor_aprobado\\]$/);\n\t//grid de coberturas monto solicitado\n\tif (aMatches_vsolicitado) {\n\t\tvar rowNo_gv = aMatches_vsolicitado[1];\n\t\t//$(\"#frm_monto_liquidar\").setValue(0);\n\n\t\tif (newVal != \"\") {\n\t\t\tvar total = $(\"#grd_coberturas\").getSummary(12);\n\t\t\tif (total === null || total === \"\" || isNaN(total)) {\n\t\t\t\t$(\"#frm_monto_liquidar\").setValue(0);\n\t\t\t} else {\n\t\t\t\t$(\"#frm_monto_liquidar\").setValue(total);\n\t\t\t}              \n\t\t}\n\t}\n\n\tvar aMatches_vaproba = fieldId.match(/^\\[grd_coberturas\\]\\[(\\d+)\\]\\[grd_txt_valor\\]$/);\n\t//grid de coberturas monto solicitado\n\tif (aMatches_vaproba) {\n\t\tvar rowNo_gv = aMatches_vaproba[1];\n\t\t//$(\"#frm_monto_liquidar\").setValue(0);\n\n\t\tif (newVal != \"\") {\n\t\t\tvar total = $(\"#grd_coberturas\").getSummary(11);\n\t\t\tif (total === null || total === \"\" || isNaN(total)){\n\t\t\t\t$(\"#frm_monto_reportado\").setValue(0);\n\t\t\t}\n\t\t\telse{\n\t\t\t\t$(\"#frm_monto_reportado\").setValue(total);\n\t\t\t}\n\t\t}\n\t}\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_coberturas","var_uid":"141498791624df91de1d4b6041313445","dataType":"grid","protectedValue":false,"id":"grd_coberturas","name":"grd_coberturas","label":"Coberturas encontradas","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_desc_riesgo","name":"grd_txt_desc_riesgo","label":"Cobertura","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"11264850561d723f004d5c2072943786","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CONCAT(DESCRIPCION, ' - ', CODIGO) AS CODIGO, CONCAT(DESCRIPCION, ' - ', CODIGO) AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'COBERTURA_MADRE' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[],"columnWidth":"10","width":100,"title":"Cobertura"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_imp_suma_aseg","name":"grd_imp_suma_aseg","label":"Suma A.","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Suma A."},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_aplicar","name":"grd_txt_aplicar","label":"Aplicar","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"SI","label":"SI"}],"columnWidth":"6","width":100,"title":"Aplicar"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_alcance","name":"grd_txt_alcance","label":"Alcance","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-"},{"value":"SI","label":"SI"}],"columnWidth":"6","width":100,"title":"Alcance"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_conoce_vcuota","name":"grd_txt_conoce_vcuota","label":"Conoce el <br>Valor cuota?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"columnWidth":"8","width":100,"title":"Conoce el <br>Valor cuota?"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_txt_vcuota","name":"grd_txt_vcuota","label":"Valor cuota","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\s*(?=.*[1-9])\\d*(?:\\.\\d{1,2})?\\s*$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","dependsOn":"","loadDropd