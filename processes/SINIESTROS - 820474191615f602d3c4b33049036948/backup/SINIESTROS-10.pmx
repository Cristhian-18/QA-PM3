ield_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"60536779361d9ce765a3cd3080469604","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[{"value":"","label":"--- Seleccione ---"}],"inp_doc_uid":"","var_uid_old":"60536779361d9ce765a3cd3080469604","var_name_old":"frm_accion","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"12772744061dada0dbe5027023934942","prj_uid":"820474191615f602d3c4b33049036948","var_name":"fle_negativa","var_field_type":"file","var_field_size":10,"var_label":"file","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":"72283441661d65ca9871594084412168"},{"var_uid":"52670265264381b3e594d16057584960","prj_uid":"820474191615f602d3c4b33049036948","var_name":"fle_actaComite","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"32315472161df3cfb123570010734958","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_user_pda","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"21136169861e9cb98375566091276017","prj_uid":"820474191615f602d3c4b33049036948","var_name":"tri_user_auditor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"85419249361d665d0b3f134007509760","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"85419249361d665d0b3f134007509760","var_name_old":"frm_comentario","prj_uid_old":"820474191615f602d3c4b33049036948","create":false}]}]}]]></dyn_content>
