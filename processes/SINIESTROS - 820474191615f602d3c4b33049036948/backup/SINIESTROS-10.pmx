,"textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_nombres","colSpan":4}],[{"type":"panel","id":"pnl_datareturn","content":"<div class=\"alert alert-info alert-dismissible\">\n  <h5><i class=\"icon fa fa-info\"><\/i> Informaci\u00f3n Adicional!<\/h5>\n  <div id=\"datareturn\"><\/div>\n<\/div>","border":"1px","colSpan":12}]],"variables":[{"var_uid":"39669798361d65d602e56c3025705212","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_tipo_busqueda","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"36800774261d65e15af5675072976685","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_fecha_ocurrencia","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"87347332861d65e69e99a16045176755","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_tipo_documento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"62087575461d65ea78a4668099127627","prj_uid":"820474191615f602d3c4b33049036948","var_name":"frm_numero_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"42356496861d65f42891040011640991","prj_uid":"820474191615f602d3c4b33049036948","var_name":"fr