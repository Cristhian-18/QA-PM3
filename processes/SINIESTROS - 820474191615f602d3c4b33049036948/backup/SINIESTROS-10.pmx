        <tri_description>Consultar_user_sac</tri_description>
        <pro_uid>820474191615f602d3c4b33049036948</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[try {


    $pro_uid     = @@PROCESS;
    $cnx         = '11264850561d723f004d5c2072943786';
    $contratante = @@frm_tipo_contratante;

    //Generar Reserva SiSe
    @@__ERROR__ = '';

    if (@@tri_bandera_alcance == '') {
        @@tri_id_stro  = '';
        @@tri_nro_stro = '';
    }

    @@tri_bandera_grabado = '';
    @@tri_message_grabado = '';

    /*******************************************************
    *
    * Generated by ProcessMaker Trigger Wizard
    * Library: ProcessMaker Functions
    * Method: PMF Send Message
    * Date: 2020-08-30 10:35:06
    *
    * ProcessMaker 2020
    *
    *******************************************************/

    /* Recupera destinatarios de correo */
    $desPARA = '';
    $desBCC  = '';

    $sql_correo = "SELECT *
    FROM ADMIN_CATALOGOS WHERE
    PRO_UID = 'GENERICO'
    AND INTEGRACION = '820474191615f602d3c4b33049036948'
    AND DESCRIPCION = 'Consultar_user_sac'
    ";

    $rs_correo = executeQuery($sql_correo, $cnx);
    $desPARA   = $rs_correo[1]['VALOR'];
    $desBCC    = $rs_correo[1]['CAMPO1'];

    //ENVIO DE EMAIL
    $texto = 'ERROR Creación de reserva de SINIESTRO';
    $de    = '';
    //$para = 'jpvalenzuela@segurosequinoccial.com';
    $cc = @@tri_user_sac_mail;
    //$bcc='dalulema@segurosequinoccial.com';
    $para          = $desPARA;
    $bcc           = $desBCC;
    $asunto        = "ERROR Creación de reserva de SINIESTRO " . @#APP_NUMBER;
    $plantilla_rec = 'Error_Resrerva.html';

    @@tri_estado_evento = 1;

    @@tri_fecha_registro_web = date('Y-m-d');
    @@frm_fecha_registro     = date('Y-m-d');

    //fecha de respuesta
    @@frm_fecha_notificacion = date('Y-m-d');
    $fecha_notificacion      = @@frm_fecha_notificacion;
    $dias_respuesta          = @@frm_dias_respuesta;

    $date_actual = date('Y-m-d');

    $date_respuesta = date("Y-m-d", strtotime($fecha_notificacion . "+ $dias_respuesta days"));

    @@frm_fecha_respuesta = $date_respuesta;

    //para el tiempo de la poliza
    //@@frm_fecha_ingreso_poliza_aux = (@@frm_fecha_ingreso_poliza_aux == '' ? @@frm_fecha_ingreso_poliza : @@frm_fecha_ingreso_poliza_aux);

    $tmp_poliza_aux = @@frm_fecha_ingreso_poliza_aux;

    if ($tmp_poliza_aux == '') {
        @@frm_fecha_ingreso_poliza_aux = @@frm_fecha_ingreso_poliza;
    }

    $date_poliza     = explode(" ", @@frm_fecha_ingreso_poliza_aux);
    $arr_date_poliza = explode("/", $date_poliza[0]);
    $mes_pol         = $arr_date_poliza[0];
    $dia_pol         = $arr_date_poliza[1];
    $anio_pol        = $arr_date_poliza[2];

    //@@frm_fecha_ingreso_poliza = substr(@@frm_fecha_ingreso_poliza, 0, 10);
    //@@frm_fecha_ingreso_poliza = str_replace("/","-",@@frm_fecha_ingreso_poliza);
    @@frm_fecha_ingreso_poliza = $anio_pol . '-' . $mes_pol . '-' . $dia_pol;
    $firstDate                 = date("Y-m-d", strtotime(@@frm_fecha_ingreso_poliza));
    //formatDate(@@frm_fecha_ingreso_polizass, "yyyy-mm-dd");
    $secondDate     = date("Y-m-d");
    $dateDifference = abs(strtotime($secondDate) - strtotime($firstDate));

    $years  = floor($dateDifference / (365 * 60 * 60 * 24));
    $months = floor(($dateDifference - $years * 365 * 60 * 60 * 24) / (30 * 60 * 60 * 24));
    $days   = floor(($dateDifference - $years * 365 * 60 * 60 * 24 - $months * 30 * 60 * 60 * 24) / (60 * 60 * 24));

    $time = $years . " años,  " . $months . " meses y " . $days . " días";

    @@frm_tiempo_poliza = $time;

    //tipo de solicitud catalogo
    $tri_valor_cobertura_madre = @@tri_valor_cobertura_madre;
    $sql_ts                    = "SELECT CODIGO FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_SINIESTRO' AND PRO_UID = '$pro_uid' AND ESTADO = 1 AND CODIGO = $tri_valor_cobertura_madre ";
    $rs_ts                     = executeQuery($sql_ts, $cnx);
    @@frm_tipo_siniestro       = $rs_ts['1']['CODIGO'];

    if (@@frm_accion == 'CONTINUAR' || @@frm_accion == 'ESPERAR') {
        if (@@tri_bandera_alcance == 'ALCANCE') {
            //GENERAR ALCANCE EN SISE
            $codigo_cau                 = @@frm_causa_siniestro;
            $sql_ca                     = "SELECT CODIGO, CONCAT(VALOR, ' ', DESCRIPCION) AS NOMBRE FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'CAUSAS_SINIESTROS' AND CODIGO = '$codigo_cau'";
            $rs_ca                      = executeQuery($sql_ca, $cnx);
            @@frm_causa_siniestro_label = $rs_ca['1']['NOMBRE'];

            //header
            $cod_suc          = @@frm_sucursal;
            $cod_ramo         = @@frm_ramo;
            $id_pv_fact       = @@frm_id_pv;
            $id_pv_cero       = @@frm_id_pv_cero;
            $fec_hora_reclamo = @@frm_fecha_ocurrencia;
            $fec_aviso        = @@frm_fecha_notificacion;
            $fec_registro     = date('Y-m-d');
            $fec_dciapol      = date('Y-m-d');
            $nro_dcia         = "";
            $cod_causa        = @@frm_causa_siniestro;
            if (@@TASK == '799986505615f607b50a4f4033464318') {
                $cod_usuario = @@USR_USERNAME;
                $cod_usuario = 'iportilla';
            } else {
                $cod_usuario = 'iportilla';
            }

            $cod_evento     = 1;
            $cod_causa_stro = 0;
            //$cod_tipo_pago = (@@frm_tipo_pago == '' ? 0: @@frm_tipo_pago);
            $tmp_tipo_pago = @@frm_tipo_pago;

            if ($tmp_tipo_pago == '') {
                $cod_tipo_pago = 0;
            } else {
                $cod_tipo_pago = $tmp_tipo_pago;
            }
            $nro_crm             = @@APP_NUMBER;
            $cod_tipo_siniestro  = @@frm_tipo_siniestro;
            $imp_monto_reportado = @@frm_monto_reportado;
            // $sn_mes_vencido = (@@frm_mes_vencido_label == 'true' ? 1 : 0);
            $tmp_mes_vencido = @@frm_mes_vencido_label;

            if ($tmp_mes_vencido == 'true') {
                $sn_mes_vencido = 1;
            } else {
                $sn_mes_vencido = 0;
            }
            $cod_cobertura_madre = @@frm_cobertura_madre;
            //$cod_diagnostico = (@@frm_diagnostico == '' ? 0 : @@frm_diagnostico);

            $cod_diagnostico         = 0;
            $cod_motivo_detenido     = 1;
            $cod_usuario_autoriza    = "DSAA";
            $fec_concesion_credito   = (@@frm_fecha_concesion == '' ? '1999-01-01' : @@frm_fecha_concesion);
            $fec_vencimiento_credito = (@@frm_fecha_vencimiento == '' ? '1999-01-01' : @@frm_fecha_vencimiento);
            $cod_plazo_credito       = (@@frm_plazo_credito == '' ? 0 : @@frm_plazo_credito);
            $cod_aseg                = @@frm_cod_aseg;

            $monto_reportado = (float) @#frm_monto_reportado;



            if (@#frm_monto_pagado_al == '') 
            {
                $monto_pagado = 0;
            } else {
                $monto_pagado = (float) @#frm_monto_pagado_al;
            }

            $imp_estimado = $monto_reportado + $monto_pagado;

            $id_stro              = @@tri_id_stro;
            $nro_stro             = @@tri_nro_stro;
            $cod_estado_siniestro = 1;
            $cod_estado_evento    = 7;
            $marca_stro           = 1;
            $imp_recl             = 0;



            //obtengo el token
            $sql_cata_auth = "SELECT DESCRIPCION FROM ADMIN_CATALOGOS WHERE PRO_UID = '$pro_uid' AND CODIGO = 'URL_CU_GEN_TOKEN_AUTH'";
            $rs_auth       = executeQuery($sql_cata_auth, $cnx);

            $url_auth = isset($rs_auth['1']['DESCRIPCION']) ? $rs_auth['1']['DESCRIPCION'] : '';
            $dns_auth = $url_auth;

            $aVars_auth = [
                "userName" => "servicio_proveedores",
