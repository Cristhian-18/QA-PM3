                        }else{
                            //if(@@tri_bandera_alcance == 'ALCANCE' || @@tri_bandera_parcial == 'true'){
                                if(@@tri_bandera_parcial == 'true'){
                                    $imp_estimado = (@@frm_monto_pagado_al == '' ? @@frm_monto_liquidar : @@frm_monto_pagado_al);
                                    $imp_estimado = $imp_estimado + @#frm_monto_liquidar;
