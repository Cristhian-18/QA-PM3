        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//created by Henry
//11-1-2021
//Consulta Beneficiarios Poliza
try{

    @@__ERROR__ = '';
    $cnx_rp = '11264850561d723f004d5c2072943786';
    $pro_uid = @@PROCESS;

    $frm_id_cns = @@frm_id_cns;
    $frm_id_pv = @@frm_id_pv;
