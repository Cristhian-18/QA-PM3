d":"","dataType":"","protectedValue":false,"id":"frm_producto_precio","name":"frm_producto_precio","label":"PRECIO UNITARIO","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"PRECIO UNITARIO"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_producto_subtotal","name":"frm_producto_subtotal","label":"SUBTOTAL","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"frm_producto_precio * frm_producto_cantidad","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"0","width":100,"title":"SUBTOTAL"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_producto_iva","name":"frm_producto_iva","label":"IVA","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"sum","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"0","width":100,"title":"IVA"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_producto_total","name":"frm_producto_total","label":"TOTAL","tabIndex":"","defaultValue":"","placeholder":"","hint":"","a