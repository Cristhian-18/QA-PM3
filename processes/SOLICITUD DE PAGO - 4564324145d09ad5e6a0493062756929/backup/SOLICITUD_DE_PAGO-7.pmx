gistrado en el sistema de Proveedores\");\n        return;\n      }\n\n      var nombre = respuesta.NOMBRE;\n      var email  = '';\n      var ruc    = respuesta.IDENTIIFICACION;\n      var estado = respuesta.ESTADO;\n      var tipo   = respuesta.TIPOPERSONA;\n      var dir    = (respuesta.direccion_lista && respuesta.direccion_lista.length > 0)\n                     ? respuesta.direccion_lista[0].DIRECCION\n                     : '';\n\n      $(\"#frm_proveedor_ruc\").setValue(ruc);\n      $(\"#frm_proveedor_email\").setValue(email);\n      $(\"#frm_proveedor_nombre\").setValue(nombre);\n      $(\"#frm_proveedor_estado\").setValue(estado);\n      $(\"#frm_proveedor_dir\").setValue(dir);\n      $(\"#frm_tipo_proveedor\").setValue(tipo);\n    },\n    error : function(xhr, status) {\n      $(\"#9891392165d09b15744efe8017167361\").hideFormModal(); // también cerrar en error HTTP\n    },\n    complete : function(xhr, status) {\n      // sin acción adicional necesaria\n    }\n  });\n}\n\n$('#btn_ruc').on('click', function(){\n  inicializar_proveedor();\n  consultar_proveedor();\n});\n\nfunction inicializar_proveedor(){\n  $(\"#frm_proveedor_nombre\").setValue('');\n  $(\"#frm_proveedor_email\").setValue('');\n  $(\"#frm_proveedor_estado\").setValue('');\n  $(\"#frm_proveedor_dir\").setValue('');\n  $(\"#frm_tipo_proveedor\").setValue('');\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_proveedor_ruc","var_uid":"5974045445d37d1ff7296a7089902081","dataType":"string","protectedValue":false,"id":"frm_proveedor_ruc","name":"frm_proveedor_ruc","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Ruc o cédula invalido","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_ruc","colSpan":4},{"type":"button","id":"btn_ruc","name":"btn_ruc","label":"Buscar","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"text","variable":"frm_proveedor_nombre","var_uid":"6539646365d37d1ff8ec576003628494","dataType":"string","protectedValue":false,"id":"frm_proveedor_nombre","name":"frm_proveedor_nombre","label":"Empresa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_nombre","colSpan":6}],[{"type":"text","variable":"frm_proveedor_email","var_uid":"2901494785d37d1ffaaaf16069845958","dataType":"string","protectedValue":false,"id":"frm_proveedor_email","name":"frm_proveedor_email","label":"Email","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_email","colSpan":6},{"type":"text","variable":"frm_proveedor_estado","var_uid":"4541175755d37d1ffc8c4c9019677992","dataType":"string","protectedValue":false,"id":"frm_proveedor_estado","name":"frm_proveedor_estado","label":"Estado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection"