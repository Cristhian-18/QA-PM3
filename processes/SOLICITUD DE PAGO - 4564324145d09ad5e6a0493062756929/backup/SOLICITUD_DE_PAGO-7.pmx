onLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"10","addRow":false,"deleteRow":false,"title":"DETALLE","colSpan":12}],[{"type":"suggest","variable":"prod_codigo","var_uid":"2098938125d09b1c282f161096990310","dataType":"string","protectedValue":false,"id":"prod_codigo","name":"prod_codigo","label":"Producto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[],"delay":"","resultsLimit":10,"forceSelection":false,"var_name":"prod_codigo","colSpan":4},{"type":"text","variable":"prod_detalle","var_uid":"7680894925d09b1c2b1bfd3001637952","dataType":"string","protectedValue":false,"id":"prod_detalle","name":"prod_detalle","label":"Detalle","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"prod_detalle","colSpan":8}],[{"type":"text","variable":"prod_cantidad","var_uid":"2680730245d09b1c33b5bd6068056394","dataType":"string","protectedValue":false,"id":"prod_cantidad","name":"prod_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"