        <dyn_content><![CDATA[{"name":"pruebas","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7809669835d6551dd614ee4000471218","name":"pruebas","description":"","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[],"variables":[]}]}]]></dyn_content>
