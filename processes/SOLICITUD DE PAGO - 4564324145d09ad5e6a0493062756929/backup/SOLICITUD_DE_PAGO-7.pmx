        <dyn_filename><![CDATA[4564324145d09ad5e6a0493062756929/8920896775d37d1cf470856076601548]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"subform proveedor","description":"proveedor seleccionado","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8920896775d37d1cf470856076601548","name":"subform proveedor","description":"proveedor seleccionado","mode":"edit","script":{"type":"js","code":"function consultar_proveedor(ruc, valor)\n{\n  var ruc = $(\"#frm_proveedor_ruc\").getValue();\n \n  $.ajax({\n    url  : '../beesmartec/services/solicitud_pago/ajax_pagos.php',\n    data : {\n      'funcion' : 'consultar_proveedor',\n      'ruc'  : ruc\n    },\n    type : 'POST',\n    dataType : 'json',\n    beforeSend : function(){\n      $(\"#9891392165d09b15744efe8017167361\").showFormModal();\n    },\n    success : function(respuesta) {\n      $(\"#9891392165d09b15744efe8017167361\").hideFormModal(); // cierra el loader\n\n      if (respuesta.ERROR !== \"EXITO\" || !respuesta.ID_PERSONA) {\n        alert(\"El proveedor seleccionado no esta registrado en el sistema de Proveedores\");\n        return;\n      }\n\n      var nombre = respuesta.NOMBRE;\n      var email  = '';\n      var ruc    = respuesta.IDENTIIFICACION;\n      var estado = respuesta.ESTADO;\n      var tipo   = respuesta.TIPOPERSONA;\n      var dir    = (respuesta.direccion_lista && respuesta.direccion_lista.length > 0)\n                     ? respuesta.direccion_lista[0].DIRECCION\n                     : '';\n\n      $(\"#frm_proveedor_ruc\").setValue(ruc);\n      $(\"#frm_proveedor_email\").setValue(email);\n      $(\"#frm_proveedor_nombre\").setValue(nombre);\n      $(\"#frm_proveedor_estado\").setValue(estado);\n      $(\"#frm_proveedor_dir\").setValue(dir);\n      $(\"#frm_tipo_proveedor\").setValue(tipo);\n    },\n    error : function(xhr, status) {\n      $(\"#9891392165d09b15744efe8017167361\").hideFormModal(); // también cerrar en error HTTP\n    },\n    complete : function(xhr, status) {\n      // sin acción adicional necesaria\n    }\n  });\n}\n\n$('#btn_ruc').on('click', function(){\n  inicializar_proveedor();\n  consultar_proveedor();\n});\n\nfunction inicializar_proveedor(){\n  $(\"#frm_proveedor_nombre\").setValue('');\n  $(\"#frm_proveedor_email\").setValue('');\n  $(\"#frm_proveedor_estado\").setValue('');\n  $(\"#frm_proveedor_dir\").setValue('');\n  $(\"#frm_tipo_proveedor\").setValue('');\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_proveedor_ruc","var_uid":"5974045445d37d1ff7296a7089902081","dataType":"string","protectedValue":false,"id":"frm_proveedor_ruc","name":"frm_proveedor_ruc","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Ruc o cédula invalido","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_ruc","colSpan":4},{"type":"button","id":"btn_ruc","name":"btn_ruc","label":"Buscar","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"text","variable":"frm_proveedor_nombre","var_uid":"6539646365d37d1ff8ec576003628494","dataType":"string","protectedValue":false,"id":"frm_proveedor_nombre","name":"frm_proveedor_nombre","label":"Empresa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_nombre","colSpan":6}],[{"type":"text","variable":"frm_proveedor_email","var_uid":"2901494785d37d1ffaaaf16069845958","dataType":"string","protectedValue":false,"id":"frm_proveedor_email","name":"frm_proveedor_email","label":"Email","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_email","colSpan":6},{"type":"text","variable":"frm_proveedor_estado","var_uid":"4541175755d37d1ffc8c4c9019677992","dataType":"string","protectedValue":false,"id":"frm_proveedor_estado","name":"frm_proveedor_estado","label":"Estado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":"100","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_estado","colSpan":6}],[{"type":"text","variable":"frm_proveedor_dir","var_uid":"6020243655d37d1ffe4f502057797919","dataType":"string","protectedValue":false,"id":"frm_proveedor_dir","name":"frm_proveedor_dir","label":"Direccion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_dir","colSpan":6},{"type":"text","variable":"frm_tipo_proveedor","var_uid":"7135022445d37d2000e3147000185013","dataType":"string","protectedValue":false,"id":"frm_tipo_proveedor","name":"frm_tipo_proveedor","label":"Tipo proveedor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_tipo_proveedor","colSpan":6}]],"variables":[{"var_uid":"5974045445d37d1ff7296a7089902081","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_proveedor_ruc","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2807959865cfc69f44f2d75031249691","var_name_old":"frm_proveedor_ruc","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"6539646365d37d1ff8ec576003628494","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_proveedor_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1272891175cfc6a35198df7069364154","var_name_old":"frm_proveedor_nombre","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"2901494785d37d1ffaaaf16069845958","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_proveedor_email","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6278819265d044abf6a2428080366295","var_name_old":"frm_proveedor_email","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"4541175755d37d1ffc8c4c9019677992","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_proveedor_estado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2355067575d214777bd05c3075805848","var_name_old":"frm_proveedor_estado","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"6020243655d37d1ffe4f502057797919","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_proveedor_dir","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6542227375d21119f3c5ef5004309472","var_name_old":"frm_proveedor_dir","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"7135022445d37d2000e3147000185013","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"frm_tipo_proveedor","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1313541205caa992d63e616090122130","var_name_old":"frm_tipo_proveedor","prj_uid_old":"8950685675bc4fc9a7402d3075704630"}]}]}]]></dyn_content>
