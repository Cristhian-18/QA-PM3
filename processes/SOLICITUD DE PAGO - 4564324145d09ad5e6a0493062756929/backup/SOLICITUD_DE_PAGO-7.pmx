connection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"7880729505ca019f93d4fc5026436732","var_name_old":"prod_por_iva","prj_uid_old":"8950685675bc4fc9a7402d3075704630","create":false},{"var_uid":"8454894135d09b9fbd00f04034160730","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"error_presupuesto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4196734645d02e0bb15f930065127792","var_name_old":"error_presupuesto","prj_uid_old":"8950685675bc4fc9a7402d3075704630"},{"var_uid":"1548499895d51fb45d38d59068685465","prj_uid":"4564324145d09ad5e6a0493062756929","var_name":"doc_facturas","var_field_type":"file","var_field_size":10,"var_label":"file","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":"9251805935d0c50a682bf99072397258"}],"colSpan":12}],[{"type":"subtitle","id":"subtit_prov","label":"<span class=\"subtitulo\" id=\"isubtit_prov\" subform=\"8920896775d37d1cf470856076601548\"> <i class=\"glyphicon glyphicon-minus\"></i> PROVEEDOR SELECCIONADO</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8920896775d37d1cf470856076601548","name":"subform proveedor","description":"proveedor seleccionado","mode":"disabled","script":{"type":"js","code":"function consultar_proveedor(ruc, valor)\n{\n  var ruc = $(\"#frm_proveedor_ruc\").getValue();\n//alert (ruc);\n  $.ajax({\n    url  : '../phsoluciones/services/ajax_pagos.php',\n    data : {\n      'funcion' : 'consultar_proveedor',\n      'ruc'  : ruc\n    },\n    type : 'POST',\n    dataType : 'json',\n    beforeSend : function(){\n      $(\"#9891392165d09b15744efe8017167361\").showFormModal();\n    },\n    success : function(respuesta) {\n      $(\"#9891392165d09b15744efe8017167361\").hideFormModal(); \n      console.log (respuesta.data.ERROR);\n      if (respuesta.data.ERROR == 'EXITO'){\n        // poblar variables\n        var nombre = respuesta.data.NOMBRE;\n        //var email = (typeof(respuesta.data.cuenta_lista[0].txt_mail) != \"undefined\" && respuesta.data.cuenta_lista[0].txt_mail\n        // !== null  ? respuesta.data.cuenta_lista[0].txt_mail : '');\n        \n       var email = '';\n\n        var ruc  = respuesta.data.IDENTIIFICACION;        \n        var estado  = respuesta.data.ESTADO;      \n        var tipo = respuesta.data.TIPOPERSONA;      \n\n        var dir =  respuesta.data.direccion_lista[0].DIRECCION;        \n\n        $(\"#frm_proveedor_ruc\").setValue(ruc);\n        $(\"#frm_proveedor_email\").setValue(email);        \n        $(\"#frm_proveedor_nombre\").setValue(nombre);\n        $(\"#frm_proveedor_estado\").setValue(estado);     \n        $(\"#frm_proveedor_dir\").setValue(dir);\n        $(\"#frm_tipo_proveedor\").setValue(tipo);        \n        \n      }\n      if (respuesta.data.ERROR == 'ERROR'){\n        alert (\"El proveedor seleccionado no esta registrado en el sistema de Proveedores\");\n//        $(\"#docs\").html(respuesta.docs);\n\n      }\n\n    },\n    error : function(xhr, status) {\n      //alert(status);\n    },\n    complete : function(xhr, status) {\n      $(\"#8045793035bdf86838339b7066185316\").hideFormModal();      \n      //alert (\"hola fin \");\n    }\n  });    \n}\n\n\n\n$('#btn_ruc').on('click', function(){ \n  inicializar_proveedor();\n/*\nvar ruc = $(\"#frm_proveedor_ruc\").getValue();\n  if (ruc.length != 10 && ruc.length != 13  ){\n    alert ('Ruc o cedula no valida');\n    return false;\n  }\n  */\n  consultar_proveedor();\n});\n\nfunction inicializar_proveedor(){\n  $(\"#frm_proveedor_nombre\").setValue('');\n  $(\"#frm_proveedor_email\").setValue('');\n  $(\"#frm_proveedor_estado\").setValue('');\n  $(\"#frm_proveedor_dir\").setValue('');  \n  $(\"#frm_tipo_proveedor\").setValue('');\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_proveedor_ruc","var_uid":"5974045445d37d1ff7296a7089902081","dataType":"string","protectedValue":false,"id":"frm_proveedor_ruc","name":"frm_proveedor_ruc","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Ruc o cédula invalido","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_ruc","colSpan":4},{"type":"button","id":"btn_ruc","name":"btn_ruc","label":"buscar","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"text","variable":"frm_proveedor_nombre","var_uid":"6539646365d37d1ff8ec576003628494","dataType":"string","protectedValue":false,"id":"frm_proveedor_nombre","name":"frm_proveedor_nombre","label":"Empresa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_proveedor_nombre","colSpan":6}],[{"type":"text","variable":"frm_proveedor_email","var_uid":"2901494785d37d1ffaaaf16069845958","dataType":"string","protectedValue":false,"id":"frm_proveedor_email","name":"frm_proveedor_email","label":"Email","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptio