        <dyn_content><![CDATA[{"name":"Form 6 Verificar da\u00f1os del siniestro Externo","description":"Form 6 Verificar da\u00f1os del siniestro Externo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"779349755656567afd1bfb4094062658","name":"Form 6 Verificar da\u00f1os del siniestro Externo","description":"Form 6 Verificar da\u00f1os del siniestro Externo","mode":"edit","script":{"type":"js","code":"$(\"#repuestos\").hide();\n\n\n$('.menu').on('click', function () {\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#375344004656567afcfcd58015574466\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#709751460656567afce0474081432341\").show();\n      break;\n    case 'repuestos':\n      $('#sub_valores').show()\n      $('#480602794656567afd00279083326971').show()\n      break\n  }\n  $(\"#frm_documentos_otros\").hide();\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#718299480656567afd0c6f5055771758\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#565843896656567afd328b8087596694\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#142725203656567afcda002050435920\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#624298983656567afd15b60051714541\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#601939553656567afce2703072259389\").hide();\n  \/\/$(\"#subt_ve_afectados\").hide();\n  \/\/$(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#780469005656567afce66c5098057154\").hide();\n  $(\"#sub_valores\").hide();\n  $('#480602794656567afd00279083326971').hide()\n  $(\"#527111746656567afd266e9046897016\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#375344004656567afcfcd58015574466\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#709751460656567afce0474081432341\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#970216769656567afcd3ed7021146455\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#582336739656567afcd7d26036202949\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#282239801656567afd29986025672858\").hide();\n  $(\"#subt_direccionador\").hide();\n  $(\"#489756561656567afcf5da3068863338\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#614037051656567afd2d975045685007\").hide();\n\n  $(\"#subt_accidente\").hide();\n  $(\"#560832659656567afcf4d25066588147\").hide();\n  \/\/$(\"#subt_ve_afectados\").hide();\n  \/\/$(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#765755715656567afd18e09041007921\").hide();\n\n}\nfunction mostrar_solicitud() {\n  $(\"#sub_busqueda\").show();\n  $(\"#718299480656567afd0c6f5055771758\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#565843896656567afd328b8087596694\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#142725203656567afcda002050435920\").show();\n  \/\/$(\"#subt_detalle\").show();\n  \/\/$(\"#624298983656567afd15b60051714541\").show();\n  \/\/$(\"#subt_registro\").show();\n  \/\/$(\"#601939553656567afce2703072259389\").show();\n  \/\/$(\"#subt_ve_afectados\").show();\n  \/\/$(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#sub_docs\").show();\n  $(\"#780469005656567afce66c5098057154\").show();\n  $(\"#sub_valores\").show();\n  $(\"#527111746656567afd266e9046897016\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#970216769656567afcd3ed7021146455\").show();\n  $(\"#subt_hsiniestros\").show();\n  $(\"#582336739656567afcd7d26036202949\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#282239801656567afd29986025672858\").show();\n  $(\"#subt_direccionador\").show();\n  $(\"#489756561656567afcf5da3068863338\").show();\n  $(\"#subt_friss\").show();\n  $(\"#614037051656567afd2d975045685007\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#560832659656567afcf4d25066588147\").show();\n  \/\/$(\"#subt_ve_afectados\").show();\n  \/\/$(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#765755715656567afd18e09041007921\").show();\n\n\n}\n\nocultar_todo();\nmostrar_solicitud();\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACI\u00d3N SINIESTROS VEH\u00cdCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\/*\n$('.menu').on('click', function () {\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n      case 'solicitud':\n          mostrar_solicitud();\n          break;\n      case 'documentos':\n          $(\"#subt_docs\").show();\n          $(\"#375344004656567afcfcd58015574466\").show();\n          break;\n      case 'repuestos':\n        $(\"#subt_tallerAsignado\").show();\n        $(\"#756477459656567afd1cfb3086270388\").show();\n        $(\"#sub_taller_asign\").show();\n        $(\"#sub_gestionrepuestos\").show();\n        $(\"#480602794656567afd00279083326971\").show();\n        $(\"#sub_valores_siniestros\").show();\n        $(\"#991013308656567afcf8d28052513130\").show();\n          break;\n      case 'historial':\n          $(\"#sbt_historial\").show();\n          $(\"#709751460656567afce0474081432341\").show();\n          break;\n  }\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#718299480656567afd0c6f5055771758\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#565843896656567afd328b8087596694\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#142725203656567afcda002050435920\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#624298983656567afd15b60051714541\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#601939553656567afce2703072259389\").hide();\n  $(\"#subt_gestionTaller\").hide();\n  $(\"#852122295656567afd17d71016531757\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#780469005656567afce66c5098057154\").hide();\n  $(\"#sub_valores\").hide();\n  $(\"#527111746656567afd266e9046897016\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#970216769656567afcd3ed7021146455\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#582336739656567afcd7d26036202949\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#282239801656567afd29986025672858\").hide();\n  \/\/$(\"#subt_direccionador\").hide();\n  \/\/$(\"#489756561656567afcf5da3068863338\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#614037051656567afd2d975045685007\").hide();\n  $(\"#subt_accidente\").hide();\n  $(\"#560832659656567afcf4d25066588147\").hide();\n  $(\"#subt_valoresSiniestros\").hide();\n  $(\"#899876897656567afce9ba0097496292\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#765755715656567afd18e09041007921\").hide();\n  $(\"#subt_documentosTaller\").hide();\n  $(\"#432589218656567afd33848050036136\").hide();\n  $(\"#subt_tallerAsignado\").hide();\n  $(\"#756477459656567afd1cfb3086270388\").hide();\n  $(\"#subt_accesoriosRegistrados\").hide();\n  $(\"#388204042656567afd22313001660735\").hide();\n  $(\"#sub_accesorios\").hide();\n  $(\"#388204042656567afd22313001660735\").hide();\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#831468248656567afce7676060479058\").hide();\n\n  \n\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n  $(\"#subt_tallerAsignado\").hide();\n  $(\"#756477459656567afd1cfb3086270388\").hide();\n  $(\"#sub_taller_asign\").hide();\n  $(\"#388204042656567afd22313001660735\").hide();\n \n  $(\"#sub_gestionrepuestos\").hide();\n  $(\"#480602794656567afd00279083326971\").hide();\n  $(\"#sub_valores_siniestros\").hide();\n  $(\"#991013308656567afcf8d28052513130\").hide();\n\n\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\n  $(\"#subt_docs\").hide();\n  $(\"#375344004656567afcfcd58015574466\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#709751460656567afce0474081432341\").hide();\n\n}\nfunction mostrar_solicitud() {\n  $(\"#subt_registro\").show();\n  $(\"#601939553656567afce2703072259389\").show();\n  $(\"#sub_busqueda\").show();\n  $(\"#718299480656567afd0c6f5055771758\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#565843896656567afd328b8087596694\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#142725203656567afcda002050435920\").show();\n  $(\"#subt_gestionTaller\").show();\n  $(\"#852122295656567afd17d71016531757\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#sub_docs\").show();\n  $(\"#780469005656567afce66c5098057154\").show();\n  $(\"#sub_valores\").show();\n  $(\"#527111746656567afd266e9046897016\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#970216769656567afcd3ed7021146455\").show();\n  $(\"#subt_hsiniestros\").show();\n  $(\"#582336739656567afcd7d26036202949\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#282239801656567afd29986025672858\").show();\n  $(\"#subt_valoresSiniestros\").show();\n  $(\"#899876897656567afce9ba0097496292\").show();\n  $(\"#subt_friss\").show();\n  $(\"#614037051656567afd2d975045685007\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#560832659656567afcf4d25066588147\").show();\n  $(\"#subt_documentosTaller\").show();\n  $(\"#432589218656567afd33848050036136\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#765755715656567afd18e09041007921\").show();\n  $(\"#subt_detalle\").show();\n  $(\"#624298983656567afd15b60051714541\").show();\n  $(\"#sub_accesorios\").show();\n  $(\"#388204042656567afd22313001660735\").show();\n  $(\"#subt_ve_afectados\").show();\n  $(\"#831468248656567afce7676060479058\").show();\n  \n}\n\nocultar_todo();\nmostrar_solicitud();\n*\/\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud<\/h4><\/a><\/li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos<\/h4><\/a><\/li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos<\/h4><\/a><\/li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_docs","label":"Documentos del caso\n","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"375344004656567afcfcd58015574466","name":"SubForm Documentos del caso","description":"SubForm Documentos del caso","mode":"edit","script":{"type":"js","code":"\/\/ Resuelve el bug de que el link de la grilla\n\/\/ no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    \/*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    *\/\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  \/\/ Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"\/plugin\/phsoluciones\/core_librerias\/datatables\/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"\/plugin\/beesmartec\/core_librerias\/datatables\/jquery.dataTables.css,\n\/plugin\/beesmartec\/core_librerias\/datatables\/jquery.dataTables.js,\n\/plugin\/beesmartec\/core_librerias\/dataTables\/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":""