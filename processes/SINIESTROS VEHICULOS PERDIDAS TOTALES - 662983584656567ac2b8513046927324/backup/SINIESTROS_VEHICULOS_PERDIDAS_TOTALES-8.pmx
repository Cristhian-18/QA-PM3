ll":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"124496421656567afe71789019602920","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"124496421656567afe71789019602920","var_name_old":"frm_comentario","prj_uid_old":"662983584656567ac2b8513046927324","create":false}]}]}]]></dyn_content>
