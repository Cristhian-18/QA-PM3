        <dyn_content><![CDATA[{"name":"SubForm Parte Policial","description":"SubForm Parte Policial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"282239801656567afd29986025672858","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"function checkAfectado(newVal, oldVal) {\n  console.log(newVal);\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'AFECTADO') {\n    $('#frm_siniestro_informacionResponsable').show();\n    $('#frm_siniestro_informacionResponsable').enableValidation();\n    console.log(newVal);\n\n  } else {\n    $('#frm_siniestro_informacionResponsable').setValue(\"\");\n    console.log(newVal);\n\n  }\n}\n\n//execute when the Dynaform loads:\ncheckAfectado($(\"#frm_siniestro_seConsidera\").getValue(), '');\n$('#frm_siniestro_seConsidera').setOnchange(checkAfectado);\n\n\nfunction informacionResponsable(newVal, oldVal) {\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_nombreResponsable').show();\n    $('#frm_siniestro_placaResponsable').show();\n    $('#frm_siniestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n//execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"415085889656567afed06d2032347077","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"645403265656567afecf4a1072477475","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"dropdown","variable":"frm_siniestro_seConsidera","var_uid":"936285525657296b26a9091032512157","dataType":"string","protectedValue":false,"id":"frm_siniestro_seConsidera","name":"frm_siniestro_seConsidera","label":"¿A juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"RESPONSABLE","label":"Responsable"},{"value":"AFECTADO","label":"Afectado"}],"var_name":"frm_siniestro_seConsidera","colSpan":6},{"type":"dropdown","variable":"frm_siniestro_informacionResponsable","var_uid":"789423375656567afed6524074308447","dataType":"string","protectedValue":false,"id":"frm_siniestro_informacionResponsable","name":"frm_siniestro_informacionResponsable","label":"¿Tiene información del responsable?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione una ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_siniestro_informacionResponsable","colSpan":6}],[{"type":"text","variable":"frm_siniestro_placaResponsable","var_uid":"457348845656567afedbbf7022772217","dataType":"string","protectedValue":false,"id":"frm_siniestro_placaResponsable","name":"frm_siniestro_placaResponsable","label":"# de Placa del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_placaResponsable","colSpan":6},{"type":"text","variable":"frm_siniestro_nombreResponsable","var_uid":"446114166656567afed7568068426900","dataType":"string","protectedValue":false,"id":"frm_siniestro_nombreResponsable","name":"frm_siniestro_nombreResponsable","label":"Nombre del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_nombreResponsable","colSpan":6}]],"variables":[{"var_uid":"415085889656567afed06d2032347077","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_requiere_PartePolicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"86078996364a5ea3db390b3029062271","var_name_old":"frm_requiere_PartePolicial","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"645403265656567afecf4a1072477475","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_requiere_AsesoriaLegal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"53896923164a5ea52d0b9a2095798782","var_name_old":"frm_requiere_AsesoriaLegal","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"936285525657296b26a9091032512157","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_siniestro_seConsidera","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"3090765516568a718c54789027470935","var_name_old":"frm_siniestro_seConsidera","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"789423375656567afed6524074308447","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_siniestro_informacionResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"806302141653aca7ed3b8b1014028540","var_name_old":"frm_siniestro_informacionResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"457348845656567afedbbf7022772217","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_siniestro_placaResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"917378942653acad9c095c7075960765","var_name_old":"frm_siniestro_placaResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"446114166656567afed7568068426900","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_siniestro_nombreResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"765788563653acae2843f40000288141","var_name_old":"frm_siniestro_nombreResponsable","prj_uid_old":"35087580064a18c9776b638006106795","create":false}]}]}]]></dyn_content>
