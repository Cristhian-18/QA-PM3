(frm_valores_valorAjustado/frm_valores_valorCasco)*100","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valores_porcentajePerdida","colSpan":6},{"type":"text","variable":"frm_valores_valorPerdida","var_uid":"95810868865755edf294231005889914","dataType":"string","protectedValue":false,"id":"frm_valores_valorPerdida","name":"frm_valores_valorPerdida","label":"Valor de perdida para Equisuiza en caso de REPARAR","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"frm_valores_totalParcial","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valores_valorPerdida","colSpan":6}],[{"type":"text","variable":"frm_valores_porcentajePerdidaSalvamento","var_uid":"49504335765755fb2938768068312649","dataType":"string","protectedValue":false,"id":"frm_valores_porcentajePerdidaSalvamento","name":"frm_valores_porcentajePerdidaSalvamento","label":"Valor de pérdida para Equisuiza en caso de pérdida total.","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"frm_valores_valorALiquidar-frm_valores_netoSalvamento","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valores_porcentajePerdidaSalvamento","colSpan":12}],[{"type":"hidden","variable":"frm_valores_valorTotalAsegurado","var_uid":"85818180965751ab106d8d6024707826","dataType":"string","protectedValue":false,"id":"frm_valores_valorTotalAsegurado","name":"frm_valores_valorTotalAsegurado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var