        <dyn_content><![CDATA[{"name":"Documentos del caso _backup","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"8847550356735953b115999056520129","name":"Documentos del caso _backup","description":"","mode":"edit","script":{"type":"js","code":"// Resuelve el bug de que el link de la grilla\n// no funciona al cargar la data desde trigger.\n$(function(){\n  var numero_columna_link = 5;\n\n  for(var i = 1; i<=$(\"#gridDocumentos\").getNumberRows(); i++){\n    /*\n    console.log('****************************');\n    console.log($(\"#gridDocumentos\").getText (i, numero_columna_link));\n    console.log($(\"#gridDocumentos\").getValue(i, numero_columna_link));\n    */\n    \n    var url = $(\"#gridDocumentos\").getValue (i, numero_columna_link);\n    $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n  }\n\n\n  // Cargar documentos\n  $('#historial_comentarios').html( $('#tri_comentarios').getValue() );\n  $('#tabla-comentarios').dataTable({\n    dom: 'Bfrtip',\n    buttons: [\n      'copyHtml5',\n      'excelHtml5',\n      'csvHtml5',\n      'pdfHtml5'\n    ],\n    \"language\": {\n      \"url\": \"/plugin/beesmartec/core_librerias/datatables/spanish.json\"\n    }\n  });\n  \n})\n\n"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Fecha"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Archivo","name":"gridDocumentos_Archivo","label":"Archivo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Archivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Comentario","name":"gridDocumentos_Comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Comentario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Usuario","name":"gridDocumentos_Usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Usuario"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Descarga","name":"gridDocumentos_Descarga","label":"gridDocumentos_Descarga","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"gridDocumentos_Descarga"}],"data":[],"mode":"view","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Documentos del flujo","colSpan":12}]],"variables":[]}]}]]></dyn_content>
