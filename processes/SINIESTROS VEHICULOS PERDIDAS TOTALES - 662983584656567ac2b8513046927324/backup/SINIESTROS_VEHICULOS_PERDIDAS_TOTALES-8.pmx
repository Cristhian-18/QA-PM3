r_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_asegurado","label":"<span class=\"subtitulo\" id=\"isubt_asegurado\" subform=\"142725203656567afcda002050435920\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos del conductor</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"142725203656567afcda002050435920","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"disabled","script":{"type":"js","code":"//henry\nlet tipoSolicitud = $(\"#frm_asegurado_tipo\").getValue();\nif (tipoSolicitud == 'A') {\nlet cedula = $(\"#frm_busqueda_identificacion\").getValue();\nlet nombres = $(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"154742637656567afe4ac98019653199","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"288601393656567afe40b97009928099","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_identificacion","colSpan":4},{"type":"text","variable":"frm_asegurado_nombres","var_uid":"783890959656567afe443b9044414105","dataType":"string","protectedValue":false,"id":"frm_asegurado_nombres","name":"frm_asegurado_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_nombres","colSpan":8}],[{"type":"text","variable":"frm_asegurado_telefono","var_uid":"512089270656567afe49c87064748438","dataType":"string","protectedValue":false,"id":"frm_as