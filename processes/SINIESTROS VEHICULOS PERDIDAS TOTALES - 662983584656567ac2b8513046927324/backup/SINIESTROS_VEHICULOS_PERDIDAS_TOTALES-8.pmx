    <\/span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"><\/i><\/span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3\"><\/div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"><\/i> Mensaje...!<\/h4>\n    <h2><div id=\"html_op\"><\/div><\/h2>\n  <\/div>\n<\/div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"910598028656567aff3c0b6040299221","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"79603397