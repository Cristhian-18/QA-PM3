($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"146427813656567aff315b7098505390","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"7","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"# Parte"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"disabled","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"tit