":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Taller"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_usuario","name":"grd_hs_usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Usuario"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCausa","name":"grd_hs_codCausa","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCobertura","name":"grd_hs_codCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Historial de Siniestros","colSpan":12}]],"variables":[{"var_uid":"426301157656567aff2cda3004650322","prj_uid":"662983584656567ac2b8513046927324","var_name":"grd_historial_siniestros","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_registro","label":"<span class=\"subtitulo\" id=\"isubt_registro\" subform=\"601939553656567afce2703072259389\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nRegistro causa siniestros<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"601939553656567afce2703072259389","name":"SubForm Registro Causa Siniestros","description":"SubForm Registro Causa Siniestros","mode":"disabled","script":{"type":"js","code":"\n\/*console.log($('#grd_registro_siniestro').getValue());\nvar formId = $(\"#form\\\\[grd_s_impValor\\\\]\\\\[2\\\\]\").getControl(); \/\/get Dynaform's ID  \nconsole.log(formId);\nfunction checkGrid(newVal, oldVal) {\n    \/\/$(\"#grd_registro_siniestro\").setValue(\"Mostrar2\", 1, 6);\n    \/\/console.log(\"SHOIW2\")\n    \/\/console.log(newVal);\n}\n\ncheckGrid($(\"#grd_registro_siniestro\").getValue(1, 6), '');\n$('#grd_registro_siniestro').setOnchange(checkGrid);*\/\n\/\/$(\"#frm_informacion_adicional2\").getControl().attr('disabled', true);\n\/\/        $(\"#frm_informacion_adicional2\").getControl().attr('readonly', true);\n\n\nconsole.log($('#grd_registro_siniestro').getControl(1,4));\n\nfunction checkGrid(newVal, oldVal){\n    console.log(newVal);\n    let rowNum = 0;\n    rowNum = $(\"#grd_registro_siniestro\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        console.log($(\"#grd_registro_siniestro\").getControl(i,4));\n        if($(\"#grd_registro_siniestro\").getValue(i,4) == \"SI\"){\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', false);\n        }else{\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', true);\n            $(\"#grd_registro_siniestro\").setValue(\"\",i,6)\n        }\n    }\n}\n\ncheckGrid($(\"#grd_registro_siniestro\").getValue(), '');\n$('#grd_registro_siniestro').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"567859411656567aff30472000486134","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid