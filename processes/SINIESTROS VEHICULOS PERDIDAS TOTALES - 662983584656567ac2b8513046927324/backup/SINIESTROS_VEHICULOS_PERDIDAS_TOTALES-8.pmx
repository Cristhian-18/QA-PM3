        <dyn_content><![CDATA[{"name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"902619888656567afd2f8e1066943177","name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","mode":"edit","script":{"type":"js","code":"\/\/henry"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"VALIDAR INFORMACI\u00d3N DEL SINIESTOR","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    switch (this.id) {\n        case 'solicitud':\n           mostrar_solicitud();\n            break;\n        case 'documentos':\n\t\t\t$(\"#subt_docs\").show();\n            $(\"#375344004656567afcfcd58015574466\").show();\n            break;\n        case 'historial':\n          $(\"#sbt_historial\").show();\n          $(\"#709751460656567afce0474081432341\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#718299480656567afd0c6f5055771758\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#565843896656567afd328b8087596694\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#142725203656567afcda002050435920\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#624298983656567afd15b60051714541\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#601939553656567afce2703072259389\").hide();\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#780469005656567afce66c5098057154\").hide();\n  $(\"#sub_valores\").hide();\n  $(\"#527111746656567afd266e9046897016\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#375344004656567afcfcd58015574466\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#709751460656567afce0474081432341\").hide();\n}\nfunction mostrar_solicitud(){\n  $(\"#sub_busqueda\").show();\n  $(\"#718299480656567afd0c6f5055771758\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#565843896656567afd328b8087596694\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#142725203656567afcda002050435920\").show();\n  $(\"#subt_detalle\").show();\n  $(\"#624298983656567afd15b60051714541\").show();\n  $(\"#subt_registro\").show();\n  $(\"#601939553656567afce2703072259389\").show();\n  $(\"#subt_ve_afectados\").show();\n  $(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#sub_docs\").show();\n  $(\"#780469005656567afce66c5098057154\").show();\n  $(\"#sub_valores\").show();\n  $(\"#527111746656567afd266e9046897016\").show();\n}\n\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud<\/h4><\/a><\/li> \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos<\/h4><\/a><\/li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"sub_busqueda","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"718299480656567afd0c6f5055771758\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos asegurado<\/span>","ariaLabel":"","colSpan":1