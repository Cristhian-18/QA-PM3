        <dyn_content><![CDATA[{"name":"Form 5.2 Reparación con Alcance","description":"Form 5.2 Reparación con Alcance","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"968155753656567afd27945012130878","name":"Form 5.2 Reparación con Alcance","description":"Form 5.2 Reparación con Alcance","mode":"edit","script":{"type":"js","code":"$(\"#frm_documentos_check\").disableValidation();\n$('#fle_matricula').disableValidation();\n$('#fle_cedula').disableValidation();\n$('#fle_licencia').disableValidation();\n$('#fle_denuncia').disableValidation();\n$('#fle_partePolicial').disableValidation();\n\nlet pest = '';\nlet taller = $(\"#frm_taller\").getValue();\nlet tipo_taller = $(\"#frm_taller_tipo\").getValue();\n\n$(\"#btn_anadir\").find(\"button\").click(function () {\n  $('#grd_valores_siniestros').addRow();\n  console.log(\"AÑADIR\")\n  console.log(\"rowsNum: \" + rowsNum);\n  let newRowsNum = $(\"#grd_valores_siniestros\").getNumberRows();\n  console.log(\"NewRowsNum: \" + newRowsNum);\n  for (let i = rowsNum + 1; i <= newRowsNum; i++) {\n    $(\"#grd_valores_siniestros\").setValue(\"DISPONIBLE\", i, 6);\n\n    for (let j = 1; j <= 9; j++) {\n      if (j < 4) {\n        $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', false);\n      } else {\n        $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n      }\n\n    }\n  }\n});\n\nfunction checkRepuestos(){\n  let numberRows = $(\"#grd_valores_siniestros\").getNumberRows();\n  console.log(numberRows);\n  let valorSuma = 0;\n  \n  for (let i = 1; i <= numberRows; i++) {\n      $(\"#grd_valores_siniestros\").setValue(\"Aprobado\", i, 9);\n      //$(\"#grd_valores_siniestros\").getControl(i, 9).attr('disabled', true);\n      valorSuma = valorSuma +  parseInt($(\"#grd_valores_siniestros\").getValue(i, 4));\n  }\n  if(valorSuma==0){\n  \n  } else {\n   \n  }\n}\n\n\nlet rowsNum = $(\"#grd_valores_siniestros\").getNumberRows();\n\nfor (let i = 1; i <= rowsNum; i++) {\n  for (let j = 1; j <= 11; j++) {\n    if (j != 10 && j != 9) {\n      $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n    }\n  }\n}\n\n\nfunction action(newVal, oldVal) {\n  $('#frm_comentario_aux').hide();\n  $('#frm_comentario_aux').disableValidation();\n  $('#frm_comentario').hide();\n  $('#frm_comentario').disableValidation();\n  $('#frm_comentario').getControl().attr('disabled', false);\n  $('#757847265656567afcfbc37043953030').hide();\n  $('#692779228656567afcf3ac6024140413').hide();\n  $('#frm_alcance_adicional').hide();\n  $('#frm_alcance_adicional').disableValidation();\n\n  if (newVal == \"SOLICITAR\") {\n    $('#frm_comentario_aux').show();\n    $('#frm_comentario_aux').enableValidation();\n    if(taller == \"MUNDO MOTRIZ\" || tipo_taller == \"TALLER AUTORIZADO MULTIMARCA\"){\n      if(pest == 'repuestos'){\n        $('#757847265656567afcfbc37043953030').show();\n        }\n      }\n    \n    if(taller == \"MUNDO MOTRIZ\"){\n      $('#frm_alcanceAdicional_valorRepuestos').getControl().attr('disabled', true);\n    } else if(tipo_taller == \"TALLER AUTORIZADO MULTIMARCA\") {\n      $('#frm_alcanceAdicional_valorRepuestos').getControl().attr('disabled', true);\n    } \n    else{\n      $('#frm_alcanceAdicional_valorMano').getControl().attr('disabled', false);\n\n      $('#frm_alcanceAdicional_valorRepuestos').getControl().attr('disabled', false);\n    }\n    $('#692779228656567afcf3ac6024140413').show();\n    $('#frm_alcance_adicional').show();\n    $('#frm_alcance_adicional').enableValidation();\n\n  }\n  if (newVal == \"REGISTRAR\") {\n    $('#frm_comentario').show();\n    $('#frm_comentario').enableValidation();\n    $('#frm_comentario').setValue(\"\");\n  }\n  if (newVal == \"CONTINUAR\") {\n    $('#frm_comentario_aux').show();\n    $('#frm_comentario_aux').enableValidation();\n    $(\"#970120515656567afd31875022633165\").show();\n    $(\"#462350562656567afd04c63077818887\").show();\n  }\n  if (newVal == \"REPUESTOS\") {\n    $('#frm_comentario_aux').show();\n    $('#frm_comentario_aux').enableValidation();\n  }\n  if (newVal == \"DISCREPANCIA\") {\n    $('#frm_comentario_aux').show();\n    $('#frm_comentario_aux').enableValidation();\n  }\n}\n\naction($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(action);\n\n\n$('.menu').on('click', function () {\n  pest = this.id;\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#375344004656567afcfcd58015574466\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#709751460656567afce0474081432341\").show();\n      break;\n    case 'repuestos':\n      if(taller == \"MUNDO MOTRIZ\" || tipo_taller == \"TALLER AUTORIZADO MULTIMARCA\"){\n      $(\"#sub_repuestos\").show();\n      $(\"#480602794656567afd00279083326971\").show();\n      }\n      $(\"#sub_valores_aprobados\").show();\n      $(\"#991013308656567afcf8d28052513130\").show();\n      if ($(\"#frm_accion\").getValue() == \"SOLICITAR\") {\n        $('#757847265656567afcfbc37043953030').show();    \n      }\n      checkRepuestos();\n      break;\n  }\n  action($(\"#frm_accion\").getValue(), '');\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#btn_anadir\").hide();\n  $(\"#757847265656567afcfbc37043953030\").hide();\n  $(\"#384439457656567afceab65011611057\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#614037051656567afd2d975045685007\").hide();\n  $(\"#756477459656567afd1cfb3086270388\").hide();\n  $(\"#subt_tallerAsignado\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#282239801656567afd29986025672858\").hide();\n  $(\"#subt_accesoriosRegistrados\").hide();\n  $(\"#388204042656567afd22313001660735\").hide();\n  $(\"#subt_accidente\").hide();\n  $(\"#560832659656567afcf4d25066588147\").hide();\n  $(\"#735645906656567afd0e8b4088103117\").hide();\n  $(\"#sub_busqueda\").hide();\n  $(\"#718299480656567afd0c6f5055771758\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#565843896656567afd328b8087596694\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#142725203656567afcda002050435920\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#624298983656567afd15b60051714541\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#601939553656567afce2703072259389\").hide();\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#780469005656567afce66c5098057154\").hide();\n  $(\"#sub_valores\").hide();\n  $(\"#527111746656567afd266e9046897016\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#375344004656567afcfcd58015574466\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#709751460656567afce0474081432341\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#970216769656567afcd3ed7021146455\").hide();\n  $(\"#sub_repuestos\").hide();\n  $(\"#480602794656567afd00279083326971\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#582336739656567afcd7d26036202949\").hide();\n  $(\"#sub_valores_aprobados\").hide();\n  $(\"#991013308656567afcf8d28052513130\").hide();\n  $(\"#970120515656567afd31875022633165\").hide();\n  $(\"#462350562656567afd04c63077818887\").hide();\n  \n  \n\n}\nfunction mostrar_solicitud() {\n\n  $(\"#subt_friss\").show();\n  $(\"#614037051656567afd2d975045685007\").show();\n  $(\"#756477459656567afd1cfb3086270388\").show();\n  $(\"#subt_tallerAsignado\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#282239801656567afd29986025672858\").show();\n  $(\"#subt_accesoriosRegistrados\").show();\n  $(\"#388204042656567afd22313001660735\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#560832659656567afcf4d25066588147\").show();\n\n  $(\"#sub_busqueda\").show();\n  $(\"#718299480656567afd0c6f5055771758\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#565843896656567afd328b8087596694\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#142725203656567afcda002050435920\").show();\n  $(\"#subt_detalle\").show();\n  $(\"#624298983656567afd15b60051714541\").show();\n  $(\"#subt_registro\").show();\n  $(\"#601939553656567afce2703072259389\").show();\n  $(\"#subt_ve_afectados\").show();\n  $(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#sub_docs\").show();\n  $(\"#780469005656567afce66c5098057154\").show();\n  $(\"#sub_valores\").show();\n  $(\"#527111746656567afd266e9046897016\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#970216769656567afcd3ed7021146455\").show();\n  $(\"#subt_historial_siniestro\").show();\n  $(\"#582336739656567afcd7d26036202949\").show();\n\n}\n\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACIÓN SINIESTROS VEHÍCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"194041199656567afd0d748058557093","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"910598028656567aff3c0b6040299221","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"796033972656567aff3fa12092643747","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"230198180656567aff40ae0087816431","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"22541636561df31c8065066073006658","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_id_stro","var_field_type":"string",