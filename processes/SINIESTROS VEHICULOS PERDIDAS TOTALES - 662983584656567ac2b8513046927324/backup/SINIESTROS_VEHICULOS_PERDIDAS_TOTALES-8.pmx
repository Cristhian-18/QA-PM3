</td>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"> <b>&nbsp;@#frm_poliza_numero</b> </font></p>
</td>
</tr>
<tr>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"><b>Asegurado:</b></font></p>
</td>
<td width="80%" valign="top">
<p align="justify"><font size="1" color="#001815"> <b>&nbsp;@#frm_busqueda_nombres</b> </font></p>
</td>
<td valign="top" colspan="2">
<p align="center"><font size="1" color="#001815"><b>&nbsp;</b></font></p>
</td>
</tr>
<tr>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"><b>Direcci&oacute;n:</b></font></p>
</td>
<td width="80%" valign="top">
<p align="justify"><font size="1" color="#001815"> <b>&nbsp;@#frm_siniestro_direccion</b> </font></p>
</td>
<td valign="top" colspan="2">
<p align="center"><font size="1" color="#001815"><b>&nbsp;</b></font></p>
</td>
</tr>
<tr>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"><b>Broker:</b></font></p>
</td>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"> <b>&nbsp;@#frm_busqueda_datosBroker</b> </font></p>
