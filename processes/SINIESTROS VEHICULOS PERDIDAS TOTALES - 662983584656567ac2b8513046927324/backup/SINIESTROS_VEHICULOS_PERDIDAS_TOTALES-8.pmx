<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"> <b>&nbsp;@#frm_vehiculo_color</b> </font></p>
</td>
</tr>
<tr>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"><b>Placa:</b></font></p>
</td>
<td width="20%" valign="top">
