        <out_doc_template><![CDATA[<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
  <head>
  <style type="text/css">
    body {
      font-family: Arial, Helvetica, sans-serif;
    }
</style></head>

  <body>
<table border="0" cellspacing="0" cellpadding="0" style="width: 100%;">
<tbody>
<tr>
<td width="100%" colspan="4" valign="top"><img src="https://imagenesweb.equisuiza.com/imagenesweb/Generales/BPM%20siniestros%20VH%20y%20Generales/SINIESTROS%20VEHICULOS%20PERDIDAS%20PARCIALES/Salidas/links/logo2.png" class="img-responsive" alt="equisuiza" /></td>
</tr>
<tr>
<td width="100%" colspan="4" valign="top">
<p align="center"><font size="1" color="#00493c"> <b>DECLARACI&Oacute;N DE ACCIDENTES DE VEH&Iacute;CULOS</b> </font></p>
</td>
</tr>
<tr>
<td width="100%" colspan="4" valign="top">&nbsp;</td>
</tr>
<tr style="background-color: #00493c;">
<td width="100%" colspan="4" valign="middle">
<p align="center"><font size="1" color="#FFFFFF"><b>DATOS DEL CONTRATANTE</b></font></p>
</td>
</tr>
<tr>
