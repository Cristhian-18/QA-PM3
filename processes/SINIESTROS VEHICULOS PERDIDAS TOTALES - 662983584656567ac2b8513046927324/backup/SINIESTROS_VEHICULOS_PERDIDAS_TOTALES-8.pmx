        <dyn_content><![CDATA[{"name":"Form 7 Adjunte el finiquito","description":"Form 7 Adjunte el finiquito","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"735309518656567afcd5862034981665","name":"Form 7 Adjunte el finiquito","description":"Form 7 Adjunte el finiquito","mode":"edit","script":{"type":"js","code":"$(\"#repuestos\").hide();\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACI\u00d3N SINIESTROS VEH\u00cdCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'documentos':\n            $(\"#subt_docs\").show();\n            $(\"#375344004656567afcfcd58015574466\").show();\n            break;\n        case 'repuestos':\n            $(\"#subt_docs\").show();\n            $(\"#375344004656567afcfcd58015574466\").show();\n            break;\n        case 'historial':\n            $(\"#sbt_historial\").show();\n            $(\"#709751460656567afce0474081432341\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n    $(\"#sub_busqueda\").hide();\n    $(\"#718299480656567afd0c6f5055771758\").hide();\n    $(\"#subt_vehiculo\").hide();\n    $(\"#565843896656567afd328b8087596694\").hide();\n    $(\"#subt_asegurado\").hide();\n    $(\"#142725203656567afcda002050435920\").hide();\n    $(\"#subt_detalle\").hide();\n    $(\"#624298983656567afd15b60051714541\").hide();\n    $(\"#subt_registro\").hide();\n    $(\"#601939553656567afce2703072259389\").hide();\n    $(\"#subt_gestionTaller\").hide();\n    $(\"#852122295656567afd17d71016531757\").hide(