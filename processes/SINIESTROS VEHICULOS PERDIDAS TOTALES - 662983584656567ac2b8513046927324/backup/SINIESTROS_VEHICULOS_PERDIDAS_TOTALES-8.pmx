        <dyn_content><![CDATA[{"name":"Form 1.2 Caso sin reserva","description":"Form 1.2 Caso sin reserva","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"40479809565c30b5150b443052311029","name":"Form 1.2 Caso sin reserva","description":"Form 1.2 Caso sin reserva","mode":"edit","script":{"type":"js","code":"$(\"#453626638656567afd038d0078120145\").hide();\n$(\"#frm_solicitarPeritaje_causa\").disableValidation();\n$(\"#frm_solicitarPeritaje_nombre\").disableValidation();\n$(\"#frm_solicitarPeritaje_correo\").disableValidation();\n$(\"#frm_solicitarPeritaje_fechaEntrega\").disableValidation();\n$(\"#file_poliza\").disableValidation();\n$(\"#file_documentoOpcional\").hide();\n$(\"#frm_siniestro_detalle\").disableValidation();\n\n\nfunction action(newVal, oldVal) {\n    $(\"#453626638656567afd038d0078120145\").hide();\n    $(\"#frm_solicitarPeritaje_causa\").disableValidation();\n    $(\"#frm_solicitarPeritaje_nombre\").disableValidation();\n    $(\"#frm_solicitarPeritaje_correo\").disableValidation();\n    $(\"#frm_solicitarPeritaje_fechaEntrega\").disableValidation();\n    $(\"#file_poliza\").disableValidation();\n    $(\"#file_documentoOpcional\").hide();\n    $(\"#frm_checkbox_documentos\").disableValidation();\n    $(\"#frm_checkbox_documentos\").hide();\n    $(\"#frm_documentos_check\").disableValidation();\n    $(\"#413499516656567afcedb62004747135\").hide();\n\n\n\n    if (newVal == 'CONTINUAR') {\n        $(\"#frm_checkbox_documentos\").enableValidation();\n        $(\"#frm_checkbox_documentos\").show();\n        $(\"#frm_documentos_check\").enableValidation();\n\n    }\n\n    if (newVal == 'PERITO') {\n        $(\"#453626638656567afd038d0078120145\").show();\n        $(\"#frm_solicitarPeritaje_causa\").enableValidation();\n        $(\"#frm_solicitarPeritaje_nombre\").enableValidation();\n        $(\"#frm_solicitarPeritaje_correo\").enableValidation();\n        $(\"#frm_solicitarPeritaje_fechaEntrega\").enableValidation();\n        $(\"#file_poliza\").enableValidation();\n    }\n    if (newVal == 'SOLICITAR') {\n        $(\"#file_documentoOpcional\").show();\n    }\n    if (newVal == 'RECHAZAR') {\n        $(\"#413499516656567afcedb62004747135\").show();\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(action);\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'repuestos':\n            $(\"#sub_taller\").show();\n            $(\"#489756561656567afcf5da3068863338\").show();\n            $(\"#852122295656567afd17d71016531757\").show();\n\n            $(\"#480602794656567afd00279083326971\").show();\n            $(\"#sub_gestionrepuestos\").show();\n            $(\"#sub_valores_siniestros\").show();\n            $(\"#899876897656567afce9ba0097496292\").show();\n            break;\n        case 'documentos':\n            $(\"#sub_documentos_caso\").show();\n            $(\"#375344004656567afcfcd58015574466\").show();\n            break;\n        case 'historial':\n            $(\"#sub_historial_caso\").show();\n            $(\"#709751460656567afce0474081432341\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n\n    $(\"#614037051656567afd2d975045685007\").hide();\n\n    $(\"#subt_poliza\").hide();\n    $(\"#970216769656567afcd3ed7021146455\").hide();\n    $(\"#sub_busqueda\").hide();\n    $(\"#718299480656567afd0c6f5055771758\").hide();\n    $(\"#subt_registro\").hide();\n    $(\"#601939553656567afce2703072259389\").hide();\n    $(\"#subt_dvehiculo\").hide();\n    $(\"#702321057656567afd0b5f8055682937\").hide();\n    $(\"#subt_ppolicial\").hide();\n    $(\"#282239801656567afd29986025672858\").hide();\n    $(\"#subt_asegurado\").hide();\n    $(\"#142725203656567afcda002050435920\").hide();\n    $(\"#subt_accidente\").hide();\n    $(\"#560832659656567afcf4d25066588147\").hide();\n    $(\"#subt_danios\").hide();\n    $(\"#624298983656567afd15b60051714541\").hide();\n    $(\"#subt_ve_afectados\").hide();\n    $(\"#831468248656567afce7676060479058\").hide();\n\n    $(\"#isubt_pe_afectados\").hide();\n    $(\"#516059836656567afd10a48026370985\").hide();\n    $(\"#iisubt_pr_afectados\").hide();\n    $(\"#976441291656567afd2a935002448351\").hide();\n    $(\"#sub_taller\").hide();\n    $(\"#489756561656567afcf5da3068863338\").hide();\n    $(\"#852122295656567afd17d71016531757\").hide();\n\n\n    $(\"#sub_accesorios\").hide();\n    $(\"#388204042656567afd22313001660735\").hide();\n    $(\"#subt_historial\").hide();\n    $(\"#582336739656567afcd7d26036202949\").hide();\n    $(\"#sub_docs\").hide();\n    $(\"#780469005656567afce66c5098057154\").hide();\n    $(\"#852122295656567afd17d71016531757\").hide();\n\n    $(\"#sub_historial_caso\").hide();\n    $(\"#709751460656567afce0474081432341\").hide();\n    $(\"#sub_documentos_caso\").hide();\n    $(\"#375344004656567afcfcd58015574466\").hide();\n\n\n\n    $(\"#480602794656567afd00279083326971\").hide();\n    $(\"#sub_gestionrepuestos\").hide();\n    $(\"#sub_valores_siniestros\").hide();\n    $(\"#899876897656567afce9ba0097496292\").hide();\n\n\n}\nfunction mostrar_solicitud() {\n    $(\"#614037051656567afd2d975045685007\").show();\n\n    $(\"#subt_poliza\").show();\n    $(\"#970216769656567afcd3ed7021146455\").show();\n    $(\"#sub_busqueda\").show();\n    $(\"#718299480656567afd0c6f5055771758\").show();\n    $(\"#subt_registro\").show();\n    $(\"#601939553656567afce2703072259389\").show();\n    $(\"#subt_dvehiculo\").show();\n    $(\"#702321057656567afd0b5f8055682937\").show();\n    $(\"#subt_ppolicial\").show();\n    $(\"#282239801656567afd29986025672858\").show();\n    $(\"#subt_asegurado\").show();\n    $(\"#142725203656567afcda002050435920\").show();\n    $(\"#subt_accidente\").show();\n    $(\"#560832659656567afcf4d25066588147\").show();\n    $(\"#subt_danios\").show();\n    $(\"#624298983656567afd15b60051714541\").show();\n    $(\"#subt_ve_afectados\").show();\n    $(\"#831468248656567afce7676060479058\").show();\n\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#516059836656567afd10a48026370985\").show();\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#976441291656567afd2a935002448351\").show();\n\n\n\n    $(\"#sub_accesorios\").show();\n    $(\"#388204042656567afd22313001660735\").show();\n    $(\"#subt_historial\").show();\n    $(\"#582336739656567afcd7d26036202949\").show();\n    $(\"#sub_docs\").show();\n    $(\"#780469005656567afce66c5098057154\").show();\n   /* checkVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), '');\n    $('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n    checkPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), '');\n    $('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\n    checkPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), '');\n    $('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes*/\n\n}\n\nfunction checkAccion(newVal, oldVal) {\n  $(\"#frm_id_pv\").hide();\n  $(\"#frm_id_pv\").disableValidation();\n  $(\"#nro_inspeccion\").hide();\n  $(\"#nro_inspeccion\").disableValidation();\n  $(\"#id_stro_insp\").hide();\n  $(\"#id_stro_insp\").disableValidation();\n  $(\"#frm_valor_insurance\").hide();\n\n  \n  if (newVal == 'CONTINUAR' || newVal == 'EQUISUIZA') {\n    $(\"#nro_inspeccion\").show();\n  $(\"#nro_inspeccion\").enableValidation();\n  $(\"#id_stro_insp\").show();\n  $(\"#id_stro_insp\").enableValidation();\n  $(\"#frm_valor_insurance\").show();\n\n  }\n  \n   if(newVal == 'EQUISUIZA'){\n      var origen_actual =  $(\"#frm_origen_core_insurance\").getValue();\n    \n    \n    if(origen_actual==\"\"){\n    $(\"#frm_origen_core_insurance\").setValue('INSURANCE');\n    }\n  }\n  \n  \n  if (newVal == 'MANUAL') {\n    \n\n  }\n  if (newVal == 'RECHAZAR') {\n    \n\n  }\n  if (newVal == 'VOLVER') {\n      $(\"#frm_id_pv\").show();\n      $(\"#frm_id_pv\").enableValidation();\n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion_2\").getValue(), '');\n$('#frm_accion_2').setOnchange(checkAccion);\n\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"DECLARACIÓN DE ACCIDENTES DE VEHÍCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"let app_padre = $(\"#app_padre\").getValue();\n\nif(app_padre == '' || app_padre == null){\n  $('#repuestos').hide();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Taller</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"app_padre","var_uid":"603372399657a8bcc3d3ee2006491156","dataType":"string","protectedValue":false,"id":"app_padre","name":"app_padre","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"app_padre","colSpan":12}]],"variables":[{"var_uid":"603372399657a8bcc3d3ee2006491156","prj_uid":"662983584656567ac2b8513046927324","var_name":"app_padre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"text","variable":"message","var_uid":"8385732576660e0ee415381023311465","dataType":"string","protectedValue":false,"id":"message","name":"message","label":"Mensaje de error","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"message","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"614037051656567afd2d975045685007","name":"SubForm Datos Friss","description":"SubForm Datos Friss","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_friss_score","var_uid":"155812011656567afeb4ac6040380453","dataType":"string","protectedValue":false,"id":"frm_friss_score","name":"frm_friss_score","label":"Scoring","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_friss_score","colSpan":6},{"colSpan":6}],[{"type":"grid","variable":"frm_friss_grid","var_uid":"309386508656567afeb1470042372622","dataType":"grid","protectedValue":false,"id":"frm_friss_grid","name":"frm_friss_grid","label":"Detalle Friss","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_friss_fecha","name":"frm_friss_fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Fecha","var_name":"frm_friss_grid"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_friss_name","name":"frm_friss_name","label":"Motivo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"35","width":100,"title":"Motivo"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_friss_value","name":"frm_friss_value","label":"Valor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Valor"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_friss_argumentation","name":"frm_friss_argumentation","label":"Detalle","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"35","width":100,"title":"Detalle"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"Detalle Friss","colSpan":12}]],"variables":[{"var_uid":"155812011656567afeb4ac6040380453","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_friss_score","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"309386508656567afeb1470042372622","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_friss_grid","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_datosSin","label":"Datos del siniestro\n","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"560832659656567afcf4d25066588147","name":"SubForm Datos Accidente","description":"SubForm Datos Accidente","mode":"disabled","script":{"type":"js","code":"//PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_provincias',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'provincia'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_provincia').getControl().empty();\n    $('#frm_accidente_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_pais\").getValue() == '') {\n  checkProvincia($(\"#frm_accidente_pais\").getValue(), '');\n} \n*/\n$('#frm_accidente_pais').setOnchange(checkProvincia); //execute when field's value changes\n\n//CANTON\nfunction checkCanton(newVal, oldVal) {\nvar frm_dato = $(\"#frm_accidente_pais\").getValue();\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_cantones',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'canton'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_provincia\").getValue() != '') {\n  checkCanton($(\"#frm_accidente_provincia\").getValue(), '');\n} \n*/\n$('#frm_accidente_provincia').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  /*console.log(\"BANDERA CAMBIO: \" + newVal);\n$(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n$(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n$(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n$(\"#frm_taller_ciudad\").setValue(\"Q\");\n$(\"#frm_taller_prioridad\").setValue(\"1\");\n$(\"#frm_taller_capacidad\").setValue(\"20\");\n$(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n$(\"#frm_taller_saldo\").setValue(\"15\");\n$(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n$(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n$(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");*/\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#subt_ve_afectados\").show();\n      $(\"#831468248656567afce7676060479058\").show();\n  } else {\n     $(\"#subt_ve_afectados\").hide();\n      $(\"#831468248656567afce7676060479058\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#iisubt_pr_afectados\").show();\n      $(\"#976441291656567afd2a935002448351\").show();\n  } else {\n     $(\"#iisubt_pr_afectados\").hide();\n      $(\"#976441291656567afd2a935002448351\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#isubt_pe_afectados\").show();\n      $(\"#516059836656567afd10a48026370985\").show();\n  } else {\n     $(\"#isubt_pe_afectados\").hide();\n      $(\"#516059836656567afd10a48026370985\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accidente_pais","var_uid":"828690795656567afe27978052201248","dataType":"string","protectedValue":false,"id":"frm_accidente_pais","name":"frm_accidente_pais","label":"Pais","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtapais","options":[],"var_name":"frm_accidente_pais","colSpan":4},{"type":"dropdown","variable":"frm_accidente_provincia","var_uid":"213150583656567afe28bc0038295549","dataType":"string","protectedValue":false,"id":"frm_accidente_provincia","name":"frm_accidente_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaprov","options":[],"var_name":"frm_accidente_provincia","colSpan":4},{"type":"dropdown","variable":"frm_acc