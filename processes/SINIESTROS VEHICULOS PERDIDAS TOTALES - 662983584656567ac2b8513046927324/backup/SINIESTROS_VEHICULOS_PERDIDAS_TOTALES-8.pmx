seStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"columnWidth":"20","width":100,"title":"Fecha de Fin"},{"type":"multipleFile","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"documentos_respaldo","name":"documentos_respaldo","label":"Documentos de respaldo","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_taller","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"735963536656567afd37dd5006177754","columnWidth":"30","width":100,"title":"Documentos de respaldo"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":false,"title":"Registro IMVEC","colSpan":12}]],"variables":[{"var_uid":"772403700657619d6c11497047946718","prj_uid":"662983584656567ac2b8513046927324","var_name":"grd_registro_INVEC","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
