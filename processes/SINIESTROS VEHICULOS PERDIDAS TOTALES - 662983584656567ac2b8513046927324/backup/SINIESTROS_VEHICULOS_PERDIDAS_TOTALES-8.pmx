        <dyn_content><![CDATA[{"name":"Form 3 Generar Cotización","description":"Form 3 Generar Cotización","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"921674946656567afcd21e5051612453","name":"Form 3 Generar Cotización","description":"Form 3 Generar Cotización","mode":"edit","script":{"type":"js","code":"$(\"#grd_valores_siniestros\").hideColumn(11);\n$(\"#grd_valores_siniestros\").hideColumn(9);\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#375344004656567afcfcd58015574466').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#709751460656567afce0474081432341').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $('#384439457656567afceab65011611057').show()\n        $('#480602794656567afd00279083326971').show()\n        $('#subt_documentos_cotizacion').show()\n        $('#337640582656567afd2b933075407212').show()\n        \n        \n        break\n    }\n  })\n  \n  function ocultar_todo() {\n    $('#subt_friss').hide()\n    $('#614037051656567afd2d975045685007').hide()\n    $('#756477459656567afd1cfb3086270388').hide()\n    $('#subt_tallerAsignado').hide()\n    $('#subt_ppolicial').hide()\n    $('#282239801656567afd29986025672858').hide()\n    $('#subt_accesoriosRegistrados').hide()\n    $('#388204042656567afd22313001660735').hide()\n    $('#subt_accidente').hide()\n    $('#560832659656567afcf4d25066588147').hide()\n    $('#735645906656567afd0e8b4088103117').hide()\n    $('#sub_busqueda').hide()\n    $('#718299480656567afd0c6f5055771758').hide()\n    $('#subt_vehiculo').hide()\n    $('#565843896656567afd328b8087596694').hide()\n    $('#subt_asegurado').hide()\n    $('#142725203656567afcda002050435920').hide()\n    $('#subt_deta