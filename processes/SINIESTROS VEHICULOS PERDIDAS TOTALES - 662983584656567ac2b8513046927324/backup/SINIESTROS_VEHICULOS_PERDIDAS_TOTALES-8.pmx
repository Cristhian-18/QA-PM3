").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n\/\/execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"154742637656567afe4ac98019653199","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"288601393656567afe40b97009928099","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnect