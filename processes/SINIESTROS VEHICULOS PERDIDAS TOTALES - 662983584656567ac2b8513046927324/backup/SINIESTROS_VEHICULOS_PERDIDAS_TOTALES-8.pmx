vil)"},{"value":"6","label":"Proforma de reparación o reemplazo de las partes afectadas (total de mano de obra u repuestos)"},{"value":"7","label":"Original de las facturas proforma, a nombre de Seguros Equinoccial S. A"},{"value":"8","label":"Contrato de compraventa firmado en el anverso y el reverso, según formato entregado por la Compañía (pérdida total)"},{"value":"9","label":"Matrícula original actualizada (o cubrir costos de la misma en caso de pérdida total)"},{"value":"10","label":"Certificados de Policía de no gravamen (pérdida total)"},{"value":"11","label":"Copias a color de cédula de identidad y certificado de votación del propietario del vehículo y del cónyuge"},{"value":"12","label":"Historia de dominio emitida por la autoridad de tránsito competente"},{"value":"13","label":"Llaves del vehículo y duplicados (pérdida total)"},{"value":"14","label":"Denuncias originales de Policía Judicial, autoridad de tránsito competente (Comisión de Tránsito del Guayas o Dirección Nacional de Tránsito) y fiscalía (pérdida total)"},{"value":"15","label":"Informe final de la Policía Judicial y Autoridad de Tránsito competente después de transcurridos cuarenta y cinco (45) días de la fecha de robo (Comisión de Transito del Guayas"},{"value":"16","label":"Sentencia Judicial ejecutoriada demostrando la responsabilidad del Asegurado y el monto de los perjuicios sufridos por el tercero o terceros afectados (responsabilidad civil)"},{"value":"17","label":"Facturas de los gastos médicos incurridos (gastos médicos y responsabilidad civil)."},{"value":"18","label":"Certificado médico del profesional que atendió al accidentado (gastos médicos y responsabilidad civil por lesiones)"},{"value":"19","label":"Historia clínica en caso de ser necesaria (gastos médicos y responsabilidad civil por lesiones)"},{"value":"20","label":"Original y copia de la cédula del afectado (gastos médicos y responsabilidad civil por lesiones)"},{"value":"21","label":"Certificado de autopsia (Muerte accidental y responsabilidad civil por muerte)."},{"value":"22","label":"Levantamiento del cadáver (Muerte accidental y responsabilidad civil por muerte)."},{"value":"23","label":"Certificado de defunción (Muerte accidental y responsabilidad civil por muerte)."},{"value":"24","label":"Original y copia de la cédula del fallecido (Muerte accidental y responsabilidad civil por muerte)."},{"value":"25","label":"Original y copia de la cédula de los beneficiarios legales (Muerte accidental y responsabilidad civil por muerte)."},{"value":"26","label":"Posesión efectiva de bienes (Muerte accidental y responsabilidad civil por muerte)"},{"value":"OTROS","label":"Otros"}],"var_name":"frm_emisionNegativa_nombreUltimoDoc","colSpan":6},{"type":"multipleFile","variable":"frm_emisionNegativa_textoPoliza","var_uid":"960038778656567afeac8e8014685115","dataType":"multiplefile","protectedValue":false,"id":"frm_emisionNegativa_textoPoliza","name":"frm_emisionNegativa_textoPoliza","label":"Texto en Póliza","tabIndex":"","ariaLabel":"","inputDocument":"","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*","size":1024,"sizeUnity":"KB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"","var_name":"frm_emisionNegativa_textoPoliza","colSpan":6}],[{"type":"text","variable":"frm_emisionNegativa_nombreUltimoDoc2","var_uid":"795634682656567afeab894022075867","dataType":"string","protectedValue":false,"id":"frm_emisionNegativa_nombreUltimoDoc2","name":"frm_emisionNegativa_nombreUltimoDoc2","label":"Detalle otros documentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_emisionNegativ