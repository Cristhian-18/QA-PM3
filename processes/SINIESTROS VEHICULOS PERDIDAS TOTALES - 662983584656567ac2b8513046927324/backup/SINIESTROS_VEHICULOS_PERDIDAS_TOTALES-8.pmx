r_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"290855849656567afedd283072881991","var_name_old":"frm_siniestro_Propiedad","prj_uid_old":"662983584656567ac2b8513046927324"},{"var_uid":"406187946656567afeda1a5037238990","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_siniestro_Personas","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"406187946656567afeda1a5037238990","var_name_old":"frm_siniestro_Personas","prj_uid_old":"662983584656567ac2b8513046927324"}],"colSpan":12}],[{"type":"subtitle","id":"subt_ppolicial","label":"<span class=\"subtitulo\" id=\"isubt_ppolicial\" subform=\"282239801656567afd29986025672858\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nParte Policial<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"282239801656567afd29986025672858","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"disabled","script":{"type":"js","code":"\nfunction asesoriaLegal(newVal, oldVal) {\n\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_informacionResponsable').show();\n    $('#frm_siniestro_informacionResponsable').enableValidation();\n  } else {\n    $('#frm_siniestro_informacionResponsable').setValue(\"\");\n  }\n}\n\n\/\/execute when the Dynaform loads:\nasesoriaLegal($(\"#frm_requiere_AsesoriaLegal\").getValue(), '');\n$('#frm_requiere_AsesoriaLegal').setOnchange(asesoriaLegal);\n\n\nfunction informacionResponsable(newVal, oldVal) {\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'SI') {\n    $('#frm_siniestro_nombreResponsable').show();\n    $('#frm_siniestro_placaResponsable').show();\n    $('#frm_siniestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n\/\/execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"415085889656567afed06d2032347077","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"645403265656567afecf4a1072477475","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","dataso