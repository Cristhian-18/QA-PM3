        <dyn_content><![CDATA[{"name":"SubForm Valores Siniestro","description":"SubForm Valores Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"899876897656567afce9ba0097496292","name":"SubForm Valores Siniestro","description":"SubForm Valores Siniestro","mode":"edit","script":{"type":"js","code":"$(\"#frm_valoresSiniestro_procentajeDescuentoProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100;\n  let min = 0;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_procentajeDescuentoProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_valoresRepuestos1\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_valoresRepuestos1\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_valorRepuestosProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_valorRepuestosProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_manoObraProformada\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_totalProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setValue(value);\n})\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"424458395656567aff14668091129194","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado","var_uid":"544224098656567aff11647035831282","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_procentajeDescuentoProformado","name":"frm_valoresSiniestro_procentajeDescuentoProformado","label":"Procentaje Descuento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_procentajeDescuentoProformado","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_valorRepuestosProformado","var_uid":"428776879656567aff17405051890302","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valorRepuestosProformado","name":"frm_valoresSiniestro_valorRepuestosProformado","label":"Valor Repuestos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"frm_valoresSiniestro_valoresRepuestos1*(1-frm_valoresSiniestro_procentajeDescuentoProformado/100)","mode":"parent","operation":"","d