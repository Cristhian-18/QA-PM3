        <dyn_content><![CDATA[{"name":"SubForm Datos Vehiculo","description":"SubForm Datos Vehiculo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"702321057656567afd0b5f8055682937","name":"SubForm Datos Vehiculo","description":"SubForm Datos Vehiculo","mode":"edit","script":{"type":"js","code":"\nfunction rastreoSatelital(newVal, oldVal) {\n\n  $(\"#file_reporte_sat\").hide();\n  $(\"#file_reporte_sat\").disableValidation();\n  \n  if (newVal == 'SI') {\n    $(\"#file_reporte_sat\").show();\n    $(\"#file_reporte_sat\").enableValidation();\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n\/\/execute when the Dynaform loads:\nrastreoSatelital($(\"#frm_rastreoSatelital\").getValue(), '');\n$('#frm_rastreoSatelital').setOnchange(rastreoSatelital);\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_vehiculo_placa","var_uid":"229546280656567aff20418049025254","dataType":"string","protectedValue":false,"id":"frm_vehiculo_placa","name":"frm_vehiculo_placa","label":"Placa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_placa","colSpan":6},{"type":"text","variable":"frm_vehiculo_marca","var_uid":"873346104656567aff1ce68038783915","dataType":"string","protectedValue":false,"id":"frm_vehiculo_marca","name":"frm_vehiculo_marca","label":"Marca","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_ve