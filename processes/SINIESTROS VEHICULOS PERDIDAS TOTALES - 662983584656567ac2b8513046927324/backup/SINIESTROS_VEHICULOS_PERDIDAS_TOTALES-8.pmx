\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong> REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"910598028656567aff3c0b6040299221","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"796033972656567aff3fa12092643747","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"230198180656567aff40ae0087816431","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}]],"variables":[{"var_uid":"22541636561df31c8065066073006658","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"820474191615f602d3c4b33049036948","create":false},{"var_uid":"910598028656567aff3c0b6040299221","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_bandera_parcial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"894162426622a1aa60b3b16032649971","var_name_old":"tri_bandera_parcial","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"796033972656567aff3fa12092643747","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"523985251622a208a6237f9095133573","var_name_old":"tri_imp_monto_estimado","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"230198180656567aff40ae0087816431","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"536049576622a20928ebc87025210023","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"820474191615f602d3c4b33049036948"}],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"560832659656567afcf4d25066588147","name":"SubForm Datos Accidente","description":"SubForm Datos Accidente","mode":"edit","script":{"type":"js","code":"//PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_provincias',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'provincia'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_provincia').getControl().empty();\n    $('#frm_accidente_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_pais\").getValue() == '') {\n  checkProvincia($(\"#frm_accidente_pais\").getValue(), '');\n} \n*/\n$('#frm_accidente_pais').setOnchange(checkProvincia); //execute when field's value changes\n\n//CANTON\nfunction checkCanton(newVal, oldVal) {\nvar frm_dato = $(\"#frm_accidente_pais\").getValue();\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_cantones',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'canton'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_provincia\").getValue() != '') {\n  checkCanton($(\"#frm_accidente_provincia\").getValue(), '');\n} \n*/\n$('#frm_accidente_provincia').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  /*console.log(\"BANDERA CAMBIO: \" + newVal);\n$(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n$(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n$(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n$(\"#frm_taller_ciudad\").setValue(\"Q\");\n$(\"#frm_taller_prioridad\").setValue(\"1\");\n$(\"#frm_taller_capacidad\").setValue(\"20\");\n$(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n$(\"#frm_taller_saldo\").setValue(\"15\");\n$(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n$(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n$(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");*/\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#subt_ve_afectados\").show();\n      $(\"#831468248656567afce7676060479058\").show();\n  } else {\n     $(\"#subt_ve_afectados\").hide();\n      $(\"#831468248656567afce7676060479058\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#iisubt_pr_afectados\").show();\n      $(\"#976441291656567afd2a935002448351\").show();\n  } else {\n     $(\"#iisubt_pr_afectados\").hide();\n      $(\"#976441291656567afd2a935002448351\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#isubt_pe_afectados\").show();\n      $(\"#516059836656567afd10a48026370985\").show();\n  } else {\n     $(\"#isubt_pe_afectados\").hide();\n      $(\"#516059836656567afd10a48026370985\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accidente_pais","var_uid":"828690795656567afe27978052201248","dataType":"string","protectedValue":false,"id":"frm_accidente_pais","name":"frm_accidente_pais","label":"Pais","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtapais","options":[],"var_name":"frm_accidente_pais","colSpan":4},{"type":"dropdown","variable":"frm_accidente_provincia","var_uid":"213150583656567afe28bc0038295549","dataType":"string","protectedValue":false,"id":"frm_accidente_provincia","name":"frm_accidente_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaprov","options":[],"var_name":"frm_accidente_provincia","colSpan":4},{"type":"dropdown","variable":"frm_accidente_ciudad","var_uid":"23706896