47806656567afe29d16025058805","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"182747806656567afe29d16025058805","var_name_old":"frm_accion","prj_uid_old":"662983584656567ac2b8513046927324","create":false},{"var_uid":"45428035665b33dc53287e2072444013","prj_uid":"662983584656567ac2b8513046927324","var_name":"file_documentos_respaldoIMVEC","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"45428035665b33dc53287e2072444013","var_name_old":"file_documentos_respaldoIMVEC","prj_uid_old":"662983584656567ac2b8513046927324","create":false},{"var_uid":"25423762965b29b4ec7c128034350259","prj_uid":"662983584656567ac2b8513046927324","var_name":"tri_user_imvec","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"25423762965b29b4ec7c128034350259","var_name_old":"tri_user_imvec","prj_uid_old":"662983584656567ac2b8513046927324","create":false},{"var_uid":"49267055365a62b496c6f25087585854","prj_uid":"662983584656567ac2b8513046927324","var_name":"file_saldoInsoluto","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"49267055365a62b496c6f25087585854","var_name_old":"file_saldoInsoluto","prj_uid_old":"662983584656567ac2b8513046927324","create":false},{"var_uid":"124496421656567afe71789019602920","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"124496421656567afe71789019602920","var_name_old":"frm_comentario","prj_uid_old":"662983584656567ac2b8513046927324","create":false}]}]}]]></dyn_content>
