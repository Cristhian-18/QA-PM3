ze":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"53574378564760b7d49bc11075935804","var_name_old":"expresion_regular_4","prj_uid_old":"771962534639f70846b6f90010923609","create":false},{"var_uid":"132227559656567aff37526067259922","prj_uid":"662983584656567ac2b8513046927324","var_name":"PROCESS","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"24323299364760b7d4d77b5029006240","var_name_old":"PROCESS","prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}]],"variables":[{"var_uid":"182747806656567afe29d16025058805","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"182747806656567afe29d16025058805","var_name_old":"frm_accion","prj_uid_old":"662983584656567ac2b8513046927324","create":false},{"var_uid":"900638254656567afe99979055449476","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_ejcomercial_reasignar","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"124496421656567afe71789019602920","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"124496421656567afe71789019602920","var_name_old":"frm_comentario","prj_uid_old":"662983584656567ac2b8513046927324","create":false}]}]}]]></dyn_content>
