56567ac2b8513046927324","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"536049576622a20928ebc87025210023","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"820474191615f602d3c4b33049036948"}],"colSpan":12}],[{"type":"subtitle","id":"sub_repuestos","label":"Gestión de repuestos","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000001","label":"Estimado cliente:","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000002","label":"Por favor, apruebe la importación de los siguientes repuestos o en su defecto solicite su indemnización, en caso de no seleccionar ninguno de los dos se aprobarán por defecto","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Para confirmar la importación por favor seleccione en \"ESTADO\"","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"480602794656567afd00279083326971","name":"SubForm Gestión Cotizacion Mundo Partes","description":"SubForm Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal){\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i,5);\n        pvp = roundToFixed(pvp, 2);\n        $(\"#grd_valores_siniestros\").setValue(pvp,i,5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i,6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega,i,6);\n    }\n}\n\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":