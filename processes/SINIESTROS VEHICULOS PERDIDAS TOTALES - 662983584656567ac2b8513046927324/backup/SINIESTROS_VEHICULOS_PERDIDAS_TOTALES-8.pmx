('#grd_registro_siniestro').getControl(1,4));\n\nfunction checkGrid(newVal, oldVal){\n    console.log(newVal);\n    let rowNum = 0;\n    rowNum = $(\"#grd_registro_siniestro\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        console.log($(\"#grd_registro_siniestro\").getControl(i,4));\n        if($(\"#grd_registro_siniestro\").getValue(i,4) == \"SI\"){\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', false);\n        }else{\n            $(\"#grd_registro_siniestro\").getControl(i,6).attr('disabled', true);\n            $(\"#grd_registro_siniestro\").setValue(\"\",i,6)\n        }\n    }\n}\n\ncheckGrid($(\"#grd_registro_siniestro\").getValue(), '');\n$('#grd_registro_siniestro').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"567859411656567aff30472000486134","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cobertura","name":"grd_s_cobertura","label":"Causa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"40","width":100,"title":"Causa","var_name":"grd_registro_siniestro"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_limiteMin","name":"grd_s_limiteMin","label":"Limite Min","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateM