        <dyn_content><![CDATA[{"name":"Form 5 Aprobar datos del siniestro","description":"Form 5 Aprobar datos del siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"804264102656567afcf1b79096011601","name":"Form 5 Aprobar datos del siniestro","description":"Form 5 Aprobar datos del siniestro","mode":"edit","script":{"type":"js","code":"$('#frm_cartaDeducible').hide();\n$('#frm_cartaDeducible').disableValidation();\n\nfunction action(newVal, oldVal) {\n  $('#frm_cartaDeducible').hide();\n  $('#frm_cartaDeducible').disableValidation();\n  \n  \n    if (newVal == 'CONTINUAR'){\n       $('#frm_cartaDeducible').show();\n       $('#frm_cartaDeducible').enableValidation();\n    } \n   \n\n}\n\/\/execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(action);\n\n$('#repuestos').hide()\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#375344004656567afcfcd58015574466').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#709751460656567afce0474081432341').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $('#384439457656567afceab65011611057').show()\n        $('#480602794656567afd00279083326971').show()\n        break\n    }\n  })\n  \n  function ocultar_todo() {\n    $('#subt_friss').hide()\n    $('#614037051656567afd2d975045685007').hide()\n    $('#756477459656567afd1cfb3086270388').hide()\n    $('#subt_tallerAsignado').hide()\n    $('#subt_ppolicial').hide()\n    $('#282239801656567afd29986025672858').hide()\n    $('#subt_accesoriosRegistrados').hide()\n    $('#388204042656567afd22313001660735').hide()\n    $('#subt_accidente').hide()\n    $('#560832659656567afcf4d25066588147').hide