iniestro_placaResponsable').enableValidation();\n  }\n}\n\n\/\/execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"415085889656567afed06d2032347077","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"645403265656567afecf4a1072477475","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"dropdown","variable":"frm_siniestro_seConsidera","var_uid":"936285525657296b26a9091032512157","dataType":"string","protectedValue":false,"id":"frm_siniestro_seConsidera","name":"frm_siniestro_seConsidera","label":"\u00bfA juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaul