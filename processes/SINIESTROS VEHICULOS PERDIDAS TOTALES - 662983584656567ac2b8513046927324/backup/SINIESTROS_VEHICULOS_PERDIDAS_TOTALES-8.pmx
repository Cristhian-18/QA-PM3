on_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"852351777656567afe16e12011240983","prj_uid":"662983584656567ac2b8513046927324","var_name":"chk_vehiculo_izquierdo","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"275521387656567afe18376031335368","prj_uid":"662983584656567ac2b8513046927324","var_name":"chk_vehiculo_posterior","var_field_type":"array","var_field_size":10,"var_label":"array","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"818092378656567afe7d5a6009845193","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_danios_detalle","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_registro","label":"<span class=\"subtitulo\" id=\"isubt_registro\" subform=\"601939553656567afce2703072259389\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nRegistro causa siniestros<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"601939553656567afce2703072259389","name":"SubForm Registro Siniestros","description":"SubForm Registro Siniestros","mode":"disabled","script":{"type":"js","code":"\/*henry\n$('#frm_rp_componente_e').hide();\n$('#frm_componente_accesorios').hide();\n$('#frm_componente_inundado').hide();\n$('#lbl_robo_parcial').hide();\n$('#lbl_danio_parcial').hide();\n\nvar formId = $(\"form\").prop(\"id\");\n  \n\/\/Set an onchange event handler for the form. When the value of a field changes in the Dynaform, \n\/\/check whether the changed field is the hasDiscount field in the grid. \n\/\/If so, then if hasDiscount is set to \"Discount\", then enable the discountRate field in the same row. \n\/\/If set to \"No Discount\", then disable the discountRate field.\n$( \"#\" + formId ).setOnchange( function(fieldId, newVal, oldVal) {\n  \/\/check if a field changed inside the grid:\n  var aMatches = fieldId.match(\/^\\[grd_registro_siniestro\\]\\[(\\d+)\\]\\[grd_s_aplicar\\]$\/);\n  \n   if (aMatches) {\n    var rowNo = aMatches[1];\n    if (newVal == \"SI\") {\n      \/\/para poner el resto en NO\n      var nRows = $(\"#grd_registro_siniestro\").getNumberRows(); \n\n      for (var i = 1; i <= nRows; i++) {\n        var grd_s_cobertura = $(\"#grd_registro_siniestro\").getValue(rowNo, 1)\t;\/\/cobertura\n        if(i != rowNo)\n        \t$(\"#form\\\\[grd_registro_siniestro\\\\]\\\\[\"+i+\"\\\\]\\\\[grd_s_aplicar\\\\]\").val(\"NO\");\n        else{\n          if(grd_s_cobertura == 'Robo parcial'){\n            $('#lbl_robo_parcial').show();\n          \t$('#frm_rp_componente_e').show();\n          \t$('#frm_componente_accesorios').show();\n          }\n          if(grd_s_cobertura == 'Da\u00f1o Parcial'){\n\t\t\t$('#lbl_danio_parcial').show();\n          \t$('#frm_componente_inundado').show();\n          }\n        }          \n      }\n    }\n  }\n});\n*\/"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_registro_siniestro","var_uid":"567859411656567aff30472000486134","dataType":"grid","protectedValue":false,"id":"grd_registro_siniestro","name":"grd_registro_siniestro","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cobertura","name":"grd_s_cobertura","label":"Causa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":