        <dyn_content><![CDATA[{"name":"SubForm Vinetas","description":"SubForm Vinetas","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"let app_padre = $(\"#app_padre\").getValue();\n\nif(app_padre == '' || app_padre == null){\n  $('#repuestos').hide();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Taller</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"app_padre","var_uid":"603372399657a8bcc3d3ee2006491156","dataType":"string","protectedValue":false,"id":"app_padre","name":"app_padre","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"app_padre","colSpan":12}]],"variables":[{"var_uid":"603372399657a8bcc3d3ee2006491156","prj_uid":"662983584656567ac2b8513046927324","var_name":"app_padre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
