        <dyn_content><![CDATA[{"name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"875784299656567afd2e956035984330","name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","mode":"edit","script":{"type":"js","code":"$(\"#grd_valores_siniestros_alcance\").hideColumn(9);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(11);\n\n\nfunction checkNewGrid(newVal, oldVal) {\n  console.log(\"CHECK\");\n  let rowNum = 0;\n  rowNum = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n  console.log(rowNum);\n  for (let i= 1; i <= rowNum; i++) {\n      let disponible = $(\"#grd_valores_siniestros_alcance\").getValue(i, 7);\n\n      if (disponible == \"DISPONIBLE\") {\n          $(\"#grd_valores_siniestros_alcance\").setValue(\"Aprobado\", i,11);\n      } \n      if (disponible == \"IMPORTACIÓN\") {\n        $(\"#grd_valores_siniestros_alcance\").setValue(\"Pendiente\", i,11);\n    } \n    if (disponible == \"FABRICACION\") {\n      $(\"#grd_valores_siniestros_alcance\").setValue(\"Indemnizacion\", i,11);\n  \n    }\n     \n  }\n}\ncheckNewGrid($(\"#grd_valores_siniestros_alcance\").getValue(), '');\n$(\"#grd_valores_siniestros_alcance\").change(checkNewGrid);\n\n\n$('.menu').on('click', function () {\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#375344004656567afcfcd58015574466\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#709751460656567afce0474081432341\").show();\n      break;\n    case 'repuestos':\n      $('#sub_valores').show()\n      $('#440020719656567afcf2b20063813760').show()\n      break\n  }\n  $(\"#frm_documentos_otros\").hide();\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#718299480656567afd0c6f5055771758\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#565843896656567afd328b8087596694\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#142725203656567afcda002050435920\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#624298983656567afd15b60051714541\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#601939553656567afce2703072259389\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#780469005656567afce66c5098057154\").hide();\n  $(\"#sub_valores\").hide();\n  $('#480602794656567afd00279083326971').hide()\n  $(\"#527111746656567afd266e9046897016\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#375344004656567afcfcd58015574466\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#709751460656567afce0474081432341\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#970216769656567afcd3ed7021146455\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#582336739656567afcd7d26036202949\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#282239801656567afd29986025672858\").hide();\n  $(\"#subt_direccionador\").hide();\n  $(\"#489756561656567afcf5da3068863338\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#614037051656567afd2d975045685007\").hide();\n\n  $(\"#subt_accidente\").hide();\n  $(\"#560832659656567afcf4d25066588147\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#831468248656567afce7676060479058\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#516059836656567afd10a48026370985\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#976441291656567afd2a935002448351\").hide();\n  $(\"#765755715656567afd18e09041007921\").hide();\n  $('#440020719656567afcf2b20063813760').hide()\n\n}\nfunction mostrar_solicitud() {\n  $(\"#sub_busqueda\").show();\n  $(\"#718299480656567afd0c6f5055771758\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#565843896656567afd328b8087596694\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#142725203656567afcda002050435920\").show();\n  //$(\"#subt_detalle\").show();\n  //$(\"#624298983656567afd15b60051714541\").show();\n  //$(\"#subt_registro\").show();\n  //$(\"#601939553656567afce2703072259389\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#sub_docs\").show();\n  $(\"#780469005656567afce66c5098057154\").show();\n  $(\"#527111746656567afd266e9046897016\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#970216769656567afcd3ed7021146455\").show();\n  $(\"#subt_hsiniestros\").show();\n  $(\"#582336739656567afcd7d26036202949\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#282239801656567afd29986025672858\").show();\n  $(\"#subt_direccionador\").show();\n  $(\"#489756561656567afcf5da3068863338\").show();\n  $(\"#subt_friss\").show();\n  $(\"#614037051656567afd2d975045685007\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#560832659656567afcf4d25066588147\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#831468248656567afce7676060479058\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#516059836656567afd10a48026370985\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#976441291656567afd2a935002448351\").show();\n  $(\"#765755715656567afd18e09041007921\").show();\n\n\n}\n\nocultar_todo();\nmostrar_solicitud();\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"GENERAR COTIZACIÓN","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"907501608656567afd21393091569045","name":"SubForm 