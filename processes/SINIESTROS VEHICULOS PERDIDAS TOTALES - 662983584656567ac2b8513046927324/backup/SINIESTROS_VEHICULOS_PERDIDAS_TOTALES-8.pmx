,"var_uid_old":"30865455164a5eb03105167001606129","var_name_old":"frm_asegurado_tipo","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"130627853659c6f612f3392042382571","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_conductor_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"429216017659c5f9a473808057066612","var_name_old":"frm_conductor_identificacion","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"357296073659c6f61332cb1010685638","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_conductor_nombres","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"152647119659c5fc84c24e6082946022","var_name_old":"frm_conductor_nombres","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"769669012659c6f613661c8062874035","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_conductor_telefono","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"115669193659c6015afc406080754563","var_name_old":"frm_conductor_telefono","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"543344153659c6f61399260041587560","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_conductor_relacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"620490272659c6038e00839044766469","var_name_old":"frm_conductor_relacion","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"393069499659c6f613cba89020624668","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_conductor_relacion_otro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"969765013659c60775b0172018792292","var_name_old":"frm_conductor_relacion_otro","prj_uid_old":"35087580064a18c9776b638006106795"}],"colSpan":12}],[{"type":"subtitle","id":"subt_accidente","label":"<span class=\"subtitulo\" id=\"isubt_accidente\" subform=\"560832659656567afcf4d25066588147\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos del accidente</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"560832659656567afcf4d25066588147","name":"SubForm Datos Accidente","description":"SubForm Datos Accidente","mode":"disabled","script":{"type":"js","code":"//PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_provincias',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'provincia'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_provincia').getControl().empty();\n    $('#frm_accidente_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_pais\").getValue() == '') {\n  checkProvincia($(\"#frm_accidente_pais\").getValue(), '');\n} \n*/\n$('#frm_accidente_pais').setOnchange(checkProvincia); //execute when field's value changes\n\n//CANTON\nfunction checkCanton(newVal, oldVal) {\nvar frm_dato = $(\"#frm_accidente_pais\").getValue();\n  $.ajax({\n    url  : '../beesmartec/services/siniestrosVeh/ajax_pantalla.php',\n    data : {\n      'funcion' : 'consultar_cantones',\n      'frm_dato' : newVal,\n      'frm_tipo' : 'canton'\n    },\n    type : 'POST',\n    beforeSend : function(){\n      //$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n      $('#frm_accidente_ciudad').getControl().empty();\n    $('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n    },\n    success : function(respuesta) {\n      var respuestadata = JSON.parse(respuesta); \n      var i=1;\n      $.each(respuestadata, function(i, item) {\n        $('#frm_accidente_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n        i++;\n      });\n    },\n    error : function(xhr, status) {\n      alert(status);\n    },\n    complete : function(xhr, status) {\n      //$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n    }\n  });\n}\n//execute when the Dynaform loads:\n/*if ($(\"#frm_accidente_provincia\").getValue() != '') {\n  checkCanton($(\"#frm_accidente_provincia\").getValue(), '');\n} \n*/\n$('#frm_accidente_provincia').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  /*console.log(\"BANDERA CAMBIO: \" + newVal);\n$(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n$(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n$(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n$(\"#frm_taller_ciudad\").setValue(\"Q\");\n$(\"#frm_taller_prioridad\").setValue(\"1\");\n$(\"#frm_taller_capacidad\").setValue(\"20\");\n$(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n$(\"#frm_taller_saldo\").setValue(\"15\");\n$(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n$(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n$(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");*/\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#subt_ve_afectados\").show();\n      $(\"#831468248656567afce7676060479058\").show();\n  } else {\n     $(\"#subt_ve_afectados\").hide();\n      $(\"#831468248656567afce7676060479058\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); //execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#iisubt_pr_afectados\").show();\n      $(\"#976441291656567afd2a935002448351\").show();\n  } else {\n     $(\"#iisubt_pr_afectados\").hide();\n      $(\"#976441291656567afd2a935002448351\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); //execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n  if (newVal == 'SI') {\n      $(\"#isubt_pe_afectados\").show();\n      $(\"#516059836656567afd10a48026370985\").show();\n  } else {\n     $(\"#isubt_pe_afectados\").hide();\n      $(\"#516059836656567afd10a48026370985\").hide();\n  }\n}\n//execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); //execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accidente_pais","var_uid":"828690795656567afe27978052201248","dataType":"string","protectedValue":false,"id":"frm_accidente_pais","name":"frm_accidente_pais","label":"Pais","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtapais","options":[],"var_name":"frm_accidente_pais","colSpan":4},{"type":"dropdown","variable":"frm_accidente_provincia","var_uid":"213150583656567afe28bc0038295549","dataType":"string","protectedValue":false,"id":"frm_accidente_provincia","name":"frm_accidente_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaprov","options":[],"var_name":"frm_accidente_provincia","colSpan":4},{"type":"dropdown","variable":"frm_accidente_ciudad","var_uid":"237068961656567afe26919072767952","dataType":"string","protectedValue":false,"id":"frm_accidente_ciudad","name":"frm_accidente_ciudad","label":"Ciudad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_DtaCant","options":[],"var_name":"frm_accidente_ciudad","colSpan":4}],[{"type":"text","variable":"frm_siniestro_direccion","var_uid":"200588