","label":"Generar automaticamente"},{"value":"EQUISUIZA","label":"Asignar caso de registro manual (Insurance)"}],"var_name":"frm_accion_2","colSpan":12}],[{"type":"dropdown","variable":"frm_tipo_solitud","var_uid":"92384674165d6d90cda2cd9046999791","dataType":"string","protectedValue":false,"id":"frm_tipo_solitud","name":"frm_tipo_solitud","label":"Tipo de Solicitud","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"2","label":"Manual"},{"value":"1","label":"Automático"}],"var_name":"frm_tipo_solitud","colSpan":12}],[{"type":"dropdown","variable":"tri_user_totales","var_uid":"4676921486596c4de72c8f2077852143","dataType":"string","protectedValue":false,"id":"tri_user_totales","name":"tri_user_totales","label":"Analista asignado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":" SELECT U.USR_UID, UPPER(CONCAT( USR_FIRSTNAME, ' ', USR_LASTNAME ) ) AS NOMBRE FROM USERS U, GROUP_USER G \nWHERE U.USR_UID = G.USR_UID AND GRP_UID = ( SELECT GRP_UID FROM GROUPWF WHERE GRP_TITLE = \"SINIESTROS_ANALISTAS_VH_INSURANCE\" )","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"tri_user_totales","colSpan":12}],[{"type":"dropdown","variable":"tri_revisar_duplicado","var_uid":"21866503866687a65e222e6045120429","dataType":"string","protectedValue":false,"id":"tri_revisar_duplicado","name":"tri_revisar_duplicado","label":"El caso es duplicado?","tabIndex":"",