        <dyn_content><![CDATA[{"name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"780469005656567afce66c5098057154","name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","mode":"edit","script":{"type":"js","code":"//$('#frm_documentos_check').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_documentos_check\").setOnchange(function (newVal, oldVal) {\n  $('#fle_matricula').disableValidation();\n  $('#fle_cedula').disableValidation();\n  $('#fle_licencia').disableValidation();\n  $('#fle_denuncia').disableValidation();\n  $('#fle_partePolicial').disableValidation();\n\n\n  if (newVal == \"SI\") {\n    $('#fle_matricula').enableValidation();\n    $('#fle_cedula').enableValidation();\n    $('#fle_licencia').enableValidation();\n    $('#fle_denuncia').enableValidation();\n    $('#fle_partePolicial').enableValidation();\n\n  }\n\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_documentos_check","var_uid":"576570047656567afe90ec1031918021","dataType":"string","protectedValue":false,"id":"frm_documentos_check","name":"frm_documentos_check","label":"¿Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"}],"var_name":"frm_documentos_check","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Documentos obligatorios","ariaLabel":"","colSpan":6},{"colSpan":1},{"type":"subtitle","id":"subtitle0000000002","label":"Documentos adicionales","ariaLabel":"","colSpan":5}],[{"type":"multipleFile","variable":"fle_matricula","var_uid":"724534224656567afe233a3013738258","dataType":"multiplefile","protectedValue":false,"id":"fle_matricula","name":"fle_matricula","label":"Copia de matrícula del vehículo asegurado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"fle_matricula","colSpan":6},{"type":"multipleFile","variable":"fle_denuncia","var_uid":"401467461656567afe211e0038766779","dataType":"multiplefile","protectedValue":false,"id":"fle_denuncia","name":"fle_denuncia","label":"Denuncia en fiscalía","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"fle_denuncia","colSpan":6}],[{"type":"multipleFile","variable":"fle_licencia","var_uid":"603126440656567afe22331038144973","dataType":"multiplefile","protectedValue":false,"id":"fle_licencia","name":"fle_licencia","label":"Copia de licencia de la persona que estaba conduciendo el vehículo en el momento del siniestro","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"fle_licencia","colSpan":6},{"type":"multipleFile","variable":"fle_partePolicial","var_uid":"303440958656567afe24432086427361","dataType":"multiplefile","protectedValue":false,"id":"fle_partePolicial","name":"fle_partePolicial","label":"Parte Policial","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"fle_partePolicial","colSpan":6}],[{"type":"multipleFile","variable":"fle_cedula","var_uid":"440793048656567afe200d8067781177","dataType":"multiplefile","protectedValue":false,"id":"fle_cedula","name":"fle_cedula","label":"Copia de cédula del asegurado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":"24","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"fle_cedula","colSpan":6},{"type":"multipleFile","variable":"frm_rastreoSatelital2","var_uid":"740817916657297df07fd85056962320","dataType":"multiplefile","protectedValue":false,"id":"frm_rastreoSatelital2","name":"frm_rastreoSatelital2","label":"Rastreo Satelital","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":24,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"frm_rastreoSatelital2","colSpan":6}],[{"colSpan":6},{"type":"multipleFile","variable":"file_liberacionVehiculo","var_uid":"150361336657a941bcdbe39056929140","dataType":"multiplefile","protectedValue":false,"id":"file_liberacionVehiculo","name":"file_liberacionVehiculo","label":"Documento liberación de vehículo","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":24,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"file_liberacionVehiculo","colSpan":6}],[{"colSpan":6},{"type":"multipleFile","variable":"frm_documentos_analisis_SESA","var_uid":"23846363766ac060d8ad660020853899","dataType":"multiplefile","protectedValue":false,"id":"frm_documentos_analisis_SESA","name":"frm_documentos_analisis_SESA","label":"Documentos Analisis Equisuiza","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.xlsx,*.docx","size":24,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"291577746656567afd35d60068669263","var_name":"frm_documentos_analisis_SESA","colSpan":6}]],"variables":[{"var_uid":"576570047656567afe90ec1031918021","prj_uid":"662983584656567ac2b8513046927324","var_name":"frm_documentos_check","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"724534224656567afe233a3013738258","prj_uid":"662983584656567ac2b8513046927324","var_name":"fle_matricula","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"401467461656567afe211e0038766779","prj_uid":"662983584656567ac2b8513046927324","var_name":"fle_denuncia","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"603126440656567afe22331