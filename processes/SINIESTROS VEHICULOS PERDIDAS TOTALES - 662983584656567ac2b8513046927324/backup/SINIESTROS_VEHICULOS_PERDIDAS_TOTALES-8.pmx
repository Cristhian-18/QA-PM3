<tr>
<td valign="top" colspan="4">
<p align="center"><font size="1" color="#001815"><b>&nbsp;</b></font></p>
</td>
</tr>
<tr style="background-color: #00493c;">
<td width="100%" colspan="4" valign="middle">
<p align="center"><font size="1" color="#FFFFFF"> <b>VEH&Iacute;CULO ASEGURADO</b> </font></p>
</td>
</tr>
<tr>
<td valign="top" colspan="4">
<p align="center"><font size="1" color="#001815"><b>&nbsp;</b></font></p>
</td>
</tr>
<tr>
<td width="20%" valign="top">
<p align="justify"><font size="1" color="#001815"><b>Marca:</b></font></p>
</td>
<td width="20%" valign="top">
