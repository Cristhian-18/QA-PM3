@@tmp_entra = @@TASK;

		$comentario = @@frm_comentario;
		$accion     = 'INGRESAR';
		$accion_label     = 'Crear Caso desde el Portal';

@@tri_estado_evento = 1;
$cod_estado = @@tri_estado_evento;

$sql = "INSERT INTO certificacion.SINIESTRO_VH_BITACORA_TOTAL (
  APP_NUMBER,
  APP_UID,
