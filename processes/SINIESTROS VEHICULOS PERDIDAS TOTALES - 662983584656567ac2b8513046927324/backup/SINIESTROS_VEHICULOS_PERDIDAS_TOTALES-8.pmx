esponsable').enableValidation();\n      }\n    } \n}\n\nfunction actionResponsableSiniestro(newVal, oldVal) {\n  console.log(newVal);\n  console.log($(\"#frm_requiere_PartePolicial\").getValue())\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  \n    if (newVal == 'Afectado'){\n      if($(\"#frm_requiere_PartePolicial\").getValue() == \"NO\"){\n        $('#frm_siniestro_nombreResponsable').show();\n        $('#frm_siniestro_placaResponsable').show();\n        $('#frm_siniestro_informacionResponsable').show();\n        $('#frm_siniestro_informacionResponsable').enableValidation();\n      }\n    } \n}\n\n\/\/execute when the Dynaform loads:\nactionPartePolicial($(\"#frm_requiere_PartePolicial\").getValue(), ''); \n$('#frm_requiere_PartePolicial').setOnchange(actionPartePolicial);\n\nactionResponsableSiniestro($(\"#frm_siniestro_afectado\").getValue(), ''); \n$('#frm_siniestro_afectado').setOnchange(actionResponsableSiniestro);\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"415085889656567afed06d2032347077","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"645403265656567afecf4a1072477475","dataType":"string","protectedVal