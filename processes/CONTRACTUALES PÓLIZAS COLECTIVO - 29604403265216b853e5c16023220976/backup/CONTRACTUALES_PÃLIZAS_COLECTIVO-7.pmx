","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_directorComercial","var_uid":"43378953265221ef3a71883064831675","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorComercial","name":"frm_datosSolicitud_directorComercial","label":"Director Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME) AS NAME \nFROM ADMIN_CATALOGOS A, USERS U WHERE \nA.CAMPO1 = U.USR_USERNAME AND PRO_UID = '42420581765087d55c278c7052161956' AND COD_CATALOGO = 'DELEGACION_DIRECTORES' \nAND ESTADO = 1 AND CODIGO = '@#frm_datosSolicitud_solicitante'","memoryCache":false,"var_name":"frm_datosSolicitud_directorComercial","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_directorEspecialista","var_uid":"99667956265221ef3aa80c2096110699","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorEspecialista","name":"frm_datosSolicitud_directorEspecialista","label":"Director Especialista","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME) AS NAME \nFROM ADMIN_CATALOGOS A, USERS U WHERE \nA.CAMPO2 = U.USR_USERNAME AND PRO_UID = '42420581765087d55c278c7052161956' AND COD_CATALOGO = 'DELEGACION_DIRECTORES' \nAND ESTADO = 1 AND CODIGO = '@#frm_datosSolicitud_solicitante'","memoryCache":false,"var_name":"frm_datosSol