        <dyn_content><![CDATA[{"name":"Form1 Registro de solicitud","description":"Form1 Registro de solicitud","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"18983404665222107b19753023115133","name":"Form1 Registro de solicitud","description":"Form1 Registro de solicitud","mode":"edit","script":{"type":"js","code":"//\n\nfunction ocultarTodo(){\n\t$(\"#7934340406522afa0b6ed54047470201\").hide(); //Cancelaciones\n\t$(\"#frm_datosCancelacion_poliza\").disableValidation();\n  $(\"#frm_datosCancelacion_fechaVigencia\").disableValidation();\n  $(\"#frm_datosCancelacion_motivo\").disableValidation();\n\n  \t$(\"#8809799596522b259653331054481206\").hide(); //Contractual\n    $(\"#frm_datosContractual_poliza\").disableValidation();\n\n  \t$(\"#4611306546522b51cd7d158024974567\").hide(); //Extension\n    $(\"#frm_datosExtencion_poliza\").disableValidation();\n    $(\"#frm_datosExtencion_motivo\").disableValidation();\n    $(\"#frm_datosExtencion_fechaInicio\").disableValidation();\n    $(\"#frm_datosExtencion_fechaFin\").disableValidation();\n\n\n}\n\nfunction checkTipoRequerimiento(newVal, oldVal) {\n  ocultarTodo();\n  switch(newVal){\n    case 'Cancelacion':\n      \t$(\"#7934340406522afa0b6ed54047470201\").show();\n        $(\"#frm_datosCancelacion_poliza\").enableValidation();\n        $(\"#frm_datosCancelacion_fechaVigencia\").enableValidation();\n        $(\"#frm_datosCancelacion_motivo\").enableValidation();\n    break;\n    case 'Contractual':\n      $(\"#8809799596522b259653331054481206\").show();\n      $(\"#frm_datosContractual_poliza\").enableValidation();\n\n    break;\n    case 'Extencion':\n      $(\"#4611306546522b51cd7d158024974567\").show();\n      $(\"#frm_datosExtencion_poliza\").enableValidation();\n    $(\"#frm_datosExtencion_motivo\").enableValidation();\n    $(\"#frm_datosExtencion_fechaInicio\").enableValidation();\n    $(\"#frm_datosExtencion_fechaFin\").enableValidation();\n    break;\n    default:\n      //aqui mostrar algo\n    break;       \n  }\n}\n//execute when the Dynaform loads\n$('#frm_datosSolicitud_tipo').setOnchange(checkTipoRequerimiento);\n\nif($(\"#frm_datosSolicitud_tipo\").getValue() != ''){\n  \tocultarTodo();\n\tcheckTipoRequerimiento($(\"#frm_datosSolicitud_tipo\").getValue(), ''); \n}else{\n\tocultarTodo();\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Movimiento","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"54311785565221eec084b12021450571\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"54311785565221eec084b12021450571","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"edit","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"97830781165221ef38454e7096073133","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND VALOR = 'M' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"24156781865221ef388ae99031960935","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"97093685865221ef3903879061644398","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d+$","validateMessage":"Por favor, ingrese un número de RUC","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"63240335265221ef393ad79084789665","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_linea","var_uid":"95689295765221ef396f090040518641","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_linea","name":"frm_datosSolicitud_linea","label":"Línea de Negocio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'LINEA_NEGOCIO' AND VALOR='C' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_linea","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_ramo","var_uid":"28640315065221ef39b2120051235608","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_ramo","name":"frm_datosSolicitud_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMO' AND VALOR <> 'AP' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_ramo","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_sucursal","var_uid":"92574269065221ef39f79d6058945561","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_sucursal","name":"frm_datosSolicitud_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSAL' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_sucursal","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_solicitante","var_uid":"82838382765221ef3a37654050093052","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_solicitante","name":"frm_datosSolicitud_solicitante","label":"Ejecutivo Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_solicitan