      <record>
        <tri_uid>9248987766522abffcbb2b8007196734</tri_uid>
        <tri_title>Consultar Comentarios</tri_title>
        <tri_description>Consultar Comentarios</tri_description>
        <pro_uid>29604403265216b853e5c16023220976</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//created y Henry


$app_uid        = @@APPLICATION;
$pro_uid        = @@PROCESS;
$cnx = '20319743365221e1e6bd6c7053940577';

$sql            = "SELECT 
  TASK_UID tarea,
  USR_UID_ACTUAL usuario,
  FECHA_DERIVACION f_tranferencia,
  FECHA_INICIO f_inicio,
  FECHA_FIN f_fin,
  ACCION accion,
  COMENTARIO txt_comentario
FROM
  certificacion.EMISIONES_MOVIMIENTOS_BITACORA WHERE APP_UID = '$app_uid' order by ID_BITACORA";
$rs_comentarios = executeQuery($sql);

 

$grd_historial = array();
$i=1;

foreach($rs_comentarios as $data){
	$grd_historial[$i]['tarea'] = PMFGetTaskName($data['tarea'],'es');
	$grd_historial[$i]['usuario'] = NomUsuario($data['usuario']);
	$grd_historial[$i]['f_tranferencia'] = $data['f_tranferencia'];
	$grd_historial[$i]['f_inicio'] = $data['f_inicio'];
	$grd_historial[$i]['f_fin'] = $data['f_fin'];
	$grd_historial[$i]['accion'] = $data['accion'];
	$grd_historial[$i]['txt_comentario'] = $data['txt_comentario'];
	$i++;
}
									
@=grd_historial_caso = $grd_historial;

$case_id=@@APPLICATION;
 
$aVars = array(
     'grd_historial_caso' => $grd_historial);

$result = PMFSendVariables($case_id, $aVars);]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>9323272246522ac19f260f7086018475</tri_uid>
        <tri_title>Envio Correos</tri_title>
        <tri_description>Envio Correos</tri_description>
        <pro_uid>29604403265216b853e5c16023220976</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/*******************************************************
*
* Generated by ProcessMaker Trigger Wizard
* Library: ProcessMaker Functions
* Method: PMF Send Message
* Date: 2020-08-30 10:35:06
*
* ProcessMaker 2020
*
*******************************************************/

$app_number = @@APP_NUMBER;
$tipo_req = @@frm_datosSolicitud_tipo_label;

$sqlCorreos = "SELECT ac.CAMPO2 FROM ADMIN_CATALOGOS ac WHERE ac.COD_CATALOGO = 'COPIAS_MAIL' AND ac.INTEGRACION = '8799375496521525608b1c5005115762'
AND ac.DESCRIPCION ='Envio_correos' LIMIT 1";

$resultadoCorreos = executeQuery($sqlCorreos);

$cc = $resultadoCorreos[1]['CAMPO2'];
switch (@@TASK){
	//tarea 1
	case '47159097865216c17422f85064227461':
		$de = '';
		$para = @@frm_responsable_emision_mail;
		$bcc = '';
		$asunto = "Notificación de caso en BPM ". @#APP_NUMBER;
		$texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
		$texto .= '<p align="justify">Se le notifica que se requiere la asignación del caso '.$app_number.' de tipo
			'.$tipo_req.' para su realización, por favor gestionarlo de acuerdo a las condiciones solicitadas</tipo>
		</p>';
		$comentario = @@frm_comentario;
		$accion = @@frm_accion;
		$plantilla_rec = 'Plantilla_mail.html';

		@@envio_mail_t1 = PMFSendMessage(@@APPLICATION,$de,$para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
		$texto));

	break;
	//tarea 2
	case '17077449865216c3f3d71e5057347607':
		$de = '';
		$para = @@frm_responsable_emision_mail;
		$bcc = '';
		$asunto = "Notificación de caso en BPM ". @#APP_NUMBER;
		$texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
		$texto .= '<p align="justify">Se le notifica que tiene asignado el caso '.$app_number.' de tipo
			'.$tipo_req.' para su resolución en su bandeja, por favor gestionarlo de acuerdo a las condiciones solicitadas.
			</tipo>
		</p>';
		$comentario = @@frm_comentario;
		$accion = @@frm_accion;
		$plantilla_rec = 'Plantilla_mail.html';

		@@envio_mail_t1 = PMFSendMessage(@@APPLICATION,$de,$para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
		$texto));

	break;
	//tarea 3
	case '27724906265216c8f395922053571348':
		$de = '';
		$para = @@frm_responsable_emision_mail;
		$bcc = '';
		$asunto = "Notificación de caso en BPM ". @#APP_NUMBER;
		$texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
		$texto .= '<p align="justify">Se le notifica que tiene asignado un caso '.$app_number.' de tipo
			'.$tipo_req.' , su ejecución en su bandeja, por favor gestionarlo de acuerdo a las condiciones solicitadas.</tipo>
		</p>';
		$comentario = @@frm_comentario;
		$accion = @@frm_accion;
		$plantilla_rec = 'Plantilla_mail.html';

		@@envio_mail_t1 = PMFSendMessage(@@APPLICATION,$de,$para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' =>
		$texto));

	break;
}
]]></tri_webbot>
