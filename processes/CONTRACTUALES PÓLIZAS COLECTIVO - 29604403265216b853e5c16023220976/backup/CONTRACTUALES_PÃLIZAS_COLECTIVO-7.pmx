        <dyn_content><![CDATA[{"name":"Subform Cancelaciones","description":"Subform Cancelaciones","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"7934340406522afa0b6ed54047470201","name":"Subform Cancelaciones","description":"Subform Cancelaciones","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"subt_cancelaciones","label":"Datos del movimiento de cancelación","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"frm_datosCancelacion_poliza","var_uid":"3424773946522affc3b4fc4073464918","dataType":"string","protectedValue":false,"id":"frm_datosCancelacion_poliza","name":"frm_datosCancelacion_poliza","label":"Número de Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"El número de póliza puede tener solo hasta 10 dígitos\n","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCancelacion_poliza","colSpan":6},{"type":"datetime","variable":"frm_datosCancelacion_fechaVigencia","var_uid":"4066937166522b01d9c9898024379023","dataType":"datetime","protectedValue":false,"id":"frm_datosCancelacion_fechaVigencia","name":"frm_datosCancelacion_fechaVigencia","label":"Fecha Vigencia Cancelación","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosCancelacion_fechaVigencia","colSpan":6}],[{"type":"dropdown","variable":"frm_datosCancelacion_motivo","var_uid":"3122589196522b033019d26061036243","dataType":"string","protectedValue":false,"id":"frm_datosCancelacion_motivo","name":"frm_datosCancelacion_motivo","label":"Motivo de cancelación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'MOTIVOS_CANCELACION' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione uno -"}],"var_name":"frm_datosCancelacion_motivo","colSpan":12}]],"variables":[{"var_uid":"3424773946522affc3b4fc4073464918","prj_uid":"29604403265216b853e5c16023220976","var_name":"frm_datosCancelacion_poliza","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4066937166522b01d9c9898024379023","prj_uid":"29604403265216b853e5c16023220976","var_name":"frm_datosCancelacion_fechaVigencia","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3122589196522b033019d26061036