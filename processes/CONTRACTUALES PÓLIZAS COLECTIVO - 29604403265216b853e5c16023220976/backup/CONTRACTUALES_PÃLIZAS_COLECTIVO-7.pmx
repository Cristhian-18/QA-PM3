      <record>
        <tri_uid>5425801976522aca2b2a6d4072318102</tri_uid>
        <tri_title>Guardar Documentos MFiles</tri_title>
        <tri_description>Guardar Documentos MFiles</tri_description>
        <pro_uid>29604403265216b853e5c16023220976</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//created by Henry
//24-12-2020
//Guardar Documentos Compartida

$pro_uid = @@PROCESS;
