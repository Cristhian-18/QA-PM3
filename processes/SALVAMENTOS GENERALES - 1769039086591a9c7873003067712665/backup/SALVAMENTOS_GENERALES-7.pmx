      <record>
        <tri_uid>90327039068c1842e5c6e18086841554</tri_uid>
        <tri_title>EnvioCorreoP</tri_title>
        <tri_description></tri_description>
        <pro_uid>1769039086591a9c7873003067712665</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/*******************************************************
*
* Generated by ProcessMaker Trigger Wizard
* Library: ProcessMaker Functions
* Method: PMF Send Message
* Date: 2020-08-30 10:35:06
*
* ProcessMaker 2020
*
*******************************************************/

$app_number = @@APP_NUMBER;
$tipo_req = @@frm_datosSolicitud_tipo_label;

$de = 'BPM Equisuiza';

// destinatarios
$para = 'daniel.villano@beesmart.ec';
$cc   = 'daniel.villano@beesmart.ec';
$bcc  = 'daniel.villano@beesmart.ec';

// lista de plantillas que quieres enviar
$plantillas = [
 'Notificacion_ejecutivos.html',
 'emailEvent_1720677387370.html',
];

// mensaje base
$texto = '<p align="justify">Estimado(a), Colaborador</p>';
$texto .= '<p align="justify">Se le notifica que se requiere la asignación del caso ' . $app_number . 
          ' de tipo ' . $tipo_req . 
          ' para su realización, por favor gestionarlo de acuerdo a las condiciones solicitadas</p>';

// recorrer todas las plantillas y enviarlas
foreach ($plantillas as $plantilla) {
    $asunto = $plantilla . " " . $app_number;

    @@envio_mail_t1 = PMFSendMessage(
        @@APPLICATION,
        $de,
        $para,
        $cc,
        $bcc,
        $asunto,
        $plantilla,
        array('tri_texto_mail' => $texto)
    );

    echo "Correo enviado con plantilla: " . $plantilla . "<br>";
}

// no usar die si quieres que siga corriendo
die;
]]></tri_webbot>
