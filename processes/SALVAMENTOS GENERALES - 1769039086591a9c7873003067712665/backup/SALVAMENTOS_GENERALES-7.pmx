lues":[],"inp_doc_uid":"","var_uid_old":"132227559656567aff37526067259922","var_name_old":"PROCESS","prj_uid_old":"662983584656567ac2b8513046927324","create":false}],"colSpan":12}]],"variables":[{"var_uid":"6341398036593750c56c5d3055143989","prj_uid":"1769039086591a9c7873003067712665","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6341398036593750c56c5d3055143989","var_name_old":"frm_accion","prj_uid_old":"1769039086591a9c7873003067712665","create":false},{"var_uid":"5416948216593751bf05fb0074138755","prj_uid":"1769039086591a9c7873003067712665","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5416948216593751bf05fb0074138755","var_name_old":"frm_comentario","prj_uid_old":"1769039086591a9c7873003067712665","create":false}]}]}]]></dyn_content>
