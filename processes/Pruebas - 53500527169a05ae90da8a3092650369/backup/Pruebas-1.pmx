      <record>
        <tri_uid>61256928769a59a96712cc8085058248</tri_uid>
        <tri_title>textos</tri_title>
        <tri_description></tri_description>
        <pro_uid>53500527169a05ae90da8a3092650369</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[ 
 
$texto = 'COBERTURAS: SUMA ASEGURADA: - Pérdida parcial por robo Hasta el valor del casco - Pérdida parcial por daño Hasta el valor del casco - Pérdida total por robo Hasta el valor del casco - Pérdida total por daño Hasta el valor del casco - Choque, vuelco - Incendio y/O rayo - Explosión. - Autoignición - Motín y huelga - Actos maliciosos y vandalismo - Eventos de la naturaleza - Derrumbe, deslave, alud - Caida e impacto de objetos COBERTURAS ADICIONALES - Responsabilidad civil hasta: USD. 35.000 como LUC por evento**. - Muerte conductor y/o ayudante: USD. 5.000 por cada ocupante* - Gastos médicos hasta: USD. 3.000 por cada ocupante* - Servicio exequial * Se tomará como límite máximo indicado en la matricula ** Dentro del Territorio Ecuatoriano CLAUSULAS ADICIONALES: - Adhesión - Aviso de siniestro, 10 días hábiles - Salvamento - Amparo patrimonial vehículos livianos para el asegurado y conductores autorizados. - Cancelación de la póliza, 30 días - Cláusula de aceptación - Cláusula de cobertura según los años de fabricación del vehículo asegurado - Cláusula de exclusión cuando carezca de licencia o documentos que habiliten dentro del territorio. - Cláusulas de inexistencia de partes y piezas en el mercado - Cláusula de exclusión por deterioro, averías, o daños en el momento de la inspección de riesgo - Cláusula de limitación y exclusión de sanciones - Paso de puentes y gabarras - Claúsula de Caminos Vecinales VALORES AGREGADOS - Cobertura en países de la CAN (Excepto Venezuela), excluye Responsabilidad civil. - Cobertura 100% en air-bag en caso de un siniestro amparado en la póliza. - No se aplica depreciación en partes y piezas BENEFICIOS ADICIONALES - Asistencia Equinoccial 24 horas - Auto Sustituto, solo para vehículos livianos hasta 15 años de fabricación, de acuerdo con los rangos de suma asegurado detallado líneas abajo, excluye motos, taxis y pesados. DEDUCIBLE POR EVENTO: (aplica el mayor) NOTAS ACLARATORIAS: DEDUCIBLE POR EVENTO: (aplica el mayor) Pérdida parcial por daños parcial por daños y/o robo: -Taller de convenio multimarca: 10% del valor del siniestro; 1% del valor asegurado; mínimo $200. -Taller Concesionario de convenio de la marca hasta 2 años de fabricación: 10% del valor del siniestro; 1% del valor asegurado; mínimo $350. - Taller Concesionario de convenio de la marca más de 2 años de fabricación: 15% del valor del siniestro; 1.5% del valor asegurado; mínimo $400 -Taller sin convenio: 10% del valor del siniestro; 1% del valor asegurado; mínimo $400. Pérdida total por daño *10% del valor asegurado *Vehículos eléctricos 20% del valor asegurado Pérdida Total por Robo (con dispositivo de vehículos menores a US$ 30.000) 10% del valor asegurado. Pérdida Total por Robo (sin dispositivo de vehículos menores a US$ 30.000) 10% del valor asegurado Pérdida Total por Robo (con dispositivo vehículos mayores a US$ 30.000) 10% del valor asegurado Pérdida Total por Robo (Sin dispositivo vehículos mayores a US$ 30.000) 20% del valor asegurado - Se excluye la cobertura de pérdida parcial por robo para los radios pull-out. - Los radios face-out se cubrirán en robo parcial siempre y cuando el asegurado entregue la mascarilla desmontable. - En caso de que el(los) vehículo(s) asegurado(s) posean accesorios extras (diferentes a los originales del vehículo), cuyo valor no supere el 20% del valor del casco, el asegurado deberá notificar por escrito su decisión de asegurarlos, previo la inspección y el pago de prima adicional; caso contrario los mencionados accesorios no tendrán cobertura. - Excluye cualquier daño que ocurra por combustible que no sea el apropiado o estipulado por el fabricante, o por la alteración del mismo que pueda causar cualquier daño al vehículo asegurado. - En caso de asegurarse furgones, termokines, tanques, las coberturas inherentes a rotura de maquinaria y transporte están excluidas - Cubertura para radios originales: hasta el 100% de su valor no superior a us$1.500 - En caso de que Seguros Equinoccial hubiere pagado una indemnización por el valor total de los bienes asegurados, adquiere los derechos de dichos bienes, pudiendo renunciar a estos unilateralmente en cualquier momento. - "En caso de que el Asegurado y/o solicitante no sea el que comparece, el seguro será tomado en calidad de tercero" POLITICAS DE PROTECCION VEHICULAR: Los automóviles, camionetas, 4x4 y 4X2 con valor asegurado superior o igual a US$ 30.000, tendrán cobertura de pérdida total por robo, siempre y cuando cuenten con el dispositivo de rastreo satelital con compañías legalmente constituidas; bajo la legislación y sujetas a control de autoridad ecuatoriana ;Que cuenten con sistema GPS y bloqueo, el cual deberá estar en perfecto estado de funcionamiento durante toda vigencia, para cuyo efecto la certificación del proveedor que gestione el asegurado para constatar el cumplimiento de la garantía será habilitante para la atención del reclamo. La Compañía mantendrá la cobertura de robo total durante los 15 primeros días de inicio vigencia de la póliza, con la finalidad que el Asegurado instale el dispositivo de rastreo El incumplimiento de esta garantía en caso de siniestro por pérdida total por robo se aplicara el deducible del 20% del valor asegurado GARANTIAS DE POLIZA: - Los vehículos de hasta 15 años de fabricación, tendrán cobertura de todo riesgo siempre y cuando sea aceptado en la inspección de nuevo riesgo. - Para efectos de esta póliza, en caso de responsabilidad civil, no se consideran terceros al cónyuge, parientes del asegurado hasta el tercer grado de consanguinidad o afinidad, así como los socios, gerentes o empleados subalternos del asegurado. - El asegurado autoriza expresamente a la aseguradora para que, de manera directa o a través de sus peritos, en cualquier momento solicite la información que considere pertinente a la empresa de rastreo satelital que le presta sus servicios. - Para Seguros Equinoccial es muy importante contar con su información actualizada para lo cual constantemente realizamos la confirmación de sus datos, además con la firma en su póliza nos autoriza a enviar la información relacionada con su seguro y factura además de recolectar, digitalizar, mantener, enviar y recibir información comercial y promocional por canales ordinarios, digitales y telefónicos. - Para Seguros Equinoccial es muy importante contar con su información actualizada para lo cual constantemente realizamos la confirmación de sus datos, además con la firma en su póliza nos autoriza a enviar la información relacionada con su seguro y factura además de recolectar, digitalizar, mantener, enviar y recibir información comercial y promocional por canales ordinarios, digitales y telefónicos.';

// Buscar el bloque del taller de convenio multimarca
// Patrón: desde "Taller de convenio multimarca:" hasta el siguiente "-Taller" o fin de sección
preg_match(
    '/-Taller de convenio multimarca:\s*([^-]+)/i',
    $texto,
    $bloqueMatch
);

if (!empty($bloqueMatch[1])) {
    $bloque = $bloqueMatch[1];

    // Extraer porcentaje del siniestro (ej: "10% del valor del siniestro")
    preg_match('/(\d+(?:\.\d+)?)\s*%\s*del valor del siniestro/i', $bloque, $mSiniestro);
    @@frm_deducible_PorcentajeSiniestro = isset($mSiniestro[1]) ? (float)$mSiniestro[1] : '';

    // Extraer porcentaje del valor asegurado (ej: "1% del valor asegurado")
    preg_match('/(\d+(?:\.\d+)?)\s*%\s*del valor asegurado/i', $bloque, $mAsegurado);
    @@frm_deducible_PorcentajeAsegurado = isset($mAsegurado[1]) ? (float)$mAsegurado[1] : '';

    // Extraer valor mínimo - robusto ante variaciones de tilde
    preg_match('/m[^\s]*nimo\s*\$\s*(\d+(?:\.\d+)?)/i', $bloque, $mMinimo);
    @@frm_deducible_ValorMinimo = isset($mMinimo[1]) ? (float)$mMinimo[1] : '';

    // Fallback manual si el regex de mínimo no capturó nada
    if (@@frm_deducible_ValorMinimo === '') {
        $pos = stripos($bloque, 'nimo $');
        if ($pos !== false) {
            preg_match('/\$\s*(\d+(?:\.\d+)?)/', substr($bloque, $pos), $mMinFb);
            @@frm_deducible_ValorMinimo = isset($mMinFb[1]) ? (float)$mMinFb[1] : '';
        }
    }

} else {
    @@frm_deducible_PorcentajeSiniestro = '';
    @@frm_deducible_PorcentajeAsegurado = '';
    @@frm_deducible_ValorMinimo         = '';
}


// Valor asegurado del casco
@@frm_sumaAseguradaCasco = 300;
@@frm_deducible_ValorAsegurado = @@frm_sumaAseguradaCasco;

echo @@frm_deducible_PorcentajeSiniestro;
echo '<br>';
echo @@frm_deducible_PorcentajeAsegurado;
echo '<br>';
echo @@frm_deducible_ValorMinimo;
echo '<br>';
echo @@frm_deducible_ValorAsegurado ;
die();]]></tri_webbot>
