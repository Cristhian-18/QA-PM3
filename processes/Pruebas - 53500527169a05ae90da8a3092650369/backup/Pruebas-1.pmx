      <record>
        <tri_uid>2902266056a3d3acab7c2e7006696640</tri_uid>
        <tri_title>datosPrueba</tri_title>
        <tri_description>datosPrueba</tri_description>
        <pro_uid>53500527169a05ae90da8a3092650369</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[ $mundo = 'MUNDO MOTRIZ UIO 2';
	 
if(stripos($mundo , "MUNDO MOTRIZ") !== false){
	echo 'entro';
	die();
}

	die('no entro');]]></tri_webbot>
