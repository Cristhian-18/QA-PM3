ub_pago\" subform=\"6673380215fd78842b513c6033965185\"> <i class=\"glyphicon glyphicon-minus\"></i> DATOS DEL PAGO</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6673380215fd78842b513c6033965185","name":"subform definicion de Pago","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_primera_cuota_total_primer_pago\").setOnchange(calcular);\n$(\"#frm_primera_cuota_descuento\").setOnchange(calcular);\n$(\"#frm_primera_cuota_plan\").hide();\n\n//calcular();\nfunction calcular()\n{\n  var sub = $(\"#frm_primera_cuota_total_primer_pago\").getValue()*1;\n  var des = $(\"#frm_primera_cuota_descuento\").getValue()*1;  \n  var tot = sub - des;\n  tot =  tot.toFixed(2);\n  $(\"#frm_primera_cuota_total_pagar\").setValue(tot);\n  \n  if(tot < 1){\n      alert('Valor total a pagar no debe ser menor a $1');\n      $(\"#frm_primera_cuota_descuento\").setValue(0);\n      return false;\n    }\n  \n}\n\n$('#frm_accion').on('change', function(){  \n  var accion = $(\"#frm_accion\").getControl().val();  \n  if (accion == 'TERMINAR'){ $(\"#frm_comentario\").enableValidation(); }\n  else    { $(\"#frm_comentario\").disableValidation();}\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_proceso","var_uid":"2601398565fd7951381f2f7036691371","dataType":"string","protectedValue":false,"id":"frm_proceso","name":"frm_proceso","label":"Proceso:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"8278346505fd796227e6981083172008","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM `ADMIN_CATALOGOS`\nWHERE COD_CATALOGO = 'PROCESOS' \nAND ESTADO = 1\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_proceso","colSpan":6},{"type":"dropdown","variable":"frm_concepto","var_uid":"7773707695fd79556697269090668136","dataType":"string","protectedValue":false,"id":"frm_concepto","name":"frm_concepto","label":"Concepto de pago","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"8278346505fd796227e6981083172008","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS\nWHERE COD_CATALOGO = 'CONCEPTO_PAGO' \nAND ESTADO = 1 and VALOR = @@frm_proceso\nORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_concepto","colSpan":6}],[{"type":"text","variable":"frm_primera_cuota_total_primer_pago","var_uid":"1192019395f23929c441fd5043148195","dataType":"string","protectedValue":false,"id":"frm_primera_cuota_total_primer_pago","name":"frm_primera_cuota_total_primer_pago","label":"Total primer pago","tabIndex":"","defaultValue":"","placeholder":"00.00","hint":"El punto es el signo para separar los decimales ","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+([.][0-9]{0,2})?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_primera_cuota_total_primer_pago","colSpan":6},{"type":"text","variable":"frm_primera_cuota_descuento","var_uid":"6520621835f2392a6719cf6024621880","dataType":"string","protectedValue":false,"id":"frm_primera_cuota_descuento","name":"frm_primera_cuota_descuento","label":"Descuento","tabIndex":"","defaultValue":"","placeholder":"00.00","hint":"El punto es el signo para separar los decimales ","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+([.][0-9]{0,2})?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_primera_cuota_descuento","colSpan":6}],[{"type":"text","variable":"frm_primera_cuota_total_pagar","var_uid":"6770226795f2392af899151079207868","dataType":"string","protectedValue":false,"id":"frm_primera_cuota_total_pagar","name":"frm_primera_cuota_total_pagar","label":"Total a pagar","tabIndex":"","defaultValue":"","placeholder":"00.00","hint":"El punto es el signo para separar los decimales ","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]+([.][0-9]{0,2})?$","validateMessage":"Formato incorrecto, ingrese dos decimales","maxLength":"10","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_primera_cuota_total_pagar","colSpan":6},{"type":"dropdown","variable":"frm_accion","var_uid":"3420179815fdab49090ee74064336826","dataType":"string","protectedValue":false,"id":"frm_accion","name":"frm_accion","label":"Acción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"CONTINUAR","label":"Enviar al cliente para el pago"},{"value":"TERMINAR","label":"Anular el pago"},{"value":"PAGADO","label":"Regularizar Pago"}],"var_name":"frm_accion","colSpan":6}],[{"type":"textarea","variable":"frm_comentario","var_uid":"4056205345fe12a3c3a0a66050857210","dataType":"string","protectedValue":false,"id":"frm_comentario","name":"frm_comentario","label":"Observacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"1","var_name":"frm_comentario","colSpan":12}]],"variables":[{"var_uid":"2601398565fd7951381f2f7036691371","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_proceso","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7773707695fd79556697269090668136","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_concepto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"1192019395f23929c441fd5043148195","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_primera_cuota_total_primer_pago","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1192019395f23929c441fd5043148195","var_name_old":"frm_primera_cuota_total_primer_pago","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"6520621835f2392a6719cf6024621880","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_primera_cuota_descuento","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6520621835f2392a6719cf6024621880","var_name_old":"frm_primera_cuota_descuento","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"6770226795f2392af899151079207868","prj_uid":"5393441295ebc1555705f98060769179","var_name":"frm_primera_cuota_total_pagar","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6770226795f2392af899151079207868","var_name_old":"frm_primera_cuota_total_pagar","prj_uid_old":"5393441295ebc1555705f98060769179","create":false},{"var_uid":"3420179815fdab49090ee74064336826","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"4056205345fe12a3c3a0a66050857210","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}]],"variables":[]}]}]]></dyn_content>
