$sql = "SELECT * FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SERVICIOS_WEB' AND CODIGO = 'USUARIO_DANA_PAGO' AND ESTADO = 1";
$rsD = executeQuery($sql,$cnx);

