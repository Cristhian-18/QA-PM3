        <dyn_filename><![CDATA[5666421555fd0e3d5a57e21058134456/2685114015fd79420a30612057178517]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Subform cliente","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"2685114015fd79420a30612057178517","name":"Subform cliente","description":"","mode":"edit","script":{"type":"js","code":"\n\nif (typeof validarExpresionRegular === 'function') {\n    validarExpresionRegular(\"frm_cliente_nombre\", 1);\n    validarExpresionRegular(\"frm_cliente_segundo_nombre\", 1);\n    validarExpresionRegular(\"frm_cliente_apellidoPaterno\", 1);\n    validarExpresionRegular(\"frm_cliente_apellidoMaterno\", 1);\n}\n\n$(\"#frm_cliente_cedula\").focusout(function () {\n\n    if (typeof identificacionValidez === 'function') {\n\n        var identificacion = $('#frm_cliente_cedula').getValue();\n        var tipoIdentificacion = $('#frm_cliente_tipo_identificacion').getValue();\n\n        if (tipoIdentificacion == \"C\" || tipoIdentificacion == \"P\") {\n            var bool = identificacionValidez(identificacion, tipoIdentificacion,true);\n            if (bool == false) {\n                $('#frm_cliente_cedula').setValue(\"\");\n            }\n        }\n    }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_cliente_tipo_identificacion","var_uid":"8573523055fd7942d332a53038021375","dataType":"string","protectedValue":false,"id":"frm_cliente_tipo_identificacion","name":"frm_cliente_tipo_identificacion","label":"Tipo de identificacion","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","dataVariable":"","options":[{"value":"","label":"Seleccione"},{"value":"C","label":"CEDULA"},{"value":"P","label":"PASAPORTE"}],"var_name":"frm_cliente_tipo_identificacion","colSpan":6},{"type":"text","variable":"frm_cliente_cedula","var_uid":"8424002705e829ed51a12d9064366438","dataType":"string","protectedValue":false,"id":"frm_cliente_cedula","name":"frm_cliente_cedula","label":"Cedula / Pasaporte","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Formato incorrecto","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_cedula","colSpan":6}],[{"type":"text","variable":"frm_cliente_nombre","var_uid":"5919362775e829ed5224501009939714","dataType":"string","protectedValue":false,"id":"frm_cliente_nombre","name":"frm_cliente_nombre","label":"Primer nombre","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[A-Za-zñÑáéíóú\\s]+$","validateMessage":"Formato incorrecto.","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_nombre","colSpan":6},{"type":"text","variable":"frm_cliente_segundo_nombre","var_uid":"8296813025fd7942d5413e3017911148","dataType":"string","protectedValue":false,"id":"frm_cliente_segundo_nombre","name":"frm_cliente_segundo_nombre","label":"Segundo nombre","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[A-Za-zñÑáéíóú\\s]+$","validateMessage":"Formato incorrecto.","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_segundo_nombre","colSpan":6}],[{"type":"text","variable":"frm_cliente_apellidoPaterno","var_uid":"5418194985e829ed5234de9098445396","dataType":"string","protectedValue":false,"id":"frm_cliente_apellidoPaterno","name":"frm_cliente_apellidoPaterno","label":"Apellido Paterno","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[A-Za-zñÑáéíóú\\s]+$","validateMessage":"Formato incorrecto.","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_apellidoPaterno","colSpan":6},{"type":"text","variable":"frm_cliente_apellidoMaterno","var_uid":"2711569585e829ed519c384037577176","dataType":"string","protectedValue":false,"id":"frm_cliente_apellidoMaterno","name":"frm_cliente_apellidoMaterno","label":"Apellido Materno","defaultValue":"","placeholder":"","hint":"","required":false,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[A-Za-zñÑáéíóú\\s]+$","validateMessage":"Formato incorrecto.","maxLength":"30","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_apellidoMaterno","colSpan":6}],[{"type":"text","variable":"frm_cliente_celular","var_uid":"6073095095e829ed521f895043742014","dataType":"string","protectedValue":false,"id":"frm_cliente_celular","name":"frm_cliente_celular","label":"Celular","defaultValue":"","placeholder":"09XXXXXXXX","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^0[8-9][0-9]{8,8}","validateMessage":"Formato incorrecto","maxLength":"10","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_celular","colSpan":6},{"type":"text","variable":"frm_cliente_email","var_uid":"4383644735e829ed51b9063015469798","dataType":"string","protectedValue":false,"id":"frm_cliente_email","name":"frm_cliente_email","label":"Email","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","textTransform":"lower","validate":"^[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Za-z0-9](?:[a-zA-Z0-9-]*[A-Za-z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$","validateMessage":"Formato incorrecto","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_cliente_email","colSpan":6}],[{"type":"textarea","variable":"frm_cliente_direccion","var_uid":"6511382675fd97476231eb3061389719","dataType":"string","protectedValue":false,"id":"frm_cliente_direccion","name":"frm_cliente_direccion","label":"Dirección","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","rows":"1","var_name":"frm_cliente_direccion","colSpan":12}]],"variables":[{"var_uid":"8573523055fd7942d332a53038021375","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_tipo_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1224800275ec3ecad3460a2031305811","var_name_old":"frm_cliente_tipo_identificacion","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"8424002705e829ed51a12d9064366438","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_cedula","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8424002705e829ed51a12d9064366438","var_name_old":"frm_cliente_cedula","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"5919362775e829ed5224501009939714","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5919362775e829ed5224501009939714","var_name_old":"frm_cliente_nombre","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"8296813025fd7942d5413e3017911148","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_segundo_nombre","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6332547775ecd9fb5b57411016549250","var_name_old":"frm_cliente_segundo_nombre","prj_uid_old":"3685317655e829ed34bce43075006773"},{"var_uid":"5418194985e829ed5234de9098445396","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_apellidoPaterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5418194985e829ed5234de9098445396","var_name_old":"frm_cliente_apellidoPaterno","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"2711569585e829ed519c384037577176","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_apellidoMaterno","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2711569585e829ed519c384037577176","var_name_old":"frm_cliente_apellidoMaterno","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"6073095095e829ed521f895043742014","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_celular","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6073095095e829ed521f895043742014","var_name_old":"frm_cliente_celular","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"4383644735e829ed51b9063015469798","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_email","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"4383644735e829ed51b9063015469798","var_name_old":"frm_cliente_email","prj_uid_old":"3685317655e829ed34bce43075006773","create":false},{"var_uid":"6511382675fd97476231eb3061389719","prj_uid":"5666421555fd0e3d5a57e21058134456","var_name":"frm_cliente_direccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
