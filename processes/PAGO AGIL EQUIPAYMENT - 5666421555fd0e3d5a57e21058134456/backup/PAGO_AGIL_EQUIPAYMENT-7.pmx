        <dyn_content><![CDATA[{"name":"subform definicion de Pago","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"6673380215fd78842b513c6033965185","name":"subform definicion de Pago","description":"","mode":"edit","script":{"type":"js","code":"$(\"#frm_primera_cuota_total_primer_pago\").setOnchange(calcular);\n$(\"#frm_primera_cuota_descuento\").setOnchange(calcular);\n$(\"#frm_primera_cuota_plan\").hide();\n\n//calcular();\nfunction calcular()\n{\n  var sub = $(\"#frm_primera_cuota_total_primer_pago\").getValue()*1;\n  var des = $(\"#frm_primera_cuota_descuento\").getValue()*1;  \n  var tot = sub - des;\n  tot =  tot.toFixed(2);\n  $(\"#frm_primera_cuota_total_pagar\").setValue(tot);\n  \n  if(tot < 1){\n      alert('Valor total a pagar no debe ser menor a $1');\n      $(\"#frm_primera_cuota_descuento\").setValue(0);\n      return false;\n    }\n  \n}\n\n$('#frm_accion').on('change', function(){  \n  var accion = $(\"#frm_accion\").getControl().val();  \n  if (accion == 'TERMINAR'){ $(\"#frm_comentario\").enableValidation(); }\n  else    { $(\"#frm_comentario\").disableValidation();}\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_proceso","var_uid":"2601398565fd7951381f2f7036691371","dataType":"string","protectedValue":false,"id":"frm_proceso","name":"frm_proceso","label":"Proceso:","defaultValue":"","placeholder":"","hint":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"8278346505fd796227e6981083172008","dbConnectionLabel":"[localhost:3306] mysql: rp_equivida","sql":"SELECT CODIGO, DESCRIPCION FROM `ADMIN_CATALOGOS`\nWHERE COD_CATALOGO = 'PROCESOS' \nAND ESTADO = 1\nORDER BY DESCRIPCION","dataVariable":"","options":[{"value":"","label":"Seleccione"}],"var_name":"frm_proceso","colSpan":6},{"type":"dropdown","variable":"frm_concepto","var_uid":"7773707695fd79556697269090668136","dataType":"string","protectedValu