d":"","dataType":"","protectedValue":false,"id":"accion","name":"accion","label":"Accion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Accion"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"txt_comentario","name":"txt_comentario","label":"Comentario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"18","width":100,"title":"Comentario"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}]],"variables":[{"var_uid":"361648268652a78c083ccc4033133874","prj_uid":"35087580064a18c9776b638006106795","var_name":"grd_historial_caso","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"636818813652152579324e6062966250","var_name_old":"grd_historial_caso","prj_uid_old":"8799375496521525608b1c5005115762"}],"colSpan":12}],[{"type":"subtitle","id":"sub_gestionrepuestos","label":"Gestión de los repuestos","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9039367376808968b52baf9065964431","name":"SubForm Gestión Cotizacion Ajustadores","description":"SubForm Gestión Cotizacion Ajustadores","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal) {\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\n    console.log(rowNum);\n    valorAprobado = 0;\n    for (let i = 1; i <= rowNum; i++) {\n        let disponibilidad = $(\"#grd_valores_siniestros\").getValue(i, 7);\n        let estado = $(\"#grd_valores_siniestros\").getValue(i, 11);\n        //if disponibilidad = IMPORTACIÓN AND ESTADO = ''\n        //set estado to pendiente\n        if (disponibilidad == \"IMPORTACIÓN\" && estado == \"\") {\n\n            $(\"#grd_valores_siniestros\").setValue(\"Pendiente\", i, 11);\n        }\n\n        console.log(disponibilidad);\n        console.log(estado);\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i, 5);\n        pvp = roundToFixed(pvp, 2);\n        //check if $(\"#grd_valores_siniestros\").getValue(i, 11) == \"Aprobado\" || Indemnizacion )\n        if ($(\"#grd_valores_siniestros\").getValue(i, 11) == \"Aprobado\" || $(\"#grd_valores_siniestros\").getValue(i, 11) == \"Indemnizacion\") {\n            valorAprobado = valorAprobado + parseFloat(pvp);\n        }\n        $(\"#grd_valores_siniestros\").setValue(pvp, i, 5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i, 6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega, i, 6);\n        //IF ($(\"#grd_valores_siniestros\").getValue(i, 1) != \"\") && ($(\"#grd_valores_siniestros\").getValue(i, 2) != \"\")\n        //DISABLE EACH COLUMN\n        console.log(\"ROW 5 VALUE\", $(\"#grd_valores_siniestros\").getValue(i, 5));\n        console.log(\"ROW 6 VALUE\", $(\"#grd_valores_siniestros\").getValue(i, 6));\n        console.log(\"ROW 7 VALUE\", $(\"#grd_valores_siniestros\").getValue(i, 7));\n\n        if (($(\"#grd_valores_siniestros\").getValue(i, 5) != \"0.00\")\n            && ($(\"#grd_valores_siniestros\").getValue(i, 7) != \"\")) {\n            for (let j = 1; j <= 8; j++) {\n                $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n                //delete the pmdynaform-grid-removerow-responsive remove-row class inside the grid\n                $(\"#grd_valores_siniestros-body\")\n                    .find(\".glyphicon-trash[data-row='\" + i + \"']\")\n                    .closest(\".pmdynaform-grid-removerow-responsive\")\n                    .hide();\n                //check if 11 is == '' and enable it\n                if ($(\"#grd_valores_siniestros\").getValue(i, 11) == \"\") {\n                    $(\"#grd_valores_siniestros\").getControl(i, 11).attr('disabled', false);\n                }\n            }\n        } else {\n            for (let j = 4; j <= 8; j++) {\n                $(\"#grd_valores_siniestros\").getControl(i, j).attr('disabled', true);\n            }\n            $(\"#grd_valores_siniestros\").getControl(i, 11).attr('disabled', true);\n        }\n\n    }\n    console.log(\"Valor aprobados\", valorAprobado);\n    $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(valorAprobado);\n\n}\n\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"28511335664f7ecf9b018d1087239481","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"6","width":100,"title":"# Parte"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"title":"Descripción"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion_ajustada","name":"frm_gvs_descripcion_ajustada","label":"Descripción ajustada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"title":"Descripción ajustada"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_pvp","name":"frm_gvs_pvp","label":"PVP sin IVA","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none"