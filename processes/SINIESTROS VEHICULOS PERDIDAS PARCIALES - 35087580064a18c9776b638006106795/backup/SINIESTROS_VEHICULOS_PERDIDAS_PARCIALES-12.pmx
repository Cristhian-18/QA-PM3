quiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Causa"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_cobertura","name":"grd_hs_cobertura","label":"Cobertura","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Cobertura"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_ciudad","name":"grd_hs_ciudad","label":"Ciudad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Ciudad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_taller","name":"grd_hs_taller","label":"Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Taller"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_usuario","name":"grd_hs_usuario","label":"Usuario","tabIndex