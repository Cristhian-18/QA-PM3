        <dyn_content><![CDATA[{"name":"SubForm Siniestros Inusuales","description":"SubForm Siniestros Inusuales","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"34837423466275511ac70a6036377630","name":"SubForm Siniestros Inusuales","description":"SubForm Siniestros Inusuales","mode":"edit","script":{"type":"js","code":"\/\/Siniestros inusuales\n\n\nfunction checkInusual(newVal, oldVal){\n\n    \/*file_siniestroInusual_fiscalia\n    file_siniestroInusual_judicatura\n    file_siniestroInusual_super\n    sub_siniestroInusual_causal\n    frm_siniestroInusual_categoria\n    frm_siniestroInusual_observaciones*\/\n\n    $(\"#file_siniestroInusual_fiscalia\").hide();\n    $(\"#file_siniestroInusual_judicatura\").hide();\n    $(\"#file_siniestroInusual_super\").hide();\n    $(\"#sub_siniestroInusual_causal\").hide();\n    $(\"#frm_siniestroInusual_categoria\").hide();\n    $(\"#frm_siniestroInusual_observaciones\").hide();\n\n    $(\"#file_siniestroInusual_fiscalia\").disableValidation();\n    $(\"#file_siniestroInusual_judicatura\").disableValidation();\n    $(\"#file_siniestroInusual_super\").disableValidation();\n    $(\"#sub_siniestroInusual_causal\").disableValidation();\n    $(\"#frm_siniestroInusual_categoria\").disableValidation();\n    $(\"#frm_siniestroInusual_observaciones\").disableValidation();\n\n    if(newVal == '1'){\n        $(\"#file_siniestroInusual_fiscalia\").show();\n        $(\"#file_siniestroInusual_judicatura\").show();\n        $(\"#file_siniestroInusual_super\").show();\n        $(\"#sub_siniestroInusual_causal\").show();\n        $(\"#frm_siniestroInusual_categoria\").show();\n        $(\"#frm_siniestroInusual_observaciones\").show();\n\n        $(\"#file_siniestroInusual_fiscalia\").enableValidation();\n        $(\"#file_siniestroInusual_judicatura\").enableValidation();\n        $(\"#file_siniestroInusual_super\").enableValidation();\n        $(\"#sub_siniestroInusual_causal\").enableValidation();\n        $(\"#frm_siniestroInusual_categoria\").enableValidation();\n        $(\"#frm_siniestroInusual_observaciones\").enableValidation();\n\n        \/\/if bandera_inusual == 1, disable sub_siniestroInusual_causal\n        let bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\n        if(bandera_inusual == '1'){\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', true);\n        } else {\n            $(\"#sub_siniestroInusual_causal\").getControl().attr('disabled', false);\n        }\n    \n    }\n\n}\ncheckInusual($(\"#frm_siniestroInusual_check\").getValue(), ''); \n$('#frm_siniestroInusual_check').setOnchange(checkInusual);\n\nlet bandera_inusual = $(\"#frm_tri_bandera_inusual\").getValue();\nif(bandera_inusual == '1'){\n    \/\/disable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', true);\n\n} else {\n    \/\/enable frm_siniestroInusual_check\n    $(\"#frm_siniestroInusual_check\").getControl().attr('disabled', false);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"subtitle","id":"sub_siniestro_inusual","label":"Siniestro inusual","ariaLabel":"","colSpan":12}],[{"type":"radio","variable":"frm_siniestroInusual_check","var_uid":"4124274556614cc051f0bb3005767510","dataType":"boolean","protectedValue":false,"id":"frm_siniestroInusual_check","name":"frm_siniestroInusual_check","label":"\u00bfSiniestro Inusual?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Si"},{"value":"0","label":"No"}],"var_name":"frm_siniestroInusual_check","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_fiscalia","var_uid":"5182355316614cc15e4ed33080838691","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_fiscalia","name":"file_siniestroInusual_fiscalia","label":"Fiscalia","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_fiscalia","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_judicatura","var_uid":"3922870726614cc1fb06803013063214","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_judicatura","name":"file_siniestroInusual_judicatura","label":"Judicatura","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_judicatura","colSpan":12}],[{"type":"multipleFile","variable":"file_siniestroInusual_super","var_uid":"4114405066614cc282a2de1056665477","dataType":"multiplefile","protectedValue":false,"id":"file_siniestroInusual_super","name":"file_siniestroInusual_super","label":"Super Intendencia de Companias","tabIndex":"","ariaLabel":"","inputDocument":"Documentos Analista","required":true,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.xlsx,*.xls,*.docx,*.doc,*.png,*.jpg,*.jpeg, *.html, *.msg","size":10,"sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"43136140466144c541e1b46077217131","var_name":"file_siniestroInusual_super","colSpan":12}],[{"type":"dropdown","variable":"frm_siniestroInusual_categoria","var_uid":"9747337436614cc46cd9914027895866","dataType":"string","protectedValue":false,"id":"frm_siniestroInusual_categoria","name":"frm_siniestroInusual_categoria","label":"Categoria","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"TECNICO","label":"T\u00e9cnico"},{"value":"LEGAL","label":"Legal"},{"value":"CUMPLIMIENTO","label":"Cumplimiento \/ Auditoria Interna"},{"value":"COMERCIAL","label":"Comercial"}],"var_name":"frm_siniestroInusual_categoria","colSpan":12}],[{"type":"dropdown","variable":"sub_siniestroInusual_causal","var_uid":"4718018996614cc3695ab46078720274","dataType":"string","protectedValue":false,"id":"sub_siniestroInusual_causal","name":"sub_siniestroInusual_causal","label":"Causal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"CONTABILIDAD","label":"Cliente no maneja contabilidad formal en sus negocios."},{"value":"PERITO","label":"Alerta de perito ajustador asignado al caso."},{"value":"SUSTENTO","label":"Alerta de perito sin sustento t\u00e9cnico, legal y\/o causa de da\u00f1os"},{"value":"BROKER","label":"Alerta de insistencia o inusualidad del Br\u00f3ker"}],"var_name":"sub_siniestroInusual_causal","colSpan":12}],[{"type":"textarea","variable":"frm_siniestroInusual_observaciones","var_uid":"6377606056614cc585aecc6070004454","dataType":"string","protectedValue":false,"id":"frm_siniestroInusual_observaciones","name":"frm_siniestroInusual_observaciones","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_siniestroInusual_observaciones","colSpan":12}],[{"type":"hidden","variable":"frm_tri_bandera_inusual","var_uid":"4436186886614cdc9715562087386954","dataType":"string","protectedValue":false,"id":"frm_tri_bandera_inusual","name":"frm_tri_bandera_inusual","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_tri_bandera_inusual","colSpan":12}]],"variables":[{"var_uid":"4124274556614cc051f0bb3005767510","prj_uid":"37532094166144c51678aa7060345527","var_name":"frm_siniestroInusual_check","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"inp_doc_uid":"","var_uid_old":"4124274556614cc051f0bb3005767510","var_name_old":"frm_siniestroInusual_check","prj_uid_old":"37532094166144c51678aa7060345527"},{"var_uid":"5182355316614cc15e4ed33080838691","prj_uid":"37532094166144c51678aa7060345527","var_name":"file_siniestroInusual_fiscalia","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"5182355316614cc15e4ed33080838691","var_name_old":"file_siniestroInusual_fiscalia","prj_uid_old":"37532094166144c51678aa7060345527"},{"var_uid":"3922870726614cc1fb06803013063214","prj_uid":"37532094166144c51678aa7060345527","var_name":"file_siniestroInusual_judicatura","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql