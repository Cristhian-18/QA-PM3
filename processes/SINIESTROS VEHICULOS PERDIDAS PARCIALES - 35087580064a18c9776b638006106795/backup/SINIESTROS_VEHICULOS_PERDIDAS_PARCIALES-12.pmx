        <dyn_content><![CDATA[{"name":"SubForm Aprobar Alcance","description":"SubForm Aprobar Alcance","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4381450096549105c9501e6023494625","name":"SubForm Aprobar Alcance","description":"SubForm Aprobar Alcance","mode":"edit","script":{"type":"js","code":"function fmt(val, decimals) {\n  let n = parseFloat(String(val).replace(/,/g, ''));\n  if (isNaN(n)) return '';\n  return n.toFixed(decimals);\n}\n\n$(document).ready(function() {\n  var campos = [\n    \"frm_alcanceAdicional_valorRepuestosAprobado\",\n    \"frm_alcanceAdicional_valorManoAprobado\",\n    \"frm_alcanceAdicional_valorTotalAprobado\",\n    \"frm_alcanceAdicional_valorRepuestos\",\n    \"frm_alcanceAdicional_total\"\n  ];\n\n  campos.forEach(function(id) {\n    var val = $(\"#\" + id).getValue();\n    if (val !== '' && val !== null && val !== undefined) {\n      $(\"#\" + id).setValue(fmt(val, 2));\n    }\n  });\n});\n\n$(\"#frm_alcanceAdicional_valorRepuestosAprobado\").setOnchange(function(newVal, oldVal) {\n  $(\"#frm_alcanceAdicional_valorRepuestosAprobado\").setValue(fmt(newVal, 2));\n});\n\n$(\"#frm_alcanceAdicional_valorManoAprobado\").setOnchange(function(newVal, oldVal) {\n  $(\"#frm_alcanceAdicional_valorManoAprobado\").setValue(fmt(newVal, 2));\n});\n\n$(\"#frm_alcanceAdicional_valorTotalAprobado\").setOnchange(function(newVal, oldVal) {\n  $(\"#frm_alcanceAdicional_valorTotalAprobado\").setValue(fmt(newVal, 2));\n});\n\n$(\"#frm_alcanceAdicional_valorRepuestos\").setOnchange(function(newVal, oldVal) {\n  $(\"#frm_alcanceAdicional_valorRepuestos\").setValue(fmt(newVal, 2));\n});\n\n$(\"#frm_alcanceAdicional_total\").setOnchange(function(newVal, oldVal) {\n  $(\"#frm_alcanceAdicional_total\").setValue(fmt(newVal, 2));\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_alcanceAdicional_valorRepuestos","var_uid":"49071410265490e6aca5580044540663","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorRepuestos","name":"frm_alcanceAdicional_valorRepuestos","label":"Valor de Repuestos Proformados","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorRepuestos","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorRepuestosAprobado","var_uid":"9846700676549109688da77069712914","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorRepuestosAprobado","name":"frm_alcanceAdicional_valorRepuestosAprobado","label":"Valor de Repuestos Aprobado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorRepuestosAprobado","colSpan":6}],[{"type":"text","variable":"frm_alcanceAdicional_valorMano","var_uid":"47251319965490e79948bd8059366959","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorMano","name":"frm_alcanceAdicional_valorMano","label":"Valor de Mano de Obra Proformados","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorMano","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorManoAprobado","var_uid":"508147956654910a146c879089301298","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorManoAprobado","name":"frm_alcanceAdicional_valorManoAprobado","label":"Valor de Mano de Obra Aprobado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorManoAprobado","colSpan":6}],[{"type":"text","variable":"frm_alcanceAdicional_total","var_uid":"18768147765490f76708de7069635498","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_total","name":"frm_alcanceAdicional_total","label":"Valor Total Proformado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"(frm_alcanceAdicional_valorRepuestos+frm_alcanceAdicional_valorMano)","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_total","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorTotalAprobado","var_uid":"304598516654910a9297fb3074389599","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorTotalAprobado","name":"frm_alcanceAdicional_valorTotalAprobado","label":"Valor Total Aprobado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","valid