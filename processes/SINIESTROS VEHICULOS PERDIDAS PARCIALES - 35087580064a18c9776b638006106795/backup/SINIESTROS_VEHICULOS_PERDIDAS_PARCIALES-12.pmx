"title":"Taller"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_usuario","name":"grd_hs_usuario","label":"Usuario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Usuario"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCausa","name":"grd_hs_codCausa","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_hs_codCobertura","name":"grd_hs_codCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Historial de Siniestros","colSpan":12}]],"variables":[{"var_uid":"65079548164a5e3bc034b42084587569","prj_uid":"35087580064a18c9776b638006106795","var_name":"grd_historial_siniestros","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_asegurado","label":"<span class=\"subtitulo\" id=\"isubt_asegurado\" subform=\"15180521364a5eaf5f02815065887190\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos Conductor</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"15180521364a5eaf5f02815065887190","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"parent","script":{"type":"js","code":"//henry\nlet tipoSolicitud = $(\"#frm_asegurado_tipo\").getValue();\nif (tipoSolicitud == 'A') {\nlet cedula = $(\"#frm_busqueda_identificacion\").getValue();\nlet nombres = $(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"30865455164a5eb03105167001606129","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"",