119","dataType":"grid","protectedValue":false,"id":"frm_accesorios","name":"frm_accesorios","label":"Accesorios registrados","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_accesorios_accesorio","name":"frm_accesorios_accesorio","label":"Accesorio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"60","width":100,"title":"Accesorio","var_name":"frm_accesorios"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_accesorios_sumaAsegurada","name":"frm_accesorios_sumaAsegurada","label":"Suma Asegurada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"20","width":100,"title":"Suma Asegurada"},{"type":"checkbox","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_accesorios_aplicar","name":"frm_accesorios_aplicar","label":"Aplicar","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[],"columnWidth":"10","width":100,"title":"Aplicar"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Accesorios registrados","colSpan":12}]],"variables":[{"var_uid":"38388593565397021337893028192119","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accesorios","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_accidente","label":"<span class=\"subtitulo\" id=\"isubt_accidente\" subform=\"342283484650ba7c9f2fd13056558401\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos del accidente<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"342283484650ba7c9f2fd13056558401","name":"SubForm Datos Accidente","description":"SubForm Datos Accidente","mode":"edit","script":{"type":"js","code":"\/\/PROVINCIA\nfunction checkProvincia(newVal, oldVal) {\n    $.ajax({\n      url  : '..\/beesmartec\/services\/siniestrosVeh\/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_provincias',\n        'frm_dato' : newVal,\n        'frm_tipo' : 'provincia'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_accidente_provincia').getControl().empty();\n  \t\t$('#frm_accidente_provincia').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n        $('#frm_accidente_ciudad').getControl().empty();\n  \t\t$('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_accidente_provincia').getControl().append( new Option(item.txtDesc, item.codDpto) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n\/\/execute when the Dynaform loads:\n\/*if ($(\"#frm_accidente_pais\").getValue() == '') {\n    checkProvincia($(\"#frm_accidente_pais\").getValue(), '');\n} \n*\/\n$('#frm_accidente_pais').setOnchange(checkProvincia); \/\/execute when field's value changes\n\n\/\/CANTON\nfunction checkCanton(newVal, oldVal) {\n  var frm_dato = $(\"#frm_accidente_pais\").getValue();\n    $.ajax({\n      url  : '..\/beesmartec\/services\/siniestrosVeh\/ajax_pantalla.php',\n      data : {\n        'funcion' : 'consultar_cantones',\n        'frm_dato' : newVal,\n        'frm_tipo' : 'canton'\n      },\n      type : 'POST',\n      beforeSend : function(){\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").showFormModal();\n        $('#frm_accidente_ciudad').getControl().empty();\n  \t\t$('#frm_accidente_ciudad').getControl().append( new Option(\"--- Seleccione ---\", \"\") );\n      },\n      success : function(respuesta) {\n        var respuestadata = JSON.parse(respuesta); \n        var i=1;\n        $.each(respuestadata, function(i, item) {\n          $('#frm_accidente_ciudad').getControl().append( new Option(item.txtDesc, item.codCanton) );\n          i++;\n        });\n      },\n      error : function(xhr, status) {\n        alert(status);\n      },\n      complete : function(xhr, status) {\n        \/\/$(\"#96986217061e95ce2ad1563044086004\").hideFormModal();          \n      }\n    });\n}\n\/\/execute when the Dynaform loads:\n\/*if ($(\"#frm_accidente_provincia\").getValue() != '') {\n    checkCanton($(\"#frm_accidente_provincia\").getValue(), '');\n} \n*\/\n$('#frm_accidente_provincia').setOnchange(checkCanton); \/\/execute when field's value changes\n\n$(\"#frm_siniestro_afectado\").setOnchange( function(newVal, oldVal) {\n  $(\"#frm_taller\").setValue(\"MUNDO MOTRIZ SA\");\n  $(\"#frm_taller_email\").setValue(\"atencion@mundomotriza.com\");\n  $(\"#frm_taller_direccion\").setValue(\"Av Eloy Alfaro y Anonas\");\n  $(\"#frm_taller_ciudad\").setValue(\"Q\");\n  $(\"#frm_taller_prioridad\").setValue(\"1\");\n  $(\"#frm_taller_capacidad\").setValue(\"20\");\n  $(\"#frm_taller_vehiculosIngresados\").setValue(\"5\");\n  $(\"#frm_taller_saldo\").setValue(\"15\");\n  $(\"#frm_taller_tipo\").setValue(\"MULTIMARCA\");\n  $(\"#frm_taller_horario\").setValue(\"RECEPCION 24 HORAS LABORABLES\");\n  $(\"#frm_taller_serviciosAdicionales\").setValue(\"ENDEREZADA Y PINTURA\");\n});\n\n\nfunction checkVehiculosImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#subt_ve_afectados\").show();\n      \t$(\"#24440509064a84d82d7a6e4090951046\").show();\n    } else {\n       $(\"#subt_ve_afectados\").hide();\n      \t$(\"#24440509064a84d82d7a6e4090951046\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckVehiculosImplicados($(\"#frm_siniestro_OtrosVehiculos\").getValue(), ''); \n$('#frm_siniestro_OtrosVehiculos').setOnchange(checkVehiculosImplicados); \/\/execute when field's value changes\n\n\nfunction checkPropiedadImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#iisubt_pr_afectados\").show();\n      \t$(\"#83626962464a84f217fbb30019736581\").show();\n    } else {\n       $(\"#iisubt_pr_afectados\").hide();\n      \t$(\"#83626962464a84f217fbb30019736581\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckPropiedadImplicados($(\"#frm_siniestro_Propiedad\").getValue(), ''); \n$('#frm_siniestro_Propiedad').setOnchange(checkPropiedadImplicados); \/\/execute when field's value changes\n\nfunction checkPersonasImplicados(newVal, oldVal) {\n    if (newVal == 'SI') {\n        $(\"#isubt_pe_afectados\").show();\n      \t$(\"#59581944164a84e6bc66f02025995827\").show();\n    } else {\n       $(\"#isubt_pe_afectados\").hide();\n      \t$(\"#59581944164a84e6bc66f02025995827\").hide();\n    }\n}\n\/\/execute when the Dynaform loads:\ncheckPersonasImplicados($(\"#frm_siniestro_Personas\").getValue(), ''); \n$('#frm_siniestro_Personas').setOnchange(checkPersonasImplicados); \/\/execute when field's value changes\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_accidente_pais","var_uid":"235758055650ba9f9a43759086995816","dataType":"string","protectedValue":false,"id":"frm_accidente_pais","name":"frm_accidente_pais","label":"Pais","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtapais","options":[],"var_name":"frm_accidente_pais","colSpan":4},{"type":"dropdown","variable":"frm_accidente_provincia","var_uid":"732342931650baa0ae0e159018069128","dataType":"string","protectedValue":false,"id":"frm_accidente_provincia","name":"frm_accidente_provincia","label":"Provincia","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtaprov","options":[],"var_name":"frm_accidente_provincia","colSpan":4},{"type":"dropdown","variable":"frm_accidente_ciudad","var_uid":"643223474650baa15df8303009965928","dataType":"string","protectedValue":false,"id":"frm_accidente_ciudad","name":"frm_accidente_ciudad","label":"Ciudad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"disabled","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_DtaCant","options":[],"var_name":"frm_accidente_ciudad","colSpan":4}],[{"type":"text","variable":"frm_siniestro_direccion","var_uid":"59772777264a5ebe74d36f9077847005","dataType":"string","protectedValue":false,"id":"frm_siniestro_direccion","name":"frm_siniestro_direccion","label":"Direcci\u00f3n Siniestro","tabIndex":"","defaultValue":"","placeholder":