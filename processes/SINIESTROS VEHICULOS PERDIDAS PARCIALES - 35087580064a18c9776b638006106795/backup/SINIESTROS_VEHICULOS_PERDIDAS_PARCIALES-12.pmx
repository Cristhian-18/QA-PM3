yCache":false,"var_name":"frm_valoresAprobados_manoObraProformada","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valorRepuestosProformado","var_uid":"14985171765398c1b184971062803469","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valorRepuestosProformado","name":"frm_valoresAprobados_valorRepuestosProformado","label":"Mano Obra Aprobada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valorRepuestosProformado","colSpan":6}],[{"type":"text","variable":"frm_deducible_deducible","var_uid":"3642452366554f8868d71b9063538909","dataType":"string","protectedValue":false,"id":"frm_deducible_deducible","name":"frm_deducible_deducible","label":"Deducible","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_deducible_deducible","colSpan":6},{"type":"text","variable":"frm_deducible_rasa","var_uid":"1094459886554f8953bd808023793457","dataType":"string","protectedValue":false,"id":"frm_deducible_rasa","name":"frm_deducible_rasa","label":"Rasa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_deducible_rasa","colSpan":6}],[{"type":"subtitle","id":"subtitle0000000004","label":"Documentos del caso","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"418835952652a78d09ec638009652152","name":"SubForm Documentos del caso","description":"SubForm Documentos del caso","mode":"edit","script":{"type":"js","code":"var host = PMDynaform.getHostName();\nvar ws = PMDynaform.getWorkspaceName();\nvar app_uid = frames.app_uid ? frames.app_uid : '';\n\n$(function(){\n    var numero_columna_link = 5;\n\n    // Refrescar links existentes\n    for (var i = 1; i <= $(\"#gridDocumentos\").getNumberRows(); i++) {\n        var url = $(\"#gridDocumentos\").getValue(i, numero_columna_link);\n        $(\"#gridDocumentos\").setValue(url, i, numero_columna_link);\n    }\n\n    // Si los enlaces están vacíos, cargar automáticamente\n    var primerEnlace = $(\"#gridDocumentos\").getValue(1, numero_columna_link);\n    if (!primerEnlace || primerEnlace.trim() === '') {\n        cargarDocumentos();\n    }\n\n    // Comentarios\n    $('#historial_comentarios').html($('#tri_comentarios').getValue());\n    $('#tabla-comentarios').dataTable({\n        dom: 'Bfrtip',\n        buttons: ['copyHtml5', 'excelHtml5', 'csvHtml5', 'pdfHtml5'],\n        \"language\": {\n            \"url\": \"/plugin/phsoluciones/core_librerias/datatables/spanish.json\"\n        }\n    });\n});\n\nfunction cargarDocumentos() {\n    if (!app_uid) return;\n    $.ajax({\n        url: host + \"/syscertificacion/es/3sesa/beesmartec/services/siniestrosVeh/consultar_documentos/obtener_enlaces.php?app_uid=\" + app_uid,\n        type: \"GET\",\n        dataType: \"json\",\n        success: function(response) {\n            if (!response.success || !response.documentos.length) return;\n            llenarGridDocumentos(response.documentos);\n        },\n        error: function(xhr, status, error) {\n            console.error(\"Error cargando documentos:\", error);\n        }\n    });\n}\n\nfunction llenarGridDocumentos(docs) {\n    var gridId = \"gridDocumentos\";\n    var totalFilas = $(\"#\" + gridId).getNumberRows();\n    for (var i = totalFilas; i > 1; i--) {\n        $(\"#\" + gridId).deleteRow(i);\n    }\n    for (var c = 1; c <= 5; c++) {\n        $(\"#\" + gridId).setValue(\"\", 1, c);\n    }\n    $.each(docs, function(i, doc) {\n        if (i === 0) {\n            $(\"#\" + gridId).setValue(doc.fecha,      1, 1);\n            $(\"#\" + gridId).setValue(doc.archivo,    1, 2);\n            $(\"#\" + gridId).setValue(doc.comentario, 1, 3);\n            $(\"#\" + gridId).setValue(doc.usuario,    1, 4);\n            $(\"#\" + gridId).setValue(doc.descarga,   1, 5);\n        } else {\n            $(\"#\" + gridId).addRow([\n                {value: doc.fecha},\n                {value: doc.archivo},\n                {value: doc.comentario},\n                {value: doc.usuario},\n                {value: doc.descarga}\n            ]);\n        }\n    });\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.css,\n/plugin/beesmartec/core_librerias/datatables/jquery.dataTables.js,\n/plugin/beesmartec/core_librerias/dataTables/jquery.dataTables.min.js","printable":false,"items":[[{"type":"grid","variable":"gridDocumentos","var_uid":"33242957159838016114138043867285","dataType":"grid","protectedValue":false,"id":"gridDocumentos","name":"gridDocumentos","label":"Documentos del flujo","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"gridDocumentos_Fecha","name":"gridDocumentos_Fecha","label":"Fecha","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"