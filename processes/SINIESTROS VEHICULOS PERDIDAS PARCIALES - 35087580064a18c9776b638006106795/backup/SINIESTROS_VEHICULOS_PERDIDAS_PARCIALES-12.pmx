false,"var_name":"frm_vehiculo_marca","colSpan":6},{"type":"text","variable":"frm_vehiculo_modelo","var_uid":"905073939650ba530f17a62066492271","dataType":"string","protectedValue":false,"id":"frm_vehiculo_modelo","name":"frm_vehiculo_modelo","label":"Modelo Vehículo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_modelo","colSpan":6}],[{"type":"text","variable":"frm_vehiculo_chasis","var_uid":"642670361650ba56d147ab1037922764","dataType":"string","protectedValue":false,"id":"frm_vehiculo_chasis","name":"frm_vehiculo_chasis","label":"VIN","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_chasis","colSpan":6},{"type":"text","variable":"frm_numero_reclamo_sise","var_uid":"5931045846a4bb712b17f18086721448","dataType":"string","protectedValue":false,"id":"frm_numero_reclamo_sise","name":"frm_numero_reclamo_sise","label":"Nro. Reclamo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_numero_reclamo_sise","colSp