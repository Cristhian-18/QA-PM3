r_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"24323299364760b7d4d77b5029006240","var_name_old":"PROCESS","prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}]],"variables":[{"var_uid":"18444705964a8191f53baa1094820624","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"18444705964a8191f53baa1094820624","var_name_old":"frm_accion","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"4924306826539387412d973075996811","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_documentos_otros","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"66475494064a8190795c4a1066892801","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"66475494064a8190795c4a1066892801","var_name_old":"frm_comentario","prj_uid_old":"35087580064a18c9776b638006106795","create":false}]}]}]]></dyn_content>
