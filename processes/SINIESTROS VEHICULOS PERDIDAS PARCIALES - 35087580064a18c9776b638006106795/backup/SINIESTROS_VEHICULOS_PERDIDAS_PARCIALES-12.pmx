leValidation();\n    $('#fle_cedula').enableValidation();\n    $('#fle_licencia').enableValidation();\n    $('#fle_denuncia').enableValidation();\n    $('#fle_partePolicial').enableValidation();\n\n  }\n\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_documentos_check","var_uid":"19231473964a5ede6be41b8060639178","dataType":"string","protectedValue":false,"id":"frm_documentos_check","name":"frm_documentos_check","label":"¿Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"NO","label":"NO"},{"value":"SI","label":"SI"}],"var_name":"frm_documentos_check","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Documentos obligatorios","ariaLabel":"","colSpan":6},{"colSpan":1},{"type":"subtitle","id":"subtitle0000000002","label":"Documentos adicionales","ariaLabel":"","colSpan":5}],[{"type":"multipleFile","variable":"fle_matricula","var_uid":"98120683164a5ee0ad19177091544875","dataType":"multiplefile","protectedValue":false,"id":"fle_matricula","name":"fle_matricula","label":"Copia de matrícula del vehículo asegurado","tabIndex":"","ariaLabel":"","inputDocument":"Documentos_flujo","required":false,"requiredFieldErrorMessage":"","dnd":false,"extensions":"*.pdf,*.png,*.jpg,*.jpeg,*.xlsx,*.docx, *.zip","size":"50","sizeUnity":"MB","maxFileNumber":"0","enableVersioning":false,"mode":"parent","multiple":false,"inp_doc_uid":"739729238652a772f7814b7025820719","var_name":"fle_matricula","colSpan":6},{"type":"multipleFile","variable":"fle_denuncia","var_uid":"57229171964a5ee407ef236013248203","dataType":"multiplefile","protectedValue":false,"id":"fle_denuncia","name":"fle_denuncia","lab