"sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"Aprobado","label":"Aprobado"},{"value":"Negado","label":"Negado"},{"value":"Pendiente","label":"Pendiente aprobación del cliente"},{"value":"Indemnizacion","label":"Indemnización"}],"columnWidth":"10","width":100,"title":"Estado"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":true,"deleteRow":true,"title":"PROFORMA","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"sub_valores","label":"Valores aprobados","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"38051173965398bc04c3a10085381199","name":"SubForm Valores Aprobados","description":"SubForm Valores Aprobados","mode":"edit","script":{"type":"js","code":"$(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let max = 100;\n  let min = 0;\n  let value = limitMaxMin(newVal, max, min);\n  if (value != '') {\n    value = roundToFixed(value, 2);\n  }\n  value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_procentajeDescuentoProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_valoresRepuestos1\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valoresRepuestos1\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_valorRepuestosProformado\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_valorRepuestosProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_manoObraProformada\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_manoObraProformada\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_totalProformado\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresAprobados_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresAprobados_diasEstimadosReparacion\").setOnchange(function (newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresAprobados_diasEstimadosReparacion\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"579761858653932bf6c4637038836846","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos proforma sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresAprobados_valoresRepuestos1","var_uid":"36997817565398beb93da19025101812","dataType":"string","protectedValue":false,"id":"frm_valoresAprobados_valoresRepuestos1","name":"frm_valoresAprobados_valoresRepuestos1","label":"Valores Repuestos Aprobados sin descuento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresAprobados_valoresRepuestos1","colSpan":6}],[{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado"