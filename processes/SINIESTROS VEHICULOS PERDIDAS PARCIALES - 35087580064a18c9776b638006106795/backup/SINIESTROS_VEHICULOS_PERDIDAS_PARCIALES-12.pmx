     var numCols = 9;\n            for (var j = 1; j <= numCols; j++) {\n                console.log(j);\n                $(\"#grd_vehiculos_afectados\").getControl(i, j).attr('disabled', true);\n                try {\n                    var row = $($(\"#grd_vehiculos_afectados\").find(\"div.pmdynaform-grid-row\")[i - 1]);\n                    var button = row.find(\".remove-row\");\n                    button.hide();\n                } catch (e) {\n                    console.log(e);\n                }\n\n\n            }\n        }\n    }\n}\ncatch (e) {\n    console.log(e);\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_vehiculos_afectados","var_uid":"69777410364a84d9b71b727073283582","dataType":"grid","protectedValue":false,"id":"grd_vehiculos_afectados","name":"grd_vehiculos_afectados","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_vafectado_marca","name":"frm_vafectado_marca","label":"Marca","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"dataVariable","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"@@arr_Dtamarcas","options":[{"value":"","label":"--- Seleccione ---"}],"columnWidth":"10","width":100,"title":"Marca","var_name":"grd_vehiculos_afectados"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_vafectado_modelo","name":"frm_vafectado_modelo","label":"Modelo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false