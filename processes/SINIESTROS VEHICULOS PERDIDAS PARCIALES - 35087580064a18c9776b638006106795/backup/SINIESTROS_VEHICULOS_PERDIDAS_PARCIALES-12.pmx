9971","var_name_old":"tri_bandera_parcial","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"85104247565394f89a40d51072446619","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"523985251622a208a6237f9095133573","var_name_old":"tri_imp_monto_estimado","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"37089132765394f89a722c2062008643","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"536049576622a20928ebc87025210023","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"820474191615f602d3c4b33049036948"}],"colSpan":12}],[{"type":"subtitle","id":"sub_repuestos","label":"Gestión de repuestos","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000001","label":"Estimado cliente:","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000002","label":"Por favor, apruebe la importación de los siguientes repuestos o en su defecto solicite su indemnización, en caso de no seleccionar ninguno de los dos se aprobarán por defecto","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Para confirmar la importación por favor seleccione en \"ESTADO\"","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"470410481653944a172eeb1027144131","name":"SubForm Gestión Cotizacion Mundo Partes","description":"SubForm Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal){\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i,5);\n        pvp = roundToFixed(pvp, 2);\n        $(\"#grd_valores_siniestros\").setValue(pvp,i,5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i,6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega,i,6);\n    }\n}\n\n//checkGrid($(\"#grd_valores_siniestros\").getValue(), '');\n$('#grd_valores_siniestros').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"28511335664f7ecf9b018d1087239481","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"6","