$(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n          \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"30865455164a5eb03105167001606129","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_conductor_identificacion","var_uid":"429216017659c5f9a473808057066612","dataType":"string","protectedValue":false,"id":"frm_conductor_identificacion","name":"frm_conductor_identificacion","label":"Identificación","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_identificacion","colSpan":4},{"type":"text","variable":"frm_conductor_nombres","var_uid":"152647119659c5fc84c24e6082946022","dataType":"string","protectedValue":false,"id":"frm_conductor_nombres","name":"frm_conductor_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_nombres","colSpan":8}],[{"type":"text","variable":"frm_conductor_telefono","var_uid":"115669193659c6015afc406080754563","dataType":"string","protectedValue":false,"id":"frm_conductor_telefono","name":"frm_conductor_telefono","label":"Teléfono","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_conductor_telefono","colSpan":4},{"type":"dropdown","variable":"frm_conductor_relacion","var_uid":"620490272659c6038e00839044766469","dataType":"string","protectedValue":false,"id":"frm_conductor_relacion","name":"frm_conductor_relacion","label":"Relación","tabIndex":"","defaultValue":"","placeholder":"","hint":""