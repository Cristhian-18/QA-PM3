        <dyn_content><![CDATA[{"name":"SubForm Informaci\u00f3n delTaller","description":"SubForm Direccionador Taller","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"34599290264a5ec882dda43091413149","name":"SubForm Informaci\u00f3n delTaller","description":"SubForm Direccionador Taller","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_taller","var_uid":"97506618964a5ecc01b6f42073254849","dataType":"string","protectedValue":false,"id":"frm_taller","name":"frm_taller","label":"Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_taller","colSpan":6},{"type":"text","variable":"frm_taller_nombreContacto","var_uid":"7197172316539436749f1b5011307748","dataType":"string","protectedValue":false,"id":"frm_taller_nombreContacto","name":"frm_taller_nombreContacto","label":"Nombre de Contacto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_taller_nombreContacto","colSpan":6}],[{"type":"text","variable":"frm_taller_telefonoContacto","var_uid":"219071741653943740e91f4077340666","dataType":"string","protectedValue":false,"id":"frm_taller_telefonoContacto","name":"frm_taller_telefonoContacto","label":"Telefono Contacto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","m