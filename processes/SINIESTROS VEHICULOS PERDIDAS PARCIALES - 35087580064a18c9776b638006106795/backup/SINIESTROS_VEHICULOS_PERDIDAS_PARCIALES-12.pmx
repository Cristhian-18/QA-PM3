<span class=\"subtitulo\" id=\"isubt_ve_afectados\" subform=\"24440509064a84d82d7a6e4090951046\"> <i class=\"glyphicon glyphicon-minus\"></i> \nVehículos afectados</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"24440509064a84d82d7a6e4090951046","name":"SubForm Datos Vehiculos Afectados","description":"SubForm Datos Vehiculos Afectados","mode":"disabled","script":{"type":"js","code":"//SI ESTÁ CREADO, DESHABILITAR\r\n\r\n//TODO REMOVER TRY CATCH CUANDO FUNCIONE CORRECTAMENTE\r\ntry {\r\n    var grdAfectados = $(\"#grd_vehiculos_afectados\").getNumberRows();\r\n    for (var i = 1; i <= grdAfectados; i++) {\r\n        if ($(\"#grd_vehiculos_afectados\").getValue(i, 8) == \"1\") {\r\n            console.log(i);\r\n            var numCols = 8;\r\n            for (var j = 1; j <= numCols; j++) {\r\n                console.log(j);\r\n                $(\"#grd_vehiculos_afectados\").getControl(i, j).attr('disabled', true);\r\n                try {\r\n                    var row = $($(\"#grd_vehiculos_afectados\").find(\"div.pmdynaform-grid-row\")[i - 1]);\r\n                    var button = row.find(\".remove-row\");\r\n                    button.hide();\r\n                } catch (e) {\r\n                    console.log(e);\r\n                }\r\n\r\n\r\n            }\r\n        }\r\n    }\r\n}\r\ncatch (e) {\r\n    console.log(e);\r\n}\r\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_vehiculos_afectados","var_uid":"69777410364a84d9b71b727073283582","dataType":"grid","protectedValue":false,"id":"grd_vehiculos_afectados","name":"grd_vehiculos_afectados","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_vafectado_marca","name":"frm_vafectado_marca","label":"Marca","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":fals