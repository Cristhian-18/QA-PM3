axLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_relacion_otro","colSpan":4}]],"variables":[{"var_uid":"30865455164a5eb03105167001606129","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_asegurado_tipo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35959853464a5eb33eab333020957592","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_asegurado_identificacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"83276475364a5eb1720fba5018137683","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_asegurado_nombres","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"44094274164a5eb4aa11dd5057756317","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_asegurado_telefono","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"95571476564a5eb54141170034918196","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_asegurado_relacion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35295574464bab6