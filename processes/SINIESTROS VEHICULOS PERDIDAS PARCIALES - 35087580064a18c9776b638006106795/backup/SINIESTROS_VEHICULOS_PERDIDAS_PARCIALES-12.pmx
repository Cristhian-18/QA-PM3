        <dyn_content><![CDATA[{"name":"SubForm A\u00f1adir Alcance adicional","description":"SubForm A\u00f1adir Alcance adicional","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"34070655965490e3b7ef1a6078991211","name":"SubForm A\u00f1adir Alcance adicional","description":"SubForm A\u00f1adir Alcance adicional","mode":"edit","script":{"type":"js","code":"$(\"#frm_alcanceAdicional_valorRepuestos\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorRepuestos\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_valorMano\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_valorMano\").setValue(value);\n})\n\n$(\"#frm_alcanceAdicional_total\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_alcanceAdicional_total\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_alcanceAdicional_valorRepuestos","var_uid":"49071410265490e6aca5580044540663","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorRepuestos","name":"frm_alcanceAdicional_valorRepuestos","label":"Valor de Repuestos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_alcanceAdicional_valorRepuestos","colSpan":6},{"type":"text","variable":"frm_alcanceAdicional_valorMano","var_uid":"47251319965490e79948bd8059366959","dataType":"string","protectedValue":false,"id":"frm_alcanceAdicional_valorMano","name":"frm_alcanceAdicional_valorMano","label":"Valor de Mano de Obra","tabIndex":