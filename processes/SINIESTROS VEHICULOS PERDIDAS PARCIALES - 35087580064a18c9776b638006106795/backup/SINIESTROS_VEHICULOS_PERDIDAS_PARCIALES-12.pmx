"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"24323299364760b7d4d77b5029006240","var_name_old":"PROCESS","prj_uid_old":"771962534639f70846b6f90010923609"}],"colSpan":12}],[{"type":"subtitle","id":"subtitle0000000003","label":"","ariaLabel":"","colSpan":12}],[{"type":"panel","id":"panelheader","content":"<div class=\"row text-center\" id=\"row-info-boxes\">\n  <div class=\"col-md-4 col-sm-4 col-xs-12 box-col\" id=\"col-preliq\">\n    <div class=\"info-box box box-primary\"> \n      <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\"></i></span>\n      <div class=\"info-box-content\">\n        <span class=\"info-box-text\"><strong>NRO. PRELIQUIDACIÓN:</strong></span>\n        <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-4 col-xs-12 box-col\" id=\"col-caso\">\n    <div class=\"info-box box box-primary\"> \n      <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n      <div class=\"info-box-content\">\n        <span class=\"info-box-text\"><strong>NÚMERO DE CASO:</strong></span>\n        <span class=\"info-box-number\"><strong id=\"nro-stro\"></strong></span>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-4 col-xs-12 box-col\" id=\"col-reclamo\">\n    <div class=\"info-box box box-primary\"> \n      <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-alert-circled\"></i></span>\n      <div class=\"info-box-content\">\n        <span class=\"info-box-text\"><strong>RECLAMO:</strong></span>\n        <span class=\"info-box-number\"><strong id=\"reclamo-stro\"></strong></span>\n      </div>\n    </div>\n  </div>\n  <div id=\"card-estado\" class=\"col-md-3 col-sm-6 col-xs-12 box-col\" style=\"display:none;\">\n    <div class=\"info-box box box-primary\"> \n      <span class=\"info-box-icon bg-yellow\"><i class=\"ion ion-clock\"></i></span>\n      <div class=\"info-box-content\">\n        <span class=\"info-box-text\"><strong>ESTADO:</strong></span>\n        <span class=\"info-box-number\"><strong id=\"estado-stro\"></strong></span>\n      </div>\n    </div>\n  </div>\n</div>","border":"1px","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000002","label":"INFORMACIÓN ADICIONAL","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"frm_busqueda_nombres","var_uid":"88342322064a4a815687f80065451874","dataType":"string","protectedValue":false,"id":"frm_busqueda_nombres","name":"frm_busqueda_nombres","label":"Propietario","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_busqueda_nombres","colSpan":12}],[{"type":"textarea","variable":"frm_taller","var_uid":"97506618964a5ecc01b6f42073254849","dataType":"string","protectedValue":false,"id":"frm_taller","name":"frm_taller","label":"Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"frm_taller","colSpan":6},{"type":"textarea","variable":"frm_ruc_taller","var_uid":"8135426406a5a4e31e1c949059294923","dataType":"string","protectedValue":false,"id":"frm_ruc_taller","name":"frm_ruc_taller","label":"Ruc Taller","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","db