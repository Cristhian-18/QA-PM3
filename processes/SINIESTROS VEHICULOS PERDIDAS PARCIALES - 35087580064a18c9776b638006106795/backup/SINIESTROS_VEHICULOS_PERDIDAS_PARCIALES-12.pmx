        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//Inicializar Datos Declaracion

@@frm_asegurado_mail1 = @@frm_busqueda_mail_1;
@@frm_broker_mail1 = @@frm_busqueda_mail_2;
@@frm_broker_celular = @@frm_busqueda_celular_1;
