iestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n//execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"86078996364a5ea3db390b3029062271","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"53896923164a5ea52d0b9a2095798782","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"dropdown","variable":"frm_siniestro_seConsidera","var_uid":"3090765516568a718c54789027470935","dataType":"string","protectedVa