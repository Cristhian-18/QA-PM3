ed":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Limite Max"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_aplicar","name":"grd_s_aplicar","label":"Aplicar","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"columnWidth":"10","width":100,"title":"Aplicar"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_impSumaAsegurada","name":"grd_s_impSumaAsegurada","label":"S. Asegurada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"S. Asegurada"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_impValor","name":"grd_s_impValor","label":"Valor Reclamado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"Ingrese solo n\u00fameros","maxLength":1000,"formula":"","mode":"parent","operation":"sum","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Valor Reclamado"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_cod_amparo","name":"grd_s_cod_amparo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_codCobertura","name":"grd_s_codCobertura","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_codConsecutivo","name":"grd_s_codConsecutivo","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"grd_s_impPrimaBasica","name":"grd_s_impPrimaBasica","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}],[{"type":"label","id":"lbl_robo_parcial","label":"<h5 style=\"color:#1C9DD9;\"><b>Robo Parcial<\/b><\/h5><hr>","ariaLabel":"","colSpan":12}],[{"type":"dropdown","variable":"frm_rp_componente_e","var_uid":"65561411064a5e6ead04668079893291","dataType":"string","protectedValue":false,"id":"frm_rp_componente_e","name":"frm_rp_componente_e","label":"Componente Electrico \/ Electr\u00f3nico \/ Hibr\u00eddos (computador, cableado)","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_rp_componente_e","colSpan":6},{"type":"dropdown","variable":"frm_componente_accesorios","var_uid":"69103242364a5e7201