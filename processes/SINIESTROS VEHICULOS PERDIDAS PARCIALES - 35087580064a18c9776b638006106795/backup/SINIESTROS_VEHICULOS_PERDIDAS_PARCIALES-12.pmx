        <dyn_content><![CDATA[{"name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"57401040965394f81a5fed8042028672","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"\n/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n/*\n$(\"#tri_id_stro\").setValue(\"2249 - 2025\");\n$(\"#tri_nro_stro\").setValue(\"42244242\");\n*/\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\nif($(\"#tri_id_stro\").getValue() == ''){\n    $(\"#id-stro\").html(''+$(\"#nro_inspeccion\").getValue());\n}\n\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());\nif($(\"#tri_nro_stro\").getValue() == ''){\n    $(\"#nro-stro\").html(''+$(\"#id_stro_insp\").getValue());\n}\n\n// Número de reclamo real (viene del SISE, vía @@frm_numero_reclamo_sise)\nvar reclamoReal = String($(\"#frm_numero_reclamo_sise\").getValue() || '').trim();\n\nif (reclamoReal == '') {\n    reclamoReal = 'XXXX';\n    $(\"#frm_numero_reclamo_sise\").setValue(reclamoReal);\n}\n\nif (reclamoReal.toUpperCase().indexOf('XXXX') === 0) {\n    // Aún no se ha logrado consultar / hubo un error\n    $(\"#nro-reclamo-real\").html('Consultando...');\n} else {\n    $(\"#nro-reclamo-real\").html(''+reclamoReal);\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>INTEGRACIÓN:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"nro-stro\"></strong></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"col-md-4 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-alert-circled\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"nro-reclamo-real\"></strong></span>\n    </div>\n  </div>\n</div>","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"96928939765394f89a07cd8013571539","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"85104247565394f89a40d51072446619","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"37089132765394f89a722c2062008643","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"type":"hidden","variable":"frm_numero_reclamo_sise","var_uid":"5931045846a4bb712b17f18086721448","dataType":"string","protectedValue":false,"id":"frm_numero_reclamo_sise","name":"frm_numero_reclamo_sise","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_reclamo_sise","colSpan":2}],[{"type":"hidden","variable":"nro_inspeccion","var_uid":"82616172465d036a042d874059140746","dataType":"string","protectedValue":false,"id":"nro_inspeccion","name":"nro_inspeccion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_inspeccion","colSpan":12}],[{"type":"hidden","variable":"frm_numero_reporte_sise","var_uid":"5991914476a4bb712c104f9041247806","dataType":"string","protectedValue":false,"id":"frm_numero_reporte_sise","name":"frm_numero_reporte_sise","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"frm_numero_reporte_sise","colSpan":12}],[{"type":"hidden","variable":"id_stro_insp","var_uid":"53071245065bd3721ec1a26042677551","dataType":"string","protectedValue":false,"id":"id_stro_insp","name":"id_stro_insp","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"id_stro_insp","colSpan":12}]],"variables":[{"var_uid":"22541636561df31c8065066073006658","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"96928939765394f89a07cd8013571539","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_bandera_parcial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"894162426622a1aa60b3b16032649971","var_name_old":"tri_bandera_parcial","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"85104247565394f89a40d51072446619","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_imp_monto_estimado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"523985251622a208a6237f9095133573","var_name_old":"tri_imp_monto_estimado","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"37089132765394f89a722c2062008643","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_imp_monto_pagado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"536049576622a20928ebc87025210023","var_name_old":"tri_imp_monto_pagado","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"5931045846a4bb712b17f18086721448","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_numero_reclamo_sise","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"82616172465d036a042d874059140746","prj_uid":"35087580064a18c9776b638006106795","var_name":"nro_inspeccion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"5991914476a4bb712c104f9041247806","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_numero_reporte_sise","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"53071245065bd3721ec1a26042677551","prj_uid":"35087580064a18c9776b638006106795","var_name":"id_stro_insp","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
