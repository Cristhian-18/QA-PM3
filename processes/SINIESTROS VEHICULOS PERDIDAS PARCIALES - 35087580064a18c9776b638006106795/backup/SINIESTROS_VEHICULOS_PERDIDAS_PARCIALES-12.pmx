aultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[],"columnWidth":"10","width":100,"title":"Aplicar"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_accesorios_codAccesorio","name":"frm_accesorios_codAccesorio","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Accesorios registrados","colSpan":12}]],"variables":[{"var_uid":"609839209654922516dd7b7027982334","prj_uid":"35087580064a18c9776b638006106795","var_name":"grd_accesorios","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"38388593565397021337893028192119","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accesorios","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
