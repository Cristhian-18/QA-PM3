        <dyn_content><![CDATA[{"name":"Form 5 Aprobar datos del siniestro","description":"Form 5 Aprobar datos del siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"325024623653a0547343469093404343","name":"Form 5 Aprobar datos del siniestro","description":"Form 5 Aprobar datos del siniestro","mode":"edit","script":{"type":"js","code":"$('#frm_cartaDeducible').hide();\n$('#frm_cartaDeducible').disableValidation();\n$('#frm_siniestro_Propiedad').disableValidation();\n$('#frm_siniestro_Personas').disableValidation();\n$('#frm_requiere_AsesoriaLegal').disableValidation();\n$('#frm_requiere_AsesoriaLegal').setText(\"NO\");\n$('#frm_requiere_AsesoriaLegal').disableValidation();\n\n$('#frm_conductor_telefono').disableValidation();\n$('#frm_conductor_identificacion').disableValidation();\n\n\nfunction action(newVal, oldVal) {\n  $('#frm_cartaDeducible').hide();\n  $('#frm_cartaDeducible').disableValidation();\n  \n  \n    if (newVal == 'CONTINUAR'){\n       $('#frm_cartaDeducible').show();\n       $('#frm_cartaDeducible').enableValidation();\n    } \n   \n\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(action);\n\n$('#repuestos').hide()\n\n$('.menu').on('click', function () {\n    ocultar_todo()\n    console.log(this.id)\n    console.log('CAMBIO')\n    switch (this.id) {\n      case 'solicitud':\n        mostrar_solicitud()\n        break\n      case 'documentos':\n        $('#subt_docs').show()\n        $('#418835952652a78d09ec638009652152').show()\n        break\n      case 'historial':\n        $('#sbt_historial').show()\n        $('#200528691652a78b49077a9030935355').show()\n        break\n      case 'repuestos':\n        $('#sub_repuestos').show()\n        $('#267077245653c2f21671c39092873297').show()\n        $('#470410481653944a172eeb1027144131').show()\n        break\n    }\n  })\n  \n  function ocultar_todo() {\n    $('#subt_friss').hide()\n    $('#88678649164f7eaea0