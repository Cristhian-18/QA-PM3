        <dyn_content><![CDATA[{"name":"SubForm Gestión Cotizacion Mundo Partes","description":"SubForm Gestión Cotizacion Mundo Partes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"470410481653944a172eeb1027144131","name":"SubForm Gestión Cotizacion Mundo Partes","description":"SubForm Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal) {\r\n    let rowNum = 0;\r\n    rowNum = $(\"#grd_valores_siniestros\").getNumberRows();\r\n    console.log(rowNum);\r\n    for (let i = 1; i <= rowNum; i++) {\r\n        let pvp = $(\"#grd_valores_siniestros\").getValue(i, 5);\r\n        pvp = roundToFixed(pvp, 2);\r\n        $(\"#grd_valores_siniestros\").setValue(pvp, i, 5);\r\n        let dias_entrega = $(\"#grd_valores_siniestros\").getValue(i, 6);\r\n        dias_entrega = roundToFixed(dias_entrega, 0);\r\n        $(\"#grd_valores_siniestros\").setValue(dias_entrega, i, 6);\r\n    }\r\n}\r\ncheckGrid($(\"#grd_valores_siniestros\").getValue(), '');\r\n$('#grd_valores_siniestros').change(checkGrid);\r\n\r\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros","var_uid":"28511335664f7ecf9b018d1087239481","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros","name":"grd_valores_siniestros","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad","name":"frm_gvs_cantidad","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"5","width":100,"title":"Cantidad"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_nparte","name":"frm_gvs_nparte","label":"# Parte","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"6","width":100,"title":"# Parte"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion","name":"frm_gvs_descripcion","label":"Descripción","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"disabled","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"title":"Descripción"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_descripcion_ajustada","name":"frm_gvs_descripcion_ajustada","label":"Descripción ajustada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","columnWidth":"10","width":100,"title":"Descripción ajustada"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_pvp","name":"frm_gvs_pvp","label":"PVP sin IVA","tabIndex":"","defaultValue":"0.00","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"7","width":100,"title":"PVP sin IVA"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_didas_entrega","name":"frm_gvs_didas_entrega","label":"Dias de entrega","tabIndex":"","defaultValue":"0","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"8","width":100,"title":"Dias de entrega"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_disponibilidad","name":"frm_gvs_disponibilidad","label":"Disponibilidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione una ---"},{"value":"DISPONIBLE","label":"Disponible"},{"value":"IMPORTACIÓN","label":"Importación"},{"value":"FABRICACION","label":"No Fabricación"}],"columnWidth":"10","width":100,"title":"Disponibilidad"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_tipo","name":"frm_gvs_tipo","label":"Tipo de repuesto","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"HOMOLOGADO","label":"Homologado"},{"value":"ORIGINAL","label":"Original"},{"value":"GENUINO","label":"Genuino"}],"columnWidth":"10","width":100,"title":"Tipo de repuesto"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_recibido","name":"frm_gvs_recibido","label":"Recibido","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"columnWidth":"10","width":100,"title":"Recibido"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_observaciones","name":"frm_gvs_observaciones","label":"Observaciones","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Observaciones"},{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_estado","name":"frm_gvs_estado","label":"Estado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"Aprobado","label":"Aprobado"},{"value":"Negado","label":"Negado"},{"value":"Pendiente","label":"Pendiente aprobación del cliente"},{"value":"Indemnizacion","label":"Indemnización"}],"columnWidth":"10","width":100,"title":"Estado"}],"data":[],"mode":"parent","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"PROFORMA","colSpan":12}]],"variables":[]}]}]]></dyn_content>
