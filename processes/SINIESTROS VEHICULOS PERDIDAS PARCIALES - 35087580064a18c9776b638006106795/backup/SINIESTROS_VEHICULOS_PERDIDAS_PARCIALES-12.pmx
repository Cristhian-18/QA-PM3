:"frm_siniestro_Propiedad","name":"frm_siniestro_Propiedad","label":"¿Existe daño a la propiedad privada?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_siniestro_Propiedad","colSpan":4},{"type":"dropdown","variable":"frm_siniestro_Personas","var_uid":"70093110964a5ec2e4e1de3043824313","dataType":"string","protectedValue":false,"id":"frm_siniestro_Personas","name":"frm_siniestro_Personas","label":"¿Personas heridas?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_siniestro_Personas","colSpan":4}]],"variables":[{"var_uid":"235758055650ba9f9a43759086995816","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accidente_pais","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"732342931650baa0ae0e159018069128","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accidente_provincia","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_value