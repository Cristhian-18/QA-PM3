        <dyn_content><![CDATA[{"name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"24155013164a5edc37a3b68095174528","name":"SubForm Documentos Respaldo","description":"SubForm Documentos Respaldo","mode":"edit","script":{"type":"js","code":"//$('#frm_documentos_check').setOnchange(checkCanton); //execute when field's value changes\n\n$(\"#frm_documentos_check\").setOnchange(function (newVal, oldVal) {\n  $('#fle_matricula').disableValidation();\n  $('#fle_cedula').disableValidation();\n  $('#fle_licencia').disableValidation();\n  $('#fle_denuncia').disableValidation();\n  $('#fle_partePolicial').disableValidation();\n\n\n  if (newVal == \"SI\") {\n    $('#fle_matricula').enableValidation();\n    $('#fle_cedula').enableValidation();\n    $('#fle_licencia').enableValidation();\n    $('#fle_denuncia').enableValidation();\n    $('#fle_partePolicial').enableValidation();\n\n  }\n\n});\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_documentos_check","var_uid":"19231473964a5ede6be41b8060639178","dataType":"string","protectedValue":false,"id":"frm_documentos_check","name":"frm_documentos_check","label":"¿Cuenta con todos los documentos?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"NO","label":"NO"},{"value":"SI","label":"SI"}],"var_name":"frm_documentos_check","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"Documentos obligatorios","ariaLabel":"","colSpan":6},{"colSpan":1},{"type":"subtitle","id":"subtitle0000000002","label":"Documentos adicionales","ariaLabel":"","colSpan":5}],[{"type":"multipleFile","v