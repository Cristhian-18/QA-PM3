        <dyn_content><![CDATA[{"name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"917680010652d94aaded3b0064736336","name":"Form 3 Validar Informacion Siniestro","description":"Form 3 Validar Informacion Siniestro","mode":"edit","script":{"type":"js","code":"\/\/henry"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"VALIDAR INFORMACI\u00d3N DEL SINIESTOR","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"751193235652a791dc69c78095996330","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":"\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    switch (this.id) {\n        case 'solicitud':\n           mostrar_solicitud();\n            break;\n        case 'documentos':\n\t\t\t$(\"#subt_docs\").show();\n            $(\"#418835952652a78d09ec638009652152\").show();\n            break;\n        case 'historial':\n          $(\"#sbt_historial\").show();\n          $(\"#200528691652a78b49077a9030935355\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#56711039964a8241d124701020566530\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#95746246564a4a9c711dfb2023501124\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#15180521364a5eaf5f02815065887190\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#61446768964a848b295ae19072670821\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#22536303964a5e5cc12a673090504456\").hide();\n  $(\"#subt_ve_afectados\").hide();\n  $(\"#24440509064a84d82d7a6e4090951046\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#59581944164a84e6bc66f02025995827\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#83626962464a84f217fbb30019736581\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#24155013164a5edc37a3b68095174528\").hide();\n  $(\"#sub_valores\").hide();\n  $(\"#79905380564f7ece7bc8989091267394\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#418835952652a78d09ec638009652152\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#200528691652a78b49077a9030935355\").hide();\n}\nfunction mostrar_solicitud(){\n  $(\"#sub_busqueda\").show();\n  $(\"#56711039964a8241d124701020566530\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#95746246564a4a9c711dfb2023501124\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#15180521364a5eaf5f02815065887190\").show();\n  $(\"#subt_detalle\").show();\n  $(\"#61446768964a848b295ae19072670821\").show();\n  $(\"#subt_registro\").show();\n  $(\"#22536303964a5e5cc12a673090504456\").show();\n  $(\"#subt_ve_afectados\").show();\n  $(\"#24440509064a84d82d7a6e4090951046\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#59581944164a84e6bc66f02025995827\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#83626962464a84f217fbb30019736581\").show();\n  $(\"#sub_docs\").show();\n  $(\"#24155013164a5edc37a3b68095174528\").show();\n  $(\"#sub_valores\").show();\n  $(\"#79905380564f7ece7bc8989091267394\").show();\n}\n\n\n\nocultar_todo();\nmostrar_solicitud();"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud<\/h4><\/a><\/li> \n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos<\/h4><\/a><\/li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial<\/h4><\/a><\/li>\n<\/ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"sub_busqueda","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"56711039964a8241d124701020566530\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos asegurado<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"56711039964a8241d124701020566530","name":"SubForm Datos Declaracion","description":"SubForm Datos Declaracion","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_busqueda_identificacion","var_uid":"84469996164a4a7f4401486070504381","dataType":"string","protectedValue":false,"id":"frm_busqueda_identificacion","name":"frm_busqueda_identificacion","label":"Identificaci\u00f3n","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_busqueda_identificacion","colSpan":6},{"type":"text","variable":"frm_busqueda_nombres","var_uid":"88342322064a4a815687f80065451874","dataType":"string","protectedValue":false,"id":"frm_busqueda_nombres","name":"frm_busqueda_nombres","label":"Nombres","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_busqueda_nombres","colSpan":6}],[{"type":"text","variable":"frm_busqueda_mail_1","var_uid":"22686820564a8245aba4a77077389584","dataType":"string","protectedValue":false,"id":"frm_busqueda_mail_1","name":"frm_busqueda_mail_1","label":"Email Contacto Asegurado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionL