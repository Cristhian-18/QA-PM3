087580064a18c9776b638006106795","var_name":"frm_poliza_contratante","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"70647097264a4a872c38f35048338552","var_name_old":"frm_poliza_contratante","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"83780747664a4a87ccdf767072617669","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_poliza_producto","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"83780747664a4a87ccdf767072617669","var_name_old":"frm_poliza_producto","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"52126078564a4a8cd38c2a5091727829","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_poliza_sucursal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"49136108064a4a8dec23e27063106447","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_poliza_LineaNegocio","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
