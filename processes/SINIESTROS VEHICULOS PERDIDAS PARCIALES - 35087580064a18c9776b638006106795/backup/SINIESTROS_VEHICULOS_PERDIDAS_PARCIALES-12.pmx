        <dyn_content><![CDATA[{"name":"SubForm Datos Vehiculo","description":"SubForm Datos Vehiculo","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"56472373564a846caecb360049084321","name":"SubForm Datos Vehiculo","description":"SubForm Datos Vehiculo","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_vehiculo_placa","var_uid":"19892679164a4a9d41833b0043771028","dataType":"string","protectedValue":false,"id":"frm_vehiculo_placa","name":"frm_vehiculo_placa","label":"Placa","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_placa","colSpan":6},{"type":"text","variable":"frm_vehiculo_marca","var_uid":"635550703650ba528228638043126609","dataType":"string","protectedValue":false,"id":"frm_vehiculo_marca","name":"frm_vehiculo_marca","label":"Marca","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_vehiculo_marca","colSpan":6}],[{"type":"text","variable":"frm_vehiculo_modelo","var_uid":"905073939650ba530f17a62066492271","dataType":"string","protectedValue":false,"id":"frm_vehiculo_modelo","name":"frm_vehiculo_modelo","label":"Modelo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workfl