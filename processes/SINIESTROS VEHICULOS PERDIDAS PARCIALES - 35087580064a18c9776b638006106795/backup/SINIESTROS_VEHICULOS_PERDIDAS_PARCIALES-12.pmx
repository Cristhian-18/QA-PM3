ize":10,"var_label":"integer","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"2745980156a2995be9cd696080362934","var_name_old":"frm_numpreliq","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"6056760626a4bb712d4eaf2037848543","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_estado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"1236348296a468bc26c7d87070535494","var_name_old":"frm_estado","prj_uid_old":"35087580064a18c9776b638006106795"},{"var_uid":"2399805816a56581184a4c4019733788","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_bandera_error_sise","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"18444705964a8191f53baa1094820624","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"60504484965486a8bc378b1043736162","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_comentario_aux","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
