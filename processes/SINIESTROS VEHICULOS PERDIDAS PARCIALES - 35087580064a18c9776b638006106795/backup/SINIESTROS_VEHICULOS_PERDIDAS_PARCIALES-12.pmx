"ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Total proformado"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"separador","name":"separador","label":"","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"7","width":100,"title":""},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"rep_aprobado","name":"rep_aprobado","label":"Repuestos aprobados","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Repuestos aprobados"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"mano_aprobado","name":"mano_aprobado","label":"Mano de obra aprobada","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Mano de obra aprobada"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"total_aprobado","name":"total_aprobado","label":"Total aprobado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"15","width":100,"title":"Total aprobado"}],"data":[],"mode":"disabled","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"Alcances","colSpan":12}],[{"type":"text","variable":"frm_totalMasAlcances","var_uid":"674356094655d2a4c871af5070597561","dataType":"string","protectedValue":false,"id":"frm_totalMasAlcances","name":"frm_totalMasAlcances","label":"Total Aprobado + Alcances","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_totalMasAlcances","colSpan":12}]],"variables":[{"var_uid":"645114878655cbbdf995306006575387","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_reg_alcances","var_field_type":"grid","var_field_size":10,"var_label":"grid","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"674356094655d2a4c871af5070597561","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_totalMasAlcances","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
