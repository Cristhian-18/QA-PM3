        <dyn_content><![CDATA[{"name":"SubForm Parte Policial","description":"SubForm Parte Policial","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"82315095164a5ea0d445d33098806451","name":"SubForm Parte Policial","description":"SubForm Parte Policial","mode":"edit","script":{"type":"js","code":"function checkAfectado(newVal, oldVal) {\n  console.log(newVal);\n  \n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').hide();\n  $('#frm_siniestro_informacionResponsable').disableValidation();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n\n  if (newVal == 'AFECTADO') {\n    $('#frm_siniestro_informacionResponsable').show();\n    $('#frm_siniestro_informacionResponsable').enableValidation();\n    console.log(newVal);\n\n  } else {\n    $('#frm_siniestro_informacionResponsable').setValue(\"\");\n    console.log(newVal);\n\n  }\n}\n\n//execute when the Dynaform loads:\ncheckAfectado($(\"#frm_siniestro_seConsidera\").getValue(), '');\n$('#frm_siniestro_seConsidera').setOnchange(checkAfectado);\n\n\nfunction informacionResponsable(newVal, oldVal) {\n\n  $('#frm_siniestro_nombreResponsable').hide();\n  $('#frm_siniestro_placaResponsable').hide();\n  $('#frm_siniestro_nombreResponsable').disableValidation();\n  $('#frm_siniestro_placaResponsable').disableValidation();\n  console.log(\"Valor responsable: \" + newVal);\n\n  if (newVal == 'SI') {\n    console.log(\"Valor responsable: \" + newVal);\n\n    $('#frm_siniestro_nombreResponsable').show();\n    $('#frm_siniestro_placaResponsable').show();\n    $('#frm_siniestro_nombreResponsable').enableValidation();\n    $('#frm_siniestro_placaResponsable').enableValidation();\n  }\n}\n\n//execute when the Dynaform loads:\ninformacionResponsable($(\"#frm_siniestro_informacionResponsable\").getValue(), '');\n\n$('#frm_siniestro_informacionResponsable').setOnchange(informacionResponsable);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_requiere_PartePolicial","var_uid":"86078996364a5ea3db390b3029062271","dataType":"string","protectedValue":false,"id":"frm_requiere_PartePolicial","name":"frm_requiere_PartePolicial","label":"Existe Parte Policial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_PartePolicial","colSpan":6},{"type":"dropdown","variable":"frm_requiere_AsesoriaLegal","var_uid":"53896923164a5ea52d0b9a2095798782","dataType":"string","protectedValue":false,"id":"frm_requiere_AsesoriaLegal","name":"frm_requiere_AsesoriaLegal","label":"Requiere Asesoria Legal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"-- Seleccione --"},{"value":"SI","label":"SI"},{"value":"NO","label":"NO"}],"var_name":"frm_requiere_AsesoriaLegal","colSpan":6}],[{"type":"dropdown","variable":"frm_siniestro_seConsidera","var_uid":"3090765516568a718c54789027470935","dataType":"string","protectedValue":false,"id":"frm_siniestro_seConsidera","name":"frm_siniestro_seConsidera","label":"¿A juicio del conductor del vehiculo asegurado se considera?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"},{"value":"RESPONSABLE","label":"Responsable"},{"value":"AFECTADO","label":"Afectado"}],"var_name":"frm_siniestro_seConsidera","colSpan":6},{"type":"dropdown","variable":"frm_siniestro_informacionResponsable","var_uid":"806302141653aca7ed3b8b1014028540","dataType":"string","protectedValue":false,"id":"frm_siniestro_informacionResponsable","name":"frm_siniestro_informacionResponsable","label":"¿Tiene información del responsable?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione una ---"},{"value":"SI","label":"Si"},{"value":"NO","label":"No"}],"var_name":"frm_siniestro_informacionResponsable","colSpan":6}],[{"type":"text","variable":"frm_siniestro_placaResponsable","var_uid":"917378942653acad9c095c7075960765","dataType":"string","protectedValue":false,"id":"frm_siniestro_placaResponsable","name":"frm_siniestro_placaResponsable","label":"# de Placa del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_placaResponsable","colSpan":6},{"type":"text","variable":"frm_siniestro_nombreResponsable","var_uid":"765788563653acae2843f40000288141","dataType":"string","protectedValue":false,"id":"frm_siniestro_nombreResponsable","name":"frm_siniestro_nombreResponsable","label":"Nombre del Responsable","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_siniestro_nombreResponsable","colSpan":6}]],"variables":[{"var_uid":"86078996364a5ea3db390b3029062271","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_requiere_PartePolicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"53896923164a5ea52d0b9a2095798782","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_requiere_AsesoriaLegal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"3090765516568a718c54789027470935","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_seConsidera","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"806302141653aca7ed3b8b1014028540","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_informacionResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"917378942653acad9c095c7075960765","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_placaResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"765788563653acae2843f40000288141","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_nombreResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
