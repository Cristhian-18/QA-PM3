e);\n})\n\n$(\"#frm_valoresSiniestro_valorRepuestosProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_valorRepuestosProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_manoObraProformada\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_manoObraProformada\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_totalProformado\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 2);\n  $(\"#frm_valoresSiniestro_totalProformado\").setValue(value);\n})\n\n$(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let value = roundToFixed(newVal, 0);\n  $(\"#frm_valoresSiniestro_diasEstimadosReparacion\").setValue(value);\n})\n\n\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_valoresSiniestro_valoresRepuestos1","var_uid":"579761858653932bf6c4637038836846","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_valoresRepuestos1","name":"frm_valoresSiniestro_valoresRepuestos1","label":"Valor repuestos sin descuentos","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_valoresSiniestro_valoresRepuestos1","colSpan":6},{"type":"text","variable":"frm_valoresSiniestro_procentajeDescuentoProformado","var_uid":"72911758265393401d9bd85012930242","dataType":"string","protectedValue":false,"id":"frm_valoresSiniestro_procentajeDescuentoProformado","name":"frm_valoresSiniestro_proce