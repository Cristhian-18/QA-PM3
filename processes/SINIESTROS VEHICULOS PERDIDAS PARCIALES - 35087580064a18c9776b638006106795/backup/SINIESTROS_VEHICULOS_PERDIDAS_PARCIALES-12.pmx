        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[$pro_uid = @@PROCESS;

$id_pv = @@frm_id_pv;

$cnx = '934957180650c74e8ed0e10096114321';
//estado de la bandera

