      <record>
        <tri_uid>91407853365684051377e65081105798</tri_uid>
        <tri_title>Detener Repuestos Pendientes Recibir</tri_title>
        <tri_description>Detener Repuestos Pendientes Recibir</tri_description>
        <pro_uid>35087580064a18c9776b638006106795</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//<?

if(@@frm_accion == "REPUESTOS"){
	$repuestos = array();
$repuestos=@@grd_valores_siniestros;
$bandera_stop = false;
foreach($repuestos as $repuesto){
  $estado = $repuesto['frm_gvs_estado'];
  if($estado == 'Aprobado'){
    $recibido = $repuesto['frm_gvs_recibido'];
    if($recibido != "SI"){
      echo("El repuesto ".$repuesto['frm_gvs_descripcion']." no ha sido recibido.");
      echo("<br>");
      $bandera_stop = true;
    }
  }
}
}
if($bandera_stop){
  echo("No se puede cerrar el siniestro porque hay repuestos pendientes por recibir.");
  die();
}
]]></tri_webbot>
