        <dyn_content><![CDATA[{"name":"Form 5 Aprobar Siniestro","description":"Form5 Registro de datos repuestos","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"184987515652eab25d1b3c8068203713","name":"Form 5 Aprobar Siniestro","description":"Form5 Registro de datos repuestos","mode":"edit","script":{"type":"js","code":" $(\"#frm_conductor_identificacion\").disableValidation();\n        $(\"#frm_conductor_telefono\").disableValidation();\n        $(\"#frm_conductor_nombres\").disableValidation();\n        $(\"#frm_conductor_relacion\").disableValidation();\n$(\"#repuestos\").hide();\n$(\"#frm_asegurado_tipo\").disableValidation();\n\n$('.menu').on('click', function () {\n    ocultar_todo();\n    console.log(this.id)\n    console.log(\"CAMBIO\")\n    switch (this.id) {\n        case 'solicitud':\n            mostrar_solicitud();\n            break;\n        case 'documentos':\n            $(\"#subt_docs\").show();\n            $(\"#418835952652a78d09ec638009652152\").show();\n            break;\n        case 'historial':\n            $(\"#sbt_historial\").show();\n            $(\"#200528691652a78b49077a9030935355\").show();\n            break;\n    }\n});\n\n\nfunction ocultar_todo() {\n    $(\"#sub_busqueda\").hide();\n    $(\"#56711039964a8241d124701020566530\").hide();\n    $(\"#subt_vehiculo\").hide();\n    $(\"#95746246564a4a9c711dfb2023501124\").hide();\n    $(\"#subt_asegurado\").hide();\n    $(\"#15180521364a5eaf5f02815065887190\").hide();\n    $(\"#subt_detalle\").hide();\n    $(\"#61446768964a848b295ae19072670821\").hide();\n    $(\"#subt_registro\").hide();\n    $(\"#22536303964a5e5cc12a673090504456\").hide();\n    $(\"#subt_ve_afectados\").hide();\n    $(\"#24440509064a84d82d7a6e4090951046\").hide();\n    $(\"#isubt_pe_afectados\").hide();\n    $(\"#59581944164a84e6bc66f02025995827\").hide();\n    $(\"#iisubt_pr_afectados\").hide();\n    $(\"#83626962464a84f217fbb30019736581\").hide();\n    $(\"#sub_docs\").hide();\n    $(\"#24155013164a5edc37a3b68095174528\").hide();\n    $(\"#sub_valores\").hide();\n    $(\"#79905380564f7ece7bc8989091267394\").hide();\n    $(\"#subt_docs\").hide();\n    $(\"#418835952652a78d09ec638009652152\").hide();\n    $(\"#sbt_historial\").hide();\n    $(\"#200528691652a78b49077a9030935355\").hide();\n    $(\"#subt_poliza\").hide();\n    $(\"#12366487464a4a855bed4c8081629548\").hide();\n    $(\"#470410481653944a172eeb1027144131\").hide();\n    $(\"#subt_historial_siniestro\").hide();\n    $(\"#14870785564a5e392d24239097281950\").hide();\n    $(\"#38051173965398bc04c3a10085381199\").hide();\n    $(\"#aub_friss\").hide();\n    $(\"#88678649164f7eaea023df2027918886\").hide();\n\n\n\n}\nfunction mostrar_solicitud() {\n    $(\"#sub_busqueda\").show();\n    $(\"#56711039964a8241d124701020566530\").show();\n    $(\"#subt_vehiculo\").show();\n    $(\"#95746246564a4a9c711dfb2023501124\").show();\n    $(\"#subt_asegurado\").show();\n    $(\"#15180521364a5eaf5f02815065887190\").show();\n    $(\"#subt_detalle\").show();\n    $(\"#61446768964a848b295ae19072670821\").show();\n    $(\"#subt_registro\").show();\n    $(\"#22536303964a5e5cc12a673090504456\").show();\n    $(\"#subt_ve_afectados\").show();\n    $(\"#24440509064a84d82d7a6e4090951046\").show();\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#59581944164a84e6bc66f02025995827\").show();\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#83626962464a84f217fbb30019736581\").show();\n    $(\"#sub_docs\").show();\n    $(\"#24155013164a5edc37a3b68095174528\").show();\n    $(\"#sub_valores\").show();\n    $(\"#79905380564f7ece7bc8989091267394\").show();\n    $(\"#subt_poliza\").show();\n    $(\"#12366487464a4a855bed4c8081629548\").show();\n    $(\"#470410481653944a172eeb1027144131\").show();\n    $(\"#subt_historial_siniestro\").show();\n    $(\"#14870785564a5e392d24239097281950\").show();\n    $(\"#38051173965398bc04c3a10085381199\").show();\n    $(\"#aub_friss\").show();\n    $(\"#88678649164f7eaea023df2027918886\").show();\n\n}\n\nlet vehiculos = $(\"#frm_siniestro_OtrosVehiculos\").getValue();\nlet propiedades = $(\"#frm_siniestro_Propiedad\").getValue();\nlet personas = $(\"#frm_siniestro_Personas\").getValue();\n\n$(\"#isubt_pe_afectados\").hide();\n$(\"#59581944164a84e6bc66f02025995827\").hide();\n$(\"#subt_ve_afectados\").hide();\n$(\"#24440509064a84d82d7a6e4090951046\").hide();\n$(\"#iisubt_pr_afectados\").hide();\n$(\"#83626962464a84f217fbb30019736581\").hide();\n\nif (vehiculos == 'SI') {\n    $(\"#subt_ve_afectados\").show();\n    $(\"#24440509064a84d82d7a6e4090951046\").show();\n}\nif (propiedades == 'SI') {\n    $(\"#iisubt_pr_afectados\").show();\n    $(\"#83626962464a84f217fbb30019736581\").show();\n}\nif (personas == 'SI') {\n    $(\"#isubt_pe_afectados\").show();\n    $(\"#59581944164a84e6bc66f02025995827\").show();\n}\n\nfunction checkAccion(newVal, oldVal) {\n    if (newVal == 'AJUSTAR') {\n        $(\"#frm_valoresAprobados_manoObraProformada\").disableValidation();\n        $(\"#frm_valoresAprobados_diasEstimadosReparacion\").disableValidation();\n\n    } \n    console.log(\"TIPO DE ACCION: \" + newVal);\n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(checkAccion);\n\n\nocultar_todo();\nmostrar_solicitud();\n\n$(\"#frm_conductor_identificacion\").disableValidation();\n$(\"#frm_conductor_telefono\").disableValidation();\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"INGRESAR DATOS DE REPUESTOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"751193235652a791dc69c78095996330","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"57401040965394f81a5fed8042028672","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"\n/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*/\n/*\n$(\"#tri_id_stro\").setValue(\"2249 - 2025\");\n$(\"#tri_nro_stro\").setValue(\"42244242\");\n*/\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\nif($(\"#tri_id_stro\").getValue() == ''){\n\t$(\"#id-stro\").html(''+$(\"#nro_inspeccion\").getValue());\n}\n\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());\n\n\nif($(\"#tri_nro_stro\").getValue() == ''){\n\t$(\"#nro-stro\").html(''+$(\"#id_stro_insp\").getValue());\n}"},"language":"en","externalLibs":"/plugin/beesmartec/core_librerias/js_externos/app.min.js,\n\n/plugin/beesmartec/core_librerias/css_externos/AdminLTE.min.css, /plugin/beesmartec/core_librerias/ionicons-2.0.1/css/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"></div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"></i></span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong> REPORTE:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"></i></span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> RECLAMO:</strong>\n      </span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"></strong></span>\n    </div>\n    <!-- /.info-box-content -->\n  </div>\n  <!-- /.info-box -->\n</div>\n<div class=\"col-md-3\"></div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"></i> Mensaje...!</h4>\n    <h2><div id=\"html_op\"></div></h2>\n  </div>\n</div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"96928939765394f89a07cd8013571539","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"85104247565394f89a40d51072446619","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"37089132765394f89a722c2062008643","dataType":"string","protectedValue":false,"id":"tri_imp_monto_pagado","name":"tri_imp_monto_pagado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_pagado","colSpan":2},{"colSpan":2}],[{"type":"hidden","variable":"nro_inspeccion","var_uid":"82616172465d036a042d874059140746","dataType":"string","protectedValue":false,"id":"nro_inspeccion","name":"nro_inspeccion","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"nro_inspeccion","colSpan":12}],[{"type":"hidden","variable":"id_stro_insp","var_uid":"53071245065bd3721ec1a26042677551","dataType":"string","protectedValue":false,"id":"id_stro_insp","name":"id_stro_insp","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"id_stro_insp","colSpan":12}]],"variables":[{"var_uid":"22541636561df31c8065066073006658","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_id_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"22541636561df31c8065066073006658","var_name_old":"tri_id_stro","prj_uid_old":"820474191615f602d3c4b33049036948"},{"var_uid":"23510320361df31d0abbeb1025197251","prj_uid":"35087580064a18c9776b638006106795","var_name":"tri_nro_stro","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"23510320361df31d0abbeb1025197251","var_name_old":"tri_nro_stro","prj_uid_old":"820474191615f602d3c4b33049036948"