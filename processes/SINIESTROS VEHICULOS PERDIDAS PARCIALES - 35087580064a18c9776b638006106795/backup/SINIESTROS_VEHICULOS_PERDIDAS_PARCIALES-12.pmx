l":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"18444705964a8191f53baa1094820624","var_name_old":"frm_accion","prj_uid_old":"35087580064a18c9776b638006106795","create":false},{"var_uid":"66475494064a8190795c4a1066892801","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"66475494064a8190795c4a1066892801","var_name_old":"frm_comentario","prj_uid_old":"35087580064a18c9776b638006106795","create":false}]}]}]]></dyn_content>
