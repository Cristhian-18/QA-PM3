title","id":"sub_repuestos","label":"Gestión de repuestos","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3333297516562f070836c34088397701","name":"SubForm Alcance Gestión Cotizacion Mundo Partes","description":"SubForm Alcance Gestión Cotizacion Mundo Partes","mode":"edit","script":{"type":"js","code":"function checkGrid(newVal, oldVal){\n    let rowNum = 0;\n    rowNum = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n    console.log(rowNum);\n    for (let i = 1; i <= rowNum; i++) {\n        let pvp = $(\"#grd_valores_siniestros_alcance\").getValue(i,5);\n        pvp = roundToFixed(pvp, 2);\n        $(\"#grd_valores_siniestros_alcance\").setValue(pvp,i,5);\n\n        let dias_entrega = $(\"#grd_valores_siniestros_alcance\").getValue(i,6);\n        dias_entrega = roundToFixed(dias_entrega, 0);\n        $(\"#grd_valores_siniestros_alcance\").setValue(dias_entrega,i,6);\n    }\n}\n\ncheckGrid($(\"#grd_valores_siniestros_alcance\").getValue(), '');\n$('#grd_valores_siniestros_alcance').change(checkGrid);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_valores_siniestros_alcance","var_uid":"5075160946562eecb97c8b7082494986","dataType":"grid","protectedValue":false,"id":"grd_valores_siniestros_alcance","name":"grd_valores_siniestros_alcance","label":"PROFORMA","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_gvs_cantidad_1","name":"frm_gvs_cantidad_1","label":"Cantidad","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[-+]?[0-9]+$","validateMessage":"Solo números","maxLength":"2","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memo