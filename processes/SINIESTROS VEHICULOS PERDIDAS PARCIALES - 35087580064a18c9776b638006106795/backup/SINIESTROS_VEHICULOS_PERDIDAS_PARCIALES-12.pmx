l":"","memoryCache":false,"var_name":"frm_siniestro_nombreResponsable","colSpan":6}]],"variables":[{"var_uid":"86078996364a5ea3db390b3029062271","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_requiere_PartePolicial","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"53896923164a5ea52d0b9a2095798782","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_requiere_AsesoriaLegal","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"47648186964a5ec44957396070016895","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_afectado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"806302141653aca7ed3b8b1014028540","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_informacionResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"917378942653acad9c095c7075960765","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_placaResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"765788563653acae2843f40000288141","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_siniestro_nombreResponsable","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"subtitle","id":"subt_asegurado","label":"<span class=\"subtitulo\" id=\"isubt_asegurado\" subform=\"15180521364a5eaf5f02815065887190\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos Conductor<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"15180521364a5eaf5f02815065887190","name":"SubForm Datos Conductor","description":"SubForm Datos Conductor","mode":"disabled","script":{"type":"js","code":"\/\/henry\nlet tipoSolicitud = $(\"#frm_asegurado_tipo\").getValue();\nif (tipoSolicitud == 'A') {\nlet cedula = $(\"#frm_busqueda_identificacion\").getValue();\nlet nombres = $(\"#frm_busqueda_nombres\").getValue();\nlet telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n  $(\"#frm_asegurado_identificacion\").setValue(cedula);\n  $(\"#frm_asegurado_nombres\").setValue(nombres);\n  $(\"#frm_asegurado_telefono\").setValue(telefono);  \n  \n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n  $(\"#frm_asegurado_relacion\").hide();\n  $(\"#frm_asegurado_relacion_otro\").hide();\n} \n\n\nfunction checkDatosConductor(newVal, oldVal) {\n  if (newVal == 'A') {\n    let cedula = $(\"#frm_busqueda_identificacion\").getValue();\n    let nombres = $(\"#frm_busqueda_nombres\").getValue();\n    let telefono = $(\"#frm_busqueda_celular_1\").getValue();\n\n      $(\"#frm_asegurado_identificacion\").setValue(cedula);\n      $(\"#frm_asegurado_nombres\").setValue(nombres);\n      $(\"#frm_asegurado_telefono\").setValue(telefono);  \n      \n      $(\"#frm_asegurado_relacion\").hide();\n      $(\"#frm_asegurado_relacion_otro\").hide();\n  } else {\n    $(\"#frm_asegurado_identificacion\").setValue('');\n      $(\"#frm_asegurado_nombres\").setValue('');\n      $(\"#frm_asegurado_telefono\").setValue('');  \n      \n    $(\"#frm_asegurado_relacion\").show();\n    $(\"#frm_asegurado_relacion_otro\").show();\n    \n\n  }\n  console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n\/\/execute when the Dynaform loads:\ncheckDatosConductor($(\"#frm_asegurado_tipo\").getValue(), ''); \n$('#frm_asegurado_tipo').setOnchange(checkDatosConductor);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_asegurado_tipo","var_uid":"30865455164a5eb03105167001606129","dataType":"string","protectedValue":false,"id":"frm_asegurado_tipo","name":"frm_asegurado_tipo","label":"Tipo de conductor","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione ---"},{"value":"A","label":"Asegurado"},{"value":"O","label":"Otro"}],"var_name":"frm_asegurado_tipo","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_asegurado_identificacion","var_uid":"35959853464a5eb33eab333020957592","dataType":"string","protectedValue":false,"id":"frm_asegurado_identificacion","name":"frm_asegurado_identificacion","label":"Identificacion","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_asegurado_identificacion","colSpan":4},{"type":"text","variable":"frm_asegurado_nombres","var_uid":"83276475364a5eb1720fba5018137683","dataType":"string","protectedValue":false,"id":"frm_asegurado_nombres","name":"frm_asegurado_nombres","label":"Nombres","tabIndex":