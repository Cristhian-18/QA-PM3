ault","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_taller_fechaIngreso","colSpan":6}],[{"type":"dropdown","variable":"frm_taller_transitoVehiculo","var_uid":"69842081564f7ec943d7775050575522","dataType":"string","protectedValue":false,"id":"frm_taller_transitoVehiculo","name":"frm_taller_transitoVehiculo","label":"\u00bfVeh\u00edculo en Tr\u00e1nsito?","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[],"var_name":"frm_taller_transitoVehiculo","colSpan":12}]],"variables":[{"var_uid":"16133680964f7ec4f3ba778097177962","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_taller_ExisteVehiculo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"67796428064f7ec75df9755077397870","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_taller_fechaIngreso","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"69842081564f7ec943d7775050575522","prj_uid":"35087580064a18c9776b638006106795","var_name":"frm_taller_transitoVehiculo","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
