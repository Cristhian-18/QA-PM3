fectados\" subform=\"24440509064a84d82d7a6e4090951046\"> <i class=\"glyphicon glyphicon-minus\"></i> \nVehículos afectados</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"24440509064a84d82d7a6e4090951046","name":"SubForm Datos Vehiculos Afectados","description":"SubForm Datos Vehiculos Afectados","mode":"parent","script":{"type":"js","code":"//SI ESTÁ CREADO, DESHABILITAR\n\n//TODO REMOVER TRY CATCH CUANDO FUNCIONE CORRECTAMENTE\ntry {\n    var grdAfectados = $(\"#grd_vehiculos_afectados\").getNumberRows();\n    for (var i = 1; i <= grdAfectados; i++) {\n        if ($(\"#grd_vehiculos_afectados\").getValue(i, 8) == \"1\") {\n            console.log(i);\n            var numCols = 10;\n            for (var j = 1; j <= numCols; j++) {\n                console.log(j);\n                $(\"#grd_vehiculos_afectados\").getControl(i, j).attr('disabled', true);\n                try {\n                    var row = $($(\"#grd_vehiculos_afectados\").find(\"div.pmdynaform-grid-row\")[i - 1]);\n                    var button = row.find(\".remove-row\");\n                    button.hide();\n                } catch (e) {\n                    console.log(e);\n                }\n\n\n            }\n        }\n    }\n}\ncatch (e) {\n    console.log(e);\n}\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"grid","variable":"grd_vehiculos_afectados","var_uid":"69777410364a84d9b71b727073283582","dataType":"grid","protectedValue":false,"id":"grd_vehiculos_afectados","name":"grd_vehiculos_afectados","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"dropdown","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"frm_vafectado_marca","name":"frm_vafectado_marca","label":"Marca","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"