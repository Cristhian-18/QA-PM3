        <dyn_content><![CDATA[{"name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"90186884165530aa6caee56030233529","name":"Form 6 Cotizar Alcance Mundo Partes","description":"Form 6 Cotizar Alcance Mundo Partes","mode":"edit","script":{"type":"js","code":"$(\"#grd_valores_siniestros_alcance\").hideColumn(9);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(11);\n\n\nfunction checkNewGrid(newVal, oldVal) {\n  console.log(\"CHECK\");\n  let rowNum = 0;\n  rowNum = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n  console.log(rowNum);\n  for (let i= 1; i <= rowNum; i++) {\n      let disponible = $(\"#grd_valores_siniestros_alcance\").getValue(i, 7);\n\n      if (disponible == \"DISPONIBLE\") {\n          $(\"#grd_valores_siniestros_alcance\").setValue(\"Aprobado\", i,11);\n      } \n      if (disponible == \"IMPORTACIÓN\") {\n        $(\"#grd_valores_siniestros_alcance\").setValue(\"Pendiente\", i,11);\n    } \n    if (disponible == \"FABRICACION\") {\n      $(\"#grd_valores_siniestros_alcance\").setValue(\"Indemnizacion\", i,11);\n  \n    }\n     \n  }\n}\ncheckNewGrid($(\"#grd_valores_siniestros_alcance\").getValue(), '');\n$(\"#grd_valores_siniestros_alcance\").change(checkNewGrid);\n\n\n$('.menu').on('click', function () {\n  ocultar_todo();\n  console.log(this.id)\n  console.log(\"CAMBIO\")\n  switch (this.id) {\n    case 'solicitud':\n      mostrar_solicitud();\n      break;\n    case 'documentos':\n      $(\"#subt_docs\").show();\n      $(\"#418835952652a78d09ec638009652152\").show();\n      break;\n    case 'historial':\n      $(\"#sbt_historial\").show();\n      $(\"#200528691652a78b49077a9030935355\").show();\n      break;\n    case 'repuestos':\n      $('#sub_valores').show()\n      $('#3333297516562f070836c34088397701').show()\n      break\n  }\n  $(\"#frm_documentos_otros\").hide();\n\n});\n\n\nfunction ocultar_todo() {\n  $(\"#sub_busqueda\").hide();\n  $(\"#56711039964a8241d124701020566530\").hide();\n  $(\"#subt_vehiculo\").hide();\n  $(\"#95746246564a4a9c711dfb2023501124\").hide();\n  $(\"#subt_asegurado\").hide();\n  $(\"#15180521364a5eaf5f02815065887190\").hide();\n  $(\"#subt_detalle\").hide();\n  $(\"#61446768964a848b295ae19072670821\").hide();\n  $(\"#subt_registro\").hide();\n  $(\"#22536303964a5e5cc12a673090504456\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#24440509064a84d82d7a6e4090951046\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#59581944164a84e6bc66f02025995827\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#83626962464a84f217fbb30019736581\").hide();\n  $(\"#sub_docs\").hide();\n  $(\"#24155013164a5edc37a3b68095174528\").hide();\n  $(\"#sub_valores\").hide();\n  $('#470410481653944a172eeb1027144131').hide()\n  $(\"#79905380564f7ece7bc8989091267394\").hide();\n  $(\"#subt_docs\").hide();\n  $(\"#418835952652a78d09ec638009652152\").hide();\n  $(\"#sbt_historial\").hide();\n  $(\"#200528691652a78b49077a9030935355\").hide();\n  $(\"#subt_poliza\").hide();\n  $(\"#12366487464a4a855bed4c8081629548\").hide();\n  $(\"#subt_hsiniestros\").hide();\n  $(\"#14870785564a5e392d24239097281950\").hide();\n  $(\"#subt_ppolicial\").hide();\n  $(\"#82315095164a5ea0d445d33098806451\").hide();\n  $(\"#subt_direccionador\").hide();\n  $(\"#34599290264a5ec882dda43091413149\").hide();\n  $(\"#subt_friss\").hide();\n  $(\"#88678649164f7eaea023df2027918886\").hide();\n\n  $(\"#subt_accidente\").hide();\n  $(\"#342283484650ba7c9f2fd13056558401\").hide();\n  //$(\"#subt_ve_afectados\").hide();\n  //$(\"#24440509064a84d82d7a6e4090951046\").hide();\n  $(\"#isubt_pe_afectados\").hide();\n  $(\"#59581944164a84e6bc66f02025995827\").hide();\n  $(\"#iisubt_pr_afectados\").hide();\n  $(\"#83626962464a84f217fbb30019736581\").hide();\n  $(\"#65277878264f7ec384dd014099215285\").hide();\n  $('#3333297516562f070836c34088397701').hide()\n\n}\nfunction mostrar_solicitud() {\n  $(\"#sub_busqueda\").show();\n  $(\"#56711039964a8241d124701020566530\").show();\n  $(\"#subt_vehiculo\").show();\n  $(\"#95746246564a4a9c711dfb2023501124\").show();\n  $(\"#subt_asegurado\").show();\n  $(\"#15180521364a5eaf5f02815065887190\").show();\n  //$(\"#subt_detalle\").show();\n  //$(\"#61446768964a848b295ae19072670821\").show();\n  //$(\"#subt_registro\").show();\n  //$(\"#22536303964a5e5cc12a673090504456\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#24440509064a84d82d7a6e4090951046\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#59581944164a84e6bc66f02025995827\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#83626962464a84f217fbb30019736581\").show();\n  $(\"#sub_docs\").show();\n  $(\"#24155013164a5edc37a3b68095174528\").show();\n  $(\"#79905380564f7ece7bc8989091267394\").show();\n  $(\"#subt_poliza\").show();\n  $(\"#12366487464a4a855bed4c8081629548\").show();\n  $(\"#subt_hsiniestros\").show();\n  $(\"#14870785564a5e392d24239097281950\").show();\n  $(\"#subt_ppolicial\").show();\n  $(\"#82315095164a5ea0d445d33098806451\").show();\n  $(\"#subt_direccionador\").show();\n  $(\"#34599290264a5ec882dda43091413149\").show();\n  $(\"#subt_friss\").show();\n  $(\"#88678649164f7eaea023df2027918886\").show();\n  $(\"#subt_accidente\").show();\n  $(\"#342283484650ba7c9f2fd13056558401\").show();\n  //$(\"#subt_ve_afectados\").show();\n  //$(\"#24440509064a84d82d7a6e4090951046\").show();\n  $(\"#isubt_pe_afectados\").show();\n  $(\"#59581944164a84e6bc66f02025995827\").show();\n  $(\"#iisubt_pr_afectados\").show();\n  $(\"#83626962464a84f217fbb30019736581\").show();\n  $(\"#65277878264f7ec384dd014099215285\").show();\n\n\n}\n\nocultar_todo();\nmostrar_solicitud();\n\n$(\"#90186884165530aa6caee56030233529\").setOnSubmit(function(){\n  if ($(\"#frm_accion\").getValue() == 'MANTENER') {\n    return true;\n}\n    var aRc = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n    for (var i=0; i <= aRc; i++) {\n        let aprobacion = $(\"#grd_valores_siniestros_alcance\").getValue(i, 7);\n        if (aprobacion == null || aprobacion == \"\") {\n                alert(\"Por favor, revise la disponibilidad de todos los productos\");\n                return false;\n        }\n    }\n    return true;\n  }\n);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"GENERAR COTIZACIÓN","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"751193235652a791dc69c78095996330","name":"SubForm Vinetas","description":"SubForm Vinetas","mode":"edit","script":{"type":"js","code":""},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"panel","id":"pnl_vinetas","content":"<ul class=\"nav nav-tabs\">\n  <li id=\"solicitud\" class=\"menu active\"><a data-toggle=\"tab\" href=\"#\"><h4>Solicitud</h4></a></li>\n  <li id=\"repuestos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Repuestos</h4></a></li>\n  <li id=\"documentos\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Documentos</h4></a></li>  \n  <li id=\"historial\" class=\"menu\"><a data-toggle=\"tab\" href=\"#\"><h4>Historial</h4></a></li>\n</ul>","border":"1px","colSpan":12}]],"variables":[],"colSpan":12}],[{"type":"subtitle","id":"subt_direccionador","label":"<span class=\"subtitulo\" id=\"isubt_direccionador\" subform=\"34599290264a5ec882dda43091413149\"> <i class=\"glyphicon glyphicon-minus\"></i> \nInformación del taller</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"34599290264a5ec882dda43091413149","name":"SubForm Información delTaller","description":"SubForm Direccionador Taller","mode":"disabled","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_taller","var_uid":"97506618964a5ecc01b6f42073254849","dataType":"string","protectedValue":false,"id":"frm_taller","name":"frm_taller","label":"Taller","tabIndex":"","defaultValue"