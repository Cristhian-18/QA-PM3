        <dyn_content><![CDATA[{"name":"Form 6.2 Aprobaci\u00f3n Importaci\u00f3n Alcance","description":"Form 6.2 Aprobaci\u00f3n Importaci\u00f3n Alcance","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4570974636570970a5c9c82040941858","name":"Form 6.2 Aprobaci\u00f3n Importaci\u00f3n Alcance","description":"Form 6.2 Aprobaci\u00f3n Importaci\u00f3n Alcance","mode":"edit","script":{"type":"js","code":"let numberRows = $(\"#grd_valores_siniestros_alcance\").getNumberRows();\n\n$(\"#grd_valores_siniestros_alcance\").hideColumn(5);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(7);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(8);\n$(\"#grd_valores_siniestros_alcance\").hideColumn(9);\n\nlet rows = $(\".pmdynaform-grid-row\");\nlet length = $(\".pmdynaform-grid-row\").length-1;\n\nlet negados = $(\"option[value='Negado']\");\nlet pendientes = $(\"option[value='Pendiente']\");\n\nfor (let i = 0; i <= length; i++) {\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 3).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 4).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 5).attr('disabled', true);\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 6).attr('disabled', true)\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 7).attr('disabled', true)\n    $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 8).attr('disabled', true)\n\n    if(($(\"#grd_valores_siniestros_alcance\").getValue(i+1, 11))!=\"Pendiente\"){\n        $(rows[i]).hide();\n    } else {\n        $(\"#grd_valores_siniestros_alcance\").getControl(i+1, 11).attr('required', true)\n        $(negados[i]).hide();\n        $(pendientes[i]).hide();\n    }\n\n}\n\n\/*$(\"option[value='Negado']\").remove();\n$(\"option[value='Pendiente']\").remove();*\/\n\nlet isBoss = confirm(\"Estimado cliente: \\nPor favor, apruebe la importaci\u00f3n de los siguientes repuestos o en su defecto solicite su indemnizaci\u00f3n, en caso de no seleccionar ninguno de los dos se aprobar\u00e1n por defecto\");\n\ndocument.onload = function () {\nalert( isBoss );\n}\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"tlt_principal","label":"NOTIFICACI\u00d3N SINIESTROS VEH\u00cdCULOS","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"57401040965394f81a5fed8042028672","name":"SubForm Mensaje Siniestro","description":"SubForm Mensaje Siniestro","mode":"edit","script":{"type":"js","code":"\/* original henry\nvar id_op = $(\"#html_op\").html('Id Stro - '+$(\"#tri_id_stro\").getValue()+' | '+'Nro Stro - '+$(\"#tri_nro_stro\").getValue());\n*\/\n$(\"#tri_id_stro\").setValue(\"12345\");\n$(\"#tri_nro_stro\").setValue(\"9863\");\n\n$(\"#id-stro\").html(''+$(\"#tri_id_stro\").getValue());\n$(\"#nro-stro\").html(''+$(\"#tri_nro_stro\").getValue());"},"language":"en","externalLibs":"\/plugin\/beesmartec\/core_librerias\/js_externos\/app.min.js,\n\n\/plugin\/beesmartec\/core_librerias\/css_externos\/AdminLTE.min.css, \/plugin\/beesmartec\/core_librerias\/ionicons-2.0.1\/css\/ionicons.min.css","printable":false,"items":[[{"type":"panel","id":"pnl_op","content":"<div class=\"col-md-3\"><\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-bookmark\" style=\"\"><\/i><\/span>\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n        <strong>ID SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id=\"id-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3 col-sm-6 col-xs-12 text-center\">\n  <div class=\"info-box box box-primary\"> \n    <span class=\"info-box-icon bg-blue\"><i class=\"ion ion-pin\"><\/i><\/span>\n\n    <div class=\"info-box-content\">\n      <span class=\"info-box-text\">\n       <strong> NUMERO SINIESTRO:<\/strong>\n      <\/span>\n      <span class=\"info-box-number\"><strong id = \"nro-stro\"><\/strong><\/span>\n    <\/div>\n    <!-- \/.info-box-content -->\n  <\/div>\n  <!-- \/.info-box -->\n<\/div>\n<div class=\"col-md-3\"><\/div>\n\n\n\n\n<!-- ORIGINAL HENRY\n<div class=\"box-body text-center\">\n  <div class=\"alert alert-warning alert-dismissible\">\n    <h4><i class=\"icon fa fa-warning\"><\/i> Mensaje...!<\/h4>\n    <h2><div id=\"html_op\"><\/div><\/h2>\n  <\/div>\n<\/div>\n-->\n","border":"1px","colSpan":12}],[{"type":"hidden","variable":"tri_id_stro","var_uid":"22541636561df31c8065066073006658","dataType":"string","protectedValue":false,"id":"tri_id_stro","name":"tri_id_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_id_stro","colSpan":2},{"type":"hidden","variable":"tri_nro_stro","var_uid":"23510320361df31d0abbeb1025197251","dataType":"string","protectedValue":false,"id":"tri_nro_stro","name":"tri_nro_stro","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_nro_stro","colSpan":2},{"type":"hidden","variable":"tri_bandera_parcial","var_uid":"96928939765394f89a07cd8013571539","dataType":"string","protectedValue":false,"id":"tri_bandera_parcial","name":"tri_bandera_parcial","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_parcial","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_estimado","var_uid":"85104247565394f89a40d51072446619","dataType":"string","protectedValue":false,"id":"tri_imp_monto_estimado","name":"tri_imp_monto_estimado","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_imp_monto_estimado","colSpan":2},{"type":"hidden","variable":"tri_imp_monto_pagado","var_uid":"37089132765394f89a722c2062008643","dataType":"string","protectedValue":f