rorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"767168442652152578f74c7023751348","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-z A-Z\\u00C0-\\u00FF]*$","validateMessage":"Ingrese el nombre del cliente","maxLength":"60","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_linea","var_uid":"43873387965215257904668099286919","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_linea","name":"frm_datosSolicitud_linea","label":"Línea de Negocio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'LINEA_NEGOCIO' AND VALOR =\"C\" AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_linea","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_ramo","var_uid":"85695973065215257905819005884866","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_ramo","name":"frm_datosSolicitud_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMO' AND VALOR != \"AP\" AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_ramo","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_sucursal","var_uid":"17113619265215257908c77097696713","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_sucursal","name":"frm_datosSolicitud_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSAL' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_sucursal","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_solicitante","var_uid":"12690539265215257907af6062235097","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_solicitante","name":"frm_datosSolicitud_solicitante","label":"Ejecutivo Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT U.USR_USERNAME, upper(CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME)) AS NAME\nFROM USERS U, GROUP_USER G WHERE U.USR_UID = G.USR_UID AND GRP_UID IN ('6774117196513a4d7375257095041040','2214584856513b058d1f5a7070402036')","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_solicitante","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_directorComercial","var_uid":"202330195652152578f8629004660615","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorComercial","name":"frm_datosSolicitud_directorComercial","label":"Director Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME) AS NAME\nFROM ADMIN_CATALOGOS A\nJOIN USERS U \n  ON A.CAMPO1 COLLATE utf8mb4_0900_ai_ci \n   = U.USR_USERNAME\nWHERE PRO_UID = '42420581765087d55c278c7052161956'\n  AND COD_CATALOGO = 'DELEGACION_DIRECTORES'\n  AND ESTADO = 1 AND CODIGO = '@#frm_datosSolicitud_solicitante';","memoryCache":false,"var_name":"frm_datosSolicitud_directorComercial","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_directorEspecialista","var_uid":"939160899652152578f97e4011610681","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorEspecialista","name":"frm_datosSolicitud_directorEspecialista","label":"Director Especialista","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"",