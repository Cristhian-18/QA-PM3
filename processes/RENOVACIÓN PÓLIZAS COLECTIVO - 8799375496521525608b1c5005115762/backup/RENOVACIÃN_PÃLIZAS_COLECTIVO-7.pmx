        <dyn_content><![CDATA[{"name":"Form 8 Solicitud de Renovaci\u00f3n","description":"Form 8 Solicitud de Renovaci\u00f3n","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"67951103265215257846180099033149","name":"Form 8 Solicitud de Renovaci\u00f3n","description":"Form 8 Solicitud de Renovaci\u00f3n","mode":"edit","script":{"type":"js","code":"\/\/\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n $(\"#frm_emisor_asignado_apro\").hide();\n $(\"#frm_emisor_asignado_apro\").disableValidation();\n\nfunction action(newVal, oldVal) {\n   $(\"#frm_emisor_asignado_apro\").disableValidation();\n\n    if (newVal == 'CONTINUAR') {\n        $(\"#frm_emisor_asignado_apro\").show();\n       $(\"#frm_emisor_asignado_apro\").enableValidation();\n\n    } else {\n       $(\"#frm_emisor_asignado_apro\").hide();\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n\/\/execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(action);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisi\u00f3n (Cotizaci\u00f3n Comercial)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"><\/i> \nDatos de la solicitud<\/span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"238363030652152578450a0095479933","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"\/\/Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"8196240416521525790afc7036639704","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND CODIGO = 'Renovacion' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"40564984665215257902388024375880","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screensh