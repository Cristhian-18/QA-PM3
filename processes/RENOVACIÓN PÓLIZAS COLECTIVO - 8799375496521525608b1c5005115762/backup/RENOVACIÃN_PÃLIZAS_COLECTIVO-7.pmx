\"#frm_datosCotizacion_porcentajeComision\").setValue(value);\n})\n//frm_datosCotizacion_primaGanada\n//frm_datosCotizacion_resultadoTecnico\n$(\"#frm_datosCotizacion_primaGanada\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_primaGanada\").setValue(value);\n})\n\n$(\"#frm_datosCotizacion_resultadoTecnico\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_resultadoTecnico\").setValue(value);\n})\n\n$(\"#frm_datosCotizacion_valorRazon\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorRazon\").setValue(value);\n})\n\n$(\"#frm_datosCotizacion_valorSiniestros\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorSiniestros\").setValue(value);\n})\n\n$(\"#frm_datosCotizacion_valorComision\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_valorComision\").setValue(value);\n})\n\n$(\"#frm_datosCotizacion_primaNeta\").setOnchange(function(newVal, oldVal) {\n  console.log(newVal);\n  let max = 100000000;\n  let min = -100000000;\n  let value = limitMaxMin(newVal, max, min);\n  if(value!=''){\n    value = roundToFixed(value, 2);\n  }\n  $(\"#frm_datosCotizacion_primaNeta\").setValue(value);\n})\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"text","variable":"frm_datosCotizacion_primaNeta","var_uid":"851242538652152578ed693060998963","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaNeta","name":"frm_datosCotizacion_primaNeta","label":"Prima Neta","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaNeta","colSpan":6},{"type":"text","variable":"frm_datosCotizacion_primaGanada","var_uid":"456805720652152578ec5c5061547053","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_primaGanada","name":"frm_datosCotizacion_primaGanada","label":"Prima Ganada","tabIndex":"","defaultValue":"","placeholder":"0000.00","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^-?[0-9]\\d*(\\.\\d+)?$","validateMessage":"Por favor ingrese un monto (revise el separador decimal), solo se admiten 2 decimales","maxLength":1000,"formula":" ","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosCotizacion_primaGanada","colSpan":6}],[{"type":"text","variable":"frm_datosCotizacion_resultadoTecnico","var_uid":"135240910652152578ee7d6009066069","dataType":"string","protectedValue":false,"id":"frm_datosCotizacion_resultadoTecnico","name":"frm_datosCotizacion_resultadoTecnico","label":"Resultado Técnico","tabIndex":"","defaultValue":"","placeholder":"0000.00","hi