nOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME) AS NAME\nFROM ADMIN_CATALOGOS A\nJOIN USERS U \n  ON A.CAMPO1 COLLATE utf8mb4_0900_ai_ci \n   = U.USR_USERNAME\nWHERE PRO_UID = '42420581765087d55c278c7052161956'\n  AND COD_CATALOGO = 'DELEGACION_DIRECTORES'\n  AND ESTADO = 1 AND CODIGO = '@#frm_datosSolicitud_solicitante';","memoryCache":false,"var_name":"frm_datosSolicitud_directorComercial","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_directorEspecialista","var_uid":"939160899652152578f97e4011610681","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorEspecialista","name":"frm_datosSolicitud_directorEspecialista","label":"Director Especialista","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"\nSELECT CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME) AS NAME\nFROM ADMIN_CATALOGOS A\nJOIN USERS U\n  ON A.CAMPO2 COLLATE utf8mb4_0900_ai_ci = U.USR_USERNAME\nWHERE PRO_UID = '42420581765087d55c278c7052161956'\n  AND COD_CATALOGO = 'DELEGACION_DIRECTORES'\n  AND ESTADO = 1\n AND CODIGO = '@#frm_datosSolicitud_solicitante';","memoryCache":false,"var_name":"frm_datosSolicitud_directorEspecialista","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_suscriptorAsignado","var_uid":"30547272265215257909d26094065833","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_suscriptorAsignado","name":"frm_datosSolicitud_suscriptorAsignado","label":"Suscriptor Asignado","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":""