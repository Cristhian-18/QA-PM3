echaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_poliza","var_uid":"54833714765218d9fa45445040336741","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_poliza","name":"frm_datosSolicitud_poliza","label":"Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"Ingrese solo números de póliza","maxLength":"13","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_poliza","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"62076699365215257906959002558107","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"767168442652152578f74c7023751348","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-z A-Z\\u00C0-\\u00FF]*$","validateMessage":"Ingrese el nombre del cliente","maxLength":"60","formula":"","dependsOn":"","loadDropdownOptions":"","externalApi"