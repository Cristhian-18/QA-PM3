        <dyn_content><![CDATA[{"name":"Form 2 Apronacion MDA","description":"Form 2 Apronacion MDA ","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"5218058106521525784b912041091855","name":"Form 2 Apronacion MDA","description":"Form 2 Apronacion MDA ","mode":"edit","script":{"type":"js","code":"$(\"#btn_consultar\").hide();\n$(\"#frm_datosSolicitud_fechaDictamen1\").hide();\n$(\"#frm_datosSolicitud_suscriptorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacion\").hide();\n$(\"#frm_datosSolicitud_fechaAceptacion\").hide();\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n $(\"#fileComiteSuscripcion\").hide();\n$(\"#fileComiteSuscripcion\").disableValidation();\nfunction checkAccion(newVal, oldVal) {\n  \t$(\"#fileComiteSuscripcion_c\").hide();\n\t$(\"#fileComiteSuscripcion_c\").disableValidation();\n    if (newVal == 'CONTINUAR') {\n      if ($(\"#tri_bandera_mda\").getValue() == 'true') {\n            $(\"#fileComiteSuscripcion_c\").show();\n            $(\"#fileComiteSuscripcion_c\").enableValidation();\n        }\n    } \n}\n//execute when the Dynaform loads:\ncheckAccion($(\"#frm_accion_c\").getValue(), ''); \n$('#frm_accion_c').setOnchange(checkAccion);"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Aprobación del caso técnico","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"238363030652152578450a0095479933","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"8196240416521525790afc7036639704","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND CODIGO = 'Renovacion' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"40564984665215257902388024375880","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_poliza","var_uid":"54833714765218d9fa45445040336741","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_poliza","name":"frm_datosSolicitud_poliza","label":"Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"Ingrese solo números de póliza","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_poliza","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"62076699365215257906959002558107","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"767168442652152578f74c7023751348","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-z A-Z\\u00C0-\\u00FF]*$","validateMessage":"Ingrese el nombre del cliente","maxLength":"60","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_linea","var_uid":"43873387965215257904668099286919","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_linea","name":"frm_datosSolicitud_linea","label":"Línea de Negocio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'LINEA_NEGOCIO' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_linea","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_ramo","var_uid":"85695973065215257905819005884866","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_ramo","name":"frm_datosSolicitud_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMO' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_ramo","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_sucursal","var_uid":"17113619265215257908c77097696713","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_sucursal","name":"frm_datosSolicitud_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSAL' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_sucursal","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_solicitante","var_uid":"12690539265215257907af6062235097","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_solicitante","name":"frm_datosSolicitud_solicitante","label":"Ejecutivo Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT U.USR_USERNAME, upper(CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME)) AS NAME\nFROM USERS U, GROUP_USER G WHERE U.USR_UID = G.USR_UID AND GRP_UID IN ('6774117196513a4d7375257095041040','2214584856513b058d1f5a7070402036')","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_solicitante","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_directorComercial","var_uid":"202330195652152578f8629004660615","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_directorComercial","name":"frm_datosSolicitud_directorComercial","label":"Director Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldError