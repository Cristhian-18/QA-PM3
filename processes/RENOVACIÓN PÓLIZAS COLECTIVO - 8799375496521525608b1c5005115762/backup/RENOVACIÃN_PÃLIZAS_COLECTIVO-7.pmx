        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[//Obtener datos iniciales Solicitud

@@frm_datosSolicitud_fechaSolicitud = date('Y-m-d');
@@tri_user_inicial = @@USER_LOGGED;

@@frm_accion = null;

