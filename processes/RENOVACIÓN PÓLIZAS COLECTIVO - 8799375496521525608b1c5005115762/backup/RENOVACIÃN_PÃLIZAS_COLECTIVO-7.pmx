        <dyn_content><![CDATA[{"name":"Form8 Respuesta FVC","description":"Form8 Respuesta FVC","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"92731426665215257859a92031300079","name":"Form8 Respuesta FVC","description":"Form8 Respuesta FVC","mode":"edit","script":{"type":"js","code":"//\n\n$(\"#frm_comentario\").setValue('FORMULARIO VALIDADO');\n$(\"#btn_consultar\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n\nfunction action(newVal, oldVal) {\n  $(\"#fileComiteSuscripcion_c\").hide();\n   $(\"#fileComiteSuscripcion_c\").disableValidation();\n  \n  if (newVal == 'CONTINUAR') {\n        $(\"#fileComiteSuscripcion_c\").show();\n   \t\t$(\"#fileComiteSuscripcion_c\").enableValidation();\n    } \n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(action);\n\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Renovación","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"id_datos\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud\n</span>","ariaLabel":"<span class=\"subtitulo\" id=\"id_datos\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud\n</span>","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"238363030652152578450a0095479933","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"8196240416521525790afc7036639704","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND CODIGO = 'Renovacion' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"40564984665215257902388024375880","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_poliza","var_uid":"54833714765218d9fa45445040336741","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_poliza","name":"frm_datosSolicitud_poliza","label":"Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"Ingrese solo números de póliza","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_poliza","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"62076699365215257906959002558107","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"767168442652152578f74c7023751348","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":""