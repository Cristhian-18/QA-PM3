ado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}]],"variables":[{"var_uid":"886644917652152578dc7b7056544305","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_accion","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"886644917652152578dc7b7056544305","var_name_old":"frm_accion","prj_uid_old":"8799375496521525608b1c5005115762","create":false},{"var_uid":"428911244652152578d4be5042642353","prj_uid":"8799375496521525608b1c5005115762","var_name":"fle_borrador_poliza","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"668824410652152578e0347024334398","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"668824410652152578e0347024334398","var_name_old":"frm_comentario","prj_uid_old":"8799375496521525608b1c5005115762","create":false}]}]}]]></dyn_content>
