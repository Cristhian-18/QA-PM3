$app_number = @@APP_NUMBER;
$tipo_req = @@frm_datosSolicitud_tipo_label;
$user = @@USER_LOGGED;
$sql = "SELECT USR_EMAIL MAIL FROM USERS WHERE USR_UID  = '$user'";
$resultadoCorreos = executeQuery($sql);
$responsable_emision_mail = $resultadoCorreos[1]['MAIL'];
$cc = $resultadoCorreos[1]['CAMPO2'];

if (@@frm_responsable_emision_mail == '') {
    @@frm_responsable_emision_mail = $responsable_emision_mail;
}

//validacion por tarea
switch (@@TASK) {
    //tarea 1
    case '425464187652152567c32c0021157413':
        $de = '';
        $para = @@frm_responsable_emision_mail;

        $bcc = '';
        $asunto = "Notificación de caso en BPM $app_number";
        $texto = '<p align="justify">Estimado(a),&nbsp;Colaborador</p>';
        $texto .= '<p align="justify">Se le notifica que se requiere la asignación del caso ' . $app_number . ' de tipo ' . $tipo_req . ' para su realización, por favor gestionarlo de acuerdo a las condiciones solicitadas</tipo></p>';
        $comentario = @@frm_comentario;
        $accion     = @@frm_accion;
        $plantilla_rec = 'Plantilla_mail.html';

        @@envio_mail_t1 = PMFSendMessage(@@APPLICATION, $de, $para, $cc, $bcc, $asunto, $plantilla_rec, array('tri_texto_mail' => $texto));



