ld":"52798821664ffb970ee8f04059416867","var_name_old":"PROCESS","prj_uid_old":"67967569564a6f1f7e1a4c1023520123"},{"var_uid":"232680942652152578dea99040385603","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_caso_estado","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}]],"variables":[{"var_uid":"67602437665399318917312040800165","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_accion_t","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"607701858652152578d0334016841452","prj_uid":"8799375496521525608b1c5005115762","var_name":"fileComiteSuscripcion","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"668824410652152578e0347024334398","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"69445867465215257936f40011076465","prj_uid":"8799375496521525608b1c5005115762","var_name":"tri_bandera_mda","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
