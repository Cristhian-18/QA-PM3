        <dyn_content><![CDATA[{"name":"Form 4 Presentar Renovacion","description":"Form 4 Presentar Renovacion","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"4782195436521525784de28011750751","name":"Form 4 Presentar Renovacion","description":"Form 4 Presentar Renovacion","mode":"edit","script":{"type":"js","code":"//\n$(\"#frm_accion\").setValue('');\n$(\"#btn_consultar\").hide();\n$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n\n\n$(\"#frm_negocioPerdido_cobertura\").disableValidation();\n$(\"#frm_negocioPerdido_tasa\").disableValidation();\n$(\"#frm_negocioPerdido_beneficios\").disableValidation();\n$(\"#frm_negocioPerdido_prima\").disableValidation();\n$(\"#frm_negocioPerdido_comision\").disableValidation();\n$(\"#frm_negocioPerdido_medica\").disableValidation();\n$(\"#frm_negocioPerdido_honorarios\").disableValidation();\n\nfunction action(newVal, oldVal) {\n  console.log(newVal);\n    $(\"#id_motivo_perdida\").hide();\n\t$(\"#85209770465215257843f31087684138\").hide();\n    $(\"#93586775565215257852650013099141\").hide();\n    $(\"#frm_resultadoNegociacion_resultado\").hide();\n    $(\"#frm_resultadoNegociacion_fechaAceptacion\").hide();\n    $(\"#frm_resultadoNegociacion_fechaUltimoEnvio\").hide();\n    $(\"#fle_aprobacion_cliente\").hide();  \n    $(\"#fle_mas_docs\").hide();\n    $(\"#frm_resultadoNegociacion_resultado\").disableValidation();\n    $(\"#frm_resultadoNegociacion_fechaAceptacion\").disableValidation();\n    $(\"#frm_resultadoNegociacion_fechaUltimoEnvio\").disableValidation();\n    $(\"#fle_aprobacion_cliente\").disableValidation();  \n    \n  \n  $(\"#frm_negocioPerdido_cobertura\").disableValidation();\n            $(\"#frm_negocioPerdido_tasa\").disableValidation();\n            $(\"#frm_negocioPerdido_beneficios\").disableValidation();\n            $(\"#frm_negocioPerdido_prima\").disableValidation();\n            $(\"#frm_negocioPerdido_comision\").disableValidation();\n            $(\"#frm_negocioPerdido_medica\").disableValidation();\n            $(\"#frm_negocioPerdido_honorarios\").disableValidation();\n    if (newVal == 'FINALIZAR') {\n        $(\"#id_motivo_perdida\").show();\n      \t$(\"#85209770465215257843f31087684138\").show();\n      $(\"#frm_negocioPerdido_cobertura\").enableValidation();\n        $(\"#frm_negocioPerdido_tasa\").enableValidation();\n        $(\"#frm_negocioPerdido_beneficios\").enableValidation();\n        $(\"#frm_negocioPerdido_prima\").enableValidation();\n        $(\"#frm_negocioPerdido_comision\").enableValidation();\n        $(\"#frm_negocioPerdido_medica\").enableValidation();\n        $(\"#frm_negocioPerdido_honorarios\").enableValidation();\n    } else  if (newVal == 'CONTINUAR'){\n        $(\"#93586775565215257852650013099141\").show();\n        $(\"#frm_resultadoNegociacion_resultado\").hide();\n        $(\"#frm_resultadoNegociacion_fechaAceptacion\").show();\n        $(\"#frm_resultadoNegociacion_fechaUltimoEnvio\").show();\n        $(\"#fle_aprobacion_cliente\").show();  \n        $(\"#frm_resultadoNegociacion_fechaAceptacion\").enableValidation();\n        $(\"#frm_resultadoNegociacion_fechaUltimoEnvio\").enableValidation();\n        $(\"#fle_aprobacion_cliente\").enableValidation();  \n    } else  if (newVal == 'REVISAR'){\n        $(\"#fle_mas_docs\").show();\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), ''); \n$('#frm_accion').setOnchange(action);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Presentación de condiciones","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"238363030652152578450a0095479933","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"8196240416521525790afc7036639704","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND CODIGO = 'Renovacion' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"40564984665215257902388024375880","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_poliza","var_uid":"54833714765218d9fa45445040336741","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_poliza","name":"frm_datosSolicitud_poliza","label":"Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"Ingrese solo números de póliza","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_poliza","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"62076699365215257906959002558107","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSolicitud_RUC","label":"RUC","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^[0-9]{10,13}","validateMessage":"Por favor, ingrese un número de RUC","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_RUC","colSpan":6},{"type":"text","variable":"frm_datosSolicitud_cliente","var_uid":"767168442652152578f74c7023751348","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_cliente","name":"frm_datosSolicitud_cliente","label":"Cliente","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"upper","validate":"^[a-z A-Z\\u00C0-\\u00FF]*$","validateMessage":"Ingrese el nombre del cliente","maxLength":"60","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_cliente","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_linea","var_uid":"43873387965215257904668099286919","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_linea","name":"frm_datosSolicitud_linea","label":"Línea de Negocio","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'LINEA_NEGOCIO' AND VALOR =\"C\" AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_linea","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_ramo","var_uid":"85695973065215257905819005884866","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_ramo","name":"frm_datosSolicitud_ramo","label":"Ramo","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'RAMO' AND VALOR != \"AP\" AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_ramo","colSpan":6}],[{"type":"dropdown","variable":"frm_datosSolicitud_sucursal","var_uid":"17113619265215257908c77097696713","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_sucursal","name":"frm_datosSolicitud_sucursal","label":"Sucursal","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'SUCURSAL' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_sucursal","colSpan":6},{"type":"dropdown","variable":"frm_datosSolicitud_solicitante","var_uid":"12690539265215257907af6062235097","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_solicitante","name":"frm_datosSolicitud_solicitante","label":"Ejecutivo Comercial","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT U.USR_USERNAME, upper(CONCAT(U.USR_LASTNAME,' ',U.USR_FIRSTNAME)) AS NAME\nFROM USERS U, GROUP_USER G WHERE U.USR_UID = G.USR_UID AND GRP_UID IN ('6774117196513a4d7375257095041040','2214584856513b058d1f5a7070402036')","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_solicitante","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_