        <dyn_content><![CDATA[{"name":"Form 6 Emisión Cotización","description":"Form 6 Emisión Cotización","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"469649369652152578630f9026206578","name":"Form 6 Emisión Cotización","description":"Form 6 Emisión Cotización","mode":"edit","script":{"type":"js","code":"$(\"#frm_datosSolicitud_fechaSolicitudEmision\").hide();\n$(\"#frm_datosSolicitud_emisorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacionEmisor\").hide();\n$(\"#frm_datosSolicitud_fechaEmision\").hide();\n$(\"#frm_datosSolicitud_suscriptorAsignado\").hide();\n$(\"#frm_datosSolicitud_fechaAsignacion\").hide();\n$(\"#frm_datosSolicitud_fechaAceptacion\").hide();\n$(\"#frm_datosSolicitud_fechaDictamen1\").hide();\n\n/*$(\"#frm_datosCotizacion_valorRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeRazon\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_primaNeta\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorSiniestros\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeIncurridos\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_valorComision\").getControl().attr('disabled', true);\n$(\"#frm_datosCotizacion_porcentajeComision\").getControl().attr('disabled', true);\n*/\n\n\nfunction action(newVal, oldVal) {\n    $(\"#5565803366521525785fc60084171987\").hide();\n    $(\"#frm_documentos_cotizaciones\").disableValidation();\n    $(\"#sub_condiciones\").hide();\n\n    if (newVal == 'CONTINUAR') {\n        $(\"#5565803366521525785fc60084171987\").show();\n        $(\"#frm_documentos_cotizaciones\").enableValidation();\n        $(\"#sub_condiciones\").show();\n\n    }\n    console.log(\"TIPO DE REQUERIMIENTO: \" + newVal);\n}\n//execute when the Dynaform loads:\naction($(\"#frm_accion\").getValue(), '');\n$('#frm_accion').setOnchange(action);\n"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"title0000000001","label":"Solicitud Emisión (Cotización Técnica)","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"subtitle0000000001","label":"<span class=\"subtitulo\" id=\"isub_busqueda\" subform=\"238363030652152578450a0095479933\"> <i class=\"glyphicon glyphicon-minus\"></i> \nDatos de la solicitud</span>","ariaLabel":"","colSpan":12}],[{"type":"form","variable":"","var_uid":"","dataType":"","id":"238363030652152578450a0095479933","name":"SubForm Datos Solicitud","description":"SubForm Datos Solicitud","mode":"disabled","script":{"type":"js","code":"//Validar cedula de identidad y pasaporte\n$(\"#frm_datosSolicitud_RUC\").focusout(function () {\n  if (typeof validarIdentificacion === 'function') {\n    let ruc = $(\"#frm_datosSolicitud_RUC\").getValue();\n    let tipoIdentificacion = \"R\";\n    let aux = true;\n    var bool = validarIdentificacion(ruc, tipoIdentificacion, aux);\n    console.log('validando '+bool);\n    if (bool == false) {\n      $('#frm_datosSolicitud_RUC').setValue(\"\");\n    }\n   \n  }\n});"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"dropdown","variable":"frm_datosSolicitud_tipo","var_uid":"8196240416521525790afc7036639704","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_tipo","name":"frm_datosSolicitud_tipo","label":"Tipo de requerimiento","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"SELECT CODIGO, DESCRIPCION FROM ADMIN_CATALOGOS WHERE COD_CATALOGO = 'TIPO_REQ' AND CODIGO = 'Renovacion' AND ESTADO = 1 ORDER BY DESCRIPCION","memoryCache":false,"dataVariable":"","options":[{"value":"","label":"--- Seleccione uno ---"}],"var_name":"frm_datosSolicitud_tipo","colSpan":6},{"type":"datetime","variable":"frm_datosSolicitud_fechaSolicitud","var_uid":"40564984665215257902388024375880","dataType":"datetime","protectedValue":false,"id":"frm_datosSolicitud_fechaSolicitud","name":"frm_datosSolicitud_fechaSolicitud","label":"Fecha de Solicitud","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"frm_datosSolicitud_fechaSolicitud","colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_poliza","var_uid":"54833714765218d9fa45445040336741","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_poliza","name":"frm_datosSolicitud_poliza","label":"Póliza","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"^\\d{1,10}$","validateMessage":"Ingrese solo números de póliza","maxLength":"13","formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"frm_datosSolicitud_poliza","colSpan":6},{"colSpan":6}],[{"type":"text","variable":"frm_datosSolicitud_RUC","var_uid":"62076699365215257906959002558107","dataType":"string","protectedValue":false,"id":"frm_datosSolicitud_RUC","name":"frm_datosSoli