t":"","var_accepted_values":"[]","inp_doc_uid":""}],"colSpan":12}],[{"type":"hidden","variable":"tri_bandera_mda","var_uid":"69445867465215257936f40011076465","dataType":"string","protectedValue":false,"id":"tri_bandera_mda","name":"tri_bandera_mda","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"tri_bandera_mda","colSpan":12}]],"variables":[{"var_uid":"67602437665399318917312040800165","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_accion_t","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"555104213655c1e538b9811023806861","prj_uid":"8799375496521525608b1c5005115762","var_name":"fileComiteSuscripcion_t","var_field_type":"multiplefile","var_field_size":10,"var_label":"multiplefile","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"668824410652152578e0347024334398","prj_uid":"8799375496521525608b1c5005115762","var_name":"frm_comentario","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"668824410652152578e0347024334398","var_name_old":"frm_comentario","prj_uid_old":"8799375496521525608b1c5005115762","create":false},{"var_uid":"69445867465215257936f40011076465","prj_uid":"8799375496521525608b1c5005115762","var_name":"tri_bandera_mda","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
